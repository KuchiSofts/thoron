+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_PORTABLE_KEY_OS_KEY_STORE_LINUX_H_
+#define COMPONENTS_THORON_PORTABLE_KEY_OS_KEY_STORE_LINUX_H_
+
+#include <stdint.h>
+
+#include <array>
+#include <memory>
+#include <optional>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "components/thoron_portable_key/os_key_store.h"
+#include "components/thoron_portable_key/secret_bytes.h"
+
+// "Remember this PC" on Linux (ROADMAP P4.9; threat model E5): the desktop's
+// keyring through the Secret Service (org.freedesktop.secrets: GNOME's keyring,
+// KDE's KWallet 5.97 and later, KeePassXC), which opens for the person signed
+// in. Protect() keeps a new random key in the keyring as an item of its own and
+// gives back the secret sealed with it; Unprotect() finds the item again by the
+// id in the blob. The blob alone (in the key file on the drive) opens nothing.
+namespace thoron_portable_key {
+
+inline constexpr char kSecretServiceBlobTag[] = "TSS1";
+inline constexpr size_t kSecretServiceIdSize = 16;
+
+// The keyring's item: its "application" attribute, and the attribute that
+// holds the blob's id in hex.
+inline constexpr char kSecretServiceApplication[] = "thoron-portable";
+inline constexpr char kSecretServiceIdAttribute[] = "thoron-copy";
+
+// The blob's format, apart from the keyring, for tests: the tag, the id, a
+// nonce and `secret` sealed with AES-256-GCM under `item_key` (the tag and id
+// as associated data).
+std::vector<uint8_t> SealForThisPc(base::span<const uint8_t, 32> item_key,
+                                   base::span<const uint8_t, kSecretServiceIdSize> id,
+                                   base::span<const uint8_t> secret);
+// The id a blob names, or nullopt for anything else (a Windows blob, say).
+std::optional<std::array<uint8_t, kSecretServiceIdSize>> IdOfBlob(base::span<const uint8_t> blob);
+std::optional<SecretBytes> OpenForThisPc(base::span<const uint8_t> item_key,
+                                         base::span<const uint8_t> blob);
+
+std::unique_ptr<OsKeyStore> CreateSecretServiceKeyStore();
+
+}  // namespace thoron_portable_key
+
+#endif  // COMPONENTS_THORON_PORTABLE_KEY_OS_KEY_STORE_LINUX_H_
diff --git a/components/thoron_portable_key/os_key_store_unittest.cc b/components/thoron_portable_key/os_key_store_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..c329a392b9a2ee2a95fb94a7494b75ace3e10bd2
--- /dev/null
+++ b/components/thoron_portable_key/os_key_store_unittest.cc
@@ -0,0 +1,116 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_portable_key/os_key_store.h"
+
+#include <stdint.h>
+
+#include <algorithm>
+#include <array>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "build/build_config.h"
+#include "build/config/linux/dbus/buildflags.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+#if BUILDFLAG(IS_LINUX) && BUILDFLAG(USE_DBUS)
+#include <stdlib.h>
+
+#include "base/test/task_environment.h"
+#include "components/thoron_portable_key/os_key_store_linux.h"
+#endif
+
+namespace thoron_portable_key {
+namespace {
+
+#if BUILDFLAG(IS_WIN)
+
+// DPAPI for this Windows account: what it protects opens again here, never in
+// the clear in the blob, and not once changed.
+TEST(ThoronOsKeyStoreTest, DpapiRoundTrip) {
+  std::unique_ptr<OsKeyStore> store = CreateOsKeyStore();
+  ASSERT_TRUE(store->IsAvailable());
+  std::vector<uint8_t> secret(32);
+  for (size_t i = 0; i < secret.size(); ++i) {
+    secret[i] = static_cast<uint8_t>(0xa0 + i);
+  }
+  std::optional<std::vector<uint8_t>> blob = store->Protect(secret);
+  ASSERT_TRUE(blob);
+  EXPECT_GT(blob->size(), secret.size());
+  EXPECT_EQ(std::search(blob->begin(), blob->end(), secret.begin(),
+                        secret.end()),
+            blob->end());
+  std::optional<SecretBytes> opened = store->Unprotect(*blob);
+  ASSERT_TRUE(opened);
+  EXPECT_TRUE(*opened == SecretBytes(secret));
+
+  std::vector<uint8_t> changed = *blob;
+  changed[changed.size() - 5] ^= 0x01;
+  EXPECT_FALSE(store->Unprotect(changed));
+  EXPECT_FALSE(store->Unprotect(std::vector<uint8_t>{1, 2, 3}));
+}
+
+#elif BUILDFLAG(IS_LINUX) && BUILDFLAG(USE_DBUS)
+
+// The blob of the desktop's keyring: it opens with its item's key only, not
+// once changed, and names its item by an id; a Windows blob names none.
+TEST(ThoronOsKeyStoreTest, SecretServiceBlob) {
+  std::array<uint8_t, 32> item_key;
+  item_key.fill(3);
+  std::array<uint8_t, kSecretServiceIdSize> id;
+  id.fill(9);
+  const std::vector<uint8_t> secret(32, 0x5a);
+  const std::vector<uint8_t> blob = SealForThisPc(item_key, id, secret);
+  EXPECT_EQ(blob.size(), 4u + 16u + 12u + 32u + 16u);
+  EXPECT_EQ(std::search(blob.begin(), blob.end(), secret.begin(), secret.end()), blob.end());
+  ASSERT_TRUE(IdOfBlob(blob));
+  EXPECT_EQ(*IdOfBlob(blob), id);
+  std::optional<SecretBytes> opened = OpenForThisPc(item_key, blob);
+  ASSERT_TRUE(opened);
+  EXPECT_TRUE(std::ranges::equal(opened->span(), secret));
+
+  std::array<uint8_t, 32> other_key;
+  other_key.fill(4);
+  EXPECT_FALSE(OpenForThisPc(other_key, blob));
+  for (size_t at : {size_t{5}, size_t{25}, blob.size() - 1}) {
+    std::vector<uint8_t> changed = blob;
+    changed[at] ^= 0x01;
+    EXPECT_FALSE(OpenForThisPc(item_key, changed)) << at;
+  }
+  EXPECT_FALSE(IdOfBlob(std::vector<uint8_t>(80, 1)));  // a DPAPI blob, say
+}
+
+// Without a session bus nothing is kept anywhere, and nothing opens.
+TEST(ThoronOsKeyStoreTest, SecretServiceWithoutABusKeepsNothing) {
+  base::test::TaskEnvironment tasks;
+  const char* bus = getenv("DBUS_SESSION_BUS_ADDRESS");
+  const std::string saved = bus ? bus : "";
+  unsetenv("DBUS_SESSION_BUS_ADDRESS");
+  std::unique_ptr<OsKeyStore> store = CreateOsKeyStore();
+  EXPECT_FALSE(store->IsAvailable());
+  EXPECT_FALSE(store->Protect(std::vector<uint8_t>(32, 1)));
+  std::array<uint8_t, 32> item_key;
+  item_key.fill(3);
+  std::array<uint8_t, kSecretServiceIdSize> id;
+  id.fill(9);
+  EXPECT_FALSE(store->Unprotect(SealForThisPc(item_key, id, std::vector<uint8_t>(32, 1))));
+  if (bus) {
+    setenv("DBUS_SESSION_BUS_ADDRESS", saved.c_str(), 1);
+  }
+}
+
+#else
+
+TEST(ThoronOsKeyStoreTest, NotAvailableYet) {
+  std::unique_ptr<OsKeyStore> store = CreateOsKeyStore();
+  EXPECT_FALSE(store->IsAvailable());
+  EXPECT_FALSE(store->Protect(std::vector<uint8_t>(32, 1)));
+}
+
+#endif
+
+}  // namespace
+}  // namespace thoron_portable_key
