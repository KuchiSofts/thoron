+let state = null;
+
+function showMessage(message, index) {
+  const button = make('button', 'message');
+  button.type = 'button';
+  const line = make('div', 'line');
+  if (message.isNew) {
+    line.append(make('span', 'dot'));
+  }
+  line.append(make('span', 'from', message.from || message.fromEmail),
+              make('span', 'when', message.issued ? ago(message.issued) : ''));
+  button.append(line, make('div', 'subject', message.subject || '(no subject)'));
+  if (message.snippet) {
+    button.append(make('div', 'snippet', message.snippet));
+  }
+  button.title = message.fromEmail || '';
+  button.addEventListener('click', () => chrome.send('openLink', [message.link, index]));
+  return button;
+}
+
+function showAccounts(next) {
+  const box = $('accounts');
+  box.replaceChildren();
+  if (!next.accounts.length) {
+    const empty = make('div', 'empty');
+    if (next.problem === 'offline' || next.problem === 'error') {
+      empty.append(make('p', '', t('Gmail could not be reached. Thoron tries again by itself.')));
+    } else if (next.lastCheck) {
+      empty.append(make('p', '', t('You are not signed in to Gmail in this browser.')));
+      const signIn = make('button', '', t('Sign in to Gmail'));
+      signIn.type = 'button';
+      signIn.addEventListener('click', () => chrome.send('signIn'));
+      empty.append(signIn);
+    } else {
+      empty.append(make('p', '', t('Not looked yet')));
+    }
+    box.append(empty);
+  }
+  for (const account of next.accounts) {
+    const card = make('section', account.watched ? 'account' : 'account off');
+    const top = make('div', 'top');
+    // the address opens the inbox, and the new mail is counted from then
+    const email = make('button', 'email', account.email);
+    email.type = 'button';
+    email.title = t('Open the inbox (the new mail is counted from then)');
+    email.addEventListener('click', () => chrome.send('openInbox', [account.index]));
+    top.append(email);
+    if (account.new) {
+      top.append(make('span', 'badge new', `${account.new} ${t('new')}`));
+    }
+    top.append(make('span', 'badge unread', `${account.unread} ${t('unread')}`));
+    card.append(top);
+    if (!account.unread) {
+      card.append(make('p', 'note', t('No unread mail')));
+    }
+    for (const message of account.latest.slice(0, 5)) {
+      card.append(showMessage(message, account.index));
+    }
+    if (account.unread > 5) {
+      card.append(make('p', 'more', `+${account.unread - 5} ${t('more unread')}`));
+    }
+    box.append(card);
+  }
+}
+
+function showSettings(next) {
+  for (const select of document.querySelectorAll('select[data-choice]')) {
+    select.value = next.choices[select.dataset.choice];
+  }
+  $('toolbar-position-row').hidden = next.choices.place === 'address';
+  $('address-position-row').hidden = next.choices.place === 'toolbar';
+  $('notify').checked = next.notify;
+  $('sound').checked = next.choices.sound !== 'off';
+  $('sound').disabled = !next.notify;
+  const interval = $('interval');
+  if (!interval.options.length) {
+    for (const minutes of next.intervals) {
+      const option = make('option', '', `${minutes} ${t('min')}`);
+      option.value = String(minutes);
+      interval.append(option);
+    }
+  }
+  interval.value = String(next.interval);
+  const watch = $('watch');
+  watch.replaceChildren();
+  for (const account of next.accounts) {
+    const label = make('label', 'check');
+    const box = make('input');
+    box.type = 'checkbox';
+    box.checked = account.watched;
+    box.addEventListener('change', () => chrome.send('setWatched', [account.email, box.checked]));
+    label.append(box, make('span', '', account.email));
+    watch.append(label);
+  }
+}
+
+function show(next) {
+  state = next;
+  const parts = [];
+  if (next.accounts.length) {
+    if (next.totalNew) {
+      parts.push(`${next.totalNew} ${t('new')}`);
+    }
+    parts.push(`${next.total} ${t('unread')}`);
+  }
+  $('total').textContent = parts.join(' · ');
+  $('check').disabled = next.checking;
+  $('state').textContent = next.lastCheck ? `${t('Looked')} ${ago(next.lastCheck)}` : '';
+  showAccounts(next);
+  showSettings(next);
+}
+
+async function refresh() {
+  try {
+    show(await sendWithPromise('getMailState'));
+  } catch {
+    // the window went away
+  }
+}
+
+$('check').addEventListener('click', () => chrome.send('checkNow'));
+$('gear').addEventListener('click', () => {
+  const open = $('settings').hidden;
+  $('settings').hidden = !open;
+  $('accounts').hidden = open;
+  $('gear').setAttribute('aria-pressed', String(open));
+});
+$('add').addEventListener('click', () => chrome.send('addAccount'));
+$('notify').addEventListener('change', () => chrome.send('setNotify', [$('notify').checked]));
+$('sound').addEventListener('change', () => chrome.send('setChoice', ['sound', $('sound').checked ? 'on' : 'off']));
+$('interval').addEventListener('change', () => chrome.send('setInterval', [Number($('interval').value)]));
+for (const select of document.querySelectorAll('select[data-choice]')) {
+  select.addEventListener('change', () => chrome.send('setChoice', [select.dataset.choice, select.value]));
+}
+document.addEventListener('keydown', (event) => {
+  if (event.key === 'Escape') {
+    chrome.send('closeMenu');
+  }
+});
+addWebUiListener('mail-changed', refresh);
+addWebUiListener('menu-shown', async () => {
+  await refresh();
+  chrome.send('menuReady');
+});
+refresh().then(() => chrome.send('menuReady'));
+// the times shown ("2 minutes ago") stay right while the menu is open
+setInterval(() => {
+  if (state && !document.hidden) {
+    show(state);
+  }
+}, 30000);
+)thoron";
