+// The bytes that lower-case hex digits spell.
+std::string FromHex(std::string_view hex) {
+  EXPECT_EQ(hex.size() % 2, 0u);
+  std::string bytes;
+  int high = -1;
+  for (const char c : hex) {
+    const int digit = c >= '0' && c <= '9'   ? c - '0'
+                      : c >= 'a' && c <= 'f' ? c - 'a' + 10
+                                             : -1;
+    EXPECT_GE(digit, 0) << hex;
+    if (high < 0) {
+      high = digit;
+    } else {
+      bytes.push_back(static_cast<char>(high * 16 + digit));
+      high = -1;
+    }
+  }
+  return bytes;
+}
+
+std::array<uint8_t, kPublicKeyBytes> KeyFromHex(std::string_view hex) {
+  const std::string bytes = FromHex(hex);
+  std::array<uint8_t, kPublicKeyBytes> key = {};
+  EXPECT_EQ(bytes.size(), key.size());
+  for (size_t i = 0; i < key.size() && i < bytes.size(); ++i) {
+    key[i] = static_cast<uint8_t>(bytes[i]);
+  }
+  return key;
+}
+
+BuildVersion Version(std::string_view text) {
+  const std::optional<BuildVersion> version = ParseBuildVersion(text);
+  EXPECT_TRUE(version) << text;
+  return version.value_or(BuildVersion());
+}
+
+// The words of a text that are separated by one space.
+std::vector<std::string> Words(std::string_view text) {
+  std::vector<std::string> words;
+  while (!text.empty()) {
+    const size_t space = text.find(' ');
+    words.emplace_back(text.substr(0, space));
+    if (space == std::string_view::npos) {
+      break;
+    }
+    text.remove_prefix(space + 1);
+  }
+  return words;
+}
+
+// A file as the vectors name it.
+std::string Written(const std::optional<PackageFile>& file) {
+  if (!file) {
+    return std::string();
+  }
+  return base::NumberToString(file->size) + " " + file->sha256 + " " +
+         file->url;
+}
+
+// update.json of a vector: the example with one stretch of it replaced.
+std::string ManifestOf(const Vector& vector) {
+  const std::string changed = vector.changed_hex.empty()
+                                  ? std::string(vector.changed)
+                                  : FromHex(vector.changed_hex);
+  EXPECT_LE(vector.keep_front + vector.keep_back, kExample.size());
+  std::string manifest(kExample.substr(0, vector.keep_front));
+  manifest.reserve(kExample.size() + changed.size() * vector.repeat);
+  for (size_t i = 0; i < vector.repeat; ++i) {
+    manifest += changed;
+  }
+  manifest += kExample.substr(kExample.size() - vector.keep_back);
+  return manifest;
+}
+
+CopyInfo CopyOf(const Vector& vector) {
+  const std::optional<Variant> variant = ParseVariant(vector.variant);
+  const std::optional<Kind> kind = ParseKind(vector.kind);
+  EXPECT_TRUE(variant) << vector.variant;
+  EXPECT_TRUE(kind) << vector.kind;
+  CopyInfo copy;
+  copy.public_key = KeyFromHex(vector.public_key);
+  copy.allowed_hosts = Words(vector.hosts);
+  copy.channel = std::string(vector.channel);
+  copy.installed = Version(vector.installed);
+  copy.updater = Version(vector.updater);
+  copy.variant = variant.value_or(Variant::kWinX64Avx2);
+  copy.kind = kind.value_or(Kind::kInstalled);
+  copy.last_serial = vector.last_serial;
+  return copy;
+}
+
+Decision Check(const Vector& vector) {
+  return CheckUpdate(ManifestOf(vector), FromHex(vector.signature),
+                     CopyOf(vector), vector.now);
+}
+
+const Vector& Named(std::string_view name) {
+  for (const Vector& vector : kVectors) {
+    if (vector.name == name) {
+      return vector;
+    }
+  }
+  ADD_FAILURE() << "no vector is named " << name;
+  return *std::begin(kVectors);
+}
+
+// The copy most tests check for: on the stable channel, with the release
+// before the example's installed, holding the test key.
+CopyInfo ExampleCopy() {
+  CopyInfo copy;
+  copy.public_key = KeyFromHex(kTestPublicKey);
+  copy.allowed_hosts = {"github.com"};
+  copy.channel = "stable";
+  copy.installed = Version(kOldVersion);
+  copy.updater = Version(kOldVersion);
+  copy.variant = Variant::kWinX64Avx2;
+  copy.kind = Kind::kInstalled;
+  return copy;
+}
+
+// The example under its signature, an hour after it was published.
+Decision CheckExample(const CopyInfo& copy, int64_t now = kNow) {
+  return CheckUpdate(kExample, FromHex(kExampleSignature), copy, now);
+}
+
+void ExpectNothingHandedOut(const Decision& decision) {
+  EXPECT_FALSE(decision.manifest);
+  EXPECT_FALSE(decision.remember_serial);
+  EXPECT_FALSE(decision.full);
+  EXPECT_FALSE(decision.delta);
+}
+
+// Every vector is a manifest and a signature made by the reference tool, with
+// the reference's answer. The updater gives the same answer.
+TEST(ThoronUpdateManifestTest, GivesTheAnswerOfTheReferenceForEveryVector) {
+  size_t checked = 0;
+  for (const Vector& vector : kVectors) {
+    SCOPED_TRACE(vector.name);
+    const Decision decision = Check(vector);
+    EXPECT_EQ(OutcomeName(decision.outcome), vector.outcome);
+    EXPECT_EQ(decision.remember_serial.value_or(0), vector.remember_serial);
+    EXPECT_EQ(decision.manifest.has_value(), vector.remember_serial != 0);
+    EXPECT_EQ(Written(decision.full), vector.full);
+    EXPECT_EQ(Written(decision.delta), vector.delta);
+    // The full package comes with an update, and with an updater that is too
+    // old when there is one for the copy (P4.6); a delta only with an update.
+    if (decision.outcome == Outcome::kUpdate) {
+      EXPECT_TRUE(decision.full);
+    } else if (decision.outcome != Outcome::kUpdaterTooOld) {
+      EXPECT_FALSE(decision.full);
+    }
+    EXPECT_TRUE(!decision.delta || decision.outcome == Outcome::kUpdate);
+    ++checked;
+  }
+  EXPECT_GE(checked, 300u);
+}
+
+// ROADMAP P3.3, "Done when": bad signatures are rejected. One changed bit, in
+// either file, is a refusal, and nothing of the manifest is handed out.
+TEST(ThoronUpdateManifestTest, RejectsBadSignatures) {
+  const CopyInfo copy = ExampleCopy();
+  const std::string signature = FromHex(kExampleSignature);
+  ASSERT_EQ(signature.size(), kSignatureBytes);
+  ASSERT_EQ(CheckUpdate(kExample, signature, copy, kNow).outcome,
+            Outcome::kUpdate);
+
+  std::string manifest(kExample);
+  for (size_t at = 0; at < manifest.size(); ++at) {
+    for (int bit = 0; bit < 8; ++bit) {
+      const char kept = manifest[at];
+      manifest[at] = static_cast<char>(kept ^ (1 << bit));
+      const Decision decision = CheckUpdate(manifest, signature, copy, kNow);
+      EXPECT_EQ(decision.outcome, Outcome::kBadSignature)
+          << "manifest byte " << at << ", bit " << bit;
+      EXPECT_FALSE(decision.manifest);
+      manifest[at] = kept;
+    }
+  }
+  ASSERT_EQ(manifest, kExample);
+
+  std::string changed = signature;
+  for (size_t at = 0; at < changed.size(); ++at) {
+    for (int bit = 0; bit < 8; ++bit) {
+      const char kept = changed[at];
+      changed[at] = static_cast<char>(kept ^ (1 << bit));
+      const Decision decision = CheckUpdate(kExample, changed, copy, kNow);
+      EXPECT_EQ(decision.outcome, Outcome::kBadSignature)
+          << "signature byte " << at << ", bit " << bit;
+      ExpectNothingHandedOut(decision);
+      changed[at] = kept;
+    }
+  }
+
+  for (const std::string_view name :
+       {"no signature", "a signature a byte short", "a signature a byte long",
+        "a signature of zeros", "a manifest a byte short", "another key",
+        "a signature made for another purpose: the bare bytes, no purpose",
+        "a signature of the ad blocker's resources"}) {
+    SCOPED_TRACE(name);
+    const Decision decision = Check(Named(name));
+    EXPECT_EQ(decision.outcome, Outcome::kBadSignature);
+    EXPECT_TRUE(CannotVerify(decision.outcome));
+    ExpectNothingHandedOut(decision);
+  }
+}
+
+// "Done when": older manifests are rejected. Older is a serial below one this
+// copy has accepted (a replay), or a version below the installed one.
+TEST(ThoronUpdateManifestTest, RejectsOlderManifests) {
+  CopyInfo copy = ExampleCopy();
+  copy.last_serial = kSerial + 1;
+  const Decision replayed = CheckExample(copy);
+  EXPECT_EQ(replayed.outcome, Outcome::kReplayed);
+  EXPECT_TRUE(CannotVerify(replayed.outcome));
+  ExpectNothingHandedOut(replayed);
+
+  // The same manifest again is not older: a copy that checks daily fetches
+  // the same one most days.
+  copy.last_serial = kSerial;
+  EXPECT_EQ(CheckExample(copy).outcome, Outcome::kUpdate);
+
+  for (const std::string_view installed :
+       {"158.0.8127.4501", "158.0.8128.0", "159.0.0.0"}) {
+    SCOPED_TRACE(installed);
+    copy = ExampleCopy();
+    copy.installed = Version(installed);
+    copy.updater = copy.installed;
+    const Decision downgrade = CheckExample(copy);
+    EXPECT_EQ(downgrade.outcome, Outcome::kDowngrade);
+    EXPECT_TRUE(CannotVerify(downgrade.outcome));
+    EXPECT_FALSE(downgrade.full);
+    EXPECT_FALSE(downgrade.delta);
+    // Still the channel's current word: its serial is stored.
+    EXPECT_EQ(downgrade.remember_serial, kSerial);
+  }
+}
+
+// "Done when": malformed JSON is rejected, after the signature held. Under a
+// signature that is not theirs the same bytes are never read.
+TEST(ThoronUpdateManifestTest, RejectsMalformedJson) {
+  for (const std::string_view name : {
+           "another written form: a word",
+           "another written form: the first 200 bytes",
+           "another written form: an empty object",
+           "another written form: an empty list",
+           "another written form: a comma after the last member",
+           "another written form: a comment",
+           "another written form: a repeated top-level key",
+           "another written form: a repeated key with another value",
+           "another written form: a number with a leading zero",
+           "another written form: no spaces",
+           "another written form: a byte order mark",
+           "a size written as 9437184.0",
+           "a size written as 1E2",
+           "a size written as NaN",
+           "invalid: schema 2",
+           "invalid: an unknown top-level key",
+           "100000 opening brackets, signed",
+       }) {
+    SCOPED_TRACE(name);
+    const Vector& vector = Named(name);
+    const Decision decision = Check(vector);
+    EXPECT_EQ(decision.outcome, Outcome::kMalformed);
+    EXPECT_TRUE(CannotVerify(decision.outcome));
+    ExpectNothingHandedOut(decision);
+    EXPECT_EQ(CheckUpdate(ManifestOf(vector), FromHex(kExampleSignature),
+                          CopyOf(vector), vector.now)
+                  .outcome,
+              Outcome::kBadSignature);
+  }
+}
+
+// "Done when": an expired manifest is "cannot verify", told apart from a bad
+// one and never shown as up to date.
+TEST(ThoronUpdateManifestTest, AnExpiredManifestIsCannotVerifyNeverUpToDate) {
+  CopyInfo copy = ExampleCopy();
+  // The clock may be off by 24 hours.
+  EXPECT_EQ(CheckExample(copy, kExpires + kClockSkewSeconds).outcome,
+            Outcome::kUpdate);
+  for (const std::string_view installed : {kOldVersion, kNewVersion}) {
+    SCOPED_TRACE(installed);
+    copy.installed = Version(installed);
+    for (const int64_t late : {int64_t{1}, int64_t{365} * 24 * 60 * 60}) {
+      const Decision decision =
+          CheckExample(copy, kExpires + kClockSkewSeconds + late);
+      EXPECT_EQ(decision.outcome, Outcome::kExpired);
+      EXPECT_TRUE(CannotVerify(decision.outcome));
+      // The serial of a manifest that is not current is not stored.
+      ExpectNothingHandedOut(decision);
+    }
+  }
+  // Before its last day, the same copy is up to date.
+  copy.installed = Version(kNewVersion);
+  const Decision current = CheckExample(copy);
+  EXPECT_EQ(current.outcome, Outcome::kUpToDate);
+  EXPECT_FALSE(CannotVerify(current.outcome));
+  EXPECT_EQ(current.remember_serial, kSerial);
+}
+
+TEST(ThoronUpdateManifestTest, AManifestDatedAfterTheClockIsNotYetValid) {
+  const CopyInfo copy = ExampleCopy();
+  EXPECT_EQ(CheckExample(copy, kPublished - kClockSkewSeconds).outcome,
+            Outcome::kUpdate);
+  const Decision decision =
+      CheckExample(copy, kPublished - kClockSkewSeconds - 1);
+  EXPECT_EQ(decision.outcome, Outcome::kNotYetValid);
+  EXPECT_TRUE(CannotVerify(decision.outcome));
+  // A serial from the future is not kept.
+  ExpectNothingHandedOut(decision);
+}
