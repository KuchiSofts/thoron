+// A build made before the real key is put in holds zeros. With them, and with
+// any other point of small order, nothing verifies.
+TEST(ThoronUpdateManifestTest, ACopyWithoutItsKeyTakesNothing) {
+  CopyInfo copy = ExampleCopy();
+  copy.public_key = {};
+  const std::string made_up = std::string(1, '\1') + std::string(63, '\0');
+  for (const std::string& signature :
+       {FromHex(kExampleSignature), std::string(kSignatureBytes, '\0'),
+        made_up}) {
+    const Decision decision = CheckUpdate(kExample, signature, copy, kNow);
+    EXPECT_EQ(decision.outcome, Outcome::kBadSignature);
+    ExpectNothingHandedOut(decision);
+  }
+  EXPECT_EQ(CheckUpdate(kExample, FromHex(kExampleSignature), CopyInfo(), kNow)
+                .outcome,
+            Outcome::kInvalidCopy);
+}
