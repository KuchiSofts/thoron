+ImapCheck::ImapCheck(network::mojom::NetworkContext* context,
+                     const ImapAccount& account,
+                     Done done,
+                     bool trust_new_certificate)
+    : session_(imap_session(account.user, account.password, kMostMessages)),
+      done_(std::move(done)),
+      read_watcher_(FROM_HERE, mojo::SimpleWatcher::ArmingPolicy::MANUAL),
+      write_watcher_(FROM_HERE, mojo::SimpleWatcher::ArmingPolicy::MANUAL) {
+  // A server on this computer (Proton Mail Bridge): reached directly, and
+  // trusted by the pin of its own certificate (also in the offline checks,
+  // whose local server stands in for servers elsewhere).
+  if (context && IsLocalImapHost(account.host) && account.port > 0 &&
+      account.port <= 65535) {
+    local_ = Local::kGreeting;
+    local_host_ = account.host;
+    local_port_ = account.port;
+    expected_pin_ = base::ToUpperASCII(account.pin);
+    trust_new_certificate_ = trust_new_certificate;
+    context->CreateTCPConnectedSocket(
+        std::nullopt,
+        net::AddressList(net::IPEndPoint(net::IPAddress::IPv4Localhost(),
+                                         static_cast<uint16_t>(account.port))),
+        nullptr, net::MutableNetworkTrafficAnnotationTag(kTrafficAnnotation),
+        tcp_.BindNewPipeAndPassReceiver(), mojo::NullRemote(),
+        base::BindOnce(&ImapCheck::OnConnected, weak_factory_.GetWeakPtr()));
+    // base::Unretained is safe: the remotes and the timers are members.
+    tcp_.set_disconnect_handler(
+        base::BindOnce(&ImapCheck::OnClosed, base::Unretained(this)));
+    timeout_.Start(FROM_HERE, kTimeout,
+                   base::BindOnce(&ImapCheck::Finish, base::Unretained(this),
+                                  "offline"));
+    return;
+  }
+  GURL url = TestingEndpoint();
+  // TLS always, but to the offline checks' own local server
+  const bool tls = !url.is_valid();
+  if (tls && IsImapHost(account.host) && account.port > 0 &&
+      account.port <= 65535) {
+    url = GURL("https://" + account.host + ":" +
+               base::NumberToString(account.port) + "/");
+  }
+  if (!context || !url.is_valid()) {
+    // not from inside the constructor: `done` may destroy this
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&ImapCheck::Finish,
+                                  weak_factory_.GetWeakPtr(), "offline"));
+    return;
+  }
+  context->CreateProxyResolvingSocketFactory(
+      factory_.BindNewPipeAndPassReceiver());
+  auto options = network::mojom::ProxyResolvingSocketOptions::New();
+  options->use_tls = tls;
+  factory_->CreateProxyResolvingSocket(
+      url, net::NetworkAnonymizationKey::CreateTransient(), std::move(options),
+      net::MutableNetworkTrafficAnnotationTag(kTrafficAnnotation),
+      socket_.BindNewPipeAndPassReceiver(), mojo::NullRemote(),
+      base::BindOnce(&ImapCheck::OnConnected, weak_factory_.GetWeakPtr()));
+  // base::Unretained is safe: the remotes and the timer are members.
+  factory_.set_disconnect_handler(
+      base::BindOnce(&ImapCheck::OnClosed, base::Unretained(this)));
+  timeout_.Start(FROM_HERE, kTimeout,
+                 base::BindOnce(&ImapCheck::Finish, base::Unretained(this),
+                                "offline"));
+}
+
+ImapCheck::~ImapCheck() = default;
+
+void ImapCheck::OnConnected(int result,
+                            const std::optional<net::IPEndPoint>& local,
+                            const std::optional<net::IPEndPoint>& peer,
+                            mojo::ScopedDataPipeConsumerHandle receive,
+                            mojo::ScopedDataPipeProducerHandle send) {
+  if (result != net::OK || !receive.is_valid() || !send.is_valid()) {
+    Finish("offline");
+    return;
+  }
+  receive_ = std::move(receive);
+  send_ = std::move(send);
+  Watch();
+  if (local_ == Local::kGreeting) {
+    // base::Unretained is safe: the timer is a member.
+    silence_.Start(FROM_HERE, kSilence,
+                   base::BindOnce(&ImapCheck::OnSilence,
+                                  base::Unretained(this)));
+  }
+}
+
+void ImapCheck::Watch() {
+  // base::Unretained is safe: the watchers are members.
+  read_watcher_.Watch(
+      receive_.get(),
+      MOJO_HANDLE_SIGNAL_READABLE | MOJO_HANDLE_SIGNAL_PEER_CLOSED,
+      MOJO_WATCH_CONDITION_SATISFIED,
+      base::BindRepeating(&ImapCheck::OnReadable, base::Unretained(this)));
+  write_watcher_.Watch(
+      send_.get(), MOJO_HANDLE_SIGNAL_WRITABLE | MOJO_HANDLE_SIGNAL_PEER_CLOSED,
+      MOJO_WATCH_CONDITION_SATISFIED,
+      base::BindRepeating(&ImapCheck::OnWritable, base::Unretained(this)));
+  read_watcher_.ArmOrNotify();
+}
+
+void ImapCheck::OnReadable(MojoResult result,
+                           const mojo::HandleSignalsState& state) {
+  if (result != MOJO_RESULT_OK) {
+    OnClosed();
+    return;
+  }
+  while (true) {
+    base::span<const uint8_t> data;
+    const MojoResult read =
+        receive_->BeginReadData(MOJO_BEGIN_READ_DATA_FLAG_NONE, data);
+    if (read == MOJO_RESULT_SHOULD_WAIT) {
+      read_watcher_.ArmOrNotify();
+      return;
+    }
+    if (read != MOJO_RESULT_OK) {
+      OnClosed();
+      return;
+    }
+    // copied first: what is read may end the look, or start TLS, which
+    // closes this pipe
+    const std::vector<uint8_t> bytes(data.begin(), data.end());
+    receive_->EndReadData(data.size());
+    const bool plain =
+        local_ == Local::kGreeting || local_ == Local::kStartTls;
+    base::WeakPtr<ImapCheck> alive = weak_factory_.GetWeakPtr();
+    const bool going = plain ? OnPlainText(bytes) : Feed(bytes);
+    if (!going || !alive || !done_ || !receive_.is_valid()) {
+      return;
+    }
+  }
+}
+
+bool ImapCheck::Feed(base::span<const uint8_t> data) {
+  ImapStep step =
+      session_->on_bytes(rust::Slice<const uint8_t>(data.data(), data.size()));
+  if (step.done) {
+    Finish(std::string(session_->problem()));
+    return false;
+  }
+  if (!step.send.empty()) {
+    if (pending_.size() + step.send.size() > kMostPending) {
+      Finish("protocol");
+      return false;
+    }
+    pending_.append(reinterpret_cast<const char*>(step.send.data()),
+                    step.send.size());
+    // A write that fails ends the look, and `done` may destroy this.
+    base::WeakPtr<ImapCheck> alive = weak_factory_.GetWeakPtr();
+    Write();
+    if (!alive || !done_) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool ImapCheck::OnPlainText(base::span<const uint8_t> data) {
+  silence_.Stop();
+  plain_.append(reinterpret_cast<const char*>(data.data()), data.size());
+  if (plain_.size() > kMostPlainText) {
+    Finish("protocol");
+    return false;
+  }
+  size_t end;
+  while ((end = plain_.find("\r\n")) != std::string::npos) {
+    const std::string line = base::ToUpperASCII(plain_.substr(0, end));
+    plain_.erase(0, end + 2);
+    if (local_ == Local::kGreeting) {
+      // Bridge's greeting; anything else is not an IMAP server
+      if (!line.starts_with("* OK")) {
+        Finish("protocol");
+        return false;
+      }
+      greeted_ = true;
+      local_ = Local::kStartTls;
+      pending_ = kStartTls;
+      base::WeakPtr<ImapCheck> alive = weak_factory_.GetWeakPtr();
+      Write();
+      if (!alive || !done_) {
+        return false;
+      }
+    } else if (line.starts_with("S0 OK")) {
+      // Nothing it said in plain text is used after TLS (RFC 3501 6.2.1).
+      plain_.clear();
+      StartTls();
+      return false;
+    } else if (line.starts_with("S0 ")) {
+      // a server here without TLS: its passwords would go in plain text
+      Finish("protocol");
+      return false;
+    }
+  }
+  return true;
+}
+
+void ImapCheck::OnSilence() {
+  if (local_ == Local::kGreeting && plain_.empty()) {
+    StartTls();
+  }
+}
+
+void ImapCheck::StartTls() {
+  local_ = Local::kUpgrading;
+  silence_.Stop();
+  read_watcher_.Cancel();
+  write_watcher_.Cancel();
+  // the network service sets TLS up once these are closed
+  receive_.reset();
+  send_.reset();
+  pending_.clear();
+  // Its certificate is made by the server itself, so no authority's
+  // signature is asked for; it is checked against the pin instead.
+  auto options = network::mojom::TLSClientSocketOptions::New();
+  options->unsafely_skip_cert_verification = true;
+  options->send_ssl_info = true;
+  tcp_->UpgradeToTLS(
+      net::HostPortPair(local_host_, static_cast<uint16_t>(local_port_)),
+      std::move(options),
+      net::MutableNetworkTrafficAnnotationTag(kTrafficAnnotation),
+      tls_.BindNewPipeAndPassReceiver(), mojo::NullRemote(),
+      base::BindOnce(&ImapCheck::OnTlsReady, weak_factory_.GetWeakPtr()));
+  // base::Unretained is safe: the remote is a member.
+  tls_.set_disconnect_handler(
+      base::BindOnce(&ImapCheck::OnClosed, base::Unretained(this)));
+}
+
+void ImapCheck::OnTlsReady(int32_t net_error,
+                           mojo::ScopedDataPipeConsumerHandle receive,
+                           mojo::ScopedDataPipeProducerHandle send,
+                           const std::optional<net::SSLInfo>& ssl_info) {
+  if (net_error != net::OK || !receive.is_valid() || !send.is_valid()) {
+    Finish("offline");
+    return;
+  }
+  if (!ssl_info || !ssl_info->cert) {
+    Finish("certificate");
+    return;
+  }
+  const net::SHA256HashValue hash =
+      net::X509Certificate::CalculateFingerprint256(
+          ssl_info->cert->cert_buffer());
+  pin_ = base::HexEncode(hash);
+  // the pin kept for it, or, when adding or editing the mailbox, the
+  // certificate it shows now
+  if (expected_pin_.empty() ? !trust_new_certificate_ : pin_ != expected_pin_) {
+    Finish("certificate");
+    return;
+  }
+  local_ = Local::kTls;
+  receive_ = std::move(receive);
+  send_ = std::move(send);
+  Watch();
+  // After STARTTLS the server greets no more: the session starts on a bare
+  // greeting, and asks for the capabilities again over TLS.
+  if (greeted_) {
+    static constexpr char kGreeting[] = "* OK\r\n";
+    Feed(base::as_byte_span(std::string_view(kGreeting)));
+  }
+}
+
+void ImapCheck::OnWritable(MojoResult result,
+                           const mojo::HandleSignalsState& state) {
+  if (result != MOJO_RESULT_OK) {
+    OnClosed();
+    return;
+  }
+  Write();
+}
+
+void ImapCheck::Write() {
+  while (!pending_.empty()) {
+    size_t written = 0;
+    const MojoResult result = send_->WriteData(base::as_byte_span(pending_),
+                                               MOJO_WRITE_DATA_FLAG_NONE,
+                                               written);
+    if (result == MOJO_RESULT_SHOULD_WAIT) {
+      write_watcher_.ArmOrNotify();
+      return;
+    }
+    if (result != MOJO_RESULT_OK) {
+      OnClosed();
+      return;
+    }
+    // what was sent (a sign-in among it) is not kept
+    std::fill_n(pending_.begin(), written, '\0');
+    pending_.erase(0, written);
+  }
+}
+
+void ImapCheck::OnClosed() {
+  session_->on_closed();
+  Finish(std::string(session_->problem()));
+}
+
+void ImapCheck::Finish(std::string problem) {
+  if (!done_) {
+    return;
+  }
+  timeout_.Stop();
+  silence_.Stop();
+  read_watcher_.Cancel();
+  write_watcher_.Cancel();
+  receive_.reset();
+  send_.reset();
+  socket_.reset();
+  factory_.reset();
+  tls_.reset();
+  tcp_.reset();
+  std::fill(pending_.begin(), pending_.end(), '\0');
+  pending_.clear();
+
+  Result result;
+  result.problem = std::move(problem);
+  result.pin = pin_;
+  if (result.problem.empty()) {
+    result.unread = static_cast<int>(
+        std::min<uint32_t>(session_->unseen(), 1000000u));
+    for (const ImapMessage& found : session_->messages()) {
+      MailMessage message;
+      message.id = std::string(found.id);
+      message.from_email = std::string(found.from_email);
+      message.from_name = TextOf(found.from_name);
+      message.subject = TextOf(found.subject);
+      if (found.issued_ms > 0) {
+        message.issued = base::Time::FromMillisecondsSinceUnixEpoch(
+            static_cast<double>(found.issued_ms));
+      }
+      result.latest.push_back(std::move(message));
+    }
+  }
+  // last: `done` may destroy this
+  std::move(done_).Run(std::move(result));
+}
+
+}  // namespace thoron_mail
