+TEST(ThoronUpdateManifestTest, OnlyUpToDateIsEverUpToDate) {
+  const std::vector<std::pair<Outcome, std::string_view>> outcomes = {
+      {Outcome::kUpdate, "update"},
+      {Outcome::kUpToDate, "up_to_date"},
+      {Outcome::kBadSignature, "bad_signature"},
+      {Outcome::kMalformed, "malformed"},
+      {Outcome::kWrongChannel, "wrong_channel"},
+      {Outcome::kReplayed, "replayed"},
+      {Outcome::kNotYetValid, "not_yet_valid"},
+      {Outcome::kExpired, "expired"},
+      {Outcome::kDowngrade, "downgrade"},
+      {Outcome::kUpdaterTooOld, "updater_too_old"},
+      {Outcome::kNoPackage, "no_package"},
+      {Outcome::kInvalidCopy, "invalid_copy"},
+  };
+  size_t cannot_verify = 0;
+  for (const auto& [outcome, name] : outcomes) {
+    EXPECT_EQ(OutcomeName(outcome), name);
+    cannot_verify += CannotVerify(outcome) ? 1 : 0;
+  }
+  // bad_signature to downgrade: the "cannot verify updates" state.
+  EXPECT_EQ(cannot_verify, 7u);
+  for (const Outcome outcome :
+       {Outcome::kBadSignature, Outcome::kMalformed, Outcome::kWrongChannel,
+        Outcome::kReplayed, Outcome::kNotYetValid, Outcome::kExpired,
+        Outcome::kDowngrade}) {
+    EXPECT_TRUE(CannotVerify(outcome)) << OutcomeName(outcome);
+  }
+  // Every vector that ends in up_to_date names the installed version.
+  for (const Vector& vector : kVectors) {
+    if (vector.outcome == "up_to_date") {
+      EXPECT_EQ(vector.installed, kNewVersion) << vector.name;
+    }
+  }
+}
