+  // The menu's switches of one host, as a restored backup has them.
+  void SetHostSwitches(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 2);
+    if (!id || !args[1].is_string() || !args[2].is_list()) {
+      return;
+    }
+    const std::string& host = args[1].GetString();
+    const GURL url("https://" + host + "/");
+    if (host.empty() || host.size() > 253 || !url.is_valid() ||
+        url.host() != host || args[2].GetList().size() > 16) {
+      Answer(*id, "This is not the name of a site.");
+      return;
+    }
+    std::vector<std::string> names;
+    for (const base::Value& name : args[2].GetList()) {
+      if (name.is_string()) {
+        names.push_back(name.GetString());
+      }
+    }
+    Service().SetHostSwitches(host, names);
+    Answer(*id, std::string());
