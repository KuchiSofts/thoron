+
+TEST_F(BrowserDetectionTest, IgnoresAnotherBrowsersOddLocalState) {
+  base::FilePath vivaldi = UserData(local_.GetPath(), L"Vivaldi\\User Data");
+  // A Local State with no profile.info_cache yields a browser with no profile,
+  // but it is still detected (its folder holds a Local State).
+  Write(vivaldi.Append(L"Local State"), "{\"something\":true}");
+
+  std::vector<DetectedBrowser> found = DetectBrowsers(folders_);
+  ASSERT_EQ(1u, found.size());
+  EXPECT_EQ("Vivaldi", found[0].name);
+  EXPECT_TRUE(found[0].profiles.empty());
+  EXPECT_TRUE(MakeSourceProfiles(found).empty());
