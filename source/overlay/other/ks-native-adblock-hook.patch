+  ASSERT_TRUE(base::WriteFile(stale, "of an older release"));
+  Serve(base::BindLambdaForTesting([&](const std::string& range) { Answer(200, whole); }));
+  EXPECT_EQ(Look(*Client(), /*install=*/true).state, State::kReadyToRelaunch);
