+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// For the tests and the fuzzer of open_tabs.cc only (ROADMAP P3.22): they link
+// Chromium's session code without the content layer, which provides the
+// browser's navigation driver. This one leaves every entry as it was read.
+
+#include <string>
+
+#include "base/no_destructor.h"
+#include "components/sessions/core/serialized_navigation_driver.h"
+#include "components/sessions/core/serialized_navigation_entry.h"
+
+namespace sessions {
+namespace {
+
+class ThoronTestNavigationDriver : public SerializedNavigationDriver {
+ public:
+  int GetDefaultReferrerPolicy() const override { return 0; }
+  std::string GetSanitizedPageStateForPickle(
+      const SerializedNavigationEntry* navigation) const override {
+    return navigation->encoded_page_state();
+  }
+  void Sanitize(SerializedNavigationEntry* navigation) const override {}
+  std::string StripReferrerFromPageState(
+      const std::string& page_state) const override {
+    return page_state;
+  }
+};
+
+}  // namespace
+
+// static
+SerializedNavigationDriver* SerializedNavigationDriver::Get() {
+  static base::NoDestructor<ThoronTestNavigationDriver> driver;
+  return driver.get();
+}
