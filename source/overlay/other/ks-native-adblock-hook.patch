+// Thoron (ROADMAP P3.14): what came over and what was left out, for the
+// report the host writes when the import ends.
+void ExternalProcessImporterClient::OnThoronImportReport(
+    chrome::mojom::ThoronImportReportPtr report) {
+  if (cancelled_ || !report || !process_importer_host_) {
+    return;
+  }
+  base::DictValue imported;
+  imported.Set("bookmarks", report->bookmarks);
+  imported.Set("history", report->history);
+  imported.Set("search_engines", report->search_engines);
+  imported.Set("autofill", report->autofill);
+  imported.Set("passwords", report->passwords);
+  imported.Set("cookies", report->cookies);
+  base::DictValue left_out;
+  left_out.Set("passwords_locked_by_chrome", report->passwords_skipped_app_bound);
+  left_out.Set("passwords_in_no_known_format", report->passwords_skipped_other);
+  left_out.Set("passwords_that_did_not_decrypt", report->passwords_failed);
+  left_out.Set("cookies_locked_by_chrome", report->cookies_skipped_app_bound);
+  left_out.Set("cookies_that_did_not_decrypt", report->cookies_failed);
+  imported.Set("home_page", report->home_page);
+  imported.Set("startup_pages", report->startup_pages);
+  imported.Set("extensions_to_install_from_the_store", report->extensions);
+  imported.Set("open_tabs", report->open_tabs);
+  left_out.Set("extensions_not_from_the_store", report->extensions_skipped);
+  left_out.Set("damaged_databases", report->databases_refused);
+  base::DictValue counts;
+  counts.Set("imported", std::move(imported));
+  counts.Set("left_out", std::move(left_out));
+  process_importer_host_->SetThoronImportReport(std::move(counts));
+}
