+    EXPECT_TRUE(r.load_flags & net::LOAD_DISABLE_CACHE) << r.url;
+    EXPECT_FALSE(r.headers.HasHeader(net::HttpRequestHeaders::kCookie)) << r.url;
+    EXPECT_TRUE(r.referrer.is_empty()) << r.url;
+    EXPECT_EQ(r.referrer_policy, net::ReferrerPolicy::NO_REFERRER) << r.url;
+    EXPECT_EQ(r.headers.GetHeader(net::HttpRequestHeaders::kUserAgent),
+              std::optional<std::string>(UpdateClient::kUserAgent))
+        << r.url;
+  }
+}
