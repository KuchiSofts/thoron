+
+// S.15: whether somebody is signed in to Google in the profile, from the
+// browser's own list of the accounts in its cookies (kept between starts, and
+// made without a request while there is no Google cookie). The service looks
+// again when somebody signs in or out.
+class ThoronMailCenter::GoogleSignIn
+    : public signin::IdentityManager::Observer {
+ public:
+  GoogleSignIn(Profile* profile, thoron_mail::MailService* service)
+      : identity_(IdentityManagerFactory::GetForProfile(profile)),
+        service_(service) {
+    if (identity_) {
+      observation_.Observe(identity_);
+      signed_in_ = SignedIn();
+    }
+  }
+
+  bool SignedIn() const {
+    return identity_ && !identity_->GetAccountsInCookieJar()
+                             .GetPotentiallyInvalidSignedInAccounts()
+                             .empty();
+  }
+
+ private:
+  // signin::IdentityManager::Observer:
+  void OnAccountsInCookieUpdated(
+      const signin::AccountsInCookieJarInfo& accounts,
+      const GoogleServiceAuthError& error) override {
+    const bool now = !accounts.GetPotentiallyInvalidSignedInAccounts().empty();
+    if (now != signed_in_) {
+      signed_in_ = now;
+      service_->CheckNow();
+    }
+  }
+  void OnIdentityManagerShutdown(signin::IdentityManager* identity) override {
+    observation_.Reset();
+    identity_ = nullptr;
+  }
+
+  raw_ptr<signin::IdentityManager> identity_;
+  const raw_ptr<thoron_mail::MailService> service_;
+  bool signed_in_ = false;
+  base::ScopedObservation<signin::IdentityManager,
+                          signin::IdentityManager::Observer>
+      observation_{this};
+};
+
+// static
+ThoronMailCenter& ThoronMailCenter::For(Profile* profile) {
+  auto* center = static_cast<ThoronMailCenter*>(profile->GetUserData(kCenterKey));
+  if (!center) {
+    auto made = std::make_unique<ThoronMailCenter>(profile);
+    center = made.get();
+    profile->SetUserData(kCenterKey, std::move(made));
+    center->service().Start();
+  }
+  return *center;
+}
+
+ThoronMailCenter::ThoronMailCenter(Profile* profile)
+    : profile_(profile),
+      service_(std::make_unique<thoron_mail::MailService>(
+          profile->GetPrefs(),
+          base::BindRepeating(
+              [](Profile* profile)
+                  -> scoped_refptr<network::SharedURLLoaderFactory> {
+                return profile->GetDefaultStoragePartition()
+                    ->GetURLLoaderFactoryForBrowserProcess();
+              },
+              // Unretained: the service is owned by this, which is the
+              // profile's own (user data): it ends before the profile.
+              base::Unretained(profile)))) {
+  service_->AddObserver(this);
+  // S.15: Gmail is asked only while somebody is signed in to Google here.
+  // Unretained: `google_sign_in_` is this object's, as the service is.
+  google_sign_in_ = std::make_unique<GoogleSignIn>(profile, service_.get());
+  service_->SetGoogleSignedIn(base::BindRepeating(
+      &GoogleSignIn::SignedIn, base::Unretained(google_sign_in_.get())));
+  // The mailboxes added by address and password (P5.77): looked at through
+  // the profile's network context, once their passwords can be decrypted.
+  // Unretained: the service is owned by this, which is the profile's own.
+  service_->SetContextGetter(base::BindRepeating(
+      [](Profile* profile) {
+        return profile->GetDefaultStoragePartition()->GetNetworkContext();
+      },
+      base::Unretained(profile)));
+  if (g_browser_process && g_browser_process->os_crypt_async()) {
+    g_browser_process->os_crypt_async()->GetInstance(base::BindOnce(
+        &ThoronMailCenter::OnEncryptor, weak_factory_.GetWeakPtr()));
+  }
+}
+
+ThoronMailCenter::~ThoronMailCenter() {
+  service_->RemoveObserver(this);
+}
+
+void ThoronMailCenter::OpenGmail(const GURL& url, int index) {
+  if (!url.is_valid() || url.host() != "mail.google.com" ||
+      !url.SchemeIs(url::kHttpsScheme)) {
+    return;
+  }
+  // The inbox opened (from the menu or a notice): the account's new mail is
+  // counted from now (P5.76).
+  if (url == thoron_mail::MailService::InboxUrl(index)) {
+    for (const thoron_mail::MailAccount& account : service_->accounts()) {
+      if (account.index == index) {
+        service_->MarkLooked(account.email);
+      }
+    }
+  }
+  const std::string inbox = "/mail/u/" + base::NumberToString(index);
+  BrowserWindowInterface* found = nullptr;
+  int tab = -1;
+  // the person's choice: the account's Gmail tab when one is open, or a new tab
+  const bool reuse = service_->Choice("open") != "new";
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* browser) {
+        if (!reuse) {
+          return false;  // a new tab
+        }
+        if (browser->GetProfile() != profile_) {
+          return true;
+        }
+        TabStripModel* tabs = browser->GetTabStripModel();
+        for (int i = 0; i < tabs->count(); ++i) {
+          const GURL& at = tabs->GetWebContentsAt(i)->GetLastCommittedURL();
+          if (at.host() == "mail.google.com" &&
+              (at.path() == inbox || base::StartsWith(at.path(), inbox + "/"))) {
+            found = browser;
+            tab = i;
+            return false;
+          }
+        }
+        return true;
+      });
+  if (found) {
+    // a message is opened in that tab; the inbox is only brought forward
+    if (url != thoron_mail::MailService::InboxUrl(index)) {
+      found->GetTabStripModel()->GetWebContentsAt(tab)->GetController().LoadURL(
+          url, content::Referrer(), ui::PAGE_TRANSITION_LINK, std::string());
+    }
+    found->GetTabStripModel()->ActivateTabAt(tab);
+    found->GetWindow()->Activate();
+    return;
+  }
+  NavigateParams params(profile_, url, ui::PAGE_TRANSITION_LINK);
+  params.disposition = WindowOpenDisposition::kNewForegroundTab;
+  params.window_action = NavigateParams::WindowAction::kShowWindow;
+  Navigate(&params);
+}
+
+namespace {
+
+// The mailboxes a person added by address and password (P5.77): a list of
+// {email, host, port, user, webmail, secret}; `secret` is the password
+// encrypted by the system (os_crypt), in base64.
+constexpr char kImapAccountsPref[] = "thoron_mail.imap_accounts";
+// A backup is small; a file larger than this is not one.
+constexpr size_t kMostBackupBytes = 4 * 1024 * 1024;
+
+bool IsAddress(const std::string& email) {
+  const size_t at = email.find('@');
+  return at != std::string::npos && at > 0 && at + 1 < email.size() &&
+         email.size() <= 254 && base::IsStringASCII(email) &&
+         std::ranges::none_of(email, [](char c) {
+           return base::IsAsciiWhitespace(c) || c == '<' || c == '>' ||
+                  c == '"';
+         });
+}
+
+// The page a mailbox's mail is read on: https, or nothing.
+std::string CheckedWebmail(const std::string& webmail) {
+  const GURL url(webmail);
+  return url.is_valid() && url.SchemeIs(url::kHttpsScheme) &&
+                 webmail.size() <= 500
+             ? url.spec()
+             : std::string();
+}
+
+// `account` with what is left out filled in, or nullopt when it is not a
+// mailbox's details.
+std::optional<thoron_mail::ImapAccount> CheckedAccount(
+    thoron_mail::ImapAccount account) {
+  account.email = std::string(
+      base::TrimWhitespaceASCII(account.email, base::TRIM_ALL));
+  account.host = base::ToLowerASCII(
+      base::TrimWhitespaceASCII(account.host, base::TRIM_ALL));
+  if (account.user.empty()) {
+    account.user = account.email;
+  }
+  account.webmail = CheckedWebmail(account.webmail);
+  if (!IsAddress(account.email) || !thoron_mail::IsImapHost(account.host) ||
+      account.port <= 0 || account.port > 65535 || account.password.empty() ||
+      account.password.size() > 1024 || account.user.size() > 320) {
+    return std::nullopt;
+  }
+  return account;
+}
+
+// The backup's text sealed, or opened, off the UI thread (slow on purpose).
+std::string Sealed(std::string backup, std::string passphrase) {
+  return thoron_mail::SealBackup(backup, passphrase);
+}
+
+std::optional<std::string> Opened(std::string file, std::string passphrase) {
+  return thoron_mail::OpenBackup(file, passphrase);
+}
+
+}  // namespace
+
+void ThoronMailCenter::OnEncryptor(
+    scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+  encryptor_ = std::move(encryptor);
+  service_->SetImapAccounts(KeptImapAccounts());
+}
+
+std::vector<thoron_mail::ImapAccount> ThoronMailCenter::KeptImapAccounts()
+    const {
+  std::vector<thoron_mail::ImapAccount> accounts;
+  if (!encryptor_) {
+    return accounts;
+  }
+  for (const base::Value& value :
+       profile_->GetPrefs()->GetList(kImapAccountsPref)) {
+    const base::DictValue* dict = value.GetIfDict();
+    const std::string* email = dict ? dict->FindString("email") : nullptr;
+    const std::string* host = dict ? dict->FindString("host") : nullptr;
+    const std::string* secret = dict ? dict->FindString("secret") : nullptr;
+    std::string encrypted;
+    thoron_mail::ImapAccount account;
+    if (!email || !host || !secret ||
+        !base::Base64Decode(*secret, &encrypted) ||
+        !encryptor_->DecryptString(encrypted, &account.password)) {
+      continue;
+    }
+    account.email = *email;
+    account.host = *host;
+    account.port = dict->FindInt("port").value_or(993);
+    if (const std::string* user = dict->FindString("user")) {
+      account.user = *user;
+    }
+    if (const std::string* webmail = dict->FindString("webmail")) {
+      account.webmail = *webmail;
+    }
+    if (std::optional<thoron_mail::ImapAccount> checked =
+            CheckedAccount(std::move(account))) {
+      accounts.push_back(std::move(*checked));
+    }
+  }
+  return accounts;
+}
+
+bool ThoronMailCenter::KeepImapAccounts(
+    const std::vector<thoron_mail::ImapAccount>& accounts) {
+  if (!encryptor_) {
+    return false;
+  }
+  base::ListValue kept;
+  for (const thoron_mail::ImapAccount& account : accounts) {
+    std::string encrypted;
+    if (!encryptor_->EncryptString(account.password, &encrypted)) {
+      return false;
+    }
+    kept.Append(base::DictValue()
+                    .Set("email", account.email)
+                    .Set("host", account.host)
+                    .Set("port", account.port)
+                    .Set("user", account.user)
+                    .Set("webmail", account.webmail)
+                    .Set("secret", base::Base64Encode(encrypted)));
+  }
+  profile_->GetPrefs()->SetList(kImapAccountsPref, std::move(kept));
+  service_->SetImapAccounts(accounts);
+  return true;
+}
+
+void ThoronMailCenter::AddImapAccount(thoron_mail::ImapAccount account,
+                                      Told told) {
+  std::optional<thoron_mail::ImapAccount> checked =
+      CheckedAccount(std::move(account));
+  if (!checked) {
+    std::move(told).Run("bad");
+    return;
+  }
+  if (!encryptor_) {
+    std::move(told).Run("locked");
+    return;
+  }
+  const std::vector<thoron_mail::ImapAccount>& known =
+      service_->imap_accounts();
+  if (std::ranges::any_of(known, [&](const thoron_mail::ImapAccount& other) {
+        return base::EqualsCaseInsensitiveASCII(other.email, checked->email);
+      })) {
+    std::move(told).Run("exists");
+    return;
+  }
+  if (known.size() >= thoron_mail::MailService::kMostImapAccounts) {
+    std::move(told).Run("full");
+    return;
+  }
+  if (imap_test_) {
+    std::move(told).Run("busy");
+    return;
+  }
+  // Signed in to once before it is kept: a wrong password is told at once.
+  thoron_mail::ImapAccount to_test = *checked;
+  imap_test_ = std::make_unique<thoron_mail::ImapCheck>(
+      profile_->GetDefaultStoragePartition()->GetNetworkContext(), to_test,
+      base::BindOnce(&ThoronMailCenter::OnImapTested,
+                     weak_factory_.GetWeakPtr(), std::move(*checked),
+                     std::move(told)));
+}
+
+void ThoronMailCenter::OnImapTested(thoron_mail::ImapAccount account,
+                                    Told told,
+                                    thoron_mail::ImapCheck::Result result) {
+  // this runs from inside the test
+  base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+      FROM_HERE, std::move(imap_test_));
+  if (!result.problem.empty()) {
+    std::move(told).Run(result.problem);
+    return;
+  }
+  std::vector<thoron_mail::ImapAccount> accounts = service_->imap_accounts();
+  accounts.push_back(std::move(account));
+  std::move(told).Run(KeepImapAccounts(accounts) ? std::string() : "locked");
+}
+
+void ThoronMailCenter::RemoveImapAccount(const std::string& email) {
+  std::vector<thoron_mail::ImapAccount> accounts = service_->imap_accounts();
+  const size_t before = accounts.size();
+  std::erase_if(accounts, [&](const thoron_mail::ImapAccount& account) {
+    return account.email == email;
+  });
+  if (accounts.size() != before) {
+    KeepImapAccounts(accounts);
+  }
+}
