@@ -0,0 +1,76 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_update/setup_plan.h"
+
+namespace thoron_update {
+
+SetupPlan PlanSetup(std::string_view manifest,
+                    std::string_view signature,
+                    const std::vector<PublicKey>& keys,
+                    const std::vector<std::string>& allowed_hosts,
+                    const std::string& channel,
+                    const BuildVersion& own_build,
+                    const Processor& cpu,
+                    int64_t now,
+                    std::optional<Variant> only) {
+  SetupPlan plan;
+  std::vector<Variant> variants = VariantsFor(Os::kWindows, cpu);
+  if (only) {
+    std::erase_if(variants, [&](Variant variant) { return variant != *only; });
+  }
+  if (variants.empty()) {
+    plan.outcome = Outcome::kNoPackage;
+    return plan;
+  }
+  for (Variant variant : variants) {
+    CopyInfo copy;
+    copy.allowed_hosts = allowed_hosts;
+    copy.channel = channel;
+    copy.installed = BuildVersion();  // nothing installed
+    copy.updater = own_build;
+    copy.variant = variant;
+    copy.kind = Kind::kInstalled;
+    const Decision decision = CheckUpdateWithKeys(manifest, signature, copy, keys, now);
+    plan.outcome = decision.outcome;
+    plan.variant = variant;
+    if (decision.manifest) {
+      plan.version = ToString(decision.manifest->version);
+      plan.thoron_version = decision.manifest->thoron_version;
+    }
+    if (decision.outcome == Outcome::kUpdate && decision.full) {
+      plan.file = decision.full;
+      return plan;
+    }
+    // Only a release without an installer for this build gives way to the
+    // next build; anything else is the answer.
+    if (decision.outcome != Outcome::kNoPackage) {
+      return plan;
+    }
+  }
+  return plan;
+}
+
+std::string SetupMessage(const SetupPlan& plan) {
+  switch (plan.outcome) {
+    case Outcome::kUpdate:
+      return "Thoron " + plan.thoron_version + " is ready to install.";
+    case Outcome::kNoPackage:
+      return plan.version.empty()
+                 ? "This computer's processor is too old for Thoron: it needs SSE4.2 at least."
+                 : "Thoron " + plan.thoron_version + " has no installer for this computer yet.";
+    case Outcome::kUpdaterTooOld:
+      return "This copy of Thoron Setup is too old for the newest release. Download Thoron Setup "
+             "again from Thoron's releases page on GitHub.";
+    case Outcome::kNotYetValid:
+    case Outcome::kExpired:
+      return "Thoron Setup cannot verify the release (" + std::string(OutcomeName(plan.outcome)) +
+             "), so it installs nothing. If this computer's date and time are wrong, set them and "
+             "try again.";
+    default:
+      return "Thoron Setup cannot verify the release (" + std::string(OutcomeName(plan.outcome)) +
+             "), so it installs nothing.";
+  }
+}
+
+}  // namespace thoron_update
diff --git a/components/thoron_update/setup_plan.h b/components/thoron_update/setup_plan.h
new file mode 100644
index 0000000000000000000000000000000000000000..2822065a5320559a03d4def5d63039dfbc45b2a2
--- /dev/null
+++ b/components/thoron_update/setup_plan.h
@@ -0,0 +1,53 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_UPDATE_SETUP_PLAN_H_
+#define COMPONENTS_THORON_UPDATE_SETUP_PLAN_H_
+
+#include <stdint.h>
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "components/thoron_update/manifest.h"
+#include "components/thoron_update/package.h"
+
+// What the one installer for good, ThoronSetup.exe (ROADMAP P3.19), downloads:
+// the newest release's full installer for the fastest build this processor
+// runs. It is an updater too, from nothing installed (0.0.0.0): the manifest is
+// checked as any updater checks it (manifest.h), and a release whose
+// min_updater_version is above ThoronSetup's own build stops it.
+namespace thoron_update {
+
+struct SetupPlan {
+  // kUpdate: `file` is the installer to download; anything else is why not.
+  Outcome outcome = Outcome::kInvalidCopy;
+  std::optional<PackageFile> file;
+  Variant variant = Variant::kWinX64Sse4;
+  std::string version;         // the release's build version
+  std::string thoron_version;  // and Thoron's own, for people
+};
+
+// The plan for the manifest and signature as fetched, under `keys`, on this
+// processor (`cpu`, Windows). The variants that run on it are tried fastest
+// first; one without an installer gives way to the next (AVX2, then SSE4).
+// With `only`, that build alone is tried (the daily look of an installed copy
+// keeps its build, P3.10).
+SetupPlan PlanSetup(std::string_view manifest,
+                    std::string_view signature,
+                    const std::vector<PublicKey>& keys,
+                    const std::vector<std::string>& allowed_hosts,
+                    const std::string& channel,
+                    const BuildVersion& own_build,
+                    const Processor& cpu,
+                    int64_t now,
+                    std::optional<Variant> only = std::nullopt);
+
+// A sentence for the person about a plan that is not kUpdate.
+std::string SetupMessage(const SetupPlan& plan);
+
+}  // namespace thoron_update
+
+#endif  // COMPONENTS_THORON_UPDATE_SETUP_PLAN_H_
diff --git a/components/thoron_update/setup_plan_unittest.cc b/components/thoron_update/setup_plan_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..78e3db6b5690224ec235a8af17757658d9505961
--- /dev/null
+++ b/components/thoron_update/setup_plan_unittest.cc
@@ -0,0 +1,108 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_update/setup_plan.h"
+
+#include <string>
+
+#include "components/thoron_update/update_client_test_data.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace thoron_update {
+namespace {
+
+namespace data = client_test;
+
+std::string Bytes(const uint8_t* bytes, size_t n) {
+  return std::string(reinterpret_cast<const char*>(bytes), n);
+}
+
+PublicKey TestKey() {
+  PublicKey key;
+  std::copy(std::begin(data::kPublicKey), std::end(data::kPublicKey), key.begin());
+  return key;
+}
+
+Processor Cpu(bool sse4, bool avx2) {
+  Processor cpu;
+  cpu.x64 = true;
+  cpu.sse41 = cpu.sse42 = sse4;
+  cpu.avx = cpu.avx2 = cpu.fma3 = avx2;
+  return cpu;
+}
+
+SetupPlan Plan(const Processor& cpu,
+               const std::string& build = data::kInstalled,
+               int64_t now = data::kNow,
+               std::string signature = Bytes(data::kSignature, sizeof(data::kSignature))) {
+  return PlanSetup(data::kManifest, signature, {TestKey()}, {"github.com"}, "stable",
+                   *ParseBuildVersion(build), cpu, now);
+}
+
+TEST(ThoronUpdateSetupPlanTest, TheNewestFullInstallerForTheFastestBuild) {
+  const SetupPlan plan = Plan(Cpu(true, true));
+  EXPECT_EQ(plan.outcome, Outcome::kUpdate);
+  ASSERT_TRUE(plan.file);
+  // the full installer, never a delta: nothing is installed yet
+  EXPECT_EQ(plan.file->url, data::kInstallerUrl);
+  EXPECT_EQ(plan.variant, Variant::kWinX64Avx2);
+  EXPECT_EQ(plan.version, data::kNewest);
+  EXPECT_EQ(plan.thoron_version, "0.1.2");
+}
+
+TEST(ThoronUpdateSetupPlanTest, AProcessorWithoutAvx2GetsTheSse4BuildOrIsTold) {
+  // the test release has no SSE4 installer
+  const SetupPlan plan = Plan(Cpu(true, false));
+  EXPECT_EQ(plan.outcome, Outcome::kNoPackage);
+  EXPECT_EQ(plan.variant, Variant::kWinX64Sse4);
+  EXPECT_NE(SetupMessage(plan).find("no installer for this computer yet"), std::string::npos);
+  const SetupPlan old = Plan(Cpu(false, false));
+  EXPECT_EQ(old.outcome, Outcome::kNoPackage);
+  EXPECT_NE(SetupMessage(old).find("too old for Thoron"), std::string::npos);
+}
+
+TEST(ThoronUpdateSetupPlanTest, TheDailyLookKeepsTheInstalledBuild) {
+  // An SSE4 copy on an AVX2 processor stays SSE4: the release has no SSE4
+  // installer, so there is nothing for it, not the AVX2 one.
+  const SetupPlan sse4 = PlanSetup(data::kManifest, Bytes(data::kSignature, sizeof(data::kSignature)),
+                                   {TestKey()}, {"github.com"}, "stable",
+                                   *ParseBuildVersion(data::kInstalled), Cpu(true, true), data::kNow,
+                                   Variant::kWinX64Sse4);
+  EXPECT_EQ(sse4.outcome, Outcome::kNoPackage);
+  EXPECT_EQ(sse4.variant, Variant::kWinX64Sse4);
+  EXPECT_FALSE(sse4.file);
+  const SetupPlan avx2 = PlanSetup(data::kManifest, Bytes(data::kSignature, sizeof(data::kSignature)),
+                                   {TestKey()}, {"github.com"}, "stable",
+                                   *ParseBuildVersion(data::kInstalled), Cpu(true, true), data::kNow,
+                                   Variant::kWinX64Avx2);
+  EXPECT_EQ(avx2.outcome, Outcome::kUpdate);
+  ASSERT_TRUE(avx2.file);
+  EXPECT_EQ(avx2.file->url, data::kInstallerUrl);
+  // A build this processor cannot run gets nothing.
+  const SetupPlan none = PlanSetup(data::kManifest, Bytes(data::kSignature, sizeof(data::kSignature)),
+                                   {TestKey()}, {"github.com"}, "stable",
+                                   *ParseBuildVersion(data::kInstalled), Cpu(true, false), data::kNow,
+                                   Variant::kWinX64Avx2);
+  EXPECT_EQ(none.outcome, Outcome::kNoPackage);
+}
+
+TEST(ThoronUpdateSetupPlanTest, ASetupBelowTheMinimumUpdaterStops) {
+  const SetupPlan plan = Plan(Cpu(true, true), "158.0.8127.2999");
+  EXPECT_EQ(plan.outcome, Outcome::kUpdaterTooOld);
+  EXPECT_NE(SetupMessage(plan).find("Download Thoron Setup again"), std::string::npos);
+}
+
+TEST(ThoronUpdateSetupPlanTest, NothingIsInstalledFromAReleaseThatDoesNotVerify) {
+  std::string forged = Bytes(data::kSignature, sizeof(data::kSignature));
+  forged[3] ^= 1;
+  const SetupPlan bad = Plan(Cpu(true, true), data::kInstalled, data::kNow, forged);
+  EXPECT_EQ(bad.outcome, Outcome::kBadSignature);
+  EXPECT_FALSE(bad.file);
+  EXPECT_NE(SetupMessage(bad).find("installs nothing"), std::string::npos);
+  const SetupPlan expired = Plan(Cpu(true, true), data::kInstalled, data::kNow + 200 * 86400);
+  EXPECT_EQ(expired.outcome, Outcome::kExpired);
+  EXPECT_NE(SetupMessage(expired).find("date and time"), std::string::npos);
+}
+
+}  // namespace
+}  // namespace thoron_update
