+  // The switch for every site (P5.70): [id, on, minutes] (minutes: off for
+  // that long, -1 until the browser closes, 0 until switched on again).
+  void SetBlocking(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 2);
+    if (!id || !args[1].is_bool() || !args[2].is_int()) {
+      return;
+    }
+    Answer(*id, thoron_adblock::ProxyingURLLoaderFactory::SetBlockingEverywhere(
+                    SiteSettings(), args[1].GetBool(), args[2].GetInt())
+                    ? std::string()
+                    : std::string("This is not a choice."));
+  }
+
+  void SetSetting(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 2);
+    if (!id || !args[1].is_string()) {
+      return;
+    }
+    const std::string& name = args[1].GetString();
+    // "Block media elements larger than N kB": a whole number
+    if (name == "accent") {
+      Answer(*id, args[2].is_string() && Service().SetAccent(args[2].GetString())
+                      ? std::string()
+                      : std::string("This is not a colour."));
+      return;
+    }
+    if (thoron_adblock::EngineService::KnownChoiceName(name)) {
+      Answer(*id, args[2].is_string() &&
+                          Service().SetChoice(name, args[2].GetString())
+                      ? std::string()
+                      : std::string("This is not a choice."));
+      return;
+    }
+    if (name == "theme") {
+      Answer(*id, args[2].is_string() && Service().SetTheme(args[2].GetString())
+                      ? std::string()
+                      : std::string("This is not a theme."));
+      return;
+    }
+    if (name == "media-kb") {
+      Answer(*id, args[2].is_int() && Service().SetLargeMediaKb(args[2].GetInt())
+                      ? std::string()
+                      : std::string("Give a whole number of kB, from 1 to 1048576."));
+      return;
+    }
+    if (!args[2].is_bool()) {
+      return;
+    }
+    const bool on = args[2].GetBool();
+    PrefService* prefs = Profile::FromWebUI(web_ui())->GetPrefs();
+    if (thoron_adblock::EngineService::KnownOption(name)) {
+      Service().SetOption(name, on);
+    } else if (name == "javascript") {
+      SiteSettings()->SetDefaultContentSetting(
+          ContentSettingsType::JAVASCRIPT,
+          on ? CONTENT_SETTING_BLOCK : CONTENT_SETTING_DEFAULT);
+    } else if (name == "prefetch" || name == "hyperlink-auditing" ||
+               name == "webrtc") {
+      // on: the protective value; off: the browser's own default again
+      const char* pref = name == "prefetch" ? prefs::kNetworkPredictionOptions
+                         : name == "webrtc" ? prefs::kWebRTCIPHandlingPolicy
+                                            : prefs::kEnableHyperlinkAuditing;
+      if (!on) {
+        prefs->ClearPref(pref);
+      } else if (name == "prefetch") {
+        prefs->SetInteger(pref, static_cast<int>(
+                                    prefetch::NetworkPredictionOptions::kDisabled));
+      } else if (name == "webrtc") {
+        prefs->SetString(pref,
+                         blink::kWebRTCIPHandlingDefaultPublicInterfaceOnly);
+      } else {
+        prefs->SetBoolean(pref, false);
+      }
+    } else {
+      Answer(*id, "This is not a setting.");
+      return;
+    }
+    Answer(*id, std::string());
+  }
