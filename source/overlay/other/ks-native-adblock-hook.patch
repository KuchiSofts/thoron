@@ -0,0 +1,39 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_PORTABLE_KEY_RECOVERY_KEY_H_
+#define COMPONENTS_THORON_PORTABLE_KEY_RECOVERY_KEY_H_
+
+#include <stddef.h>
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "components/thoron_portable_key/secret_bytes.h"
+
+namespace thoron_portable_key {
+
+// A recovery key (threat model E4) is 128 random bits, never derived from the
+// passphrase, with a 32-bit check: 160 bits written as 32 characters of
+// Crockford's base 32 in eight groups of four, "7K3Q-....". The check is the
+// start of SHA-256 over a label and the random bits, so a mistyped character
+// is caught before anything is tried.
+inline constexpr size_t kRecoveryKeyBytes = 16;
+inline constexpr size_t kRecoveryKeyCharacters = 32;
+
+// 16 new random bytes.
+SecretBytes NewRecoveryKey();
+
+// The text a person writes down; empty unless `key` has kRecoveryKeyBytes.
+std::string FormatRecoveryKey(const SecretBytes& key);
+
+// The 16 bytes of a recovery key as a person typed it: letters in either case,
+// with or without the dashes and spaces; O is read as 0, and I and L as 1, as
+// Crockford's base 32 does. nullopt when it is not 32 characters or its check
+// does not hold.
+std::optional<SecretBytes> ParseRecoveryKey(std::string_view typed);
+
+}  // namespace thoron_portable_key
+
+#endif  // COMPONENTS_THORON_PORTABLE_KEY_RECOVERY_KEY_H_
diff --git a/components/thoron_portable_key/recovery_key_unittest.cc b/components/thoron_portable_key/recovery_key_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..1e6b8e21f07ad5fbd5bbee8e60f56f21c57295cc
--- /dev/null
+++ b/components/thoron_portable_key/recovery_key_unittest.cc
@@ -0,0 +1,101 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_portable_key/recovery_key.h"
+
+#include <algorithm>
+#include <string>
+#include <string_view>
+
+#include "base/strings/string_util.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace thoron_portable_key {
+namespace {
+
+constexpr std::string_view kAlphabet = "0123456789ABCDEFGHJKMNPQRSTVWXYZ";
+
+SecretBytes KeyOf(uint8_t start) {
+  SecretBytes key(kRecoveryKeyBytes);
+  for (size_t i = 0; i < key.size(); ++i) {
+    key.span()[i] = static_cast<uint8_t>(start + 37 * i);
+  }
+  return key;
+}
+
+TEST(ThoronRecoveryKeyTest, NewKeysAreRandomAndOfTheirSize) {
+  const SecretBytes first = NewRecoveryKey();
+  const SecretBytes second = NewRecoveryKey();
+  EXPECT_EQ(first.size(), kRecoveryKeyBytes);
+  EXPECT_EQ(second.size(), kRecoveryKeyBytes);
+  EXPECT_FALSE(first == second);
+}
+
+TEST(ThoronRecoveryKeyTest, FormatIsEightGroupsOfFour) {
+  const std::string text = FormatRecoveryKey(KeyOf(3));
+  ASSERT_EQ(text.size(), 39u);
+  for (size_t i = 0; i < text.size(); ++i) {
+    if (i % 5 == 4) {
+      EXPECT_EQ(text[i], '-') << i;
+    } else {
+      EXPECT_NE(kAlphabet.find(text[i]), std::string_view::npos) << i;
+    }
+  }
+  EXPECT_TRUE(FormatRecoveryKey(SecretBytes(15)).empty());
+}
+
+TEST(ThoronRecoveryKeyTest, ReadsWhatAPersonTypes) {
+  for (uint8_t start : {0, 1, 99, 255}) {
+    const SecretBytes key = KeyOf(start);
+    const std::string text = FormatRecoveryKey(key);
+    std::string without_dashes;
+    base::RemoveChars(text, "-", &without_dashes);
+    std::string spaced = text;
+    std::replace(spaced.begin(), spaced.end(), '-', ' ');
+    // O for 0, and I or L for 1, in either case
+    std::string confused = base::ToLowerASCII(text);
+    std::replace(confused.begin(), confused.end(), '0', 'o');
+    std::replace(confused.begin(), confused.end(), '1', 'l');
+    for (const std::string& typed :
+         {text, without_dashes, spaced, base::ToLowerASCII(text), confused}) {
+      std::optional<SecretBytes> read = ParseRecoveryKey(typed);
+      ASSERT_TRUE(read.has_value()) << typed;
+      EXPECT_TRUE(*read == key) << typed;
+    }
+  }
+}
+
+// Threat model E4: every single mistyped character is caught by the check.
+TEST(ThoronRecoveryKeyTest, EveryMistypedCharacterIsCaught) {
+  const std::string text = FormatRecoveryKey(KeyOf(42));
+  for (size_t i = 0; i < text.size(); ++i) {
+    if (text[i] == '-') {
+      continue;
+    }
+    for (char c : kAlphabet) {
+      if (c == text[i]) {
+        continue;
+      }
+      std::string typed = text;
+      typed[i] = c;
+      EXPECT_FALSE(ParseRecoveryKey(typed).has_value()) << typed;
+    }
+  }
+}
+
+TEST(ThoronRecoveryKeyTest, RefusesWhatIsNotARecoveryKey) {
+  const std::string text = FormatRecoveryKey(KeyOf(7));
+  EXPECT_FALSE(ParseRecoveryKey(text.substr(0, text.size() - 1)));
+  EXPECT_FALSE(ParseRecoveryKey(text + "0"));
+  EXPECT_FALSE(ParseRecoveryKey(""));
+  // U is not a character of Crockford's base 32
+  std::string with_u = text;
+  with_u[0] = 'U';
+  EXPECT_FALSE(ParseRecoveryKey(with_u));
+  std::string with_symbol = text;
+  with_symbol[1] = '*';
+  EXPECT_FALSE(ParseRecoveryKey(with_symbol));
+}
+
+}  // namespace
+}  // namespace thoron_portable_key
