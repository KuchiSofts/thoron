+void DetectChromiumFamilyProfiles(
+    std::vector<user_data_importer::SourceProfile>* profiles) {
+  user_data_importer::chromium_family::DetectionFolders folders;
+  base::FilePath path;
 #if BUILDFLAG(IS_WIN)
+  if (base::PathService::Get(base::DIR_LOCAL_APP_DATA, &path)) {
+    folders.local_app_data = path;
+  }
+  if (base::PathService::Get(base::DIR_ROAMING_APP_DATA, &path)) {
+    folders.roaming_app_data = path;
+  }
+#else
+  // $XDG_CONFIG_HOME, or ~/.config.
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  folders.config_home = base::nix::GetXDGDirectory(
+      env.get(), base::nix::kXdgConfigHomeEnvVar, base::nix::kDotConfigDir);
+#endif
+  // Our own user data folder, so Thoron is never offered as a source.
+  if (base::PathService::Get(chrome::DIR_USER_DATA, &path)) {
+    folders.own_user_data = path;
+  }
+
+  for (user_data_importer::SourceProfile& source :
+       user_data_importer::chromium_family::DetectSourceProfiles(folders)) {
+    profiles->push_back(std::move(source));
+  }
+}
