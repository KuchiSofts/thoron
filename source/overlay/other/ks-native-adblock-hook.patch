+bool IsImapHost(const std::string& host) {
+  if (host.empty() || host.size() > 253 || host.front() == '.' ||
+      host.front() == '-' || host.back() == '-') {
+    return false;
+  }
+  for (char c : host) {
+    if (!base::IsAsciiAlphaNumeric(c) && c != '.' && c != '-') {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool IsLocalImapHost(const std::string& host) {
+  return host == "127.0.0.1" || host == "localhost";
+}
+
+bool IsCertificatePin(const std::string& pin) {
+  return pin.size() == 64 && std::ranges::all_of(pin, base::IsHexDigit<char>);
+}
