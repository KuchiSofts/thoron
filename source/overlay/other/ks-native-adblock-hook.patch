+// Thoron (ROADMAP P3.22): a session file of one window with a tab on `url`,
+// complete (with the marker) or still being written.
+std::string ThoronSessionFile(const std::string& url, bool complete) {
+  std::string out;
+  auto append = [&out](base::span<const uint8_t> bytes) {
+    out.append(bytes.begin(), bytes.end());
+  };
+  append(base::U32ToLittleEndian(0x53534E53));
+  append(base::U32ToLittleEndian(3));
+  auto add = [&](std::unique_ptr<sessions::SessionCommand> command) {
+    append(base::U16ToLittleEndian(
+        static_cast<uint16_t>(command->contents().size() + 1)));
+    out.push_back(static_cast<char>(command->id()));
+    append(command->contents());
+  };
+  const SessionID window = SessionID::FromSerializedValue(1);
+  const SessionID tab = SessionID::FromSerializedValue(2);
+  add(sessions::CreateSetWindowTypeCommand(
+      window, sessions::SessionWindow::TYPE_NORMAL));
+  add(sessions::CreateSetTabWindowCommand(window, tab));
+  sessions::SerializedNavigationEntry page;
+  page.set_index(0);
+  page.set_virtual_url(GURL(url));
+  add(sessions::CreateUpdateTabNavigationCommand(tab, page));
+  add(sessions::CreateSetSelectedNavigationIndexCommand(tab, 0));
+  if (complete) {
+    append(base::U16ToLittleEndian(1));
+    out.push_back(static_cast<char>(255));
+  }
+  return out;
+}
