diff --git a/components/thoron_mail/imap.rs b/components/thoron_mail/imap.rs
new file mode 100644
index 0000000000000000000000000000000000000000..753dfc535012eaa8817b1b83f3ec91acf79e2484
--- /dev/null
+++ b/components/thoron_mail/imap.rs
@@ -0,0 +1,849 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! One look at a mailbox over IMAP for Thoron M-Notifier (P5.77): sign in, count the unread
+//! messages of the inbox and read who sent the newest ones and what they are about. Nothing in
+//! the mailbox is changed (the inbox is opened read-only and the messages are only peeked at).
+//!
+//! What a mail server sends is not to be trusted, so everything that reads it is here, in Rust:
+//! the browser (imap_check.cc) only carries bytes between the server and `ImapSession`, which says
+//! what to send next. Sizes are bounded; a server that sends too much ends the look.
+
+use base64::Engine as _;
+
+#[cxx::bridge(namespace = "thoron_mail")]
+mod ffi {
+    /// One piece of a header's text: `bytes` in `charset` (lower case; "" for plain text, which
+    /// is read as UTF-8).
+    struct ImapText {
+        charset: String,
+        bytes: Vec<u8>,
+    }
+
+    /// One unread message of the inbox.
+    struct ImapMessage {
+        /// "<UIDVALIDITY>:<UID>": the same for as long as the message is in the inbox.
+        id: String,
+        from_email: String,
+        from_name: Vec<ImapText>,
+        subject: Vec<ImapText>,
+        /// When the server got it, ms since 1970 (0 when it did not say).
+        issued_ms: i64,
+    }
+
+    /// What the browser does next: sends `send` (may be empty), and stops when `done`.
+    struct ImapStep {
+        send: Vec<u8>,
+        done: bool,
+    }
+
+    extern "Rust" {
+        type ImapSession;
+        /// A look for `user` with `password`, reading at most `most` of the newest unread messages.
+        fn imap_session(user: &str, password: &str, most: u32) -> Box<ImapSession>;
+        /// What the server sent, in the order it came.
+        fn on_bytes(self: &mut ImapSession, data: &[u8]) -> ImapStep;
+        /// The server closed the connection, or it broke: the look is over.
+        fn on_closed(self: &mut ImapSession);
+        /// "" when the look ended well; else "sign-in" (the server refused the name or the
+        /// password), "protocol" (the server said something this does not understand, or refused
+        /// the inbox), "too-much" (it sent more than a look may take) or "offline" (the connection
+        /// ended before the look did).
+        fn problem(self: &ImapSession) -> String;
+        /// How many unread messages the inbox has.
+        fn unseen(self: &ImapSession) -> u32;
+        /// The newest unread messages, newest first.
+        fn messages(self: &ImapSession) -> Vec<ImapMessage>;
+    }
+}
+
+use ffi::{ImapMessage, ImapStep, ImapText};
+
+/// The most a look takes from a server in all, and for one literal (a message's headers).
+const MAX_TOTAL: usize = 2 * 1024 * 1024;
+const MAX_LITERAL: usize = 64 * 1024;
+/// The most of a name or a subject that is kept.
+const MAX_TEXT: usize = 400;
+
+#[derive(PartialEq, Clone, Copy, Debug)]
+enum State {
+    Greeting,
+    Capability,
+    Auth,
+    Examine,
+    Search,
+    Fetch,
+    Logout,
+    Done,
+}
+
+/// A piece of one response: its text, or a literal it carried.
+enum Part {
+    Text(Vec<u8>),
+    Literal(Vec<u8>),
+}
+
+pub struct ImapSession {
+    state: State,
+    buf: Vec<u8>,
+    taken: usize,
+    most: usize,
+    /// "\0user\0password" in base64, until it is sent.
+    auth: String,
+    login: Option<String>,
+    capabilities: Vec<String>,
+    waiting_for_continuation: bool,
+    uid_validity: String,
+    uids: Vec<u32>,
+    unseen: u32,
+    messages: Vec<ImapMessage>,
+    problem: String,
+}
+
+fn imap_session(user: &str, password: &str, most: u32) -> Box<ImapSession> {
+    let plain = format!("\0{user}\0{password}");
+    Box::new(ImapSession {
+        state: State::Greeting,
+        buf: Vec::new(),
+        taken: 0,
+        most: most.clamp(1, 50) as usize,
+        auth: base64::engine::general_purpose::STANDARD.encode(plain.as_bytes()),
+        login: quoted(user).zip(quoted(password)).map(|(u, p)| format!("{u} {p}")),
+        capabilities: Vec::new(),
+        waiting_for_continuation: false,
+        uid_validity: String::new(),
+        uids: Vec::new(),
+        unseen: 0,
+        messages: Vec::new(),
+        problem: String::new(),
+    })
+}
+
+/// `text` as an IMAP quoted string, when it can be one (no line break, no NUL, ASCII).
+fn quoted(text: &str) -> Option<String> {
+    if !text.is_ascii() || text.bytes().any(|b| b == b'\r' || b == b'\n' || b == 0) {
+        return None;
+    }
+    Some(format!("\"{}\"", text.replace('\\', "\\\\").replace('"', "\\\"")))
+}
+
+impl ImapSession {
+    fn on_bytes(&mut self, data: &[u8]) -> ImapStep {
+        let mut send = Vec::new();
+        if self.state == State::Done {
+            return ImapStep { send, done: true };
+        }
+        self.taken += data.len();
+        if self.taken > MAX_TOTAL {
+            return self.fail("too-much");
+        }
+        self.buf.extend_from_slice(data);
+        loop {
+            match self.next_response() {
+                Err(()) => return self.fail("too-much"),
+                Ok(None) => break,
+                Ok(Some(parts)) => {
+                    self.handle(&parts, &mut send);
+                    if self.state == State::Done {
+                        break;
+                    }
+                }
+            }
+        }
+        ImapStep { send, done: self.state == State::Done }
+    }
+
+    fn on_closed(&mut self) {
+        if self.state == State::Logout {
+            // it said goodbye by closing
+            self.state = State::Done;
+        } else if self.state != State::Done {
+            self.fail("offline");
+        }
+    }
+
+    fn fail(&mut self, problem: &str) -> ImapStep {
+        if self.problem.is_empty() {
+            self.problem = problem.to_string();
+        }
+        self.state = State::Done;
+        self.forget_secret();
+        ImapStep { send: Vec::new(), done: true }
+    }
+
+    fn forget_secret(&mut self) {
+        // not left in memory longer than needed
+        self.auth = "\0".repeat(self.auth.len());
+        self.auth.clear();
+        self.login = None;
+    }
+
+    /// The next whole response in the buffer (a line, with the literals it carries), taken out of
+    /// it; None while it is not all there; Err when a literal is larger than a look may take.
+    fn next_response(&mut self) -> Result<Option<Vec<Part>>, ()> {
+        let mut parts = Vec::new();
+        let mut at = 0;
+        loop {
+            let Some(end) = find_crlf(&self.buf[at..]) else { return Ok(None) };
+            let line = &self.buf[at..at + end];
+            at += end + 2;
+            match literal_size(line) {
+                None => {
+                    parts.push(Part::Text(line.to_vec()));
+                    break;
+                }
+                Some(size) => {
+                    if size > MAX_LITERAL {
+                        return Err(());
+                    }
+                    if self.buf.len() < at + size {
+                        return Ok(None);
+                    }
+                    parts.push(Part::Text(line.to_vec()));
+                    parts.push(Part::Literal(self.buf[at..at + size].to_vec()));
+                    at += size;
+                }
+            }
+        }
+        self.buf.drain(..at);
+        Ok(Some(parts))
+    }
+
+    fn handle(&mut self, parts: &[Part], send: &mut Vec<u8>) {
+        let Some(Part::Text(first)) = parts.first() else { return };
+        let line = String::from_utf8_lossy(first).to_string();
+        let upper = line.to_ascii_uppercase();
+        match self.state {
+            State::Greeting => {
+                if upper.starts_with("* OK") || upper.starts_with("* PREAUTH") {
+                    self.note_capabilities(&upper);
+                    send.extend_from_slice(b"a1 CAPABILITY\r\n");
+                    self.state = State::Capability;
+                } else {
+                    self.problem = "protocol".to_string();
+                    self.state = State::Done;
+                }
+            }
+            State::Capability => {
+                if upper.starts_with("* CAPABILITY") {
+                    self.note_capabilities(&upper);
+                } else if upper.starts_with("A1 ") {
+                    self.sign_in(send);
+                }
+            }
+            State::Auth => {
+                if line.starts_with('+') && self.waiting_for_continuation {
+                    self.waiting_for_continuation = false;
+                    send.extend_from_slice(self.auth.as_bytes());
+                    send.extend_from_slice(b"\r\n");
+                } else if upper.starts_with("A2 OK") {
+                    self.forget_secret();
+                    send.extend_from_slice(b"a3 EXAMINE INBOX\r\n");
+                    self.state = State::Examine;
+                } else if upper.starts_with("A2 ") {
+                    self.problem = "sign-in".to_string();
+                    self.forget_secret();
+                    self.state = State::Done;
+                }
+            }
+            State::Examine => {
+                if let Some(value) = bracket_value(&upper, "UIDVALIDITY") {
+                    self.uid_validity = value;
+                } else if upper.starts_with("A3 OK") {
+                    send.extend_from_slice(b"a4 UID SEARCH UNSEEN\r\n");
+                    self.state = State::Search;
+                } else if upper.starts_with("A3 ") {
+                    self.end(send, "protocol");
+                }
+            }
+            State::Search => {
+                if let Some(rest) = upper.strip_prefix("* SEARCH") {
+                    for uid in rest.split_ascii_whitespace().filter_map(|t| t.parse::<u32>().ok()) {
+                        self.unseen = self.unseen.saturating_add(1);
+                        self.uids.push(uid);
+                        // only the newest are read: the list stays short
+                        if self.uids.len() > 4 * self.most {
+                            self.uids.sort_unstable();
+                            let cut = self.uids.len() - self.most;
+                            self.uids.drain(..cut);
+                        }
+                    }
+                } else if upper.starts_with("A4 OK") {
+                    self.uids.sort_unstable();
+                    let cut = self.uids.len().saturating_sub(self.most);
+                    self.uids.drain(..cut);
+                    if self.uids.is_empty() {
+                        self.end(send, "");
+                    } else {
+                        let list: Vec<String> = self.uids.iter().map(u32::to_string).collect();
+                        send.extend_from_slice(
+                            format!(
+                                "a5 UID FETCH {} (UID INTERNALDATE BODY.PEEK[HEADER.FIELDS (FROM SUBJECT)])\r\n",
+                                list.join(",")
+                            )
+                            .as_bytes(),
+                        );
+                        self.state = State::Fetch;
+                    }
+                } else if upper.starts_with("A4 ") {
+                    self.end(send, "protocol");
+                }
+            }
+            State::Fetch => {
+                if upper.starts_with("A5 ") {
+                    self.messages.sort_by(|a, b| b.issued_ms.cmp(&a.issued_ms).then(b.id.cmp(&a.id)));
+                    self.end(send, "");
+                } else if upper.starts_with('*') && upper.contains(" FETCH ") {
+                    self.note_message(parts);
+                }
+            }
+            State::Logout => {
+                if upper.starts_with("A6 ") {
+                    self.state = State::Done;
+                }
+            }
+            State::Done => {}
+        }
+    }
+
+    fn note_capabilities(&mut self, upper: &str) {
+        let text = match (upper.find("[CAPABILITY"), upper.strip_prefix("* CAPABILITY")) {
+            (_, Some(rest)) => rest.to_string(),
+            (Some(at), None) => upper[at + 1..].split(']').next().unwrap_or("").to_string(),
+            _ => return,
+        };
+        for token in text.split_ascii_whitespace().take(64) {
+            if token.len() <= 40 && !self.capabilities.iter().any(|c| c == token) {
+                self.capabilities.push(token.to_string());
+            }
+        }
+    }
+
+    fn has(&self, capability: &str) -> bool {
+        self.capabilities.iter().any(|c| c == capability)
+    }
+
+    fn sign_in(&mut self, send: &mut Vec<u8>) {
+        self.state = State::Auth;
+        if self.has("AUTH=PLAIN") {
+            if self.has("SASL-IR") {
+                send.extend_from_slice(format!("a2 AUTHENTICATE PLAIN {}\r\n", self.auth).as_bytes());
+            } else {
+                self.waiting_for_continuation = true;
+                send.extend_from_slice(b"a2 AUTHENTICATE PLAIN\r\n");
+            }
+        } else if let (false, Some(login)) = (self.has("LOGINDISABLED"), self.login.as_ref()) {
+            send.extend_from_slice(format!("a2 LOGIN {login}\r\n").as_bytes());
+        } else {
+            self.problem = "sign-in".to_string();
+            self.forget_secret();
+            self.state = State::Done;
+        }
+    }
+
+    /// Says goodbye; the look ends when the server answers (or closes).
+    fn end(&mut self, send: &mut Vec<u8>, problem: &str) {
+        if !problem.is_empty() && self.problem.is_empty() {
+            self.problem = problem.to_string();
+        }
+        send.extend_from_slice(b"a6 LOGOUT\r\n");
+        self.state = State::Logout;
+    }
+
+    fn note_message(&mut self, parts: &[Part]) {
+        if self.messages.len() >= self.most {
+            return;
+        }
+        let mut text = String::new();
+        let mut headers: &[u8] = &[];
+        for part in parts {
+            match part {
+                Part::Text(bytes) => text.push_str(&String::from_utf8_lossy(bytes)),
+                Part::Literal(bytes) if headers.is_empty() => headers = bytes,
+                Part::Literal(_) => {}
+            }
+        }
+        let upper = text.to_ascii_uppercase();
+        let Some(uid) = word_after(&upper, "UID ").and_then(|w| w.parse::<u32>().ok()) else { return };
+        let issued_ms = upper
+            .find("INTERNALDATE \"")
+            .and_then(|at| text[at + 14..].split('"').next())
+            .and_then(internal_date_ms)
+            .unwrap_or(0);
+        let (from, subject) = from_and_subject(headers);
+        let (from_name, from_email) = split_address(&from);
+        self.messages.push(ImapMessage {
+            id: format!("{}:{uid}", self.uid_validity),
+            from_email,
+            from_name: decode_words(from_name.as_bytes()),
+            subject: decode_words(subject.as_bytes()),
+            issued_ms,
+        });
+    }
+
+    fn problem(&self) -> String {
+        self.problem.clone()
+    }
+
+    fn unseen(&self) -> u32 {
+        self.unseen
+    }
+
+    fn messages(&self) -> Vec<ImapMessage> {
+        self.messages
+            .iter()
+            .map(|m| ImapMessage {
+                id: m.id.clone(),
+                from_email: m.from_email.clone(),
+                from_name: copy_text(&m.from_name),
+                subject: copy_text(&m.subject),
+                issued_ms: m.issued_ms,
+            })
+            .collect()
+    }
+}
+
+fn copy_text(parts: &[ImapText]) -> Vec<ImapText> {
+    parts.iter().map(|p| ImapText { charset: p.charset.clone(), bytes: p.bytes.clone() }).collect()
+}
+
+fn find_crlf(data: &[u8]) -> Option<usize> {
+    data.windows(2).position(|w| w == b"\r\n")
+}
+
+/// The size of the literal a line announces at its end ("... {123}"), if it does.
+fn literal_size(line: &[u8]) -> Option<usize> {
+    if line.last() != Some(&b'}') {
+        return None;
+    }
+    let open = line.iter().rposition(|&b| b == b'{')?;
+    let digits = &line[open + 1..line.len() - 1];
+    // "{123+}" is a literal the server need not announce: as sent by a client, never by a server
+    if digits.is_empty() || digits.len() > 9 || !digits.iter().all(u8::is_ascii_digit) {
+        return None;
+    }
+    std::str::from_utf8(digits).ok()?.parse().ok()
+}
+
+/// The value of "[NAME value]" in a response.
+fn bracket_value(upper: &str, name: &str) -> Option<String> {
+    let at = upper.find(&format!("[{name} "))?;
+    let value = upper[at + name.len() + 2..].split(']').next()?.trim();
+    (!value.is_empty() && value.len() <= 20 && value.bytes().all(|b| b.is_ascii_digit())).then(|| value.to_string())
+}
+
+fn word_after<'a>(text: &'a str, name: &str) -> Option<&'a str> {
+    let at = text.find(name)?;
+    text[at + name.len()..].split(|c: char| !c.is_ascii_alphanumeric()).next()
+}
+
+/// "17-Jul-1996 02:44:25 -0700" as ms since 1970.
+fn internal_date_ms(text: &str) -> Option<i64> {
+    let mut pieces = text.split_ascii_whitespace();
+    let mut date = pieces.next()?.split('-');
+    let day: i64 = date.next()?.parse().ok()?;
+    let month = match date.next()?.to_ascii_lowercase().as_str() {
+        "jan" => 1,
+        "feb" => 2,
+        "mar" => 3,
+        "apr" => 4,
+        "may" => 5,
+        "jun" => 6,
+        "jul" => 7,
+        "aug" => 8,
+        "sep" => 9,
+        "oct" => 10,
+        "nov" => 11,
+        "dec" => 12,
+        _ => return None,
+    };
+    let year: i64 = date.next()?.parse().ok()?;
+    let mut time = pieces.next()?.split(':');
+    let hour: i64 = time.next()?.parse().ok()?;
+    let minute: i64 = time.next()?.parse().ok()?;
+    let second: i64 = time.next()?.parse().ok()?;
+    let zone = pieces.next().unwrap_or("+0000");
+    if !(1..=31).contains(&day) || !(1970..=9999).contains(&year) || hour > 23 || minute > 59 || second > 60 {
+        return None;
+    }
+    let zone_minutes = if zone.len() == 5 && zone.is_ascii() {
+        let sign = if zone.starts_with('-') { -1 } else { 1 };
+        let hours: i64 = zone[1..3].parse().ok()?;
+        let minutes: i64 = zone[3..5].parse().ok()?;
+        sign * (hours * 60 + minutes)
+    } else {
+        0
+    };
+    // days since 1970-01-01 (the civil calendar, as in "chrono-Compatible Low-Level Date Algorithms")
+    let y = if month <= 2 { year - 1 } else { year };
+    let era = y.div_euclid(400);
+    let yoe = y.rem_euclid(400);
+    let doy = (153 * (month + if month > 2 { -3 } else { 9 }) + 2) / 5 + day - 1;
+    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+    let days = era * 146097 + doe - 719468;
+    Some(((days * 24 + hour) * 60 + minute - zone_minutes) * 60_000 + second * 1000)
+}
+
+/// The values of the From and the Subject header of `headers`, with folded lines joined.
+fn from_and_subject(headers: &[u8]) -> (String, String) {
+    let text = String::from_utf8_lossy(headers);
+    let mut from = String::new();
+    let mut subject = String::new();
+    let mut current: Option<&mut String> = None;
+    for line in text.split("\r\n").flat_map(|l| l.split('\n')) {
+        if line.starts_with(' ') || line.starts_with('\t') {
+            if let Some(value) = current.as_mut() {
+                if value.len() < 4 * MAX_TEXT {
+                    value.push(' ');
+                    value.push_str(line.trim());
+                }
+            }
+            continue;
+        }
+        let Some((name, value)) = line.split_once(':') else {
+            current = None;
+            continue;
+        };
+        current = match name.trim().to_ascii_lowercase().as_str() {
+            "from" if from.is_empty() => Some(&mut from),
+            "subject" if subject.is_empty() => Some(&mut subject),
+            _ => None,
+        };
+        if let Some(target) = current.as_mut() {
+            target.push_str(value.trim());
+        }
+    }
+    (from, subject)
+}
+
+/// The name and the address of a From header's value ("Name <a@b>", "a@b").
+fn split_address(from: &str) -> (String, String) {
+    let (name, address) = match (from.rfind('<'), from.rfind('>')) {
+        (Some(open), Some(close)) if open < close => (&from[..open], &from[open + 1..close]),
+        _ => ("", from),
+    };
+    let address = address.trim();
+    let address = if address.len() <= 254 && address.contains('@') && address.bytes().all(|b| b.is_ascii_graphic()) {
+        address.to_string()
+    } else {
+        String::new()
+    };
+    (name.trim().trim_matches('"').trim().to_string(), address)
+}
+
+/// A header's text with its encoded words ("=?utf-8?B?...?=", RFC 2047) decoded: plain pieces and
+/// decoded pieces in the order they come. White space between two encoded words is dropped.
+fn decode_words(value: &[u8]) -> Vec<ImapText> {
+    let mut out: Vec<ImapText> = Vec::new();
+    let mut total = 0;
+    let mut push = |charset: &str, bytes: &[u8], out: &mut Vec<ImapText>| {
+        if bytes.is_empty() || total >= MAX_TEXT {
+            return;
+        }
+        let take = bytes.len().min(MAX_TEXT - total);
+        total += take;
+        match out.last_mut() {
+            Some(last) if last.charset == charset => last.bytes.extend_from_slice(&bytes[..take]),
+            _ => out.push(ImapText { charset: charset.to_string(), bytes: bytes[..take].to_vec() }),
+        }
+    };
+    let mut rest = value;
+    let mut after_word = false;
+    while !rest.is_empty() {
+        let Some(start) = rest.windows(2).position(|w| w == b"=?") else {
+            push("", rest, &mut out);
+            break;
+        };
+        match encoded_word(&rest[start..]) {
+            Some((charset, bytes, used)) => {
+                let before = &rest[..start];
+                if !(after_word && before.iter().all(u8::is_ascii_whitespace)) {
+                    push("", before, &mut out);
+                }
+                push(&charset, &bytes, &mut out);
+                rest = &rest[start + used..];
+                after_word = true;
+            }
+            None => {
+                push("", &rest[..start + 2], &mut out);
+                rest = &rest[start + 2..];
+                after_word = false;
+            }
+        }
+    }
+    out
+}
+
+/// One encoded word at the start of `data`: its charset, its bytes, and how long it is.
+fn encoded_word(data: &[u8]) -> Option<(String, Vec<u8>, usize)> {
+    // =?charset?B?text?=
+    let end = data.windows(2).skip(2).position(|w| w == b"?=").map(|p| p + 2)?;
+    // the "?=" found may be the one of "?Q?=..": the word needs three more '?' before its end
+    let mut inner = std::str::from_utf8(&data[2..end]).ok()?.splitn(3, '?');
+    let (charset, kind, text) = (inner.next()?, inner.next()?, inner.next());
+    let (text, end) = match text {
+        Some(text) => (text.to_string(), end),
+        None => {
+            // "=?utf-8?Q?=41..." : look for the end again, after the encoding letter
+            let from = 2 + charset.len() + 1 + kind.len() + 1;
+            let more = data.get(from..)?.windows(2).position(|w| w == b"?=")?;
+            (std::str::from_utf8(&data[from..from + more]).ok()?.to_string(), from + more)
+        }
+    };
+    // "charset*language" (RFC 2231): the language is not needed
+    let charset = charset.split('*').next()?.to_ascii_lowercase();
+    if charset.is_empty() || charset.len() > 40 || !charset.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'-' || b == b'_') {
+        return None;
+    }
+    let bytes = match kind {
+        "B" | "b" => base64::engine::general_purpose::STANDARD.decode(text.trim_end_matches('=').to_string() + pad(&text)).ok()?,
+        "Q" | "q" => q_decode(text.as_bytes())?,
+        _ => return None,
+    };
+    Some((charset, bytes, end + 2))
+}
+
+/// The '=' a base64 text needs at its end (some senders leave them out).
+fn pad(text: &str) -> &'static str {
+    match text.trim_end_matches('=').len() % 4 {
+        2 => "==",
+        3 => "=",
+        _ => "",
+    }
+}
+
+fn q_decode(text: &[u8]) -> Option<Vec<u8>> {
+    let mut out = Vec::with_capacity(text.len());
+    let mut at = 0;
+    while at < text.len() {
+        match text[at] {
+            b'_' => out.push(b' '),
+            b'=' => {
+                let hex = std::str::from_utf8(text.get(at + 1..at + 3)?).ok()?;
+                out.push(u8::from_str_radix(hex, 16).ok()?);
+                at += 2;
+            }
+            other => out.push(other),
+        }
+        at += 1;
+    }
+    Some(out)
+}
