+namespace thoron_adblock {
+
+void SetSiteJavascript(HostContentSettingsMap* settings,
+                       const GURL& url,
+                       bool blocked) {
+  if (!settings || !url.is_valid() || url.host().empty()) {
+    return;
+  }
+  const ContentSettingsPattern host =
+      ContentSettingsPattern::FromString(base::StrCat({"[*.]", url.host()}));
+  if (!host.IsValid()) {
+    return;
+  }
+  settings->SetContentSettingCustomScope(
+      host, ContentSettingsPattern::Wildcard(), ContentSettingsType::JAVASCRIPT,
+      blocked ? CONTENT_SETTING_BLOCK : CONTENT_SETTING_DEFAULT);
+  if (!blocked) {
+    settings->SetContentSettingDefaultScope(url, GURL(),
+                                            ContentSettingsType::JAVASCRIPT,
+                                            CONTENT_SETTING_DEFAULT);
+  }
+}
+
+}  // namespace thoron_adblock
