@@ -0,0 +1,111 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_MAIL_IMAP_CHECK_H_
+#define COMPONENTS_THORON_MAIL_IMAP_CHECK_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "components/thoron_mail/imap.rs.h"
+#include "components/thoron_mail/mail_feed.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "mojo/public/cpp/system/data_pipe.h"
+#include "mojo/public/cpp/system/simple_watcher.h"
+#include "net/base/ip_endpoint.h"
+#include "services/network/public/mojom/network_context.mojom-forward.h"
+#include "services/network/public/mojom/proxy_resolving_socket.mojom.h"
+#include "third_party/rust/cxx/v1/cxx.h"
+
+namespace thoron_mail {
+
+// A mailbox the person added with its address and password (P5.77): any mail
+// service that speaks IMAP over TLS. Thoron signs in to it by itself, so it
+// does not depend on the accounts the browser is signed in to.
+struct ImapAccount {
+  ImapAccount();
+  ImapAccount(const ImapAccount&);
+  ImapAccount& operator=(const ImapAccount&);
+  ImapAccount(ImapAccount&&);
+  ImapAccount& operator=(ImapAccount&&);
+  ~ImapAccount();
+
+  std::string email;
+  std::string host;  // imap.example.com
+  int port = 993;    // IMAP over TLS
+  std::string user;  // what the server knows the person as; often the address
+  std::string password;
+  // The service's page for reading mail (https), opened from the menu; may be
+  // empty.
+  std::string webmail;
+};
+
+// True for a host name a look may connect to: letters, digits, dots and
+// hyphens, as a mail server's name is.
+bool IsImapHost(const std::string& host);
+
+// One look at one mailbox: connects (TLS, through the browser's network
+// service, so the person's proxy settings hold), signs in, counts the unread
+// messages of the inbox and reads who sent the newest and what about. What the
+// server sends is read in Rust (imap.rs); this only carries the bytes.
+// Nothing in the mailbox is changed. The look ends after kTimeout at the
+// latest.
+class ImapCheck {
+ public:
+  struct Result {
+    Result();
+    Result(Result&&);
+    Result& operator=(Result&&);
+    ~Result();
+    // "" when the look went well; else "sign-in" (the name or the password
+    // was refused), "offline" (no connection, or it ended early), "protocol"
+    // or "too-much" (the server's answers could not be used).
+    std::string problem;
+    int unread = 0;
+    std::vector<MailMessage> latest;
+  };
+  using Done = base::OnceCallback<void(Result)>;
+
+  // Starts the look. `done` runs once, unless this is destroyed first; it may
+  // destroy this.
+  ImapCheck(network::mojom::NetworkContext* context,
+            const ImapAccount& account,
+            Done done);
+  ImapCheck(const ImapCheck&) = delete;
+  ImapCheck& operator=(const ImapCheck&) = delete;
+  ~ImapCheck();
+
+ private:
+  void OnConnected(int result,
+                   const std::optional<net::IPEndPoint>& local,
+                   const std::optional<net::IPEndPoint>& peer,
+                   mojo::ScopedDataPipeConsumerHandle receive,
+                   mojo::ScopedDataPipeProducerHandle send);
+  void OnReadable(MojoResult result, const mojo::HandleSignalsState& state);
+  void OnWritable(MojoResult result, const mojo::HandleSignalsState& state);
+  void Write();
+  // the server closed the connection, or it broke
+  void OnClosed();
+  void Finish(std::string problem);
+
+  rust::Box<ImapSession> session_;
+  Done done_;
+  mojo::Remote<network::mojom::ProxyResolvingSocketFactory> factory_;
+  mojo::Remote<network::mojom::ProxyResolvingSocket> socket_;
+  mojo::ScopedDataPipeConsumerHandle receive_;
+  mojo::ScopedDataPipeProducerHandle send_;
+  mojo::SimpleWatcher read_watcher_;
+  mojo::SimpleWatcher write_watcher_;
+  // what is still to be sent
+  std::string pending_;
+  base::OneShotTimer timeout_;
+  base::WeakPtrFactory<ImapCheck> weak_factory_{this};
+};
+
+}  // namespace thoron_mail
+
+#endif  // COMPONENTS_THORON_MAIL_IMAP_CHECK_H_
diff --git a/components/thoron_mail/mail_backup.cc b/components/thoron_mail/mail_backup.cc
new file mode 100644
index 0000000000000000000000000000000000000000..4d99796529b4be504e552580bf0cf1befe9bb3f1
--- /dev/null
+++ b/components/thoron_mail/mail_backup.cc
@@ -0,0 +1,159 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_mail/mail_backup.h"
+
+#include <array>
+#include <cstdint>
+#include <vector>
+
+#include "base/base64.h"
+#include "base/containers/span.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/values.h"
+#include "crypto/aead.h"
+#include "crypto/random.h"
+#include "third_party/boringssl/src/include/openssl/evp.h"
+
+namespace thoron_mail {
+
+namespace {
+
+// scrypt as recommended for files a person keeps: 32 MB and a fraction of a
+// second for each guess of the passphrase.
+constexpr int kCost = 32768;  // N
+constexpr int kBlock = 8;     // r
+constexpr int kParallel = 1;  // p
+constexpr size_t kMaxMemory = 96 * 1024 * 1024;
+constexpr size_t kSaltBytes = 16;
+constexpr size_t kNonceBytes = 12;
+constexpr size_t kKeyBytes = 32;
+// A backup is small: the accounts and the settings.
+constexpr size_t kMaxBackupBytes = 4 * 1024 * 1024;
+// What a sealed backup is bound to.
+constexpr char kAssociated[] = "thoron-m-notifier-backup-v1";
+
+bool DeriveKey(std::string_view passphrase,
+               base::span<const uint8_t> salt,
+               int cost,
+               int block,
+               int parallel,
+               base::span<uint8_t> key) {
+  return EVP_PBE_scrypt(passphrase.data(), passphrase.size(), salt.data(),
+                        salt.size(), static_cast<uint64_t>(cost),
+                        static_cast<uint64_t>(block),
+                        static_cast<uint64_t>(parallel), kMaxMemory, key.data(),
+                        key.size()) == 1;
+}
+
+std::optional<std::vector<uint8_t>> Bytes(const base::DictValue& dict,
+                                          std::string_view name,
+                                          size_t size) {
+  const std::string* text = dict.FindString(name);
+  std::optional<std::vector<uint8_t>> bytes =
+      text ? base::Base64Decode(*text) : std::nullopt;
+  if (!bytes || (size != 0 && bytes->size() != size)) {
+    return std::nullopt;
+  }
+  return bytes;
+}
+
+std::optional<base::DictValue> SealedDict(std::string_view text) {
+  if (text.empty() || text.size() > 2 * kMaxBackupBytes) {
+    return std::nullopt;
+  }
+  std::optional<base::DictValue> dict =
+      base::JSONReader::ReadDict(text, base::JSON_PARSE_RFC);
+  if (!dict) {
+    return std::nullopt;
+  }
+  const std::string* format = dict->FindString("format");
+  if (!format || *format != kBackupFormat ||
+      !dict->FindBool("sealed").value_or(false)) {
+    return std::nullopt;
+  }
+  return dict;
+}
+
+}  // namespace
+
+std::string SealBackup(std::string_view backup, std::string_view passphrase) {
+  if (backup.empty() || backup.size() > kMaxBackupBytes || passphrase.empty()) {
+    return std::string();
+  }
+  const std::array<uint8_t, kSaltBytes> salt =
+      crypto::RandBytesAsArray<kSaltBytes>();
+  const std::array<uint8_t, kNonceBytes> nonce =
+      crypto::RandBytesAsArray<kNonceBytes>();
+  std::array<uint8_t, kKeyBytes> key;
+  if (!DeriveKey(passphrase, salt, kCost, kBlock, kParallel, key)) {
+    return std::string();
+  }
+  const std::vector<uint8_t> sealed =
+      crypto::Aead(crypto::Aead::AES_256_GCM, key)
+          .Seal(base::as_byte_span(backup), nonce,
+                base::byte_span_from_cstring(kAssociated));
+  key.fill(0);
+  if (sealed.empty()) {
+    return std::string();
+  }
+  const base::DictValue file = base::DictValue()
+                                   .Set("format", kBackupFormat)
+                                   .Set("version", 1)
+                                   .Set("sealed", true)
+                                   .Set("kdf", "scrypt")
+                                   .Set("n", kCost)
+                                   .Set("r", kBlock)
+                                   .Set("p", kParallel)
+                                   .Set("salt", base::Base64Encode(salt))
+                                   .Set("nonce", base::Base64Encode(nonce))
+                                   .Set("data", base::Base64Encode(sealed));
+  return base::WriteJsonWithOptions(file, base::JSONWriter::OPTIONS_PRETTY_PRINT)
+      .value_or(std::string());
+}
+
+bool IsSealedBackup(std::string_view text) {
+  return SealedDict(text).has_value();
+}
+
+std::optional<std::string> OpenBackup(std::string_view text,
+                                      std::string_view passphrase) {
+  std::optional<base::DictValue> file = SealedDict(text);
+  const std::string* kdf = file ? file->FindString("kdf") : nullptr;
+  if (!kdf || *kdf != "scrypt" || passphrase.empty() ||
+      file->FindInt("version").value_or(0) != 1) {
+    return std::nullopt;
+  }
+  // Only costs a careful file would name: a file cannot ask for hours or for
+  // all the memory.
+  const int cost = file->FindInt("n").value_or(0);
+  const int block = file->FindInt("r").value_or(0);
+  const int parallel = file->FindInt("p").value_or(0);
+  if (cost < 1024 || cost > 1048576 || (cost & (cost - 1)) != 0 ||
+      block != kBlock || parallel != kParallel) {
+    return std::nullopt;
+  }
+  const std::optional<std::vector<uint8_t>> salt =
+      Bytes(*file, "salt", kSaltBytes);
+  const std::optional<std::vector<uint8_t>> nonce =
+      Bytes(*file, "nonce", kNonceBytes);
+  const std::optional<std::vector<uint8_t>> data = Bytes(*file, "data", 0);
+  if (!salt || !nonce || !data || data->size() > kMaxBackupBytes + 64) {
+    return std::nullopt;
+  }
+  std::array<uint8_t, kKeyBytes> key;
+  if (!DeriveKey(passphrase, *salt, cost, block, parallel, key)) {
+    return std::nullopt;
+  }
+  const std::optional<std::vector<uint8_t>> opened =
+      crypto::Aead(crypto::Aead::AES_256_GCM, key)
+          .Open(*data, *nonce, base::byte_span_from_cstring(kAssociated));
+  key.fill(0);
+  if (!opened) {
+    return std::nullopt;
+  }
+  return std::string(opened->begin(), opened->end());
+}
+
+}  // namespace thoron_mail
