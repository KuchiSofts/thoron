new file mode 100644
index 0000000000000000000000000000000000000000..4c249e10c731f7b7fc3e2bf12a29b82eaba25e5f
--- /dev/null
+++ b/components/thoron_mail/mail_feed.h
@@ -0,0 +1,75 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_MAIL_MAIL_FEED_H_
+#define COMPONENTS_THORON_MAIL_MAIL_FEED_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/time/time.h"
+#include "base/values.h"
+
+namespace thoron_mail {
+
+// One unread message, as Gmail's feed of unread mail tells of it.
+struct MailMessage {
+  MailMessage();
+  MailMessage(const MailMessage&);
+  MailMessage& operator=(const MailMessage&);
+  ~MailMessage();
+
+  std::string id;  // Gmail's own, for telling new mail from mail seen before
+  std::string subject;
+  std::string snippet;
+  std::string from_name;
+  std::string from_email;
+  // the conversation in Gmail (https://mail.google.com/ only; empty if not)
+  std::string link;
+  base::Time issued;
+  // from Gmail's spam, counted because the person asked for it (P5.77)
+  bool spam = false;
+};
+
+// One Google account the browser is signed in to: Gmail's u/<index>.
+struct MailAccount {
+  MailAccount();
+  MailAccount(const MailAccount&);
+  MailAccount& operator=(const MailAccount&);
+  ~MailAccount();
+
+  int index = 0;
+  std::string email;
+  int unread = 0;
+  // the newest unread messages, as many as the feed has (at most 20)
+  std::vector<MailMessage> latest;
+  // P5.77: a mailbox the person added with its address and password (IMAP),
+  // not one of the browser's Google accounts: its index is kFirstImapIndex or
+  // more, `webmail` is the page its mail is read on (may be empty), and
+  // `problem` says why the last look at it failed ("" when it went well;
+  // "sign-in", "offline", "protocol", "too-much"). The counts are then those
+  // of the last look that went well.
+  bool imap = false;
+  std::string webmail;
+  std::string problem;
+};
+
+// The index of the first mailbox added by address and password; Google
+// accounts are u/0 to u/9.
+inline constexpr int kFirstImapIndex = 1000;
+
+// The account of Gmail's feed of unread mail (Atom 0.3) for u/`index`, from
+// the tree the data decoder (a sandboxed process) parsed it into. Nullopt for
+// anything else.
+std::optional<MailAccount> AccountFromFeed(const base::Value& feed, int index);
+
+// "2026-11-15T10:20:30Z" (the feed's times), or a null time.
+base::Time FeedTime(const std::string& text);
+
+// `link` if it opens something of Gmail's, made https; else empty.
+std::string GmailLink(const std::string& link);
+
+}  // namespace thoron_mail
+
+#endif  // COMPONENTS_THORON_MAIL_MAIL_FEED_H_
diff --git a/components/thoron_mail/mail_page.cc b/components/thoron_mail/mail_page.cc
new file mode 100644
index 0000000000000000000000000000000000000000..4f0d237c681b492df1b07cea202345f7ca119bdf
--- /dev/null
+++ b/components/thoron_mail/mail_page.cc
@@ -0,0 +1,1152 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_mail/mail_page.h"
+
+namespace thoron_mail {
+
+namespace {
+
+// The menu takes its colours and its font from the browser (P5.78): the
+// theme's colours (chrome://theme/colors.css) and the text defaults of the
+// browser's own pages, so it looks like a part of the browser in every theme.
+constexpr char kHtml[] = R"thoron(<!doctype html>
+<html dir="ltr">
+<head>
+<meta charset="utf-8">
+<title>Thoron M-Notifier</title>
+<link rel="stylesheet" href="chrome://resources/css/text_defaults_md.css">
+<link rel="stylesheet" id="theme" href="chrome://theme/colors.css?sets=ui,chrome">
+<style>
+  :root { color-scheme: light dark;
