+  ChromiumFamilyReader reader(Options());
+  ChromiumFamilyReader::Stats stats = reader.Import(HISTORY, &bridge);
+  EXPECT_TRUE(bridge.history.empty());
+  EXPECT_EQ(1, stats.databases_refused);
+}
