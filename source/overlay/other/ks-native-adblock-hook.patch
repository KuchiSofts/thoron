+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_UPDATE_CLI_H_
+#define COMPONENTS_THORON_UPDATE_CLI_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "components/thoron_update/manifest.h"
+#include "components/thoron_update/swap.h"
+
+namespace base {
+class CommandLine;
+class FilePath;
+}  // namespace base
+
+// The updater's command line and its settings (ROADMAP P3.11).
+//
+//   thoron_update --root <program folder> --status
+//   thoron_update --root <program folder> --apply <staged folder> --version <v> --files <files.json>
+//       [--handed-off]
+//   thoron_update --root <program folder> --apply-package <portable .zip> --version <v>
+//       [--snapshot-profile <User Data> --snapshots <folder>]
+//   thoron_update --root <program folder> --apply-delta <file.delta> --version <v>
+//       [--snapshot-profile <User Data> --snapshots <folder>]
+//   thoron_update --root <Application folder> --apply-installed-delta <file.delta> --from <v> --version <v>
+//       [--system-level]
+//       an installed copy (P4.1): the newer version made from the Application folder with the delta, then
+//       installed by its own setup.exe (PrepareInstalledDelta); the Application folder is not a program
+//       folder of swap.h
+//   thoron_update --root <program folder> --rollback [--confirm]
+//       [--restore-profile <User Data> --snapshots <folder>]
+//   thoron_update --check --manifest <update.json> --signature <update.json.sig> --public-key <base64>
+//       --channel <channel> --installed <v> --updater <v> --variant <name> --kind installed|portable
+//       --allowed-host <host> [--last-serial <n>] [--now <seconds since 1970>]
+//   thoron_update --root <program folder> --mode [auto|notify|off]
+//
+// The program folder is the one of swap.h: a folder per version and the file
+// `current`.
+//
+// The release's own updater applies the release (ROADMAP P4.6). When the staged
+// folder holds the updater (kUpdaterFile), --apply copies it out of the folder
+// (the folder is renamed during the swap), checks the copy against its entry in
+// the files, and runs it with the same command line and --handed-off; that one
+// applies the release itself. So an updater below a release's
+// min_updater_version only fetches, checks and unpacks the package and never
+// runs the swap of a release it may not apply. A copy that does not match its
+// entry is never started: the apply ends with bad files. --check reads the two files of a release as they were fetched;
+// fetching them is the browser's part (P3.20).
+
+namespace thoron_update {
+
+// The exit codes, as documented in README.md.
+enum ExitCode {
+  kExitOk = 0,             // done; with --check: up to date
+  kExitUsage = 1,          // the command line is not one of the above
+  kExitNoVersion = 10,     // --status: no version starts in the folder
+  kExitAlreadyCurrent = 11,
+  kExitBadFiles = 12,      // --apply: the staged folder is not the package's files
+  kExitBadRequest = 13,    // --apply: the version or a path of the files is wrong
+  kExitIoError = 14,
+  kExitNothingToRollBack = 15,
+  kExitUpdate = 20,        // --check: a newer release for this copy
+  kExitCannotVerify = 21,  // --check: bad signature, malformed, replayed, expired...
+  kExitUpdaterTooOld = 22,
+  kExitNoPackage = 23,
+  // --rollback without --confirm: what it would do was said, nothing was done.
+  kExitNeedsConfirmation = 16,
+  // --rollback --restore-profile: the snapshot did not verify; nothing changed.
+  kExitSnapshotBad = 17,
+  // --apply-installed-delta: the newer setup did not install the version.
+  kExitInstallerFailed = 18,
+};
+
+// The name of the snapshot taken before `version` was put in place.
+std::string SnapshotLabel(const BuildVersion& version);
+
+// How a copy updates itself.
+enum class UpdateMode {
+  kAuto,    // downloads and installs; the new version starts with the next start
+  kNotify,  // says a newer version is there; installs when asked
+  kOff,     // looks only when asked
+};
+
+std::string_view UpdateModeName(UpdateMode mode);
+
+// The mode kept in the program folder (the file `update-mode`); kAuto when
+// none is kept or it is not one of the three.
+UpdateMode ReadUpdateMode(const base::FilePath& root);
+bool WriteUpdateMode(const base::FilePath& root, UpdateMode mode);
+
+// What a copy does with a decision in its mode, when it looked on its own (a
+// look the person asked for always shows its answer).
+enum class Action {
+  kNothing,
+  kInstall,  // download, verify and put in place (P3.4, P3.5)
+  kTell,     // show that a newer version is there
+  kWarn,     // show that updates cannot be verified (P4.5)
+};
+Action ActionFor(UpdateMode mode, Outcome outcome);
+// The same for a whole decision: an updater that is too old installs like an
+// update when the decision has the package (P4.6), and tells otherwise.
+Action ActionFor(UpdateMode mode, const Decision& decision);
+
+// The updater's file in a version's folder, and the name of its copy in the
+// program folder while it applies a release it was handed.
+extern const char kUpdaterFile[];
+extern const char kHandOffFile[];
+
+// The entry of the updater in `files`, when the version has one.
+std::optional<VersionFile> UpdaterEntry(const std::vector<VersionFile>& files);
+
+// Copies the updater of the staged folder to `to` and checks the copy against
+// `entry` (length and SHA-256). False, and nothing left at `to`, when it does
+// not match or cannot be copied.
+bool CopyCheckedUpdater(const base::FilePath& staged,
+                        const VersionFile& entry,
+                        const base::FilePath& to);
+
+// Runs the command line `command`; what it prints goes to `out`. Gives the
+// exit code.
+int RunUpdateCommand(const base::CommandLine& command, std::string* out);
+
+}  // namespace thoron_update
+
+#endif  // COMPONENTS_THORON_UPDATE_CLI_H_
