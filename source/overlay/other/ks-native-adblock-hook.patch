+
+    def copies(self) -> None:
+        mf = self.mf
+        junk = b"update\n"
+        self.section("what a copy gets wrong about itself: the reference raises an error, whatever the files")
+        wrong = (("a channel in upper case", {"channel": "Stable"}), ("no channel", {"channel": ""}),
+                 ("a channel with a line end", {"channel": "stable\n"}),
+                 ("a channel of 33 letters", {"channel": "s" * 33}),
+                 ("a channel that starts with a digit", {"channel": "1stable"}),
+                 ("a stored serial below zero", {"last_serial": -1}),
+                 ("no allowed host", {"hosts": ()}),
+                 ("an allowed host in upper case", {"hosts": ("GitHub.com",)}),
+                 ("an allowed host of one label", {"hosts": ("github",)}),
+                 ("an allowed host with a scheme", {"hosts": ("https://github.com",)}),
+                 ("an allowed host with a line end", {"hosts": ("github.com\n",)}),
+                 ("an allowed host with a dot at the end", {"hosts": ("github.com.",)}),
+                 ("an allowed host with a label that starts with a hyphen", {"hosts": ("-a.example.org",)}),
+                 ("an allowed host with a label of 64 letters", {"hosts": ("a" * 64 + ".example.org",)}),
+                 ("one host of two that is none", {"hosts": ("github.com", "example")}))
+        for name, state in wrong:
+            self.add(name, expect="invalid_copy", **state)
+        for name, state in (wrong[0], wrong[5], wrong[6]):
+            self.add(name + ", and files that are none", manifest=junk, signature=b"", expect="invalid_copy",
+                     **state)
+        self.section("the allowed hosts are the caller's")
+        self.add("a second allowed host changes nothing", hosts=("example.org", "github.com"), expect=mf.UPDATE)
+        self.add("a host the updater does not allow is malformed even when signed", hosts=("example.org",),
+                 expect=mf.MALFORMED)
+        self.add("a label of 63 letters is a host", hosts=("a" * 63 + ".example.org", "github.com"),
+                 expect=mf.UPDATE)
+        self.add("a channel of 32 letters is a channel, and not this manifest's", channel="s" * 32,
+                 expect=mf.WRONG_CHANNEL)
+        self.add("a channel with digits and a hyphen", channel="beta-2", expect=mf.WRONG_CHANNEL)
+
+    def signatures(self) -> None:
+        mf, c = self.mf, self.cases
+        raw, signature = self.example, self.signature
+        small = c.small()
+        bad = mf.BAD_SIGNATURE
+        self.section("the signature (step 2): 64 bytes, over the purpose prefix and the exact bytes")
+        self.add("a small manifest of one package verifies too", manifest=small, expect=mf.UPDATE)
+        self.add("a changed manifest", manifest=raw.replace(b"4500", b"4600", 1), signature=signature,
+                 expect=bad)
+        self.add("a signature back to front", signature=signature[::-1], expect=bad)
+        self.add("no signature", signature=b"", expect=bad)
+        self.add("the signature of another manifest", manifest=small, signature=signature, expect=bad)
+        self.add("a manifest a byte short", manifest=raw[:-1], signature=signature, expect=bad)
+        self.add("a manifest with one more line end", manifest=raw + b"\n", signature=signature, expect=bad)
+        self.add("a manifest after a line end", manifest=b"\n" + raw, signature=signature, expect=bad)
+        self.add("a signature a byte short", signature=signature[:-1], expect=bad)
+        self.add("a signature a byte long", signature=signature + b"\x00", expect=bad)
+        self.add("a signature in base64", signature=base64.b64encode(signature), expect=bad)
+        self.add("a signature in hex", signature=signature.hex().encode("ascii"), expect=bad)
+        self.add("a signature of zeros", signature=bytes(64), expect=bad)
+        s = int.from_bytes(signature[32:], "little")
+        assert s < ORDER
+        times = [n for n in range(1, 16) if s + n * ORDER < 2**256]
+        assert len(times) >= 7, times
+        for n in (times[0], times[1], times[-1]):   # the same S plus the group order: equal on the curve
