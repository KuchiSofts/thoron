+    fn encoded_words_are_decoded_piece_by_piece() {
+        assert_eq!(text(&decode_words(b"plain")), "[]plain");
+        assert_eq!(text(&decode_words(b"=?ISO-8859-1?Q?caf=E9?= au lait")), "[iso-8859-1]caf\u{FFFD}[] au lait");
+        // white space between two encoded words is dropped, and their bytes are joined
+        assert_eq!(text(&decode_words(b"=?utf-8?B?SGVs?= =?utf-8?B?bG8=?=")), "[utf-8]Hello");
+        // base64 without its padding, a language tag, another script
+        assert_eq!(text(&decode_words(b"=?UTF-8*en?B?SGk?=")), "[utf-8]Hi");
+        assert_eq!(text(&decode_words(b"=?windows-1255?B?+eXs7Q==?=")).len(), "[windows-1255]".len() + 4 * 3);
+        // what is not an encoded word stays as it is
+        assert_eq!(text(&decode_words(b"a =? b ?= c")), "[]a =? b ?= c");
+        assert_eq!(text(&decode_words(b"=?utf-8?X?abc?=")), "[]=?utf-8?X?abc?=");
+        assert_eq!(text(&decode_words(b"=?bad charset?B?QQ==?=")), "[]=?bad charset?B?QQ==?=");
+        // a Q word whose text starts with "="
+        assert_eq!(text(&decode_words(b"=?utf-8?Q?=41BC?=")), "[utf-8]ABC");
+        // a long subject is cut
+        let long = "x".repeat(2000);
+        assert_eq!(decode_words(long.as_bytes())[0].bytes.len(), MAX_TEXT);
+    }
+
+    #[test]
+    fn literal_sizes_are_read_only_from_the_end_of_a_line() {
+        assert_eq!(literal_size(b"* 1 FETCH (BODY[] {12}"), Some(12));
+        assert_eq!(literal_size(b"* 1 FETCH {12} more"), None);
+        assert_eq!(literal_size(b"{}"), None);
+        assert_eq!(literal_size(b"{12+}"), None);
+        assert_eq!(literal_size(b"{99999999999999999999}"), None);
+    }
+}
diff --git a/components/thoron_mail/imap_check.cc b/components/thoron_mail/imap_check.cc
new file mode 100644
index 0000000000000000000000000000000000000000..24a812760e93588f844bcc9e7acaf1d45320c903
--- /dev/null
+++ b/components/thoron_mail/imap_check.cc
@@ -0,0 +1,308 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_mail/imap_check.h"
+
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/containers/span.h"
+#include "base/functional/bind.h"
+#include "base/i18n/icu_string_conversions.h"
+#include "base/location.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/time/time.h"
+#include "net/base/host_port_pair.h"
+#include "net/base/net_errors.h"
+#include "net/base/network_anonymization_key.h"
+#include "net/base/url_util.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/mojom/network_context.mojom.h"
+#include "url/gurl.h"
+
+namespace thoron_mail {
+
+namespace {
+
+// A look that takes longer than this is given up.
+constexpr base::TimeDelta kTimeout = base::Seconds(30);
+// The newest unread messages read from one mailbox.
+constexpr uint32_t kMostMessages = 20;
+// What is waiting to be sent is never more than this: a look sends a few
+// short lines.
+constexpr size_t kMostPending = 64 * 1024;
+
+// For the offline checks: every look goes to this local server instead, in
+// plain text ("127.0.0.1:<port>"; nothing but a loopback address is taken).
+constexpr char kImapForTesting[] = "thoron-mail-imap-for-testing";
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("thoron_mail_imap", R"(
+        semantics {
+          sender: "Thoron M-Notifier"
+          description:
+            "Looks at a mailbox the person added to Thoron M-Notifier with its "
+            "address and password: signs in to the mail service's IMAP server "
+            "over TLS, counts the unread messages of the inbox and reads the "
+            "sender and the subject of the newest ones. Nothing in the mailbox "
+            "is changed."
+          trigger:
+            "The person added a mailbox by address and password: a moment "
+            "after the browser starts, then every few minutes (the person's "
+            "choice), and when the person asks in the M-Notifier's menu."
+          data:
+            "The name and the password the person entered for that mailbox, "
+            "sent only to the mail server the person named, over TLS."
+          destination: OTHER
+          destination_other: "The mail server the person named."
+        }
+        policy {
+          cookies_allowed: NO
+          setting:
+            "Remove the mailbox in the M-Notifier's settings; off when the "
+            "ThoronMailNotifier feature is off."
+          policy_exception_justification: "No policy yet."
+        })");
+
+// The local server that stands in for every mail server in the offline
+// checks, or an invalid address.
+GURL TestingEndpoint() {
+  const std::string value =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          kImapForTesting);
+  if (value.empty()) {
+    return GURL();
+  }
+  const GURL url("http://" + value + "/");
+  return url.is_valid() && net::IsLocalhost(url) ? url : GURL();
+}
+
+// A header's text, piece by piece in the charset each piece says. What cannot
+// be read in its charset is read as UTF-8.
+std::string TextOf(const rust::Vec<ImapText>& parts) {
+  std::u16string text;
+  for (const ImapText& part : parts) {
+    const std::string_view bytes(
+        reinterpret_cast<const char*>(part.bytes.data()), part.bytes.size());
+    const std::string charset(part.charset);
+    std::u16string piece;
+    if (charset.empty() || charset == "utf-8" || charset == "us-ascii" ||
+        !base::CodepageToUTF16(bytes, charset.c_str(),
+                               base::OnStringConversionError::SUBSTITUTE,
+                               &piece)) {
+      piece = base::UTF8ToUTF16(bytes);
+    }
+    text += piece;
+  }
+  return base::UTF16ToUTF8(
+      base::CollapseWhitespace(text, /*trim_sequences_with_line_breaks=*/true));
+}
+
+}  // namespace
+
+ImapAccount::ImapAccount() = default;
+ImapAccount::ImapAccount(const ImapAccount&) = default;
+ImapAccount& ImapAccount::operator=(const ImapAccount&) = default;
+ImapAccount::ImapAccount(ImapAccount&&) = default;
+ImapAccount& ImapAccount::operator=(ImapAccount&&) = default;
+ImapAccount::~ImapAccount() = default;
+
+ImapCheck::Result::Result() = default;
+ImapCheck::Result::Result(Result&&) = default;
+ImapCheck::Result& ImapCheck::Result::operator=(Result&&) = default;
+ImapCheck::Result::~Result() = default;
+
+bool IsImapHost(const std::string& host) {
+  if (host.empty() || host.size() > 253 || host.front() == '.' ||
+      host.front() == '-' || host.back() == '-') {
+    return false;
+  }
+  for (char c : host) {
+    if (!base::IsAsciiAlphaNumeric(c) && c != '.' && c != '-') {
+      return false;
+    }
+  }
+  return true;
+}
+
+ImapCheck::ImapCheck(network::mojom::NetworkContext* context,
+                     const ImapAccount& account,
+                     Done done)
+    : session_(imap_session(account.user, account.password, kMostMessages)),
+      done_(std::move(done)),
+      read_watcher_(FROM_HERE, mojo::SimpleWatcher::ArmingPolicy::MANUAL),
+      write_watcher_(FROM_HERE, mojo::SimpleWatcher::ArmingPolicy::MANUAL) {
+  GURL url = TestingEndpoint();
+  // TLS always, but to the offline checks' own local server
+  const bool tls = !url.is_valid();
+  if (tls && IsImapHost(account.host) && account.port > 0 &&
+      account.port <= 65535) {
+    url = GURL("https://" + account.host + ":" +
+               base::NumberToString(account.port) + "/");
+  }
+  if (!context || !url.is_valid()) {
+    // not from inside the constructor: `done` may destroy this
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&ImapCheck::Finish,
+                                  weak_factory_.GetWeakPtr(), "offline"));
+    return;
+  }
+  context->CreateProxyResolvingSocketFactory(
+      factory_.BindNewPipeAndPassReceiver());
+  auto options = network::mojom::ProxyResolvingSocketOptions::New();
+  options->use_tls = tls;
+  factory_->CreateProxyResolvingSocket(
+      url, net::NetworkAnonymizationKey::CreateTransient(), std::move(options),
+      net::MutableNetworkTrafficAnnotationTag(kTrafficAnnotation),
+      socket_.BindNewPipeAndPassReceiver(), mojo::NullRemote(),
+      base::BindOnce(&ImapCheck::OnConnected, weak_factory_.GetWeakPtr()));
+  // base::Unretained is safe: the remotes and the timer are members.
+  factory_.set_disconnect_handler(
+      base::BindOnce(&ImapCheck::OnClosed, base::Unretained(this)));
+  timeout_.Start(FROM_HERE, kTimeout,
+                 base::BindOnce(&ImapCheck::Finish, base::Unretained(this),
+                                "offline"));
+}
+
+ImapCheck::~ImapCheck() = default;
+
+void ImapCheck::OnConnected(int result,
+                            const std::optional<net::IPEndPoint>& local,
+                            const std::optional<net::IPEndPoint>& peer,
+                            mojo::ScopedDataPipeConsumerHandle receive,
+                            mojo::ScopedDataPipeProducerHandle send) {
+  if (result != net::OK || !receive.is_valid() || !send.is_valid()) {
+    Finish("offline");
+    return;
+  }
+  receive_ = std::move(receive);
+  send_ = std::move(send);
+  // base::Unretained is safe: the watchers are members.
+  read_watcher_.Watch(
+      receive_.get(),
+      MOJO_HANDLE_SIGNAL_READABLE | MOJO_HANDLE_SIGNAL_PEER_CLOSED,
+      MOJO_WATCH_CONDITION_SATISFIED,
+      base::BindRepeating(&ImapCheck::OnReadable, base::Unretained(this)));
+  write_watcher_.Watch(
+      send_.get(), MOJO_HANDLE_SIGNAL_WRITABLE | MOJO_HANDLE_SIGNAL_PEER_CLOSED,
+      MOJO_WATCH_CONDITION_SATISFIED,
+      base::BindRepeating(&ImapCheck::OnWritable, base::Unretained(this)));
+  read_watcher_.ArmOrNotify();
+}
+
+void ImapCheck::OnReadable(MojoResult result,
+                           const mojo::HandleSignalsState& state) {
+  if (result != MOJO_RESULT_OK) {
+    OnClosed();
+    return;
+  }
+  while (true) {
+    base::span<const uint8_t> data;
+    const MojoResult read =
+        receive_->BeginReadData(MOJO_BEGIN_READ_DATA_FLAG_NONE, data);
+    if (read == MOJO_RESULT_SHOULD_WAIT) {
+      read_watcher_.ArmOrNotify();
+      return;
+    }
+    if (read != MOJO_RESULT_OK) {
+      OnClosed();
+      return;
+    }
+    ImapStep step = session_->on_bytes(
+        rust::Slice<const uint8_t>(data.data(), data.size()));
+    receive_->EndReadData(data.size());
+    if (step.done) {
+      Finish(std::string(session_->problem()));
+      return;
+    }
+    if (!step.send.empty()) {
+      if (pending_.size() + step.send.size() > kMostPending) {
+        Finish("protocol");
+        return;
+      }
+      pending_.append(reinterpret_cast<const char*>(step.send.data()),
+                      step.send.size());
+      // A write that fails ends the look, and `done` may destroy this.
+      base::WeakPtr<ImapCheck> alive = weak_factory_.GetWeakPtr();
+      Write();
+      if (!alive || !done_) {
+        return;
+      }
+    }
+  }
+}
+
+void ImapCheck::OnWritable(MojoResult result,
+                           const mojo::HandleSignalsState& state) {
+  if (result != MOJO_RESULT_OK) {
+    OnClosed();
+    return;
+  }
+  Write();
+}
+
+void ImapCheck::Write() {
+  while (!pending_.empty()) {
+    size_t written = 0;
+    const MojoResult result = send_->WriteData(base::as_byte_span(pending_),
+                                               MOJO_WRITE_DATA_FLAG_NONE,
+                                               written);
+    if (result == MOJO_RESULT_SHOULD_WAIT) {
+      write_watcher_.ArmOrNotify();
+      return;
+    }
+    if (result != MOJO_RESULT_OK) {
+      OnClosed();
+      return;
+    }
+    // what was sent (a sign-in among it) is not kept
+    std::fill_n(pending_.begin(), written, '\0');
+    pending_.erase(0, written);
+  }
+}
+
+void ImapCheck::OnClosed() {
+  session_->on_closed();
+  Finish(std::string(session_->problem()));
+}
+
+void ImapCheck::Finish(std::string problem) {
+  if (!done_) {
+    return;
+  }
+  timeout_.Stop();
+  read_watcher_.Cancel();
+  write_watcher_.Cancel();
+  receive_.reset();
+  send_.reset();
+  socket_.reset();
+  factory_.reset();
+  std::fill(pending_.begin(), pending_.end(), '\0');
+  pending_.clear();
+
+  Result result;
+  result.problem = std::move(problem);
+  if (result.problem.empty()) {
+    result.unread = static_cast<int>(
+        std::min<uint32_t>(session_->unseen(), 1000000u));
+    for (const ImapMessage& found : session_->messages()) {
+      MailMessage message;
+      message.id = std::string(found.id);
+      message.from_email = std::string(found.from_email);
+      message.from_name = TextOf(found.from_name);
+      message.subject = TextOf(found.subject);
+      if (found.issued_ms > 0) {
+        message.issued = base::Time::FromMillisecondsSinceUnixEpoch(
+            static_cast<double>(found.issued_ms));
+      }
+      result.latest.push_back(std::move(message));
+    }
+  }
+  // last: `done` may destroy this
+  std::move(done_).Run(std::move(result));
+}
+
+}  // namespace thoron_mail
