+TEST_F(ThoronUpdateClientTest, NoRequestCarriesACookieAReferrerOrTheVersion) {
+  Publish();
+  std::vector<network::ResourceRequest> seen;
+  network_.SetInterceptor(
+      base::BindLambdaForTesting([&](const network::ResourceRequest& r) { seen.push_back(r); }));
+  EXPECT_EQ(Look(*Client(), /*install=*/true).state, State::kReadyToRelaunch);
+  // The manifest, its signature, the key statements and the package.
+  ASSERT_GE(seen.size(), 4u);
+  for (const network::ResourceRequest& r : seen) {
+    EXPECT_EQ(r.credentials_mode, network::mojom::CredentialsMode::kOmit) << r.url;
+    EXPECT_TRUE(r.load_flags & net::LOAD_DISABLE_CACHE) << r.url;
+    EXPECT_FALSE(r.headers.HasHeader(net::HttpRequestHeaders::kCookie)) << r.url;
+    EXPECT_TRUE(r.referrer.is_empty()) << r.url;
+    EXPECT_EQ(r.referrer_policy, net::ReferrerPolicy::NO_REFERRER) << r.url;
+    EXPECT_EQ(r.headers.GetHeader(net::HttpRequestHeaders::kUserAgent),
+              std::optional<std::string>(UpdateClient::kUserAgent))
+        << r.url;
+  }
+}
