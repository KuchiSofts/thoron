+++ b/components/thoron_update/package_unittest.cc
@@ -0,0 +1,361 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_update/package.h"
+
+#include <string>
+#include <vector>
+
+#include "base/files/file.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "build/build_config.h"
+#include "crypto/hash.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace thoron_update {
+namespace {
+
+PackageFile FileOf(const std::string& content) {
+  PackageFile file;
+  file.url = "https://github.com/KuchiSofts/thoron/releases/download/v0.1.2/p.exe";
+  file.size = static_cast<int64_t>(content.size());
+  file.sha256 = base::HexEncodeLower(crypto::hash::Sha256(content));
+  return file;
+}
+
+class ThoronUpdatePackageTest : public testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(dir_.CreateUniqueTempDir()); }
+
+  base::FilePath Write(const std::string& name, const std::string& content) {
+    const base::FilePath path = dir_.GetPath().AppendASCII(name);
+    EXPECT_TRUE(base::WriteFile(path, content));
+    return path;
+  }
+
+  std::string Read(const base::FilePath& path) {
+    std::string out;
+    EXPECT_TRUE(base::ReadFileToString(path, &out));
+    return out;
+  }
+
+  base::ScopedTempDir dir_;
+  const std::string package_ = std::string(3 * 1024 * 1024 + 17, 'p') + "end";
+};
+
+// P3.4 -------------------------------------------------------------------------
+
+TEST_F(ThoronUpdatePackageTest, TheFileTheManifestNamesIsOk) {
+  EXPECT_EQ(CheckFile(Write("p", package_), FileOf(package_)), FileCheck::kOk);
+}
+
+TEST_F(ThoronUpdatePackageTest, RejectsATruncatedDownload) {
+  const base::FilePath path = Write("p", package_.substr(0, package_.size() - 1));
+  EXPECT_EQ(CheckFile(path, FileOf(package_)), FileCheck::kTruncated);
+  EXPECT_EQ(CheckFile(Write("empty", ""), FileOf(package_)), FileCheck::kTruncated);
+}
+
+TEST_F(ThoronUpdatePackageTest, RejectsAFileWithMoreInIt) {
+  EXPECT_EQ(CheckFile(Write("p", package_ + "x"), FileOf(package_)), FileCheck::kTooLong);
+}
+
+TEST_F(ThoronUpdatePackageTest, RejectsACorruptedDownload) {
+  std::string changed = package_;
+  changed[changed.size() / 2] ^= 1;  // one bit in the middle
+  EXPECT_EQ(CheckFile(Write("p", changed), FileOf(package_)), FileCheck::kCorrupted);
+  changed = package_;
+  changed[0] = 'q';  // the first byte
+  EXPECT_EQ(CheckFile(Write("q", changed), FileOf(package_)), FileCheck::kCorrupted);
+}
+
+TEST_F(ThoronUpdatePackageTest, AMissingFileIsMissing) {
+  EXPECT_EQ(CheckFile(dir_.GetPath().AppendASCII("none"), FileOf(package_)), FileCheck::kMissing);
+}
+
+TEST_F(ThoronUpdatePackageTest, AnExpectationThatIsNoManifestsIsRefused) {
+  const base::FilePath path = Write("p", package_);
+  PackageFile bad = FileOf(package_);
+  bad.sha256 = base::ToUpperASCII(bad.sha256);
+  EXPECT_EQ(CheckFile(path, bad), FileCheck::kBadExpectation);
+  bad = FileOf(package_);
+  bad.sha256.pop_back();
+  EXPECT_EQ(CheckFile(path, bad), FileCheck::kBadExpectation);
+  bad = FileOf(package_);
+  bad.size = 0;
+  EXPECT_EQ(CheckFile(path, bad), FileCheck::kBadExpectation);
+  // and the file itself is left alone
+  EXPECT_EQ(PlaceVerifiedFile(path, bad, dir_.GetPath().AppendASCII("dest")),
+            FileCheck::kBadExpectation);
+  EXPECT_TRUE(base::PathExists(path));
+}
+
+TEST_F(ThoronUpdatePackageTest, AHeldFileCannotBeChangedRenamedOrRemovedUntilLetGo) {
+  const base::FilePath path = Write("package.exe", package_);
+  FileCheck check = FileCheck::kMissing;
+  base::File held = HoldVerifiedFile(path, FileOf(package_), &check);
+  ASSERT_TRUE(held.IsValid());
+  EXPECT_EQ(check, FileCheck::kOk);
+#if BUILDFLAG(IS_WIN)
+  EXPECT_FALSE(base::File(path, base::File::FLAG_OPEN | base::File::FLAG_WRITE).IsValid());
+  const base::FilePath other = Write("other.exe", "another program");
+  EXPECT_FALSE(base::ReplaceFile(other, path, nullptr));
+  EXPECT_FALSE(base::Move(path, dir_.GetPath().AppendASCII("moved.exe")));
+  EXPECT_FALSE(base::DeleteFile(path));
+#endif
+  // An installer may still read it.
+  EXPECT_TRUE(base::File(path, base::File::FLAG_OPEN | base::File::FLAG_READ).IsValid());
+  EXPECT_EQ(Read(path), package_);
+  held.Close();
+  EXPECT_TRUE(base::DeleteFile(path));
+}
+
+TEST_F(ThoronUpdatePackageTest, OnlyAFileThatStillChecksOutIsHeld) {
+  FileCheck check = FileCheck::kOk;
+  const base::FilePath changed = Write("changed.exe", package_ + "x");
+  EXPECT_FALSE(HoldVerifiedFile(changed, FileOf(package_), &check).IsValid());
+  EXPECT_EQ(check, FileCheck::kTooLong);
+  std::string swapped = package_;
+  swapped[swapped.size() / 2] ^= 0x20;
+  const base::FilePath other = Write("swapped.exe", swapped);
+  EXPECT_FALSE(HoldVerifiedFile(other, FileOf(package_), &check).IsValid());
+  EXPECT_EQ(check, FileCheck::kCorrupted);
+  EXPECT_FALSE(HoldVerifiedFile(dir_.GetPath().AppendASCII("none"), FileOf(package_), &check).IsValid());
+  EXPECT_EQ(check, FileCheck::kMissing);
+  PackageFile bad = FileOf(package_);
+  bad.size = 0;
+  EXPECT_FALSE(HoldVerifiedFile(changed, bad, &check).IsValid());
+  EXPECT_EQ(check, FileCheck::kBadExpectation);
+}
+
+TEST_F(ThoronUpdatePackageTest, AVerifiedFileIsPlaced) {
+  const base::FilePath downloaded = Write("download.part", package_);
+  const base::FilePath destination = dir_.GetPath().AppendASCII("package.exe");
+  EXPECT_EQ(PlaceVerifiedFile(downloaded, FileOf(package_), destination), FileCheck::kOk);
+  EXPECT_FALSE(base::PathExists(downloaded));
+  EXPECT_EQ(Read(destination), package_);
+}
+
+TEST_F(ThoronUpdatePackageTest, NeverPlacesAnUnverifiedFile) {
+  const base::FilePath destination = Write("package.exe", "the package that was there");
+  std::string changed = package_;
+  changed[7] = '!';
+  for (const auto& [content, want] :
+       std::vector<std::pair<std::string, FileCheck>>{
+           {changed, FileCheck::kCorrupted},
+           {package_.substr(0, 100), FileCheck::kTruncated},
+           {package_ + "more", FileCheck::kTooLong}}) {
+    const base::FilePath downloaded = Write("download.part", content);
+    EXPECT_EQ(PlaceVerifiedFile(downloaded, FileOf(package_), destination), want);
+    // the download is gone, and what was at the destination is untouched
+    EXPECT_FALSE(base::PathExists(downloaded));
+    EXPECT_EQ(Read(destination), "the package that was there");
+  }
+  EXPECT_EQ(PlaceVerifiedFile(dir_.GetPath().AppendASCII("none"), FileOf(package_), destination),
+            FileCheck::kMissing);
+  EXPECT_EQ(Read(destination), "the package that was there");
+}
+
+// P4.2 -------------------------------------------------------------------------
+
+Decision UpdateWith(std::optional<int64_t> delta_size, int64_t full_size = 100) {
+  Decision decision;
+  decision.outcome = Outcome::kUpdate;
+  decision.full = PackageFile{"https://github.com/f", full_size, std::string(64, 'a')};
+  if (delta_size) {
+    decision.delta = PackageFile{"https://github.com/d", *delta_size, std::string(64, 'b')};
+  }
+  return decision;
+}
+
+TEST(ThoronUpdatePlanTest, TheSmallerDeltaComesFirstAndTheFullPackageAfterIt) {
+  const Decision decision = UpdateWith(30);
+  const std::vector<DownloadStep> plan = PlanDownloads(decision);
+  ASSERT_EQ(plan.size(), 2u);
+  EXPECT_TRUE(plan[0].delta);
+  EXPECT_EQ(plan[0].file, *decision.delta);
+  EXPECT_FALSE(plan[1].delta);
+  EXPECT_EQ(plan[1].file, *decision.full);
+}
+
+TEST(ThoronUpdatePlanTest, ADeltaThatIsNotSmallerIsNotDownloaded) {
+  for (int64_t size : {100, 150}) {
+    const std::vector<DownloadStep> plan = PlanDownloads(UpdateWith(size));
+    ASSERT_EQ(plan.size(), 1u);
+    EXPECT_FALSE(plan[0].delta);
+  }
+  const std::vector<DownloadStep> plan = PlanDownloads(UpdateWith(std::nullopt));
+  ASSERT_EQ(plan.size(), 1u);
+  EXPECT_FALSE(plan[0].delta);
+}
+
+TEST(ThoronUpdatePlanTest, NothingIsDownloadedWithoutAnUpdate) {
+  Decision decision = UpdateWith(30);
+  for (Outcome outcome : {Outcome::kUpToDate, Outcome::kBadSignature, Outcome::kExpired,
+                          Outcome::kDowngrade, Outcome::kNoPackage}) {
+    decision.outcome = outcome;
+    EXPECT_TRUE(PlanDownloads(decision).empty());
+  }
+  decision = UpdateWith(30);
+  decision.full.reset();
+  EXPECT_TRUE(PlanDownloads(decision).empty());
+}
+
+// P4.6: an updater that is too old fetches the whole package, never a delta,
+// and the updater inside it applies the release.
+TEST(ThoronUpdatePlanTest, AnUpdaterThatIsTooOldGetsTheWholePackageOnly) {
+  Decision decision = UpdateWith(30);
+  decision.outcome = Outcome::kUpdaterTooOld;
+  const std::vector<DownloadStep> plan = PlanDownloads(decision);
+  ASSERT_EQ(plan.size(), 1u);
+  EXPECT_FALSE(plan[0].delta);
+  EXPECT_EQ(plan[0].file, *decision.full);
+  decision.full.reset();
+  EXPECT_TRUE(PlanDownloads(decision).empty());
+}
+
+TEST(ThoronUpdatePlanTest, TheDeltaIsUsedWhenItHolds) {
+  std::vector<bool> tried;
+  const std::optional<DownloadStep> used =
+      RunDownloadPlan(PlanDownloads(UpdateWith(30)), [&](const DownloadStep& step) {
+        tried.push_back(step.delta);
+        return true;
+      });
+  ASSERT_TRUE(used);
+  EXPECT_TRUE(used->delta);
+  EXPECT_EQ(tried, (std::vector<bool>{true}));
+}
+
+TEST(ThoronUpdatePlanTest, ADeltaThatDoesNotMatchFallsBackToTheFullPackage) {
+  std::vector<bool> tried;
+  const std::optional<DownloadStep> used =
+      RunDownloadPlan(PlanDownloads(UpdateWith(30)), [&](const DownloadStep& step) {
+        tried.push_back(step.delta);
+        return !step.delta;  // the delta's result does not match
+      });
+  ASSERT_TRUE(used);
+  EXPECT_FALSE(used->delta);
+  EXPECT_EQ(tried, (std::vector<bool>{true, false}));
+}
+
+TEST(ThoronUpdatePlanTest, NothingHoldsNothingIsUsed) {
+  int tried = 0;
+  EXPECT_FALSE(RunDownloadPlan(PlanDownloads(UpdateWith(30)), [&](const DownloadStep&) {
+    ++tried;
+    return false;
+  }));
+  EXPECT_EQ(tried, 2);
+  EXPECT_FALSE(RunDownloadPlan({}, [](const DownloadStep&) { return true; }));
+}
+
+// P4.4 -------------------------------------------------------------------------
+
+Processor X64(bool sse41, bool sse42, bool avx, bool avx2, bool fma3) {
+  Processor cpu;
+  cpu.x64 = true;
+  cpu.sse41 = sse41;
+  cpu.sse42 = sse42;
+  cpu.avx = avx;
+  cpu.avx2 = avx2;
+  cpu.fma3 = fma3;
+  return cpu;
+}
+
+TEST(ThoronUpdateVariantTest, EachProcessorGetsTheFastestBuildThatRunsOnIt) {
+  const Processor haswell = X64(true, true, true, true, true);
+  const Processor excavator = haswell;                         // AMD, AVX2 and FMA
+  const Processor goldmont = X64(true, true, false, false, false);  // Celeron, Pentium Silver
+  const Processor sandy_bridge = X64(true, true, true, false, false);  // AVX, no AVX2
+  const Processor avx2_without_fma = X64(true, true, true, true, false);
+  const Processor penryn = X64(true, false, false, false, false);  // SSE4.1 only
+  const Processor merom = X64(false, false, false, false, false);
+  Processor arm;
+  arm.arm64 = true;
+
+  using V = std::vector<Variant>;
+  EXPECT_EQ(VariantsFor(Os::kWindows, haswell), (V{Variant::kWinX64Avx2, Variant::kWinX64Sse4}));
+  EXPECT_EQ(VariantsFor(Os::kLinux, excavator),
+            (V{Variant::kLinuxX64Avx2, Variant::kLinuxX64Sse4}));
+  EXPECT_EQ(VariantsFor(Os::kWindows, goldmont), (V{Variant::kWinX64Sse4}));
+  EXPECT_EQ(VariantsFor(Os::kWindows, sandy_bridge), (V{Variant::kWinX64Sse4}));
+  EXPECT_EQ(VariantsFor(Os::kWindows, avx2_without_fma), (V{Variant::kWinX64Sse4}));
+  EXPECT_TRUE(VariantsFor(Os::kWindows, penryn).empty());
+  EXPECT_TRUE(VariantsFor(Os::kLinux, merom).empty());
+  EXPECT_EQ(VariantsFor(Os::kWindows, arm), (V{Variant::kWinArm64Armv8}));
+  EXPECT_EQ(VariantsFor(Os::kLinux, arm), (V{Variant::kLinuxArm64Armv8}));
+}
+
+TEST(ThoronUpdateVariantTest, ACopyMovedToAnOlderProcessorIsToldApart) {
+  const Processor goldmont = X64(true, true, false, false, false);
+  EXPECT_FALSE(RunsOn(Variant::kWinX64Avx2, goldmont));
+  EXPECT_TRUE(RunsOn(Variant::kWinX64Sse4, goldmont));
+  Processor arm;
+  arm.arm64 = true;
+  EXPECT_FALSE(RunsOn(Variant::kWinX64Sse4, arm));
+  EXPECT_FALSE(RunsOn(Variant::kWinArm64Armv8, goldmont));
+}
+
+TEST(ThoronUpdateVariantTest, AnAvx512BuildNeedsAvx512AndIsNeverOffered) {
+  Processor skylake_x;
+  skylake_x.x64 = skylake_x.sse41 = skylake_x.sse42 = skylake_x.avx = skylake_x.avx2 =
+      skylake_x.fma3 = skylake_x.avx512 = true;
+  Processor haswell = skylake_x;
+  haswell.avx512 = false;
+  EXPECT_TRUE(RunsOn(Variant::kWinX64Avx512, skylake_x));
+  EXPECT_TRUE(RunsOn(Variant::kLinuxX64Avx512, skylake_x));
+  EXPECT_FALSE(RunsOn(Variant::kWinX64Avx512, haswell));
+  Processor odd = skylake_x;  // AVX-512 said, AVX2 not: not a processor to trust
+  odd.avx2 = false;
+  EXPECT_FALSE(RunsOn(Variant::kWinX64Avx512, odd));
+  using V = std::vector<Variant>;
+  EXPECT_EQ(VariantsFor(Os::kWindows, skylake_x), (V{Variant::kWinX64Avx2, Variant::kWinX64Sse4}));
+  EXPECT_EQ(VariantName(Variant::kWinX64Avx512), "win-x64-avx512");
+  EXPECT_EQ(ParseVariant("linux-x64-avx512"), Variant::kLinuxX64Avx512);
+}
+
+TEST(ThoronUpdateVariantTest, TheProcessorThisRunsOnRunsThisBuild) {
+  // The tests themselves are built like the browser, so their processor runs
+  // at least one variant of this system.
+#if BUILDFLAG(IS_WIN)
+  EXPECT_FALSE(VariantsFor(Os::kWindows, ThisProcessor()).empty());
+#elif BUILDFLAG(IS_LINUX)
+  EXPECT_FALSE(VariantsFor(Os::kLinux, ThisProcessor()).empty());
+#endif
+}
+
+// A program that comes through an update must start: on Linux the updater's
+// own writes make files that may not be run (rw-------).
+TEST(ThoronUpdateFileTest, AProgramItWroteCanBeRunAndOtherFilesStayAsTheyAre) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath elf = dir.GetPath().AppendASCII("thoron");
+  const base::FilePath script = dir.GetPath().AppendASCII("launcher");
+  const base::FilePath data = dir.GetPath().AppendASCII("resources.pak");
+  const base::FilePath tiny = dir.GetPath().AppendASCII("one");
+  ASSERT_TRUE(base::WriteFile(elf, std::string_view("\x7F" "ELF\x02")));
+  ASSERT_TRUE(base::WriteFile(script, "#!/bin/sh\nexit 0\n"));
+  ASSERT_TRUE(base::WriteFile(data, "PAK not a program"));
+  ASSERT_TRUE(base::WriteFile(tiny, "#"));
+  EXPECT_TRUE(MakeRunnableIfProgram(elf));
+  EXPECT_TRUE(MakeRunnableIfProgram(script));
+  EXPECT_TRUE(MakeRunnableIfProgram(data));
+  EXPECT_TRUE(MakeRunnableIfProgram(tiny));
+#if BUILDFLAG(IS_POSIX)
+  EXPECT_FALSE(MakeRunnableIfProgram(dir.GetPath().AppendASCII("missing")));
+  int mode = 0;
+  ASSERT_TRUE(base::SetPosixFilePermissions(data, 0600));
+  EXPECT_TRUE(MakeRunnableIfProgram(data));
+  ASSERT_TRUE(base::GetPosixFilePermissions(elf, &mode));
+  EXPECT_EQ(mode, 0755);
+  ASSERT_TRUE(base::GetPosixFilePermissions(script, &mode));
+  EXPECT_EQ(mode, 0755);
+  ASSERT_TRUE(base::GetPosixFilePermissions(data, &mode));
+  EXPECT_EQ(mode, 0600);
