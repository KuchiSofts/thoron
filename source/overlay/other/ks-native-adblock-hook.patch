@@ -0,0 +1,415 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/thoron_portable/unlock_linux.h"
+
+#include <fcntl.h>
+#include <unistd.h>
+
+#include <array>
+#include <cstdio>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/base64.h"
+#include "base/command_line.h"
+#include "base/containers/span.h"
+#include "base/files/file_enumerator.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/no_destructor.h"
+#include "base/posix/eintr_wrapper.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "components/os_crypt/async/browser/thoron_profile_key.h"
+#include "components/prefs/pref_service.h"
+#include "components/thoron_portable_key/key_file.h"
+#include "components/thoron_portable_key/key_store.h"
+#include "components/thoron_portable_key/local_state_key.h"
+#include "components/thoron_portable_key/os_key_store.h"
+#include "components/thoron_portable_key/recovery_key.h"
+#include "components/thoron_portable_key/reencrypt_linux.h"
+#include "components/thoron_portable_key/secret_bytes.h"
+#include "components/user_data_importer/chromium_family/password_decryptor_linux.h"
+
+namespace thoron_portable {
+
+namespace {
+
+namespace tpk = thoron_portable_key;
+
+bool g_quit = false;
+int g_exit_code = 0;
+base::FilePath* g_user_data_dir = nullptr;
+
+// A secret longer than this is not one a person typed.
+constexpr size_t kMostSecretBytes = 4096;
+
+UnlockResult Quit(int code, std::string_view message) {
+  if (!message.empty()) {
+    fprintf(stderr, "Thoron: %.*s\n", static_cast<int>(message.size()), message.data());
+    // for the launcher's dialog when no terminal shows stderr; it holds no secret
+    if (code == kExitCannotUnlock && g_user_data_dir) {
+      base::WriteFile(g_user_data_dir->Append(kProblemFile), message);
+    }
+  }
+  g_quit = true;
+  g_exit_code = code;
+  return UnlockResult::kQuit;
+}
+
+std::string_view ReadProblemText(const tpk::StoredKeyFile& stored) {
+  if (stored.problem == tpk::StoreProblem::kUnreadable) {
+    return "this copy's key file (\"Thoron Portable Key\" in its User Data folder) cannot be read, so its "
+           "saved passwords and sign-ins stay locked. Check that the drive is not damaged or full, then start "
+           "Thoron again.";
+  }
+  switch (stored.read_problem) {
+    case tpk::ReadProblem::kNewerFormat:
+      return "this copy's key file was written by a newer Thoron. Open this copy with that Thoron or a newer one.";
+    case tpk::ReadProblem::kTooWeak:
+    case tpk::ReadProblem::kTooCostly:
+      return "this copy's key file asks for a passphrase check outside what Thoron allows, so someone may have "
+             "changed it. Put back the file \"Thoron Portable Key\" from a backup of this copy.";
+    default:
+      return "this copy's key file is damaged, so its saved passwords and sign-ins cannot be opened. Put back "
+             "the file \"Thoron Portable Key\" from a backup of this copy. Thoron changed nothing.";
+  }
+}
+
+// What the launcher wrote on the pipe, or nothing.
+std::optional<std::pair<bool, std::string>> ReadSecret() {
+  const base::CommandLine& command = *base::CommandLine::ForCurrentProcess();
+  int fd = -1;
+  if (!base::StringToInt(command.GetSwitchValueASCII(kSecretFdSwitch), &fd) || fd < 0) {
+    return std::nullopt;
+  }
+  std::string text;
+  std::array<char, 512> chunk;
+  // the passphrase's bytes would otherwise stay on the stack and in the
+  // string's earlier buffers: room for the most a pipe gives, wiped below
+  text.reserve(kMostSecretBytes + chunk.size());
+  while (text.size() <= kMostSecretBytes) {
+    const ssize_t n = HANDLE_EINTR(read(fd, chunk.data(), chunk.size()));
+    if (n <= 0) {
+      break;
+    }
+    text.append(chunk.data(), static_cast<size_t>(n));
+  }
+  tpk::Wipe(base::as_writable_byte_span(chunk));
+  if (fd <= STDERR_FILENO) {
+    // the browser's input (the launcher's pipe): /dev/null takes its place, so
+    // the number is never handed to a file the browser opens later
+    const int null_fd = HANDLE_EINTR(open("/dev/null", O_RDONLY | O_CLOEXEC));
+    if (null_fd >= 0) {
+      dup2(null_fd, fd);
+      IGNORE_EINTR(close(null_fd));
+    }
+  } else {
+    IGNORE_EINTR(close(fd));
+  }
+  const size_t newline = text.find('\n');
+  if (text.size() > kMostSecretBytes || newline == std::string::npos) {
+    tpk::WipeString(text);
+    return std::nullopt;
+  }
+  const bool recovery = std::string_view(text).substr(0, newline) == "recovery";
+  std::string secret = text.substr(newline + 1);
+  tpk::WipeString(text);
+  while (!secret.empty() && (secret.back() == '\n' || secret.back() == '\r')) {
+    secret.pop_back();
+  }
+  return std::make_pair(recovery, std::move(secret));
+}
+
+// Every profile folder of the copy: a folder of User Data with Preferences.
+std::vector<base::FilePath> ProfileFolders(const base::FilePath& user_data_dir) {
+  std::vector<base::FilePath> out;
+  base::FileEnumerator folders(user_data_dir, /*recursive=*/false, base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath folder = folders.Next(); !folder.empty(); folder = folders.Next()) {
+    if (base::PathExists(folder.Append(FILE_PATH_LITERAL("Preferences")))) {
+      out.push_back(folder);
+    }
+  }
+  return out;
+}
+
+// Every profile folder's values back under Chromium's own Linux key, for the
+// removal of the lock; true once nothing of the copy's key is left in them.
+// Chromium's fixed key ("v10") is used, which every Linux build of Chromium
+// reads: not a keyring's, because the secret found first need not be the one
+// the browser reads on this PC (another browser's, another collection), and a
+// copy moves between PCs. An unlocked copy's values are that open anyway.
+bool ReturnToChromium(const base::FilePath& user_data_dir, const tpk::SecretBytes& key) {
+  // Chromium's fixed password (components/os_crypt/async/browser/posix_key_provider.cc)
+  std::array<uint8_t, 16> fixed = user_data_importer::chromium_family::PasswordKey::DeriveKey("peanuts");
+  bool finished = true;
+  tpk::ReencryptCounts counts;
+  for (const base::FilePath& profile : ProfileFolders(user_data_dir)) {
+    if (tpk::ReturnProfileToChromium(profile, key.span().first<32>(), fixed, "v10", &counts) !=
+        tpk::ReencryptResult::kDone) {
+      finished = false;
+    }
+  }
+  if (!finished || counts.unreadable != 0) {
+    fprintf(stderr,
+            "Thoron: the lock stays for now: %d value(s) are back under Chromium's key, %d could not be; Thoron "
+            "tries again at its next start.\n",
+            counts.passwords + counts.cookies + counts.other, counts.unreadable);
+    return false;
+  }
+  return true;
+}
+
+// The encryption of the copy's values with its key (the owner's decision of
+// 2026-11-21), looked for at every start of a locked copy, not only when Local
+// State says it waits (a lock whose Local State was not written, or was put
+// back, still gets it): a database with nothing to turn is not touched;
+// otherwise a checked copy of it first.
+void FinishReencryption(const base::FilePath& user_data_dir, PrefService* local_state,
+                        const tpk::SecretBytes& key) {
+  if (!local_state || key.span().size() != 32) {
+    return;
+  }
+  user_data_importer::chromium_family::PasswordKey old =
+      user_data_importer::chromium_family::PasswordKey::ForUserData(user_data_dir);
+  auto read_old = [&old](base::span<const uint8_t> value) -> std::optional<std::string> {
+    std::string plain;
+    if (user_data_importer::chromium_family::DecryptPasswordValue(old, value, &plain) !=
+        user_data_importer::chromium_family::DecryptResult::kOk) {
+      return std::nullopt;
+    }
+    return plain;
+  };
+  const base::span<const uint8_t, 32> new_key(key.span().first<32>());
+  bool finished = true;
+  tpk::ReencryptCounts counts;
+  for (const base::FilePath& profile : ProfileFolders(user_data_dir)) {
+    if (tpk::ReencryptProfile(profile, read_old, new_key, &counts) != tpk::ReencryptResult::kDone) {
+      finished = false;
+    }
+  }
+  old.Clear();
+  if (finished && counts.unreadable == 0) {
+    if (local_state->GetBoolean(kReencryptPendingPref)) {
+      local_state->SetBoolean(kReencryptPendingPref, false);
+      local_state->CommitPendingWrite();
+    }
+  } else {
+    fprintf(stderr,
+            "Thoron: %d password(s), %d cookie(s) and %d other value(s) are encrypted with this copy's key; %d "
+            "value(s) could not be read with the old keys (a locked keyring, or another PC's), so they stay as "
+            "they are and Thoron looks again at its next start.\n",
+            counts.passwords, counts.cookies, counts.other, counts.unreadable);
+  }
+}
+
+// Whether Local State asks for the lock's removal with the proof the page made
+// for this very key file (key_file.h, RemovalProof). A request without it is
+// dropped: Local State is plain on the drive, so anyone holding the drive could
+// otherwise have a lock removed at its owner's next start.
+bool RemovalAsked(PrefService* local_state, const tpk::KeyFile& file, const tpk::SecretBytes& key) {
+  if (!local_state || !local_state->GetBoolean(kRemovePendingPref)) {
+    return false;
+  }
+  std::string proof;
+  const bool asked = base::Base64Decode(local_state->GetString(kRemoveProofPref), &proof) &&
+                     tpk::IsRemovalProof(file, key, base::as_byte_span(proof));
+  if (!asked) {
+    local_state->SetBoolean(kRemovePendingPref, false);
+    local_state->ClearPref(kRemoveProofPref);
+    local_state->CommitPendingWrite();
+    fprintf(stderr,
+            "Thoron: a request to remove this copy's lock was not made by someone who opened it, or the key file "
+            "changed since; the lock stays.\n");
+  }
+  return asked;
+}
+
+// The copy opened with `key`: the lock removed when that was asked for (every
+// value back under Chromium's key first, then the key file, and the key kept
+// only for reading what is still under it), or the key given to os_crypt and
+// the encryption with it finished.
+UnlockResult Opened(const base::FilePath& user_data_dir,
+                    PrefService* local_state,
+                    const tpk::SecretBytes& key,
+                    const tpk::KeyFile& file) {
+  if (local_state && !local_state->GetString(kFormerKeyPref).empty()) {
+    // a former key never stays readable beside a lock (an end between a
+    // removal and its last write, or an edited Local State)
+    local_state->ClearPref(kFormerKeyPref);
+    local_state->CommitPendingWrite();
+  }
+  if (RemovalAsked(local_state, file, key) && ReturnToChromium(user_data_dir, key)) {
+    if (tpk::RemoveKeyFile(user_data_dir)) {
+      // written once the key file is gone, never beside it
+      local_state->SetString(kFormerKeyPref, base::Base64Encode(key.span()));
+      local_state->SetBoolean(kLockedPref, false);
+      local_state->SetBoolean(kReencryptPendingPref, false);
+      local_state->SetBoolean(kRemovePendingPref, false);
+      local_state->ClearPref(kRemoveProofPref);
+      local_state->CommitPendingWrite();
+      os_crypt_async::SetThoronProfileKey(key.span());  // not locked: it only reads
+      return UnlockResult::kNotLocked;
+    }
+    fprintf(stderr, "Thoron: the key file could not be removed; the copy stays locked.\n");
+  }
+  os_crypt_async::SetThoronProfileLocked();
+  os_crypt_async::SetThoronProfileKey(key.span());
+  FinishReencryption(user_data_dir, local_state, key);
+  return UnlockResult::kUnlocked;
+}
+
+// The databases that hold a lock's values set aside in every profile folder,
+// for a start without the key file the person chose.
+void SetAsideLockedValues(const base::FilePath& user_data_dir) {
+  for (const base::FilePath& profile : ProfileFolders(user_data_dir)) {
+    if (!tpk::SetAsideLockedDatabases(profile)) {
+      fprintf(stderr, "Thoron: a database of %s holding locked values could not be set aside.\n",
+              profile.BaseName().value().c_str());
+    }
+  }
+}
+
+// True when a password or cookie database of the copy holds a lock's values.
+bool HoldsLockedValues(const base::FilePath& user_data_dir) {
+  for (const base::FilePath& profile : ProfileFolders(user_data_dir)) {
+    if (!tpk::FilesWithPortableValues(profile).empty()) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+UnlockResult UnlockIfLocked(const base::FilePath& user_data_dir, PrefService* local_state) {
+  static base::NoDestructor<base::FilePath> folder(user_data_dir);
+  g_user_data_dir = folder.get();
+  base::DeleteFile(user_data_dir.Append(kProblemFile));
+  if (!tpk::HasKeyFile(user_data_dir)) {
+    const bool without_key =
+        base::CommandLine::ForCurrentProcess()->HasSwitch("thoron-portable-start-without-key");
+    bool locked = local_state && local_state->GetBoolean(kLockedPref);
+    if (!locked && local_state && local_state->GetString(kFormerKeyPref).empty() &&
+        HoldsLockedValues(user_data_dir)) {
+      // A lock's values, no key file, and Local State says unlocked: Thoron
+      // never removes a lock so (it turns the values back first and keeps the
+      // key for the rest), so the key file was taken and Local State edited.
+      // The copy is treated as locked (from its values, so also when this
+      // write does not reach the drive): the launcher asks the person.
+      locked = true;
+      local_state->SetBoolean(kLockedPref, true);
+      local_state->CommitPendingWrite();
+    }
+    if (locked) {
+      // The key file is gone: put back from a backup, or start without what it
+      // kept locked, which the launcher asks the person about.
+      if (!without_key) {
+        return Quit(kExitCannotUnlock,
+                    "this copy was locked with a passphrase and its key file \"Thoron Portable Key\" is missing. "
+                    "Put it back from a backup of this copy, or start Thoron without its saved passwords and "
+                    "sign-ins.");
+      }
+      // kept aside, not deleted: they open again if the key file turns up
+      SetAsideLockedValues(user_data_dir);
+      local_state->SetBoolean(kLockedPref, false);
+      local_state->SetBoolean(kReencryptPendingPref, false);
+      local_state->CommitPendingWrite();
+    }
+    // A removed lock's key only reads what is still under it.
+    if (local_state) {
+      std::string former;
+      if (base::Base64Decode(local_state->GetString(kFormerKeyPref), &former) && former.size() == 32) {
+        os_crypt_async::SetThoronProfileKey(base::as_byte_span(former));
+      }
+      tpk::WipeString(former);
+    }
+    return UnlockResult::kNotLocked;
+  }
+  tpk::StoredKeyFile stored = tpk::ReadKeyFile(user_data_dir);
+  if (stored.problem == tpk::StoreProblem::kNoKeyFile) {
+    return UnlockResult::kNotLocked;
+  }
+  if (!stored.file) {
+    return Quit(kExitCannotUnlock, ReadProblemText(stored));
+  }
+  // A PC remembered in this user's keyring opens the copy without a question
+  // (the launcher's first try gives no passphrase).
+  {
+    std::unique_ptr<tpk::OsKeyStore> store = tpk::CreateOsKeyStore();
+    tpk::OpenProblem remembered = tpk::OpenProblem::kNoLock;
+    if (std::optional<tpk::SecretBytes> key = tpk::OpenOnThisPc(*stored.file, *store, &remembered)) {
+      if (std::optional<std::pair<bool, std::string>> unused = ReadSecret()) {
+        tpk::WipeString(unused->second);
+      }
+      return Opened(user_data_dir, local_state, *key, *stored.file);
+    }
+    if (remembered == tpk::OpenProblem::kChanged) {
+      return Quit(kExitCannotUnlock,
+                  "this copy's key file was changed by someone who could not open it, so Thoron does not trust "
+                  "it. Put back the file \"Thoron Portable Key\" from a backup of this copy.");
+    }
+  }
+  std::optional<std::pair<bool, std::string>> typed = ReadSecret();
+  if (!typed) {
+    return Quit(kExitNeedsSecret,
+                "this copy is locked with a passphrase: start it with its launcher (the file thoron in its "
+                "folder), which asks for it.");
+  }
+  tpk::OpenProblem problem = tpk::OpenProblem::kWrongSecret;
+  std::optional<tpk::SecretBytes> key;
+  if (typed->first) {
+    std::optional<tpk::SecretBytes> recovery = tpk::ParseRecoveryKey(typed->second);
+    if (recovery) {
+      key = tpk::OpenWithRecoveryKey(*stored.file, *recovery, &problem);
+    }
+  } else {
+    // PassphraseFromTyped() wipes what it was given once it has read it.
+    std::u16string as_typed = base::UTF8ToUTF16(typed->second);
+    if (std::optional<tpk::SecretBytes> passphrase = tpk::PassphraseFromTyped(as_typed)) {
+      key = tpk::OpenWithPassphrase(*stored.file, std::move(*passphrase), &problem);
+    }
+    tpk::WipeString(as_typed);
+    // The launcher has one field: what does not open the copy as a passphrase
+    // may be its recovery key (eight groups of four characters).
+    if (!key && problem != tpk::OpenProblem::kChanged) {
+      if (std::optional<tpk::SecretBytes> recovery = tpk::ParseRecoveryKey(typed->second)) {
+        tpk::OpenProblem recovery_problem = tpk::OpenProblem::kWrongSecret;
+        key = tpk::OpenWithRecoveryKey(*stored.file, *recovery, &recovery_problem);
+        if (!key && recovery_problem == tpk::OpenProblem::kChanged) {
+          problem = recovery_problem;
+        }
+      }
+    }
+  }
+  tpk::WipeString(typed->second);
+  if (!key) {
+    switch (problem) {
+      case tpk::OpenProblem::kChanged:
+        return Quit(kExitCannotUnlock,
+                    "this copy's key file was changed by someone who could not open it, so Thoron does not trust "
+                    "it. Put back the file \"Thoron Portable Key\" from a backup of this copy.");
+      case tpk::OpenProblem::kCannotDerive:
+        return Quit(kExitWrongSecret,
+                    "Thoron could not get the memory it needs to check the passphrase. Close other programs and "
+                    "try again.");
+      default:
+        return Quit(kExitWrongSecret, "");
+    }
+  }
+  return Opened(user_data_dir, local_state, *key, *stored.file);
+}
+
+bool QuitBeforeStart() {
+  return g_quit;
+}
+
+int QuitExitCode() {
+  return g_exit_code;
+}
+
+}  // namespace thoron_portable
diff --git a/chrome/browser/thoron_portable/unlock_linux.h b/chrome/browser/thoron_portable/unlock_linux.h
new file mode 100644
index 0000000000000000000000000000000000000000..2c3cfc70d223ce352e2e1e562b5f83be6f77e702
--- /dev/null
+++ b/chrome/browser/thoron_portable/unlock_linux.h
@@ -0,0 +1,65 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_THORON_PORTABLE_UNLOCK_LINUX_H_
+#define CHROME_BROWSER_THORON_PORTABLE_UNLOCK_LINUX_H_
+
+class PrefService;
+
+namespace base {
+class FilePath;
+}  // namespace base
+
+// Thoron (ROADMAP P4.9, Linux): a portable copy locked with a passphrase, as on
+// Windows (unlock_win.h), but the copy's launcher asks for the passphrase (a
+// desktop dialog, or the terminal) and hands what was typed to the browser on a
+// pipe; the browser checks it before os_crypt starts. Linux keeps no key of its
+// own per copy, so locking gave the copy a new key, and its saved passwords and
+// cookies are encrypted again with it at the first start after the lock
+// (kReencryptPendingPref; components/thoron_portable_key/reencrypt_linux.h).
+namespace thoron_portable {
+
+// Local State: this copy was locked with a passphrase (as on Windows).
+inline constexpr char kLockedPref[] = "thoron_portable.locked";
+// Local State: the copy's values still wait to be encrypted again with its key.
+inline constexpr char kReencryptPendingPref[] = "thoron_portable.reencrypt_pending";
+// Local State: the lock goes at the next start (chrome://thoron-portable), only
+// with kRemoveProofPref, which only the opened key makes (key_file.h,
+// RemovalProof): Local State alone cannot remove a lock.
+inline constexpr char kRemovePendingPref[] = "thoron_portable.remove_pending";
+inline constexpr char kRemoveProofPref[] = "thoron_portable.remove_proof";
+// Local State, once a lock was removed: the copy's former key (base64), which
+// only reads what is still under it in the stores Thoron does not turn back
+// (an unlocked copy's values are as open as Chromium's fixed key keeps them).
+// A later lock takes this key again instead of a new one, so no value is ever
+// left under a key that is gone; it is cleared while the copy is locked.
+inline constexpr char kFormerKeyPref[] = "thoron_portable.former_key";
+// The launcher's pipe: "passphrase\n<what was typed>" or "recovery\n<...>".
+inline constexpr char kSecretFdSwitch[] = "thoron-portable-secret-fd";
+// In User Data, why the copy cannot be unlocked, for the launcher to show.
+inline constexpr char kProblemFile[] = "Thoron Unlock Problem";
+
+// The exit codes the launcher reads (above Chromium's own, which end at 43:
+// chrome/common/chrome_result_codes.h).
+inline constexpr int kExitWrongSecret = 81;   // ask again
+inline constexpr int kExitCannotUnlock = 82;  // said on stderr; do not ask again
+inline constexpr int kExitNeedsSecret = 83;   // started without the launcher's pipe
+
+enum class UnlockResult {
+  kNotLocked,  // no key file: the copy keeps Chromium's own keys
+  kUnlocked,   // the profile key is given to os_crypt
+  kQuit,       // the browser stops with QuitExitCode()
+};
+
+// Called before os_crypt's key providers are made
+// (ChromeBrowserMainPartsLinux::PostCreateMainMessageLoop).
+UnlockResult UnlockIfLocked(const base::FilePath& user_data_dir, PrefService* local_state);
+
+// True after UnlockIfLocked() gave kQuit, and the exit code the browser stops
+// with then.
+bool QuitBeforeStart();
+int QuitExitCode();
+
+}  // namespace thoron_portable
+
+#endif  // CHROME_BROWSER_THORON_PORTABLE_UNLOCK_LINUX_H_
diff --git a/chrome/browser/thoron_portable/unlock_win.cc b/chrome/browser/thoron_portable/unlock_win.cc
new file mode 100644
index 0000000000000000000000000000000000000000..68a73b6f75a783b6afaa481a5f7066049909686a
--- /dev/null
+++ b/chrome/browser/thoron_portable/unlock_win.cc
@@ -0,0 +1,172 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/thoron_portable/unlock_win.h"
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/thoron_portable/unlock_dialog_win.h"
+#include "components/prefs/pref_service.h"
+#include "components/os_crypt/async/browser/thoron_profile_key.h"
+#include "components/thoron_portable_key/key_file.h"
+#include "components/thoron_portable_key/key_store.h"
+#include "components/thoron_portable_key/local_state_key.h"
+#include "components/thoron_portable_key/os_key_store.h"
+#include "components/thoron_portable_key/recovery_key.h"
+#include "components/thoron_portable_key/secret_bytes.h"
+
+namespace thoron_portable {
+
+namespace {
+
+namespace tpk = thoron_portable_key;
+
+bool g_quit = false;
+
+std::u16string ReadProblemText(const tpk::StoredKeyFile& stored) {
+  if (stored.problem == tpk::StoreProblem::kUnreadable) {
+    return u"Thoron could not read this copy's key file (\"Thoron Portable "
+           u"Key\" in its User Data folder), so its saved passwords and "
+           u"sign-ins stay locked. Check that the drive is not damaged or "
+           u"full, then start Thoron again.";
+  }
+  switch (stored.read_problem) {
+    case tpk::ReadProblem::kNewerFormat:
+      return u"This copy's key file was written by a newer Thoron. Open this "
+             u"copy with that Thoron or a newer one.";
+    case tpk::ReadProblem::kTooWeak:
+      return u"This copy's key file asks for a weaker passphrase check than "
+             u"Thoron allows, so someone may have changed it. Put back the "
+             u"file \"Thoron Portable Key\" from a backup of this copy.";
+    case tpk::ReadProblem::kTooCostly:
+      return u"This copy's key file asks for more memory or time than Thoron "
+             u"allows, so someone may have changed it. Put back the file "
+             u"\"Thoron Portable Key\" from a backup of this copy.";
+    default:
+      return u"This copy's key file (\"Thoron Portable Key\" in its User Data "
+             u"folder) is damaged, so its saved passwords and sign-ins cannot "
+             u"be opened. Put back the file from a backup of this copy. "
+             u"Thoron changed nothing.";
+  }
+}
+
+constexpr char16_t kChanged[] =
+    u"This copy's key file was changed by someone who could not open it, so "
+    u"Thoron does not trust it. Put back the file \"Thoron Portable Key\" from "
+    u"a backup of this copy.";
+
+struct Unlock {
+  base::FilePath folder;
+  tpk::KeyFile file;
+  std::unique_ptr<tpk::OsKeyStore> store;
+  bool opened = false;
+};
+
+std::u16string Try(Unlock* unlock, UnlockAttempt& attempt) {
+  tpk::OpenProblem problem = tpk::OpenProblem::kWrongSecret;
+  std::optional<tpk::SecretBytes> key;
+  if (attempt.recovery) {
+    const std::string typed = base::UTF16ToUTF8(attempt.secret);
+    std::optional<tpk::SecretBytes> recovery = tpk::ParseRecoveryKey(typed);
+    if (!recovery) {
+      return u"That is not this copy's recovery key: check each group of four "
+             u"characters.";
+    }
+    key = tpk::OpenWithRecoveryKey(unlock->file, *recovery, &problem);
+  } else {
+    std::optional<tpk::SecretBytes> passphrase =
+        tpk::PassphraseFromTyped(attempt.secret);
+    if (passphrase) {
+      key = tpk::OpenWithPassphrase(unlock->file, std::move(*passphrase),
+                                    &problem);
+    }
+  }
+  if (!key) {
+    switch (problem) {
+      case tpk::OpenProblem::kChanged:
+        return kChanged;
+      case tpk::OpenProblem::kCannotDerive:
+        return u"Thoron could not get the memory it needs to check the "
+               u"passphrase. Close other programs and try again.";
+      case tpk::OpenProblem::kNoLock:
+        return u"This copy has no recovery key. Type its passphrase.";
+      default:
+        return attempt.recovery
+                   ? u"That recovery key does not open this copy."
+                   : u"That passphrase does not open this copy.";
+    }
+  }
+  if (attempt.remember &&
+      tpk::RememberThisPc(unlock->file, *key, *unlock->store)) {
+    // Not remembered when it cannot be written; the copy opens all the same.
+    tpk::WriteKeyFile(unlock->folder, tpk::SerializeKeyFile(unlock->file, *key));
+  }
+  os_crypt_async::SetThoronProfileKey(key->span());
+  unlock->opened = true;
+  return std::u16string();
+}
+
+}  // namespace
+
+UnlockResult UnlockIfLocked(const base::FilePath& user_data_dir,
+                            PrefService* local_state) {
+  if (!tpk::HasKeyFile(user_data_dir)) {
+    if (local_state && local_state->GetBoolean(kLockedPref)) {
+      // The key file is gone: put back from a backup, or start without what
+      // it kept locked (then they cannot be opened, and new ones are kept
+      // the way an unlocked copy keeps them).
+      if (!AskToStartWithoutKeyFile()) {
+        g_quit = true;
+        return UnlockResult::kQuit;
+      }
+      local_state->SetBoolean(kLockedPref, false);
+    }
+    return UnlockResult::kNotLocked;
+  }
+  tpk::StoredKeyFile stored = tpk::ReadKeyFile(user_data_dir);
+  if (stored.problem == tpk::StoreProblem::kNoKeyFile) {
+    // only what an unfinished first setup left, now cleared away
+    return UnlockResult::kNotLocked;
+  }
+  os_crypt_async::SetThoronProfileLocked();
+  if (!stored.file) {
+    ShowStartupProblem(ReadProblemText(stored));
+    g_quit = true;
+    return UnlockResult::kQuit;
+  }
+  Unlock unlock;
+  unlock.folder = user_data_dir;
+  unlock.file = std::move(*stored.file);
+  unlock.store = tpk::CreateOsKeyStore();
+  tpk::OpenProblem problem = tpk::OpenProblem::kNoLock;
+  if (std::optional<tpk::SecretBytes> key =
+          tpk::OpenOnThisPc(unlock.file, *unlock.store, &problem)) {
+    os_crypt_async::SetThoronProfileKey(key->span());
+    return UnlockResult::kUnlocked;
+  }
+  if (problem == tpk::OpenProblem::kChanged) {
+    ShowStartupProblem(kChanged);
+    g_quit = true;
+    return UnlockResult::kQuit;
+  }
+  const bool can_remember = unlock.store->IsAvailable() &&
+                            !tpk::IsRememberedHere(unlock.file, *unlock.store);
+  if (!RunUnlockDialog(can_remember,
+                       base::BindRepeating(&Try, base::Unretained(&unlock))) ||
+      !unlock.opened) {
+    g_quit = true;
+    return UnlockResult::kQuit;
+  }
+  return UnlockResult::kUnlocked;
+}
+
+bool QuitBeforeStart() {
+  return g_quit;
+}
+
+}  // namespace thoron_portable
diff --git a/chrome/browser/thoron_portable/unlock_win.h b/chrome/browser/thoron_portable/unlock_win.h
