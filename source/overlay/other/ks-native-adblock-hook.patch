+void ProfileWriter::SetThoronStartup(const GURL& home_page,
+                                     bool home_page_is_new_tab_page,
+                                     int show_home_button,
+                                     int restore_on_startup,
+                                     const std::vector<GURL>& startup_pages) {
+  CHECK(profile_, base::NotFatalUntil::M161);
+  PrefService* prefs = profile_->GetPrefs();
+  auto free = [prefs](const char* name) {
+    const PrefService::Preference* pref = prefs->FindPreference(name);
+    return pref && pref->IsUserModifiable();
+  };
+  if (home_page.is_valid() && free(prefs::kHomePage) &&
+      free(prefs::kHomePageIsNewTabPage)) {
+    prefs->SetString(prefs::kHomePage, home_page.spec());
+    prefs->SetBoolean(prefs::kHomePageIsNewTabPage, home_page_is_new_tab_page);
+  }
+  if (show_home_button >= 0 && free(prefs::kShowHomeButton)) {
+    prefs->SetBoolean(prefs::kShowHomeButton, show_home_button == 1);
+  }
+  if (restore_on_startup >= 0 && free(prefs::kRestoreOnStartup) &&
+      (restore_on_startup != 4 ||
+       (!startup_pages.empty() && free(prefs::kURLsToRestoreOnStartup)))) {
+    if (restore_on_startup == 4) {
+      base::ListValue pages;
+      for (const GURL& page : startup_pages) {
+        pages.Append(page.spec());
