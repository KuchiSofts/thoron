+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/user_data_importer/chromium_family/password_decryptor_linux.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/strings/string_view_util.h"
+#include "base/task/sequenced_task_runner.h"
+#include "crypto/aes_cbc.h"
+#include "crypto/hmac.h"
+#include "dbus/bus.h"
+#include "dbus/message.h"
+#include "dbus/object_path.h"
+#include "dbus/object_proxy.h"
+
+namespace user_data_importer::chromium_family {
+
+namespace {
+
+// As components/os_crypt/async/browser/posix_key_provider.cc and
+// freedesktop_secret_key_provider.cc write them.
+constexpr char kV10Prefix[] = "v10";
+constexpr char kV11Prefix[] = "v11";
+constexpr char kSalt[] = "saltysalt";
+constexpr char kFixedPassword[] = "peanuts";
+constexpr size_t kPrefixSize = 3;
+constexpr std::array<uint8_t, 16> kIv = {' ', ' ', ' ', ' ', ' ', ' ', ' ', ' ',
+                                         ' ', ' ', ' ', ' ', ' ', ' ', ' ', ' '};
+
+// The Secret Service (org.freedesktop.Secret, GNOME's keyring and others).
+constexpr char kService[] = "org.freedesktop.secrets";
+constexpr char kServicePath[] = "/org/freedesktop/secrets";
+constexpr char kServiceInterface[] = "org.freedesktop.Secret.Service";
+constexpr char kItemInterface[] = "org.freedesktop.Secret.Item";
+constexpr char kSessionInterface[] = "org.freedesktop.Secret.Session";
+// KDE's KWallet (org.kde.KWallet): since KWallet 6.24 ksecretd keeps the
+// wallets behind kwalletd6; before, kwalletd6 (KWallet 6) or kwalletd5
+// (KWallet 5) kept them.
+constexpr std::array<std::pair<const char*, const char*>, 3> kKWallets = {{
+    {"org.kde.ksecretd", "/ksecretd"},
+    {"org.kde.kwalletd6", "/modules/kwalletd6"},
+    {"org.kde.kwalletd5", "/modules/kwalletd5"},
+}};
+constexpr char kKWalletInterface[] = "org.kde.KWallet";
+constexpr char kKWalletAppId[] = "Thoron";
+// A keyring that does not answer within this is taken as not there.
+constexpr int kTimeoutMs = 5000;
+// A secret longer than this is not a browser's key.
+constexpr size_t kMostSecretBytes = 4096;
+
+using Attributes = std::vector<std::pair<std::string, std::string>>;
+
+std::unique_ptr<dbus::Response> Call(dbus::ObjectProxy* proxy,
+                                     dbus::MethodCall* call) {
+  auto result = proxy->CallMethodAndBlock(call, kTimeoutMs);
+  if (!result.has_value()) {
+    return nullptr;
+  }
+  return std::move(result.value());
+}
+
+// The secret an unlocked item with `attributes` holds: read with the "plain"
+// algorithm of a session of the local bus, as Chromium does. Nothing is made,
+// changed or unlocked.
+std::optional<std::string> SecretOf(dbus::Bus* bus,
+                                    const dbus::ObjectPath& session,
+                                    const Attributes& attributes) {
+  dbus::ObjectProxy* service =
+      bus->GetObjectProxy(kService, dbus::ObjectPath(kServicePath));
+  dbus::MethodCall search(kServiceInterface, "SearchItems");
+  dbus::MessageWriter writer(&search);
+  dbus::MessageWriter array(nullptr);
+  writer.OpenArray("{ss}", &array);
+  for (const auto& [name, value] : attributes) {
+    dbus::MessageWriter entry(nullptr);
+    array.OpenDictEntry(&entry);
+    entry.AppendString(name);
+    entry.AppendString(value);
+    array.CloseContainer(&entry);
+  }
+  writer.CloseContainer(&array);
+  std::unique_ptr<dbus::Response> found = Call(service, &search);
+  if (!found) {
+    return std::nullopt;
+  }
+  dbus::MessageReader reader(found.get());
+  std::vector<dbus::ObjectPath> unlocked;
+  if (!reader.PopArrayOfObjectPaths(&unlocked) || unlocked.empty()) {
+    return std::nullopt;
+  }
+  dbus::ObjectProxy* item = bus->GetObjectProxy(kService, unlocked.front());
+  dbus::MethodCall get(kItemInterface, "GetSecret");
+  dbus::MessageWriter get_writer(&get);
+  get_writer.AppendObjectPath(session);
+  std::unique_ptr<dbus::Response> secret = Call(item, &get);
+  if (!secret) {
+    return std::nullopt;
+  }
+  // (o session, ay parameters, ay value, s content type)
+  dbus::MessageReader secret_reader(secret.get());
+  dbus::MessageReader fields(nullptr);
+  dbus::ObjectPath secret_session;
+  base::span<const uint8_t> parameters;
+  base::span<const uint8_t> value;
+  if (!secret_reader.PopStruct(&fields) ||
+      !fields.PopObjectPath(&secret_session) ||
+      !fields.PopArrayOfBytes(&parameters) || !fields.PopArrayOfBytes(&value) ||
+      value.empty() || value.size() > kMostSecretBytes) {
+    return std::nullopt;
+  }
+  return std::string(base::as_string_view(value));
+}
+
+// The secret of one of `entries` (folder, entry) in KDE's wallet, through
+// KWallet's own interface, as Chromium reads it, but only from a wallet that
+// is open already (as after the person signed in): a closed wallet is not
+// opened, so KWallet shows no password dialog, and a KWallet that does not run
+// is not started.
+std::optional<std::string> KWalletSecret(dbus::Bus* bus,
+                                         const Attributes& entries) {
+  if (entries.empty()) {
+    return std::nullopt;
+  }
+  for (const auto& [name, path] : kKWallets) {
+    if (bus->GetServiceOwnerAndBlock(name, dbus::Bus::SUPPRESS_ERRORS)
+            .empty()) {
+      continue;
+    }
+    dbus::ObjectProxy* kwallet =
+        bus->GetObjectProxy(name, dbus::ObjectPath(path));
+    dbus::MethodCall network(kKWalletInterface, "networkWallet");
+    std::unique_ptr<dbus::Response> named = Call(kwallet, &network);
+    std::string wallet;
+    if (!named || !dbus::MessageReader(named.get()).PopString(&wallet) ||
+        wallet.empty()) {
+      continue;
+    }
+    dbus::MethodCall is_open(kKWalletInterface, "isOpen");
+    dbus::MessageWriter(&is_open).AppendString(wallet);
+    std::unique_ptr<dbus::Response> open_reply = Call(kwallet, &is_open);
+    bool open = false;
+    if (!open_reply || !dbus::MessageReader(open_reply.get()).PopBool(&open) ||
+        !open) {
+      continue;
+    }
+    dbus::MethodCall open_call(kKWalletInterface, "open");
+    dbus::MessageWriter open_writer(&open_call);
+    open_writer.AppendString(wallet);
+    open_writer.AppendInt64(0);
+    open_writer.AppendString(kKWalletAppId);
+    std::unique_ptr<dbus::Response> opened = Call(kwallet, &open_call);
+    int32_t handle = -1;
+    if (!opened || !dbus::MessageReader(opened.get()).PopInt32(&handle) ||
+        handle < 0) {
+      continue;
+    }
+    std::optional<std::string> secret;
+    for (const auto& [folder, key] : entries) {
+      dbus::MethodCall read(kKWalletInterface, "readPassword");
+      dbus::MessageWriter read_writer(&read);
+      read_writer.AppendInt32(handle);
+      read_writer.AppendString(folder);
+      read_writer.AppendString(key);
+      read_writer.AppendString(kKWalletAppId);
+      std::unique_ptr<dbus::Response> value = Call(kwallet, &read);
+      std::string text;
+      if (value && dbus::MessageReader(value.get()).PopString(&text) &&
+          !text.empty() && text.size() <= kMostSecretBytes) {
+        secret = std::move(text);
+        break;
+      }
+    }
+    dbus::MethodCall close(kKWalletInterface, "close");
+    dbus::MessageWriter close_writer(&close);
+    close_writer.AppendInt32(handle);
+    close_writer.AppendBool(false);
+    close_writer.AppendString(kKWalletAppId);
+    Call(kwallet, &close);
+    if (secret) {
+      return secret;
+    }
+  }
+  return std::nullopt;
+}
+
+// The first secret found under one of `applications`, from the session bus's
+// Secret Service, then under KWallet's names for them (in the Secret Service,
+// which KWallet 6 serves too, and in an open KDE wallet); none when there is no
+// bus, no keyring, or no unlocked item.
+std::optional<std::string> KeyringSecret(
+    const std::vector<std::string>& applications) {
+  // The bus works on this thread's task runner, which the import's thread has
+  // (a thread without one, as in a test, reads no keyring).
+  if (!base::SequencedTaskRunner::HasCurrentDefault()) {
+    return std::nullopt;
+  }
+  dbus::Bus::Options options;
+  options.bus_type = dbus::Bus::SESSION;
+  options.connection_type = dbus::Bus::PRIVATE;
+  scoped_refptr<dbus::Bus> bus =
+      base::MakeRefCounted<dbus::Bus>(std::move(options));
+  std::optional<std::string> secret;
+  const Attributes kwallet_entries =
+      PasswordKey::KWalletEntriesFor(applications);
+  if (bus->Connect()) {
+    dbus::ObjectProxy* service =
+        bus->GetObjectProxy(kService, dbus::ObjectPath(kServicePath));
+    dbus::MethodCall open(kServiceInterface, "OpenSession");
+    dbus::MessageWriter writer(&open);
+    writer.AppendString("plain");
+    writer.AppendVariantOfString(std::string());
+    std::unique_ptr<dbus::Response> opened = Call(service, &open);
+    dbus::ObjectPath session;
+    if (opened) {
+      dbus::MessageReader reader(opened.get());
+      dbus::MessageReader output(nullptr);
+      if (reader.PopVariant(&output) && reader.PopObjectPath(&session) &&
+          session.IsValid()) {
+        for (const std::string& application : applications) {
+          secret = SecretOf(bus.get(), session, {{"application", application}});
+          if (secret) {
+            break;
+          }
+        }
+        // KWallet's entries, as KWallet 6 shows them in the Secret Service.
+        for (const auto& [folder, key] : kwallet_entries) {
+          if (secret) {
+            break;
+          }
+          secret =
+              SecretOf(bus.get(), session, {{"server", folder}, {"user", key}});
+        }
+        dbus::MethodCall close(kSessionInterface, "Close");
+        Call(bus->GetObjectProxy(kService, session), &close);
+      }
+    }
+    if (!secret) {
+      secret = KWalletSecret(bus.get(), kwallet_entries);
+    }
+  }
+  bus->ShutdownAndBlock();
+  return secret;
+}
+
+}  // namespace
+
+PasswordKey::PasswordKey() = default;
+PasswordKey::PasswordKey(PasswordKey&&) noexcept = default;
+PasswordKey& PasswordKey::operator=(PasswordKey&&) noexcept = default;
+PasswordKey::~PasswordKey() {
+  Clear();
+}
+
+// static
+std::array<uint8_t, 16> PasswordKey::DeriveKey(std::string_view password) {
+  // PBKDF2 with one iteration and a key no longer than SHA-1's output is the
+  // first block: HMAC-SHA1(password, salt || 00 00 00 01) (RFC 8018 5.2).
+  std::vector<uint8_t> salt_and_block(std::begin(kSalt), std::end(kSalt) - 1);
+  salt_and_block.insert(salt_and_block.end(), {0, 0, 0, 1});
+  const auto block =
+      crypto::hmac::SignSha1(base::as_byte_span(password), salt_and_block);
+  std::array<uint8_t, 16> key;
+  base::span(key).copy_from(base::span(block).first<16u>());
+  return key;
+}
+
+// static
+std::vector<std::string> PasswordKey::ApplicationNamesFor(
+    const base::FilePath& user_data) {
+  const std::string folder = user_data.BaseName().value();
+  // Chromium names its entry "chrome" in Google's builds and "chromium" in all
+  // others (freedesktop_secret_key_provider.h, kAppName); a browser that
+  // changes it uses its own name.
+  std::vector<std::string> names;
+  if (folder == "google-chrome") {
+    names = {"chrome"};
+  } else if (folder == "Brave-Browser") {
+    names = {"brave"};
+  } else if (folder == "microsoft-edge") {
+    names = {"microsoft-edge"};
+  } else if (folder == "vivaldi") {
+    names = {"vivaldi"};
+  } else if (folder == "opera") {
+    names = {"opera"};
+  }
+  names.push_back("chromium");
+  if (folder != "google-chrome") {
+    names.push_back("chrome");
+  }
+  return names;
+}
+
+// static
+std::vector<std::pair<std::string, std::string>> PasswordKey::KWalletEntriesFor(
+    const std::vector<std::string>& applications) {
+  std::vector<std::pair<std::string, std::string>> entries;
+  for (const std::string& application : applications) {
+    if (application == "chromium") {
+      entries.emplace_back("Chromium Keys", "Chromium Safe Storage");
+    } else if (application == "chrome") {
+      entries.emplace_back("Chrome Keys", "Chrome Safe Storage");
+    }
+  }
+  return entries;
+}
+
+// static
+PasswordKey PasswordKey::ForUserData(const base::FilePath& user_data) {
+  return FromSecretForTesting(KeyringSecret(ApplicationNamesFor(user_data)));
+}
+
+// static
+PasswordKey PasswordKey::FromSecretForTesting(
+    std::optional<std::string> secret) {
+  PasswordKey key;
+  key.v10_ = DeriveKey(kFixedPassword);
+  if (secret) {
+    key.v11_ = DeriveKey(*secret);
+    key.has_v11_ = true;
+    std::fill(secret->begin(), secret->end(), '\0');
+  }
+  return key;
+}
+
+void PasswordKey::Clear() {
+  v10_.fill(0);
+  v11_.fill(0);
+  has_v11_ = false;
+}
+
+DecryptResult DecryptPasswordValue(const PasswordKey& key,
+                                   base::span<const uint8_t> value,
+                                   std::string* plaintext) {
+  if (value.size() <= kPrefixSize) {
+    return DecryptResult::kSkippedOther;
+  }
+  const std::string_view prefix = base::as_string_view(value.first(kPrefixSize));
+  base::span<const uint8_t, 16> aes_key = key.fixed_key();
+  if (prefix == kV11Prefix) {
+    if (!key.has_keyring_key()) {
+      return DecryptResult::kSkippedOther;
+    }
+    aes_key = key.keyring_key();
+  } else if (prefix != kV10Prefix) {
+    return DecryptResult::kSkippedOther;
+  }
+  const base::span<const uint8_t> ciphertext = value.subspan(kPrefixSize);
+  if (ciphertext.size() % 16 != 0) {
+    return DecryptResult::kError;
+  }
+  // Chromium's own values: there is no tag to check before the padding, as in
+  // Chromium's reading of them.
+  std::optional<std::vector<uint8_t>> clear =
+      crypto::aes_cbc::Decrypt(aes_key, kIv, ciphertext);
+  if (!clear) {
+    return DecryptResult::kError;
+  }
+  plaintext->assign(clear->begin(), clear->end());
+  std::fill(clear->begin(), clear->end(), 0);
+  return DecryptResult::kOk;
+}
+
+}  // namespace user_data_importer::chromium_family
