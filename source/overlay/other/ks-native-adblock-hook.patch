@@ -0,0 +1,376 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/user_data_importer/chromium_family/open_tabs.h"
+
+#include <limits>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/numerics/byte_conversions.h"
+#include "base/pickle.h"
+#include "components/sessions/core/serialized_navigation_entry.h"
+#include "components/sessions/core/serialized_user_agent_override.h"
+#include "components/sessions/core/session_command.h"
+#include "components/sessions/core/session_id.h"
+#include "components/sessions/core/session_service_commands.h"
+#include "components/sessions/core/session_types.h"
+#include "components/tab_groups/tab_group_color.h"
+#include "components/tab_groups/tab_group_id.h"
+#include "components/tab_groups/tab_group_visual_data.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/base/mojom/window_show_state.mojom.h"
+#include "ui/base/resource/resource_bundle.h"
+#include "ui/gfx/geometry/rect.h"
+#include "url/gurl.h"
+
+namespace user_data_importer::chromium_family {
+namespace {
+
+using sessions::SessionCommand;
+using sessions::SessionWindow;
+
+// A session file as Chromium writes one: the header, the commands, the marker
+// of a complete state.
+class SessionFile {
+ public:
+  explicit SessionFile(uint32_t version = 3) {
+    Append(base::U32ToLittleEndian(0x53534E53));
+    Append(base::U32ToLittleEndian(version));
+  }
+
+  void Add(std::unique_ptr<SessionCommand> command) {
+    Append(base::U16ToLittleEndian(
+        static_cast<uint16_t>(command->contents().size() + 1)));
+    bytes_.push_back(command->id());
+    Append(command->contents());
+  }
+  void Marker() {
+    Append(base::U16ToLittleEndian(1));
+    bytes_.push_back(255);
+  }
+  const std::vector<uint8_t>& bytes() const { return bytes_; }
+
+ private:
+  void Append(base::span<const uint8_t> more) {
+    bytes_.insert(bytes_.end(), more.begin(), more.end());
+  }
+  std::vector<uint8_t> bytes_;
+};
+
+sessions::SerializedNavigationEntry Page(int index, const std::string& url) {
+  sessions::SerializedNavigationEntry entry;
+  entry.set_index(index);
+  entry.set_virtual_url(GURL(url));
+  entry.set_original_request_url(GURL(url));
+  entry.set_title(u"a page");
+  entry.set_encoded_page_state("the other browser's page state");
+  return entry;
+}
+
+// One tab in `window` with the pages `urls`, the current one `current`.
+void AddTab(SessionFile& file,
+            SessionID window,
+            SessionID tab,
+            int position,
+            const std::vector<std::string>& urls,
+            int current) {
+  file.Add(sessions::CreateSetTabWindowCommand(window, tab));
+  file.Add(sessions::CreateSetTabIndexInWindowCommand(tab, position));
+  for (size_t i = 0; i < urls.size(); ++i) {
+    file.Add(sessions::CreateUpdateTabNavigationCommand(
+        tab, Page(static_cast<int>(i), urls[i])));
+  }
+  file.Add(sessions::CreateSetSelectedNavigationIndexCommand(tab, current));
+}
+
+std::vector<std::string> Urls(const sessions::SessionTab& tab) {
+  std::vector<std::string> urls;
+  for (const auto& entry : tab.navigations) {
+    urls.push_back(entry.virtual_url().spec());
+  }
+  return urls;
+}
+
+// Two windows: the first with a group of two tabs, a pinned tab and a tab of
+// browser pages only; the second an app window.
+SessionFile TwoWindows(tab_groups::TabGroupId group) {
+  SessionFile file;
+  const SessionID window = SessionID::FromSerializedValue(1);
+  const SessionID app = SessionID::FromSerializedValue(2);
+  file.Add(sessions::CreateSetWindowTypeCommand(window,
+                                                SessionWindow::TYPE_NORMAL));
+  file.Add(sessions::CreateSetWindowBoundsCommand(
+      window, gfx::Rect(10, 20, 800, 600),
+      ui::mojom::WindowShowState::kMinimized));
+  file.Add(sessions::CreateSetWindowWorkspaceCommand(window, "a desktop"));
+  file.Add(sessions::CreateAddWindowExtraDataCommand(window, "k", "v"));
+  const SessionID t1 = SessionID::FromSerializedValue(11);
+  const SessionID t2 = SessionID::FromSerializedValue(12);
+  const SessionID t3 = SessionID::FromSerializedValue(13);
+  const SessionID t4 = SessionID::FromSerializedValue(14);
+  AddTab(file, window, t1, 0, {"https://example.org/pinned"}, 0);
+  file.Add(sessions::CreatePinnedStateCommand(t1, true));
+  AddTab(file, window, t2, 1,
+         {"https://example.org/a", "chrome://settings/", "javascript:alert(1)",
+          "https://example.org/b"},
+         2);
+  file.Add(sessions::CreateTabGroupCommand(t2, group));
+  file.Add(sessions::CreateSetTabExtensionAppIDCommand(t2, "an-app"));
+  file.Add(sessions::CreateSessionStorageAssociatedCommand(t2, "storage-id"));
+  file.Add(sessions::CreateSetTabUserAgentOverrideCommand(
+      t2, sessions::SerializedUserAgentOverride::UserAgentOnly("an agent")));
+  file.Add(sessions::CreateAddTabExtraDataCommand(t2, "k", "v"));
+  AddTab(file, window, t3, 2, {"vivaldi://startpage/", "about:blank"}, 0);
+  AddTab(file, window, t4, 3, {"file:///C:/notes.html"}, 0);
+  file.Add(sessions::CreateTabGroupCommand(t4, group));
+  const tab_groups::TabGroupVisualData visuals(
+      u"Work", tab_groups::TabGroupColorId::kBlue, /*is_collapsed=*/true);
+  file.Add(sessions::CreateTabGroupMetadataUpdateCommand(
+      group, &visuals, std::string("a-saved-group-of-the-other-browser")));
+  file.Add(sessions::CreateSetSelectedTabInWindowCommand(window, 3));
+
+  file.Add(sessions::CreateSetWindowTypeCommand(app, SessionWindow::TYPE_APP));
+  file.Add(sessions::CreateSetWindowAppNameCommand(app, "an app"));
+  AddTab(file, app, SessionID::FromSerializedValue(21), 0,
+         {"https://example.org/app"}, 0);
+  file.Add(sessions::CreateSetActiveWindowCommand(window));
+  file.Marker();
+  return file;
+}
+
+// Chromium's tab groups name their colours from the resource bundle, which a
+// browser or utility process loads; here an empty one stands in.
+class ThoronOpenTabsTest : public testing::Test {
+ private:
+  ui::ResourceBundle bundle_{nullptr};
+  ui::ResourceBundle::SharedInstanceSwapperForTesting swap_{&bundle_};
+};
+
+TEST_F(ThoronOpenTabsTest, WindowsTabsAndGroupsComeBackWithWebPagesOnly) {
+  const tab_groups::TabGroupId group = tab_groups::TabGroupId::GenerateNew();
+  OpenTabsCounts counts;
+  std::vector<std::unique_ptr<SessionWindow>> windows =
+      ReadOpenTabs(TwoWindows(group).bytes(), &counts);
+  ASSERT_EQ(windows.size(), 1u);  // the app window is left out
+  EXPECT_EQ(counts.windows, 1);
+  EXPECT_EQ(counts.tabs, 3);  // the tab of browser pages only is left out
+  EXPECT_EQ(counts.groups, 1);
+
+  const SessionWindow& window = *windows[0];
+  EXPECT_EQ(window.type, SessionWindow::TYPE_NORMAL);
+  EXPECT_EQ(window.bounds.ToString(), gfx::Rect(10, 20, 800, 600).ToString());
+  EXPECT_EQ(window.show_state, ui::mojom::WindowShowState::kNormal);
+  EXPECT_TRUE(window.workspace.empty());
+  EXPECT_TRUE(window.extra_data.empty());
+  ASSERT_EQ(window.tabs.size(), 3u);
+  // The selected tab (the file page, 4th in the source) is still selected.
+  EXPECT_EQ(window.selected_tab_index, 2);
+
+  const sessions::SessionTab& pinned = *window.tabs[0];
+  EXPECT_TRUE(pinned.pinned);
+  EXPECT_EQ(Urls(pinned),
+            std::vector<std::string>{"https://example.org/pinned"});
+
+  const sessions::SessionTab& grouped = *window.tabs[1];
+  EXPECT_EQ(Urls(grouped), (std::vector<std::string>{"https://example.org/a",
+                                                     "https://example.org/b"}));
+  // The current page was the script, left out: the page kept before it.
+  EXPECT_EQ(grouped.current_navigation_index, 0);
+  EXPECT_EQ(grouped.navigations[1].index(), 1);
+  for (const auto& entry : grouped.navigations) {
+    EXPECT_TRUE(entry.encoded_page_state().empty());
+  }
+  EXPECT_TRUE(grouped.extension_app_id.empty());
+  EXPECT_TRUE(grouped.session_storage_persistent_id.empty());
+  EXPECT_TRUE(grouped.user_agent_override.ua_string_override.empty());
+  EXPECT_TRUE(grouped.extra_data.empty());
+  ASSERT_TRUE(grouped.group.has_value());
+  EXPECT_EQ(*grouped.group, group);
+  EXPECT_EQ(window.tabs[1]->tab_visual_index, 1);
+
+  EXPECT_EQ(Urls(*window.tabs[2]),
+            std::vector<std::string>{"file:///C:/notes.html"});
+  EXPECT_EQ(window.tabs[2]->tab_visual_index, 2);
+
+  ASSERT_EQ(window.tab_groups.size(), 1u);
+  EXPECT_EQ(window.tab_groups[0]->id, group);
+  EXPECT_EQ(window.tab_groups[0]->visual_data.title(), u"Work");
+  EXPECT_EQ(window.tab_groups[0]->visual_data.color(),
+            tab_groups::TabGroupColorId::kBlue);
+  EXPECT_TRUE(window.tab_groups[0]->visual_data.is_collapsed());
+  EXPECT_FALSE(window.tab_groups[0]->saved_guid.has_value());
+}
+
+TEST_F(ThoronOpenTabsTest, AFileNotCompleteOrNotThisFormatGivesNothing) {
+  const tab_groups::TabGroupId group = tab_groups::TabGroupId::GenerateNew();
+  std::vector<uint8_t> whole = TwoWindows(group).bytes();
+  ASSERT_FALSE(ReadOpenTabs(whole, nullptr).empty());
+
+  // Without the marker: the browser was still writing it.
+  std::vector<uint8_t> unmarked(whole.begin(), whole.end() - 3);
+  OpenTabsCounts counts;
+  EXPECT_TRUE(ReadOpenTabs(unmarked, &counts).empty());
+  EXPECT_EQ(counts.tabs, 0);
+  EXPECT_FALSE(ReadSessionCommands(unmarked).has_value());
+
+  // Another signature, an older or an encrypted version, too short.
+  std::vector<uint8_t> other = whole;
+  other[0] = 'X';
+  EXPECT_FALSE(ReadSessionCommands(other).has_value());
+  for (uint8_t version : {1, 2, 4, 5}) {
+    std::vector<uint8_t> versioned = whole;
+    versioned[4] = version;
+    EXPECT_FALSE(ReadSessionCommands(versioned).has_value()) << int{version};
+  }
+  EXPECT_FALSE(ReadSessionCommands(std::vector<uint8_t>(7, 0)).has_value());
+  EXPECT_TRUE(ReadOpenTabs({}, nullptr).empty());
+}
+
+TEST_F(ThoronOpenTabsTest, ACommandCutShortEndsTheReadingAsInChromium) {
+  SessionFile file;
+  const SessionID window = SessionID::FromSerializedValue(1);
+  file.Add(sessions::CreateSetWindowTypeCommand(window,
+                                                SessionWindow::TYPE_NORMAL));
+  AddTab(file, window, SessionID::FromSerializedValue(2), 0,
+         {"https://example.org/"}, 0);
+  file.Marker();
+  std::vector<uint8_t> bytes = file.bytes();
+  // A command that says it is longer than what is left of the file.
+  bytes.push_back(0xff);
+  bytes.push_back(0x7f);
+  bytes.push_back(6);
+  OpenTabsCounts counts;
+  EXPECT_EQ(ReadOpenTabs(bytes, &counts).size(), 1u);
+  EXPECT_EQ(counts.tabs, 1);
+}
+
+// Edge, Vivaldi and Opera write commands of their own, and a command can be
+// damaged; Chromium's replay would stop at either and lose the rest.
+TEST_F(ThoronOpenTabsTest, ANotherBrowsersOwnOrADamagedCommandIsLeftOut) {
+  SessionFile file;
+  const SessionID window = SessionID::FromSerializedValue(1);
+  file.Add(sessions::CreateSetWindowTypeCommand(window,
+                                                SessionWindow::TYPE_NORMAL));
+  // another browser's own command (Edge writes 131), with some contents
+  auto vendor = std::make_unique<SessionCommand>(131, 4);
+  vendor->contents().copy_from(base::span<const uint8_t>({1, 2, 3, 4}));
+  file.Add(std::move(vendor));
+  AddTab(file, window, SessionID::FromSerializedValue(2), 0,
+         {"https://example.org/one"}, 0);
+  // a known command that cannot be read: a navigation of three bytes
+  auto damaged = std::make_unique<SessionCommand>(6, 3);
+  damaged->contents().copy_from(base::span<const uint8_t>({9, 9, 9}));
+  file.Add(std::move(damaged));
+  AddTab(file, window, SessionID::FromSerializedValue(3), 1,
+         {"https://example.org/two"}, 0);
+  file.Marker();
+  OpenTabsCounts counts;
+  std::vector<std::unique_ptr<SessionWindow>> windows =
+      ReadOpenTabs(file.bytes(), &counts);
+  ASSERT_EQ(windows.size(), 1u);
+  ASSERT_EQ(counts.tabs, 2);
+  EXPECT_EQ(Urls(*windows[0]->tabs[1]),
+            std::vector<std::string>{"https://example.org/two"});
+}
+
+// A navigation whose count of extended info entries is damaged (here the
+// largest int) is read at once: Chromium's reader went on looping after its
+// reads had failed (found by fuzzing the session reader).
+TEST_F(ThoronOpenTabsTest, ADamagedCountInANavigationIsReadAtOnce) {
+  base::Pickle pickle;
+  pickle.WriteInt(0);                               // index
+  pickle.WriteString("https://example.org/");       // virtual URL
+  pickle.WriteString16(u"Example");                 // title
+  pickle.WriteString(std::string());                // page state
+  pickle.WriteInt(0);                               // transition
+  pickle.WriteInt(0);                               // type mask
+  pickle.WriteString(std::string());                // referrer
+  pickle.WriteInt(0);                               // old referrer policy
+  pickle.WriteString(std::string());                // original request URL
+  pickle.WriteBool(false);                          // overriding user agent
+  pickle.WriteInt64(0);                             // time
+  pickle.WriteString16(std::u16string());           // search terms
+  pickle.WriteInt(200);                             // HTTP status
+  pickle.WriteInt(0);                               // referrer policy
+  pickle.WriteInt(std::numeric_limits<int>::max()); // extended info entries
+  base::PickleIterator iterator(pickle);
+  sessions::SerializedNavigationEntry entry;
+  ASSERT_TRUE(entry.ReadFromPickle(&iterator));
+  EXPECT_EQ(entry.virtual_url(), GURL("https://example.org/"));
+  EXPECT_TRUE(entry.extended_info_map().empty());
+}
+
+// A show state Chromium never writes is read as normal, without the fault the
+// replay would report (found by fuzzing the session reader).
+TEST_F(ThoronOpenTabsTest, AnUnknownShowStateOpensANormalWindow) {
+  SessionFile file;
+  const SessionID window = SessionID::FromSerializedValue(1);
+  file.Add(sessions::CreateSetWindowTypeCommand(window,
+                                                SessionWindow::TYPE_NORMAL));
+  std::unique_ptr<SessionCommand> bounds =
+      sessions::CreateSetWindowBoundsCommand(
+          window, gfx::Rect(10, 20, 800, 600),
+          ui::mojom::WindowShowState::kMaximized);
+  bounds->contents().last<4u>().copy_from(base::I32ToNativeEndian(9));
+  file.Add(std::move(bounds));
+  AddTab(file, window, SessionID::FromSerializedValue(2), 0,
+         {"https://example.org/one"}, 0);
+  file.Marker();
+  OpenTabsCounts counts;
+  std::vector<std::unique_ptr<SessionWindow>> windows =
+      ReadOpenTabs(file.bytes(), &counts);
+  ASSERT_EQ(windows.size(), 1u);
+  EXPECT_EQ(windows[0]->show_state, ui::mojom::WindowShowState::kNormal);
+  EXPECT_EQ(windows[0]->bounds.ToString(),
+            gfx::Rect(10, 20, 800, 600).ToString());
+}
+
+TEST_F(ThoronOpenTabsTest, ALongHistoryKeepsTheEntriesAroundTheCurrentOne) {
+  SessionFile file;
+  const SessionID window = SessionID::FromSerializedValue(1);
+  file.Add(sessions::CreateSetWindowTypeCommand(window,
+                                                SessionWindow::TYPE_NORMAL));
+  std::vector<std::string> urls;
+  for (int i = 0; i < 120; ++i) {
+    urls.push_back("https://example.org/" + std::to_string(i));
+  }
+  AddTab(file, window, SessionID::FromSerializedValue(2), 0, urls, 100);
+  file.Marker();
+  std::vector<std::unique_ptr<SessionWindow>> windows =
+      ReadOpenTabs(file.bytes(), nullptr);
+  ASSERT_EQ(windows.size(), 1u);
+  const sessions::SessionTab& tab = *windows[0]->tabs[0];
+  ASSERT_EQ(tab.navigations.size(), kMostNavigationsPerTab);
+  EXPECT_EQ(
+      tab.navigations[tab.current_navigation_index].virtual_url().spec(),
+      "https://example.org/100");
+  EXPECT_EQ(tab.navigations.front().virtual_url().spec(),
+            "https://example.org/70");
+  EXPECT_EQ(tab.navigations.back().index(),
+            static_cast<int>(kMostNavigationsPerTab) - 1);
+}
+
+TEST_F(ThoronOpenTabsTest, AtMostTheLimitOfTabsOpen) {
+  SessionFile file;
+  for (int w = 0; w < 3; ++w) {
+    const SessionID window = SessionID::FromSerializedValue(100000 + w);
+    file.Add(sessions::CreateSetWindowTypeCommand(window,
+                                                  SessionWindow::TYPE_NORMAL));
+    for (int t = 0; t < 200; ++t) {
+      AddTab(file, window, SessionID::FromSerializedValue(w * 1000 + t + 1), t,
+             {"https://example.org/" + std::to_string(t)}, 0);
+    }
+  }
+  file.Marker();
+  OpenTabsCounts counts;
+  std::vector<std::unique_ptr<SessionWindow>> windows =
+      ReadOpenTabs(file.bytes(), &counts);
+  EXPECT_EQ(counts.tabs, static_cast<int>(kMostOpenTabs));
+  EXPECT_EQ(counts.windows, 3);
+  EXPECT_EQ(windows[2]->tabs.size(), kMostOpenTabs - 400);
+}
+
+}  // namespace
+}  // namespace user_data_importer::chromium_family
