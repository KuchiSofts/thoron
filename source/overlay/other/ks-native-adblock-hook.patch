+// Digits and letters are the ASCII ones everywhere.
+bool IsDigit(char c) {
+  return c >= '0' && c <= '9';
+}
+
+bool IsLower(char c) {
+  return c >= 'a' && c <= 'z';
+}
+
+bool IsUpper(char c) {
+  return c >= 'A' && c <= 'Z';
+}
+
+bool IsHostChar(char c) {
+  return IsLower(c) || IsDigit(c) || c == '.' || c == '-';
+}
+
+bool IsPathChar(char c) {
+  return IsLower(c) || IsUpper(c) || IsDigit(c) || c == '.' || c == '_' ||
+         c == '~' || c == '+' || c == '-';
+}
+
+// Printable ASCII that a JSON string holds without an escape.
+bool IsPlainChar(char c) {
+  return c >= 0x20 && c <= 0x7e && c != '"' && c != '\\';
+}
+
+// `count` numbers (at most four) joined by '.', each "0" or digits without a
+// leading zero, at most `max_digits` long and `max_value` in value.
+bool ReadNumbers(std::string_view text,
+                 size_t count,
+                 size_t max_digits,
+                 uint32_t max_value,
+                 std::array<uint16_t, 4>& out) {
+  for (size_t part = 0; part < count; ++part) {
+    if (part > 0) {
+      if (!text.starts_with('.')) {
+        return false;
+      }
+      text.remove_prefix(1);
+    }
+    size_t digits = 0;
+    uint32_t value = 0;
+    while (digits < text.size() && digits < max_digits &&
+           IsDigit(text[digits])) {
+      value = value * 10 + static_cast<uint32_t>(text[digits] - '0');
+      ++digits;
+    }
+    if (digits == 0 || (digits > 1 && text.front() == '0') ||
+        value > max_value) {
+      return false;
+    }
+    out[part] = static_cast<uint16_t>(value);
+    text.remove_prefix(digits);
+  }
+  return text.empty();
+}
+
+// Thoron's own version: three numbers of 0 to 9999.
+bool IsThoronVersion(std::string_view text) {
+  std::array<uint16_t, 4> parts = {};
+  return ReadNumbers(text, 3, 4, 9999, parts);
+}
+
+// A lower-case letter, then up to 31 lower-case letters, digits or '-'.
+bool IsChannel(std::string_view text) {
+  return !text.empty() && text.size() <= kMaxChannelChars &&
+         IsLower(text.front()) && std::ranges::all_of(text, [](char c) {
+           return IsLower(c) || IsDigit(c) || c == '-';
+         });
+}
+
+// A host as the allow-list names it: two or more labels joined by '.', each 1
+// to 63 lower-case letters, digits or '-', with no '-' at either end.
+bool IsHostName(std::string_view text) {
+  size_t labels = 0;
+  while (true) {
+    const size_t dot = text.find('.');
+    const std::string_view label = text.substr(0, dot);
+    if (label.empty() || label.size() > kMaxHostLabelChars ||
+        label.front() == '-' || label.back() == '-' ||
+        !std::ranges::all_of(label, [](char c) {
+          return IsLower(c) || IsDigit(c) || c == '-';
+        })) {
+      return false;
+    }
+    ++labels;
+    if (dot == std::string_view::npos) {
+      return labels >= 2;
+    }
+    text.remove_prefix(dot + 1);
+  }
+}
+
+bool IsSha256(std::string_view text) {
+  return text.size() == kSha256Chars && std::ranges::all_of(text, [](char c) {
+           return IsDigit(c) || (c >= 'a' && c <= 'f');
+         });
