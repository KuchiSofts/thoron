+  Serve(base::BindLambdaForTesting([&](const std::string& range) {
+    if (range.empty()) {
+      Answer(200, whole.substr(0, 1000));  // the connection ended early
+    } else {
+      Answer(206, whole.substr(1000), "bytes 1000-2047/2048");
+    }
+  }));
+  EXPECT_EQ(Look(*Client(), /*install=*/true).state, State::kReadyToRelaunch);
+  EXPECT_EQ(ranges_, (std::vector<std::string>{"", "bytes=1000-"}));
+  ASSERT_EQ(installed_.size(), 1u);
+  EXPECT_EQ(installed_[0], whole);
+  EXPECT_TRUE(DownloadFolderIsEmpty());
+}
