+#ifndef CHROME_BROWSER_UI_VIEWS_TOOLBAR_THORON_WINDOWS_SECURITY_H_
+#define CHROME_BROWSER_UI_VIEWS_TOOLBAR_THORON_WINDOWS_SECURITY_H_
+
+namespace thoron {
+
+// Windows asks "is it you?" in a window of its own (Windows Security: Windows
+// Hello or the PIN, for showing and filling saved passwords, for passkeys and
+// security keys, and for a password manager's own check), and it may open
+// that window behind the browser. From the first call on, every such window
+// that opens while the browser is in front, or behind one of its windows, is
+// brought to the front at once. Windows only; elsewhere it does nothing.
+void WatchWindowsSecurityPrompts();
+
+}  // namespace thoron
