+// static
+UpdateClient::State UpdateClient::StateFor(const Decision& decision) {
+  switch (decision.outcome) {
+    case Outcome::kUpdate:
+      return decision.full ? State::kAvailable : State::kError;
+    case Outcome::kUpToDate:
+      return State::kUpToDate;
+    case Outcome::kNoPackage:
+      return State::kNoPackage;
+    case Outcome::kUpdaterTooOld:
+      // P4.6: with the package, the updater inside it applies the release.
+      return decision.full ? State::kAvailable : State::kNeedsInstaller;
+    case Outcome::kInvalidCopy:
+      return State::kError;
+    default:
+      return CannotVerify(decision.outcome) ? State::kCannotVerify : State::kError;
+  }
+}
+
+// static
+UpdateClient::Page UpdateClient::ForAboutPage(const Status& status) {
+  const std::string newest = status.thoron_version.empty()
+                                 ? status.version
+                                 : status.thoron_version + " (" + status.version + ")";
+  Page page;
+  switch (status.state) {
+    case State::kIdle:
+    case State::kChecking:
+      page.kind = PageKind::kChecking;
+      break;
+    case State::kDownloading:
+      page.kind = PageKind::kUpdating;
+      page.progress = status.progress;
+      break;
+    case State::kInstalling:
+      page.kind = PageKind::kUpdating;
+      page.progress = 100;
+      break;
+    case State::kReadyToRelaunch:
+      page.kind = PageKind::kRelaunch;
+      break;
+    case State::kUpToDate:
+      page.kind = PageKind::kUpToDate;
+      break;
+    case State::kAvailable:
+      page.kind = PageKind::kFailed;
+      // Why it is not installed now, when there is a reason; else a portable
+      // copy's own words.
+      page.message = "Thoron " + newest +
+                     (status.detail.empty()
+                          ? " is out. This copy updates by hand: close Thoron and replace everything "
+                            "in its folder except User Data with the new package."
+                          : " is out: " + status.detail + ".");
+      break;
+    case State::kNoPackage:
+      page.kind = PageKind::kFailed;
+      page.message = "Thoron " + newest + " is out, but not yet for this kind of computer.";
+      break;
+    case State::kNeedsInstaller:
+      page.kind = PageKind::kFailed;
+      page.message = "Thoron " + newest +
+                     " needs its own installer: download it from Thoron's releases page on GitHub.";
+      break;
+    case State::kCannotVerify:
+      page.kind = PageKind::kFailed;
+      page.message = "Thoron cannot verify updates (" + status.detail +
+                     "), so it installs nothing. If this computer's date and time are wrong, set "
+                     "them and try again.";
+      break;
+    case State::kError:
+      page.kind = PageKind::kFailedDownload;
+      page.message = "Thoron could not update: " + status.detail + ".";
+      break;
+    case State::kDisabled:
+      page.kind = PageKind::kDisabled;
+      page.message = "This build of Thoron does not update itself.";
+      break;
+  }
+  return page;
+}
+
+void UpdateClient::Check(bool install, StatusCallback callback, bool asked) {
+  asked_ = asked_ || asked;
+  callbacks_.push_back(std::move(callback));
+  // Without an installer (a portable copy, for now) a look only says what is there.
+  install_wanted_ = install_wanted_ || (install && !config_.install.is_null());
+  if (status_.state == State::kReadyToRelaunch) {
+    Finish(status_);
+    return;
+  }
+  if (running_) {
+    callbacks_.back().Run(status_);
+    return;
+  }
+  if (IsNoKey(config_.public_key) || !config_.manifest_url.SchemeIs(url::kHttpsScheme)) {
+    Fail(State::kDisabled, "this build has no key to check updates with");
+    return;
+  }
+  running_ = true;
+  decision_.reset();
+  manifest_.clear();
+  signature_.clear();
+  fetched_statements_.clear();
+  Status checking;
+  checking.state = State::kChecking;
+  Report(checking);
+  Fetch(config_.manifest_url, kMaxManifestBytes + 1,
+        base::BindOnce(&UpdateClient::OnManifest, weak_factory_.GetWeakPtr()));
+}
+
+void UpdateClient::Report(Status status) {
+  status_ = std::move(status);
+  // A callback may call Check() again; it then sees the state it was given.
+  const std::vector<StatusCallback> callbacks = callbacks_;
+  for (const StatusCallback& callback : callbacks) {
+    callback.Run(status_);
+  }
+}
+
+void UpdateClient::Finish(Status status) {
+  running_ = false;
+  install_wanted_ = false;
+  asked_ = false;
+  loader_.reset();
+  Report(std::move(status));
+  callbacks_.clear();
+}
+
+void UpdateClient::Fail(State state, std::string detail) {
+  Status failed;
+  failed.state = state;
+  failed.detail = std::move(detail);
+  if (decision_ && decision_->manifest) {
+    failed.version = ToString(decision_->manifest->version);
+    failed.thoron_version = decision_->manifest->thoron_version;
+  }
+  if (decision_) {
+    failed.outcome = decision_->outcome;
+  }
+  Finish(std::move(failed));
+}
+
+namespace {
+
+// Every request of the updater (THREAT_MODEL U12): no cookie, no cache, no
+// referrer, and a User-Agent that does not name the browser's version.
+std::unique_ptr<network::ResourceRequest> UpdateRequest(const GURL& url) {
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = url;
+  request->method = "GET";
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->load_flags = net::LOAD_DISABLE_CACHE;
+  request->referrer_policy = net::ReferrerPolicy::NO_REFERRER;
+  request->headers.SetHeader(net::HttpRequestHeaders::kUserAgent,
+                             UpdateClient::kUserAgent);
+  return request;
+}
+
+}  // namespace
+
+void UpdateClient::Fetch(const GURL& url,
+                         size_t most_bytes,
+                         base::OnceCallback<void(std::optional<std::string>)> done) {
+  std::unique_ptr<network::ResourceRequest> request = UpdateRequest(url);
+  loader_ = network::SimpleURLLoader::Create(std::move(request), kTrafficAnnotation);
+  loader_->SetOnRedirectCallback(base::BindRepeating(
+      [](base::WeakPtr<UpdateClient> self, const GURL&, const net::RedirectInfo& info,
+         const network::mojom::URLResponseHead&, std::vector<std::string>*) {
+        if (self && !info.new_url.SchemeIs(url::kHttpsScheme)) {
+          // Deleting the loader stops it; nothing after this is read.
+          self->loader_.reset();
+          self->Fail(State::kError, "an update address led away from https");
+        }
+      },
+      weak_factory_.GetWeakPtr()));
+  loader_->DownloadToString(
+      loader_factory_.get(),
+      base::BindOnce(
+          [](base::WeakPtr<UpdateClient> self,
+             base::OnceCallback<void(std::optional<std::string>)> done,
+             std::optional<std::string> body) {
+            if (self) {
+              self->OnFetched(std::move(done), std::move(body));
+            }
+          },
+          weak_factory_.GetWeakPtr(), std::move(done)),
+      most_bytes);
+}
+
+void UpdateClient::OnFetched(base::OnceCallback<void(std::optional<std::string>)> done,
+                             std::optional<std::string> body) {
+  const network::mojom::URLResponseHead* head = loader_ ? loader_->ResponseInfo() : nullptr;
+  const int code = head && head->headers ? head->headers->response_code() : 0;
+  std::move(done).Run(code == 200 ? std::move(body) : std::nullopt);
+}
+
+void UpdateClient::OnManifest(std::optional<std::string> body) {
+  if (!body) {
+    const int error = loader_ ? loader_->NetError() : net::ERR_FAILED;
+    Fail(State::kError, "the update manifest could not be fetched (" +
+                            net::ErrorToShortString(error) + ")");
+    return;
+  }
+  manifest_ = std::move(*body);
+  Fetch(SignatureUrl(config_.manifest_url), kSignatureBytes + 1,
+        base::BindOnce(&UpdateClient::OnSignature, weak_factory_.GetWeakPtr()));
+}
+
+void UpdateClient::OnSignature(std::optional<std::string> body) {
+  // A missing signature is a manifest that does not verify, not a network
+  // problem: CheckUpdate says so.
+  signature_ = body.value_or(std::string());
+  Fetch(KeyStatementsUrl(config_.manifest_url),
+        kKeyStatementBytes * kMostKeyStatements + 1,
+        base::BindOnce(&UpdateClient::OnKeyStatements, weak_factory_.GetWeakPtr()));
+}
+
+void UpdateClient::OnKeyStatements(std::optional<std::string> body) {
+  // Most releases have none.
+  fetched_statements_ = body ? SplitStatements(*body) : std::vector<std::string>();
+  loader_.reset();
+  Decide();
+}
+
+void UpdateClient::Decide() {
+  std::vector<std::string> statements;
+  for (const base::Value& kept : local_state_->GetList(kKeyStatementsPref)) {
+    std::string bytes;
+    if (kept.is_string() && base::Base64Decode(kept.GetString(), &bytes)) {
+      statements.push_back(std::move(bytes));
+    }
+  }
+  for (const std::string& fetched : fetched_statements_) {
+    if (std::find(statements.begin(), statements.end(), fetched) == statements.end()) {
+      statements.push_back(fetched);
+    }
+  }
+  if (statements.size() > kMostKeyStatements) {
+    statements.resize(kMostKeyStatements);
+  }
+  const std::vector<PublicKey> keys = TrustedKeys(config_.public_key, statements);
+
+  CopyInfo copy;
+  copy.allowed_hosts = config_.allowed_hosts;
+  copy.channel = config_.channel;
+  copy.installed = config_.installed;
+  copy.updater = config_.updater;
+  copy.variant = config_.variant;
+  copy.kind = config_.kind;
+  copy.last_serial = local_state_->GetInt64(kLastSerialPref);
+  const int64_t now = (clock_->Now() - base::Time::UnixEpoch()).InSeconds();
+  decision_ = CheckUpdateWithKeys(manifest_, signature_, copy, keys, now);
+
+  if (decision_->remember_serial && *decision_->remember_serial > copy.last_serial) {
+    local_state_->SetInt64(kLastSerialPref, *decision_->remember_serial);
+  }
+  // The statements that lead to a trusted key are kept, so the next look
+  // trusts the new key without update.key (P4.7).
+  if (decision_->manifest) {
+    base::ListValue keep;
+    for (const std::string& statement : statements) {
+      if (KeyFromStatement(statement, keys)) {
+        keep.Append(base::Base64Encode(statement));
+      }
+    }
+    local_state_->SetList(kKeyStatementsPref, std::move(keep));
+  }
+
+  const State state = StateFor(*decision_);
+  if (state != State::kAvailable) {
+    Fail(state, std::string(OutcomeName(decision_->outcome)));
+    return;
+  }
+  // On a metered connection only a look the person asked for downloads.
+  const bool wait_for_connection = !asked_ && config_.is_metered && config_.is_metered.Run();
+  if (!install_wanted_ || wait_for_connection) {
+    Status available;
+    if (wait_for_connection) {
+      available.detail = "waits for a connection that is not metered";
+    } else if (config_.install.is_null()) {
+      available.detail = config_.by_hand;
+    }
+    available.state = State::kAvailable;
+    available.version = ToString(decision_->manifest->version);
+    available.thoron_version = decision_->manifest->thoron_version;
+    available.outcome = decision_->outcome;
+    Finish(std::move(available));
+    return;
+  }
+  plan_ = PlanDownloads(*decision_);
+  next_step_ = 0;
+  std::vector<std::string> keep;
+  for (const DownloadStep& step : plan_) {
+    keep.push_back(step.file.sha256 + ".part");
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](const base::FilePath& dir, const std::vector<std::string>& keep) {
+            if (!base::CreateDirectory(dir)) {
+              return false;
+            }
+            // Parts of files this release does not name are of an older one.
+            base::FileEnumerator found(dir, /*recursive=*/false, base::FileEnumerator::FILES);
+            for (base::FilePath path = found.Next(); !path.empty(); path = found.Next()) {
+              const std::string name = path.BaseName().MaybeAsASCII();
+              const bool part = name.ends_with(".part") || name.ends_with(".part.more");
+              if (part && std::find(keep.begin(), keep.end(), name) == keep.end()) {
+                base::DeleteFile(path);
+              }
+            }
+            return true;
+          },
+          config_.download_dir, std::move(keep)),
+      base::BindOnce(&UpdateClient::OnDownloadDirReady, weak_factory_.GetWeakPtr()));
+}
+
+void UpdateClient::OnDownloadDirReady(bool made) {
+  if (!made || config_.download_dir.empty()) {
+    Fail(State::kError, "the download folder could not be made");
+    return;
+  }
+  DownloadNext();
+}
+
+base::FilePath UpdateClient::PartPath() const {
+  // Named by its SHA-256, so a part from an earlier run of the same file is
+  // taken up again, and never one of another file.
+  return config_.download_dir.AppendASCII(plan_[next_step_].file.sha256 + ".part");
+}
+
+void UpdateClient::DownloadNext() {
+  if (next_step_ >= plan_.size()) {
+    Fail(State::kError, "no download of the release verified");
+    return;
+  }
+  const DownloadStep& step = plan_[next_step_];
+  step_size_ = step.file.size;
+  attempts_ = 0;
+  resumed_ = false;
+  fetched_whole_again_ = false;
+  Status downloading;
+  downloading.state = State::kDownloading;
+  downloading.version = ToString(decision_->manifest->version);
+  downloading.thoron_version = decision_->manifest->thoron_version;
+  Report(downloading);
+  StartAttempt();
+}
+
+void UpdateClient::StartAttempt() {
+  ++attempts_;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](const base::FilePath& part, int64_t most) -> int64_t {
+            const int64_t size = base::GetFileSize(part).value_or(0);
+            // A part as long as the file or longer is no part to go on from.
+            if (size >= most) {
+              base::DeleteFile(part);
+              return 0;
+            }
+            return size;
+          },
+          PartPath(), step_size_),
+      base::BindOnce(&UpdateClient::OnPartSize, weak_factory_.GetWeakPtr()));
+}
+
+void UpdateClient::OnPartSize(int64_t had) {
+  const DownloadStep& step = plan_[next_step_];
+  had_ = had;
+  if (had > 0) {
+    resumed_ = true;
+  }
+  std::unique_ptr<network::ResourceRequest> request = UpdateRequest(GURL(step.file.url));
+  if (had > 0) {
+    // Only the rest (P4.3). A server that sends it all again is fine too.
+    request->headers.SetHeader("Range", "bytes=" + base::NumberToString(had) + "-");
+  }
+  loader_ = network::SimpleURLLoader::Create(std::move(request), kTrafficAnnotation);
+  // What arrived before a break is kept, so the next attempt goes on from it.
+  loader_->SetAllowPartialResults(true);
+  loader_->SetOnRedirectCallback(base::BindRepeating(
+      [](base::WeakPtr<UpdateClient> self, const GURL&, const net::RedirectInfo& info,
+         const network::mojom::URLResponseHead&, std::vector<std::string>*) {
+        if (self && !info.new_url.SchemeIs(url::kHttpsScheme)) {
+          self->loader_.reset();
+          self->Fail(State::kError, "a download led away from https");
+        }
+      },
+      weak_factory_.GetWeakPtr()));
+  loader_->SetOnDownloadProgressCallback(
+      base::BindRepeating(&UpdateClient::OnProgress, weak_factory_.GetWeakPtr()));
+  // One byte more than the manifest names is enough to tell a longer file. The
+  // whole size, not the rest: a server may send it all again for a range, and
+  // a part that grows too long is told by the check (PlaceVerifiedFile).
+  loader_->DownloadToFile(
+      loader_factory_.get(),
+      base::BindOnce(&UpdateClient::OnDownloaded, weak_factory_.GetWeakPtr(), had),
+      PartPath().AddExtensionASCII("more"), step.file.size + 1);
+}
+
+void UpdateClient::OnProgress(uint64_t current) {
+  if (step_size_ <= 0) {
+    return;
+  }
+  const int progress = static_cast<int>(std::min<uint64_t>(
+      100, (current + static_cast<uint64_t>(had_)) * 100 / static_cast<uint64_t>(step_size_)));
+  if (progress != status_.progress) {
+    Status downloading = status_;
+    downloading.progress = progress;
+    Report(downloading);
+  }
+}
+
+void UpdateClient::OnDownloaded(int64_t had, base::FilePath path) {
+  const net::HttpResponseHeaders* headers =
+      loader_ && loader_->ResponseInfo() ? loader_->ResponseInfo()->headers.get() : nullptr;
+  const int code = headers ? headers->response_code() : 0;
+  // A range answer counts only when it starts where the part ends.
+  int64_t first = -1, last = -1, length = -1;
+  const bool range_fits = code == 206 && had > 0 &&
+                          headers->GetContentRangeFor206(&first, &last, &length) &&
+                          first == had && (length < 0 || length == step_size_);
+  loader_.reset();
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](const base::FilePath& part, const base::FilePath& more, int code, bool range_fits)
+              -> int64_t {
+            if (!more.empty() && base::PathExists(more)) {
+              if (range_fits) {
+                // The rest, after what was there, copied in blocks.
+                base::File from(more, base::File::FLAG_OPEN | base::File::FLAG_READ);
+                base::File to(part, base::File::FLAG_OPEN | base::File::FLAG_APPEND);
+                bool copied = from.IsValid() && to.IsValid();
+                std::vector<uint8_t> block(1 << 20);
+                while (copied) {
+                  const std::optional<size_t> read = from.ReadAtCurrentPos(block);
+                  if (!read || *read == 0) {
+                    copied = read.has_value();
+                    break;
+                  }
+                  copied = to.WriteAtCurrentPosAndCheck(base::span(block).first(*read));
+                }
+                to.Close();
+                from.Close();
+                if (!copied) {
+                  base::DeleteFile(part);
+                }
+              } else if (code == 200) {
+                // The whole file (again): it takes the part's place.
+                base::ReplaceFile(more, part, nullptr);
+              }
+              base::DeleteFile(more);
+            }
+            return base::GetFileSize(part).value_or(0);
+          },
+          PartPath(), path, code, range_fits),
+      base::BindOnce(&UpdateClient::OnTakenIn, weak_factory_.GetWeakPtr()));
+}
+
+void UpdateClient::OnTakenIn(int64_t size) {
+  const DownloadStep& step = plan_[next_step_];
+  if (size < step_size_) {
+    if (attempts_ < kMostAttempts) {
+      StartAttempt();
+      return;
+    }
+    // What arrived is kept: the next look goes on from it.
+    ++next_step_;
+    DownloadNext();
+    return;
+  }
+  const base::FilePath destination =
+      config_.download_dir.AppendASCII(PackageName(step.file, step.delta));
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&PlaceVerifiedFile, PartPath(), step.file, destination),
+      base::BindOnce(&UpdateClient::OnPlaced, weak_factory_.GetWeakPtr(), destination));
+}
+
+void UpdateClient::OnPlaced(base::FilePath placed, FileCheck check) {
+  if (check != FileCheck::kOk && resumed_ && !fetched_whole_again_) {
+    // A part from before that did not fit what came after: the file once more,
+    // from the start (PlaceVerifiedFile removed what did not verify).
+    fetched_whole_again_ = true;
+    resumed_ = false;
+    StartAttempt();
+    return;
+  }
+  if (check != FileCheck::kOk) {
+    // That download is gone; the next step (the full package) is tried.
+    ++next_step_;
+    DownloadNext();
+    return;
+  }
+  Status installing = status_;
+  installing.state = State::kInstalling;
+  installing.progress = 100;
+  Report(installing);
+  const bool delta = plan_[next_step_].delta;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](Installer install, base::FilePath package, PackageFile expected, bool delta,
+             std::string version) {
+            bool installed = false;
+            {
+              // Checked once more and held open until the installer is done:
+              // nothing can change, rename or remove it in between (U8).
+              FileCheck check;
+              const base::File held = HoldVerifiedFile(package, expected, &check);
+              installed = held.IsValid() && install && install.Run(package, delta, version);
+            }
+            base::DeleteFile(package);
+            return installed;
+          },
+          config_.install, placed, plan_[next_step_].file, delta,
+          ToString(decision_->manifest->version)),
+      base::BindOnce(&UpdateClient::OnInstalled, weak_factory_.GetWeakPtr()));
+}
+
+void UpdateClient::OnInstalled(bool installed) {
+  if (!installed) {
+    if (plan_[next_step_].delta) {
+      // A delta that does not install ends in the full package (package.h).
+      ++next_step_;
+      DownloadNext();
+      return;
+    }
+    Fail(State::kError, "the installer of the release failed");
+    return;
+  }
+  Status ready;
+  ready.state = State::kReadyToRelaunch;
+  ready.progress = 100;
+  ready.version = ToString(decision_->manifest->version);
+  ready.thoron_version = decision_->manifest->thoron_version;
+  ready.outcome = decision_->outcome;
+  const bool critical = decision_->manifest->critical;
+  Finish(ready);
+  if (config_.on_installed) {
+    config_.on_installed.Run(ready.version, critical);
+  }
+}
+
