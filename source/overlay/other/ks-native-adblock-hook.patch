diff --git a/chrome/utility/importer/chromium_family_importer.cc b/chrome/utility/importer/chromium_family_importer.cc
new file mode 100644
index 0000000000000000000000000000000000000000..4c750ac03d23614f037f42f37f76e708eedbed06
--- /dev/null
+++ b/chrome/utility/importer/chromium_family_importer.cc
@@ -0,0 +1,247 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/utility/importer/chromium_family_importer.h"
+
+#include <memory>
+#include <utility>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/common/importer/importer_autofill_form_data_entry.h"
+#include "chrome/common/importer/importer_bridge.h"
+#include "chrome/grit/generated_resources.h"
+#include "components/user_data_importer/chromium_family/chromium_family_import_bridge.h"
+#include "components/user_data_importer/chromium_family/chromium_family_reader.h"
+#include "components/user_data_importer/common/importer_data_types.h"
+#include "net/cookies/canonical_cookie.h"
+#include "net/cookies/cookie_constants.h"
+#include "net/cookies/cookie_partition_key.h"
+
+namespace {
+
+namespace cf = user_data_importer::chromium_family;
+
+// The browser's on-disk cookie integers (see ImportedCookie) mapped to net's
+// enums, matching net/extras/sqlite/sqlite_persistent_cookie_store.cc.
+net::CookieSameSite ToSameSite(int db_value) {
+  switch (db_value) {
+    case 0:
+      return net::CookieSameSite::NO_RESTRICTION;
+    case 1:
+      return net::CookieSameSite::LAX_MODE;
+    case 2:
+      return net::CookieSameSite::STRICT_MODE;
+    default:
+      return net::CookieSameSite::UNSPECIFIED;
+  }
+}
+
+net::CookiePriority ToPriority(int db_value) {
+  switch (db_value) {
+    case 0:
+      return net::COOKIE_PRIORITY_LOW;
+    case 2:
+      return net::COOKIE_PRIORITY_HIGH;
+    default:
+      return net::COOKIE_PRIORITY_MEDIUM;
+  }
+}
+
+net::CookieSourceScheme ToSourceScheme(int db_value) {
+  switch (db_value) {
+    case 1:
+      return net::CookieSourceScheme::kNonSecure;
+    case 2:
+      return net::CookieSourceScheme::kSecure;
+    default:
+      return net::CookieSourceScheme::kUnset;
+  }
+}
+
+net::CookieSourceType ToSourceType(int db_value) {
+  switch (db_value) {
+    case 1:
+      return net::CookieSourceType::kHTTP;
+    case 2:
+      return net::CookieSourceType::kScript;
+    default:
+      // The database's "unknown" (0) maps to "other", as Chromium does.
+      return net::CookieSourceType::kOther;
+  }
+}
+
+// "Brave (Work)" -> "Brave". The browser name never contains " (", so the
+// first one is the separator the detector added.
+std::u16string BrowserNameOnly(const std::u16string& importer_name) {
+  size_t open = importer_name.find(u" (");
+  if (open != std::u16string::npos && !importer_name.empty() &&
+      importer_name.back() == u')') {
+    return importer_name.substr(0, open);
+  }
+  return importer_name;
+}
+
+// Forwards what the reader library extracts to Chromium's ImporterBridge.
+class BridgeAdapter : public cf::ChromiumFamilyImportBridge {
+ public:
+  explicit BridgeAdapter(ImporterBridge* bridge) : bridge_(bridge) {}
+
+  void AddBookmarks(
+      const std::vector<user_data_importer::ImportedBookmarkEntry>& bookmarks,
+      const std::u16string& top_level_folder_name) override {
+    bridge_->AddBookmarks(bookmarks, top_level_folder_name);
+  }
+
+  void SetHistory(
+      const std::vector<user_data_importer::ImporterURLRow>& rows) override {
+    bridge_->SetHistoryItems(
+        rows, user_data_importer::VISIT_SOURCE_CHROMIUM_FAMILY_IMPORTED);
+  }
+
+  void SetKeywords(
+      const std::vector<user_data_importer::SearchEngineInfo>& engines)
+      override {
+    // Dedup against existing engines by host+path, as the IE importer does, so
+    // Thoron's own prepopulated engines are not replaced.
+    bridge_->SetKeywords(engines, /*unique_on_host_and_path=*/true);
+  }
+
+  void AddPasswordForm(
+      const user_data_importer::ImportedPasswordForm& form) override {
+    bridge_->SetPasswordForm(form);
+  }
+
+  void SetAutofillEntries(
+      const std::vector<cf::ImportedAutofillEntry>& entries) override {
+    std::vector<ImporterAutofillFormDataEntry> converted;
+    converted.reserve(entries.size());
+    for (const cf::ImportedAutofillEntry& entry : entries) {
+      ImporterAutofillFormDataEntry out;
+      out.name = entry.name;
+      out.value = entry.value;
+      out.times_used = entry.times_used;
+      out.first_used = entry.date_created;
+      out.last_used = entry.date_last_used;
+      converted.push_back(std::move(out));
+    }
+    if (!converted.empty()) {
+      bridge_->SetAutofillFormData(converted);
+    }
+  }
+
+  void SetStartupSettings(const cf::ImportedStartupSettings& settings) override {
+    bridge_->SetThoronStartup(settings.home_page,
+                              settings.home_page_is_new_tab_page,
+                              settings.show_home_button,
+                              settings.restore_on_startup,
+                              settings.startup_pages);
+  }
+
+
+  void SetWebStoreExtensions(const std::vector<std::string>& ids) override {
+    bridge_->AddThoronWebStoreExtensions(ids);
+  }
+
+  void SetOpenTabsSession(const std::vector<uint8_t>& session_file) override {
+    bridge_->AddThoronOpenTabs(session_file);
+  }
+  void SetCookies(const std::vector<cf::ImportedCookie>& cookies) override {
+    std::vector<net::CanonicalCookie> converted;
+    converted.reserve(cookies.size());
+    for (const cf::ImportedCookie& c : cookies) {
+      // The partition key for a partitioned cookie; empty means unpartitioned.
+      base::expected<std::optional<net::CookiePartitionKey>, std::string>
+          partition_key = net::CookiePartitionKey::FromStorage(
+              c.top_frame_site_key, c.has_cross_site_ancestor);
+      if (!partition_key.has_value()) {
+        continue;
+      }
+      std::unique_ptr<net::CanonicalCookie> cc =
+          net::CanonicalCookie::FromStorage(
+              c.name, c.value, c.domain, c.path, c.creation, c.expiration,
+              c.last_access, c.last_update, c.secure, c.httponly,
+              ToSameSite(c.same_site), ToPriority(c.priority),
+              std::move(partition_key.value()), ToSourceScheme(c.source_scheme),
+              c.source_port, ToSourceType(c.source_type),
+              net::CanonicalCookieFromStorageCallSite::kCookieManager);
+      if (cc) {
+        converted.push_back(std::move(*cc));
+      }
+    }
+    if (!converted.empty()) {
+      bridge_->SetCookies(converted);
+    }
+  }
+
+ private:
+  raw_ptr<ImporterBridge> bridge_;
+};
+
+}  // namespace
+
+ChromiumFamilyImporter::ChromiumFamilyImporter() = default;
+ChromiumFamilyImporter::~ChromiumFamilyImporter() = default;
+
+void ChromiumFamilyImporter::StartImport(
+    const user_data_importer::SourceProfile& source_profile,
+    uint16_t items,
+    ImporterBridge* bridge) {
+  bridge_ = bridge;
+  bridge_->NotifyStarted();
+
+  cf::ChromiumFamilyReader::Options options;
+  options.profile_path = source_profile.source_path;
+  options.user_data_path = source_profile.app_path;
+  const std::u16string browser_name =
+      BrowserNameOnly(source_profile.importer_name);
+  options.bookmark_folder_name = base::ReplaceStringPlaceholders(
+      bridge_->GetLocalizedString(IDS_BOOKMARK_GROUP_FROM_CHROMIUM_FAMILY),
+      browser_name, nullptr);
+
+  cf::ChromiumFamilyReader reader(options);
+  BridgeAdapter adapter(bridge_.get());
+
+  // Drive one item at a time so the progress UI sees each start and end. The
+  // order matches the reader's own (history before bookmarks, so favicons map
+  // onto known URLs).
+  static constexpr user_data_importer::ImportItem kOrder[] = {
+      user_data_importer::HISTORY, user_data_importer::FAVORITES,
+      user_data_importer::SEARCH_ENGINES,
+      user_data_importer::AUTOFILL_FORM_DATA, user_data_importer::PASSWORDS,
+      user_data_importer::COOKIES, user_data_importer::HOME_PAGE,
+      user_data_importer::EXTENSIONS, user_data_importer::OPEN_TABS};
+  cf::ChromiumFamilyReader::Stats stats;
+  for (user_data_importer::ImportItem item : kOrder) {
+    if (!(items & item) || cancelled()) {
+      continue;
+    }
+    bridge_->NotifyItemStarted(item);
+    stats = reader.Import(item, &adapter);  // the counts so far
+    bridge_->NotifyItemEnded(item);
+  }
+
+  // The local report of the import (counts only), written by the browser.
+  ThoronImportCounts counts;
+  counts.bookmarks = stats.bookmarks;
+  counts.history = stats.history;
+  counts.search_engines = stats.search_engines;
+  counts.autofill = stats.autofill;
+  counts.passwords = stats.passwords;
+  counts.passwords_skipped_app_bound = stats.passwords_skipped_app_bound;
+  counts.passwords_skipped_other = stats.passwords_skipped_other;
+  counts.passwords_failed = stats.passwords_failed;
+  counts.cookies = stats.cookies;
+  counts.cookies_skipped_app_bound = stats.cookies_skipped_app_bound;
+  counts.cookies_failed = stats.cookies_failed;
+  counts.home_page = stats.home_page;
+  counts.startup_pages = stats.startup_pages;
+  counts.extensions = stats.extensions;
+  counts.extensions_skipped = stats.extensions_skipped;
+  counts.open_tabs = stats.open_tabs;
+  counts.databases_refused = stats.databases_refused;
+  bridge_->ReportThoronImport(counts);
+  bridge_->NotifyEnded();
+}
