+class MenuHandler : public content::WebUIMessageHandler {
+ public:
+  explicit MenuHandler(ThoronAdblockMenuUI* controller)
+      : controller_(controller) {}
+  MenuHandler(const MenuHandler&) = delete;
+  MenuHandler& operator=(const MenuHandler&) = delete;
+  ~MenuHandler() override = default;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override {
+    Register("getPopupState", &MenuHandler::GetState);
+    Register("setSiteEnabled", &MenuHandler::SetSiteEnabled);
+    Register("setBlocking", &MenuHandler::SetBlocking);
+    Register("getLists", &MenuHandler::GetLists);
+    Register("setListEnabled", &MenuHandler::SetListEnabled);
+    Register("updateLists", &MenuHandler::UpdateLists);
+    Register("addList", &MenuHandler::AddList);
+    Register("removeList", &MenuHandler::RemoveList);
+    Register("setSwitch", &MenuHandler::SetSwitch);
+    Register("startPicker", &MenuHandler::StartPicker);
+    Register("startZapper", &MenuHandler::StartZapper);
+    Register("openLogger", &MenuHandler::OpenLogger);
+    Register("openDashboard", &MenuHandler::OpenDashboard);
+    Register("openExtensions", &MenuHandler::OpenExtensions);
+    Register("menuReady", &MenuHandler::MenuReady);
+    Register("closeMenu", &MenuHandler::CloseMenu);
+    Register("setGridCell", &MenuHandler::SetGridCell);
+    Register("saveGrid", &MenuHandler::SaveGrid);
+    Register("revertGrid", &MenuHandler::RevertGrid);
+    Register("reloadTab", &MenuHandler::ReloadTab);
+    Register("openBlockedPage", &MenuHandler::OpenBlockedPage);
+  }
+
+ private:
+  using Method = void (MenuHandler::*)(const base::ListValue&);
+  void Register(std::string_view message, Method method) {
+    web_ui()->RegisterMessageCallback(
+        message, base::BindRepeating(method, base::Unretained(this)));
+  }
+
+  // The tab the menu is about: the active tab of its window. Opened as a tab
+  // itself (the automated checks), the tab before it.
+  content::WebContents* Tab() {
+    BrowserWindowInterface* browser =
+        webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+    TabStripModel* tabs = browser ? browser->GetTabStripModel() : nullptr;
+    content::WebContents* active =
+        tabs ? tabs->GetActiveWebContents() : nullptr;
+    if (!active || active != web_ui()->GetWebContents()) {
+      return active;
+    }
+    const int index = tabs->GetIndexOfWebContents(active);
+    return index > 0 ? tabs->GetWebContentsAt(index - 1) : nullptr;
+  }
+
+  // The site of that tab, when it is one the blocker works on.
+  GURL Site(content::WebContents* tab) {
+    if (!tab) {
+      return GURL();
+    }
+    const GURL url = tab->GetPrimaryMainFrame()->GetLastCommittedURL();
+    return url.SchemeIsHTTPOrHTTPS() ? url : GURL();
+  }
+
+  HostContentSettingsMap* Settings() {
+    return HostContentSettingsMapFactory::GetForProfile(
+        Profile::FromWebUI(web_ui()));
+  }
+
+  void GetState(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.empty()) {
+      return;
+    }
+    content::WebContents* tab = Tab();
+    const GURL site = Site(tab);
+    base::DictValue state;
+    state.Set("applicable", site.is_valid());
+    state.Set("site", site.is_valid() ? std::string(site.host()) : std::string());
+    state.Set("enabled",
+              site.is_valid() &&
+                  Settings()->GetContentSetting(site, site,
+                                                ContentSettingsType::ADS) !=
+                      CONTENT_SETTING_ALLOW);
+    // the switch for every site (P5.70), and when it comes back on by itself
+    state.Set("everywhere",
+              thoron_adblock::ProxyingURLLoaderFactory::BlockingEverywhere(
+                  Settings()));
+    state.Set("backAt",
+              thoron_adblock::EngineService::Get().BlockingBackAt());
+    // uBlock Origin on as well (P5.24): both do the same work
+    state.Set("ubo", UBlockOriginOn());
+    base::ListValue sites;
+    int page_count = 0;
+    if (tab) {
+      content::Page& page = tab->GetPrimaryPage();
+      page_count = thoron_adblock::BlockedCount::Get(page);
+      for (const auto& [host, count] :
+           thoron_adblock::BlockedCount::Hosts(page)) {
+        sites.Append(base::DictValue().Set("host", host).Set("count", count));
+      }
+    }
+    state.Set("pageCount", page_count);
+    const thoron_adblock::BlockedCount::Summary summary =
+        tab ? thoron_adblock::BlockedCount::Totals(tab->GetPrimaryPage())
+            : thoron_adblock::BlockedCount::Summary();
+    state.Set("requests", summary.requests);
+    state.Set("domains", summary.domains);
+    state.Set("connected", summary.connected);
+    state.Set("sites", std::move(sites));
+    state.Set("totalCount", static_cast<double>(
+                                thoron_adblock::BlockedCount::Total()));
+    base::DictValue switches;
+    if (site.is_valid()) {
+      switches.Set("javascript",
+                   Settings()->GetContentSetting(
+                       site, site, ContentSettingsType::JAVASCRIPT) ==
+                       CONTENT_SETTING_BLOCK);
+      for (const char* name :
+           {"popups", "media", "cosmetic", "fonts", "3p-script", "3p-frame"}) {
+        switches.Set(name,
+                     thoron_adblock::EngineService::Get().SiteSwitch(site, name));
+      }
+    }
+    state.Set("switches", std::move(switches));
+    state.Set("mediaKb", thoron_adblock::EngineService::Get().large_media_kb());
+    state.Set("colorblind",
+              thoron_adblock::EngineService::Get().Option("colorblind"));
+    state.Set("theme", thoron_adblock::EngineService::Get().theme());
+    state.Set("accent", thoron_adblock::EngineService::Get().accent());
+    state.Set("noTooltips",
+              thoron_adblock::EngineService::Get().Option("no-tooltips"));
+    state.Set("blockedPage", BlockedPage(tab, site));
+    // the grid of rules, unless "I am an advanced user" is off
+    if (site.is_valid() &&
+        thoron_adblock::EngineService::Get().Option("advanced")) {
+      state.Set("grid", Grid(site, tab->GetPrimaryPage()));
+    }
+    ResolveJavascriptCallback(args[0], state);
+  }
+
+  // The rows of uBlock Origin's grid for the page: the domains it asked (the
+  // page's own first), each followed by the hosts under it that it asked.
+  struct GridRow {
+    std::string host;
+    bool domain = false;
+    int requests = 0;
+    int blocked = 0;
+  };
+  static constexpr size_t kMaxGridRows = 200;
+  std::vector<GridRow> GridRows(const GURL& site, content::Page& page) {
+    using net::registry_controlled_domains::GetDomainAndRegistry;
+    using net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES;
+    auto domain_of = [](const std::string& host) {
+      std::string domain = GetDomainAndRegistry(host, INCLUDE_PRIVATE_REGISTRIES);
+      return domain.empty() ? host : domain;
+    };
+    std::vector<thoron_adblock::BlockedCount::HostRequests> asked =
+        thoron_adblock::BlockedCount::AskedHosts(page);
+    const std::string own(site.host());
+    if (std::none_of(asked.begin(), asked.end(),
+                     [&](const auto& h) { return h.host == own; })) {
+      asked.push_back({own, 0, 0});
+    }
+    // domain -> (its row, the hosts under it)
+    std::map<std::string, std::pair<GridRow, std::vector<GridRow>>> domains;
+    for (const auto& h : asked) {
+      const std::string domain = domain_of(h.host);
+      auto& [row, hosts] = domains[domain];
+      row.host = domain;
+      row.domain = true;
+      row.requests += h.requests;
+      row.blocked += h.blocked;
+      if (h.host != domain) {
+        hosts.push_back({h.host, false, h.requests, h.blocked});
+      }
+    }
+    std::vector<GridRow> rows;
+    auto add = [&](const std::pair<GridRow, std::vector<GridRow>>& entry) {
+      if (rows.size() < kMaxGridRows) {
+        rows.push_back(entry.first);
+      }
+      for (const GridRow& host : entry.second) {
+        if (rows.size() < kMaxGridRows) {
+          rows.push_back(host);
+        }
+      }
+    };
+    const std::string own_domain = domain_of(own);
+    if (auto it = domains.find(own_domain); it != domains.end()) {
+      add(it->second);
+    }
+    for (const auto& [domain, entry] : domains) {
+      if (domain != own_domain) {
+        add(entry);
+      }
+    }
+    return rows;
+  }
+
+  std::vector<std::string> GridHosts(const GURL& site, content::Page& page) {
+    std::vector<std::string> hosts;
+    for (const GridRow& row : GridRows(site, page)) {
+      hosts.push_back(row.host);
+    }
+    return hosts;
+  }
+
+  base::DictValue Grid(const GURL& site, content::Page& page) {
+    thoron_adblock::EngineService& service =
+        thoron_adblock::EngineService::Get();
+    const std::string source(site.host());
+    base::ListValue types;
+    for (std::string_view kind : kGridTypes) {
+      types.Append(base::DictValue()
+                       .Set("kind", kind)
+                       .Set("global", service.GridCell("*", "*", kind))
+                       .Set("local", service.GridCell(source, "*", kind)));
+    }
+    base::ListValue rows;
+    std::vector<std::string> hosts;
+    for (const GridRow& row : GridRows(site, page)) {
+      rows.Append(base::DictValue()
+                      .Set("host", row.host)
+                      .Set("domain", row.domain)
+                      .Set("requests", row.requests)
+                      .Set("blocked", row.blocked)
+                      .Set("global", service.GridCell("*", row.host, "*"))
+                      .Set("local", service.GridCell(source, row.host, "*")));
+      hosts.push_back(row.host);
+    }
+    return base::DictValue()
+        .Set("types", std::move(types))
+        .Set("hosts", std::move(rows))
+        .Set("changed", service.GridChanged(source, hosts));
+  }
+
+  // [destination, type, "global" or "local", action 0-3]: a type row
+  // ("*" and a type of kGridTypes) or a host the page asked (and "*").
+  void SetGridCell(const base::ListValue& args) {
+    content::WebContents* tab = Tab();
+    const GURL site = Site(tab);
+    if (!site.is_valid() ||
+        !thoron_adblock::EngineService::Get().Option("advanced") ||
+        args.size() != 4 || !args[0].is_string() ||
+        !args[1].is_string() || !args[2].is_string() || !args[3].is_int()) {
+      return;
+    }
+    const std::string& destination = args[0].GetString();
+    const std::string& kind = args[1].GetString();
+    const std::string& scope = args[2].GetString();
+    const int action = args[3].GetInt();
+    if ((scope != "global" && scope != "local") || action < 0 || action > 3) {
+      return;
+    }
+    if (destination == "*") {
+      if (std::find(std::begin(kGridTypes), std::end(kGridTypes), kind) ==
+          std::end(kGridTypes)) {
+        return;
+      }
+    } else {
+      const std::vector<std::string> hosts =
+          GridHosts(site, tab->GetPrimaryPage());
+      if (kind != "*" ||
+          std::find(hosts.begin(), hosts.end(), destination) == hosts.end()) {
+        return;
+      }
+    }
+    thoron_adblock::EngineService::Get().SetGridCell(
+        scope == "local" ? std::string(site.host()) : std::string("*"),
+        destination, kind, action);
+  }
+
+  // uBlock Origin's padlock and eraser, for the cells of this page.
+  void SaveGrid(const base::ListValue& args) {
+    content::WebContents* tab = Tab();
+    const GURL site = Site(tab);
+    if (site.is_valid()) {
+      thoron_adblock::EngineService::Get().SaveGrid(
+          site.host(), GridHosts(site, tab->GetPrimaryPage()));
+    }
+  }
+
+  void RevertGrid(const base::ListValue& args) {
+    content::WebContents* tab = Tab();
+    const GURL site = Site(tab);
+    if (site.is_valid()) {
+      thoron_adblock::EngineService::Get().RevertGrid(
+          site.host(), GridHosts(site, tab->GetPrimaryPage()));
+    }
+  }
+
+  void ReloadTab(const base::ListValue& args) { Reload(Tab()); }
+
+  // The tab shows the page strict blocking put in place of a page the lists
+  // block (PageBlockThrottle).
+  bool BlockedPage(content::WebContents* tab, const GURL& site) {
+    const thoron_adblock::EngineService& service =
+        thoron_adblock::EngineService::Get();
+    return tab && site.is_valid() &&
+           tab->GetPrimaryMainFrame()->IsErrorDocument() &&
+           service.BlocksPage(site) && !service.StrictOff(site);
+  }
+
+  // uBlock Origin's "Proceed" on its blocked page: [always]. Only for the
+  // page the tab shows blocked.
+  void OpenBlockedPage(const base::ListValue& args) {
+    content::WebContents* tab = Tab();
+    const GURL site = Site(tab);
+    if (args.size() != 1 || !args[0].is_bool() || !BlockedPage(tab, site)) {
+      return;
+    }
+    thoron_adblock::EngineService& service =
+        thoron_adblock::EngineService::Get();
+    if (args[0].GetBool()) {
+      service.SetSiteSwitch(site, "no-strict", true);
+    } else {
+      service.SetStrictOffForNow(site);
+    }
+    Reload(tab);
+  }
+
+  void Reload(content::WebContents* tab) {
+    if (tab) {
+      tab->GetController().Reload(content::ReloadType::NORMAL, true);
+    }
+  }
+
+  void SetSiteEnabled(const base::ListValue& args) {
+    content::WebContents* tab = Tab();
+    const GURL site = Site(tab);
+    if (!site.is_valid() || args.size() != 1 || !args[0].is_bool()) {
+      return;
+    }
+    // The per-site switch the blocker already follows (the "Ads and
+    // trackers" site setting): allowed means blocking is off there.
+    Settings()->SetContentSettingDefaultScope(
+        site, GURL(), ContentSettingsType::ADS,
+        args[0].GetBool() ? CONTENT_SETTING_DEFAULT : CONTENT_SETTING_ALLOW);
+    Reload(tab);
+  }
+
+  // The switch for every site (P5.70): [on, minutes] (minutes: off for that
+  // long, -1 until the browser closes, 0 until switched on again). The tab
+  // is loaded again, as for the site's switch.
+  void SetBlocking(const base::ListValue& args) {
+    if (args.size() != 2 || !args[0].is_bool() || !args[1].is_int()) {
+      return;
+    }
+    if (!thoron_adblock::ProxyingURLLoaderFactory::SetBlockingEverywhere(
+            Settings(), args[0].GetBool(), args[1].GetInt())) {
+      return;
+    }
+    content::WebContents* tab = Tab();
+    if (Site(tab).is_valid()) {
+      Reload(tab);
+    }
+  }
+
+  // The filter lists in the menu (P5.71), as on chrome://adblock: what
+  // there is, a list on or off, every list downloaded again now, one added
+  // by its address or removed. Each answers "" or what went wrong.
+  static constexpr size_t kMaxListUrl = 2048;
+  const std::string* CallbackId(const base::ListValue& args, size_t last) {
+    AllowJavascript();
+    return args.size() == last + 1 && args[0].is_string() ? &args[0].GetString()
+                                                          : nullptr;
+  }
+  void Resolve(const std::string& id, base::DictValue value) {
+    if (IsJavascriptAllowed()) {
+      ResolveJavascriptCallback(base::Value(id), value);
+    }
+  }
+  void Answer(const std::string& id, std::string error) {
+    if (IsJavascriptAllowed()) {
+      ResolveJavascriptCallback(base::Value(id), base::Value(std::move(error)));
+    }
+  }
+  thoron_adblock::EngineService::Changed Answered(const std::string& id) {
+    return base::BindOnce(&MenuHandler::Answer, weak_factory_.GetWeakPtr(), id);
+  }
+  void GetLists(const base::ListValue& args) {
+    if (const std::string* id = CallbackId(args, 0)) {
+      thoron_adblock::EngineService::Get().DescribeSettings(base::BindOnce(
+          &MenuHandler::Resolve, weak_factory_.GetWeakPtr(), *id));
+    }
+  }
+  void SetListEnabled(const base::ListValue& args) {
+    const std::string* id = CallbackId(args, 2);
+    if (id && args[1].is_string() && args[2].is_bool()) {
+      thoron_adblock::EngineService::Get().SetListEnabled(
+          args[1].GetString(), args[2].GetBool(), Answered(*id));
+    }
+  }
+  void UpdateLists(const base::ListValue& args) {
+    if (const std::string* id = CallbackId(args, 0)) {
+      thoron_adblock::EngineService::Get().UpdateNow(Answered(*id));
+    }
+  }
+  void AddList(const base::ListValue& args) {
+    const std::string* id = CallbackId(args, 1);
+    if (!id || !args[1].is_string()) {
+      return;
+    }
+    const GURL url(args[1].GetString());
+    if (args[1].GetString().size() > kMaxListUrl || !url.is_valid()) {
+      Answer(*id, "This is not an address.");
+      return;
+    }
+    thoron_adblock::EngineService::Get().AddList(url, Answered(*id));
+  }
+  void RemoveList(const base::ListValue& args) {
+    const std::string* id = CallbackId(args, 1);
+    if (id && args[1].is_string()) {
+      thoron_adblock::EngineService::Get().RemoveList(args[1].GetString(),
+                                                      Answered(*id));
+    }
+  }
+
+  void SetSwitch(const base::ListValue& args) {
+    content::WebContents* tab = Tab();
+    const GURL site = Site(tab);
+    if (!site.is_valid() || args.size() != 2 || !args[0].is_string() ||
+        !args[1].is_bool()) {
+      return;
+    }
+    const std::string& name = args[0].GetString();
+    const bool on = args[1].GetBool();
+    const ContentSettingsType chrome_type = ChromeSwitch(name);
+    if (chrome_type == ContentSettingsType::JAVASCRIPT) {
+      thoron_adblock::SetSiteJavascript(Settings(), site, on);
+    } else if (name == "popups" || name == "media" || name == "cosmetic" ||
+               name == "fonts" || name == "3p-script" || name == "3p-frame") {
+      thoron_adblock::EngineService::Get().SetSiteSwitch(site, name, on);
+    } else {
+      return;
+    }
+    Reload(tab);
+  }
+
+  void StartPicker(const base::ListValue& args) {
+    thoron_adblock::StartPicker(Tab(), /*zapper=*/false);
+    CloseMenu(args);
+  }
+
+  void StartZapper(const base::ListValue& args) {
+    thoron_adblock::StartPicker(Tab(), /*zapper=*/true);
+    CloseMenu(args);
+  }
+
+  void Open(const char* url) {
+    BrowserWindowInterface* browser =
+        webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+    if (browser) {
+      browser->OpenGURL(GURL(url), WindowOpenDisposition::kNewForegroundTab);
+    }
+  }
+
+  void OpenLogger(const base::ListValue& args) {
+    Open(kLoggerUrl);
+    CloseMenu(args);
+  }
+
+  // The id of a uBlock Origin that is on in this profile, or "".
+  std::string UBlockOriginOn() {
+    const extensions::ExtensionRegistry* registry =
+        extensions::ExtensionRegistry::Get(Profile::FromWebUI(web_ui()));
+    for (const char* id : kUBlockOriginIds) {
+      if (registry && registry->enabled_extensions().Contains(id)) {
+        return id;
+      }
+    }
+    return std::string();
+  }
+
+  // chrome://extensions at the uBlock Origin that is on, to turn it off.
+  void OpenExtensions(const base::ListValue& args) {
+    const std::string id = UBlockOriginOn();
+    Open(id.empty() ? "chrome://extensions/"
+                    : ("chrome://extensions/?id=" + id).c_str());
+    CloseMenu(args);
+  }
+
+  void OpenDashboard(const base::ListValue& args) {
+    Open(kDashboardUrl);
+    CloseMenu(args);
+  }
+
+  void MenuReady(const base::ListValue& args) {
+    controller_->set_ready();
+    if (auto embedder = controller_->embedder()) {
+      embedder->ShowUI();
+    }
+  }
+
+  void CloseMenu(const base::ListValue& args) {
+    if (auto embedder = controller_->embedder()) {
+      embedder->CloseUI();
+    }
+  }
+
+  const raw_ptr<ThoronAdblockMenuUI> controller_;
+  base::WeakPtrFactory<MenuHandler> weak_factory_{this};
+};
+
+}  // namespace
+
+ThoronAdblockMenuUIConfig::ThoronAdblockMenuUIConfig()
+    : DefaultTopChromeWebUIConfig(content::kChromeUIScheme,
+                                  kThoronAdblockMenuHost) {}
+
+bool ThoronAdblockMenuUIConfig::IsWebUIEnabled(
+    content::BrowserContext* browser_context) {
+  return base::FeatureList::IsEnabled(thoron_adblock::kThoronNativeAdblock);
+}
+
+bool ThoronAdblockMenuUIConfig::ShouldAutoResizeHost() {
+  return true;
+}
+
+ThoronAdblockMenuUI::ThoronAdblockMenuUI(content::WebUI* web_ui)
+    : TopChromeWebUIController(web_ui, /*enable_chrome_send=*/true) {
+  content::URLDataSource::Add(Profile::FromWebUI(web_ui),
+                              std::make_unique<MenuDataSource>());
+  web_ui->AddMessageHandler(std::make_unique<MenuHandler>(this));
+}
+
+ThoronAdblockMenuUI::~ThoronAdblockMenuUI() = default;
+
+bool ThoronAdblockMenuUI::TellShown() {
+  if (!ready_) {
+    return false;
+  }
+  const base::Value event("menu-shown");
+  web_ui()->CallJavascriptFunctionUnsafe("cr.webUIListenerCallback", event);
+  return true;
+}
+
+void ThoronAdblockMenuUI::TellHidden() {
+  if (!ready_) {
+    return;
+  }
+  const base::Value event("menu-hidden");
+  web_ui()->CallJavascriptFunctionUnsafe("cr.webUIListenerCallback", event);
+}
+
+WEB_UI_CONTROLLER_TYPE_IMPL(ThoronAdblockMenuUI)
