+// static
+bool MailService::KnownChoice(const std::string& name,
+                              const std::string& value) {
+  const ChoiceValues* choice = FindChoice(name);
+  if (!choice) {
+    return false;
+  }
+  for (const char* known : choice->values) {
+    if (known && value == known) {
+      return true;
+    }
+  }
+  return false;
+}
+
+std::string MailService::Choice(const std::string& name) const {
+  const ChoiceValues* choice = FindChoice(name);
+  if (!choice) {
+    return std::string();
+  }
+  const std::string value =
+      prefs_ ? prefs_->GetString("thoron_mail." + name) : std::string();
+  return KnownChoice(name, value) ? value : choice->values[0];
+}
+
+bool MailService::SetChoice(const std::string& name, const std::string& value) {
+  if (!prefs_ || !KnownChoice(name, value)) {
+    return false;
+  }
+  prefs_->SetString("thoron_mail." + name, value);
+  observers_.Notify(&Observer::OnMailChanged);
+  return true;
+}
+
+int MailService::interval_minutes() const {
+  const int minutes = prefs_ ? prefs_->GetInteger(kIntervalPref) : 0;
+  return std::ranges::find(kIntervals, minutes) != std::end(kIntervals)
+             ? minutes
+             : kDefaultInterval;
+}
+
+bool MailService::SetInterval(int minutes) {
+  if (!prefs_ ||
+      std::ranges::find(kIntervals, minutes) == std::end(kIntervals)) {
+    return false;
+  }
+  prefs_->SetInteger(kIntervalPref, minutes);
+  if (!checking_ && started_) {
+    Reschedule();
+  }
+  observers_.Notify(&Observer::OnMailChanged);
+  return true;
+}
+
+bool MailService::notify() const {
+  return prefs_ && prefs_->GetBoolean(kNotifyPref);
+}
+
+void MailService::SetNotify(bool on) {
+  if (prefs_) {
+    prefs_->SetBoolean(kNotifyPref, on);
+  }
+  observers_.Notify(&Observer::OnMailChanged);
+}
+
+GURL MailService::FeedUrl(int index) const {
+  const std::string path =
+      "mail/u/" + base::NumberToString(index) + "/feed/atom";
+  const std::string base =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          kFeedsForTesting);
+  const GURL testing(base);
+  // only a local server stands in for Gmail
+  if (testing.is_valid() && net::IsLocalhost(testing)) {
+    return testing.Resolve(path);
+  }
+  return GURL("https://mail.google.com/").Resolve(path);
+}
+
+// static
+GURL MailService::InboxUrl(int index) {
+  return GURL("https://mail.google.com/mail/u/" + base::NumberToString(index) +
+              "/#inbox");
+}
+
+void MailService::CheckNow() {
+  if (checking_) {
+    return;
+  }
+  timer_.Stop();
+  checking_ = true;
+  next_.clear();
+  observers_.Notify(&Observer::OnMailChanged);
+  Fetch(0);
+}
+
+void MailService::Fetch(int index) {
+  scoped_refptr<network::SharedURLLoaderFactory> factory =
+      factory_ ? factory_.Run() : nullptr;
+  if (!factory) {
+    Finish("error");
+    return;
+  }
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = FeedUrl(index);
+  request->method = "GET";
+  // as Gmail's own page asks: the profile's sign-in for mail.google.com
+  request->credentials_mode = network::mojom::CredentialsMode::kInclude;
+  request->site_for_cookies = net::SiteForCookies::FromUrl(request->url);
+  request->request_initiator = url::Origin::Create(request->url);
+  request->load_flags = net::LOAD_DISABLE_CACHE;
+  request->headers.SetHeader("Accept", "application/atom+xml");
+  loader_ =
+      network::SimpleURLLoader::Create(std::move(request), kTrafficAnnotation);
+  loader_->SetTimeoutDuration(kTimeout);
+  // Without a sign-in Gmail answers 401: no account there, not a failure.
+  loader_->SetAllowHttpErrorResults(true);
+  loader_->DownloadToString(
+      factory.get(),
+      base::BindOnce(&MailService::OnFetched, weak_factory_.GetWeakPtr(),
+                     index),
+      kMostBytes);
+}
+
+void MailService::OnFetched(int index, std::optional<std::string> body) {
+  const int status = loader_ && loader_->ResponseInfo() &&
+                             loader_->ResponseInfo()->headers
+                         ? loader_->ResponseInfo()->headers->response_code()
+                         : 0;
+  const int net_error = loader_ ? loader_->NetError() : 0;
+  loader_.reset();
+  if (!body || status != 200) {
+    // The first account that is not there ends the look. No account at all:
+    // signed out (401 or a page to sign in), or the network.
+    std::string problem;
+    if (next_.empty()) {
+      problem = status == 401 || status == 302 || status == 403 ? "signed-out"
+                : status == 0 && net_error != 0                 ? "offline"
+                                                                : "error";
+    }
+    Finish(std::move(problem));
+    return;
+  }
+  data_decoder::DataDecoder::ParseXmlIsolated(
+      *body, data_decoder::mojom::XmlParser::WhitespaceBehavior::kIgnore,
+      base::BindOnce(&MailService::OnParsed, weak_factory_.GetWeakPtr(),
+                     index));
+}
+
+void MailService::OnParsed(int index,
+                           data_decoder::DataDecoder::ValueOrError result) {
+  std::optional<MailAccount> account =
+      result.has_value() ? AccountFromFeed(*result, index) : std::nullopt;
+  // Gmail answers an index past the last account with the first one again
+  const bool again = account && std::ranges::any_of(
+                                    next_, [&](const MailAccount& known) {
+                                      return known.email == account->email;
+                                    });
+  if (!account || again) {
+    Finish(!next_.empty() ? std::string() : "signed-out");
+    return;
+  }
+  next_.push_back(std::move(*account));
+  if (index + 1 >= kMostAccounts) {
+    Finish(std::string());
+    return;
+  }
+  Fetch(index + 1);
+}
+
+void MailService::Finish(std::string problem) {
+  checking_ = false;
+  last_check_ = base::Time::Now();
+  problem_ = std::move(problem);
+  // A failed look keeps what the last one found, as it was.
+  if (problem_.empty() || problem_ == "signed-out") {
+    accounts_ = std::move(next_);
+    std::map<std::string, std::set<std::string>> seen;
+    for (const MailAccount& account : accounts_) {
+      std::set<std::string>& known = seen_[account.email];
+      std::vector<MailMessage> fresh;
+      for (const MailMessage& message : account.latest) {
+        if (!known.contains(message.id)) {
+          fresh.push_back(message);
+        }
+        seen[account.email].insert(message.id);
+      }
+      if (first_look_done_ && !fresh.empty() && watched(account.email)) {
+        observers_.Notify(&Observer::OnNewMail, account, fresh);
+      }
+    }
+    // only what is still unread is remembered
+    seen_ = std::move(seen);
+    if (!first_look_done_) {
+      // what was there at the first look is not new
+      first_look_ = base::Time::Now();
+    }
+    first_look_done_ = true;
+    // An account seen for the first time is looked at from now: what it has
+    // is not new, what comes later is, also across restarts.
+    if (prefs_) {
+      base::DictValue looked = prefs_->GetDict(kLookedPref).Clone();
+      bool added = false;
+      for (const MailAccount& account : accounts_) {
+        if (!looked.contains(account.email) && looked.size() < kMostLooked) {
+          looked.Set(account.email,
+                     base::Time::Now().InMillisecondsFSinceUnixEpoch());
+          added = true;
+        }
+      }
+      if (added) {
+        prefs_->SetDict(kLookedPref, std::move(looked));
+      }
+    }
+  }
+  next_.clear();
+  observers_.Notify(&Observer::OnMailChanged);
+  Reschedule();
+}
+
+void MailService::Reschedule() {
+  timer_.Start(FROM_HERE, base::Minutes(interval_minutes()),
+               base::BindOnce(&MailService::CheckNow, base::Unretained(this)));
+}
+
+}  // namespace thoron_mail
