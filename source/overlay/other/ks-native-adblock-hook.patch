+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_OS_CRYPT_ASYNC_BROWSER_THORON_PROFILE_KEY_H_
+#define COMPONENTS_OS_CRYPT_ASYNC_BROWSER_THORON_PROFILE_KEY_H_
+
+#include <stdint.h>
+
+#include <optional>
+#include <vector>
+
+#include "base/component_export.h"
+#include "base/containers/span.h"
+
+namespace os_crypt_async {
+
+// Thoron (ROADMAP P4.9): a portable copy locked with a passphrase keeps its
+// profile key in its own key file (components/thoron_portable_key), not in
+// Local State. The browser marks such a copy as locked before Init(), and
+// gives the key here once the person unlocked it. Init() then makes no key
+// of its own, and the DPAPI key provider gives this key ("v10", the same key
+// the copy's data was encrypted with) instead of reading Local State.
+
+// The copy has a key file: never make or use a key of Local State's.
+COMPONENT_EXPORT(OS_CRYPT_ASYNC) void SetThoronProfileLocked();
+COMPONENT_EXPORT(OS_CRYPT_ASYNC) bool IsThoronProfileLocked();
+
+// The unlocked profile key (32 bytes); kept for the life of the process, as
+// the key read from Local State is in other copies.
+COMPONENT_EXPORT(OS_CRYPT_ASYNC)
+void SetThoronProfileKey(base::span<const uint8_t> key);
+COMPONENT_EXPORT(OS_CRYPT_ASYNC)
+std::optional<std::vector<uint8_t>> GetThoronProfileKey();
+
+// For tests: back to an unlocked, unmarked process.
+COMPONENT_EXPORT(OS_CRYPT_ASYNC) void ResetThoronProfileKeyForTesting();
+
+}  // namespace os_crypt_async
+
+#endif  // COMPONENTS_OS_CRYPT_ASYNC_BROWSER_THORON_PROFILE_KEY_H_
