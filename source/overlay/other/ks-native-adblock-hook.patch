+bool IsPortableCopy() {
+#if BUILDFLAG(IS_WIN)
+  return thoron_update_win::ConfigForThisCopy().kind ==
+         thoron_update::Kind::kPortable;
+#elif BUILDFLAG(IS_LINUX)
+  // The portable package's layout (tools/release/portable_linux.py): the
+  // program in ThoronPortable/Application/<version>/, beside `current`, the
+  // launcher one folder up; a copy installed for one user has the mark
+  // `per-user` there and keeps its profile in ~/.config instead.
+  base::FilePath exe;
+  base::PathService::Get(base::DIR_EXE, &exe);
+  const base::FilePath package = exe.DirName().DirName();
+  return base::PathExists(exe.DirName().AppendASCII("current")) &&
+         base::PathExists(package.AppendASCII("thoron")) &&
+         !base::PathExists(package.AppendASCII("per-user"));
+#else
+  return false;
+#endif
