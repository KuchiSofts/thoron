+TEST_F(ThoronUpdateClientTest, TheBrowserIsToldOnceAVersionIsInstalled) {
+  Publish();
+  std::vector<std::string> told;
+  config_.on_installed = base::BindLambdaForTesting([&](const std::string& version, bool critical) {
+    told.push_back(version + (critical ? " critical" : ""));
+  });
+  auto client = Client();
+  EXPECT_EQ(Look(*client, /*install=*/false).state, State::kAvailable);
+  EXPECT_TRUE(told.empty());
+  EXPECT_EQ(Look(*client, /*install=*/true).state, State::kReadyToRelaunch);
+  EXPECT_EQ(told, (std::vector<std::string>{data::kNewest}));
+  // a look after it tells nothing new
+  EXPECT_EQ(Look(*client, /*install=*/true).state, State::kReadyToRelaunch);
+  EXPECT_EQ(told.size(), 1u);
+}
