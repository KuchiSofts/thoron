@@ -0,0 +1,137 @@
+# Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+import("//testing/libfuzzer/fuzzer_test.gni")
+import("//testing/test.gni")
+
+# Thoron (ROADMAP P3.22): the open windows, tabs and tab groups of another
+# browser's last session, read with Chromium's own session code. Not tied to
+# Windows, so it can be fuzzed on Linux as well.
+source_set("open_tabs") {
+  sources = [
+    "open_tabs.cc",
+    "open_tabs.h",
+  ]
+  deps = [
+    "//base",
+    "//components/sessions:shared",
+    "//components/split_tabs",
+    "//components/tab_groups",
+    "//ui/base",
+    "//ui/gfx",
+    "//url",
+  ]
+}
+
+# Coverage-guided fuzzing of that reading (ROADMAP S.2, I3). Built only with a
+# fuzzing engine (use_libfuzzer).
+# The navigation driver the content layer gives the browser, for the tests
+# and the fuzzer, which link the session code without it.
+source_set("open_tabs_test_driver") {
+  testonly = true
+  sources = [ "open_tabs_test_driver.cc" ]
+  deps = [
+    "//base",
+    "//components/sessions:shared",
+  ]
+}
+
+fuzzer_test("thoron_open_tabs_fuzzer") {
+  sources = [ "open_tabs_fuzzer.cc" ]
+  deps = [
+    ":open_tabs",
+    ":open_tabs_test_driver",
+    "//base",
+    "//base:i18n",
+    "//components/sessions:shared",
+    "//ui/base",
+  ]
+}
+
+group("thoron_open_tabs_all") {
+  testonly = true
+  deps = [ ":open_tabs" ]
+}
+
+if (is_win || is_linux) {
+  # Thoron (ROADMAP P3.14): reads a Chromium-family browser's profile (Thorium,
+  # Chrome, Edge, Brave, Vivaldi, Opera, Chromium) during an import. A small
+  # library with few dependencies (base, sql, crypto, url and the importer
+  # common types) so it can be tested without linking Chromium's giant
+  # unit_tests. Windows and Linux; on Linux the keyring is read over D-Bus.
+  source_set("chromium_family") {
+    sources = [
+      "browser_detection.cc",
+      "browser_detection.h",
+      "chromium_family_import_bridge.h",
+      "chromium_family_reader.cc",
+      "chromium_family_reader.h",
+    ]
+    deps = [
+      ":open_tabs",
+      "//base",
+      "//components/sessions:shared",
+      "//components/user_data_importer/common",
+      "//crypto",
+      "//sql",
+      "//url",
+    ]
+    if (is_win) {
+      sources += [
+        "password_decryptor_win.cc",
+        "password_decryptor_win.h",
+      ]
+    } else {
+      sources += [
+        "password_decryptor_linux.cc",
+        "password_decryptor_linux.h",
+      ]
+      deps += [ "//dbus" ]
+    }
+  }
+
+  source_set("unit_tests") {
+    testonly = true
+    sources = [
+      "chromium_family_reader_unittest.cc",
+      "open_tabs_unittest.cc",
+    ]
+    if (is_win) {
+      sources += [
+        "browser_detection_unittest.cc",
+        "password_decryptor_win_unittest.cc",
+      ]
+    } else {
+      sources += [
+        "browser_detection_linux_unittest.cc",
+        "password_decryptor_linux_unittest.cc",
+      ]
+    }
+    deps = [
+      ":chromium_family",
+      ":open_tabs",
+      ":open_tabs_test_driver",
+      "//base",
+      "//base/test:test_support",
+      "//components/sessions:shared",
+      "//components/tab_groups",
