@@ -0,0 +1,128 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_TOOLBAR_THORON_TOOLBAR_ICONS_H_
+#define CHROME_BROWSER_UI_VIEWS_TOOLBAR_THORON_TOOLBAR_ICONS_H_
+
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/gfx/geometry/point.h"
+#include "ui/gfx/image/image_skia.h"
+
+class PrefService;
+class ToolbarView;
+
+namespace ui {
+class ColorProvider;
+class MouseEvent;
+}  // namespace ui
+
+namespace views {
+class View;
+}
+
+// What Thoron's own icons share (P5.78): Thoron adblock's shield and Thoron
+// M-Notifier's envelope, in the toolbar and in the address bar. Their colours
+// are the browser theme's, their counts are drawn as Chrome draws an
+// extension's badge (in the corner, so the icon stays in view), and in the
+// toolbar a person moves them with the mouse.
+namespace thoron {
+
+// The colours, from the browser's theme: an icon that has something to say
+// (the shield while it blocks, the envelope with new mail) and what is drawn
+// on it; a count's background and its digits.
+struct IconColors {
+  SkColor accent;
+  SkColor on_accent;
+  SkColor badge;
+  SkColor badge_text;
+};
+IconColors ColorsOf(const ui::ColorProvider* provider);
+
+// How much larger than its icon a toolbar button's image is, as an
+// extension's (a 28 px image around a 20 px icon): the count sits in the
+// corner of the image and covers a quarter of the icon at most. The button's
+// insets are smaller by half of this, so the button is as large as the others.
+inline constexpr int kToolbarImageMargin = 8;
+
+// `icon` in the middle of an image `area` px wide and high, with `text` (a
+// count; "" for none) in its bottom right corner as an extension's badge,
+// 14 px high: for the toolbar. A ring around the count is cleared, so it reads
+// on any icon.
+gfx::ImageSkia WithCountBadge(const gfx::ImageSkia& icon,
+                              int area,
+                              const std::string& text,
+                              SkColor background,
+                              SkColor foreground);
+
+// `icon` with `text` (a count; "" for none) right of it, in `color`: for the
+// address bar, whose icons are small (a count over one would hide it). The
+// image is as high as the icon and wider by the count.
+gfx::ImageSkia WithCountBeside(const gfx::ImageSkia& icon,
+                               const std::string& text,
+                               SkColor color);
+
+// The order of Thoron's buttons, left to right, where they are next to each
+// other (the same place in the toolbar or in the address bar): the ids below,
+// kept in the profile ("thoron.toolbar_order", "mail,adblock"). A person
+// changes it by moving a button with the mouse.
+inline constexpr char kToolbarOrderPref[] = "thoron.toolbar_order";
+inline constexpr char kAdblockId[] = "adblock";
+inline constexpr char kMailId[] = "mail";
+std::vector<std::string> ToolbarOrder(const PrefService* prefs);
+void SetToolbarOrder(PrefService* prefs, const std::vector<std::string>& order);
+// True when the envelope is left of the shield.
+bool MailBeforeAdblock(const PrefService* prefs);
+
+// Puts Thoron's buttons of `toolbar` where their settings say (right after
+// the address bar, after the extensions, next to the menu), in their order.
+void ArrangeToolbar(ToolbarView* toolbar);
+
+// One of Thoron's toolbar buttons moved with the mouse: while it is dragged
+// it goes to the place nearest the pointer (one of the three above) and
+// before or after Thoron's other button there, at once, and that is kept (the
+// button's own setting of its place, and the order). A press that became a
+// drag is no click.
+class ToolbarDrag {
+ public:
+  using GetPlace = base::RepeatingCallback<std::string()>;
+  using SetPlace = base::RepeatingCallback<void(const std::string&)>;
+
+  // `button` is one of Thoron's buttons in a ToolbarView, known as `id`;
+  // `get_place` and `set_place` read and write its setting of where it is.
+  ToolbarDrag(views::View* button,
+              const char* id,
+              PrefService* prefs,
+              GetPlace get_place,
+              SetPlace set_place);
+  ToolbarDrag(const ToolbarDrag&) = delete;
+  ToolbarDrag& operator=(const ToolbarDrag&) = delete;
+  ~ToolbarDrag();
+
+  // From the button's mouse handlers. Dragged() is true once the press is a
+  // drag (the button then handles the event itself); Ended() is true when
+  // the press that ends was a drag.
+  void Pressed(const ui::MouseEvent& event);
+  bool Dragged(const ui::MouseEvent& event);
+  bool Ended();
+
+ private:
+  void Place(const ui::MouseEvent& event);
+
+  const raw_ptr<views::View> button_;
+  const std::string id_;
+  const raw_ptr<PrefService> prefs_;
+  const GetPlace get_place_;
+  const SetPlace set_place_;
+  gfx::Point start_;
+  bool pressed_ = false;
+  bool dragging_ = false;
+};
+
+}  // namespace thoron
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TOOLBAR_THORON_TOOLBAR_ICONS_H_
