+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_update/portable_package.h"
+
+#include <array>
+#include <string>
+#include <utility>
+
+#include "base/containers/span.h"
+#include "base/files/file.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "components/thoron_update/package.h"
+#include "crypto/hash.h"
+#include "third_party/zlib/google/zip_reader.h"
+
+namespace thoron_update {
+
+namespace {
+
+// The SHA-256 of a file, read in blocks; empty when it cannot be read.
+std::string Sha256Of(const base::FilePath& path) {
+  base::File file(path, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  if (!file.IsValid()) {
+    return std::string();
+  }
+  crypto::hash::Hasher hasher(crypto::hash::kSha256);
+  std::array<uint8_t, 64 * 1024> block;
+  while (true) {
+    const std::optional<size_t> read = file.ReadAtCurrentPos(block);
+    if (!read) {
+      return std::string();
+    }
+    if (*read == 0) {
+      break;
+    }
+    hasher.Update(base::span(block).first(*read));
+  }
+  std::array<uint8_t, crypto::hash::kSha256Size> digest;
+  hasher.Finish(digest);
+  return base::HexEncodeLower(digest);
+}
+
+// The parts of an entry's path, as the reader made it safe.
+std::vector<std::string> Parts(const base::FilePath& path) {
+  std::vector<std::string> out;
+  for (const base::FilePath::StringType& part : path.GetComponents()) {
+    out.push_back(base::FilePath(part).AsUTF8Unsafe());
+  }
+  return out;
+}
+
+}  // namespace
+
+bool ZipPathWasMadeSafe(const base::FilePath& path) {
+  const std::vector<std::string> parts = Parts(path);
+  for (size_t i = 0; i < parts.size(); ++i) {
+    if (parts[i] == "UP" || parts[i] == "DOT" || (i == 0 && parts[i] == "ROOT")) {
+      return true;
+    }
+  }
+  return false;
+}
+
+namespace {
+
+UnpackResult Abandon(const base::FilePath& staged, UnpackResult result) {
+  base::DeletePathRecursively(staged);
+  return result;
+}
+
+}  // namespace
+
+std::string_view UnpackResultName(UnpackResult result) {
+  switch (result) {
+    case UnpackResult::kDone:
+      return "done";
+    case UnpackResult::kNotAPackage:
+      return "not_a_package";
+    case UnpackResult::kNoSuchVersion:
+      return "no_such_version";
+    case UnpackResult::kUnsafeEntry:
+      return "unsafe_entry";
+    case UnpackResult::kTooLarge:
+      return "too_large";
+    case UnpackResult::kIoError:
+      return "io_error";
+  }
+  return "io_error";
+}
+
+UnpackResult UnpackVersion(const base::FilePath& package,
+                           const BuildVersion& version,
+                           const base::FilePath& staged,
+                           std::vector<VersionFile>* files) {
+  files->clear();
+  if (base::PathExists(staged)) {
+    return UnpackResult::kIoError;
+  }
+  zip::ZipReader reader;
+  if (!reader.Open(package)) {
+    return UnpackResult::kNotAPackage;
+  }
+  const std::string version_name = ToString(version);
+  if (!base::CreateDirectory(staged)) {
+    return UnpackResult::kIoError;
+  }
+  int64_t written = 0;
+  bool any_other_folder = false;
+  while (const zip::ZipReader::Entry* entry = reader.Next()) {
+    if (entry->is_unsafe || entry->is_encrypted || entry->is_symbolic_link ||
+        ZipPathWasMadeSafe(entry->path)) {
+      return Abandon(staged, UnpackResult::kUnsafeEntry);
+    }
+    const std::vector<std::string> parts = Parts(entry->path);
+    if (parts.empty() || parts[0] != kPortableFolder) {
+      any_other_folder = true;
+      continue;
+    }
+    // ThoronPortable/Application/<version>/<the rest>
+    if (parts.size() < 4 || parts[1] != "Application" || parts[2] != version_name) {
+      continue;
+    }
+    std::string inside;
+    base::FilePath target = staged;
+    for (size_t i = 3; i < parts.size(); ++i) {
+      if (parts[i].empty() || parts[i] == "." || parts[i] == "..") {
+        return Abandon(staged, UnpackResult::kUnsafeEntry);
+      }
+      inside += (inside.empty() ? "" : "/") + parts[i];
+      target = target.Append(base::FilePath::FromUTF8Unsafe(parts[i]));
+    }
+    if (entry->is_directory) {
+      if (!base::CreateDirectory(target)) {
+        return Abandon(staged, UnpackResult::kIoError);
+      }
+      continue;
+    }
+    if (files->size() >= kMostUnpackedFiles) {
+      return Abandon(staged, UnpackResult::kTooLarge);
+    }
+    if (!base::CreateDirectory(target.DirName())) {
+      return Abandon(staged, UnpackResult::kIoError);
+    }
+    // One byte more than what is left is enough to tell an entry that is too big.
+    const uint64_t room = static_cast<uint64_t>(kMostUnpackedBytes - written) + 1;
+    bool extracted = false;
+    {
+      // Closed before the file is measured and read.
+      zip::FilePathWriterDelegate writer(target);
+      extracted = reader.ExtractCurrentEntry(&writer, room);
+    }
+    if (!extracted) {
+      return Abandon(staged, base::PathExists(target) && base::GetFileSize(target).value_or(0) >=
+                                                             static_cast<int64_t>(room)
+                                 ? UnpackResult::kTooLarge
+                                 : UnpackResult::kIoError);
+    }
+    const std::optional<int64_t> size = base::GetFileSize(target);
+    if (!size || !MakeRunnableIfProgram(target)) {
+      return Abandon(staged, UnpackResult::kIoError);
+    }
+    written += *size;
+    if (written > kMostUnpackedBytes) {
+      return Abandon(staged, UnpackResult::kTooLarge);
+    }
+    const std::string sha256 = Sha256Of(target);
+    if (sha256.empty()) {
+      return Abandon(staged, UnpackResult::kIoError);
+    }
+    files->push_back({inside, *size, sha256});
+  }
+  if (!reader.ok() || any_other_folder) {
+    files->clear();
+    return Abandon(staged, any_other_folder ? UnpackResult::kNotAPackage : UnpackResult::kIoError);
+  }
+  if (files->empty()) {
+    return Abandon(staged, UnpackResult::kNoSuchVersion);
+  }
+  return UnpackResult::kDone;
+}
+
+bool ReplaceLauncher(const base::FilePath& package, const base::FilePath& launcher) {
+  zip::ZipReader reader;
+  if (!reader.Open(package)) {
+    return false;
+  }
+  while (const zip::ZipReader::Entry* entry = reader.Next()) {
+    const std::vector<std::string> parts = Parts(entry->path);
+    if (entry->is_directory || entry->is_unsafe || entry->is_encrypted ||
+        entry->is_symbolic_link || ZipPathWasMadeSafe(entry->path) || parts.size() != 2 ||
+        parts[0] != kPortableFolder ||
+        parts[1] != "Thoron.exe") {
+      continue;
+    }
+    const base::FilePath beside = launcher.AddExtensionASCII("new");
+    base::DeleteFile(beside);
+    bool extracted = false;
+    {
+      // Closed before the file is compared and moved.
+      zip::FilePathWriterDelegate writer(beside);
+      // A launcher is small; anything over 16 MiB is not one.
+      extracted = reader.ExtractCurrentEntry(&writer, 16 * 1024 * 1024);
+    }
+    if (!extracted) {
+      base::DeleteFile(beside);
+      return false;
+    }
+    if (base::PathExists(launcher) && Sha256Of(beside) == Sha256Of(launcher)) {
+      base::DeleteFile(beside);
+      return true;
+    }
+    if (!base::ReplaceFile(beside, launcher, nullptr)) {
+      base::DeleteFile(beside);
+      return false;
+    }
+    return true;
+  }
+  return false;
+}
+
+}  // namespace thoron_update
