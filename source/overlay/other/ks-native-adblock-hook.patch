+TEST_F(ChromiumFamilyReaderTest, ImportsCookiesV24WithHostHashPrefix) {
+  std::array<uint8_t, 32> raw_key = MakeKey();
+  MakeLocalState(raw_key);
+
+  const std::string host = "example.com";
+  const std::string host_hash = crypto::SHA256HashString(host);
+  const base::Time future = base::Time::Now() + base::Days(30);
+  const base::Time past = base::Time::Now() - base::Days(1);
+
+  std::vector<CookieRow> rows;
+  // v10 cookie, meta version 24: plaintext is SHA-256(host_key) + the value.
+  rows.push_back({host, "sid",
+                  /*value=*/"",
+                  MakeV10Value(raw_key, host_hash + "secret-session"),
+                  /*is_persistent=*/true, /*has_expires=*/true, future});
+  // v20 app-bound cookie: skipped and counted, never read.
+  rows.push_back({host, "appbound", "", {'v', '2', '0', 1, 2, 3},
+                  true, true, future});
+  // Expired cookie: not imported, not counted.
+  rows.push_back({host, "stale", "",
+                  MakeV10Value(raw_key, host_hash + "old"), true, true, past});
+  // Session cookie (not persistent): not imported, not counted.
+  rows.push_back({host, "temp", "",
+                  MakeV10Value(raw_key, host_hash + "temp"), false, false,
+                  base::Time()});
+  // Plain-value cookie (no encrypted_value): imported as-is.
+  rows.push_back({host, "plain", "plainvalue", {}, true, true, future});
+
+  MakeCookies(profile_.Append(FILE_PATH_LITERAL("Network")).Append(FILE_PATH_LITERAL("Cookies")), /*version=*/24,
+              rows);
+
+  FakeBridge bridge;
+  ChromiumFamilyReader reader(Options());
+  ChromiumFamilyReader::Stats stats = reader.Import(user_data_importer::COOKIES,
+                                                    &bridge);
+
+  EXPECT_EQ(2, stats.cookies);
+#if BUILDFLAG(IS_WIN)
+  EXPECT_EQ(1, stats.cookies_skipped_app_bound);
+  EXPECT_EQ(0, stats.cookies_failed);
+#else
+  EXPECT_EQ(0, stats.cookies_skipped_app_bound);
+  EXPECT_EQ(1, stats.cookies_failed);
+#endif
+  ASSERT_EQ(2u, bridge.cookies.size());
+  bool saw_sid = false;
+  bool saw_plain = false;
+  for (const auto& c : bridge.cookies) {
+    if (c.name == "sid") {
+      // The per-host hash prefix is stripped from the value.
+      EXPECT_EQ("secret-session", c.value);
+      saw_sid = true;
+    } else if (c.name == "plain") {
+      EXPECT_EQ("plainvalue", c.value);
+      saw_plain = true;
+    }
+  }
+  EXPECT_TRUE(saw_sid);
+  EXPECT_TRUE(saw_plain);
+}
