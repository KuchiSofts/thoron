+class MailHandler : public content::WebUIMessageHandler,
+                    public thoron_mail::MailService::Observer {
+ public:
+  explicit MailHandler(ThoronMailMenuUI* controller)
+      : controller_(controller) {}
+  MailHandler(const MailHandler&) = delete;
+  MailHandler& operator=(const MailHandler&) = delete;
+  ~MailHandler() override = default;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override {
+    Register("getMailState", &MailHandler::GetState);
+    Register("checkNow", &MailHandler::CheckNow);
+    Register("openInbox", &MailHandler::OpenInbox);
+    Register("openLink", &MailHandler::OpenLink);
+    Register("signIn", &MailHandler::SignIn);
+    Register("addAccount", &MailHandler::AddAccount);
+    Register("setNotify", &MailHandler::SetNotify);
+    Register("setInterval", &MailHandler::SetInterval);
+    Register("setChoice", &MailHandler::SetChoice);
+    Register("setWatched", &MailHandler::SetWatched);
+    Register("menuReady", &MailHandler::MenuReady);
+    Register("closeMenu", &MailHandler::CloseMenu);
+  }
+  void OnJavascriptAllowed() override {
+    if (!observation_.IsObserving()) {
+      observation_.Observe(&Center().service());
+    }
+  }
+  void OnJavascriptDisallowed() override { observation_.Reset(); }
+
+  // thoron_mail::MailService::Observer:
+  void OnMailChanged() override {
+    if (IsJavascriptAllowed()) {
+      FireWebUIListener("mail-changed");
+    }
+  }
+
+ private:
+  using Method = void (MailHandler::*)(const base::ListValue&);
+  void Register(std::string_view message, Method method) {
+    web_ui()->RegisterMessageCallback(
+        message, base::BindRepeating(method, base::Unretained(this)));
+  }
+
+  ThoronMailCenter& Center() {
+    return ThoronMailCenter::For(Profile::FromWebUI(web_ui()));
+  }
+
+  void GetState(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.empty()) {
+      return;
+    }
+    const thoron_mail::MailService& service = Center().service();
+    base::ListValue accounts;
+    for (const thoron_mail::MailAccount& account : service.accounts()) {
+      base::ListValue latest;
+      for (const thoron_mail::MailMessage& message : account.latest) {
+        latest.Append(base::DictValue()
+                          .Set("subject", message.subject)
+                          .Set("from", message.from_name)
+                          .Set("fromEmail", message.from_email)
+                          .Set("snippet", message.snippet)
+                          .Set("link", message.link)
+                          .Set("isNew", service.is_new(account, message))
+                          .Set("issued", JsTime(message.issued)));
+      }
+      accounts.Append(base::DictValue()
+                          .Set("index", account.index)
+                          .Set("email", account.email)
+                          .Set("unread", account.unread)
+                          .Set("new", service.new_count(account))
+                          .Set("watched", service.watched(account.email))
+                          .Set("latest", std::move(latest)));
+    }
+    base::ListValue intervals;
+    for (int minutes : thoron_mail::MailService::kIntervals) {
+      intervals.Append(minutes);
+    }
+    base::DictValue choices;
+    for (const char* name : {"sound", "count", "open", "place",
+                             "toolbar-position", "address-position"}) {
+      choices.Set(name, service.Choice(name));
+    }
+    ResolveJavascriptCallback(
+        args[0], base::DictValue()
+                     .Set("accounts", std::move(accounts))
+                     .Set("choices", std::move(choices))
+                     .Set("totalNew", service.total_new())
+                     .Set("total", service.total_unread())
+                     .Set("checking", service.checking())
+                     .Set("lastCheck", JsTime(service.last_check()))
+                     .Set("problem", service.problem())
+                     .Set("notify", service.notify())
+                     .Set("interval", service.interval_minutes())
+                     .Set("intervals", std::move(intervals)));
+  }
+
+  void CheckNow(const base::ListValue& args) { Center().service().CheckNow(); }
+
+  // The account's inbox (its address or "Open inbox" pressed): its new mail
+  // is counted from now (P5.76).
+  void OpenInbox(const base::ListValue& args) {
+    if (args.empty() || !args[0].is_int()) {
+      return;
+    }
+    const int index = args[0].GetInt();
+    Center().OpenGmail(thoron_mail::MailService::InboxUrl(index), index);
+    CloseMenu(args);
+  }
+
+  void SetChoice(const base::ListValue& args) {
+    if (args.size() >= 2 && args[0].is_string() && args[1].is_string()) {
+      Center().service().SetChoice(args[0].GetString(), args[1].GetString());
+    }
+  }
+
+  void SetWatched(const base::ListValue& args) {
+    if (args.size() >= 2 && args[0].is_string() && args[1].is_bool()) {
+      Center().service().SetWatched(args[0].GetString(), args[1].GetBool());
+    }
+  }
+
+  // a message: its link (Gmail's only), and the account it is in
+  void OpenLink(const base::ListValue& args) {
+    if (args.size() < 2 || !args[0].is_string() || !args[1].is_int()) {
+      return;
+    }
+    const std::string link = thoron_mail::GmailLink(args[0].GetString());
+    Center().OpenGmail(
+        link.empty() ? thoron_mail::MailService::InboxUrl(args[1].GetInt())
+                     : GURL(link),
+        args[1].GetInt());
+    CloseMenu(args);
+  }
+
+  void SignIn(const base::ListValue& args) {
+    Center().OpenSignIn(/*add=*/false);
+    CloseMenu(args);
+  }
+
+  void AddAccount(const base::ListValue& args) {
+    Center().OpenSignIn(/*add=*/true);
+    CloseMenu(args);
+  }
+
+  void SetNotify(const base::ListValue& args) {
+    if (!args.empty() && args[0].is_bool()) {
+      Center().service().SetNotify(args[0].GetBool());
+    }
+  }
+
+  void SetInterval(const base::ListValue& args) {
+    if (!args.empty() && args[0].is_int()) {
+      Center().service().SetInterval(args[0].GetInt());
+    }
+  }
+
+  void MenuReady(const base::ListValue& args) {
+    controller_->set_ready();
+    if (auto embedder = controller_->embedder()) {
+      embedder->ShowUI();
+    }
+  }
+
+  void CloseMenu(const base::ListValue& args) {
+    if (auto embedder = controller_->embedder()) {
+      embedder->CloseUI();
+    }
+  }
+
+  const raw_ptr<ThoronMailMenuUI> controller_;
+  base::ScopedObservation<thoron_mail::MailService,
+                          thoron_mail::MailService::Observer>
+      observation_{this};
+};
+
+}  // namespace
