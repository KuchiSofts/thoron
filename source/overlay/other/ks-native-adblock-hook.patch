+bool ThoronMailMenuUIConfig::ShouldAutoResizeHost() {
+  return true;
+}
+
+ThoronMailMenuUI::ThoronMailMenuUI(content::WebUI* web_ui)
+    : TopChromeWebUIController(web_ui, /*enable_chrome_send=*/true) {
+  content::URLDataSource::Add(Profile::FromWebUI(web_ui),
+                              std::make_unique<MailDataSource>());
+  web_ui->AddMessageHandler(std::make_unique<MailHandler>(this));
+}
+
+ThoronMailMenuUI::~ThoronMailMenuUI() = default;
+
+bool ThoronMailMenuUI::TellShown() {
+  if (!ready_) {
+    return false;
+  }
+  const base::Value event("menu-shown");
+  web_ui()->CallJavascriptFunctionUnsafe("cr.webUIListenerCallback", event);
+  return true;
+}
