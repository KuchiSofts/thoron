+section{border:1px solid color-mix(in srgb,currentColor 20%,transparent);border-radius:12px;
+padding:18px 22px;margin:0 0 16px}p{margin:0 0 12px}.note{opacity:.8;font-size:14px}
+label{display:block;margin:10px 0 4px}input[type=password],input[type=text]{font:inherit;width:100%;
+box-sizing:border-box;padding:6px 10px;border-radius:8px;border:1px solid color-mix(in srgb,currentColor 35%,transparent);
+background:transparent;color:inherit}label.check{display:flex;gap:8px;align-items:flex-start}
+button{font:inherit;font-weight:600;padding:7px 18px;border-radius:18px;border:0;background:#0f8b8d;
+color:#fff;cursor:pointer;margin-top:12px}button.quiet{background:transparent;color:inherit;
+border:1px solid color-mix(in srgb,currentColor 35%,transparent)}button:disabled{opacity:.5;cursor:default}
+#problem{color:#c62828;font-weight:600}#message{font-weight:600}
+.key{font-family:ui-monospace,Consolas,monospace;font-size:20px;letter-spacing:1px;padding:10px 0}
+</style></head><body><h1>Portable copy: passphrase</h1>
+<p id="problem" role="alert"></p><p id="message" role="status"></p>
+<section id="not-portable" hidden><p>This page is for a portable copy of Thoron. An installed Thoron keeps
+saved passwords and sign-ins locked by Windows for your account on this PC.</p></section>
+<section id="unlocked" hidden><h2>Lock this copy with a passphrase</h2>
+<p>Today this copy's saved passwords and sign-ins (cookies) open only on this PC and this Windows
+account. With a passphrase they open on any PC once you type it, and stay locked for anyone else.</p>
+<p class="note">Only passwords and cookies are locked. Bookmarks, history, open tabs and what sites keep in
+their own storage stay readable to whoever holds the drive. If you forget the passphrase and have no
+recovery key, the passwords and sign-ins cannot be opened again by anyone.</p>
+<div id="form"><label for="pass">Passphrase (at least 12 characters; a few words are easy to type)</label>
+<input id="pass" type="password" autocomplete="new-password">
+<label for="repeat">The same passphrase again</label><input id="repeat" type="password" autocomplete="new-password">
+<label class="check"><input id="with-recovery" type="checkbox" checked> Make a recovery key to write down
+(recommended)</label><label class="check remember"><input id="remember" type="checkbox"> Remember this PC for
+this Windows account (no passphrase here)</label><button id="next">Next</button></div>
+<div id="confirm" hidden><p>Your recovery key. Write it down and keep it apart from the drive: it opens this
+copy without the passphrase.</p><p class="key" id="recovery-key"></p>
+<label for="last-group">To confirm, type its last group of four</label><input id="last-group" type="text"
+autocomplete="off" spellcheck="false"><button id="lock">Lock this copy</button>
+<button id="back" class="quiet">Back</button></div></section>
+<section id="locked" hidden><h2>This copy is locked with a passphrase</h2>
+<p id="pc-state"></p><button id="remember-pc" class="quiet">Remember this PC</button>
+<button id="forget-pc" class="quiet">Forget this PC</button><p id="recovery-state" class="note"></p>
+<div id="shown-key" hidden><p class="key" id="new-key"></p></div>
+<h2 style="margin-top:20px">Change the passphrase</h2><label for="current">Current passphrase</label>
+<input id="current" type="password" autocomplete="current-password"><label for="fresh">New passphrase</label>
+<input id="fresh" type="password" autocomplete="new-password"><label for="fresh-repeat">The new passphrase
+again</label><input id="fresh-repeat" type="password" autocomplete="new-password">
+<button id="change">Change the passphrase</button>
+<h2 style="margin-top:20px">Recovery key, or no lock</h2><label for="check-pass">Passphrase</label>
+<input id="check-pass" type="password" autocomplete="current-password">
+<button id="new-recovery" class="quiet">Make a new recovery key</button>
+<button id="remove" class="quiet">Remove the lock</button><p class="note">Without the lock, this copy's
+passwords and sign-ins open only on this PC and this Windows account, as an installed Thoron's do.</p>
+</section><script src="portable.js"></script></body></html>)html";
+}
+
+constexpr char kScript[] = R"js(
+const $ = (id) => document.getElementById(id);
+let busy = false;
+function setBusy(on) {
+  busy = on;
+  document.querySelectorAll('button').forEach((b) => b.disabled = on);
+}
+function clear(...ids) { ids.forEach((id) => $(id).value = ''); }
+window.thoronPortableShow = (state) => {
+  setBusy(false);
+  $('problem').textContent = state.problem || '';
+  $('message').textContent = state.message || '';
+  $('not-portable').hidden = state.portable;
+  $('unlocked').hidden = !state.portable || state.locked;
+  $('locked').hidden = !state.portable || !state.locked;
+  document.querySelectorAll('.remember').forEach((e) => e.hidden = !state.canRemember);
+  if (state.step === 'confirm') {
+    $('form').hidden = true;
+    $('confirm').hidden = false;
+    $('recovery-key').textContent = state.recovery || '';
+    $('recovery-key').hidden = !state.recovery;
+    $('last-group').parentElement.querySelector('label[for=last-group]').hidden = !state.recovery;
+    $('last-group').hidden = !state.recovery;
+    $('last-group').focus();
+  } else {
+    $('form').hidden = false;
+    $('confirm').hidden = true;
+  }
+  if (state.locked) {
+    $('pc-state').textContent = state.remembered
+        ? 'This PC is remembered for this Windows account: the copy opens here without the passphrase.'
+        : 'This copy asks for its passphrase on this PC.';
+    $('remember-pc').hidden = state.remembered || !state.canRemember;
+    $('forget-pc').hidden = !state.remembered;
+    $('recovery-state').textContent = state.hasRecovery
+        ? 'A recovery key also opens this copy.'
+        : 'No recovery key opens this copy: only the passphrase does.';
+  }
+  $('shown-key').hidden = !state.recovery || !state.locked;
+  $('new-key').textContent = state.locked ? (state.recovery || '') : '';
+};
+function send(name, ...args) {
+  if (busy) return;
+  setBusy(true);
+  $('problem').textContent = '';
+  $('message').textContent = 'Working...';
+  chrome.send(name, args);
+}
+$('next').addEventListener('click', () =>
+    send('prepareLock', $('pass').value, $('repeat').value, $('with-recovery').checked));
+$('back').addEventListener('click', () => { clear('last-group'); send('getState'); });
+$('lock').addEventListener('click', () => {
+  send('lock', $('pass').value, $('remember').checked, $('last-group').value);
+});
+$('change').addEventListener('click', () => {
+  send('changePassphrase', $('current').value, $('fresh').value, $('fresh-repeat').value);
+  clear('current', 'fresh', 'fresh-repeat');
+});
+$('new-recovery').addEventListener('click', () => {
+  send('newRecoveryKey', $('check-pass').value);
+  clear('check-pass');
+});
+$('remove').addEventListener('click', () => {
+  send('removeLock', $('check-pass').value);
+  clear('check-pass');
+});
+$('remember-pc').addEventListener('click', () => send('rememberThisPc'));
+$('forget-pc').addEventListener('click', () => send('forgetThisPc'));
+window.thoronPortableLocked = () => clear('pass', 'repeat', 'last-group');
+send('getState');
+)js";
+
+class ThoronPortableDataSource : public content::URLDataSource {
+ public:
+  ThoronPortableDataSource() = default;
+  ThoronPortableDataSource(const ThoronPortableDataSource&) = delete;
+  ThoronPortableDataSource& operator=(const ThoronPortableDataSource&) =
+      delete;
+
+  // content::URLDataSource:
+  std::string GetSource() override { return kThoronPortableHost; }
+  std::string GetMimeType(const GURL& url) override {
+    return url.path() == kScriptPath ? "text/javascript" : "text/html";
+  }
+  void StartDataRequest(const GURL& url,
+                        const content::WebContents::Getter& wc_getter,
+                        GotDataCallback callback) override {
+    std::move(callback).Run(base::MakeRefCounted<base::RefCountedString>(
+        ForThisSystem(url.path() == kScriptPath ? std::string(kScript) : Page())));
+  }
+};
+
+class ThoronPortableHandler : public content::WebUIMessageHandler {
+ public:
+  ThoronPortableHandler() : folder_(UserDataFolder()) {}
+  ThoronPortableHandler(const ThoronPortableHandler&) = delete;
+  ThoronPortableHandler& operator=(const ThoronPortableHandler&) = delete;
+  ~ThoronPortableHandler() override = default;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override {
+    Register("getState", &ThoronPortableHandler::GetState);
+    Register("prepareLock", &ThoronPortableHandler::PrepareLock);
+    Register("lock", &ThoronPortableHandler::LockCopy);
+    Register("changePassphrase", &ThoronPortableHandler::Change);
+    Register("newRecoveryKey", &ThoronPortableHandler::NewRecoveryKey);
+    Register("rememberThisPc", &ThoronPortableHandler::Remember);
+    Register("forgetThisPc", &ThoronPortableHandler::Forget);
+    Register("removeLock", &ThoronPortableHandler::RemoveLock);
+  }
+
+ private:
+  using Handler = void (ThoronPortableHandler::*)(const base::ListValue&);
+
+  void Register(const char* name, Handler handler) {
+    web_ui()->RegisterMessageCallback(
+        name, base::BindRepeating(handler, weak_factory_.GetWeakPtr()));
+  }
+
+  // Runs `task` away from the UI thread (it reads and writes files and
+  // derives keys), then shows its result.
+  void Run(base::OnceCallback<Result()> task) {
+    tasks_->PostTaskAndReplyWithResult(
+        FROM_HERE,
+        std::move(task),
+        base::BindOnce(&ThoronPortableHandler::Show,
+                       weak_factory_.GetWeakPtr()));
+  }
+
+  void Show(Result result) {
+    if (!IsJavascriptAllowed()) {
+      return;
+    }
+    base::DictValue state;
+    state.Set("portable", portable_);
+    state.Set("locked", result.locked);
+    state.Set("remembered", result.remembered);
+    state.Set("canRemember", result.can_remember);
+    state.Set("hasRecovery", result.has_recovery);
+    state.Set("problem", result.problem);
+    state.Set("message", result.message);
+    state.Set("recovery", result.recovery);
+    CallJavascriptFunction("thoronPortableShow", base::Value(std::move(state)));
+  }
+
+  void ShowProblem(std::string problem) {
+    Result result;
+    result.problem = std::move(problem);
+    Run(base::BindOnce(
+        [](base::FilePath folder, std::string problem) {
+          return WithState(folder, problem, "");
+        },
+        folder_, result.problem));
+  }
+
+  bool Ready(const base::ListValue& args, size_t count) {
+    AllowJavascript();
+    if (!portable_) {
+      Run(base::BindOnce(&ReadState, folder_));
+      return false;
+    }
+    if (args.size() != count) {
+      ShowProblem("Thoron did not understand the page. Reload it.");
+      return false;
+    }
+    return true;
+  }
+
+  void GetState(const base::ListValue& args) {
+    AllowJavascript();
+    pending_recovery_.reset();
+    Run(base::BindOnce(&ReadState, folder_));
+  }
+
+  // Locking, first step: the passphrase is checked and the recovery key made
+  // and shown; nothing is written yet.
+  void PrepareLock(const base::ListValue& args) {
+    if (!Ready(args, 3)) {
+      return;
+    }
+    if (!args[0].is_string() || !args[1].is_string() ||
+        args[0].GetString() != args[1].GetString()) {
+      ShowProblem("The two passphrases are not the same.");
+      return;
+    }
+    if (!PassphraseOf(args[0])) {
+      ShowProblem("A passphrase needs at least 12 characters.");
+      return;
+    }
+    pending_recovery_.reset();
+    if (args[2].is_bool() && args[2].GetBool()) {
+      pending_recovery_ = tpk::NewRecoveryKey();
+    }
+    ShowConfirm(std::string());
+  }
+
+  // The confirmation step: the recovery key to write down (if one is made),
+  // and `problem`.
+  void ShowConfirm(const std::string& problem) {
+    base::DictValue state;
+    state.Set("portable", true);
+    state.Set("locked", false);
+    state.Set("canRemember", tpk::CreateOsKeyStore()->IsAvailable());
+    state.Set("step", "confirm");
+    state.Set("problem", problem);
+    state.Set("recovery", pending_recovery_
+                              ? tpk::FormatRecoveryKey(*pending_recovery_)
+                              : std::string());
+    CallJavascriptFunction("thoronPortableShow", base::Value(std::move(state)));
+  }
+
+  // Locking, second step: the recovery key confirmed, the key file written and
+  // checked, then Local State gives up its copy of the key.
+  void LockCopy(const base::ListValue& args) {
+    if (!Ready(args, 3)) {
+      return;
+    }
+    if (pending_recovery_) {
+      const std::string shown = tpk::FormatRecoveryKey(*pending_recovery_);
+      std::string typed;
+      base::RemoveChars(args[2].is_string() ? args[2].GetString() : "", " -",
+                        &typed);
+      if (base::ToUpperASCII(typed) != shown.substr(shown.size() - 4)) {
+        ShowConfirm(
+            "That is not the last group of the recovery key shown here.");
+        return;
+      }
+    }
+    std::optional<tpk::SecretBytes> passphrase = PassphraseOf(args[0]);
+    if (!passphrase) {
+      ShowProblem("A passphrase needs at least 12 characters.");
+      return;
+    }
+    PrefService* local_state = g_browser_process->local_state();
+#if BUILDFLAG(IS_LINUX)
+    // Linux keeps no key of its own per copy: the lock gives the copy a new
+    // one, and the next start encrypts its passwords and cookies again with it
+    // (unlock_linux.cc; the owner's decision of 2026-11-21).
+    // A copy whose lock was removed before takes its former key again (the
+    // values still under it stay readable; unlock_linux.h, kFormerKeyPref).
+    std::vector<uint8_t> fresh(32);
+    std::string former;
+    if (base::Base64Decode(local_state->GetString(kFormerKeyPref), &former) &&
+        former.size() == fresh.size()) {
+      base::span(fresh).copy_from(base::as_byte_span(former));
+    } else {
+      crypto::RandBytes(fresh);
+    }
+    tpk::WipeString(former);
+    std::optional<tpk::SecretBytes> key(std::in_place, fresh);
+    tpk::Wipe(fresh);
+#else
+    std::optional<tpk::SecretBytes> key = tpk::UnprotectLocalStateKey(
+        local_state->GetString(tpk::kLocalStateKeyPref));
+#endif
+    if (!key) {
+      ShowProblem(
+          "Thoron cannot read this copy's key on this PC, so it cannot lock "
+          "it here.");
+      return;
+    }
+    tasks_->PostTaskAndReplyWithResult(
+        FROM_HERE,
+        base::BindOnce(&Lock, folder_, std::move(*key), std::move(*passphrase),
+                       std::exchange(pending_recovery_, std::nullopt),
+                       args[1].is_bool() && args[1].GetBool()),
+        base::BindOnce(&ThoronPortableHandler::OnLocked,
+                       weak_factory_.GetWeakPtr()));
+  }
+
+  void OnLocked(Result result) {
+#if BUILDFLAG(IS_LINUX)
+    if (result.problem.empty() && result.locked) {
+      PrefService* local_state = g_browser_process->local_state();
+      local_state->SetBoolean(kLockedPref, true);
+      local_state->SetBoolean("thoron_portable.reencrypt_pending", true);
+      // the key is in the key file now, locked: never readable beside it
+      local_state->ClearPref(kFormerKeyPref);
+      local_state->CommitPendingWrite();
+      result.message =
+          "This copy is locked with your passphrase. Close Thoron and start it "
+          "again: it asks for the passphrase, then encrypts this copy's saved "
+          "passwords and cookies with the copy's new key (a checked copy of "
+          "each database is made first, and removed once every value reads "
+          "back).";
+      if (IsJavascriptAllowed()) {
+        CallJavascriptFunction("thoronPortableLocked");
+      }
+    }
+    Show(std::move(result));
+    return;
+#else
+    if (result.problem.empty() && result.locked) {
+      PrefService* local_state = g_browser_process->local_state();
+      std::optional<tpk::SecretBytes> key = tpk::UnprotectLocalStateKey(
+          local_state->GetString(tpk::kLocalStateKeyPref));
+      if (key) {
+        os_crypt_async::SetThoronProfileKey(key->span());
+      }
+      local_state->SetBoolean(kLockedPref, true);
+      local_state->ClearPref(tpk::kLocalStateKeyPref);
+      local_state->CommitPendingWrite();
+      if (IsJavascriptAllowed()) {
+        CallJavascriptFunction("thoronPortableLocked");
+      }
+    }
+    Show(std::move(result));
+#endif
+  }
+
+  void Change(const base::ListValue& args) {
+    if (!Ready(args, 3)) {
+      return;
+    }
+    std::optional<tpk::SecretBytes> current = PassphraseOf(args[0]);
+    if (!args[1].is_string() || !args[2].is_string() ||
+        args[1].GetString() != args[2].GetString()) {
+      ShowProblem("The two new passphrases are not the same.");
+      return;
+    }
+    std::optional<tpk::SecretBytes> fresh = PassphraseOf(args[1]);
+    if (!fresh) {
+      ShowProblem("A passphrase needs at least 12 characters.");
+      return;
+    }
+    if (!current) {
+      ShowProblem(kWrongPassphrase);
+      return;
+    }
+    Run(base::BindOnce(&ChangePassphrase, folder_, std::move(*current),
+                       std::move(*fresh)));
+  }
+
+  void NewRecoveryKey(const base::ListValue& args) {
+    if (!Ready(args, 1)) {
+      return;
+    }
+    std::optional<tpk::SecretBytes> passphrase = PassphraseOf(args[0]);
+    if (!passphrase) {
+      ShowProblem(kWrongPassphrase);
+      return;
+    }
+    Run(base::BindOnce(&NewRecovery, folder_, std::move(*passphrase)));
+  }
+
+  void Remember(const base::ListValue& args) { RememberOrForgetHere(args, true); }
+  void Forget(const base::ListValue& args) { RememberOrForgetHere(args, false); }
+
+  void RememberOrForgetHere(const base::ListValue& args, bool remember) {
+    if (!Ready(args, 0)) {
+      return;
+    }
+    std::optional<std::vector<uint8_t>> key =
+        os_crypt_async::GetThoronProfileKey();
+    if (!key) {
+      ShowProblem("Restart Thoron first: this copy was not opened with its "
+                  "passphrase.");
+      return;
+    }
+    tpk::SecretBytes secret(*key);
+    tpk::Wipe(*key);
+    Run(base::BindOnce(&RememberOrForget, folder_, std::move(secret),
+                       remember));
+  }
+
+  void RemoveLock(const base::ListValue& args) {
+    if (!Ready(args, 1)) {
+      return;
+    }
+    std::optional<tpk::SecretBytes> passphrase = PassphraseOf(args[0]);
+    if (!passphrase) {
+      ShowProblem(kWrongPassphrase);
+      return;
+    }
+    tasks_->PostTaskAndReplyWithResult(
+        FROM_HERE,
+        base::BindOnce(&OpenForRemoval, folder_, std::move(*passphrase)),
+#if BUILDFLAG(IS_LINUX)
+        base::BindOnce(&ThoronPortableHandler::OnOpenedForRemovalLinux,
+                       weak_factory_.GetWeakPtr()));
+#else
+        base::BindOnce(&ThoronPortableHandler::OnOpenedForRemoval,
+                       weak_factory_.GetWeakPtr()));
+#endif
+  }
+
+#if BUILDFLAG(IS_LINUX)
+  // On Linux the copy's values are under its own key while the browser runs,
+  // so they go back to Chromium's key at the next start, before any profile
+  // opens (unlock_linux.cc); the key file goes only once every value is back.
+  void OnOpenedForRemovalLinux(Result result) {
+    if (!result.key) {
+      Show(std::move(result));
+      return;
+    }
+    result.key.reset();
+    PrefService* local_state = g_browser_process->local_state();
+    local_state->SetBoolean(kRemovePendingPref, true);
+    local_state->SetString(kRemoveProofPref, std::exchange(result.proof, std::string()));
+    local_state->CommitPendingWrite();
+    result.message =
+        "The lock goes at the next start. Close Thoron and start it again, "
+        "and type the passphrase once more: Thoron then puts this copy's saved "
+        "passwords, cookies and cards back under Chromium's own key for Linux, "
+        "which anyone can use, as an unlocked copy has them, checks each one, "
+        "and removes the key file.";
+    Show(std::move(result));
+  }
+#endif
+
+  // The key goes back into Local State first; only once that is written is
+  // the key file removed, so the key is never in neither.
+  void OnOpenedForRemoval(Result result) {
+    if (!result.key) {
+      Show(std::move(result));
+      return;
+    }
+    std::optional<std::string> stored = tpk::ProtectLocalStateKey(*result.key);
+    if (!stored) {
+      result.key.reset();
+      result.problem = "Windows did not keep the key for this account, so the "
+                       "lock stays.";
+      Show(std::move(result));
+      return;
+    }
+    PrefService* local_state = g_browser_process->local_state();
+    local_state->SetString(tpk::kLocalStateKeyPref, *stored);
+    local_state->SetBoolean(kLockedPref, false);
+    local_state->CommitPendingWrite(base::BindOnce(
+        &ThoronPortableHandler::Run, weak_factory_.GetWeakPtr(),
+        base::BindOnce(&RemoveFile, folder_)));
+  }
+
+  const base::FilePath folder_;
+  const bool portable_ = IsPortableCopy();
+  // One sequence for the work away from the UI thread, the same for every
+  // tab of the page, so two tabs never read and write the key file at once;
+  // the desktop keyring's D-Bus calls on Linux need one (os_key_store_linux.cc).
+  const scoped_refptr<base::SequencedTaskRunner> tasks_ = KeyFileTasks();
+  std::optional<tpk::SecretBytes> pending_recovery_;
+  base::WeakPtrFactory<ThoronPortableHandler> weak_factory_{this};
+};
+
+}  // namespace
+
+ThoronPortableUIConfig::ThoronPortableUIConfig()
+    : DefaultWebUIConfig(content::kChromeUIScheme, kThoronPortableHost) {}
+
+ThoronPortableUI::ThoronPortableUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  content::URLDataSource::Add(Profile::FromWebUI(web_ui),
+                              std::make_unique<ThoronPortableDataSource>());
+  web_ui->AddMessageHandler(std::make_unique<ThoronPortableHandler>());
+}
+
+ThoronPortableUI::~ThoronPortableUI() = default;
