+#include "ui/views/widget/widget.h"
+#include "ui/views/widget/widget_observer.h"
+
+namespace {
+
+// The badge as on Thoron adblock's shield: red, white text.
+constexpr SkColor kBadgeBackground = SkColorSetRGB(0xD9, 0x30, 0x25);
+constexpr SkColor kBadgeText = SK_ColorWHITE;
+// Thoron's teal: the envelope while there is mail to count.
+constexpr SkColor kMailOn = SkColorSetRGB(0x0D, 0x94, 0x88);
+constexpr base::TimeDelta kReopenGuard = base::Milliseconds(300);
+constexpr base::TimeDelta kShowAnyway = base::Milliseconds(250);
+
+thoron_mail::MailService* ServiceOf(BrowserWindowInterface* browser) {
+  Profile* profile = browser ? browser->GetProfile() : nullptr;
+  return profile && !profile->IsOffTheRecord()
+             ? &ThoronMailCenter::For(profile).service()
+             : nullptr;
+}
+
+std::string BadgeText(int count) {
+  if (count <= 0) {
+    return std::string();
+  }
+  return count < 1000 ? base::NumberToString(count)
+                      : base::NumberToString(count / 1000) + "k";
+}
+
+std::u16string Tooltip(const thoron_mail::MailService& service) {
+  if (service.accounts().empty()) {
+    return service.last_check().is_null()
+               ? std::u16string(u"Thoron M-Notifier")
+               : u"Thoron M-Notifier: sign in to Gmail to see your mail here";
+  }
+  const int fresh = service.total_new();
+  const int unread = service.total_unread();
+  std::u16string text = u"Thoron M-Notifier: ";
+  if (fresh > 0) {
+    text += base::NumberToString16(fresh) + u" new, ";
+  }
+  text += unread == 0 ? std::u16string(u"no unread mail")
+                      : base::NumberToString16(unread) + u" unread";
+  return text;
+}
+
+// The envelope, teal with the count while there is mail to count.
+ui::ImageModel Envelope(const thoron_mail::MailService& service,
+                        const views::View* view,
+                        int size,
+                        SkColor plain) {
+  const int count = service.icon_count();
+  const gfx::ImageSkia icon = gfx::CreateVectorIcon(
+      vector_icons::kMailIcon, size, count > 0 ? kMailOn : plain);
+  const std::string text = BadgeText(count);
+  if (text.empty()) {
+    return ui::ImageModel::FromImageSkia(icon);
+  }
+  // the count laid over the envelope, as on the shield (an empty 16 px icon:
+  // the badge's image places an icon as if it were an extension's)
+  SkBitmap empty;
+  empty.allocN32Pixels(16, 16);
+  empty.eraseColor(SK_ColorTRANSPARENT);
+  auto source = std::make_unique<IconWithBadgeImageSource>(
+      gfx::Size(size, size),
+      base::BindRepeating(
+          [](const views::View* view) -> const ui::ColorProvider* {
+            return view->GetColorProvider();
+          },
+          base::Unretained(view)));
+  source->SetIcon(gfx::Image(gfx::ImageSkia::CreateFrom1xBitmap(empty)));
+  source->SetBadge(std::make_unique<IconWithBadgeImageSource::Badge>(
+      text, kBadgeText, kBadgeBackground));
+  return ui::ImageModel::FromImageSkia(
+      gfx::ImageSkiaOperations::CreateSuperimposedImage(
+          icon, gfx::ImageSkia(std::move(source), gfx::Size(size, size))));
+}
+
+}  // namespace
+
+// The M-Notifier's menu of one envelope: opened from it, closed by a second
+// press, and shown at once with a page kept since it closed (as Thoron
+// adblock's menu, P5.71/P5.72).
+class ThoronMailMenu : public views::WidgetObserver {
+ public:
+  explicit ThoronMailMenu(BrowserWindowInterface* browser) : browser_(browser) {}
+  ThoronMailMenu(const ThoronMailMenu&) = delete;
+  ThoronMailMenu& operator=(const ThoronMailMenu&) = delete;
+  ~ThoronMailMenu() override = default;
+
+  void Toggle(views::View* anchor) {
+    if (!manager_) {
+      manager_ = WebUIBubbleManager::Create<ThoronMailMenuUI>(
+          browser_, GURL(kThoronMailMenuUrl), IDS_THORON_MAIL_MENU);
+    }
+    if (manager_->GetBubbleWidget()) {
+      manager_->CloseBubble();
+      return;
+    }
+    if (!closed_at_.is_null() &&
+        base::TimeTicks::Now() - closed_at_ < kReopenGuard) {
+      return;
+    }
+    if (!manager_->ShowBubble(anchor, views::BubbleBorder::TOP_RIGHT)) {
+      return;
+    }
+    if (manager_->bubble_using_cached_web_contents()) {
+      if (ThoronMailMenuUI* ui = MenuUI()) {
+        ui->TellShown();
+      }
+      show_anyway_.Start(FROM_HERE, kShowAnyway,
+                         base::BindOnce(&ThoronMailMenu::ShowNow,
+                                        base::Unretained(this)));
+    }
+    if (views::Widget* widget = manager_->GetBubbleWidget()) {
+      observation_.Reset();
+      observation_.Observe(widget);
+    }
+    // what is shown is as new as can be
+    if (thoron_mail::MailService* service = ServiceOf(browser_)) {
+      service->CheckNow();
+    }
+  }
+
+  // views::WidgetObserver:
+  void OnWidgetDestroying(views::Widget* widget) override {
+    closed_at_ = base::TimeTicks::Now();
+    observation_.Reset();
+    show_anyway_.Stop();
+  }
+
+ private:
+  ThoronMailMenuUI* MenuUI() {
+    WebUIContentsWrapper* contents = manager_->GetContentsWrapper();
+    content::WebUI* web_ui = contents && contents->web_contents()
+                                 ? contents->web_contents()->GetWebUI()
+                                 : nullptr;
+    return web_ui && web_ui->GetController()
+               ? web_ui->GetController()->GetAs<ThoronMailMenuUI>()
+               : nullptr;
+  }
+
+  void ShowNow() {
+    views::Widget* widget = manager_ ? manager_->GetBubbleWidget() : nullptr;
+    if (widget && !widget->IsVisible()) {
+      if (WebUIContentsWrapper* contents = manager_->GetContentsWrapper()) {
+        contents->ShowUI();
+      }
+    }
+  }
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  std::unique_ptr<WebUIBubbleManager> manager_;
+  base::ScopedObservation<views::Widget, views::WidgetObserver> observation_{
+      this};
+  base::TimeTicks closed_at_;
+  base::OneShotTimer show_anyway_;
+};
+
+// --- In the toolbar ---
+
+ThoronMailButton::ThoronMailButton(BrowserWindowInterface* browser)
+    : ToolbarButton(base::BindRepeating(&ThoronMailButton::ButtonPressed,
+                                        base::Unretained(this))),
+      browser_(browser),
+      menu_(std::make_unique<ThoronMailMenu>(browser)) {
+  SetTooltipText(u"Thoron M-Notifier");
+  GetViewAccessibility().SetName(u"Thoron M-Notifier");
+  thoron_mail::MailService* service = ServiceOf(browser_);
+  // the profile's own sign-in only: never in an off-the-record window
+  if (!service) {
+    SetVisible(false);
+    return;
+  }
+  mail_observation_.Observe(service);
+  SetVisible(service->Choice("place") != "address");
+}
+
+ThoronMailButton::~ThoronMailButton() = default;
+
+void ThoronMailButton::UpdateIcon() {
+  thoron_mail::MailService* service = ServiceOf(browser_);
+  if (!GetWidget() || !GetColorProvider() || !service) {
+    return;
+  }
+  const ui::ImageModel image =
+      Envelope(*service, this, GetIconSize(),
+               GetForegroundColor(ButtonState::STATE_NORMAL));
+  for (auto state : kButtonStates) {
+    SetImageModel(state, image);
+  }
+  const std::u16string tooltip = Tooltip(*service);
+  SetTooltipText(tooltip);
+  GetViewAccessibility().SetName(tooltip);
+}
+
+void ThoronMailButton::AddedToWidget() {
+  ToolbarButton::AddedToWidget();
+  // after the toolbar has made its other buttons
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&ThoronMailButton::ApplyPlace,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void ThoronMailButton::OnMailChanged() {
+  ApplyPlace();
+  UpdateIcon();
+}
+
+void ThoronMailButton::ButtonPressed() {
+  menu_->Toggle(this);
+}
+
+void ThoronMailButton::ApplyPlace() {
+  thoron_mail::MailService* service = ServiceOf(browser_);
+  ToolbarView* toolbar = views::AsViewClass<ToolbarView>(parent());
+  if (!service || !toolbar) {
+    return;
+  }
+  SetVisible(service->Choice("place") != "address");
+  const std::string where = service->Choice("toolbar-position");
+  // The toolbar has no getters for its extensions and its menu: they are
+  // found by their kind (as for the shield).
+  auto child_named = [toolbar](std::string_view name) -> views::View* {
+    for (views::View* child : toolbar->children()) {
+      if (child->GetClassName() == name) {
+        return child;
+      }
+    }
+    return nullptr;
+  };
+  views::View* after = nullptr;
+  views::View* before = nullptr;
+  if (where == "menu") {
+    before = child_named("BrowserAppMenuButton");
+  } else if (where == "extensions") {
+    after = child_named("ExtensionsToolbarDesktop");
+  }
+  if (!after && !before) {
+    after = toolbar->location_bar_view();
+  }
+  views::View* anchor = after ? after : before;
+  if (!anchor || anchor->parent() != toolbar) {
+    return;
+  }
+  const std::optional<size_t> mine = toolbar->GetIndexOf(this);
+  const std::optional<size_t> index = toolbar->GetIndexOf(anchor);
+  if (!mine || !index) {
+    return;
+  }
+  size_t target = *index;
+  if (*mine < target) {
+    --target;
+  }
+  if (after) {
+    ++target;
+  }
+  if (target != *mine) {
+    toolbar->ReorderChildView(this, target);
+    toolbar->InvalidateLayout();
+  }
+}
+
+// --- In the address bar ---
+
+ThoronMailAddressIcon::ThoronMailAddressIcon(BrowserWindowInterface* browser)
+    : views::ImageButton(
+          base::BindRepeating(&ThoronMailAddressIcon::ButtonPressed,
+                              base::Unretained(this))),
+      browser_(browser),
+      menu_(std::make_unique<ThoronMailMenu>(browser)) {
+  SetImageHorizontalAlignment(views::ImageButton::ALIGN_CENTER);
+  SetImageVerticalAlignment(views::ImageButton::ALIGN_MIDDLE);
+  views::InkDrop::Get(this)->SetMode(views::InkDropHost::InkDropMode::ON);
+  SetHasInkDropActionOnClick(true);
+  views::InstallCircleHighlightPathGenerator(this);
+  SetTooltipText(u"Thoron M-Notifier");
+  GetViewAccessibility().SetName(u"Thoron M-Notifier");
+  const int size =
+      GetLayoutConstant(LayoutConstant::kLocationBarTrailingIconSize);
+  SetPreferredSize(gfx::Size(size + 4, size + 4));
+  thoron_mail::MailService* service = ServiceOf(browser_);
+  if (!service) {
+    SetVisible(false);
+    return;
+  }
+  mail_observation_.Observe(service);
+  SetVisible(service->Choice("place") != "toolbar");
+}
+
+ThoronMailAddressIcon::~ThoronMailAddressIcon() = default;
+
+std::string ThoronMailAddressIcon::position() const {
+  thoron_mail::MailService* service = ServiceOf(browser_);
+  return service ? service->Choice("address-position") : std::string("icons");
+}
+
+void ThoronMailAddressIcon::OnThemeChanged() {
+  views::ImageButton::OnThemeChanged();
+  Update();
+}
+
+void ThoronMailAddressIcon::OnMailChanged() {
+  thoron_mail::MailService* service = ServiceOf(browser_);
+  const bool shown = service && service->Choice("place") != "toolbar";
+  if (shown != GetVisible()) {
+    SetVisible(shown);
+  }
+  Update();
+  // the place among the address bar's icons may have changed
+  if (parent()) {
+    parent()->InvalidateLayout();
+  }
+}
+
+void ThoronMailAddressIcon::ButtonPressed() {
+  menu_->Toggle(this);
+}
+
+void ThoronMailAddressIcon::Update() {
+  thoron_mail::MailService* service = ServiceOf(browser_);
+  if (!service || !GetColorProvider()) {
+    return;
+  }
+  const int size =
+      GetLayoutConstant(LayoutConstant::kLocationBarTrailingIconSize);
+  SetImageModel(views::Button::STATE_NORMAL,
+                Envelope(*service, this, size,
+                         GetColorProvider()->GetColor(kColorOmniboxResultsIcon)));
+  const std::u16string tooltip = Tooltip(*service);
+  SetTooltipText(tooltip);
+  GetViewAccessibility().SetName(tooltip);
+}
+
+BEGIN_METADATA(ThoronMailButton)
+END_METADATA
+
+BEGIN_METADATA(ThoronMailAddressIcon)
+END_METADATA
