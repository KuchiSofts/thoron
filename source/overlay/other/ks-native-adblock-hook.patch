+TEST_F(ThoronUpdateClientTest, AnUpdaterThatIsTooOldGetsTheFullPackageOnly) {
+  Publish();
+  config_.updater = *ParseBuildVersion("158.0.8127.2999");
+  EXPECT_EQ(Look(*Client(), /*install=*/true).state, State::kReadyToRelaunch);
+  ASSERT_EQ(installed_.size(), 1u);
+  EXPECT_EQ(installed_[0], Bytes(data::kInstaller));
+  EXPECT_FALSE(deltas_[0]);
+}
+
+TEST_F(ThoronUpdateClientTest, ARedirectAwayFromHttpsIsRefused) {
+  Publish();
+  net::RedirectInfo redirect;
+  redirect.new_url = GURL("http://github.com/KuchiSofts/thoron/update.json");
+  redirect.status_code = 302;
+  network::TestURLLoaderFactory::Redirects redirects;
+  redirects.push_back({redirect, network::mojom::URLResponseHead::New()});
+  network_.AddResponse(GURL(data::kManifestUrl), network::mojom::URLResponseHead::New(), "",
+                       network::URLLoaderCompletionStatus(net::OK), std::move(redirects));
+  const UpdateClient::Status status = Look(*Client(), /*install=*/true);
+  EXPECT_EQ(status.state, State::kError);
+  EXPECT_NE(status.detail.find("https"), std::string::npos);
+}
+
+TEST(ThoronUpdateClientStateTest, EachOutcomeHasItsState) {
+  Decision decision;
+  decision.outcome = Outcome::kUpToDate;
+  EXPECT_EQ(UpdateClient::StateFor(decision), State::kUpToDate);
+  decision.outcome = Outcome::kNoPackage;
+  EXPECT_EQ(UpdateClient::StateFor(decision), State::kNoPackage);
+  decision.outcome = Outcome::kUpdaterTooOld;
+  EXPECT_EQ(UpdateClient::StateFor(decision), State::kNeedsInstaller);
+  decision.full = PackageFile{"https://github.com/a.exe", 1, std::string(64, 'a')};
+  EXPECT_EQ(UpdateClient::StateFor(decision), State::kAvailable);
+  decision.outcome = Outcome::kUpdate;
+  EXPECT_EQ(UpdateClient::StateFor(decision), State::kAvailable);
+  for (Outcome outcome : {Outcome::kBadSignature, Outcome::kMalformed, Outcome::kWrongChannel,
+                          Outcome::kReplayed, Outcome::kNotYetValid, Outcome::kExpired,
+                          Outcome::kDowngrade}) {
+    decision.outcome = outcome;
+    EXPECT_EQ(UpdateClient::StateFor(decision), State::kCannotVerify);
+  }
+  decision.outcome = Outcome::kInvalidCopy;
+  EXPECT_EQ(UpdateClient::StateFor(decision), State::kError);
+}
+
+// P3.9: every state has its line on the About page, and none is shown as up
+// to date unless it is.
+TEST(ThoronUpdateClientStateTest, EveryStateHasItsLineOnTheAboutPage) {
+  using Kind = UpdateClient::PageKind;
+  UpdateClient::Status status;
+  status.version = "158.0.8127.4500";
+  status.thoron_version = "0.1.2";
+  status.detail = "bad_signature";
+  const struct {
+    State state;
+    Kind kind;
+    const char* words;
+  } cases[] = {
+      {State::kIdle, Kind::kChecking, ""},
+      {State::kChecking, Kind::kChecking, ""},
+      {State::kDownloading, Kind::kUpdating, ""},
+      {State::kInstalling, Kind::kUpdating, ""},
+      {State::kReadyToRelaunch, Kind::kRelaunch, ""},
+      {State::kUpToDate, Kind::kUpToDate, ""},
+      // with a reason (here the shared detail) the reason; without, a portable copy's words (below)
+      {State::kAvailable, Kind::kFailed, "Thoron 0.1.2 (158.0.8127.4500) is out: bad_signature."},
+      {State::kNoPackage, Kind::kFailed, "not yet for this kind of computer"},
+      {State::kNeedsInstaller, Kind::kFailed, "needs its own installer"},
+      {State::kCannotVerify, Kind::kFailed, "cannot verify updates (bad_signature), so it installs nothing"},
+      {State::kError, Kind::kFailedDownload, "could not update: bad_signature."},
+      {State::kDisabled, Kind::kDisabled, "does not update itself"},
+  };
+  for (const auto& c : cases) {
+    SCOPED_TRACE(static_cast<int>(c.state));
+    status.state = c.state;
+    status.progress = 42;
+    const UpdateClient::Page page = UpdateClient::ForAboutPage(status);
+    EXPECT_EQ(page.kind, c.kind);
+    if (*c.words) {
+      EXPECT_NE(page.message.find(c.words), std::string::npos) << page.message;
+    } else {
+      EXPECT_TRUE(page.message.empty());
+    }
+    EXPECT_EQ(page.progress, c.state == State::kDownloading ? 42
+                             : c.state == State::kInstalling ? 100
+                                                              : 0);
+    // nothing that cannot say "up to date" says it
+    EXPECT_EQ(page.kind == Kind::kUpToDate, c.state == State::kUpToDate);
+  }
+  status.state = State::kAvailable;
+  status.detail.clear();
+  EXPECT_NE(UpdateClient::ForAboutPage(status).message.find(
+                "Thoron 0.1.2 (158.0.8127.4500) is out. This copy updates by hand"),
+            std::string::npos);
+}
+
+TEST(ThoronUpdateClientStateTest, TheFilesBesideTheManifest) {
+  const GURL manifest("https://github.com/KuchiSofts/thoron/releases/latest/download/update.json");
+  EXPECT_EQ(UpdateClient::SignatureUrl(manifest).spec(),
+            "https://github.com/KuchiSofts/thoron/releases/latest/download/update.json.sig");
+  EXPECT_EQ(UpdateClient::KeyStatementsUrl(manifest).spec(),
+            "https://github.com/KuchiSofts/thoron/releases/latest/download/update.key");
+}
+
+}  // namespace
+}  // namespace thoron_update
