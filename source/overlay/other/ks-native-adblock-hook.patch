+<!-- Thoron (ROADMAP P3.21): the welcome page of the first start, chrome://thoron-welcome. -->
+<grit-part>
+  <message name="IDS_THORON_WELCOME_TITLE" desc="Title of Thoron's welcome page, shown once at the browser's first start.">
+    Welcome to Thoron
+  </message>
+  <message name="IDS_THORON_WELCOME_IMPORT_HEADING" desc="Heading of the welcome page's offer to import data from another browser.">
+    Bring your things from another browser
+  </message>
+  <message name="IDS_THORON_WELCOME_IMPORT_TEXT" desc="What the import brings over, under the heading of the offer to import.">
+    Bookmarks, history, saved passwords, search engines and form entries from a browser on this computer. Close that browser first; nothing in it is changed.
+  </message>
+  <message name="IDS_THORON_WELCOME_IMPORT_BUTTON" desc="Button that opens the dialog to import from another browser.">
+    Import...
+  </message>
+  <message name="IDS_THORON_WELCOME_DEFAULT_HEADING" desc="Heading of the welcome page's offer to make Thoron the default browser.">
+    Make Thoron your default browser
+  </message>
+  <message name="IDS_THORON_WELCOME_DEFAULT_TEXT" desc="Explains that Windows asks the person to confirm the default browser on its own settings page.">
+    Links and web files then open in Thoron. Windows asks you to confirm it on its own settings page; Thoron opens that page and changes nothing by itself.
+  </message>
+  <message name="IDS_THORON_WELCOME_DEFAULT_BUTTON" desc="Button that opens Windows' settings page for the default browser.">
+    Open Windows' setting
+  </message>
+  <message name="IDS_THORON_WELCOME_ALREADY_DEFAULT" desc="Shown instead of the button when Thoron is already the default browser.">
+    Thoron is your default browser.
+  </message>
+  <message name="IDS_THORON_WELCOME_LATER" desc="Note at the bottom of the welcome page: both can be done later, and closing the tab skips them.">
+    You can do both later in Settings. Close this tab to skip them.
+  </message>
+</grit-part>
