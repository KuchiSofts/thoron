diff --git a/chrome/installer/setup/thoron_update_task.cc b/chrome/installer/setup/thoron_update_task.cc
new file mode 100644
index 0000000000000000000000000000000000000000..80f3daf7dbc4dc2d7cc0c2cdc98d356325349bbe
--- /dev/null
+++ b/chrome/installer/setup/thoron_update_task.cc
@@ -0,0 +1,173 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/installer/setup/thoron_update_task.h"
+
+#include <windows.h>
+
+#include <taskschd.h>
+#include <wrl/client.h>
+
+#include <iterator>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/logging.h"
+#include "base/win/scoped_bstr.h"
+#include "base/win/scoped_com_initializer.h"
+#include "base/win/scoped_variant.h"
+#include "base/win/win_util.h"
+
+namespace installer {
+
+namespace {
+
+constexpr wchar_t kVariant[] = L"" THORON_UPDATE_VARIANT;
+
+std::wstring XmlText(const std::wstring& text) {
+  std::wstring out;
+  for (wchar_t c : text) {
+    switch (c) {
+      case L'&':
+        out += L"&amp;";
+        break;
+      case L'<':
+        out += L"&lt;";
+        break;
+      case L'>':
+        out += L"&gt;";
+        break;
+      case L'"':
+        out += L"&quot;";
+        break;
+      default:
+        out += c;
+    }
+  }
+  return out;
+}
+
+// Task Scheduler's root folder, as the user who runs setup. Its Connect
+// crashes when Windows has no current user name (as Chromium's updater found,
+// chrome/updater/win/task_scheduler.cc), so then there is none.
+Microsoft::WRL::ComPtr<ITaskFolder> RootFolder() {
+  wchar_t user[257] = {};
+  DWORD size = std::size(user);
+  if (!::GetUserNameW(user, &size) || user[0] == L'\0') {
+    return nullptr;
+  }
+  Microsoft::WRL::ComPtr<ITaskService> service;
+  Microsoft::WRL::ComPtr<ITaskFolder> folder;
+  if (FAILED(::CoCreateInstance(CLSID_TaskScheduler, nullptr, CLSCTX_INPROC_SERVER,
+                                IID_PPV_ARGS(&service))) ||
+      FAILED(service->Connect(base::win::ScopedVariant::kEmptyVariant,
+                              base::win::ScopedVariant::kEmptyVariant,
+                              base::win::ScopedVariant::kEmptyVariant,
+                              base::win::ScopedVariant::kEmptyVariant)) ||
+      FAILED(service->GetFolder(base::win::ScopedBstr(L"\\").Get(), &folder))) {
+    return nullptr;
+  }
+  return folder;
+}
+
+// Whether the person switched the task off (in Task Scheduler): an update
+// keeps it off.
+bool SwitchedOff(ITaskFolder* folder) {
+  Microsoft::WRL::ComPtr<IRegisteredTask> task;
+  VARIANT_BOOL enabled = VARIANT_TRUE;
+  return SUCCEEDED(folder->GetTask(base::win::ScopedBstr(ThoronUpdateTaskName()).Get(), &task)) &&
+         SUCCEEDED(task->get_Enabled(&enabled)) && enabled == VARIANT_FALSE;
+}
+
+}  // namespace
+
+std::wstring ThoronUpdateTaskName() {
+  std::wstring sid;
+  if (!base::win::GetUserSidString(&sid)) {
+    sid.clear();
+  }
+  return L"ThoronUpdateTaskUser" + sid;
+}
+
+std::wstring ThoronUpdateTaskXml(const base::FilePath& thoron_setup, bool enabled) {
+  return L"<?xml version=\"1.0\" encoding=\"UTF-16\"?>\r\n"
+         L"<Task version=\"1.3\" xmlns=\"http://schemas.microsoft.com/windows/2004/02/mit/task\">\r\n"
+         L"  <RegistrationInfo>\r\n"
+         L"    <Description>Keeps Thoron up to date: once a day it looks for a newer signed "
+         L"release on Thoron's releases page and installs it, when Thoron's updates are set to "
+         L"automatic. Uninstalling Thoron removes this task.</Description>\r\n"
+         L"  </RegistrationInfo>\r\n"
+         L"  <Triggers>\r\n"
+         L"    <CalendarTrigger>\r\n"
+         L"      <StartBoundary>2026-01-01T12:00:00</StartBoundary>\r\n"
+         L"      <RandomDelay>PT1H</RandomDelay>\r\n"
+         L"      <ScheduleByDay><DaysInterval>1</DaysInterval></ScheduleByDay>\r\n"
+         L"    </CalendarTrigger>\r\n"
+         L"  </Triggers>\r\n"
+         L"  <Principals>\r\n"
+         L"    <Principal id=\"Author\">\r\n"
+         L"      <LogonType>InteractiveToken</LogonType>\r\n"
+         L"      <RunLevel>LeastPrivilege</RunLevel>\r\n"
+         L"    </Principal>\r\n"
+         L"  </Principals>\r\n"
+         L"  <Settings>\r\n"
+         L"    <Enabled>" +
+         std::wstring(enabled ? L"true" : L"false") +
+         L"</Enabled>\r\n"
+         L"    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>\r\n"
+         L"    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>\r\n"
+         L"    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>\r\n"
+         L"    <StartWhenAvailable>true</StartWhenAvailable>\r\n"
+         L"    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>\r\n"
+         L"    <AllowStartOnDemand>true</AllowStartOnDemand>\r\n"
+         L"    <ExecutionTimeLimit>PT1H</ExecutionTimeLimit>\r\n"
+         L"    <Priority>7</Priority>\r\n"
+         L"  </Settings>\r\n"
+         L"  <Actions Context=\"Author\">\r\n"
+         L"    <Exec>\r\n"
+         L"      <Command>" +
+         XmlText(thoron_setup.value()) +
+         L"</Command>\r\n"
+         L"      <Arguments>--scheduled --variant=" +
+         XmlText(kVariant) +
+         L"</Arguments>\r\n"
+         L"    </Exec>\r\n"
+         L"  </Actions>\r\n"
+         L"</Task>\r\n";
+}
+
+bool RegisterThoronUpdateTask(const base::FilePath& thoron_setup) {
+  if (!base::PathExists(thoron_setup)) {
+    LOG(ERROR) << "No update task: " << thoron_setup << " is not there.";
+    return false;
+  }
+  base::win::ScopedCOMInitializer com;
+  Microsoft::WRL::ComPtr<ITaskFolder> folder = RootFolder();
+  if (!com.Succeeded() || !folder) {
+    LOG(ERROR) << "No update task: Task Scheduler cannot be reached.";
+    return false;
+  }
+  const bool enabled = !SwitchedOff(folder.Get());
+  Microsoft::WRL::ComPtr<IRegisteredTask> task;
+  const HRESULT result = folder->RegisterTask(
+      base::win::ScopedBstr(ThoronUpdateTaskName()).Get(),
+      base::win::ScopedBstr(ThoronUpdateTaskXml(thoron_setup, enabled)).Get(), TASK_CREATE_OR_UPDATE,
+      base::win::ScopedVariant::kEmptyVariant, base::win::ScopedVariant::kEmptyVariant,
+      TASK_LOGON_INTERACTIVE_TOKEN, base::win::ScopedVariant::kEmptyVariant, &task);
+  LOG_IF(ERROR, FAILED(result)) << "Task Scheduler did not take Thoron's update task: " << std::hex
+                                << result;
+  return SUCCEEDED(result);
+}
+
+void RemoveThoronUpdateTask() {
+  base::win::ScopedCOMInitializer com;
+  Microsoft::WRL::ComPtr<ITaskFolder> folder = RootFolder();
+  if (com.Succeeded() && folder) {
+    // There may be none (an install from before the task, or one removed by
+    // hand); that is fine.
+    folder->DeleteTask(base::win::ScopedBstr(ThoronUpdateTaskName()).Get(), 0);
+  }
+}
+
+}  // namespace installer
