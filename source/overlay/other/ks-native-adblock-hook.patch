+
+namespace sql {
+class Database;
+}  // namespace sql
+
+namespace user_data_importer::chromium_family {
+
+// Reads bookmarks, history, saved passwords, search engines and autofill from
+// one profile of a Chromium-family browser and hands them to a bridge (ROADMAP
+// P3.14). The source is never written: each file a type needs is copied to a
+// temporary folder, the copies are opened read only, and each SQLite copy is
+// refused unless `PRAGMA quick_check` passes. The copies are deleted when the
+// reader is destroyed.
+class ChromiumFamilyReader {
+ public:
+  struct Options {
+    // The profile folder (the browser's `Local State` names it), e.g.
+    // ...\User Data\Default. Holds `Bookmarks`, `History`, `Login Data`,
+    // `Web Data`.
+    base::FilePath profile_path;
+    // The browser's user data folder, which holds `Local State` (and the
+    // password key inside it).
+    base::FilePath user_data_path;
+    // The folder imported bookmarks go under, already localized, e.g.
+    // "Imported from Brave". The glue builds it from a string resource.
+    std::u16string bookmark_folder_name;
+  };
+
+  // Counts for the import report. No secrets.
+  struct Stats {
+    int bookmarks = 0;
+    int history = 0;
+    int search_engines = 0;
+    int autofill = 0;
+    int passwords = 0;
+    // "v20" app-bound values, left alone on purpose.
+    int passwords_skipped_app_bound = 0;
+    // Values in no recognised format.
+    int passwords_skipped_other = 0;
+    // Recognised values that failed to decrypt.
+    int passwords_failed = 0;
+    int cookies = 0;
+    // "v20" app-bound cookie values, left alone on purpose.
+    int cookies_skipped_app_bound = 0;
+    // Cookie values that could not be decrypted or read.
+    int cookies_failed = 0;
+    // The home page and startup pages (settings) of the profile.
+    int home_page = 0;  // 0 or 1
+    int startup_pages = 0;
+    // Chrome Web Store extensions listed to be installed again from the store.
+    int extensions = 0;
+    // Extensions the person installed from elsewhere (unpacked, by another
+    // program, from a file): counted and left out.
+    int extensions_skipped = 0;
+    // Tabs in the source's last session that will open (web pages only).
+    int open_tabs = 0;
+    // A SQLite file whose copy failed PRAGMA quick_check, so its type was
+    // skipped.
+    int databases_refused = 0;
+  };
+
+  explicit ChromiumFamilyReader(const Options& options);
+  ChromiumFamilyReader(const ChromiumFamilyReader&) = delete;
+  ChromiumFamilyReader& operator=(const ChromiumFamilyReader&) = delete;
+  ~ChromiumFamilyReader();
+
+  // Reads the chosen `items` (a bitmask of ImportItem) and reports them to
+  // `bridge`. Returns the counts so far. May be called once per item; the
+  // copies are kept between calls and deleted when the reader is destroyed.
+  Stats Import(uint16_t items, ChromiumFamilyImportBridge* bridge);
+
+  // The folder holding the copies (empty until the first copy is made).
+  base::FilePath copies_folder_for_testing() const {
+    return temp_dir_.IsValid() ? temp_dir_.GetPath() : base::FilePath();
+  }
+
+ private:
+  // Copies `source_file` into the temp folder once and returns the copy's
+  // path, or empty if the source is missing or the copy fails.
+  base::FilePath CopyForReading(const base::FilePath& source_file);
+
+  // Copies a SQLite file and opens the copy read only, returning it only if
+  // PRAGMA quick_check passes. On a quick_check failure the type is skipped and
+  // counted once.
+  std::unique_ptr<sql::Database> OpenCopiedDatabase(
+      const base::FilePath& source_file);
+
+  void ImportBookmarks(ChromiumFamilyImportBridge* bridge);
+  void ImportHistory(ChromiumFamilyImportBridge* bridge);
+  void ImportSearchEngines(ChromiumFamilyImportBridge* bridge);
+  void ImportAutofill(ChromiumFamilyImportBridge* bridge);
+  void ImportPasswords(ChromiumFamilyImportBridge* bridge);
+  void ImportCookies(ChromiumFamilyImportBridge* bridge);
+  void ImportStartup(ChromiumFamilyImportBridge* bridge);
+  void ImportExtensions(ChromiumFamilyImportBridge* bridge);
+  void ImportOpenTabs(ChromiumFamilyImportBridge* bridge);
+
+  const Options options_;
+  base::ScopedTempDir temp_dir_;
+  // SQLite copies already refused by quick_check, so Web Data (keywords and
+  // autofill) is not counted twice.
+  std::set<base::FilePath> refused_databases_;
+  Stats stats_;
+};
+
+}  // namespace user_data_importer::chromium_family
+
+#endif  // COMPONENTS_USER_DATA_IMPORTER_CHROMIUM_FAMILY_CHROMIUM_FAMILY_READER_H_
