+      alias.set(found[1], value);
+    }
+  }
+  const accounts = [];
+  let other = 0;
+  for (const line of sections['<accounts>'].split('\n')) {
+    let parts = [];
+    try {
+      parts = (await xnDecrypt(key, line)).split('\t');
+    } catch {
+      continue;
+    }
+    // the kind, the user, the password, and the file's own token: a line without it is not of this file
+    if (parts.length < 4 || parts[3] !== token) {
+      continue;
+    }
+    const user = parts[1].trim();
+    if (parts[0] !== 'gmail' || !user) {
+      other++;
+      continue;
+    }
+    accounts.push({email: user.includes('@') ? user : `${user}@gmail.com`, alias: alias.get(parts[1]) || '',
+                   password: parts[2]});
+  }
+  return {accounts, other};
+}
+
+async function readXnotifier(text) {
+  const say = (words) => {
+    $('backup-state').textContent = words;
+  };
+  const errors = {
+    passphrase: 'This file of X-notifier needs its passphrase: type it above and read it again.',
+    wrong: 'The passphrase does not open this file of X-notifier.',
+    bad: 'This is not a backup of Thoron M-Notifier.',
+    locked: 'Passwords cannot be kept yet. Try again in a moment.',
+  };
+  const read = await xnRead(text, $('backup-pass').value);
+  if (read.error) {
+    say(t(errors[read.error] || errors.bad));
+    return;
+  }
+  let answer = {error: 'bad', google: 0, mailboxes: 0};
+  try {
+    answer = await sendWithPromise('importGoogleAccounts', read.accounts);
+  } catch {
+    return;
+  }
+  if (answer.error) {
+    say(t(errors[answer.error] || errors.bad));
+    return;
+  }
+  say(`${t('Read from X-notifier. Google accounts:')} ${answer.google}; ${t('as mailboxes by app password:')} ` +
+      `${answer.mailboxes}; ${t('left out (not mail):')} ${read.other}`);
+  refresh();
+}
+
+async function readBackup(file) {
+  if (!file || file.size > 4 * 1024 * 1024) {
+    $('backup-state').textContent = t('This is not a backup of Thoron M-Notifier.');
+    return;
+  }
+  const whole = await file.text();
+  if (whole.trimStart().startsWith(XN_START)) {
+    await readXnotifier(whole);
+    return;
+  }
+  let answer = {error: 'bad', accounts: 0};
+  try {
+    answer = await sendWithPromise('importBackup', await file.text(), $('backup-pass').value);
+  } catch {
+    return;
+  }
+  const errors = {
+    passphrase: 'This backup is sealed: type its passphrase above and read it again.',
+    wrong: 'The passphrase does not open this backup.',
+    bad: 'This is not a backup of Thoron M-Notifier.',
+    locked: 'Passwords cannot be kept yet. Try again in a moment.',
+  };
+  $('backup-state').textContent =
+      answer.error ? t(errors[answer.error] || errors.bad) : `${t('Read. Mailboxes now:')} ${answer.accounts}`;
+  refresh();
+}
+
+function show(next) {
+  state = next;
+  const parts = [];
+  if (next.accounts.length) {
+    if (next.totalNew) {
+      parts.push(`${next.totalNew} ${t('new')}`);
+    }
+    parts.push(`${next.total} ${t('unread')}`);
+  }
+  $('total').textContent = parts.join(' · ');
+  $('check').disabled = next.checking;
+  $('state').textContent = next.lastCheck ? `${t('Looked')} ${ago(next.lastCheck)}` : '';
+  showAccounts(next);
+  showSettings(next);
+}
+
+async function refresh() {
+  try {
+    show(await sendWithPromise('getMailState'));
+  } catch {
+    // the window went away
+  }
+}
