+// Thoron (ROADMAP P3.14): what an import may install from the store.
+bool IsAThoronImportableExtension(const extensions::Extension* extension,
+                                  content::BrowserContext* context) {
+  return extension->is_extension();
+}
+
+}  // namespace
+
+void ProfileWriter::AddThoronWebStoreExtensions(
+    const std::vector<std::string>& ids) {
+  CHECK(profile_, base::NotFatalUntil::M161);
+  extensions::PendingExtensionManager* pending =
+      extensions::PendingExtensionManager::Get(profile_);
+  extensions::ExtensionRegistry* registry =
+      extensions::ExtensionRegistry::Get(profile_);
+  if (!pending || !registry) {
+    return;
+  }
+  bool queued = false;
+  for (const std::string& id : ids) {
+    if (!crx_file::id_util::IdIsValid(id) ||
+        registry->GetInstalledExtension(id)) {
+      continue;
+    }
+    // As a store install from another device is queued: from the store's own
+    // address, as an "internal" install (one queued as an external install is
+    // removed at the next start, since no external provider lists it), with its
+    // permissions not granted, so one that asks for access Chromium warns about
+    // stays off until the person accepts that access. Only extensions; an app
+    // or a theme is not installed.
+    queued |= pending->AddFromSync(
+        id, extension_urls::GetWebstoreUpdateUrl(), base::Version(),
+        &IsAThoronImportableExtension, /*remote_install=*/true);
+  }
+  if (queued) {
+    if (extensions::ExtensionUpdater* updater =
+            extensions::ExtensionUpdater::Get(profile_)) {
+      updater->CheckSoon();
+    }
+  }
+}
+
+void ProfileWriter::AddThoronOpenTabs(const std::vector<uint8_t>& session_file) {
+  CHECK(profile_, base::NotFatalUntil::M161);
+  if (profile_->IsOffTheRecord()) {
+    return;
+  }
+  const std::vector<std::unique_ptr<sessions::SessionWindow>> windows =
+      user_data_importer::chromium_family::ReadOpenTabs(session_file, nullptr);
+  if (windows.empty()) {
+    return;
+  }
+  std::vector<const sessions::SessionWindow*> to_open;
+  for (const std::unique_ptr<sessions::SessionWindow>& window : windows) {
+    to_open.push_back(window.get());
+  }
+  SessionRestore::RestoreForeignSessionWindows(
+      profile_, to_open.cbegin(), to_open.cend(), base::DoNothing());
+}
