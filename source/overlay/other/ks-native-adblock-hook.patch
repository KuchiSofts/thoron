+
+#include <stdint.h>
+
+#include <memory>
+#include <optional>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "components/thoron_portable_key/secret_bytes.h"
+
+namespace thoron_portable_key {
+
+// What the system keeps for the person signed in to this PC, for "Remember
+// this PC" (design 7.8): on Windows, DPAPI for the current Windows account; on
+// Linux, the desktop's keyring.
+// What it protects opens only for that account on that PC (or with its
+// password and its keys), so the protected copy may travel with the portable
+// copy without giving the profile key to whoever holds the drive.
+class OsKeyStore {
+ public:
+  virtual ~OsKeyStore() = default;
+
+  // False where the system has no such store; "Remember this PC" is then not
+  // offered and nothing is ever kept without protection (threat model E5).
+  virtual bool IsAvailable() const = 0;
+  // `secret` protected for this account on this PC, or nullopt.
+  virtual std::optional<std::vector<uint8_t>> Protect(
+      base::span<const uint8_t> secret) = 0;
+  // What Protect() gave, back again; nullopt when it was protected for
+  // another account or PC, or was changed.
+  virtual std::optional<SecretBytes> Unprotect(
+      base::span<const uint8_t> blob) = 0;
+  // Whatever the system itself still keeps for `blob` (one this store's
+  // Protect() gave) removed, for "Forget this PC": an older copy of the key
+  // file, a backup of the drive, then no longer opens here. DPAPI keeps
+  // nothing; the desktop's keyring keeps an item. True when nothing is left.
+  virtual bool Forget(base::span<const uint8_t> blob) { return true; }
+};
+
+// The system's store: DPAPI on Windows, the desktop's keyring through the
+// Secret Service on Linux (os_key_store_linux.h); elsewhere one that is not
+// available.
+std::unique_ptr<OsKeyStore> CreateOsKeyStore();
+
+}  // namespace thoron_portable_key
+
+#endif  // COMPONENTS_THORON_PORTABLE_KEY_OS_KEY_STORE_H_
