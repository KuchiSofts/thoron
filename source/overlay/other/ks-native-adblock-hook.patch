+
+TEST_F(BrowserDetectionTest, NeverDetectsThoronItself) {
+  base::FilePath thorium = UserData(local_.GetPath(), L"Thorium\\User Data");
+  MakeMultiProfile(thorium, "{\"Default\":{\"name\":\"Me\"}}", {"Default"},
+                   /*running=*/true);
+  // Point own_user_data at that folder: it is the running browser, so it is
+  // never offered as a source.
+  folders_.own_user_data = thorium;
