+
+// The blocker's shield for the page of `tab`, as the address bar and the
+// toolbar show it (P5.71): filled with the theme's accent while it blocks
+// there (P5.78), `off_color` where it does not (not a web page, off for the
+// site or for every site), and the count of what it blocked on the page in
+// its corner. `tooltip`, when given, gets what the shield says. `view` draws
+// it (its colours).
+ui::ImageModel ThoronAdblockShield(content::WebContents* tab,
+                                   const views::View* view,
+                                   int size,
+                                   SkColor off_color,
+                                   std::u16string* tooltip);
+
+// The shield of Thoron adblock in the toolbar, where an ad blocker's icon
+// sits (chrome://adblock says where the shield is: the address bar, the
+// toolbar or both, P5.72). Pressed, it opens the blocker's menu
+// (thoron_adblock_popup_ui.h); so does the address bar's shield, through
+// thoron_adblock::OpenMenuFor. Shown only while the ThoronNativeAdblock
+// feature is on.
+class ThoronAdblockButton : public ToolbarButton,
+                            public TabStripModelObserver,
+                            public content::WebContentsObserver,
+                            public views::WidgetObserver,
+                            public thoron_adblock::MenuOpener {
+  METADATA_HEADER(ThoronAdblockButton, ToolbarButton)
+
+ public:
+  explicit ThoronAdblockButton(BrowserWindowInterface* browser);
+  ThoronAdblockButton(const ThoronAdblockButton&) = delete;
+  ThoronAdblockButton& operator=(const ThoronAdblockButton&) = delete;
+  ~ThoronAdblockButton() override;
+
+  // thoron_adblock::MenuOpener: the address bar's shield opens this menu too,
+  // from itself (`anchor`), as uBlock Origin's icon does.
+  bool OpenMenuFor(content::WebContents* tab, views::View* anchor) override;
+  void WarmUpMenuFor(content::WebContents* tab) override;
+
+  // ToolbarButton:
+  void UpdateIcon() override;
+  // the pointer over the shield: the menu's page is loaded ahead
+  void OnMouseEntered(const ui::MouseEvent& event) override;
+  void AddedToWidget() override;
+  // The shield is moved with the mouse (P5.78, thoron::ToolbarDrag).
+  bool OnMousePressed(const ui::MouseEvent& event) override;
+  bool OnMouseDragged(const ui::MouseEvent& event) override;
+  void OnMouseReleased(const ui::MouseEvent& event) override;
+  void OnMouseCaptureLost() override;
+
+  // The profile's settings (the order of Thoron's buttons is kept there).
+  PrefService* prefs() const;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+
+  // content::WebContentsObserver:
+  void PrimaryPageChanged(content::Page& page) override;
+
+  // views::WidgetObserver: the menu closed.
+  void OnWidgetDestroying(views::Widget* widget) override;
+
+ private:
+  void ButtonPressed();
+  // Opens the menu from `anchor` (null: this shield, or the address bar when
+  // it is hidden), or closes it when it is open.
+  void ShowMenu(views::View* anchor);
+  // A request was blocked on `page`.
+  void OnBlocked(content::Page& page);
+  // The switch for every site or an option changed.
+  void OnStateChanged();
+  // The address bar's shield is drawn again, at most every
+  // kAddressBarRefresh while a page blocks a lot.
+  void RefreshAddressBar();
+  void DoRefreshAddressBar();
+  // Moves the shield where chrome://adblock says (P5.73): after the
+  // extensions, right after the address bar, or next to the menu.
+  void ApplyPosition();
+  // The menu's bubble manager, made when first needed.
+  ThoronMenuBubbleManager& Menu();
+  void WarmUpMenu();
+  // A kept page did not ask to be shown in time: the menu is shown anyway.
+  void ShowMenuNow();
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  std::unique_ptr<ThoronMenuBubbleManager> menu_;
+  bool warm_up_pending_ = false;
+  base::OneShotTimer show_anyway_;
+  base::ScopedObservation<views::Widget, views::WidgetObserver>
+      menu_observation_{this};
+  // When the menu last closed: a press that closed it does not open it again.
+  base::TimeTicks menu_closed_at_;
+  bool address_bar_refresh_pending_ = false;
+  base::CallbackListSubscription blocked_subscription_;
+  // the switch for every site (P5.70) and the options (P5.71)
+  base::CallbackListSubscription blocking_subscription_;
+  // moving the shield with the mouse, and the order when it changes (P5.78)
+  std::unique_ptr<thoron::ToolbarDrag> drag_;
+  PrefChangeRegistrar order_registrar_;
+  base::WeakPtrFactory<ThoronAdblockButton> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TOOLBAR_THORON_ADBLOCK_BUTTON_H_
