+    #[test]
+    fn a_whole_look_counts_the_unread_and_reads_the_newest() {
+        let mut s = imap_session("alice@example.com", "app pass", 2);
+        assert_eq!(feed(&mut s, "* OK ready\r\n").0, "a1 CAPABILITY\r\n");
+        let (sent, _) = feed(&mut s, "* CAPABILITY IMAP4rev1 AUTH=PLAIN SASL-IR\r\na1 OK done\r\n");
+        let auth = base64::engine::general_purpose::STANDARD.encode(b"\0alice@example.com\0app pass");
+        assert_eq!(sent, format!("a2 AUTHENTICATE PLAIN {auth}\r\n"));
+        assert_eq!(feed(&mut s, "a2 OK signed in\r\n").0, "a3 EXAMINE INBOX\r\n");
+        assert_eq!(
+            feed(&mut s, "* 9 EXISTS\r\n* OK [UIDVALIDITY 77] ok\r\na3 OK [READ-ONLY] done\r\n").0,
+            "a4 UID SEARCH UNSEEN\r\n"
+        );
+        // three unread, the two newest are read
+        let (sent, _) = feed(&mut s, "* SEARCH 4 9 7\r\na4 OK done\r\n");
+        assert_eq!(sent, "a5 UID FETCH 7,9 (UID INTERNALDATE BODY.PEEK[HEADER.FIELDS (FROM SUBJECT)])\r\n");
+        let server = fetch(7, "16-Nov-2026 10:00:00 +0000", HEADERS)
+            + &fetch(9, "16-Nov-2026 12:30:00 +0200", "Subject: plain\r\nFrom: bob@example.com\r\n\r\n")
+            + "a5 OK done\r\n";
+        // in two pieces, cut inside a literal
+        let cut = server.len() / 3;
+        assert_eq!(feed(&mut s, &server[..cut]), (String::new(), false));
+        assert_eq!(feed(&mut s, &server[cut..]), ("a6 LOGOUT\r\n".to_string(), false));
+        assert_eq!(feed(&mut s, "* BYE\r\na6 OK\r\n"), (String::new(), true));
+        assert_eq!(s.problem(), "");
+        assert_eq!(s.unseen(), 3);
+        let messages = s.messages();
+        assert_eq!(messages.len(), 2);
+        // newest first: 12:30 +0200 is 10:30 UTC
+        assert_eq!(messages[0].id, "77:9");
+        assert_eq!(messages[0].from_email, "bob@example.com");
+        assert_eq!(text(&messages[0].subject), "[]plain");
+        assert_eq!(messages[0].issued_ms - messages[1].issued_ms, 30 * 60 * 1000);
+        assert_eq!(messages[1].id, "77:7");
