+void ThoronMailCenter::OpenPage(const GURL& url) {
+  if (!url.is_valid() || !url.SchemeIs(url::kHttpsScheme)) {
+    return;
+  }
+  BrowserWindowInterface* found = nullptr;
+  int tab = -1;
+  if (service_->Choice("open") != "new") {
+    ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+        [&](BrowserWindowInterface* browser) {
+          if (browser->GetProfile() != profile_) {
+            return true;
+          }
+          TabStripModel* tabs = browser->GetTabStripModel();
+          for (int i = 0; i < tabs->count(); ++i) {
+            if (tabs->GetWebContentsAt(i)->GetLastCommittedURL().host() ==
+                url.host()) {
+              found = browser;
+              tab = i;
+              return false;
+            }
+          }
+          return true;
+        });
+  }
+  if (found) {
+    found->GetTabStripModel()->ActivateTabAt(tab);
+    found->GetWindow()->Activate();
+    return;
+  }
+  NavigateParams params(profile_, url, ui::PAGE_TRANSITION_LINK);
+  params.disposition = WindowOpenDisposition::kNewForegroundTab;
+  params.window_action = NavigateParams::WindowAction::kShowWindow;
+  Navigate(&params);
+}
+
+void ThoronMailCenter::OpenAccount(int index) {
+  for (const thoron_mail::MailAccount& account : service_->accounts()) {
+    if (account.index != index) {
+      continue;
+    }
+    if (!account.imap) {
+      // marks it looked at, too
+      OpenGmail(thoron_mail::MailService::InboxUrl(index), index);
+      return;
+    }
+    const std::string email = account.email;
+    const GURL webmail(account.webmail);
+    service_->MarkLooked(email);
+    OpenPage(webmail);
+    return;
+  }
+}
+
+void ThoronMailCenter::OpenManagePage(bool add) {
+  NavigateParams params(profile_,
+                        GURL(std::string(kThoronMailMenuUrl) +
+                             (add ? "#manage-add" : "#manage")),
+                        ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+  params.disposition = WindowOpenDisposition::kSingletonTab;
+  params.window_action = NavigateParams::WindowAction::kShowWindow;
+  Navigate(&params);
+}
+
+base::DictValue ThoronMailCenter::BackupDict(bool with_passwords) const {
+  base::DictValue choices;
+  for (const char* name : {"sound", "count", "open", "messages", "which",
+                           "place", "toolbar-position", "address-position"}) {
+    choices.Set(name, service_->Choice(name));
+  }
+  base::ListValue accounts;
+  for (const thoron_mail::ImapAccount& account : service_->imap_accounts()) {
+    base::DictValue entry = base::DictValue()
+                                .Set("email", account.email)
+                                .Set("host", account.host)
+                                .Set("port", account.port)
+                                .Set("user", account.user)
+                                .Set("webmail", account.webmail);
+    if (with_passwords) {
+      entry.Set("password", account.password);
+    }
+    accounts.Append(std::move(entry));
+  }
+  PrefService* prefs = profile_->GetPrefs();
+  return base::DictValue()
+      .Set("format", thoron_mail::kBackupFormat)
+      .Set("version", 1)
+      .Set("sealed", false)
+      .Set("settings",
+           base::DictValue()
+               .Set("notify", service_->notify())
+               .Set("interval", service_->interval_minutes())
+               .Set("choices", std::move(choices))
+               .Set("ignored", prefs->GetList("thoron_mail.ignored").Clone())
+               .Set("order", prefs->GetString("thoron.toolbar_order")))
+      .Set("accounts", std::move(accounts));
+}
+
+void ThoronMailCenter::ExportBackup(bool with_passwords,
+                                    std::string passphrase,
+                                    Exported done) {
+  const bool seal = !passphrase.empty();
+  std::string backup =
+      base::WriteJsonWithOptions(BackupDict(with_passwords || seal),
+                                 base::JSONWriter::OPTIONS_PRETTY_PRINT)
+          .value_or(std::string());
+  if (!seal) {
+    std::move(done).Run(std::move(backup));
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&Sealed, std::move(backup), std::move(passphrase)),
+      std::move(done));
+}
+
+void ThoronMailCenter::ImportBackup(std::string file,
+                                    std::string passphrase,
+                                    Imported done) {
+  if (file.empty() || file.size() > kMostBackupBytes) {
+    std::move(done).Run("bad", 0);
+    return;
+  }
+  if (!thoron_mail::IsSealedBackup(file)) {
+    ApplyBackup(std::move(done), std::move(file));
+    return;
+  }
+  if (passphrase.empty()) {
+    std::move(done).Run("passphrase", 0);
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&Opened, std::move(file), std::move(passphrase)),
+      base::BindOnce(&ThoronMailCenter::ApplyBackup, weak_factory_.GetWeakPtr(),
+                     std::move(done)));
+}
+
+void ThoronMailCenter::ApplyBackup(Imported done,
+                                   std::optional<std::string> backup) {
+  if (!backup) {
+    std::move(done).Run("wrong", 0);
+    return;
+  }
+  std::optional<base::DictValue> dict =
+      base::JSONReader::ReadDict(*backup, base::JSON_PARSE_RFC);
+  const std::string* format = dict ? dict->FindString("format") : nullptr;
+  if (!format || *format != thoron_mail::kBackupFormat ||
+      dict->FindBool("sealed").value_or(false) ||
+      dict->FindInt("version").value_or(0) != 1) {
+    std::move(done).Run("bad", 0);
+    return;
+  }
+  if (!encryptor_) {
+    std::move(done).Run("locked", 0);
+    return;
+  }
+  // The settings: only what the M-Notifier knows, each checked as when a
+  // person sets it.
+  PrefService* prefs = profile_->GetPrefs();
+  if (const base::DictValue* settings = dict->FindDict("settings")) {
+    if (std::optional<bool> notify = settings->FindBool("notify")) {
+      service_->SetNotify(*notify);
+    }
+    if (std::optional<int> interval = settings->FindInt("interval")) {
+      service_->SetInterval(*interval);
+    }
+    if (const base::DictValue* choices = settings->FindDict("choices")) {
+      for (const auto [name, value] : *choices) {
+        if (value.is_string()) {
+          service_->SetChoice(name, value.GetString());
+        }
+      }
+    }
+    if (const base::ListValue* ignored = settings->FindList("ignored")) {
+      base::ListValue kept;
+      for (const base::Value& value : *ignored) {
+        if (value.is_string() && IsAddress(value.GetString()) &&
+            kept.size() < 50) {
+          kept.Append(value.GetString());
+        }
+      }
+      prefs->SetList("thoron_mail.ignored", std::move(kept));
+    }
+    if (const std::string* order = settings->FindString("order");
+        order && (*order == "mail,adblock" || *order == "adblock,mail")) {
+      prefs->SetString("thoron.toolbar_order", *order);
+    }
+  }
+  // The mailboxes: those of the backup, then those there were that it does
+  // not name. One the backup names without its password keeps the password
+  // it has here, or is left out.
+  std::vector<thoron_mail::ImapAccount> accounts;
+  const std::vector<thoron_mail::ImapAccount> known = service_->imap_accounts();
+  auto has = [&accounts](const std::string& email) {
+    return std::ranges::any_of(accounts,
+                               [&](const thoron_mail::ImapAccount& account) {
+                                 return account.email == email;
+                               });
+  };
+  if (const base::ListValue* list = dict->FindList("accounts")) {
+    for (const base::Value& value : *list) {
+      const base::DictValue* entry = value.GetIfDict();
+      const std::string* email = entry ? entry->FindString("email") : nullptr;
+      const std::string* host = entry ? entry->FindString("host") : nullptr;
+      if (!email || !host ||
+          accounts.size() >= thoron_mail::MailService::kMostImapAccounts) {
+        continue;
+      }
+      thoron_mail::ImapAccount account;
+      account.email = *email;
+      account.host = *host;
+      account.port = entry->FindInt("port").value_or(993);
+      if (const std::string* user = entry->FindString("user")) {
+        account.user = *user;
+      }
+      if (const std::string* webmail = entry->FindString("webmail")) {
+        account.webmail = *webmail;
+      }
+      if (const std::string* password = entry->FindString("password")) {
+        account.password = *password;
+      } else {
+        for (const thoron_mail::ImapAccount& old : known) {
+          if (old.email == *email) {
+            account.password = old.password;
+          }
+        }
+      }
+      std::optional<thoron_mail::ImapAccount> checked =
+          CheckedAccount(std::move(account));
+      if (checked && !has(checked->email)) {
+        accounts.push_back(std::move(*checked));
+      }
+    }
+  }
+  for (const thoron_mail::ImapAccount& old : known) {
+    if (!has(old.email) &&
+        accounts.size() < thoron_mail::MailService::kMostImapAccounts) {
+      accounts.push_back(old);
+    }
+  }
+  if (!KeepImapAccounts(accounts)) {
+    std::move(done).Run("locked", 0);
+    return;
+  }
+  std::move(done).Run(std::string(), static_cast<int>(accounts.size()));
+}
