+++ b/components/thoron_update/swap_unittest.cc
@@ -0,0 +1,236 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_update/swap.h"
+
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/strings/string_number_conversions.h"
+#include "crypto/hash.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace thoron_update {
+namespace {
+
+BuildVersion V(uint16_t build, uint16_t patch) {
+  return BuildVersion{{158, 0, build, patch}};
+}
+
+// The files of a made-up version: a program, a library and a file in a folder.
+std::map<std::string, std::string> Content(const BuildVersion& version) {
+  const std::string name = ToString(version);
+  return {{"thoron.exe", "program " + name},
+          {"chrome.dll", std::string(70000, 'd') + name},
+          {"locales/en-US.pak", "strings " + name}};
+}
+
+std::vector<VersionFile> FilesOf(const BuildVersion& version) {
+  std::vector<VersionFile> out;
+  for (const auto& [path, text] : Content(version)) {
+    out.push_back({path, static_cast<int64_t>(text.size()),
+                   base::HexEncodeLower(crypto::hash::Sha256(text))});
+  }
+  return out;
+}
+
+class ThoronUpdateSwapTest : public testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(dir_.CreateUniqueTempDir()); }
+
+  const base::FilePath& root() { return dir_.GetPath(); }
+
+  // Unpacks a made-up package of `version` into a folder of `root`.
+  base::FilePath Stage(const BuildVersion& version,
+                       const std::map<std::string, std::string>& content) {
+    const base::FilePath staged = root().AppendASCII(ToString(version) + ".staging");
+    for (const auto& [path, text] : content) {
+      const base::FilePath file = staged.Append(base::FilePath::FromUTF8Unsafe(path))
+                                      .NormalizePathSeparators();
+      EXPECT_TRUE(base::CreateDirectory(file.DirName()));
+      EXPECT_TRUE(base::WriteFile(file, text));
+    }
+    return staged;
+  }
+
+  base::FilePath Stage(const BuildVersion& version) { return Stage(version, Content(version)); }
+
+  void Install(const BuildVersion& version) {
+    ASSERT_EQ(InstallVersion(root(), Stage(version), version, FilesOf(version)), SwapResult::kDone);
+  }
+
+  // What a launcher starts is a version whose folder is whole.
+  void ExpectLaunchable() {
+    const std::optional<BuildVersion> current = CurrentVersion(root());
+    ASSERT_TRUE(current);
+    EXPECT_TRUE(VersionIsComplete(root(), *current, FilesOf(*current))) << ToString(*current);
+  }
+
+  base::ScopedTempDir dir_;
+};
+
+TEST_F(ThoronUpdateSwapTest, AFirstVersionIsInstalled) {
+  EXPECT_FALSE(CurrentVersion(root()));
+  Install(V(8127, 3000));
+  EXPECT_EQ(CurrentVersion(root()), V(8127, 3000));
+  EXPECT_FALSE(PreviousVersion(root()));
+  ExpectLaunchable();
+  EXPECT_FALSE(base::PathExists(root().AppendASCII("158.0.8127.3000.staging")));
+}
+
+TEST_F(ThoronUpdateSwapTest, AnUpdateKeepsTheVersionBeforeItAndNoOther) {
+  Install(V(8127, 3000));
+  Install(V(8127, 3010));
+  Install(V(8127, 3020));
+  EXPECT_EQ(CurrentVersion(root()), V(8127, 3020));
+  EXPECT_EQ(PreviousVersion(root()), V(8127, 3010));
+  EXPECT_FALSE(base::PathExists(VersionFolder(root(), V(8127, 3000))));
+  EXPECT_TRUE(VersionIsComplete(root(), V(8127, 3010), FilesOf(V(8127, 3010))));
+  ExpectLaunchable();
+}
+
+TEST_F(ThoronUpdateSwapTest, AStagedFolderThatIsNotTheVersionIsNeverSwitchedTo) {
+  Install(V(8127, 3000));
+  const BuildVersion next = V(8127, 3010);
+  std::vector<std::map<std::string, std::string>> wrong(4, Content(next));
+  wrong[0]["chrome.dll"][5] = 'x';              // a byte changed
+  wrong[1].erase("locales/en-US.pak");          // a file missing
+  wrong[2]["extra.dll"] = "not in the package";  // a file more
+  wrong[3]["thoron.exe"].pop_back();             // a file cut short
+  for (const auto& content : wrong) {
+    EXPECT_EQ(InstallVersion(root(), Stage(next, content), next, FilesOf(next)),
+              SwapResult::kBadFiles);
+    EXPECT_EQ(CurrentVersion(root()), V(8127, 3000));
+    EXPECT_FALSE(base::PathExists(VersionFolder(root(), next)));
+    EXPECT_FALSE(base::PathExists(root().AppendASCII("158.0.8127.3010.staging")));
+    ExpectLaunchable();
+  }
+}
+
+TEST_F(ThoronUpdateSwapTest, APathThatLeavesTheFolderIsRefused) {
+  for (const std::string path : {"../thoron.exe", "/thoron.exe", "a\\b.dll", "c:x.dll", ""}) {
+    std::vector<VersionFile> files = FilesOf(V(8127, 3010));
+    files[0].path = path;
+    EXPECT_EQ(InstallVersion(root(), Stage(V(8127, 3010)), V(8127, 3010), files),
+              SwapResult::kBadRequest)
+        << path;
+  }
+  EXPECT_EQ(InstallVersion(root(), Stage(V(8127, 3010)), BuildVersion(), FilesOf(V(8127, 3010))),
+            SwapResult::kBadRequest);
+}
+
+// The stage's test: a kill after every step leaves a browser that starts, and
+// the next run finishes the update.
+TEST_F(ThoronUpdateSwapTest, AKillAtEveryStepLeavesAVersionThatStarts) {
+  for (SwapStep step : {SwapStep::kVerified, SwapStep::kMoved, SwapStep::kSwitched,
+                        SwapStep::kCleaned}) {
+    SCOPED_TRACE(static_cast<int>(step));
+    ASSERT_TRUE(base::DeletePathRecursively(root()));
+    ASSERT_TRUE(base::CreateDirectory(root()));
+    Install(V(8127, 3000));
+    Install(V(8127, 3010));
+    const BuildVersion next = V(8127, 3020);
+    EXPECT_EQ(InstallVersion(root(), Stage(next), next, FilesOf(next), step),
+              SwapResult::kInterrupted);
+    ExpectLaunchable();
+    // before the switch the old version starts, after it the new one
+    EXPECT_EQ(CurrentVersion(root()),
+              step == SwapStep::kSwitched || step == SwapStep::kCleaned ? next : V(8127, 3010));
+    // and the version before the current one is still there
+    ASSERT_TRUE(PreviousVersion(root()));
+    EXPECT_TRUE(VersionIsComplete(root(), *PreviousVersion(root()), FilesOf(*PreviousVersion(root()))));
+    // run again: it goes on where it stopped
+    const base::FilePath staged = root().AppendASCII("158.0.8127.3020.staging");
+    const SwapResult again = InstallVersion(root(), staged, next, FilesOf(next));
+    EXPECT_TRUE(again == SwapResult::kDone || again == SwapResult::kAlreadyCurrent)
+        << SwapResultName(again);
+    CleanUp(root());
+    EXPECT_EQ(CurrentVersion(root()), next);
+    EXPECT_EQ(PreviousVersion(root()), V(8127, 3010));
+    EXPECT_FALSE(base::PathExists(VersionFolder(root(), V(8127, 3000))));
+    EXPECT_FALSE(base::PathExists(staged));
+    ExpectLaunchable();
+  }
+}
+
+TEST_F(ThoronUpdateSwapTest, LeftoversOfAKilledRunAreRemovedButNeverAVersionInUse) {
+  Install(V(8127, 3000));
+  Install(V(8127, 3010));
+  Stage(V(8127, 3020));                                                // a staged folder
+  ASSERT_TRUE(base::CreateDirectory(root().AppendASCII("158.0.8127.2990.removing")));
+  ASSERT_TRUE(base::CreateDirectory(root().AppendASCII("158.0.8127.2000")));  // an old version
+  CleanUp(root());
+  EXPECT_FALSE(base::PathExists(root().AppendASCII("158.0.8127.3020.staging")));
+  EXPECT_FALSE(base::PathExists(root().AppendASCII("158.0.8127.2990.removing")));
+  EXPECT_FALSE(base::PathExists(root().AppendASCII("158.0.8127.2000")));
+  EXPECT_TRUE(VersionIsComplete(root(), V(8127, 3010), FilesOf(V(8127, 3010))));
+  EXPECT_TRUE(VersionIsComplete(root(), V(8127, 3000), FilesOf(V(8127, 3000))));
+}
+
+TEST_F(ThoronUpdateSwapTest, WithoutAVersionThatStartsNothingIsRemoved) {
+  Stage(V(8127, 3020));
+  ASSERT_TRUE(base::CreateDirectory(root().AppendASCII("158.0.8127.2000")));
+  CleanUp(root());
+  EXPECT_TRUE(base::PathExists(root().AppendASCII("158.0.8127.3020.staging")));
+  EXPECT_TRUE(base::PathExists(root().AppendASCII("158.0.8127.2000")));
+}
+
+// P3.8, the program's half: update, roll back, and the folders are as before.
+TEST_F(ThoronUpdateSwapTest, RollingBackStartsThePreviousVersionByteForByte) {
+  EXPECT_EQ(RollBack(root()), SwapResult::kNothingToRollBack);
+  Install(V(8127, 3000));
+  EXPECT_EQ(RollBack(root()), SwapResult::kNothingToRollBack);
+  Install(V(8127, 3010));
+  EXPECT_EQ(RollBack(root()), SwapResult::kDone);
+  EXPECT_EQ(CurrentVersion(root()), V(8127, 3000));
+  EXPECT_EQ(PreviousVersion(root()), V(8127, 3010));
+  ExpectLaunchable();
+  // the files of both are exactly the packages'
+  EXPECT_TRUE(VersionIsComplete(root(), V(8127, 3000), FilesOf(V(8127, 3000))));
+  EXPECT_TRUE(VersionIsComplete(root(), V(8127, 3010), FilesOf(V(8127, 3010))));
+  // and it can be undone
+  EXPECT_EQ(RollBack(root()), SwapResult::kDone);
+  EXPECT_EQ(CurrentVersion(root()), V(8127, 3010));
+  CleanUp(root());
+  EXPECT_TRUE(VersionIsComplete(root(), V(8127, 3000), FilesOf(V(8127, 3000))));
+}
+
+TEST_F(ThoronUpdateSwapTest, ThePointerFileIsReadStrictly) {
+  Install(V(8127, 3000));
+  const base::FilePath pointer = root().AppendASCII("current");
+  for (const std::string& text :
+       std::vector<std::string>{"", "158.0.8127\n", "158.0.8127.03000\n", "158.0.8127.9999\n",
+                                std::string(100, '1')}) {
+    ASSERT_TRUE(base::WriteFile(pointer, text));
+    EXPECT_FALSE(CurrentVersion(root())) << text;
+  }
+}
+
+TEST(ThoronUpdateSwapRelaunchTest, AfterAnUpdateTheRelaunchStartsTheCurrentVersion) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath root = dir.GetPath().AppendASCII("Application");
+  for (const char* version : {"158.0.8127.3000", "158.0.8127.3010"}) {
+    ASSERT_TRUE(base::CreateDirectory(root.AppendASCII(version)));
+    ASSERT_TRUE(base::WriteFile(root.AppendASCII(version).AppendASCII("thoron.exe"), version));
+  }
+  const base::FilePath old_exe = root.AppendASCII("158.0.8127.3000").AppendASCII("thoron.exe");
+  base::FilePath next;
+  // no `current`: nothing to change
+  EXPECT_FALSE(BrowserOfCurrentVersion(old_exe, &next));
+  ASSERT_TRUE(base::WriteFile(root.AppendASCII("current"), "158.0.8127.3000\n"));
+  EXPECT_FALSE(BrowserOfCurrentVersion(old_exe, &next));   // it is the current one
+  ASSERT_TRUE(base::WriteFile(root.AppendASCII("current"), "158.0.8127.3010\n158.0.8127.3000\n"));
+  ASSERT_TRUE(BrowserOfCurrentVersion(old_exe, &next));
+  EXPECT_EQ(next, root.AppendASCII("158.0.8127.3010").AppendASCII("thoron.exe"));
+  // an installed copy runs from Application\thoron.exe, not from a version folder
+  EXPECT_FALSE(BrowserOfCurrentVersion(root.AppendASCII("thoron.exe"), &next));
+}
+
+}  // namespace
+}  // namespace thoron_update
