+
+MailService::MailService(PrefService* prefs, FactoryGetter factory)
+    : prefs_(prefs), factory_(std::move(factory)) {}
+
+MailService::~MailService() = default;
+
+void MailService::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void MailService::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void MailService::Start() {
+  if (started_) {
+    return;
+  }
+  started_ = true;
+  timer_.Start(FROM_HERE, kFirstLook,
+               base::BindOnce(&MailService::CheckNow, base::Unretained(this)));
+}
+
+int MailService::total_unread() const {
+  int total = 0;
+  for (const MailAccount& account : accounts_) {
+    if (watched(account.email)) {
+      total += account.unread;
+    }
+  }
+  return total;
+}
+
+base::Time MailService::Looked(const std::string& email) const {
+  if (prefs_) {
+    if (std::optional<double> ms =
+            prefs_->GetDict(kLookedPref).FindDouble(email)) {
+      return base::Time::FromMillisecondsSinceUnixEpoch(*ms);
+    }
+  }
+  return first_look_;
+}
+
+int MailService::new_count(const MailAccount& account) const {
+  const base::Time looked = Looked(account.email);
+  int count = 0;
+  for (const MailMessage& message : account.latest) {
+    // a message without a time is new until the person looks
+    if (message.issued.is_null() || message.issued > looked) {
+      ++count;
+    }
+  }
+  return count;
+}
+
+int MailService::total_new() const {
+  int total = 0;
+  for (const MailAccount& account : accounts_) {
+    if (watched(account.email)) {
+      total += new_count(account);
+    }
+  }
+  return total;
+}
+
+int MailService::icon_count() const {
+  return Choice("count") == "unread" ? total_unread() : total_new();
+}
+
+void MailService::MarkLooked(const std::string& email) {
+  if (!prefs_ || email.empty()) {
+    return;
+  }
+  base::DictValue looked = prefs_->GetDict(kLookedPref).Clone();
+  // only the accounts there are now, and a few more
+  if (looked.size() >= kMostLooked) {
+    base::DictValue kept;
+    for (const MailAccount& account : accounts_) {
+      if (const base::Value* at = looked.Find(account.email)) {
+        kept.Set(account.email, at->Clone());
+      }
+    }
+    looked = std::move(kept);
+  }
+  looked.Set(email, base::Time::Now().InMillisecondsFSinceUnixEpoch());
+  prefs_->SetDict(kLookedPref, std::move(looked));
+  observers_.Notify(&Observer::OnMailChanged);
+}
+
+bool MailService::watched(const std::string& email) const {
+  if (!prefs_) {
+    return true;
+  }
+  for (const base::Value& ignored : prefs_->GetList(kIgnoredPref)) {
+    if (ignored.is_string() && ignored.GetString() == email) {
+      return false;
+    }
+  }
+  return true;
+}
+
+void MailService::SetWatched(const std::string& email, bool on) {
+  if (!prefs_ || email.empty() || watched(email) == on) {
+    return;
+  }
+  base::ListValue ignored = prefs_->GetList(kIgnoredPref).Clone();
+  if (on) {
+    ignored.EraseIf([&](const base::Value& value) {
+      return value.is_string() && value.GetString() == email;
+    });
+  } else if (ignored.size() < kMostLooked) {
+    ignored.Append(email);
+  }
+  prefs_->SetList(kIgnoredPref, std::move(ignored));
+  observers_.Notify(&Observer::OnMailChanged);
+}
+
+// static
+bool MailService::KnownChoice(const std::string& name,
+                              const std::string& value) {
+  const ChoiceValues* choice = FindChoice(name);
+  if (!choice) {
+    return false;
+  }
+  for (const char* known : choice->values) {
+    if (known && value == known) {
+      return true;
+    }
+  }
+  return false;
+}
+
+std::string MailService::Choice(const std::string& name) const {
+  const ChoiceValues* choice = FindChoice(name);
+  if (!choice) {
+    return std::string();
+  }
+  const std::string value =
+      prefs_ ? prefs_->GetString("thoron_mail." + name) : std::string();
+  return KnownChoice(name, value) ? value : choice->values[0];
+}
+
+bool MailService::SetChoice(const std::string& name, const std::string& value) {
+  if (!prefs_ || !KnownChoice(name, value)) {
+    return false;
+  }
+  prefs_->SetString("thoron_mail." + name, value);
+  observers_.Notify(&Observer::OnMailChanged);
+  return true;
+}
+
+int MailService::interval_minutes() const {
+  const int minutes = prefs_ ? prefs_->GetInteger(kIntervalPref) : 0;
+  return std::ranges::find(kIntervals, minutes) != std::end(kIntervals)
+             ? minutes
+             : kDefaultInterval;
+}
+
+bool MailService::SetInterval(int minutes) {
+  if (!prefs_ ||
+      std::ranges::find(kIntervals, minutes) == std::end(kIntervals)) {
+    return false;
+  }
+  prefs_->SetInteger(kIntervalPref, minutes);
+  if (!checking_ && started_) {
+    Reschedule();
+  }
+  observers_.Notify(&Observer::OnMailChanged);
+  return true;
+}
+
+bool MailService::notify() const {
+  return prefs_ && prefs_->GetBoolean(kNotifyPref);
+}
+
+void MailService::SetNotify(bool on) {
+  if (prefs_) {
+    prefs_->SetBoolean(kNotifyPref, on);
+  }
+  observers_.Notify(&Observer::OnMailChanged);
+}
+
+void MailService::SetContextGetter(ContextGetter context) {
+  context_ = std::move(context);
+}
+
+void MailService::SetGoogleSignedIn(GoogleSignedIn signed_in) {
+  google_signed_in_ = std::move(signed_in);
+}
+
+bool MailService::AsksGmail() const {
+  // a local server that stands in for Gmail (the checks) is always asked
+  if (FeedUrl(0, /*spam=*/false).host() != "mail.google.com") {
+    return true;
+  }
+  return !google_signed_in_ || google_signed_in_.Run();
+}
+
+void MailService::SetImapAccounts(std::vector<ImapAccount> accounts) {
+  if (accounts.size() > kMostImapAccounts) {
+    accounts.resize(kMostImapAccounts);
+  }
+  imap_ = std::move(accounts);
+  if (!started_) {
+    return;
+  }
+  if (checking_) {
+    look_again_ = true;
+  } else {
+    CheckNow();
+  }
+}
+
+GURL MailService::FeedUrl(int index, bool spam) const {
+  // Gmail's feed of unread mail: of the inbox as it is, of one label after
+  // it. The inbox's Primary tab is the label "^sq_ig_i_personal".
+  std::string path = "mail/u/" + base::NumberToString(index) + "/feed/atom";
+  if (spam) {
+    path += "/spam";
+  } else if (Choice("which") == "primary" && !primary_refused_) {
+    path += "/%5Esq_ig_i_personal";
+  }
+  const std::string base =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          kFeedsForTesting);
+  const GURL testing(base);
+  // only a local server stands in for Gmail
+  if (testing.is_valid() && net::IsLocalhost(testing)) {
+    return testing.Resolve(path);
+  }
+  return GURL("https://mail.google.com/").Resolve(path);
+}
+
+// static
+GURL MailService::InboxUrl(int index) {
+  return GURL("https://mail.google.com/mail/u/" + base::NumberToString(index) +
+              "/#inbox");
+}
+
+void MailService::CheckNow() {
+  if (checking_) {
+    return;
+  }
+  timer_.Stop();
+  checking_ = true;
+  look_again_ = false;
+  primary_refused_ = false;
+  next_.clear();
+  observers_.Notify(&Observer::OnMailChanged);
+  if (!AsksGmail()) {
+    // S.15: nobody is signed in to Google here, so Gmail is not asked: it
+    // would only answer that nobody is.
+    CheckImap(0, "signed-out");
+    return;
+  }
+  Fetch(0, /*spam=*/false);
+}
+
+void MailService::Fetch(int index, bool spam) {
+  scoped_refptr<network::SharedURLLoaderFactory> factory =
+      factory_ ? factory_.Run() : nullptr;
+  if (!factory) {
+    Finish("error");
+    return;
+  }
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = FeedUrl(index, spam);
+  request->method = "GET";
+  // as Gmail's own page asks: the profile's sign-in for mail.google.com
+  request->credentials_mode = network::mojom::CredentialsMode::kInclude;
+  request->site_for_cookies = net::SiteForCookies::FromUrl(request->url);
+  request->request_initiator = url::Origin::Create(request->url);
+  request->load_flags = net::LOAD_DISABLE_CACHE;
+  request->headers.SetHeader("Accept", "application/atom+xml");
+  loader_ =
+      network::SimpleURLLoader::Create(std::move(request), kTrafficAnnotation);
+  loader_->SetTimeoutDuration(kTimeout);
+  // Without a sign-in Gmail answers 401: no account there, not a failure.
+  loader_->SetAllowHttpErrorResults(true);
+  loader_->DownloadToString(
+      factory.get(),
+      base::BindOnce(&MailService::OnFetched, weak_factory_.GetWeakPtr(),
+                     index, spam),
+      kMostBytes);
+}
+
+void MailService::OnFetched(int index,
+                            bool spam,
+                            std::optional<std::string> body) {
+  const int status = loader_ && loader_->ResponseInfo() &&
+                             loader_->ResponseInfo()->headers
+                         ? loader_->ResponseInfo()->headers->response_code()
+                         : 0;
+  const int net_error = loader_ ? loader_->NetError() : 0;
+  loader_.reset();
+  if (spam && (!body || status != 200)) {
+    // the spam could not be read: the account is counted without it
+    AfterAccount(index, /*spam_done=*/true);
+    return;
+  }
+  if ((!body || status != 200) && Choice("which") == "primary" &&
+      !primary_refused_ && (status == 400 || status == 404)) {
+    // Gmail does not know the Primary tab's label here: the whole inbox
+    primary_refused_ = true;
+    Fetch(index, /*spam=*/false);
+    return;
+  }
+  if (!body || status != 200) {
+    // The first account that is not there ends the Google accounts. None at
+    // all: signed out (401 or a page to sign in), or the network.
+    std::string problem;
+    if (next_.empty()) {
+      problem = status == 401 || status == 302 || status == 403 ? "signed-out"
+                : status == 0 && net_error != 0                 ? "offline"
+                                                                : "error";
+    }
+    CheckImap(0, std::move(problem));
+    return;
+  }
+  data_decoder::DataDecoder::ParseXmlIsolated(
+      *body, data_decoder::mojom::XmlParser::WhitespaceBehavior::kIgnore,
+      base::BindOnce(&MailService::OnParsed, weak_factory_.GetWeakPtr(), index,
+                     spam));
+}
+
+void MailService::OnParsed(int index,
+                           bool spam,
+                           data_decoder::DataDecoder::ValueOrError result) {
+  std::optional<MailAccount> account =
+      result.has_value() ? AccountFromFeed(*result, index) : std::nullopt;
+  if (spam) {
+    // the account's spam, added to what its inbox has: newest first
+    if (account && !next_.empty() && next_.back().email == account->email) {
+      MailAccount& into = next_.back();
+      into.unread += account->unread;
+      for (MailMessage& message : account->latest) {
+        message.spam = true;
+        into.latest.push_back(std::move(message));
+      }
+      std::ranges::stable_sort(into.latest, [](const MailMessage& a,
+                                               const MailMessage& b) {
+        return a.issued > b.issued;
+      });
+      if (into.latest.size() > 20) {
+        into.latest.resize(20);
+      }
+    }
+    AfterAccount(index, /*spam_done=*/true);
+    return;
+  }
+  // Gmail answers an index past the last account with the first one again
+  const bool again = account && std::ranges::any_of(
+                                    next_, [&](const MailAccount& known) {
+                                      return known.email == account->email;
+                                    });
+  if (!account || again) {
+    CheckImap(0, !next_.empty() ? std::string() : "signed-out");
+    return;
+  }
+  next_.push_back(std::move(*account));
+  AfterAccount(index, /*spam_done=*/false);
+}
+
+void MailService::AfterAccount(int index, bool spam_done) {
+  if (!spam_done && Choice("which") == "all") {
+    Fetch(index, /*spam=*/true);
+    return;
+  }
+  if (index + 1 >= kMostAccounts) {
+    CheckImap(0, std::string());
+    return;
+  }
+  Fetch(index + 1, /*spam=*/false);
+}
+
+void MailService::CheckImap(size_t at, std::string problem) {
+  // The network is away (the Google accounts could not be asked): the
+  // mailboxes are not tried either, and what the last look found stays.
+  network::mojom::NetworkContext* context =
+      context_ && at < imap_.size() && problem != "offline" &&
+              problem != "error"
+          ? context_.Run()
+          : nullptr;
+  if (!context) {
+    // Signed out of Google is no problem of a look that has mailboxes.
+    Finish(problem == "signed-out" &&
+                   std::ranges::any_of(next_, &MailAccount::imap)
+               ? std::string()
+               : std::move(problem));
+    return;
+  }
+  imap_check_ = std::make_unique<ImapCheck>(
+      context, imap_[at],
+      base::BindOnce(&MailService::OnImapChecked, weak_factory_.GetWeakPtr(),
+                     at, std::move(problem)));
+}
+
+void MailService::OnImapChecked(size_t at,
+                                std::string problem,
+                                ImapCheck::Result result) {
+  // the look at this mailbox is over (this runs from inside it)
+  std::unique_ptr<ImapCheck> finished = std::move(imap_check_);
+  base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+      FROM_HERE, std::move(finished));
+  if (at < imap_.size()) {
+    MailAccount account;
+    account.index = kFirstImapIndex + static_cast<int>(at);
+    account.email = imap_[at].email;
+    account.imap = true;
+    account.webmail = imap_[at].webmail;
+    account.problem = result.problem;
+    if (result.problem.empty()) {
+      account.unread = result.unread;
+      account.latest = std::move(result.latest);
+    } else {
+      // a look that failed keeps what the last one found
+      for (const MailAccount& known : accounts_) {
+        if (known.imap && known.email == account.email) {
+          account.unread = known.unread;
+          account.latest = known.latest;
+        }
+      }
+    }
+    // an address is shown once: a Google account of the same name stays
+    if (std::ranges::none_of(next_, [&](const MailAccount& known) {
+          return known.email == account.email;
+        })) {
+      next_.push_back(std::move(account));
+    }
+  }
+  CheckImap(at + 1, std::move(problem));
+}
+
+void MailService::Finish(std::string problem) {
+  checking_ = false;
+  last_check_ = base::Time::Now();
+  problem_ = std::move(problem);
+  // A failed look keeps what the last one found, as it was.
+  if (problem_.empty() || problem_ == "signed-out") {
+    accounts_ = std::move(next_);
+    std::map<std::string, std::set<std::string>> seen;
+    for (const MailAccount& account : accounts_) {
+      // An account that was not there at the last look (just added, or just
+      // signed in to) is only learned: what it has is not new mail.
+      const bool known_account = seen_.contains(account.email);
+      std::set<std::string>& known = seen_[account.email];
+      std::vector<MailMessage> fresh;
+      // remembered also while it has no unread mail
+      std::set<std::string>& now = seen[account.email];
+      for (const MailMessage& message : account.latest) {
+        if (!known.contains(message.id)) {
+          fresh.push_back(message);
+        }
+        now.insert(message.id);
+      }
+      if (first_look_done_ && known_account && !fresh.empty() &&
+          watched(account.email)) {
+        observers_.Notify(&Observer::OnNewMail, account, fresh);
+      }
+    }
+    // only what is still unread is remembered
+    seen_ = std::move(seen);
+    if (!first_look_done_) {
+      // what was there at the first look is not new
+      first_look_ = base::Time::Now();
+    }
+    first_look_done_ = true;
+    // An account seen for the first time is looked at from now: what it has
+    // is not new, what comes later is, also across restarts.
+    if (prefs_) {
+      base::DictValue looked = prefs_->GetDict(kLookedPref).Clone();
+      bool added = false;
+      for (const MailAccount& account : accounts_) {
+        if (!looked.contains(account.email) && looked.size() < kMostLooked) {
+          looked.Set(account.email,
+                     base::Time::Now().InMillisecondsFSinceUnixEpoch());
+          added = true;
+        }
+      }
+      if (added) {
+        prefs_->SetDict(kLookedPref, std::move(looked));
+      }
+    }
+  }
+  next_.clear();
+  observers_.Notify(&Observer::OnMailChanged);
+  if (look_again_) {
+    // the mailboxes changed meanwhile
+    CheckNow();
+    return;
+  }
+  Reschedule();
+}
+
+void MailService::Reschedule() {
+  timer_.Start(FROM_HERE, base::Minutes(interval_minutes()),
+               base::BindOnce(&MailService::CheckNow, base::Unretained(this)));
+}
