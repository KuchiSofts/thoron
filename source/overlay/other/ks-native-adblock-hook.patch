diff --git a/components/thoron_mail/mail_sounds.cc b/components/thoron_mail/mail_sounds.cc
new file mode 100644
index 0000000000000000000000000000000000000000..8424b529d823823318c6a134272c85161c2fa54f
--- /dev/null
+++ b/components/thoron_mail/mail_sounds.cc
@@ -0,0 +1,209 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_mail/mail_sounds.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+#include "base/no_destructor.h"
+
+namespace thoron_mail {
+
+namespace {
+
+constexpr int kRate = 44100;
+constexpr double kTwoPi = 6.283185307179586;
+// every tone fades out over its last 15 ms, so no sound ends in a click
+constexpr double kRelease = 0.015;
+
+// An overtone: its pitch as a multiple of the tone's, and how loud it is.
+struct Partial {
+  double ratio;
+  double level;
+};
+
+// One struck or sung note of a sound.
+struct Tone {
+  double start;     // seconds from the sound's start
+  double freq;      // Hz
+  double freq_end;  // Hz at the end of the glide; 0: no glide
+  double glide;     // seconds the pitch takes to move to `freq_end`
+  double decay;     // seconds for the note to fall to a third (1/e)
+  double length;    // seconds it lasts
+  double level;     // 0 to 1
+};
+
+struct Design {
+  const char* name;
+  double attack;  // seconds to full strength
+  std::vector<Partial> partials;
+  std::vector<Tone> tones;
+};
+
+// The sounds, made of tones whose pitches are those of the equal-tempered
+// scale (C6 = 1046.50 Hz). Bell-like sounds take overtones that are not whole
+// multiples, as a struck bell's are.
+const std::vector<Design>& Designs() {
+  static const base::NoDestructor<std::vector<Design>> designs([] {
+    return std::vector<Design>{
+      {"chime",
+       0.004,
+       {{1, 1}, {2, 0.35}, {3, 0.12}, {4.2, 0.06}},
+       {{0, 1046.50, 0, 0, 0.35, 0.9, 0.8}, {0.13, 1318.51, 0, 0, 0.45, 1.1, 0.9}}},
+      {"bell",
+       0.002,
+       {{1, 1}, {2.76, 0.45}, {5.40, 0.25}, {8.93, 0.12}},
+       {{0, 783.99, 0, 0, 0.7, 1.6, 1}}},
+      {"marimba",
+       0.002,
+       {{1, 1}, {3.93, 0.3}, {10.0, 0.05}},
+       {{0, 1046.50, 0, 0, 0.14, 0.45, 0.9},
+        {0.09, 1318.51, 0, 0, 0.14, 0.45, 0.9},
+        {0.18, 1567.98, 0, 0, 0.16, 0.5, 1}}},
+      {"pop",
+       0.002,
+       {{1, 1}, {2, 0.15}},
+       {{0, 420, 980, 0.05, 0.05, 0.16, 1}, {0.11, 520, 1180, 0.05, 0.05, 0.16, 0.8}}},
+      {"drops",
+       0.001,
+       {{1, 1}},
+       {{0, 1900, 1100, 0.07, 0.06, 0.14, 1},
+        {0.12, 1600, 900, 0.07, 0.06, 0.14, 0.85},
+        {0.22, 2100, 1250, 0.06, 0.05, 0.12, 0.7}}},
+      {"bright",
+       0.003,
+       {{1, 1}, {2, 0.25}, {3, 0.1}},
+       {{0, 1046.50, 0, 0, 0.2, 0.55, 0.8},
+        {0.07, 1318.51, 0, 0, 0.2, 0.55, 0.8},
+        {0.14, 1567.98, 0, 0, 0.2, 0.55, 0.8},
+        {0.21, 2093.00, 0, 0, 0.3, 0.7, 0.9}}},
+      {"soft",
+       0.03,
+       {{1, 1}, {2, 0.08}},
+       {{0, 523.25, 0, 0, 0.5, 1.0, 0.7}, {0.18, 659.26, 0, 0, 0.6, 1.1, 0.7}}},
+      {"knock",
+       0.001,
+       {{1, 1}, {2.3, 0.3}},
+       {{0, 190, 150, 0.04, 0.045, 0.12, 1}, {0.16, 190, 150, 0.04, 0.045, 0.12, 0.9}}},
+      {"ding", 0.003, {{1, 1}, {2, 0.2}, {3, 0.05}}, {{0, 1567.98, 0, 0, 0.5, 1.0, 1}}},
+      {"beeps",
+       0.003,
+       {{1, 1}, {3, 0.33}, {5, 0.2}},
+       {{0, 1318.51, 0, 0, 1, 0.09, 0.8}, {0.14, 1318.51, 0, 0, 1, 0.09, 0.8}}},
+    };
+  }());
+  return *designs;
+}
+
+const Design* FindDesign(std::string_view name) {
+  for (const Design& design : Designs()) {
+    if (name == design.name) {
+      return &design;
+    }
+  }
+  return nullptr;
+}
+
+void Append16(std::string& out, uint16_t value) {
+  out.push_back(static_cast<char>(value & 0xff));
+  out.push_back(static_cast<char>(value >> 8));
+}
+
+void Append32(std::string& out, uint32_t value) {
+  Append16(out, static_cast<uint16_t>(value & 0xffff));
+  Append16(out, static_cast<uint16_t>(value >> 16));
+}
+
+}  // namespace
+
+const std::vector<std::string>& MadeSoundNames() {
+  static const base::NoDestructor<std::vector<std::string>> names([] {
+    std::vector<std::string> out;
+    for (const Design& design : Designs()) {
+      out.emplace_back(design.name);
+    }
+    return out;
+  }());
+  return *names;
+}
+
+bool IsKnownSound(std::string_view name) {
+  return name == kSystemSound || FindDesign(name);
+}
+
+std::string MakeSoundWav(std::string_view name, int volume) {
+  const Design* design = FindDesign(name);
+  if (!design) {
+    return std::string();
+  }
+  volume = std::clamp(volume, 0, 100);
+  double total = 0;
+  for (const Tone& tone : design->tones) {
+    total = std::max(total, tone.start + tone.length);
+  }
+  const size_t count = static_cast<size_t>((total + 0.02) * kRate);
+  std::vector<double> mix(count, 0.0);
+  for (const Tone& tone : design->tones) {
+    const size_t first = static_cast<size_t>(tone.start * kRate);
+    const size_t length = static_cast<size_t>(tone.length * kRate);
+    std::vector<double> phase(design->partials.size(), 0.0);
+    for (size_t i = 0; i < length && first + i < count; ++i) {
+      const double t = static_cast<double>(i) / kRate;
+      double freq = tone.freq;
+      if (tone.freq_end > 0 && tone.glide > 0) {
+        freq = t < tone.glide
+                   ? tone.freq + (tone.freq_end - tone.freq) * (t / tone.glide)
+                   : tone.freq_end;
+      }
+      const double rise = design->attack > 0 ? std::min(1.0, t / design->attack) : 1.0;
+      const double fall = std::min(1.0, (tone.length - t) / kRelease);
+      const double envelope = rise * std::exp(-t / tone.decay) * std::max(0.0, fall);
+      double sample = 0;
+      for (size_t p = 0; p < design->partials.size(); ++p) {
+        const Partial& partial = design->partials[p];
+        // an overtone above what the file can hold is left out
+        if (freq * partial.ratio >= kRate / 2.0) {
+          continue;
+        }
+        phase[p] += kTwoPi * freq * partial.ratio / kRate;
+        sample += partial.level * std::sin(phase[p]);
+      }
+      mix[first + i] += tone.level * envelope * sample;
+    }
+  }
+  double peak = 0;
+  for (double value : mix) {
+    peak = std::max(peak, std::abs(value));
+  }
+  // loudness follows the slider the way ears hear it: half way is clearly
+  // quieter, not a little; the loudest sample stays below the volume's share
+  const double share = std::pow(volume / 100.0, 1.5) * 0.95;
+  const double gain = peak > 0 ? share / peak : 0;
+  std::string data;
+  data.reserve(count * 2);
+  for (double value : mix) {
+    const long sample =
+        std::lround(std::clamp(value * gain, -1.0, 1.0) * 32767.0);
+    Append16(data, static_cast<uint16_t>(static_cast<int16_t>(sample)));
+  }
+  std::string wav;
+  wav.reserve(44 + data.size());
+  wav += "RIFF";
+  Append32(wav, static_cast<uint32_t>(36 + data.size()));
+  wav += "WAVEfmt ";
+  Append32(wav, 16);         // the size of the format block
+  Append16(wav, 1);          // PCM
+  Append16(wav, 1);          // one channel
+  Append32(wav, kRate);
+  Append32(wav, kRate * 2);  // bytes a second
+  Append16(wav, 2);          // bytes a sample
+  Append16(wav, 16);         // bits a sample
+  wav += "data";
+  Append32(wav, static_cast<uint32_t>(data.size()));
+  wav += data;
+  return wav;
+}
+
+}  // namespace thoron_mail
