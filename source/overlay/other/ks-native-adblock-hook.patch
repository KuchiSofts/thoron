@@ -0,0 +1,735 @@
+#!/usr/bin/env python3
+# Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+"""Makes manifest_test_vectors.h, the test vectors of manifest_unittest.cc (ROADMAP P3.3).
+
+Every vector is made by the reference tool, tools/update/manifest.py of Thoron's repository: the manifest
+bytes, the signature, and what check_update() there makes of them. The cases are those of the tool's own
+tests (tools/update/tests/test_manifest.py), so the C++ updater is held to the same answers.
+
+    py -3 -I make_test_vectors.py --repo <Thoron's repository>            write the header next to this file
+    py -3 -I make_test_vectors.py --repo <Thoron's repository> --check    exit 1 when the header differs
+
+TEST KEY ONLY. The key these vectors are signed with is no secret and no release key: its private half is
+the SHA-256 of TEST_KEY_PHRASE below, so anyone can make the same vectors again. No build of Thoron trusts
+it. Needs the Python package cryptography.
+"""
+import argparse
+import base64
+import hashlib
+import json
+import random
+import re
+import sys
+from pathlib import Path
+
+HEADER_NAME = "manifest_test_vectors.h"
+TEST_KEY_PHRASE = b"thoron-update test vectors: a key for tests only, never a release key"
+OTHER_KEY_PHRASE = b"thoron-update test vectors: another key for tests only"
+ORDER = 2**252 + 27742317777372353535851937790883648493      # the order of the Ed25519 group
+MIN_SHARED = 16     # a vector that shares less with the example is written out whole
+
+
+class Vectors:
+    def __init__(self, repo: Path):
+        sys.path.insert(0, str(repo))
+        from tools.update import manifest as mf
+        from tools.update.tests import test_manifest as cases
+        from cryptography.hazmat.primitives.asymmetric import ed25519
+        self.mf, self.cases, self.ed25519 = mf, cases, ed25519
+        self.spec = (repo / "docs" / "update" / "MANIFEST.md").read_text(encoding="utf-8")
+        self.private = hashlib.sha256(TEST_KEY_PHRASE).digest()
+        self.public = mf.public_key_of(self.private)
+        self.other_private = hashlib.sha256(OTHER_KEY_PHRASE).digest()
+        self.other_public = mf.public_key_of(self.other_private)
+        self.example = mf.example()
+        # The copy most vectors are checked for; a vector names only what it changes.
+        self.copy = dict(channel="stable", installed=cases.OLD, updater=cases.OLD, variant="win-x64-avx2",
+                         kind="installed", now=cases.NOW, last_serial=0)
+        self.signature = mf.sign(self.example, self.private, self.public, allowed_hosts=cases.HOSTS,
+                                 now=cases.NOW)
+        assert self.signature == self.raw_signature(mf.signed_message(self.example))
+        # Files that many vectors name: written once, under a name.
+        packages = cases.sample()["packages"]
+        self.known = {
+            self.written(packages["win-x64-avx2"]["installed"]["full"]): "kExampleFull",
+            self.written(packages["win-x64-avx2"]["installed"]["deltas"][cases.OLD]): "kExampleDelta",
+            self.written(packages["win-x64-avx2"]["portable"]["full"]): "kExamplePortable",
+            self.written(packages["win-x64-sse4"]["installed"]["full"]): "kExampleSse4",
+            self.written(cases.ENTRY): "kPlainFile",
+        }
+        self.out: list[str] = []
+        self.names: set[str] = set()
+        self.count = 0
+
+    # --- signing ---------------------------------------------------------------------------------------
+
+    def raw_signature(self, message: bytes, private: bytes = None) -> bytes:
+        """An Ed25519 signature of any bytes, as a careless or hostile holder of the key could make."""
+        return self.ed25519.Ed25519PrivateKey.from_private_bytes(private or self.private).sign(message)
+
+    def signed(self, manifest: bytes) -> bytes:
+        """The signature of these bytes as a manifest's, valid or not: prefix, then the bytes."""
+        return self.raw_signature(self.mf.signed_message(manifest))
+
+    def fits(self, message: bytes, signature: bytes, key: bytes) -> bool:
+        """The bare Ed25519 check, without the tool's look at the key."""
+        from cryptography.exceptions import InvalidSignature
+        try:
+            self.ed25519.Ed25519PublicKey.from_public_bytes(key).verify(signature, message)
+        except (InvalidSignature, ValueError):
+            return False
+        return True
+
+    # --- writing ---------------------------------------------------------------------------------------
+
+    def section(self, title: str) -> None:
+        self.out.append(f"\n    // --- {title} ---\n")
+
+    def add(self, name: str, manifest: bytes = None, signature: bytes = None, key: bytes = None,
+            hosts=None, expect=None, repeat: tuple = None, **state) -> str:
+        """One vector: what the reference makes of these two files for this copy. `repeat` is (bytes,
+        count) for a manifest of one stretch of bytes many times over."""
+        mf, cases = self.mf, self.cases
+        if repeat:
+            manifest = repeat[0] * repeat[1]
+        elif manifest is None:
+            manifest = self.example
+        if signature is None:
+            signature = self.signature if manifest == self.example else self.signed(manifest)
+        key = self.public if key is None else key
+        hosts = cases.HOSTS if hosts is None else hosts
+        copy = dict(self.copy)
+        copy.update(state)
+        try:
+            decision = mf.check_update(manifest, signature, key, allowed_hosts=hosts, **copy)
+            outcome = decision.outcome
+        except ValueError:      # what the caller got wrong: the reference raises, the updater says so
+            decision, outcome = None, "invalid_copy"
+        if expect is not None and outcome not in ((expect,) if isinstance(expect, str) else expect):
+            raise SystemExit(f"{name}: the reference says {outcome}, this script expected {expect}")
+        if name in self.names or not re.fullmatch(r"[ -~]+", name) or '"' in name or "\\" in name:
+            raise SystemExit(f"a vector needs a plain name of its own: {name!r}")
+        self.names.add(name)
+        self.count += 1
+
+        fields = [f'.name = "{name}"']
+        if repeat:
+            fields += [self.bytes_field(repeat[0]), f".repeat = {repeat[1]}"]
+        else:
+            front, back = self.shared(manifest)
+            if front:
+                fields.append(f".keep_front = {front}")
+            middle = manifest[front:len(manifest) - back]
+            if middle:
+                fields.append(self.bytes_field(middle))
+            if back:
+                fields.append(f".keep_back = {back}")
+        if signature != self.signature:
+            fields.append(".signature = " + self.hex_literal(signature, 18))
+        if key != self.public:
+            fields.append(".public_key = " + self.hex_literal(key, 19))
+        if tuple(hosts) != tuple(cases.HOSTS):
+            fields.append(".hosts = " + self.text_literal(" ".join(hosts).encode("ascii"), 14))
+        for field in ("channel", "installed", "updater", "variant", "kind"):
+            if copy[field] != self.copy[field]:
+                fields.append(f".{field} = " + self.text_literal(copy[field].encode("ascii"), 9 + len(field)))
+        for field in ("now", "last_serial"):
+            if copy[field] != self.copy[field]:
+                fields.append(f".{field} = {self.number(copy[field])}")
+        fields.append(f'.outcome = "{outcome}"')
+        if decision is not None and decision.remember_serial is not None:
+            fields.append(f".remember_serial = {decision.remember_serial}")
+        for field in ("full", "delta"):
+            entry = getattr(decision, field, None)
+            if entry:
+                written = self.written(entry)
+                fields.append(f".{field} = " + (self.known.get(written) or
+                                                 self.text_literal(written, 9 + len(field))))
+        self.out.append("    {" + ",\n     ".join(fields) + "},\n")
+        return outcome
+
+    def shared(self, manifest: bytes) -> tuple[int, int]:
+        """How many bytes a manifest has in common with the example, at its start and at its end."""
+        example, front = self.example, 0
+        limit = min(len(manifest), len(example))
+        while front < limit and manifest[front] == example[front]:
+            front += 1
+        back = 0
+        while back < limit - front and manifest[-1 - back] == example[-1 - back]:
+            back += 1
+        return (front, back) if front + back >= MIN_SHARED else (0, 0)
+
+    @staticmethod
+    def written(entry: dict) -> bytes:
+        """A file as the vectors name it: its size, its SHA-256 and its address."""
+        return f"{entry['size']} {entry['sha256']} {entry['url']}".encode("ascii")
+
+    def bytes_field(self, data: bytes) -> str:
+        if re.fullmatch(rb"[\n -~]*", data):
+            return ".changed = " + self.text_literal(data, 16)
+        return ".changed_hex = " + self.hex_literal(data, 20)
+
+    @staticmethod
+    def text_literal(data: bytes, column: int, width: int = 96) -> str:
+        """Printable ASCII and LF as C++ string literals: one for each line of the text, cut when long."""
+        assert re.fullmatch(rb"[\n -~]*", data), data
+        pieces = []
+        for line in data.decode("ascii").splitlines(keepends=True) or [""]:
+            for at in range(0, max(len(line), 1), width):
+                piece = line[at:at + width]
+                pieces.append(piece.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n"))
+        return ("\n" + " " * column).join(f'"{piece}"' for piece in pieces)
+
+    @staticmethod
+    def hex_literal(data: bytes, column: int) -> str:
+        text = data.hex()
+        pieces = [text[at:at + 64] for at in range(0, len(text), 64)] or [""]
+        return ("\n" + " " * column).join(f'"{piece}"' for piece in pieces)
+
+    @staticmethod
+    def number(value: int) -> str:
+        return {2**63 - 1: "INT64_MAX", -2**63: "INT64_MIN"}.get(value, str(value))
+
+    # --- the cases -------------------------------------------------------------------------------------
+
+    def decisions(self) -> None:
+        mf, c = self.mf, self.cases
+        new, old, serial, day = c.NEW, c.OLD, c.SERIAL, c.DAY
+        skew = mf.CLOCK_SKEW_SECONDS
