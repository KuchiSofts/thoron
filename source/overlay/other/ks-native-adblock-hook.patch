diff --git a/components/thoron_mail/mail_feed.cc b/components/thoron_mail/mail_feed.cc
new file mode 100644
index 0000000000000000000000000000000000000000..a5e3a57002d3ddd55f6ed110d427aca1cfc88752
--- /dev/null
+++ b/components/thoron_mail/mail_feed.cc
@@ -0,0 +1,174 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_mail/mail_feed.h"
+
+#include <algorithm>
+#include <string_view>
+#include <utility>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "services/data_decoder/public/cpp/safe_xml_parser.h"
+#include "url/gurl.h"
+#include "url/url_constants.h"
+
+namespace thoron_mail {
+
+MailMessage::MailMessage() = default;
+MailMessage::MailMessage(const MailMessage&) = default;
+MailMessage& MailMessage::operator=(const MailMessage&) = default;
+MailMessage::~MailMessage() = default;
+
+MailAccount::MailAccount() = default;
+MailAccount::MailAccount(const MailAccount&) = default;
+MailAccount& MailAccount::operator=(const MailAccount&) = default;
+MailAccount::~MailAccount() = default;
+
+namespace {
+
+constexpr size_t kMostMessages = 20;
+constexpr size_t kMostText = 400;
+
+// "atom:entry" -> "entry"
+std::string_view LocalName(std::string_view tag) {
+  const size_t colon = tag.find(':');
+  return colon == std::string_view::npos ? tag : tag.substr(colon + 1);
+}
+
+bool Named(const base::Value& element, std::string_view name) {
+  std::string tag;
+  return data_decoder::GetXmlElementTagName(element, &tag) &&
+         LocalName(tag) == name;
+}
+
+std::vector<const base::Value*> Children(const base::Value& element,
+                                         std::string_view name) {
+  std::vector<const base::Value*> out;
+  if (const base::ListValue* children =
+          data_decoder::GetXmlElementChildren(element)) {
+    for (const base::Value& child : *children) {
+      if (Named(child, name)) {
+        out.push_back(&child);
+      }
+    }
+  }
+  return out;
+}
+
+const base::Value* Child(const base::Value& element, std::string_view name) {
+  const std::vector<const base::Value*> found = Children(element, name);
+  return found.empty() ? nullptr : found.front();
+}
+
+std::string Text(const base::Value* element) {
+  std::string text;
+  if (element) {
+    data_decoder::GetXmlElementText(*element, &text);
+  }
+  std::string out(base::TrimWhitespaceASCII(text, base::TRIM_ALL));
+  if (out.size() > kMostText) {
+    out.resize(kMostText);
+  }
+  return out;
+}
+
+// "Gmail - Inbox for name@example.com" -> "name@example.com"
+std::string EmailIn(const std::string& title) {
+  const size_t at = title.find('@');
+  if (at == std::string::npos) {
+    return std::string();
+  }
+  size_t from = at;
+  while (from > 0 && !base::IsAsciiWhitespace(title[from - 1])) {
+    --from;
+  }
+  size_t to = at;
+  while (to < title.size() && !base::IsAsciiWhitespace(title[to])) {
+    ++to;
+  }
+  std::string email = title.substr(from, to - from);
+  return email.size() >= 3 && email.front() != '@' && email.back() != '@'
+             ? email
+             : std::string();
+}
+
+}  // namespace
+
+base::Time FeedTime(const std::string& text) {
+  int year = 0, month = 0, day = 0, hour = 0, minute = 0, second = 0;
+  if (text.size() < 19 ||
+      !base::StringToInt(std::string_view(text).substr(0, 4), &year) ||
+      !base::StringToInt(std::string_view(text).substr(5, 2), &month) ||
+      !base::StringToInt(std::string_view(text).substr(8, 2), &day) ||
+      !base::StringToInt(std::string_view(text).substr(11, 2), &hour) ||
+      !base::StringToInt(std::string_view(text).substr(14, 2), &minute) ||
+      !base::StringToInt(std::string_view(text).substr(17, 2), &second)) {
+    return base::Time();
+  }
+  base::Time::Exploded exploded = {};
+  exploded.year = year;
+  exploded.month = month;
+  exploded.day_of_month = day;
+  exploded.hour = hour;
+  exploded.minute = minute;
+  exploded.second = second;
+  base::Time time;
+  return base::Time::FromUTCExploded(exploded, &time) ? time : base::Time();
+}
+
+std::string GmailLink(const std::string& link) {
+  GURL url(link);
+  if (!url.is_valid() || url.host() != "mail.google.com" ||
+      !(url.SchemeIs(url::kHttpsScheme) || url.SchemeIs(url::kHttpScheme))) {
+    return std::string();
+  }
+  GURL::Replacements secure;
+  secure.SetSchemeStr(url::kHttpsScheme);
+  return url.ReplaceComponents(secure).spec();
+}
+
+std::optional<MailAccount> AccountFromFeed(const base::Value& feed,
+                                           int index) {
+  if (!Named(feed, "feed")) {
+    return std::nullopt;
+  }
+  MailAccount account;
+  account.index = index;
+  account.email = EmailIn(Text(Child(feed, "title")));
+  if (account.email.empty()) {
+    return std::nullopt;
+  }
+  int unread = 0;
+  if (base::StringToInt(Text(Child(feed, "fullcount")), &unread) &&
+      unread > 0) {
+    account.unread = unread;
+  }
+  for (const base::Value* entry : Children(feed, "entry")) {
+    if (account.latest.size() >= kMostMessages) {
+      break;
+    }
+    MailMessage message;
+    message.id = Text(Child(*entry, "id"));
+    message.subject = Text(Child(*entry, "title"));
+    message.snippet = Text(Child(*entry, "summary"));
+    if (const base::Value* author = Child(*entry, "author")) {
+      message.from_name = Text(Child(*author, "name"));
+      message.from_email = Text(Child(*author, "email"));
+    }
+    if (const base::Value* link = Child(*entry, "link")) {
+      message.link =
+          GmailLink(data_decoder::GetXmlElementAttribute(*link, "href"));
+    }
+    message.issued = FeedTime(Text(Child(*entry, "issued")));
+    if (!message.id.empty()) {
+      account.latest.push_back(std::move(message));
+    }
+  }
+  // the feed holds at most 20 messages; the count may be larger, never smaller
+  account.unread =
+      std::max(account.unread, static_cast<int>(account.latest.size()));
+  return account;
+}
+
+}  // namespace thoron_mail
