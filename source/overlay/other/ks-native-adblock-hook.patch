+class Clock;
+}  // namespace base
+
+namespace network {
+class SharedURLLoaderFactory;
+class SimpleURLLoader;
+}  // namespace network
+
+// The browser's own updater (ROADMAP P3.20, P3.9): it fetches the signed
+// update manifest of the channel, decides with manifest.h, downloads what the
+// decision names (the delta first when it is smaller, then the full package),
+// checks every download against the manifest (package.h) before anything uses
+// it, and hands the checked package to the caller's installer. Each step is a
+// state the About page shows.
+//
+// What it sends: plain GET requests for update.json, update.json.sig and
+// update.key, then for the package, without cookies, credentials or a cache, and
+// only over https, redirects included. What it keeps is in the browser's Local
+// State, outside every profile: the highest serial accepted on the channel
+// (P4.5) and the key statements that led to a key it trusts (P4.7). It never
+// opens a profile.
+namespace thoron_update {
+
+class UpdateClient {
+ public:
+  enum class State {
+    kIdle,
+    kChecking,
+    // A newer release, not installed: a look without installing.
+    kAvailable,
+    // Downloading; `progress` is 0 to 100.
+    kDownloading,
+    kInstalling,
+    // Installed; the new version starts with the next start.
+    kReadyToRelaunch,
+    kUpToDate,
+    // A newer release with nothing for this copy's variant and kind.
+    kNoPackage,
+    // A newer release this updater may not apply and that has no package for it
+    // to hand over (P4.6): the installer of the release is needed.
+    kNeedsInstaller,
+    // The manifest, its signature or its dates do not hold (manifest.h,
+    // CannotVerify): never shown as up to date.
+    kCannotVerify,
+    // The network, a download, or the installer failed.
+    kError,
+    // This build has no key to check updates with, or no https address.
+    kDisabled,
+  };
+
+  struct Status {
+    State state = State::kIdle;
+    int progress = 0;
+    // The newest release's build version, when a manifest said it.
+    std::string version;
+    // Thoron's own version of it, for people: 0.1.2.
+    std::string thoron_version;
+    // Why, in a few words (ASCII), for the page and the log.
+    std::string detail;
+    std::optional<Outcome> outcome;
+  };
+  using StatusCallback = base::RepeatingCallback<void(const Status&)>;
+
+  // Runs a checked package of the release `version`: an installer, or a delta
+  // installer when `delta`, or a portable copy's package. True when it
+  // installed. Called on a thread that may block.
+  using Installer = base::RepeatingCallback<
+      bool(const base::FilePath& package, bool delta, const std::string& version)>;
+
+  struct Config {
+    Config();
+    Config(const Config&);
+    Config& operator=(const Config&);
+    ~Config();
+
+    // The key the build trusts; all zero: none, and the client is disabled.
+    PublicKey public_key = {};
+    // The hosts packages may come from, as manifest.h takes them.
+    std::vector<std::string> allowed_hosts;
+    // The channel's update.json. Its signature is update.json.sig and the key
+    // statements update.key, both in the same folder.
+    GURL manifest_url;
+    std::string channel = "stable";
+    BuildVersion installed;
+    // The build the updater came with: the browser's own.
+    BuildVersion updater;
+    Variant variant = Variant::kWinX64Avx2;
+    Kind kind = Kind::kInstalled;
+    // Where packages are downloaded: a folder only this user writes, never a
+    // profile. Made when needed.
+    base::FilePath download_dir;
+    Installer install;
+    // Without `install`: why this copy is updated by hand, said with a newer
+    // release ("" for a portable copy's own words). An install for every user
+    // gives it: its installer needs administrator rights, which the updater
+    // never asks for (P3.10).
+    std::string by_hand;
+    // Called once a version is installed and waits for a relaunch: its build
+    // version, and whether the release is a security release that should not
+    // wait (the manifest's `critical`). The browser shows the relaunch badge.
+    base::RepeatingCallback<void(const std::string& version, bool critical)> on_installed;
+    // Whether the connection is metered: a look the copy takes on its own then
+    // downloads nothing (P4.3); a look the person asked for still does.
+    base::RepeatingCallback<bool()> is_metered;
+  };
+
+  UpdateClient(Config config,
+               scoped_refptr<network::SharedURLLoaderFactory> loader_factory,
+               PrefService* local_state,
+               base::Clock* clock);
+  UpdateClient(const UpdateClient&) = delete;
+  UpdateClient& operator=(const UpdateClient&) = delete;
+  ~UpdateClient();
+
+  static void RegisterPrefs(PrefRegistrySimple* registry);
+
+  // The files beside the manifest.
+  static GURL SignatureUrl(const GURL& manifest);
+  static GURL KeyStatementsUrl(const GURL& manifest);
+
+  // The User-Agent of every request the updater makes: it does not name the
+  // browser's version (THREAT_MODEL U12).
+  static constexpr char kUserAgent[] = "Thoron-Update";
+
+  // What a decision means for the page, before anything is downloaded.
+  static State StateFor(const Decision& decision);
+
+  // What the About page shows for a status (P3.9): the kind of line, the
+  // progress and the words. `by_hand`: the copy has no installer (a portable
+  // one, for now), so a newer release is said, not installed.
+  enum class PageKind {
+    kChecking,
+    kUpdating,
+    kRelaunch,
+    kUpToDate,
+    kFailed,
+    kFailedDownload,
+    kDisabled,
+  };
+  struct Page {
+    PageKind kind = PageKind::kChecking;
+    int progress = 0;
+    std::string message;
+  };
+  static Page ForAboutPage(const Status& status);
+
+  // Looks for a newer release and, when `install`, installs it. `callback`
+  // gets every state from now on, the last being the answer. A look while one
+  // runs joins it; `install` then also installs what it finds. After an
+  // install, every look answers kReadyToRelaunch until the browser restarts.
+  // `asked`: the person asked (the About page); false for the looks on a
+  // schedule, which download nothing on a metered connection.
+  void Check(bool install, StatusCallback callback, bool asked = true);
+
+  // How often one download is tried before the next step of the plan.
+  static constexpr int kMostAttempts = 3;
+
+  const Status& status() const { return status_; }
+
+ private:
+  void Report(Status status);
+  void Finish(Status status);
+  void Fail(State state, std::string detail);
+
+  void Fetch(const GURL& url,
+             size_t most_bytes,
+             base::OnceCallback<void(std::optional<std::string>)> done);
+  void OnFetched(base::OnceCallback<void(std::optional<std::string>)> done,
+                 std::optional<std::string> body);
+  void OnManifest(std::optional<std::string> body);
+  void OnSignature(std::optional<std::string> body);
+  void OnKeyStatements(std::optional<std::string> body);
+  void Decide();
+
+  void DownloadNext();
+  void StartAttempt();
+  void OnPartSize(int64_t had);
+  void OnDownloadDirReady(bool made);
+  void OnDownloaded(int64_t had, base::FilePath path);
+  void OnTakenIn(int64_t size);
+  base::FilePath PartPath() const;
+  void OnProgress(uint64_t current);
+  void OnPlaced(base::FilePath placed, FileCheck check);
+  void OnInstalled(bool installed);
+
+  const Config config_;
+  scoped_refptr<network::SharedURLLoaderFactory> loader_factory_;
+  raw_ptr<PrefService> local_state_;
+  raw_ptr<base::Clock> clock_;
+
+  Status status_;
+  bool running_ = false;
+  bool install_wanted_ = false;
+  bool asked_ = false;
+  int attempts_ = 0;
+  // The part of the download that had arrived when this attempt began.
+  int64_t had_ = 0;
+  // The step was resumed from a part: if it does not verify, it is fetched once
+  // more from the start.
+  bool resumed_ = false;
+  bool fetched_whole_again_ = false;
+  std::vector<StatusCallback> callbacks_;
+
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  std::string manifest_;
+  std::string signature_;
+  std::vector<std::string> fetched_statements_;
+  std::optional<Decision> decision_;
+  std::vector<DownloadStep> plan_;
+  size_t next_step_ = 0;
+  int64_t step_size_ = 0;
+
+  base::WeakPtrFactory<UpdateClient> weak_factory_{this};
+};
+
+}  // namespace thoron_update
+
+#endif  // COMPONENTS_THORON_UPDATE_UPDATE_CLIENT_H_
