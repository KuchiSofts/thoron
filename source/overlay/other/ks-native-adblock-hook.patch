@@ -0,0 +1,158 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_portable_key/key_store.h"
+
+#include <utility>
+
+#include "base/files/file.h"
+#include "base/files/file_util.h"
+
+namespace thoron_portable_key {
+
+namespace {
+
+// A key file is a few kilobytes at most (kMostLocks locks of at most
+// kMostRememberedPcBytes); anything larger is not one.
+constexpr int64_t kMostKeyFileBytes = 64 * 1024;
+
+base::FilePath MainPath(const base::FilePath& folder) {
+  return folder.Append(kKeyFileName);
+}
+
+base::FilePath NewPath(const base::FilePath& folder) {
+  return MainPath(folder).AddExtensionASCII("new");
+}
+
+base::FilePath OldPath(const base::FilePath& folder) {
+  return MainPath(folder).AddExtensionASCII("old");
+}
+
+base::FilePath DamagedPath(const base::FilePath& folder) {
+  return MainPath(folder).AddExtensionASCII("damaged");
+}
+
+// The file's bytes, or nullopt when it cannot be read or is too large.
+std::optional<std::vector<uint8_t>> ReadSmall(const base::FilePath& path) {
+  std::optional<int64_t> size = base::GetFileSize(path);
+  if (!size || *size < 0 || *size > kMostKeyFileBytes) {
+    return std::nullopt;
+  }
+  return base::ReadFileToBytes(path);
+}
+
+StoredKeyFile Parsed(std::optional<std::vector<uint8_t>> bytes) {
+  StoredKeyFile stored;
+  if (!bytes) {
+    stored.problem = StoreProblem::kUnreadable;
+    return stored;
+  }
+  stored.file = ParseKeyFile(*bytes, &stored.read_problem);
+  if (!stored.file) {
+    stored.problem = StoreProblem::kBadFile;
+  }
+  return stored;
+}
+
+bool WriteFlushed(const base::FilePath& path, base::span<const uint8_t> bytes) {
+  base::File file(path, base::File::FLAG_CREATE_ALWAYS | base::File::FLAG_WRITE);
+  if (!file.IsValid()) {
+    return false;
+  }
+  const bool ok = file.WriteAtCurrentPosAndCheck(bytes) && file.Flush();
+  file.Close();
+  return ok;
+}
+
+}  // namespace
+
+StoredKeyFile::StoredKeyFile() = default;
+StoredKeyFile::StoredKeyFile(StoredKeyFile&&) = default;
+StoredKeyFile& StoredKeyFile::operator=(StoredKeyFile&&) = default;
+StoredKeyFile::~StoredKeyFile() = default;
+
+StoredKeyFile ReadKeyFile(const base::FilePath& folder) {
+  const base::FilePath main = MainPath(folder);
+  const base::FilePath fresh = NewPath(folder);
+  const base::FilePath old = OldPath(folder);
+  if (base::PathExists(main)) {
+    StoredKeyFile stored = Parsed(ReadSmall(main));
+    if (stored.file) {
+      // what a write left beside a file in its place: an unfinished or
+      // unconfirmed change, and the file it replaced
+      base::DeleteFile(fresh);
+      base::DeleteFile(old);
+      return stored;
+    }
+    // A damaged file in its place (a bad flush, a worn drive): a complete file
+    // a write left beside it takes its place, the newer one first, and the
+    // damaged one is kept aside, never deleted on a guess.
+    for (const base::FilePath& candidate : {fresh, old}) {
+      if (!base::PathExists(candidate)) {
+        continue;
+      }
+      StoredKeyFile other = Parsed(ReadSmall(candidate));
+      if (!other.file) {
+        continue;
+      }
+      const base::FilePath damaged = DamagedPath(folder);
+      base::DeleteFile(damaged);
+      if (!base::Move(main, damaged) || !base::Move(candidate, main)) {
+        StoredKeyFile failed;
+        failed.problem = StoreProblem::kUnreadable;
+        return failed;
+      }
+      return other;
+    }
+    return stored;
+  }
+  if (base::PathExists(fresh)) {
+    StoredKeyFile stored = Parsed(ReadSmall(fresh));
+    if (stored.file) {
+      // complete: it was flushed before the old one was moved aside
+      if (!base::Move(fresh, main)) {
+        StoredKeyFile failed;
+        failed.problem = StoreProblem::kUnreadable;
+        return failed;
+      }
+      base::DeleteFile(old);
+      return stored;
+    }
+    base::DeleteFile(fresh);
+  }
+  if (base::PathExists(old)) {
+    if (!base::Move(old, main)) {
+      StoredKeyFile failed;
+      failed.problem = StoreProblem::kUnreadable;
+      return failed;
+    }
+    return Parsed(ReadSmall(main));
+  }
+  StoredKeyFile none;
+  none.problem = StoreProblem::kNoKeyFile;
+  return none;
+}
+
+bool WriteKeyFile(const base::FilePath& folder,
+                  base::span<const uint8_t> bytes,
+                  const AfterStep& after_step) {
+  auto go_on = [&after_step](int step) {
+    return after_step.is_null() || after_step.Run(step);
+  };
+  const base::FilePath main = MainPath(folder);
+  const base::FilePath fresh = NewPath(folder);
+  const base::FilePath old = OldPath(folder);
+  if (!WriteFlushed(fresh, bytes) || !go_on(1)) {
+    return false;
+  }
+  if (base::PathExists(main) && !base::Move(main, old)) {
+    return false;
+  }
+  if (!go_on(2) || !base::Move(fresh, main) || !go_on(3)) {
+    return false;
+  }
+  base::DeleteFile(old);
+  return go_on(4);
+}
+
+}  // namespace thoron_portable_key
