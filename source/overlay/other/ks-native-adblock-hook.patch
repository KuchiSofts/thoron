+  {match: /@(icloud|me|mac)\.com$/, host: 'imap.mail.me.com', hint: 'app',
+   webmail: () => 'https://www.icloud.com/mail'},
+  {match: /@(outlook|hotmail|live|msn)\.[a-z.]+$/, blocked: 'microsoft'},
+  {match: /@(proton|protonmail)\.(me|com|ch)$|@pm\.me$/, blocked: 'proton'},
