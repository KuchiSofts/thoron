+std::optional<std::vector<std::unique_ptr<sessions::SessionCommand>>>
+ReadSessionCommands(base::span<const uint8_t> file) {
+  if (file.size() < 8 || file.size() > kMostOpenTabsFileBytes) {
+    return std::nullopt;
+  }
+  const uint32_t signature = base::U32FromLittleEndian(file.first<4u>());
+  const uint32_t version = base::U32FromLittleEndian(file.subspan<4u, 4u>());
+  if (signature != kFileSignature || version != kFileVersionWithMarker) {
+    return std::nullopt;
+  }
+  base::span<const uint8_t> rest = file.subspan(8u);
+  bool marker = false;
+  std::vector<std::unique_ptr<sessions::SessionCommand>> commands;
+  while (rest.size() >= 2) {
+    // Each command: its size (2 bytes, the id included), its id, its contents.
+    const size_t size = base::U16FromLittleEndian(rest.first<2u>());
+    rest = rest.subspan(2u);
+    if (size < 1 || size > rest.size()) {
+      break;  // cut short or damaged: the commands before it count, as in Chromium
+    }
+    const uint8_t id = rest[0];
+    const base::span<const uint8_t> contents = rest.subspan(1u, size - 1);
+    rest = rest.subspan(size);
+    if (id == kInitialStateMarkerCommandId) {
+      marker = true;
+      continue;
+    }
+    auto command = std::make_unique<sessions::SessionCommand>(
+        id, static_cast<sessions::SessionCommand::size_type>(contents.size()));
+    command->contents().copy_from(contents);
+    commands.push_back(std::move(command));
+  }
+  if (!marker) {
+    return std::nullopt;
+  }
+  return commands;
+}
+
+std::vector<std::unique_ptr<sessions::SessionWindow>> ReadOpenTabs(
+    base::span<const uint8_t> file,
+    OpenTabsCounts* counts) {
+  OpenTabsCounts found;
+  std::vector<std::unique_ptr<sessions::SessionWindow>> kept;
+  std::optional<std::vector<std::unique_ptr<sessions::SessionCommand>>>
+      commands = ReadSessionCommands(file);
+  if (commands) {
+    LeaveOutWhatStopsTheReplay(*commands);
+    std::vector<std::unique_ptr<sessions::SessionWindow>> windows;
+    Replay(*commands, &windows);
+    size_t tabs_in_all = 0;
+    for (std::unique_ptr<sessions::SessionWindow>& window : windows) {
+      if (kept.size() >= kMostOpenTabsWindows || tabs_in_all >= kMostOpenTabs) {
+        break;
+      }
+      if (window->type != sessions::SessionWindow::TYPE_NORMAL) {
+        continue;
+      }
+      const sessions::SessionTab* selected =
+          window->selected_tab_index >= 0 &&
+                  static_cast<size_t>(window->selected_tab_index) <
+                      window->tabs.size()
+              ? window->tabs[window->selected_tab_index].get()
+              : nullptr;
+      int selected_at = 0;
+      std::vector<std::unique_ptr<sessions::SessionTab>> tabs;
+      std::set<tab_groups::TabGroupId> used_groups;
+      for (std::unique_ptr<sessions::SessionTab>& tab : window->tabs) {
+        if (tabs_in_all >= kMostOpenTabs) {
+          break;
+        }
+        if (!KeepWebPages(*tab)) {
+          continue;
+        }
+        ForgetTheOtherBrowser(*tab);
+        if (tab.get() == selected) {
+          selected_at = static_cast<int>(tabs.size());
+        }
+        if (tab->group) {
+          used_groups.insert(*tab->group);
+        }
+        tab->tab_visual_index = static_cast<int>(tabs.size());
+        tabs.push_back(std::move(tab));
+        ++tabs_in_all;
+      }
+      if (tabs.empty()) {
+        continue;
+      }
+      // Groups with a tab kept, without the link to the other browser's saved
+      // groups; a tab whose group has no entry of its own keeps no group.
+      std::vector<std::unique_ptr<sessions::SessionTabGroup>> groups;
+      std::set<tab_groups::TabGroupId> described;
+      for (std::unique_ptr<sessions::SessionTabGroup>& group :
+           window->tab_groups) {
+        if (used_groups.contains(group->id) && !described.contains(group->id)) {
+          group->saved_guid.reset();
+          described.insert(group->id);
+          groups.push_back(std::move(group));
+        }
+      }
+      for (std::unique_ptr<sessions::SessionTab>& tab : tabs) {
+        if (tab->group && !described.contains(*tab->group)) {
+          tab->group.reset();
+        }
+      }
+      window->tabs = std::move(tabs);
+      window->tab_groups = std::move(groups);
+      window->split_tabs.clear();
+      window->selected_tab_index = selected_at;
+      window->app_name.clear();
+      window->workspace.clear();
+      window->visible_on_all_workspaces = false;
+      window->extra_data.clear();
+      if (window->show_state == ui::mojom::WindowShowState::kMinimized) {
+        window->show_state = ui::mojom::WindowShowState::kNormal;
+      }
+      found.windows += 1;
+      found.tabs += static_cast<int>(window->tabs.size());
+      found.groups += static_cast<int>(window->tab_groups.size());
+      kept.push_back(std::move(window));
+    }
+  }
+  if (counts) {
+    *counts = found;
+  }
+  return kept;
+}
+
+}  // namespace user_data_importer::chromium_family
diff --git a/components/user_data_importer/chromium_family/open_tabs.h b/components/user_data_importer/chromium_family/open_tabs.h
