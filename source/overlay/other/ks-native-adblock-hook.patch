+
+// P5.81: the backup written into the file the person chose, then read back:
+// "" when the file holds exactly the backup, else "write" or "verify". It is
+// written next to the file first and put in its place, so a file that is there
+// already is only replaced by a whole backup; where a folder takes no such
+// move (some synced folders), it is written in place and read back.
+std::string WriteBackupFile(base::FilePath path, std::string text) {
+  auto holds = [&text](const base::FilePath& file) {
+    std::string back;
+    return base::ReadFileToStringWithMaxSize(file, &back, text.size() + 1) &&
+           back == text;
+  };
+  const bool existed = base::PathExists(path);
+  const base::FilePath part = path.AddExtensionASCII("part");
+  if (base::WriteFile(part, text) && holds(part) &&
+      base::ReplaceFile(part, path, nullptr) && holds(path)) {
+    return std::string();
+  }
+  base::DeleteFile(part);
+  if (!base::WriteFile(path, text)) {
+    if (!existed) {
+      base::DeleteFile(path);
+    }
+    return "write";
+  }
+  if (!holds(path)) {
+    if (!existed) {
+      base::DeleteFile(path);
+    }
+    return "verify";
+  }
+  return std::string();
+}
