+  // A request was blocked on `page`.
+  void OnBlocked(content::Page& page);
+  // The switch for every site or an option changed.
+  void OnStateChanged();
+  // The address bar's shield is drawn again, at most every
+  // kAddressBarRefresh while a page blocks a lot.
+  void RefreshAddressBar();
+  void DoRefreshAddressBar();
+  // Moves the shield where chrome://adblock says (P5.73): after the
+  // extensions, right after the address bar, or next to the menu.
+  void ApplyPosition();
+  // The menu's bubble manager, made when first needed.
+  ThoronMenuBubbleManager& Menu();
+  void WarmUpMenu();
+  // A kept page did not ask to be shown in time: the menu is shown anyway.
+  void ShowMenuNow();
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  std::unique_ptr<ThoronMenuBubbleManager> menu_;
+  bool warm_up_pending_ = false;
+  base::OneShotTimer show_anyway_;
+  base::ScopedObservation<views::Widget, views::WidgetObserver>
+      menu_observation_{this};
+  // When the menu last closed: a press that closed it does not open it again.
+  base::TimeTicks menu_closed_at_;
+  bool address_bar_refresh_pending_ = false;
+  base::CallbackListSubscription blocked_subscription_;
+  // the switch for every site (P5.70) and the options (P5.71)
+  base::CallbackListSubscription blocking_subscription_;
+  base::WeakPtrFactory<ThoronAdblockButton> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TOOLBAR_THORON_ADBLOCK_BUTTON_H_
