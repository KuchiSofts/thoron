+// An extension ID: 32 letters from a to p.
+bool IsExtensionId(const std::string& id) {
+  return id.size() == 32 &&
+         std::ranges::all_of(id, [](char c) { return c >= 'a' && c <= 'p'; });
+}
+
+inline constexpr sql::Database::Tag kDatabaseTag{"ThoronChromiumImport"};
+
+constexpr base::FilePath::CharType kBookmarksFile[] = FILE_PATH_LITERAL("Bookmarks");
+constexpr base::FilePath::CharType kHistoryFile[] = FILE_PATH_LITERAL("History");
+constexpr base::FilePath::CharType kLoginDataFile[] = FILE_PATH_LITERAL("Login Data");
+constexpr base::FilePath::CharType kWebDataFile[] = FILE_PATH_LITERAL("Web Data");
+constexpr base::FilePath::CharType kLocalStateFile[] = FILE_PATH_LITERAL("Local State");
+constexpr base::FilePath::CharType kNetworkDir[] = FILE_PATH_LITERAL("Network");
+constexpr base::FilePath::CharType kCookiesFile[] = FILE_PATH_LITERAL("Cookies");
+
+// The home page and startup pages: web pages only (http, https, file); a
+// script or an internal page is never set as one.
+bool IsWebPage(const GURL& url) {
+  return url.is_valid() && (url.SchemeIsHTTPOrHTTPS() || url.SchemeIsFile());
+}
+
+// A URL is worth importing only if it parses and is not an internal page.
+bool CanImportURL(const GURL& url) {
+  if (!url.is_valid()) {
+    return false;
+  }
+  static constexpr const char* kSkip[] = {"about", "chrome",  "chrome-untrusted",
+                                          "edge",  "brave",   "vivaldi",
+                                          "opera", "devtools"};
+  for (const char* scheme : kSkip) {
+    if (url.SchemeIs(scheme)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// Chromium stores bookmark times as microseconds since the Windows epoch, held
+// as a decimal string.
+base::Time TimeFromWebkitString(const std::string* microseconds) {
+  int64_t value = 0;
+  if (!microseconds || !base::StringToInt64(*microseconds, &value) ||
+      value <= 0) {
+    return base::Time();
+  }
+  return base::Time::FromDeltaSinceWindowsEpoch(base::Microseconds(value));
+}
+
+// Opens a database copy and returns it only if PRAGMA quick_check reports "ok".
+// A copy is opened read only, unless its -wal file came along: then for
+// writing, so that SQLite takes the last writes into it (the copy is the
+// reader's own).
+std::unique_ptr<sql::Database> OpenCheckedDatabase(const base::FilePath& path) {
+  if (path.empty()) {
+    return nullptr;
+  }
+  const bool has_wal =
+      base::PathExists(base::FilePath(path.value() + FILE_PATH_LITERAL("-wal")));
+  auto db = std::make_unique<sql::Database>(
+      sql::DatabaseOptions().set_read_only(!has_wal).set_wal_mode(has_wal),
+      kDatabaseTag);
+  if (!db->Open(path)) {
+    return nullptr;
+  }
+  sql::Statement check(db->GetUniqueStatement("PRAGMA quick_check"));
+  if (!check.Step() || check.ColumnStringView(0) != "ok") {
+    return nullptr;
+  }
+  return db;
+}
+
+void WalkBookmarkNode(const base::DictValue& node,
+                      bool in_toolbar,
+                      bool synced,
+                      std::vector<std::u16string> path,
+                      std::vector<ImportedBookmarkEntry>* out) {
+  const std::string* type = node.FindString("type");
+  if (!type) {
+    return;
+  }
+  const std::string* name = node.FindString("name");
+  std::u16string title = name ? base::UTF8ToUTF16(*name) : std::u16string();
+
+  if (*type == "url") {
+    const std::string* url = node.FindString("url");
+    GURL gurl(url ? *url : std::string());
+    if (!CanImportURL(gurl)) {
+      return;
+    }
+    ImportedBookmarkEntry entry;
+    entry.in_toolbar = in_toolbar;
+    entry.is_folder = false;
+    entry.url = gurl;
+    entry.path = path;
+    entry.title = title;
+    entry.creation_time = TimeFromWebkitString(node.FindString("date_added"));
+    entry.synced = synced;
+    out->push_back(std::move(entry));
+    return;
+  }
+
+  if (*type != "folder") {
+    return;
+  }
+  const base::ListValue* children = node.FindList("children");
+  if (!children) {
+    return;
+  }
+  // Empty folder: keep it, so an empty folder structure survives.
+  if (children->empty()) {
+    ImportedBookmarkEntry entry;
+    entry.in_toolbar = in_toolbar;
+    entry.is_folder = true;
+    entry.path = path;
+    entry.title = title;
+    entry.creation_time = TimeFromWebkitString(node.FindString("date_added"));
+    entry.synced = synced;
+    out->push_back(std::move(entry));
+    return;
+  }
+  std::vector<std::u16string> child_path = path;
+  child_path.push_back(title);
+  for (const base::Value& child : *children) {
+    if (const base::DictValue* dict = child.GetIfDict()) {
+      WalkBookmarkNode(*dict, in_toolbar, synced, child_path, out);
+    }
+  }
+}
+
+}  // namespace
+
+ChromiumFamilyReader::ChromiumFamilyReader(const Options& options)
+    : options_(options) {}
+
+ChromiumFamilyReader::~ChromiumFamilyReader() = default;
+
+base::FilePath ChromiumFamilyReader::CopyForReading(
+    const base::FilePath& source_file) {
+  if (!base::PathExists(source_file)) {
+    return {};
+  }
+  if (!temp_dir_.IsValid() && !temp_dir_.CreateUniqueTempDir()) {
+    return {};
+  }
+  base::FilePath destination =
+      temp_dir_.GetPath().Append(source_file.BaseName());
+  // A type may need the same file twice (keywords and autofill both live in
+  // Web Data); copy once.
+  if (base::PathExists(destination)) {
+    return destination;
+  }
+  if (!base::CopyFile(source_file, destination)) {
+    return {};
+  }
+  // A browser that did not close cleanly leaves its last writes in the
+  // database's -wal file. It comes along, so the copy holds them; the source
+  // itself is never opened.
+  const base::FilePath wal(source_file.value() + FILE_PATH_LITERAL("-wal"));
+  if (base::PathExists(wal)) {
+    base::CopyFile(wal,
+                   base::FilePath(destination.value() + FILE_PATH_LITERAL("-wal")));
+  }
+  return destination;
+}
+
+std::unique_ptr<sql::Database> ChromiumFamilyReader::OpenCopiedDatabase(
+    const base::FilePath& source_file) {
+  base::FilePath copy = CopyForReading(source_file);
+  if (copy.empty()) {
+    return nullptr;
+  }
+  std::unique_ptr<sql::Database> db = OpenCheckedDatabase(copy);
+  if (!db) {
+    // A SQLite file whose copy fails quick_check is skipped; count it once.
+    if (refused_databases_.insert(copy).second) {
+      ++stats_.databases_refused;
+    }
+  }
+  return db;
+}
+
+ChromiumFamilyReader::Stats ChromiumFamilyReader::Import(
+    uint16_t items,
+    ChromiumFamilyImportBridge* bridge) {
+  // History before bookmarks, like Chromium's own importers.
+  if (items & HISTORY) {
+    ImportHistory(bridge);
+  }
+  if (items & FAVORITES) {
+    ImportBookmarks(bridge);
+  }
+  if (items & SEARCH_ENGINES) {
+    ImportSearchEngines(bridge);
+  }
+  if (items & AUTOFILL_FORM_DATA) {
+    ImportAutofill(bridge);
+  }
+  if (items & PASSWORDS) {
+    ImportPasswords(bridge);
+  }
+  if (items & COOKIES) {
+    ImportCookies(bridge);
+  }
+  if (items & HOME_PAGE) {
+    ImportStartup(bridge);
+  }
+  if (items & EXTENSIONS) {
+    ImportExtensions(bridge);
+  }
+  if (items & OPEN_TABS) {
+    ImportOpenTabs(bridge);
+  }
+  return stats_;
+}
+
+ImportedStartupSettings::ImportedStartupSettings() = default;
+ImportedStartupSettings::ImportedStartupSettings(const ImportedStartupSettings&) =
+    default;
+ImportedStartupSettings::~ImportedStartupSettings() = default;
+
+
+// Thoron (ROADMAP P3.14): the Chrome Web Store extensions a person installed
+// in the source profile, by ID, from copies of its Preferences and Secure
+// Preferences ("extensions.settings"). Only what came from the store and was
+// installed by the person (location 1, "internal"); none installed by default,
+// by a policy, by another program or unpacked. Nothing of the extensions
+// themselves is read or copied: the browser installs each one again from the
+// store, switched off until the person turns it on.
+void ChromiumFamilyReader::ImportExtensions(ChromiumFamilyImportBridge* bridge) {
+  constexpr size_t kMostExtensions = 500;
+  std::vector<std::string> ids;
+  int skipped = 0;
+  std::vector<std::string> seen;  // each ID once, from either file
+  for (const char* name : {"Secure Preferences", "Preferences"}) {
+    const base::FilePath copy =
+        CopyForReading(options_.profile_path.AppendASCII(name));
+    std::string text;
+    if (copy.empty() ||
+        !base::ReadFileToStringWithMaxSize(copy, &text, 32 * 1024 * 1024)) {
+      continue;
+    }
+    std::optional<base::Value> read =
+        base::JSONReader::Read(text, base::JSON_PARSE_RFC);
+    const base::DictValue* prefs = read ? read->GetIfDict() : nullptr;
+    const base::DictValue* settings =
+        prefs ? prefs->FindDictByDottedPath("extensions.settings") : nullptr;
+    if (!settings) {
+      continue;
+    }
+    for (const auto [id, value] : *settings) {
+      const base::DictValue* entry = value.GetIfDict();
+      if (!entry || !IsExtensionId(id) || ids.size() >= kMostExtensions ||
+          std::ranges::find(seen, id) != seen.end()) {
+        continue;
+      }
+      seen.push_back(id);
+      const std::optional<int> location = entry->FindInt("location");
+      const bool from_store = entry->FindBool("from_webstore").value_or(false);
+      const bool by_default =
+          entry->FindBool("was_installed_by_default").value_or(false) ||
+          entry->FindBool("was_installed_by_oem").value_or(false);
+      if (by_default) {
+        continue;
+      }
+      if (location == 1 && from_store) {
+        ids.push_back(id);
+      } else if (location == 1 || location == 2 || location == 3 ||
+                 location == 4 || location == 6 || location == 8) {
+        ++skipped;  // installed by the person or another program, not the store
+      }
+    }
+  }
+  stats_.extensions = static_cast<int>(ids.size());
+  stats_.extensions_skipped = skipped;
+  if (!ids.empty()) {
+    bridge->SetWebStoreExtensions(ids);
+  }
+}
+
+// Thoron (ROADMAP P3.22): the open windows, tabs and tab groups of the source
+// profile, from a copy of its newest complete session file
+// (`Sessions/Session_<time>`), the one the browser itself would restore: a file
+// still being written (no marker) gives way to the one before it. The file is
+// only checked and counted here; the browser reads it again and opens what is
+// safe to open (open_tabs.h).
+void ChromiumFamilyReader::ImportOpenTabs(ChromiumFamilyImportBridge* bridge) {
+  constexpr size_t kMostFilesTried = 5;
+  std::vector<std::pair<uint64_t, base::FilePath>> files;
+  base::FileEnumerator found(options_.profile_path.AppendASCII("Sessions"),
+                             /*recursive=*/false, base::FileEnumerator::FILES,
+                             FILE_PATH_LITERAL("Session_*"));
+  for (base::FilePath path = found.Next(); !path.empty(); path = found.Next()) {
+    const std::string name = path.BaseName().MaybeAsASCII();
+    uint64_t time = 0;
+    if (name.size() > 8 &&
+        base::StringToUint64(std::string_view(name).substr(8), &time)) {
+      files.emplace_back(time, path);
+    }
+  }
+  std::ranges::sort(files, std::greater<>());
+  for (size_t i = 0; i < files.size() && i < kMostFilesTried; ++i) {
+    const base::FilePath copy = CopyForReading(files[i].second);
+    std::string data;
+    if (copy.empty() || !base::ReadFileToStringWithMaxSize(
+                            copy, &data, kMostOpenTabsFileBytes)) {
+      continue;
+    }
+    const base::span<const uint8_t> bytes = base::as_byte_span(data);
+    if (!ReadSessionCommands(bytes)) {
+      continue;
+    }
+    OpenTabsCounts counts;
+    ReadOpenTabs(bytes, &counts);
+    stats_.open_tabs = counts.tabs;
+    if (counts.tabs > 0) {
+      bridge->SetOpenTabsSession(
+          std::vector<uint8_t>(bytes.begin(), bytes.end()));
+    }
+    return;
+  }
+}
+// The home page and the startup choice, from a copy of the profile's
+// Preferences (and Secure Preferences, where some browsers keep them). Nothing
+// else is read from those files.
+void ChromiumFamilyReader::ImportStartup(ChromiumFamilyImportBridge* bridge) {
+  ImportedStartupSettings settings;
+  bool found = false;
+  for (const char* name : {"Preferences", "Secure Preferences"}) {
+    const base::FilePath copy =
+        CopyForReading(options_.profile_path.AppendASCII(name));
+    std::string text;
+    if (copy.empty() ||
+        !base::ReadFileToStringWithMaxSize(copy, &text, 32 * 1024 * 1024)) {
+      continue;
+    }
+    std::optional<base::Value> read = base::JSONReader::Read(
+        text, base::JSON_PARSE_RFC);
+    const base::DictValue* prefs = read ? read->GetIfDict() : nullptr;
+    if (!prefs) {
+      continue;
+    }
+    if (const std::string* home = prefs->FindString("homepage")) {
+      const GURL url(*home);
+      if (IsWebPage(url)) {
+        settings.home_page = url;
+        found = true;
+      }
+    }
+    if (std::optional<bool> ntp = prefs->FindBool("homepage_is_newtabpage")) {
+      settings.home_page_is_new_tab_page = *ntp;
+    }
+    if (std::optional<bool> button =
+            prefs->FindBoolByDottedPath("browser.show_home_button")) {
+      settings.show_home_button = *button ? 1 : 0;
+      found = true;
+    }
+    if (std::optional<int> restore =
+            prefs->FindIntByDottedPath("session.restore_on_startup")) {
+      if (*restore == 1 || *restore == 4 || *restore == 5) {
+        settings.restore_on_startup = *restore;
+        found = true;
+      }
+    }
+    if (const base::ListValue* pages =
+            prefs->FindListByDottedPath("session.startup_urls")) {
+      std::vector<GURL> kept;
+      for (const base::Value& page : *pages) {
+        const GURL url(page.is_string() ? page.GetString() : std::string());
+        if (IsWebPage(url)) {
+          kept.push_back(url);
+        }
+      }
+      if (!kept.empty()) {
+        settings.startup_pages = std::move(kept);
+      }
+    }
+  }
+  if (!found && settings.startup_pages.empty()) {
+    return;
+  }
+  stats_.home_page = settings.home_page.is_valid() ? 1 : 0;
+  stats_.startup_pages = settings.restore_on_startup == 4
+                             ? static_cast<int>(settings.startup_pages.size())
+                             : 0;
+  bridge->SetStartupSettings(settings);
+}
+
+void ChromiumFamilyReader::ImportBookmarks(ChromiumFamilyImportBridge* bridge) {
+  base::FilePath copy =
+      CopyForReading(options_.profile_path.Append(kBookmarksFile));
+  if (copy.empty()) {
+    return;
+  }
+  std::string json;
+  if (!base::ReadFileToString(copy, &json)) {
+    return;
+  }
+  std::optional<base::DictValue> root =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  if (!root) {
+    return;
+  }
+  const base::DictValue* roots = root->FindDict("roots");
+  if (!roots) {
+    return;
+  }
+
+  std::vector<ImportedBookmarkEntry> bookmarks;
+  // A root is never an entry itself; its children are walked. ProfileWriter
+  // expects toolbar entries to carry the bar's name as path[0] (it skips that
+  // element when importing straight into an empty bar), so the bar keeps its
+  // name. "Other bookmarks" is left out, so its items go straight into the
+  // import folder. The mobile root keeps its name so its items stay grouped.
+  struct Root {
+    const char* key;
+    bool in_toolbar;
+    bool synced;
+    bool keep_name;
+    const char16_t* fallback_name;
+  };
+  for (const Root& r :
+       {Root{"bookmark_bar", true, false, true, u"Bookmarks bar"},
+        Root{"other", false, false, false, u""},
+        Root{"synced", false, true, true, u"Mobile bookmarks"}}) {
+    const base::DictValue* node = roots->FindDict(r.key);
+    if (!node) {
+      continue;
+    }
+    const base::ListValue* children = node->FindList("children");
+    if (!children) {
+      continue;
+    }
+    std::vector<std::u16string> path;
+    if (r.keep_name) {
+      const std::string* name = node->FindString("name");
+      path.push_back(name && !name->empty() ? base::UTF8ToUTF16(*name)
+                                            : std::u16string(r.fallback_name));
+    }
+    for (const base::Value& child : *children) {
+      if (const base::DictValue* dict = child.GetIfDict()) {
+        WalkBookmarkNode(*dict, r.in_toolbar, r.synced, path, &bookmarks);
+      }
+    }
+  }
+
+  stats_.bookmarks = static_cast<int>(bookmarks.size());
+  if (!bookmarks.empty()) {
+    bridge->AddBookmarks(bookmarks, options_.bookmark_folder_name);
+  }
+}
+
+void ChromiumFamilyReader::ImportHistory(ChromiumFamilyImportBridge* bridge) {
+  std::unique_ptr<sql::Database> db =
+      OpenCopiedDatabase(options_.profile_path.Append(kHistoryFile));
+  if (!db) {
+    return;
+  }
+  sql::Statement s(db->GetUniqueStatement(
+      "SELECT url, title, visit_count, typed_count, last_visit_time, hidden "
+      "FROM urls"));
+  if (!s.is_valid()) {
+    return;
+  }
+  std::vector<ImporterURLRow> rows;
+  while (s.Step()) {
+    GURL url(s.ColumnStringView(0));
+    if (!CanImportURL(url)) {
+      continue;
+    }
+    ImporterURLRow row(url);
+    row.title = s.ColumnString16(1);
+    row.visit_count = s.ColumnInt(2);
+    row.typed_count = s.ColumnInt(3);
+    row.last_visit = s.ColumnTime(4);
+    row.hidden = s.ColumnInt(5) != 0;
+    rows.push_back(std::move(row));
+  }
+  stats_.history = static_cast<int>(rows.size());
+  if (!rows.empty()) {
+    bridge->SetHistory(rows);
+  }
+}
+
+void ChromiumFamilyReader::ImportSearchEngines(
+    ChromiumFamilyImportBridge* bridge) {
+  std::unique_ptr<sql::Database> db =
+      OpenCopiedDatabase(options_.profile_path.Append(kWebDataFile));
+  if (!db) {
+    return;
+  }
+  sql::Statement s(db->GetUniqueStatement(
+      "SELECT short_name, keyword, url FROM keywords"));
+  if (!s.is_valid()) {
+    return;
+  }
+  std::vector<SearchEngineInfo> engines;
+  while (s.Step()) {
+    std::u16string keyword = s.ColumnString16(1);
+    std::u16string url = s.ColumnString16(2);
+    if (keyword.empty() || url.empty()) {
+      continue;
+    }
+    SearchEngineInfo engine;
+    engine.display_name = s.ColumnString16(0);
+    engine.keyword = keyword;
+    // Chromium keeps the URL already in the {searchTerms} form that
+    // TemplateURLData expects, so it is passed through unchanged.
+    engine.url = url;
+    engines.push_back(std::move(engine));
+  }
+  stats_.search_engines = static_cast<int>(engines.size());
+  if (!engines.empty()) {
+    bridge->SetKeywords(engines);
+  }
+}
+
+void ChromiumFamilyReader::ImportAutofill(ChromiumFamilyImportBridge* bridge) {
+  std::unique_ptr<sql::Database> db =
+      OpenCopiedDatabase(options_.profile_path.Append(kWebDataFile));
+  if (!db) {
+    return;
+  }
+  sql::Statement s(db->GetUniqueStatement(
+      "SELECT name, value, count, date_created, date_last_used FROM autofill"));
+  if (!s.is_valid()) {
+    return;
+  }
+  std::vector<ImportedAutofillEntry> entries;
+  while (s.Step()) {
+    ImportedAutofillEntry entry;
+    entry.name = s.ColumnString16(0);
+    entry.value = s.ColumnString16(1);
+    if (entry.name.empty() || entry.value.empty()) {
+      continue;
+    }
+    entry.times_used = s.ColumnInt(2);
+    // Chromium's Web Data stores these as seconds since the Unix epoch.
+    entry.date_created = base::Time::FromTimeT(s.ColumnInt64(3));
+    entry.date_last_used = base::Time::FromTimeT(s.ColumnInt64(4));
+    entries.push_back(std::move(entry));
+  }
+  stats_.autofill = static_cast<int>(entries.size());
+  if (!entries.empty()) {
+    bridge->SetAutofillEntries(entries);
+  }
+}
+
+void ChromiumFamilyReader::ImportPasswords(ChromiumFamilyImportBridge* bridge) {
+#if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_LINUX)
+  std::unique_ptr<sql::Database> db =
+      OpenCopiedDatabase(options_.profile_path.Append(kLoginDataFile));
+  if (!db) {
+    return;
+  }
+  // The profile key lives in the browser's Local State, not the profile folder.
+  std::string local_state;
+  base::FilePath local_state_copy =
+      CopyForReading(options_.user_data_path.Append(kLocalStateFile));
+  std::optional<PasswordKey> key;
+#if BUILDFLAG(IS_WIN)
+  if (!local_state_copy.empty() &&
+      base::ReadFileToString(local_state_copy, &local_state)) {
+    key = PasswordKey::FromLocalState(local_state);
+  }
+#else
+  // Linux keeps no key in Local State: the fixed one, and the keyring's.
+  key = PasswordKey::ForUserData(options_.user_data_path);
+#endif
+  PasswordKey empty_key;
+
+  sql::Statement s(db->GetUniqueStatement(
+      "SELECT origin_url, action_url, username_element, username_value, "
+      "password_element, password_value, signon_realm, blacklisted_by_user, "
+      "scheme FROM logins"));
+  if (!s.is_valid()) {
+    return;
+  }
+  while (s.Step()) {
+    base::span<const uint8_t> encrypted = s.ColumnBlob(5);
+    std::string password;
+    DecryptResult result =
+        DecryptPasswordValue(key ? *key : empty_key, encrypted, &password);
+    switch (result) {
+      case DecryptResult::kSkippedV20:
+        ++stats_.passwords_skipped_app_bound;
+        continue;
+      case DecryptResult::kSkippedOther:
+        ++stats_.passwords_skipped_other;
+        continue;
+      case DecryptResult::kError:
+        ++stats_.passwords_failed;
+        continue;
+      case DecryptResult::kOk:
+        break;
+    }
+
+    ImportedPasswordForm form;
+    form.scheme = s.ColumnInt(8) == 1
+                      ? ImportedPasswordForm::Scheme::kBasic
+                      : ImportedPasswordForm::Scheme::kHtml;
+    form.signon_realm = s.ColumnString(6);
+    form.url = GURL(s.ColumnStringView(0));
+    form.action = GURL(s.ColumnStringView(1));
+    form.username_element = s.ColumnString16(2);
+    form.username_value = s.ColumnString16(3);
+    form.password_element = s.ColumnString16(4);
+    form.password_value = base::UTF8ToUTF16(password);
+    form.blocked_by_user = s.ColumnInt(7) != 0;
+    if (form.username_value.empty() && form.password_value.empty() &&
+        !form.blocked_by_user) {
+      continue;
+    }
+    ++stats_.passwords;
+    bridge->AddPasswordForm(form);
+  }
+  if (key) {
+    key->Clear();
+  }
+#endif  // BUILDFLAG(IS_WIN) || BUILDFLAG(IS_LINUX)
+}
+
+void ChromiumFamilyReader::ImportCookies(ChromiumFamilyImportBridge* bridge) {
+#if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_LINUX)
+  // The current layout keeps cookies in Network\Cookies; older profiles kept
+  // them in the profile folder itself.
+  std::unique_ptr<sql::Database> db = OpenCopiedDatabase(
+      options_.profile_path.Append(kNetworkDir).Append(kCookiesFile));
+  if (!db) {
+    db = OpenCopiedDatabase(options_.profile_path.Append(kCookiesFile));
+  }
+  if (!db) {
+    return;
+  }
+
+  // Cookie databases at meta version 24 and later prefix each decrypted value
+  // with the SHA-256 of the cookie's host_key.
+  int cookie_db_version = 0;
+  {
+    sql::Statement v(
+        db->GetUniqueStatement("SELECT value FROM meta WHERE key='version'"));
+    if (v.is_valid() && v.Step()) {
+      cookie_db_version = v.ColumnInt(0);
+    }
+  }
+  const bool has_host_hash_prefix = cookie_db_version >= 24;
+
+  std::string local_state;
+  base::FilePath local_state_copy =
+      CopyForReading(options_.user_data_path.Append(kLocalStateFile));
+  std::optional<PasswordKey> key;
+#if BUILDFLAG(IS_WIN)
+  if (!local_state_copy.empty() &&
+      base::ReadFileToString(local_state_copy, &local_state)) {
+    key = PasswordKey::FromLocalState(local_state);
+  }
+#else
+  // Linux keeps no key in Local State: the fixed one, and the keyring's.
+  key = PasswordKey::ForUserData(options_.user_data_path);
+#endif
+  PasswordKey empty_key;
+
+  sql::Statement s(db->GetUniqueStatement(
+      "SELECT creation_utc, host_key, top_frame_site_key, name, value, path, "
+      "expires_utc, is_secure, is_httponly, last_access_utc, has_expires, "
+      "is_persistent, priority, encrypted_value, samesite, source_scheme, "
+      "source_port, last_update_utc, source_type, has_cross_site_ancestor "
+      "FROM cookies"));
+  if (!s.is_valid()) {
+    return;
+  }
+
+  const base::Time now = base::Time::Now();
+  std::vector<ImportedCookie> cookies;
+  while (s.Step()) {
+    const std::string host_key = s.ColumnString(1);
+    const bool is_persistent = s.ColumnInt(11) != 0;
+    const bool has_expires = s.ColumnInt(10) != 0;
+    const base::Time expiration = s.ColumnTime(6);
+
+    // Session cookies (not persistent) and already-expired cookies are not
+    // imported. They are not failures, so they are not counted.
+    if (!is_persistent) {
+      continue;
+    }
+    if (has_expires && expiration <= now) {
+      continue;
+    }
+
+    std::string value = s.ColumnString(4);
+    base::span<const uint8_t> encrypted = s.ColumnBlob(13);
+    if (!encrypted.empty()) {
+      std::string decrypted;
+      switch (DecryptPasswordValue(key ? *key : empty_key, encrypted,
+                                   &decrypted)) {
+        case DecryptResult::kSkippedV20:
+          ++stats_.cookies_skipped_app_bound;
+          continue;
+        case DecryptResult::kSkippedOther:
+        case DecryptResult::kError:
+          ++stats_.cookies_failed;
+          continue;
+        case DecryptResult::kOk:
+          break;
+      }
+      if (has_host_hash_prefix) {
+        const auto hash = crypto::hash::Sha256(host_key);
+        std::string_view prefix(reinterpret_cast<const char*>(hash.data()),
+                                hash.size());
+        if (!base::StartsWith(decrypted, prefix,
+                              base::CompareCase::SENSITIVE)) {
+          // The expected per-host hash is missing; treat the value as
+          // unreadable rather than import a wrong value.
+          ++stats_.cookies_failed;
+          continue;
+        }
+        decrypted = decrypted.substr(prefix.size());
+      }
+      value = std::move(decrypted);
+    }
+
+    ImportedCookie cookie;
+    cookie.creation = s.ColumnTime(0);
+    cookie.domain = host_key;
+    cookie.top_frame_site_key = s.ColumnString(2);
+    cookie.name = s.ColumnString(3);
+    cookie.value = std::move(value);
+    cookie.path = s.ColumnString(5);
+    cookie.expiration = expiration;
+    cookie.secure = s.ColumnInt(7) != 0;
+    cookie.httponly = s.ColumnInt(8) != 0;
+    cookie.last_access = s.ColumnTime(9);
+    cookie.priority = s.ColumnInt(12);
+    cookie.same_site = s.ColumnInt(14);
+    cookie.source_scheme = s.ColumnInt(15);
+    cookie.source_port = s.ColumnInt(16);
+    cookie.last_update = s.ColumnTime(17);
+    cookie.source_type = s.ColumnInt(18);
+    cookie.has_cross_site_ancestor = s.ColumnInt(19) != 0;
+    cookies.push_back(std::move(cookie));
+  }
+
+  stats_.cookies = static_cast<int>(cookies.size());
+  if (!cookies.empty()) {
+    bridge->SetCookies(cookies);
+  }
+  if (key) {
+    key->Clear();
+  }
+#endif  // BUILDFLAG(IS_WIN) || BUILDFLAG(IS_LINUX)
+}
