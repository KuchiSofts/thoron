+TEST_F(ThoronUpdateClientTest, ATruncatedOrLongerDownloadIsNeverInstalled) {
+  Publish();
+  network_.AddResponse(data::kDeltaUrl, Bytes(data::kDelta).substr(0, 100));
+  network_.AddResponse(data::kInstallerUrl, Bytes(data::kInstaller) + "x");
+  const UpdateClient::Status status = Look(*Client(), /*install=*/true);
+  EXPECT_EQ(status.state, State::kError);
+  EXPECT_TRUE(installed_.empty());
+  // Nothing is left that could be taken for a package: the one that came too
+  // long is gone, and of the short one only its part, for the next look to go
+  // on from.
+  base::FileEnumerator left(config_.download_dir, false, base::FileEnumerator::FILES);
+  for (base::FilePath path = left.Next(); !path.empty(); path = left.Next()) {
+    EXPECT_EQ(path.Extension(), FILE_PATH_LITERAL(".part")) << path;
+  }
