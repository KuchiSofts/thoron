@@ -0,0 +1,60 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_UPDATE_SNAPSHOT_H_
+#define COMPONENTS_THORON_UPDATE_SNAPSHOT_H_
+
+#include <stdint.h>
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/files/file_path.h"
+
+// A copy of what matters most in every profile, taken before an update that
+// changes the major version (ROADMAP P3.7), and put back by a rollback (P3.8):
+// bookmarks, settings, saved passwords, history, cookies, autofill, and the
+// open windows and tabs. Each file is copied, its copy checked, and every
+// database in it checked by SQLite itself. Nothing of what the files hold is
+// read beyond that, logged or sent anywhere.
+
+namespace thoron_update {
+
+struct SnapshotReport {
+  // A snapshot was written and every file in it verified. A database that
+  // SQLite finds damaged is copied as it is and named in `problems`; the
+  // snapshot is still kept, and `ok` is false.
+  bool ok = false;
+  base::FilePath folder;
+  int profiles = 0;
+  int files = 0;
+  int64_t bytes = 0;
+  // Names of files and what is wrong, never their content.
+  std::vector<std::string> problems;
+};
+
+// The files of a profile that a snapshot holds, as paths inside it. A database
+// is copied with its journal when it has one.
+std::vector<std::string> SnapshotFiles();
+
+// Takes a snapshot of `user_data` (the browser's folder of profiles) into a new
+// folder of `snapshots` named `label` (letters, digits, '-', '_' and '.' only),
+// and removes the oldest snapshots so that `keep` are left. The browser should
+// not be running; files it is writing may differ from what was read.
+SnapshotReport TakeSnapshot(const base::FilePath& user_data,
+                            const base::FilePath& snapshots,
+                            std::string_view label,
+                            int keep = 2);
+
+// Puts the files of the snapshot in `folder` back into `user_data`, after
+// checking each of them against what the snapshot recorded. Nothing is put back
+// unless every file verifies. Files of the profiles that the snapshot does not
+// hold are left alone. True when everything was put back.
+bool RestoreSnapshot(const base::FilePath& folder,
+                     const base::FilePath& user_data,
+                     std::vector<std::string>* problems);
+
+}  // namespace thoron_update
+
+#endif  // COMPONENTS_THORON_UPDATE_SNAPSHOT_H_
