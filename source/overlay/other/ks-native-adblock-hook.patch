+#include "base/strings/string_number_conversions.h"
+#include "build/build_config.h"
+#include "crypto/hash.h"
+
+namespace thoron_update {
+
+namespace {
+
+constexpr size_t kReadChunk = 1024 * 1024;
+constexpr int64_t kMostBytes = 2147483647;
+
+bool IsLowerHex64(std::string_view text) {
+  return text.size() == 64 && std::ranges::all_of(text, [](char c) {
+           return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+         });
+}
+
+}  // namespace
+
+std::string_view FileCheckName(FileCheck check) {
+  switch (check) {
+    case FileCheck::kOk:
+      return "ok";
+    case FileCheck::kMissing:
+      return "missing";
+    case FileCheck::kTruncated:
+      return "truncated";
+    case FileCheck::kTooLong:
+      return "too_long";
+    case FileCheck::kCorrupted:
+      return "corrupted";
+    case FileCheck::kUnreadable:
+      return "unreadable";
+    case FileCheck::kNotPlaced:
+      return "not_placed";
+    case FileCheck::kBadExpectation:
+      return "bad_expectation";
+  }
+  return "unknown";
+}
+
+namespace {
+
+bool GoodExpectation(const PackageFile& expected) {
+  return expected.size >= 1 && expected.size <= kMostBytes &&
+         IsLowerHex64(expected.sha256);
+}
+
+// Read only, and nobody may write to it while it is open; without
+// FLAG_WIN_SHARE_DELETE nobody can rename or remove it either (Windows).
+base::File OpenHeld(const base::FilePath& path) {
+  return base::File(path, base::File::FLAG_OPEN | base::File::FLAG_READ |
+                              base::File::FLAG_WIN_EXCLUSIVE_WRITE);
+}
+
+FileCheck CheckOpenFile(base::File& file, const PackageFile& expected) {
+  const int64_t length = file.GetLength();
+  if (length < 0) {
+    return FileCheck::kUnreadable;
+  }
+  if (length < expected.size) {
+    return FileCheck::kTruncated;
+  }
+  if (length > expected.size) {
+    return FileCheck::kTooLong;
+  }
+  crypto::hash::Hasher hasher(crypto::hash::kSha256);
+  std::vector<uint8_t> buffer(kReadChunk);
+  int64_t total = 0;
+  while (total < length) {
+    const std::optional<size_t> read = file.ReadAtCurrentPos(buffer);
+    if (!read || *read == 0) {
+      return FileCheck::kUnreadable;
+    }
+    hasher.Update(base::span(buffer).first(*read));
+    total += static_cast<int64_t>(*read);
+  }
+  if (total != length) {
+    return FileCheck::kUnreadable;
+  }
+  std::array<uint8_t, crypto::hash::kSha256Size> digest;
+  hasher.Finish(digest);
+  return base::HexEncodeLower(digest) == expected.sha256 ? FileCheck::kOk
+                                                         : FileCheck::kCorrupted;
+}
+
+}  // namespace
+
+FileCheck CheckFile(const base::FilePath& path, const PackageFile& expected) {
+  if (!GoodExpectation(expected)) {
+    return FileCheck::kBadExpectation;
+  }
+  base::File file = OpenHeld(path);
+  if (!file.IsValid()) {
+    return FileCheck::kMissing;
+  }
+  return CheckOpenFile(file, expected);
+}
+
+base::File HoldVerifiedFile(const base::FilePath& path,
+                            const PackageFile& expected,
+                            FileCheck* check) {
+  if (!GoodExpectation(expected)) {
+    *check = FileCheck::kBadExpectation;
+    return base::File();
+  }
+  base::File file = OpenHeld(path);
+  if (!file.IsValid()) {
+    *check = FileCheck::kMissing;
+    return base::File();
+  }
+  *check = CheckOpenFile(file, expected);
+  if (*check != FileCheck::kOk) {
+    return base::File();
+  }
+  return file;
+}
+
+FileCheck PlaceVerifiedFile(const base::FilePath& downloaded,
+                            const PackageFile& expected,
+                            const base::FilePath& destination) {
+  const FileCheck first = CheckFile(downloaded, expected);
+  if (first != FileCheck::kOk) {
+    if (first != FileCheck::kBadExpectation) {
+      base::DeleteFile(downloaded);
+    }
+    return first;
+  }
+  if (!base::ReplaceFile(downloaded, destination, nullptr)) {
+    base::DeleteFile(downloaded);
+    return FileCheck::kNotPlaced;
+  }
+  // Once more where it is used: what changed it between the two checks is
+  // found here, and the file goes.
+  const FileCheck there = CheckFile(destination, expected);
+  if (there != FileCheck::kOk) {
+    base::DeleteFile(destination);
+  }
+  return there;
+}
+
+std::vector<DownloadStep> PlanDownloads(const Decision& decision) {
+  std::vector<DownloadStep> plan;
+  if (decision.outcome == Outcome::kUpdaterTooOld && decision.full) {
+    plan.push_back({*decision.full, /*delta=*/false});
+    return plan;
+  }
+  if (decision.outcome != Outcome::kUpdate || !decision.full) {
+    return plan;
+  }
+  if (decision.delta && decision.delta->size < decision.full->size) {
+    plan.push_back({*decision.delta, /*delta=*/true});
+  }
+  plan.push_back({*decision.full, /*delta=*/false});
+  return plan;
+}
+
+std::optional<DownloadStep> RunDownloadPlan(
+    const std::vector<DownloadStep>& plan,
+    base::FunctionRef<bool(const DownloadStep&)> attempt) {
+  for (const DownloadStep& step : plan) {
+    if (attempt(step)) {
+      return step;
+    }
+  }
+  return std::nullopt;
+}
+
+Processor ThisProcessor() {
+  Processor cpu;
+#if defined(ARCH_CPU_X86_64)
+  const base::CPU& features = base::CPU::GetInstanceNoAllocation();
+  cpu.x64 = true;
+  cpu.sse41 = features.has_sse41();
+  cpu.sse42 = features.has_sse42();
+  cpu.avx = features.has_avx();
+  cpu.avx2 = features.has_avx2();
+  cpu.fma3 = features.has_fma3();
+  cpu.avx512 = features.has_avx512_f() && features.has_avx512_bw();
+#elif defined(ARCH_CPU_ARM64)
+  cpu.arm64 = true;
+#endif
+  return cpu;
+}
+
+bool RunsOn(Variant variant, const Processor& cpu) {
+  const bool sse4 = cpu.x64 && cpu.sse41 && cpu.sse42;
+  switch (variant) {
+    case Variant::kWinX64Avx2:
+    case Variant::kLinuxX64Avx2:
+      return sse4 && cpu.avx && cpu.avx2 && cpu.fma3;
+    case Variant::kWinX64Avx512:
+    case Variant::kLinuxX64Avx512:
+      return sse4 && cpu.avx && cpu.avx2 && cpu.fma3 && cpu.avx512;
+    case Variant::kWinX64Sse4:
+    case Variant::kLinuxX64Sse4:
+      return sse4;
+    case Variant::kWinArm64Armv8:
+    case Variant::kLinuxArm64Armv8:
+      return cpu.arm64;
+  }
+  return false;
+}
+
+std::vector<Variant> VariantsFor(Os os, const Processor& cpu) {
+  const std::array<Variant, 3> order =
+      os == Os::kWindows
+          ? std::array<Variant, 3>{Variant::kWinX64Avx2, Variant::kWinX64Sse4,
+                                   Variant::kWinArm64Armv8}
+          : std::array<Variant, 3>{Variant::kLinuxX64Avx2,
+                                   Variant::kLinuxX64Sse4,
+                                   Variant::kLinuxArm64Armv8};
+  std::vector<Variant> out;
+  for (Variant variant : order) {
+    if (RunsOn(variant, cpu)) {
+      out.push_back(variant);
+    }
+  }
+  return out;
+}
+
+}  // namespace thoron_update
