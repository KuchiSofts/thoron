+import("//chrome/browser/thoron_update/args.gni")
+
+# ThoronSetup.exe, the one installer for good (ROADMAP P3.19).
+template("thoron_setup_executable") {
+  executable(target_name) {
+    forward_variables_from(invoker, [ "output_name" ])
+    sources = [ "thoron_setup_win.cc" ]
+    configs -= [ "//build/config/win:console" ]
+    configs += [ "//build/config/win:windowed" ]
+    defines = invoker.defines
+    deps = [
+      "//base",
+      "//base/version_info",
+      "//components/thoron_update",
+      "//url",
+    ]
+    libs = [
+      "comctl32.lib",
+      "ole32.lib",
+      "winhttp.lib",
+    ]
+  }
+}
+
+thoron_setup_executable("thoron_setup") {
+  output_name = "ThoronSetup"
+  defines = [
+    "THORON_SETUP_PUBLIC_KEY=\"$thoron_update_public_key\"",
+    "THORON_SETUP_MANIFEST_URL=\"$thoron_update_manifest_url\"",
+  ]
+}
+
+# For tests only, never shipped: the published test key of the reference tool
+# (make_test_vectors.py), and the seams the tests use (thoron_setup_win.cc).
+thoron_setup_executable("thoron_setup_for_tests") {
+  defines = [
+    "THORON_SETUP_FOR_TESTS",
+    "THORON_SETUP_PUBLIC_KEY=\"$thoron_update_test_public_key\"",
+    "THORON_SETUP_MANIFEST_URL=\"https://github.com/KuchiSofts/thoron/releases/download/v0.1.2/update.json\"",
+  ]
+}
diff --git a/components/thoron_update/setup/thoron_setup_win.cc b/components/thoron_update/setup/thoron_setup_win.cc
new file mode 100644
index 0000000000000000000000000000000000000000..3b5adeda0fba80dd593e0e3ed74d2a230cb80c10
--- /dev/null
+++ b/components/thoron_update/setup/thoron_setup_win.cc
@@ -0,0 +1,500 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// ThoronSetup.exe, the one installer for good (ROADMAP P3.19): a small program
+// that never changes with a release. It fetches the channel's signed update
+// manifest from Thoron's releases on GitHub, checks it as every updater does
+// (manifest.h), picks the fastest build this processor runs (setup_plan.h),
+// downloads that release's full installer, checks its length and SHA-256
+// against the signed manifest, and runs it. Anything that does not verify is
+// never run.
+//
+// Exit status: 0 installed; 2 the release cannot be verified; 3 no installer
+// for this computer; 4 the network failed; 5 the download is not the one the
+// manifest names; 6 the installer failed; 7 this Setup is too old; 8 (with
+// --scheduled) the installed Thoron is the newest; 9 (with --scheduled) its
+// updates are not automatic, or it is installed for every user; 10 (with
+// --scheduled) the connection is metered, so the download waits.
+//
+// --scheduled [--variant=<build>] (ROADMAP P3.10): the daily look of an
+// installed Thoron, run by the task its installer registers for the user (no
+// administrator rights; chrome/installer/setup/thoron_update_task.h). No window
+// and no message. It does nothing (9) when Thoron's updates are not automatic
+// (the setting kept in the program folder, cli.h) or the copy is installed for
+// every user (under Program Files: its administrator updates it). Otherwise,
+// when the release of that build is newer than the newest version folder
+// beside this program's own (Application\<version>\ThoronSetup.exe), its
+// installer runs silently and leaves a running Thoron as it is (it takes the
+// new version at its next start); else nothing happens (8). On a metered
+// connection it downloads nothing (10), as the browser's own looks (design
+// 7.5); the next day's look tries again.
+//
+// The build for tests (thoron_setup_for_tests, never shipped: its key is the
+// published test key) also takes --from-folder <dir> (the release's files from
+// a folder instead of the network), --now <seconds>, --assume-cpu
+// avx2|sse4|old, --message-file <path> (the message is written there
+// instead of shown), --program-folder <dir> (the installed copy the daily
+// look looks at) and --assume-metered.
+
+#include <windows.h>
+
+#include <commctrl.h>
+#include <netlistmgr.h>
+#include <winhttp.h>
+#include <wrl/client.h>
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/at_exit.h"
+#include "base/base64.h"
+#include "base/command_line.h"
+#include "base/files/file.h"
+#include "base/files/file_path.h"
+#include "base/files/file_enumerator.h"
+#include "base/files/file_util.h"
+#include "base/path_service.h"
+#include "base/process/launch.h"
+#include "base/process/process.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/time/time.h"
+#include "base/win/scoped_com_initializer.h"
+#include "base/version_info/version_info.h"
+#include "components/thoron_update/cli.h"
+#include "components/thoron_update/manifest.h"
+#include "components/thoron_update/package.h"
+#include "components/thoron_update/setup_plan.h"
+#include "url/gurl.h"
+
+namespace {
+
+constexpr char kPublicKey[] = THORON_SETUP_PUBLIC_KEY;
+constexpr char kManifestUrl[] = THORON_SETUP_MANIFEST_URL;
+constexpr char kChannel[] = "stable";
+
+enum ExitCode {
+  kInstalled = 0,
+  kCannotVerify = 2,
+  kNoInstaller = 3,
+  kNetwork = 4,
+  kBadDownload = 5,
+  kInstallerFailed = 6,
+  kSetupTooOld = 7,
+  kUpToDate = 8,
+  kNotAutomatic = 9,
+  kMetered = 10,
+};
+
+constexpr UINT kProgressMessage = WM_APP + 1;
+constexpr UINT kDoneMessage = WM_APP + 2;
+
+struct State {
+  HWND window = nullptr;
+  HWND label = nullptr;
+  HWND bar = nullptr;
+  int exit_code = kNetwork;
+  std::wstring message;
+};
+State g_state;
+
+const base::CommandLine& Command() {
+  return *base::CommandLine::ForCurrentProcess();
+}
+
+#if defined(THORON_SETUP_FOR_TESTS)
+bool ForTests() {
+  return true;
+}
+#else
+bool ForTests() {
+  return false;
+}
+#endif
+
+void SetLabel(const std::wstring& text) {
+  if (g_state.label) {
+    ::SetWindowTextW(g_state.label, text.c_str());
+  }
+}
+
+// --- the network: Windows' own HTTP client, https only, the system's proxy ---
+
+std::optional<std::string> Fetch(const std::string& url_text,
+                                 int64_t most,
+                                 bool report_progress) {
+  const GURL url(url_text);
+  if (!url.is_valid() || !url.SchemeIs("https")) {
+    return std::nullopt;
+  }
+  HINTERNET session = ::WinHttpOpen(L"Thoron Setup", WINHTTP_ACCESS_TYPE_AUTOMATIC_PROXY,
+                                    WINHTTP_NO_PROXY_NAME, WINHTTP_NO_PROXY_BYPASS, 0);
+  if (!session) {
+    return std::nullopt;
+  }
+  DWORD protocols = WINHTTP_FLAG_SECURE_PROTOCOL_TLS1_2 | WINHTTP_FLAG_SECURE_PROTOCOL_TLS1_3;
+  ::WinHttpSetOption(session, WINHTTP_OPTION_SECURE_PROTOCOLS, &protocols, sizeof(protocols));
+  std::optional<std::string> body;
+  const std::wstring host = base::UTF8ToWide(url.host());
+  const std::wstring path = base::UTF8ToWide(url.PathForRequest());
+  HINTERNET connection = ::WinHttpConnect(session, host.c_str(),
+                                          static_cast<INTERNET_PORT>(url.EffectiveIntPort()), 0);
+  HINTERNET request = connection
+                          ? ::WinHttpOpenRequest(connection, L"GET", path.c_str(), nullptr,
+                                                 WINHTTP_NO_REFERER, WINHTTP_DEFAULT_ACCEPT_TYPES,
+                                                 WINHTTP_FLAG_SECURE)
+                          : nullptr;
+  // Redirects stay on https (the default policy refuses https to http); no
+  // cookies are kept or sent.
+  DWORD no_cookies = WINHTTP_DISABLE_COOKIES;
+  if (request) {
+    ::WinHttpSetOption(request, WINHTTP_OPTION_DISABLE_FEATURE, &no_cookies, sizeof(no_cookies));
+  }
+  if (request &&
+      ::WinHttpSendRequest(request, WINHTTP_NO_ADDITIONAL_HEADERS, 0, WINHTTP_NO_REQUEST_DATA, 0, 0,
+                           0) &&
+      ::WinHttpReceiveResponse(request, nullptr)) {
+    DWORD status = 0;
+    DWORD size = sizeof(status);
+    ::WinHttpQueryHeaders(request, WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER,
+                          WINHTTP_HEADER_NAME_BY_INDEX, &status, &size, WINHTTP_NO_HEADER_INDEX);
+    if (status == 200) {
+      std::string data;
+      bool ok = true;
+      while (ok) {
+        DWORD available = 0;
+        if (!::WinHttpQueryDataAvailable(request, &available)) {
+          ok = false;
+          break;
+        }
+        if (available == 0) {
+          break;
+        }
+        if (static_cast<int64_t>(data.size() + available) > most) {
+          ok = false;  // longer than may be: refused, never cut
+          break;
+        }
+        const size_t at = data.size();
+        data.resize(at + available);
+        DWORD read = 0;
+        if (!::WinHttpReadData(request, data.data() + at, available, &read)) {
+          ok = false;
+          break;
+        }
+        data.resize(at + read);
+        if (report_progress && g_state.window) {
+          ::PostMessageW(g_state.window, kProgressMessage,
+                         static_cast<WPARAM>(data.size() * 100 / std::max<int64_t>(1, most - 1)), 0);
+        }
+      }
+      if (ok) {
+        body = std::move(data);
+      }
+    }
+  }
+  if (request) {
+    ::WinHttpCloseHandle(request);
+  }
+  if (connection) {
+    ::WinHttpCloseHandle(connection);
+  }
+  ::WinHttpCloseHandle(session);
+  return body;
+}
+
+// The release's files: from the network, or (tests) from a folder.
+std::optional<std::string> ReleaseFile(const std::string& url, int64_t most, bool progress) {
+  if (ForTests() && Command().HasSwitch("from-folder")) {
+    const base::FilePath file =
+        Command().GetSwitchValuePath("from-folder").AppendASCII(GURL(url).ExtractFileName());
+    std::string data;
+    if (!base::ReadFileToStringWithMaxSize(file, &data, static_cast<size_t>(most))) {
+      return std::nullopt;
+    }
+    return data;
+  }
+  return Fetch(url, most, progress);
+}
+
+thoron_update::Processor TheProcessor() {
+  thoron_update::Processor cpu = thoron_update::ThisProcessor();
+  if (ForTests() && Command().HasSwitch("assume-cpu")) {
+    const std::string assume = Command().GetSwitchValueASCII("assume-cpu");
+    if (assume == "sse4" || assume == "old") {
+      cpu.avx = cpu.avx2 = cpu.fma3 = cpu.avx512 = false;
+    }
+    if (assume == "old") {
+      cpu.sse41 = cpu.sse42 = false;
+    }
+  }
+  return cpu;
+}
+
+int64_t Now() {
+  int64_t now = (base::Time::Now() - base::Time::UnixEpoch()).InSeconds();
+  if (ForTests() && Command().HasSwitch("now")) {
+    base::StringToInt64(Command().GetSwitchValueASCII("now"), &now);
+  }
+  return now;
+}
+
+bool Scheduled() {
+  return Command().HasSwitch("scheduled");
+}
+
+// The installed Thoron's program folder: Application, the folder above this
+// program's own (the build for tests may name another with --program-folder).
+base::FilePath ProgramFolder() {
+  if (ForTests() && Command().HasSwitch("program-folder")) {
+    return Command().GetSwitchValuePath("program-folder");
+  }
+  base::FilePath exe;
+  if (!base::PathService::Get(base::FILE_EXE, &exe)) {
+    return base::FilePath();
+  }
+  return exe.DirName().DirName();
+}
+
+// A system install lives under Program Files.
+bool ForEveryUser(const base::FilePath& program) {
+  for (int key : {base::DIR_PROGRAM_FILES, base::DIR_PROGRAM_FILESX86,
+                  base::DIR_PROGRAM_FILES6432}) {
+    base::FilePath root;
+    if (base::PathService::Get(key, &root) && (root == program || root.IsParent(program))) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// A connection paid for by the amount, or near its limit, as Windows knows it
+// (Chromium's own mapping: net/base/network_cost_change_notifier_win.cc).
+bool Metered() {
+  if (ForTests() && Command().HasSwitch("assume-metered")) {
+    return true;
+  }
+  base::win::ScopedCOMInitializer com(base::win::ScopedCOMInitializer::kMTA);
+  Microsoft::WRL::ComPtr<INetworkCostManager> costs;
+  DWORD cost = NLM_CONNECTION_COST_UNKNOWN;
+  if (!com.Succeeded() ||
+      FAILED(::CoCreateInstance(CLSID_NetworkListManager, nullptr, CLSCTX_ALL,
+                                IID_PPV_ARGS(&costs))) ||
+      FAILED(costs->GetCost(&cost, nullptr))) {
+    return false;
+  }
+  return cost != NLM_CONNECTION_COST_UNKNOWN && (cost & NLM_CONNECTION_COST_UNRESTRICTED) == 0;
+}
+
+// The build the daily look keeps: the task names it.
+std::optional<thoron_update::Variant> ScheduledVariant() {
+  if (!Scheduled() || !Command().HasSwitch("variant")) {
+    return std::nullopt;
+  }
+  return thoron_update::ParseVariant(Command().GetSwitchValueASCII("variant"));
+}
+
+// The newest version folder of the installed Thoron.
+std::optional<thoron_update::BuildVersion> InstalledVersion(const base::FilePath& program) {
+  std::optional<thoron_update::BuildVersion> newest;
+  base::FileEnumerator folders(program, /*recursive=*/false, base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath folder = folders.Next(); !folder.empty(); folder = folders.Next()) {
+    const std::optional<thoron_update::BuildVersion> version =
+        thoron_update::ParseBuildVersion(folder.BaseName().AsUTF8Unsafe());
+    if (version && (!newest || *version > *newest)) {
+      newest = version;
+    }
+  }
+  return newest;
+}
+
+void Finish(int code, const std::string& message) {
+  g_state.exit_code = code;
+  g_state.message = base::UTF8ToWide(message);
+}
+
+// --- the work -----------------------------------------------------------------
+
+void Work() {
+  if (Scheduled()) {
+    const base::FilePath program = ProgramFolder();
+    if (program.empty() || ForEveryUser(program)) {
+      return Finish(kNotAutomatic, "A Thoron installed for every user is updated by its "
+                                   "administrator.");
+    }
+    if (thoron_update::ReadUpdateMode(program) != thoron_update::UpdateMode::kAuto) {
+      return Finish(kNotAutomatic, "Thoron's updates are not automatic.");
+    }
+  }
+  SetLabel(L"Looking for the newest Thoron...");
+  const GURL manifest_url(kManifestUrl);
+  const std::optional<std::string> manifest =
+      ReleaseFile(kManifestUrl, thoron_update::kMaxManifestBytes + 1, false);
+  if (!manifest) {
+    return Finish(kNetwork, "Thoron Setup could not reach Thoron's releases on GitHub. Check the "
+                            "connection and try again.");
+  }
+  const std::string signature =
+      ReleaseFile(std::string(kManifestUrl) + ".sig", thoron_update::kSignatureBytes + 1, false)
+          .value_or(std::string());
+  std::vector<std::string> statements;
+  if (const std::optional<std::string> keys = ReleaseFile(
+          manifest_url.Resolve("update.key").spec(),
+          thoron_update::kKeyStatementBytes * thoron_update::kMostKeyStatements + 1, false)) {
+    for (size_t at = 0; at + thoron_update::kKeyStatementBytes <= keys->size() &&
+                        keys->size() % thoron_update::kKeyStatementBytes == 0;
+         at += thoron_update::kKeyStatementBytes) {
+      statements.push_back(keys->substr(at, thoron_update::kKeyStatementBytes));
+    }
+  }
+  thoron_update::PublicKey built_in = {};
+  std::string key;
+  if (base::Base64Decode(kPublicKey, &key) && key.size() == built_in.size()) {
+    std::copy(key.begin(), key.end(), built_in.begin());
+  }
+  const std::optional<thoron_update::BuildVersion> own =
+      thoron_update::ParseBuildVersion(version_info::GetVersionNumber());
+  const thoron_update::SetupPlan plan = thoron_update::PlanSetup(
+      *manifest, signature, thoron_update::TrustedKeys(built_in, statements), {"github.com"},
+      kChannel, own.value_or(thoron_update::BuildVersion()), TheProcessor(), Now(),
+      ScheduledVariant());
+  if (plan.outcome != thoron_update::Outcome::kUpdate || !plan.file) {
+    const int code = plan.outcome == thoron_update::Outcome::kNoPackage ? kNoInstaller
+                     : plan.outcome == thoron_update::Outcome::kUpdaterTooOld
+                         ? kSetupTooOld
+                         : kCannotVerify;
+    return Finish(code, thoron_update::SetupMessage(plan));
+  }
+  if (Scheduled()) {
+    const std::optional<thoron_update::BuildVersion> installed =
+        InstalledVersion(ProgramFolder());
+    const std::optional<thoron_update::BuildVersion> release =
+        thoron_update::ParseBuildVersion(plan.version);
+    if (!installed || !release || *release <= *installed) {
+      return Finish(kUpToDate, "The installed Thoron is the newest.");
+    }
+    if (Metered()) {
+      return Finish(kMetered, "Thoron " + plan.thoron_version +
+                                  " is out; it is not downloaded on a metered connection.");
+    }
+  }
+
+  SetLabel(base::UTF8ToWide("Downloading Thoron " + plan.thoron_version + "..."));
+  const std::optional<std::string> installer = ReleaseFile(plan.file->url, plan.file->size + 1, true);
+  if (!installer) {
+    return Finish(kNetwork, "Thoron Setup could not download Thoron " + plan.thoron_version +
+                                ". Check the connection and try again.");
+  }
+  base::FilePath folder;
+  if (!base::GetTempDir(&folder)) {
+    return Finish(kBadDownload, "Thoron Setup cannot write its download.");
+  }
+  folder = folder.AppendASCII("ThoronSetup");
+  const base::FilePath file = folder.AppendASCII(plan.file->sha256.substr(0, 16) + ".exe");
+  base::DeleteFile(file);
+  if (!base::CreateDirectory(folder) || !base::WriteFile(file, *installer)) {
+    return Finish(kBadDownload, "Thoron Setup cannot write its download.");
+  }
+  // What runs is the file as it lies on the disk, so that is what is checked.
+  if (thoron_update::CheckFile(file, *plan.file) != thoron_update::FileCheck::kOk) {
+    base::DeleteFile(file);
+    return Finish(kBadDownload, "The download is not the installer Thoron's signed release names, so "
+                                "it was deleted and nothing was installed.");
+  }
+
+  SetLabel(base::UTF8ToWide("Installing Thoron " + plan.thoron_version + "..."));
+  base::CommandLine command(file);
+  if (Scheduled()) {
+    // No window, and a running Thoron stays as it is: the new version starts
+    // with its next start.
+    command.AppendSwitch("silent");
+    command.AppendSwitch("do-not-launch-chrome");
+  }
+  base::Process process = base::LaunchProcess(command, base::LaunchOptions());
+  int code = -1;
+  if (!process.IsValid() || !process.WaitForExit(&code)) {
+    base::DeleteFile(file);
+    return Finish(kInstallerFailed, "The installer of Thoron could not be started.");
+  }
+  base::DeleteFile(file);
+  // chrome/installer/util/util_constants.h: installed, repaired, updated, the
+  // version already there, a newer one already there, updated while in use.
+  for (int fine : {0, 1, 2, 3, 4, 30}) {
+    if (code == fine) {
+      return Finish(kInstalled, "Thoron " + plan.thoron_version + " is installed.");
+    }
+  }
+  Finish(kInstallerFailed,
+         "The installer of Thoron stopped with code " + base::NumberToString(code) + ".");
+}
+
+DWORD WINAPI WorkThread(void*) {
+  Work();
+  ::PostMessageW(g_state.window, kDoneMessage, 0, 0);
+  return 0;
+}
+
+LRESULT CALLBACK WindowProc(HWND window, UINT message, WPARAM w, LPARAM l) {
+  switch (message) {
+    case kProgressMessage:
+      ::SendMessageW(g_state.bar, PBM_SETPOS, std::min<WPARAM>(w, 100), 0);
+      return 0;
+    case kDoneMessage:
+      ::DestroyWindow(window);
+      return 0;
+    case WM_CLOSE:
+      // The work is not stopped halfway; the window goes when it is done.
+      return 0;
+    case WM_DESTROY:
+      ::PostQuitMessage(0);
+      return 0;
+  }
+  return ::DefWindowProcW(window, message, w, l);
+}
+
+}  // namespace
+
+int WINAPI wWinMain(HINSTANCE instance, HINSTANCE, PWSTR, int show) {
+  base::AtExitManager at_exit;
+  base::CommandLine::Init(0, nullptr);
+  INITCOMMONCONTROLSEX controls = {sizeof(controls), ICC_PROGRESS_CLASS};
+  ::InitCommonControlsEx(&controls);
+
+  WNDCLASSW type = {};
+  type.lpfnWndProc = WindowProc;
+  type.hInstance = instance;
+  type.hCursor = ::LoadCursorW(nullptr, IDC_ARROW);
+  type.hbrBackground = reinterpret_cast<HBRUSH>(COLOR_WINDOW + 1);
+  type.lpszClassName = L"ThoronSetup";
+  ::RegisterClassW(&type);
+  const bool quiet = Scheduled() || (ForTests() && Command().HasSwitch("message-file"));
+  g_state.window = ::CreateWindowExW(0, L"ThoronSetup", L"Thoron Setup",
+                                     WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU, CW_USEDEFAULT,
+                                     CW_USEDEFAULT, 440, 150, nullptr, nullptr, instance, nullptr);
+  g_state.label = ::CreateWindowExW(0, L"STATIC", L"", WS_CHILD | WS_VISIBLE, 20, 20, 390, 24,
+                                    g_state.window, nullptr, instance, nullptr);
+  g_state.bar = ::CreateWindowExW(0, PROGRESS_CLASSW, nullptr, WS_CHILD | WS_VISIBLE, 20, 55, 390,
+                                  20, g_state.window, nullptr, instance, nullptr);
+  if (!quiet) {
+    ::ShowWindow(g_state.window, show);
+  }
+  HANDLE worker = ::CreateThread(nullptr, 0, WorkThread, nullptr, 0, nullptr);
+  MSG message;
+  while (::GetMessageW(&message, nullptr, 0, 0) > 0) {
+    ::TranslateMessage(&message);
+    ::DispatchMessageW(&message);
+  }
+  if (worker) {
+    ::WaitForSingleObject(worker, INFINITE);
+    ::CloseHandle(worker);
+  }
+  if (ForTests() && Command().HasSwitch("message-file")) {
+    base::WriteFile(Command().GetSwitchValuePath("message-file"),
+                    base::WideToUTF8(g_state.message));
+  } else if (quiet) {
+    // --scheduled: nobody is there to read it; the exit status says it.
+  } else if (g_state.exit_code != kInstalled) {
+    ::MessageBoxW(nullptr, g_state.message.c_str(), L"Thoron Setup", MB_OK | MB_ICONWARNING);
+  }
+  return g_state.exit_code;
+}
