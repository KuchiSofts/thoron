@@ -0,0 +1,123 @@
+#!/usr/bin/env python3
+# Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be found in the LICENSE file.
+"""Writes update_client_test_data.h: what update_client_unittest.cc serves through a fake network.
+
+Made by the reference tool, tools/update/manifest.py of Thoron's repository, as manifest_test_vectors.h is: a
+signed manifest whose packages are small enough to download in a test (an "installer" of 2048 bytes and a
+smaller delta), the same release signed by a second key, and the key statement by which the test key
+introduces that second key. The keys are the test keys of make_test_vectors.py, never a release key.
+
+    py -3 -I make_client_test_data.py --repo <Thoron's repository>            write the header next to this file
+    py -3 -I make_client_test_data.py --repo <Thoron's repository> --check    exit 1 when the header differs
+"""
+import argparse
+import hashlib
+import sys
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+HEADER_NAME = "update_client_test_data.h"
+TEST_KEY_PHRASE = b"thoron-update test vectors: a key for tests only, never a release key"
+OTHER_KEY_PHRASE = b"thoron-update test vectors: another key for tests only"
+URL = "https://github.com/KuchiSofts/thoron/releases/download/v0.1.2/"
+
+
+def made(repo: Path) -> str:
+    sys.path.insert(0, str(repo))
+    from tools.update import manifest as mf
+    from tools.update.tests import test_manifest as cases
+
+    private = hashlib.sha256(TEST_KEY_PHRASE).digest()
+    public = mf.public_key_of(private)
+    other_private = hashlib.sha256(OTHER_KEY_PHRASE).digest()
+    other_public = mf.public_key_of(other_private)
+    installer = bytes((i * 7 + 3) % 251 for i in range(2048))
+    delta = bytes((i * 13 + 5) % 241 for i in range(512))
+    portable = bytes((i * 11 + 1) % 239 for i in range(1024))
+
+    def entry(name: str, data: bytes) -> dict:
+        return {"url": URL + name, "size": len(data), "sha256": hashlib.sha256(data).hexdigest()}
+
+    new, old = cases.NEW, cases.OLD
+    packages = {"win-x64-avx2": {
+        "installed": {"full": entry(f"thoron-{new}-win-x64-avx2-installer.exe", installer),
+                      "deltas": {old: entry(f"thoron-{old}-to-{new}-win-x64-avx2-installed.delta", delta)}},
+        "portable": {"full": entry(f"thoron-{new}-win-x64-avx2-portable.zip", portable)},
+    }}
+    manifest = mf.build(channel="stable", version=new, thoron_version="0.1.2", critical=False,
+                        min_updater_version=old, packages=packages, published=cases.PUBLISHED,
+                        allowed_hosts=cases.HOSTS)
+    signature = mf.sign(manifest, private, public, allowed_hosts=cases.HOSTS, now=cases.NOW)
+    other_signature = mf.sign(manifest, other_private, other_public, allowed_hosts=cases.HOSTS, now=cases.NOW)
+    statement = mf.sign_key_statement(private, other_public)
+
+    def array(name: str, data: bytes) -> list[str]:
+        out = [f"inline constexpr uint8_t {name}[] = {{"]
+        for i in range(0, len(data), 16):
+            out.append("    " + " ".join(f"0x{b:02x}," for b in data[i:i + 16]))
+        out.append("};")
+        return out
+
+    def text(name: str, data: bytes) -> list[str]:
+        assert all(32 <= b < 127 or b == 10 for b in data), name
+        body = data.decode("ascii").replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")
+        return [f'inline constexpr char {name}[] = "{body}";']
+
+    lines = [
+        "// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be",
+        "// found in the LICENSE file.",
+        "",
+        f"// Written by make_client_test_data.py from the reference tool; do not edit.",
+        "",
+        "#ifndef COMPONENTS_THORON_UPDATE_UPDATE_CLIENT_TEST_DATA_H_",
+        "#define COMPONENTS_THORON_UPDATE_UPDATE_CLIENT_TEST_DATA_H_",
+        "",
+        "#include <stdint.h>",
+        "",
+        "namespace thoron_update::client_test {",
+        "",
+        f'inline constexpr char kInstalled[] = "{old}";',
+        f'inline constexpr char kNewest[] = "{new}";',
+        f"inline constexpr int64_t kNow = {cases.NOW};",
+        f"inline constexpr int64_t kSerial = {cases.SERIAL};",
+        f'inline constexpr char kManifestUrl[] = "{URL}update.json";',
+        f'inline constexpr char kInstallerUrl[] = "{packages["win-x64-avx2"]["installed"]["full"]["url"]}";',
+        f'inline constexpr char kDeltaUrl[] = "{packages["win-x64-avx2"]["installed"]["deltas"][old]["url"]}";',
+        f'inline constexpr char kPortableUrl[] = "{packages["win-x64-avx2"]["portable"]["full"]["url"]}";',
+        "",
+        *text("kManifest", manifest),
+        *array("kSignature", signature),
+        *array("kOtherSignature", other_signature),
+        *array("kPublicKey", public),
+        *array("kOtherPublicKey", other_public),
+        *array("kKeyStatement", statement),
+        *array("kInstaller", installer),
+        *array("kDelta", delta),
+        *array("kPortable", portable),
+        "",
+        "}  // namespace thoron_update::client_test",
+        "",
+        "#endif  // COMPONENTS_THORON_UPDATE_UPDATE_CLIENT_TEST_DATA_H_",
+        "",
+    ]
+    return "\n".join(lines)
+
+
+def main(argv: list[str]) -> int:
+    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    p.add_argument("--repo", type=Path, required=True)
+    p.add_argument("--check", action="store_true")
+    a = p.parse_args(argv)
+    text = made(a.repo)
+    target = HERE / HEADER_NAME
+    if a.check:
+        same = target.is_file() and target.read_text(encoding="utf-8") == text
+        print(f"client test data: {HEADER_NAME} is {'' if same else 'NOT '}what the reference gives")
+        return 0 if same else 1
+    target.write_text(text, encoding="utf-8", newline="\n")
+    print(f"client test data: wrote {HEADER_NAME}, {len(text)} bytes")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
