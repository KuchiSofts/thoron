+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_PORTABLE_KEY_ARGON2ID_H_
+#define COMPONENTS_THORON_PORTABLE_KEY_ARGON2ID_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "base/containers/span.h"
+#include "base/time/time.h"
+
+namespace thoron_portable_key {
+
+// The cost of one Argon2id derivation (RFC 9106): memory in KiB, passes over
+// it, and lanes.
+struct Argon2Params {
+  uint32_t memory_kib = 0;
+  uint32_t passes = 0;
+  uint32_t lanes = 0;
+
+  friend bool operator==(const Argon2Params&, const Argon2Params&) = default;
+};
+
+// The least a key file may ask for: RFC 9106's second recommended setting
+// (64 MiB, 3 passes, 4 lanes). A key file asking for less is refused, so a
+// changed file cannot make the passphrase cheaper to guess (threat model E1).
+inline constexpr Argon2Params kFloor{65536, 3, 4};
+// The most a key file may ask for, so that a crafted file cannot take all of
+// a PC's memory or time: 1 GiB, 32 passes, 16 lanes.
+inline constexpr Argon2Params kCeiling{1048576, 32, 16};
+// What setup aims for on the PC that sets it up; a PC half as fast still opens
+// the profile in a few seconds.
+inline constexpr base::TimeDelta kCalibrationTarget = base::Milliseconds(750);
+// The most memory setup asks for, so that a weaker PC opens the profile too.
+inline constexpr uint32_t kMostCalibratedMemoryKib = 262144;  // 256 MiB
+
+// Between the floor and the ceiling, and lanes no more than memory allows.
+bool AreAcceptable(const Argon2Params& params);
+
+// The setting for this PC, given how long one derivation at the floor took
+// here: the floor's passes and lanes, and more memory (in steps of 64 MiB, up
+// to kMostCalibratedMemoryKib) while it would still take no longer than
+// kCalibrationTarget.
+Argon2Params Calibrate(base::TimeDelta floor_time);
+
+// Argon2id (version 0x13) of `password` and `salt` into `out`. `password` is
+// wiped as soon as it is no longer needed, whatever the result. False when the
+// library refuses (for example memory it cannot have).
+[[nodiscard]] bool Argon2id(base::span<uint8_t> password,
+                            base::span<const uint8_t> salt,
+                            const Argon2Params& params,
+                            base::span<uint8_t> out);
+
+// The same with RFC 9106's optional secret and associated data, for the test
+// vectors only.
+[[nodiscard]] bool Argon2idForTesting(base::span<uint8_t> password,
+                                      base::span<const uint8_t> salt,
+                                      base::span<const uint8_t> secret,
+                                      base::span<const uint8_t> associated_data,
+                                      const Argon2Params& params,
+                                      base::span<uint8_t> out);
+
+}  // namespace thoron_portable_key
+
+#endif  // COMPONENTS_THORON_PORTABLE_KEY_ARGON2ID_H_
