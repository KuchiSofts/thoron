+namespace thoron_update {
+namespace {
+
+namespace data = client_test;
+using State = UpdateClient::State;
+
+template <size_t N>
+std::string Bytes(const uint8_t (&bytes)[N]) {
+  return std::string(reinterpret_cast<const char*>(bytes), N);
+}
+
+template <size_t N>
+PublicKey Key(const uint8_t (&bytes)[N]) {
+  static_assert(N == kPublicKeyBytes);
+  PublicKey key;
+  std::copy(bytes, bytes + N, key.begin());
+  return key;
+}
+
+class ThoronUpdateClientTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(dir_.CreateUniqueTempDir());
+    UpdateClient::RegisterPrefs(prefs_.registry());
+    clock_.SetNow(base::Time::UnixEpoch() + base::Seconds(data::kNow));
+    config_.public_key = Key(data::kPublicKey);
+    config_.allowed_hosts = {"github.com"};
+    config_.manifest_url = GURL(data::kManifestUrl);
+    config_.installed = *ParseBuildVersion(data::kInstalled);
+    config_.updater = *ParseBuildVersion(data::kInstalled);
+    config_.download_dir = dir_.GetPath().AppendASCII("Update");
+    config_.install = base::BindRepeating(&ThoronUpdateClientTest::Install, base::Unretained(this));
+  }
+
+  // The release as it is published.
+  void Publish() {
+    network_.AddResponse(data::kManifestUrl, std::string(data::kManifest));
+    network_.AddResponse(std::string(data::kManifestUrl) + ".sig", Bytes(data::kSignature));
+    network_.AddResponse(UpdateClient::KeyStatementsUrl(GURL(data::kManifestUrl)).spec(), "",
+                         net::HTTP_NOT_FOUND);
+    network_.AddResponse(data::kInstallerUrl, Bytes(data::kInstaller));
+    network_.AddResponse(data::kDeltaUrl, Bytes(data::kDelta));
+  }
+
+  // The installer the client hands a package to: it reads what it was given.
+  bool Install(const base::FilePath& package, bool delta, const std::string& version) {
+    EXPECT_EQ(version, data::kNewest);
+    std::string read;
+    base::ReadFileToString(package, &read);
+    // Nothing else may write to the package while it is installed (U8).
+    const bool writable = base::File(package, base::File::FLAG_OPEN | base::File::FLAG_WRITE).IsValid();
+    base::AutoLock hold(lock_);
+    installed_.push_back(read);
+    writable_.push_back(writable);
+    deltas_.push_back(delta);
+    return install_works_ && !(fail_delta_ && delta);
+  }
+
+  // A look, to its last state; every state it went through is in `states_`.
+  UpdateClient::Status Look(UpdateClient& client, bool install) {
+    base::RunLoop loop;
+    UpdateClient::Status last;
+    states_.clear();
+    client.Check(install, base::BindLambdaForTesting([&](const UpdateClient::Status& status) {
+                   if (states_.empty() || states_.back() != status.state) {
+                     states_.push_back(status.state);
+                   }
+                   last = status;
+                   if (status.state != State::kChecking && status.state != State::kDownloading &&
+                       status.state != State::kInstalling) {
+                     loop.Quit();
+                   }
+                 }));
+    loop.Run();
+    return last;
+  }
+
+  std::unique_ptr<UpdateClient> Client() {
+    return std::make_unique<UpdateClient>(
+        config_, base::MakeRefCounted<network::WeakWrapperSharedURLLoaderFactory>(&network_),
+        &prefs_, &clock_);
+  }
+
+  bool DownloadFolderIsEmpty() {
+    return base::IsDirectoryEmpty(config_.download_dir) || !base::PathExists(config_.download_dir);
+  }
+
+  base::test::TaskEnvironment task_environment_;
+  base::ScopedTempDir dir_;
+  TestingPrefServiceSimple prefs_;
+  base::SimpleTestClock clock_;
+  network::TestURLLoaderFactory network_;
+  UpdateClient::Config config_;
+  std::vector<State> states_;
+
+  base::Lock lock_;
+  std::vector<std::string> installed_;
+  std::vector<bool> deltas_;
+  std::vector<bool> writable_;
+  bool install_works_ = true;
+  bool fail_delta_ = false;
+};
+
+TEST_F(ThoronUpdateClientTest, WithoutAKeyNothingIsFetched) {
+  config_.public_key = {};
+  const UpdateClient::Status status = Look(*Client(), /*install=*/true);
+  EXPECT_EQ(status.state, State::kDisabled);
+  EXPECT_EQ(network_.NumPending(), 0);
+  EXPECT_EQ(network_.total_requests(), 0u);
+}
+
+TEST_F(ThoronUpdateClientTest, TheInstalledReleaseIsUpToDateAndItsSerialIsKept) {
+  Publish();
+  config_.installed = *ParseBuildVersion(data::kNewest);
+  const UpdateClient::Status status = Look(*Client(), /*install=*/true);
+  EXPECT_EQ(status.state, State::kUpToDate);
+  EXPECT_EQ(prefs_.GetInt64("thoron_update.last_serial"), data::kSerial);
+  EXPECT_TRUE(installed_.empty());
+}
+
+// An install for every user has no installer the updater may run (its
+// installer needs administrator rights, P3.10): even an asked look only says
+// what is out, and why it is not installed.
+TEST_F(ThoronUpdateClientTest, ACopyWithoutAnInstallerSaysWhyItUpdatesByHand) {
+  Publish();
+  config_.install = UpdateClient::Installer();
+  config_.by_hand = "this copy is installed for every user of this computer";
+  const UpdateClient::Status status = Look(*Client(), /*install=*/true);
+  EXPECT_EQ(status.state, State::kAvailable);
+  EXPECT_EQ(status.detail, config_.by_hand);
+  EXPECT_TRUE(installed_.empty());
+  EXPECT_EQ(UpdateClient::ForAboutPage(status).message,
+            "Thoron 0.1.2 (" + std::string(data::kNewest) +
+                ") is out: this copy is installed for every user of this computer.");
+}
+
+TEST_F(ThoronUpdateClientTest, ALookWithoutInstallingSaysWhatIsThere) {
+  Publish();
+  const UpdateClient::Status status = Look(*Client(), /*install=*/false);
+  EXPECT_EQ(status.state, State::kAvailable);
+  EXPECT_EQ(status.version, data::kNewest);
+  EXPECT_EQ(status.thoron_version, "0.1.2");
+  EXPECT_TRUE(installed_.empty());
+  EXPECT_TRUE(DownloadFolderIsEmpty());
+}
+
+TEST_F(ThoronUpdateClientTest, AnUpdateIsDownloadedCheckedInstalledAndThenWaitsForARelaunch) {
+  Publish();
+  auto client = Client();
+  const UpdateClient::Status status = Look(*client, /*install=*/true);
+  EXPECT_EQ(status.state, State::kReadyToRelaunch);
+  EXPECT_EQ(states_, (std::vector<State>{State::kChecking, State::kDownloading, State::kInstalling,
+                                         State::kReadyToRelaunch}));
+  // The delta is smaller, so it is the one installed.
+  ASSERT_EQ(installed_.size(), 1u);
+  EXPECT_EQ(installed_[0], Bytes(data::kDelta));
+  EXPECT_TRUE(deltas_[0]);
+#if BUILDFLAG(IS_WIN)
+  EXPECT_FALSE(writable_[0]);
+#endif
+  // Nothing is left in the download folder, neither the package nor a part.
+  EXPECT_TRUE(DownloadFolderIsEmpty());
+  // Until the restart, a look says the same and fetches nothing.
+  const size_t requests = network_.total_requests();
+  EXPECT_EQ(Look(*client, /*install=*/true).state, State::kReadyToRelaunch);
+  EXPECT_EQ(network_.total_requests(), requests);
+}
+
+TEST_F(ThoronUpdateClientTest, TheBrowserIsToldOnceAVersionIsInstalled) {
+  Publish();
+  std::vector<std::string> told;
+  config_.on_installed = base::BindLambdaForTesting([&](const std::string& version, bool critical) {
+    told.push_back(version + (critical ? " critical" : ""));
+  });
+  auto client = Client();
+  EXPECT_EQ(Look(*client, /*install=*/false).state, State::kAvailable);
+  EXPECT_TRUE(told.empty());
+  EXPECT_EQ(Look(*client, /*install=*/true).state, State::kReadyToRelaunch);
+  EXPECT_EQ(told, (std::vector<std::string>{data::kNewest}));
+  // a look after it tells nothing new
+  EXPECT_EQ(Look(*client, /*install=*/true).state, State::kReadyToRelaunch);
+  EXPECT_EQ(told.size(), 1u);
+}
+
+// --- P4.3: downloads that break are resumed ------------------------------------
+
+class ThoronUpdateClientResumeTest : public ThoronUpdateClientTest {
+ protected:
+  // Only the full installer is downloaded (an updater that is too old gets no
+  // delta), and every answer for it is made by `answer` from the Range asked.
+  void Serve(base::RepeatingCallback<void(const std::string& range)> answer) {
+    Publish();
+    config_.updater = *ParseBuildVersion("158.0.8127.2999");
+    network_.SetInterceptor(base::BindLambdaForTesting([this, answer](const network::ResourceRequest& r) {
+      if (r.url != GURL(data::kInstallerUrl)) {
+        return;
+      }
+      const std::string range = r.headers.GetHeader("Range").value_or("");
+      ranges_.push_back(range);
+      answer.Run(range);
+    }));
+  }
+
+  void Answer(int code, const std::string& body, const std::string& content_range = "") {
+    auto head = network::CreateURLResponseHead(static_cast<net::HttpStatusCode>(code));
+    if (!content_range.empty()) {
+      head->headers->AddHeader("Content-Range", content_range);
+    }
+    network_.AddResponse(GURL(data::kInstallerUrl), std::move(head), body,
+                         network::URLLoaderCompletionStatus(net::OK));
+  }
+
+  base::FilePath Part() {
+    return config_.download_dir.AppendASCII(
+        base::HexEncodeLower(crypto::hash::Sha256(Bytes(data::kInstaller))) + ".part");
+  }
+
+  std::vector<std::string> ranges_;
+};
