+
+#ifndef CHROME_BROWSER_UI_WEBUI_THORON_PORTABLE_UI_H_
+#define CHROME_BROWSER_UI_WEBUI_THORON_PORTABLE_UI_H_
+
+#include "content/public/browser/web_ui_controller.h"
+#include "content/public/browser/webui_config.h"
+
+namespace content {
+class WebUI;
+}  // namespace content
+
+// chrome://thoron-portable: the passphrase of a portable copy (ROADMAP P4.9).
+// Locks the copy's saved passwords and sign-ins with a passphrase (and a
+// recovery key), changes it, remembers or forgets this PC, and removes the
+// lock. The unlock window at start is chrome/browser/thoron_portable.
+inline constexpr char kThoronPortableHost[] = "thoron-portable";
+inline constexpr char kThoronPortableURL[] = "chrome://thoron-portable/";
+
+class ThoronPortableUI;
+
+class ThoronPortableUIConfig
+    : public content::DefaultWebUIConfig<ThoronPortableUI> {
+ public:
+  ThoronPortableUIConfig();
+};
+
+class ThoronPortableUI : public content::WebUIController {
+ public:
+  explicit ThoronPortableUI(content::WebUI* web_ui);
+  ThoronPortableUI(const ThoronPortableUI&) = delete;
+  ThoronPortableUI& operator=(const ThoronPortableUI&) = delete;
+  ~ThoronPortableUI() override;
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_THORON_PORTABLE_UI_H_
