@@ -0,0 +1,182 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/thoron_welcome_ui.h"
+
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/i18n/rtl.h"
+#include "base/memory/ref_counted_memory.h"
+#include "base/memory/weak_ptr.h"
+#include "base/strings/escape.h"
+#include "base/strings/strcat.h"
+#include "base/values.h"
+#include "build/build_config.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/shell_integration.h"
+#include "chrome/grit/generated_resources.h"
+#include "content/public/browser/url_data_source.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_message_handler.h"
+#include "content/public/common/url_constants.h"
+#include "ui/base/l10n/l10n_util.h"
+
+#if BUILDFLAG(IS_WIN)
+#include "chrome/browser/thoron_update/thoron_update_win.h"
+#endif
+
+namespace {
+
+constexpr char kScriptPath[] = "/welcome.js";
+
+std::string Text(int id) {
+  return base::EscapeForHTML(l10n_util::GetStringUTF8(id));
+}
+
+// The page in the browser's language. Its text is filled in here, escaped; the
+// default security policy of a data source stays: script only from this page.
+std::string Page() {
+  const std::string locale =
+      g_browser_process ? g_browser_process->GetApplicationLocale() : "en";
+  return base::StrCat({
+      "<!doctype html><html lang=\"", base::EscapeForHTML(locale), "\" dir=\"",
+      base::i18n::IsRTL() ? "rtl" : "ltr",
+      "\"><head><meta charset=\"utf-8\"><title>", Text(IDS_THORON_WELCOME_TITLE),
+      "</title><style>"
+      ":root{color-scheme:light dark;font-family:system-ui,sans-serif}"
+      "body{max-width:640px;margin:48px auto;padding:0 24px;line-height:1.5}"
+      "h1{font-size:28px;font-weight:600;margin:0 0 32px}"
+      "section{border:1px solid color-mix(in srgb,currentColor 20%,transparent);"
+      "border-radius:12px;padding:20px 24px;margin:0 0 16px}"
+      "h2{font-size:17px;margin:0 0 6px}p{margin:0 0 14px;opacity:.85}"
+      "a.button,button{display:inline-block;font:inherit;font-weight:600;padding:8px 18px;"
+      "border-radius:18px;border:0;background:#0f8b8d;color:#fff;text-decoration:none;cursor:pointer}"
+      "#already{font-weight:600;margin:0}.later{opacity:.7;font-size:14px}"
+      "</style></head><body><h1>", Text(IDS_THORON_WELCOME_TITLE), "</h1>",
+      "<section><h2>", Text(IDS_THORON_WELCOME_IMPORT_HEADING), "</h2><p>",
+      Text(IDS_THORON_WELCOME_IMPORT_TEXT),
+      "</p><a class=\"button\" id=\"import\" href=\"chrome://settings/importData\">",
+      Text(IDS_THORON_WELCOME_IMPORT_BUTTON), "</a></section>",
+      "<section id=\"default\"><h2>", Text(IDS_THORON_WELCOME_DEFAULT_HEADING),
+      "</h2><p>", Text(IDS_THORON_WELCOME_DEFAULT_TEXT),
+      "</p><button id=\"make-default\">", Text(IDS_THORON_WELCOME_DEFAULT_BUTTON),
+      "</button><p id=\"already\" hidden>", Text(IDS_THORON_WELCOME_ALREADY_DEFAULT),
+      "</p></section><p class=\"later\">", Text(IDS_THORON_WELCOME_LATER),
+      "</p><script src=\"welcome.js\"></script></body></html>"});
+}
+
+// Asks the browser whether Thoron is the default, and to open Windows' page
+// for it; shows the answer. A portable copy is not offered it.
+constexpr char kScript[] = R"js(
+const button = document.getElementById('make-default');
+const already = document.getElementById('already');
+window.thoronWelcomeDefault = (isDefault, portable) => {
+  // a portable copy is no program Windows knows: it is never the default
+  document.getElementById('default').hidden = portable;
+  button.hidden = isDefault;
+  already.hidden = !isDefault;
+};
+button.addEventListener('click', () => chrome.send('makeDefault'));
+chrome.send('checkDefault');
+)js";
+
+class ThoronWelcomeDataSource : public content::URLDataSource {
+ public:
+  ThoronWelcomeDataSource() = default;
+  ThoronWelcomeDataSource(const ThoronWelcomeDataSource&) = delete;
+  ThoronWelcomeDataSource& operator=(const ThoronWelcomeDataSource&) = delete;
+
+  // content::URLDataSource:
+  std::string GetSource() override { return kThoronWelcomeHost; }
+  std::string GetMimeType(const GURL& url) override {
+    return url.path() == kScriptPath ? "text/javascript" : "text/html";
+  }
+  void StartDataRequest(const GURL& url,
+                        const content::WebContents::Getter& wc_getter,
+                        GotDataCallback callback) override {
+    std::move(callback).Run(base::MakeRefCounted<base::RefCountedString>(
+        url.path() == kScriptPath ? std::string(kScript) : Page()));
+  }
+};
+
+class ThoronWelcomeHandler : public content::WebUIMessageHandler {
+ public:
+  ThoronWelcomeHandler() = default;
+  ThoronWelcomeHandler(const ThoronWelcomeHandler&) = delete;
+  ThoronWelcomeHandler& operator=(const ThoronWelcomeHandler&) = delete;
+  ~ThoronWelcomeHandler() override = default;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override {
+    web_ui()->RegisterMessageCallback(
+        "checkDefault", base::BindRepeating(&ThoronWelcomeHandler::CheckDefault,
+                                            weak_factory_.GetWeakPtr()));
+    web_ui()->RegisterMessageCallback(
+        "makeDefault", base::BindRepeating(&ThoronWelcomeHandler::MakeDefault,
+                                           weak_factory_.GetWeakPtr()));
+  }
+
+ private:
+  void CheckDefault(const base::ListValue&) {
+    AllowJavascript();
+    if (Portable()) {
+      CallJavascriptFunction("thoronWelcomeDefault", base::Value(false),
+                             base::Value(true));
+      return;
+    }
+    base::MakeRefCounted<shell_integration::DefaultBrowserWorker>()
+        ->StartCheckIsDefault(base::BindOnce(&ThoronWelcomeHandler::Show,
+                                             weak_factory_.GetWeakPtr()));
+  }
+
+  // On Windows 10 and 11 this opens Windows' own page for the default browser:
+  // the person confirms there, or not.
+  void MakeDefault(const base::ListValue&) {
+    AllowJavascript();
+    if (Portable()) {
+      return;
+    }
+    base::MakeRefCounted<shell_integration::DefaultBrowserWorker>()
+        ->StartSetAsDefault(base::BindOnce(&ThoronWelcomeHandler::Show,
+                                           weak_factory_.GetWeakPtr()));
+  }
+
+  void Show(shell_integration::DefaultWebClientState state) {
+    if (IsJavascriptAllowed()) {
+      CallJavascriptFunction("thoronWelcomeDefault",
+                             base::Value(state == shell_integration::IS_DEFAULT),
+                             base::Value(false));
+    }
+  }
+
+  // A portable copy leaves no trace on the PC and is not registered with
+  // Windows, so it is never made the default browser (docs/release/PORTABLE.md).
+  static bool Portable() {
+#if BUILDFLAG(IS_WIN)
+    return thoron_update_win::ConfigForThisCopy().kind ==
+           thoron_update::Kind::kPortable;
+#else
+    return false;
+#endif
+  }
+
+  base::WeakPtrFactory<ThoronWelcomeHandler> weak_factory_{this};
+};
+
+}  // namespace
+
+ThoronWelcomeUIConfig::ThoronWelcomeUIConfig()
+    : DefaultWebUIConfig(content::kChromeUIScheme, kThoronWelcomeHost) {}
+
+ThoronWelcomeUI::ThoronWelcomeUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  content::URLDataSource::Add(Profile::FromWebUI(web_ui),
+                              std::make_unique<ThoronWelcomeDataSource>());
+  web_ui->AddMessageHandler(std::make_unique<ThoronWelcomeHandler>());
+}
+
+ThoronWelcomeUI::~ThoronWelcomeUI() = default;
