+    p.add_argument("--repo", required=True, type=Path, help="Thoron's repository: tools/update/manifest.py is "
+                   "the reference")
+    p.add_argument("--out", type=Path, default=Path(__file__).resolve().with_name(HEADER_NAME),
+                   help=f"the header to write (default: {HEADER_NAME} next to this script)")
+    p.add_argument("--check", action="store_true", help="write nothing; exit 1 when the header differs")
+    a = p.parse_args(argv)
+    if not (a.repo / "tools" / "update" / "manifest.py").is_file():
+        print(f"vectors: {a.repo} is not Thoron's repository (no tools/update/manifest.py)", file=sys.stderr)
+        return 2
+    vectors = Vectors(a.repo.resolve())
+    text = vectors.header().encode("ascii")
+    if a.check:
+        same = a.out.is_file() and a.out.read_bytes() == text
+        print(f"vectors: {a.out.name} is " + ("what the reference gives" if same else "NOT what the reference "
+              "gives: run this script without --check"))
+        return 0 if same else 1
+    a.out.write_bytes(text)
+    print(f"vectors: wrote {vectors.count} vectors, {len(text)} bytes, to {a.out.name}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
