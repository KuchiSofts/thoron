+++ b/components/thoron_update/delta_package.h
@@ -0,0 +1,77 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_UPDATE_DELTA_PACKAGE_H_
+#define COMPONENTS_THORON_UPDATE_DELTA_PACKAGE_H_
+
+#include <string_view>
+#include <vector>
+
+#include "components/thoron_update/manifest.h"
+#include "components/thoron_update/swap.h"
+
+namespace base {
+class CommandLine;
+class FilePath;
+}  // namespace base
+
+// A delta package (ROADMAP P4.1), made by tools/release/delta.py: the files of
+// a newer version made from the folder of an older one. A .zip with
+// delta.json, which lists every file of the newer folder (its path, size and
+// SHA-256, and how it is made: `same` as the older file, `patch` with a Zucchini
+// patch from it, or `whole`), and the patches and whole files. The updater
+// applies it with Chromium's Zucchini, the code the tool made the patches with.
+namespace thoron_update {
+
+enum class DeltaResult {
+  kDone,
+  // Not a .zip with a delta.json of format 1, or a path that leaves the folder.
+  kNotADelta,
+  // The delta is not from the current version to the one asked for.
+  kWrongVersion,
+  // An older file it is made from is missing or not the one the delta names.
+  kOldFileDiffers,
+  // A patch that does not apply.
+  kPatchFails,
+  // A file it made is not the newer file the delta names.
+  kNewFileDiffers,
+  // More than kMostUnpackedBytes or kMostUnpackedFiles (portable_package.h).
+  kTooLarge,
+  // The staging folder is there already, or reading or writing failed.
+  kIoError,
+};
+
+std::string_view DeltaResultName(DeltaResult result);
+
+// Makes the folder of `to` in `staged`, which must not exist, from
+// `old_folder`, the folder of `from`, with the delta, and lists its files in
+// `files`. Every older file is checked against the SHA-256 the delta names
+// before it is used, and every file made against the newer one's. With
+// anything but kDone, nothing is left at `staged`.
+DeltaResult ApplyDelta(const base::FilePath& delta,
+                       const base::FilePath& old_folder,
+                       const BuildVersion& from,
+                       const BuildVersion& to,
+                       const base::FilePath& staged,
+                       std::vector<VersionFile>* files);
+
+// An installed copy (ROADMAP P4.1). Chromium's setup no longer applies patches
+// itself, so the delta of an installed release turns `program_folder`
+// (Application: thoron.exe and the folder of `from`, with its
+// Installer\setup.exe) into the newer version's files in `staged`, its own
+// setup.exe included at <version>\Installer\setup.exe. `setup` is then the
+// command that installs them: that setup.exe with --thoron-chrome-bin=<staged>,
+// without starting the browser, and --system-level for an install for every
+// user. A delta without that setup.exe is not one for installed copies
+// (kNotADelta). With anything but kDone, nothing is left at `staged`.
+DeltaResult PrepareInstalledDelta(const base::FilePath& delta,
+                                  const base::FilePath& program_folder,
+                                  const BuildVersion& from,
+                                  const BuildVersion& to,
+                                  bool system_level,
+                                  const base::FilePath& staged,
+                                  base::CommandLine* setup);
+
+}  // namespace thoron_update
+
+#endif  // COMPONENTS_THORON_UPDATE_DELTA_PACKAGE_H_
