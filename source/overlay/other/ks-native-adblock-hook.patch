+#include "components/thoron_update/test_zip.h"
+
+#include <stdint.h>
+
+#include "base/files/file_util.h"
+#include "third_party/zlib/google/zip_reader.h"
+
+namespace thoron_update {
+namespace {
+
+uint32_t Crc32(const std::string& data) {
+  uint32_t crc = 0xFFFFFFFFu;
+  for (const unsigned char c : data) {
+    crc ^= c;
+    for (int i = 0; i < 8; ++i) {
+      crc = (crc >> 1) ^ (0xEDB88320u & (0u - (crc & 1u)));
+    }
+  }
+  return ~crc;
+}
+
+void Put16(std::string& out, uint32_t value) {
+  out.push_back(static_cast<char>(value & 0xFF));
+  out.push_back(static_cast<char>((value >> 8) & 0xFF));
+}
+
+void Put32(std::string& out, uint32_t value) {
+  Put16(out, value & 0xFFFF);
+  Put16(out, value >> 16);
+}
+
+}  // namespace
+
+std::vector<TestZipEntry> ReadTestZip(const base::FilePath& path) {
+  std::vector<TestZipEntry> out;
+  zip::ZipReader reader;
+  if (!reader.Open(path)) {
+    return out;
+  }
+  while (const zip::ZipReader::Entry* entry = reader.Next()) {
+    if (entry->is_directory) {
+      continue;
+    }
+    std::string content;
+    if (!reader.ExtractCurrentEntryToString(64 * 1024 * 1024, &content)) {
+      return {};
+    }
+    out.push_back({entry->path.AsUTF8Unsafe(), content, false});
+  }
+  return out;
+}
+
+bool WriteTestZip(const base::FilePath& path, const std::vector<TestZipEntry>& entries) {
+  std::string out;
+  std::string central;
+  for (const TestZipEntry& entry : entries) {
+    const uint32_t offset = static_cast<uint32_t>(out.size());
+    const uint32_t crc = Crc32(entry.content);
+    const uint32_t size = static_cast<uint32_t>(entry.content.size());
+    const uint32_t name = static_cast<uint32_t>(entry.name.size());
+    // The local header: version 2.0, no flags, stored, 1980-01-01.
+    Put32(out, 0x04034b50);
+    Put16(out, 20);
+    Put16(out, 0);
+    Put16(out, 0);
+    Put16(out, 0);
+    Put16(out, 0x21);
+    Put32(out, crc);
+    Put32(out, size);
+    Put32(out, size);
+    Put16(out, name);
+    Put16(out, 0);
+    out += entry.name;
+    out += entry.content;
+    // The central directory: made on Unix, so the file mode in the upper half
+    // of the external attributes counts (a link: 0120777).
+    Put32(central, 0x02014b50);
+    Put16(central, (3 << 8) | 20);
+    Put16(central, 20);
+    Put16(central, 0);
+    Put16(central, 0);
+    Put16(central, 0);
+    Put16(central, 0x21);
+    Put32(central, crc);
+    Put32(central, size);
+    Put32(central, size);
+    Put16(central, name);
+    Put16(central, 0);
+    Put16(central, 0);
+    Put16(central, 0);
+    Put16(central, 0);
+    Put32(central, (entry.link ? 0120777u : 0100644u) << 16);
+    Put32(central, offset);
+    central += entry.name;
+  }
+  const uint32_t central_offset = static_cast<uint32_t>(out.size());
+  const uint32_t count = static_cast<uint32_t>(entries.size());
+  out += central;
+  Put32(out, 0x06054b50);
+  Put16(out, 0);
+  Put16(out, 0);
+  Put16(out, count);
+  Put16(out, count);
+  Put32(out, static_cast<uint32_t>(central.size()));
+  Put32(out, central_offset);
+  Put16(out, 0);
+  return base::WriteFile(path, out);
+}
+
+}  // namespace thoron_update
