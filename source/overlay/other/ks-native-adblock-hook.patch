@@ -0,0 +1,118 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/user_data_importer/chromium_family/password_decryptor_linux.h"
+
+#include <array>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "crypto/aes_cbc.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace user_data_importer::chromium_family {
+namespace {
+
+std::vector<uint8_t> Seal(const char* prefix,
+                          const std::array<uint8_t, 16>& key,
+                          const std::string& plaintext) {
+  std::array<uint8_t, 16> iv;
+  iv.fill(' ');
+  std::vector<uint8_t> sealed =
+      crypto::aes_cbc::Encrypt(key, iv, base::as_byte_span(plaintext));
+  std::vector<uint8_t> value(prefix, prefix + 3);
+  value.insert(value.end(), sealed.begin(), sealed.end());
+  return value;
+}
+
+// The fixed key Chromium uses on Linux
+// (components/os_crypt/async/browser/posix_key_provider.cc, kV10Key), made the
+// way it says: PBKDF2-HMAC-SHA1 of "peanuts" with "saltysalt", one iteration.
+TEST(ThoronPasswordDecryptorLinuxTest, TheFixedKeyIsChromiums) {
+  constexpr std::array<uint8_t, 16> kV10Key = {
+      0xfd, 0x62, 0x1f, 0xe5, 0xa2, 0xb4, 0x02, 0x53,
+      0x9d, 0xfa, 0x14, 0x7c, 0xa9, 0x27, 0x27, 0x78};
+  EXPECT_EQ(PasswordKey::DeriveKey("peanuts"), kV10Key);
+}
+
+TEST(ThoronPasswordDecryptorLinuxTest, AV10ValueIsRead) {
+  const PasswordKey key = PasswordKey::FromSecretForTesting(std::nullopt);
+  std::string plaintext;
+  EXPECT_EQ(DecryptPasswordValue(
+                key, Seal("v10", PasswordKey::DeriveKey("peanuts"), "hunter2"),
+                &plaintext),
+            DecryptResult::kOk);
+  EXPECT_EQ(plaintext, "hunter2");
+}
+
+TEST(ThoronPasswordDecryptorLinuxTest, AV11ValueNeedsTheKeyringsSecret) {
+  const std::vector<uint8_t> value =
+      Seal("v11", PasswordKey::DeriveKey("the keyring's secret"), "hunter2");
+  std::string plaintext;
+  EXPECT_EQ(DecryptPasswordValue(PasswordKey::FromSecretForTesting(std::nullopt),
+                                 value, &plaintext),
+            DecryptResult::kSkippedOther);
+  EXPECT_TRUE(plaintext.empty());
+  EXPECT_EQ(DecryptPasswordValue(
+                PasswordKey::FromSecretForTesting("the keyring's secret"), value,
+                &plaintext),
+            DecryptResult::kOk);
+  EXPECT_EQ(plaintext, "hunter2");
+}
+
+TEST(ThoronPasswordDecryptorLinuxTest, AWrongKeyOrAnOddValueIsNotRead) {
+  const PasswordKey key = PasswordKey::FromSecretForTesting("another secret");
+  std::string plaintext;
+  // Sealed with another secret: the padding comes out wrong (or, rarely, right
+  // with other bytes; a value that reads is never assumed to be the person's).
+  const std::vector<uint8_t> other =
+      Seal("v11", PasswordKey::DeriveKey("the keyring's secret"),
+           "a password long enough to fill blocks");
+  const DecryptResult result = DecryptPasswordValue(key, other, &plaintext);
+  EXPECT_TRUE(result == DecryptResult::kError ||
+              plaintext != "a password long enough to fill blocks");
+  plaintext.clear();
+  EXPECT_EQ(DecryptPasswordValue(key, std::vector<uint8_t>{'v', '1', '0', 1, 2},
+                                 &plaintext),
+            DecryptResult::kError);
+  EXPECT_EQ(DecryptPasswordValue(key, std::vector<uint8_t>{'v', '2', '0', 1},
+                                 &plaintext),
+            DecryptResult::kSkippedOther);
+  EXPECT_EQ(DecryptPasswordValue(key, std::vector<uint8_t>{'p', 'l'}, &plaintext),
+            DecryptResult::kSkippedOther);
+  EXPECT_TRUE(plaintext.empty());
+}
+
+TEST(ThoronPasswordDecryptorLinuxTest, EachBrowserItsKeyringName) {
+  using Names = std::vector<std::string>;
+  EXPECT_EQ(PasswordKey::ApplicationNamesFor(
+                base::FilePath("/home/a/.config/google-chrome")),
+            (Names{"chrome", "chromium"}));
+  EXPECT_EQ(PasswordKey::ApplicationNamesFor(
+                base::FilePath("/home/a/.config/chromium")),
+            (Names{"chromium", "chrome"}));
+  EXPECT_EQ(PasswordKey::ApplicationNamesFor(base::FilePath(
+                "/home/a/.config/BraveSoftware/Brave-Browser")),
+            (Names{"brave", "chromium", "chrome"}));
+  EXPECT_EQ(PasswordKey::ApplicationNamesFor(
+                base::FilePath("/home/a/.config/thorium")),
+            (Names{"chromium", "chrome"}));
+}
+
+TEST(ThoronPasswordDecryptorLinuxTest, KWalletKeepsTheSecretInChromiumsFolder) {
+  using Entries = std::vector<std::pair<std::string, std::string>>;
+  EXPECT_EQ(PasswordKey::KWalletEntriesFor(PasswordKey::ApplicationNamesFor(
+                base::FilePath("/home/a/.config/thorium"))),
+            (Entries{{"Chromium Keys", "Chromium Safe Storage"},
+                     {"Chrome Keys", "Chrome Safe Storage"}}));
+  EXPECT_EQ(PasswordKey::KWalletEntriesFor(PasswordKey::ApplicationNamesFor(
+                base::FilePath("/home/a/.config/google-chrome"))),
+            (Entries{{"Chrome Keys", "Chrome Safe Storage"},
+                     {"Chromium Keys", "Chromium Safe Storage"}}));
+  // Names Thoron has not seen a browser use in KWallet are not guessed.
+  EXPECT_EQ(PasswordKey::KWalletEntriesFor({"brave", "vivaldi"}), Entries{});
+}
+
+}  // namespace
+}  // namespace user_data_importer::chromium_family
diff --git a/components/user_data_importer/chromium_family/password_decryptor_win.cc b/components/user_data_importer/chromium_family/password_decryptor_win.cc
new file mode 100644
index 0000000000000000000000000000000000000000..f8ce7f05f49fc1e93ba27b9839d051fc4a9fac6d
--- /dev/null
+++ b/components/user_data_importer/chromium_family/password_decryptor_win.cc
@@ -0,0 +1,169 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/user_data_importer/chromium_family/password_decryptor_win.h"
+
+#include <windows.h>
+
+#include <wincrypt.h>
+
+#include <array>
+#include <string_view>
+#include <utility>
+
+#include "base/base64.h"
+#include "base/compiler_specific.h"
+#include "base/json/json_reader.h"
+#include "base/values.h"
+#include "base/win/scoped_localalloc.h"
+#include "crypto/aead.h"
+#include "crypto/secure_util.h"
+
+namespace user_data_importer::chromium_family {
+
+namespace {
+
+// Matches os_crypt_win.cc.
+constexpr uint8_t kDpapiKeyPrefix[] = {'D', 'P', 'A', 'P', 'I'};
+constexpr char kV10Prefix[] = "v10";
+constexpr char kV20Prefix[] = "v20";
+constexpr size_t kPrefixLength = 3;    // "v10" / "v20".
+constexpr size_t kNonceLength = 12;    // AES-256-GCM nonce.
+constexpr size_t kTagLength = 16;      // AES-256-GCM tag.
+constexpr size_t kKeyLength = 32;      // AES-256 key.
+
+// Unwraps a DPAPI blob for the current Windows user. Returns nullopt on
+// failure (for example a blob wrapped by a different user).
+std::optional<std::vector<uint8_t>> UnwrapForCurrentUser(
+    base::span<const uint8_t> wrapped) {
+  DATA_BLOB input = {};
+  input.pbData = const_cast<BYTE*>(wrapped.data());
+  input.cbData = static_cast<DWORD>(wrapped.size());
+
+  DATA_BLOB output = {};
+  if (!::CryptUnprotectData(&input, nullptr, nullptr, nullptr, nullptr, 0,
+                            &output)) {
+    return std::nullopt;
+  }
+  auto owned = base::win::TakeLocalAlloc(output.pbData);
+  std::vector<uint8_t> result(owned.get(),
+                              UNSAFE_TODO(owned.get() + output.cbData));
+  // Wipe the decrypted copy DPAPI left behind before its memory is freed.
+  ::SecureZeroMemory(owned.get(), output.cbData);
+  return result;
+}
+
+bool HasPrefix(base::span<const uint8_t> value, std::string_view prefix) {
+  if (value.size() < prefix.size()) {
+    return false;
+  }
+  return std::equal(prefix.begin(), prefix.end(), value.begin());
+}
+
+}  // namespace
+
+PasswordKey::PasswordKey() = default;
+PasswordKey::PasswordKey(PasswordKey&&) noexcept = default;
+PasswordKey& PasswordKey::operator=(PasswordKey&&) noexcept = default;
+
+PasswordKey::~PasswordKey() {
+  Clear();
+}
+
+void PasswordKey::Clear() {
+  if (!key_.empty()) {
+    crypto::SecureZeroBuffer(base::span(key_));
+    key_.clear();
+  }
+}
+
+// static
+std::optional<PasswordKey> PasswordKey::FromLocalState(
+    const std::string& local_state_json) {
+  std::optional<base::DictValue> state =
+      base::JSONReader::ReadDict(local_state_json, base::JSON_PARSE_RFC);
+  if (!state) {
+    return std::nullopt;
+  }
+  const std::string* encoded =
+      state->FindStringByDottedPath("os_crypt.encrypted_key");
+  if (!encoded) {
+    return std::nullopt;
+  }
+  std::optional<std::vector<uint8_t>> decoded = base::Base64Decode(*encoded);
+  if (!decoded || decoded->size() <= std::size(kDpapiKeyPrefix)) {
+    return std::nullopt;
+  }
+  if (!std::equal(std::begin(kDpapiKeyPrefix), std::end(kDpapiKeyPrefix),
+                  decoded->begin())) {
+    return std::nullopt;
+  }
+  base::span<const uint8_t> wrapped =
+      base::span(*decoded).subspan(std::size(kDpapiKeyPrefix));
+  std::optional<std::vector<uint8_t>> unwrapped = UnwrapForCurrentUser(wrapped);
+  crypto::SecureZeroBuffer(base::span(*decoded));
+  if (!unwrapped || unwrapped->size() != kKeyLength) {
+    if (unwrapped) {
+      crypto::SecureZeroBuffer(base::span(*unwrapped));
+    }
+    return std::nullopt;
+  }
+  PasswordKey key;
+  key.key_ = std::move(*unwrapped);
+  return key;
+}
+
+// static
+std::optional<PasswordKey> PasswordKey::FromRawKeyForTesting(
+    base::span<const uint8_t> raw_key) {
+  if (raw_key.size() != kKeyLength) {
+    return std::nullopt;
+  }
+  PasswordKey key;
+  key.key_.assign(raw_key.begin(), raw_key.end());
+  return key;
+}
+
+DecryptResult DecryptPasswordValue(const PasswordKey& key,
+                                   base::span<const uint8_t> value,
+                                   std::string* plaintext) {
+  // App-bound value: counted, never read.
+  if (HasPrefix(value, kV20Prefix)) {
+    return DecryptResult::kSkippedV20;
+  }
+
+  // Old value with no known prefix: unwrap for the current user directly.
+  if (!HasPrefix(value, kV10Prefix)) {
+    std::optional<std::vector<uint8_t>> unwrapped =
+        UnwrapForCurrentUser(value);
+    if (!unwrapped) {
+      return DecryptResult::kSkippedOther;
+    }
+    plaintext->assign(unwrapped->begin(), unwrapped->end());
+    crypto::SecureZeroBuffer(base::span(*unwrapped));
+    return DecryptResult::kOk;
+  }
+
+  // "v10": AES-256-GCM with the profile key.
+  if (!key.is_valid()) {
+    return DecryptResult::kError;
+  }
+  if (value.size() < kPrefixLength + kNonceLength + kTagLength) {
+    return DecryptResult::kSkippedOther;
+  }
+  base::span<const uint8_t> body = value.subspan(kPrefixLength);
+  base::span<const uint8_t> nonce = body.first(kNonceLength);
+  base::span<const uint8_t> ciphertext_and_tag = body.subspan(kNonceLength);
+
+  crypto::Aead aead(crypto::Aead::AES_256_GCM, key.bytes());
+  std::optional<std::vector<uint8_t>> decrypted =
+      aead.Open(ciphertext_and_tag, nonce, /*additional_data=*/{});
+  if (!decrypted) {
+    return DecryptResult::kError;
+  }
+  plaintext->assign(decrypted->begin(), decrypted->end());
+  crypto::SecureZeroBuffer(base::span(*decrypted));
+  return DecryptResult::kOk;
+}
+
+}  // namespace user_data_importer::chromium_family
