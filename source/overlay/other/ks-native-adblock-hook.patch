+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// thoron_update: the updater's command line (ROADMAP P3.11). See cli.h and
+// README.md for what it takes and the exit codes it gives.
+
+#include <stdio.h>
+
+#include <string>
+
+#include "base/at_exit.h"
+#include "base/command_line.h"
+#include "components/thoron_update/cli.h"
+
+int main(int argc, char** argv) {
+  base::AtExitManager at_exit;
+  base::CommandLine::Init(argc, argv);
+  std::string out;
+  const int code =
+      thoron_update::RunUpdateCommand(*base::CommandLine::ForCurrentProcess(), &out);
+  fputs(out.c_str(), stdout);
+  return code;
+}
