+// One name/value autofill pair. Kept here so the reader library needs nothing
+// from chrome/common/importer; the importer glue converts it to Chromium's
+// ImporterAutofillFormDataEntry.
+struct ImportedAutofillEntry {
+  std::u16string name;
+  std::u16string value;
+  int times_used = 0;
+  base::Time date_created;
+  base::Time date_last_used;
+};
+
+// One decrypted cookie, with every field needed to rebuild a
+// net::CanonicalCookie. Kept here so the reader library needs nothing from
+// //net; the importer glue builds the CanonicalCookie. The enum-like fields
+// carry the browser's on-disk integer values (the same the cookie database
+// stores), which the glue maps to net's enums.
+// The home page and what the browser opens at its start. Only web pages
+// (http, https, file); a value the profile does not set stays empty or -1.
+struct ImportedStartupSettings {
+  ImportedStartupSettings();
+  ImportedStartupSettings(const ImportedStartupSettings&);
+  ~ImportedStartupSettings();
+
+  GURL home_page;
+  bool home_page_is_new_tab_page = true;
+  // -1: not set in the profile, else 0 or 1.
+  int show_home_button = -1;
+  // session.restore_on_startup: 1 the last session, 4 the pages below, 5 the
+  // new tab page; -1 not set.
+  int restore_on_startup = -1;
+  std::vector<GURL> startup_pages;
+};
+
+struct ImportedCookie {
+  std::string name;
+  std::string value;
+  std::string domain;  // host_key, e.g. ".example.com"
+  std::string path;
+  base::Time creation;
+  base::Time expiration;
+  base::Time last_access;
+  base::Time last_update;
+  bool secure = false;
+  bool httponly = false;
+  int same_site = -1;      // DBCookieSameSite (-1 unspecified .. 2 strict)
+  int priority = 1;        // DBCookiePriority (0 low, 1 medium, 2 high)
+  int source_scheme = 0;   // CookieSourceScheme (0 unset, 1 non-secure, 2 sec.)
+  int source_port = -1;
+  int source_type = 0;     // DBCookieSourceType (0 unknown .. 3 other)
+  // Partitioned-cookie key, as the database stores it. Empty when the cookie is
+  // not partitioned.
+  std::string top_frame_site_key;
+  bool has_cross_site_ancestor = false;
+};
+
+// Receives what the reader extracts from a source profile. The importer in
+// chrome/utility/importer implements this over Chromium's ImporterBridge; unit
+// tests implement a recording fake. Each method is called at most once per
+// import, with the whole set.
+class ChromiumFamilyImportBridge {
+ public:
+  virtual ~ChromiumFamilyImportBridge() = default;
+
+  virtual void AddBookmarks(
+      const std::vector<ImportedBookmarkEntry>& bookmarks,
+      const std::u16string& top_level_folder_name) = 0;
+
+  virtual void SetHistory(const std::vector<ImporterURLRow>& rows) = 0;
+
+  virtual void SetKeywords(
+      const std::vector<SearchEngineInfo>& search_engines) = 0;
+
+  virtual void AddPasswordForm(const ImportedPasswordForm& form) = 0;
+
+  virtual void SetAutofillEntries(
+      const std::vector<ImportedAutofillEntry>& entries) = 0;
+
+  virtual void SetCookies(const std::vector<ImportedCookie>& cookies) = 0;
+
+  virtual void SetStartupSettings(const ImportedStartupSettings& settings) = 0;
+
+  // Thoron (ROADMAP P3.14): the source profile's Chrome Web Store extensions,
+  // by ID, to be installed again from the store.
+  virtual void SetWebStoreExtensions(const std::vector<std::string>& ids) {}
+
+  // Thoron (ROADMAP P3.22): the source profile's last session file, for its
+  // open windows, tabs and tab groups.
+  virtual void SetOpenTabsSession(const std::vector<uint8_t>& session_file) {}
+};
+
