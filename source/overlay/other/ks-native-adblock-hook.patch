+// What a copy says about itself is checked before the files are looked at.
+TEST(ThoronUpdateManifestTest, WhatACopyGetsWrongIsNoOutcomeOfTheFiles) {
+  const std::string signature = FromHex(kExampleSignature);
+  CopyInfo copy = ExampleCopy();
+  copy.channel = "Stable";
+  EXPECT_EQ(CheckUpdate(kExample, signature, copy, kNow).outcome,
+            Outcome::kInvalidCopy);
+  EXPECT_EQ(CheckUpdate("update\n", "", copy, kNow).outcome,
+            Outcome::kInvalidCopy);
+
+  copy = ExampleCopy();
+  copy.last_serial = -1;
+  EXPECT_EQ(CheckUpdate(kExample, signature, copy, kNow).outcome,
+            Outcome::kInvalidCopy);
+
+  copy = ExampleCopy();
+  copy.allowed_hosts.clear();
+  EXPECT_EQ(CheckUpdate(kExample, signature, copy, kNow).outcome,
+            Outcome::kInvalidCopy);
+  copy.allowed_hosts = {"github.com", "GitHub.com"};
+  const Decision decision = CheckUpdate(kExample, signature, copy, kNow);
+  EXPECT_EQ(decision.outcome, Outcome::kInvalidCopy);
+  EXPECT_FALSE(CannotVerify(decision.outcome));
+  ExpectNothingHandedOut(decision);
+}
