+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_portable_key/argon2id.h"
+
+#include <stdint.h>
+
+#include <algorithm>
+#include <array>
+#include <vector>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace thoron_portable_key {
+namespace {
+
+bool AllZero(base::span<const uint8_t> bytes) {
+  return std::ranges::all_of(bytes, [](uint8_t b) { return b == 0; });
+}
+
+// RFC 9106, section 5.3 (also kats/argon2id of the reference release):
+// Argon2id, version 0x13, 32 KiB, 3 passes, 4 lanes, a 32-byte tag.
+TEST(ThoronArgon2idTest, Rfc9106TestVector) {
+  std::vector<uint8_t> password(32, 0x01);
+  const std::vector<uint8_t> salt(16, 0x02);
+  const std::vector<uint8_t> secret(8, 0x03);
+  const std::vector<uint8_t> associated_data(12, 0x04);
+  constexpr std::array<uint8_t, 32> kTag = {
+      0x0d, 0x64, 0x0d, 0xf5, 0x8d, 0x78, 0x76, 0x6c, 0x08, 0xc0, 0x37,
+      0xa3, 0x4a, 0x8b, 0x53, 0xc9, 0xd0, 0x1e, 0xf0, 0x45, 0x2d, 0x75,
+      0xb6, 0x5e, 0xb5, 0x25, 0x20, 0xe9, 0x6b, 0x01, 0xe6, 0x59};
+  std::array<uint8_t, 32> tag = {};
+  ASSERT_TRUE(Argon2idForTesting(password, salt, secret, associated_data,
+                                 Argon2Params{32, 3, 4}, tag));
+  EXPECT_EQ(tag, kTag);
+  // the password was wiped once it was hashed (threat model E9)
+  EXPECT_TRUE(AllZero(password));
+}
+
+// A derivation at the floor wipes the passphrase and gives the same key for
+// the same passphrase and salt; another salt gives another key.
+TEST(ThoronArgon2idTest, FloorDerivationWipesAndRepeats) {
+  const std::vector<uint8_t> salt(16, 0x5a);
+  std::vector<uint8_t> first_password = {'c', 'o', 'r', 'r', 'e', 'c', 't',
+                                         ' ', 'h', 'o', 'r', 's', 'e'};
+  std::vector<uint8_t> second_password = first_password;
+  std::array<uint8_t, 32> first = {};
+  std::array<uint8_t, 32> second = {};
+  ASSERT_TRUE(Argon2id(first_password, salt, kFloor, first));
+  EXPECT_TRUE(AllZero(first_password));
+  ASSERT_TRUE(Argon2id(second_password, salt, kFloor, second));
+  EXPECT_EQ(first, second);
+  EXPECT_FALSE(AllZero(first));
+}
+
+// A cost below the floor or above the ceiling is refused, and the passphrase
+// is wiped all the same (threat model E1).
+TEST(ThoronArgon2idTest, RefusesCostsOutsideTheLimits) {
+  const std::vector<uint8_t> salt(16, 0x02);
+  for (const Argon2Params& params :
+       {Argon2Params{kFloor.memory_kib - 1, 3, 4},
+        Argon2Params{kFloor.memory_kib, 2, 4}, Argon2Params{65536, 3, 0},
+        Argon2Params{kCeiling.memory_kib + 1, 3, 4},
+        Argon2Params{65536, kCeiling.passes + 1, 4},
+        Argon2Params{65536, 3, kCeiling.lanes + 1}}) {
+    std::vector<uint8_t> password(20, 0x41);
+    std::array<uint8_t, 32> out;
+    out.fill(0xff);
+    EXPECT_FALSE(AreAcceptable(params));
+    EXPECT_FALSE(Argon2id(password, salt, params, out));
+    EXPECT_TRUE(AllZero(password));
+    EXPECT_TRUE(AllZero(out));
+  }
+  EXPECT_TRUE(AreAcceptable(kFloor));
+  EXPECT_TRUE(AreAcceptable(kCeiling));
+  // RFC 9106's second recommended setting is the floor
+  EXPECT_EQ(kFloor, (Argon2Params{65536, 3, 4}));
+}
+
+// Setup asks for more memory on a faster PC, never less than the floor and
+// never more than 256 MiB.
+TEST(ThoronArgon2idTest, Calibrate) {
+  EXPECT_EQ(Calibrate(base::TimeDelta()), kFloor);
+  EXPECT_EQ(Calibrate(base::Seconds(2)), kFloor);
+  EXPECT_EQ(Calibrate(base::Milliseconds(750)), kFloor);
+  EXPECT_EQ(Calibrate(base::Milliseconds(375)), (Argon2Params{131072, 3, 4}));
+  EXPECT_EQ(Calibrate(base::Milliseconds(250)), (Argon2Params{196608, 3, 4}));
+  EXPECT_EQ(Calibrate(base::Milliseconds(10)), (Argon2Params{262144, 3, 4}));
+  for (int ms = 1; ms < 3000; ms += 7) {
+    const Argon2Params params = Calibrate(base::Milliseconds(ms));
+    EXPECT_TRUE(AreAcceptable(params)) << ms;
+    EXPECT_LE(params.memory_kib, kMostCalibratedMemoryKib) << ms;
+  }
+}
+
+}  // namespace
+}  // namespace thoron_portable_key
