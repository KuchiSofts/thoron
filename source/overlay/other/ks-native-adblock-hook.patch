+constexpr char kOld[] = "158.0.8127.3000";
+constexpr char kNew[] = "158.0.8127.3010";
+
+std::string Hex(const std::string& data) {
+  return base::HexEncodeLower(crypto::hash::Sha256(data));
+}
+
+std::string Patch(const std::string& from, const std::string& to) {
+  const zucchini::ConstBufferView a(reinterpret_cast<const uint8_t*>(from.data()), from.size());
+  const zucchini::ConstBufferView b(reinterpret_cast<const uint8_t*>(to.data()), to.size());
+  zucchini::EnsemblePatchWriter writer(a, b);
+  EXPECT_EQ(zucchini::GenerateBuffer(a, b, zucchini::GenerateOptions(), &writer),
+            zucchini::status::kStatusSuccess);
+  std::string out(writer.SerializedSize(), '\0');
+  EXPECT_TRUE(writer.SerializeInto(
+      zucchini::MutableBufferView(reinterpret_cast<uint8_t*>(out.data()), out.size())));
+  return out;
+}
+
+class ThoronUpdateDeltaTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(dir_.CreateUniqueTempDir());
+    old_folder_ = dir_.GetPath().AppendASCII("Application").AppendASCII(kOld);
+    // The older version's folder: a file that stays, one that changes, one that goes.
+    Put(old_folder_, "thoron.exe", launcher_);
+    Put(old_folder_, std::string(kOld) + "/chrome.dll", old_dll_);
+    Put(old_folder_, std::string(kOld) + "/gone.dat", "gone");
+  }
+
+  void Put(const base::FilePath& root, const std::string& relative, const std::string& data) {
+    const base::FilePath path = root.Append(base::FilePath::FromUTF8Unsafe(relative));
+    ASSERT_TRUE(base::CreateDirectory(path.DirName()));
+    ASSERT_TRUE(base::WriteFile(path, data));
+  }
+
+  // A delta as tools/release/delta.py makes it, changed by `change` first.
+  base::FilePath Delta(base::RepeatingCallback<void(base::DictValue&)> change = {},
+                       const std::string& patch_bytes = "") {
+    base::ListValue files;
+    auto add = [&](const std::string& path, const std::string& data, const std::string& how,
+                   const std::string& from_path, const std::string& from_data) {
+      base::DictValue entry;
+      entry.Set("path", path);
+      entry.Set("size", static_cast<double>(data.size()));
+      entry.Set("sha256", Hex(data));
+      entry.Set("how", how);
+      if (how != "whole") {
+        entry.Set("from_path", from_path);
+        entry.Set("from_sha256", Hex(from_data));
+      }
+      files.Append(std::move(entry));
+    };
+    add("thoron.exe", launcher_, "same", "thoron.exe", launcher_);
+    add(std::string(kNew) + "/chrome.dll", new_dll_, "patch", std::string(kOld) + "/chrome.dll",
+        old_dll_);
+    add(std::string(kNew) + "/new.dat", "new", "whole", "", "");
+    base::DictValue list;
+    list.Set("format", 1);
+    list.Set("from", kOld);
+    list.Set("to", kNew);
+    list.Set("files", std::move(files));
+    if (change) {
+      change.Run(list);
+    }
+    const base::FilePath tree = dir_.GetPath().AppendASCII("tree" + base::NumberToString(++made_));
+    std::string json;
+    EXPECT_TRUE(base::JSONWriter::Write(list, &json));
+    Put(tree, "delta.json", json);
+    Put(tree, "patch/1", patch_bytes.empty() ? Patch(old_dll_, new_dll_) : patch_bytes);
+    Put(tree, "whole/2", "new");
+    const base::FilePath zip = dir_.GetPath().AppendASCII("d" + base::NumberToString(made_) + ".delta");
+    EXPECT_TRUE(zip::Zip(tree, zip, true));
+    return zip;
+  }
+
+  DeltaResult Apply(const base::FilePath& delta, std::vector<VersionFile>* files) {
+    return ApplyDelta(delta, old_folder_, *ParseBuildVersion(kOld), *ParseBuildVersion(kNew), Staged(),
+                      files);
+  }
+
+  base::FilePath Staged() { return dir_.GetPath().AppendASCII("Application").AppendASCII("s.staging"); }
+
+  base::ScopedTempDir dir_;
+  base::FilePath old_folder_;
+  int made_ = 0;
+  const std::string launcher_ = "the launcher, unchanged";
+  const std::string old_dll_ = std::string(3000, 'a') + "an engine of the older version" + std::string(500, 'b');
+  const std::string new_dll_ = std::string(3000, 'a') + "an engine of the NEWER version!" + std::string(520, 'b');
+};
+
+TEST_F(ThoronUpdateDeltaTest, TheNewerFolderIsMadeAndListed) {
+  std::vector<VersionFile> files;
+  ASSERT_EQ(Apply(Delta(), &files), DeltaResult::kDone);
+  ASSERT_EQ(files.size(), 3u);
+  std::string read;
+  ASSERT_TRUE(base::ReadFileToString(Staged().AppendASCII(kNew).AppendASCII("chrome.dll"), &read));
+  EXPECT_EQ(read, new_dll_);
+  ASSERT_TRUE(base::ReadFileToString(Staged().AppendASCII("thoron.exe"), &read));
+  EXPECT_EQ(read, launcher_);
+  ASSERT_TRUE(base::ReadFileToString(Staged().AppendASCII(kNew).AppendASCII("new.dat"), &read));
+  EXPECT_EQ(read, "new");
+  // the file the newer version does not have is not made
+  EXPECT_FALSE(base::PathExists(Staged().AppendASCII(kNew).AppendASCII("gone.dat")));
+  EXPECT_EQ(files[1].sha256, Hex(new_dll_));
+}
+
+// An installed copy (P4.1): the delta also makes the newer setup.exe, from the
+// one the installed copy keeps in its version folder, and that setup is the
+// command that installs the staged folder.
+TEST_F(ThoronUpdateDeltaTest, AnInstalledCopysDeltaGivesTheNewerSetupToInstallIt) {
+  const std::string setup = "the older setup, the same in the newer version";
+  Put(old_folder_, std::string(kOld) + "/Installer/setup.exe", setup);
+  const auto with_setup = base::BindRepeating(
+      [](const std::string& data, base::DictValue& d) {
+        base::DictValue entry;
+        entry.Set("path", std::string(kNew) + "/Installer/setup.exe");
+        entry.Set("size", static_cast<double>(data.size()));
+        entry.Set("sha256", Hex(data));
+        entry.Set("how", "same");
+        entry.Set("from_path", std::string(kOld) + "/Installer/setup.exe");
+        entry.Set("from_sha256", Hex(data));
+        d.FindList("files")->Append(std::move(entry));
+      },
+      setup);
+  for (const bool system_level : {false, true}) {
+    base::DeletePathRecursively(Staged());
+    base::CommandLine command(base::CommandLine::NO_PROGRAM);
+    ASSERT_EQ(PrepareInstalledDelta(Delta(with_setup), old_folder_, *ParseBuildVersion(kOld),
+                                    *ParseBuildVersion(kNew), system_level, Staged(), &command),
+              DeltaResult::kDone);
+    EXPECT_EQ(command.GetProgram(),
+              Staged().AppendASCII(kNew).AppendASCII("Installer").AppendASCII("setup.exe"));
+    EXPECT_EQ(command.GetSwitchValuePath("thoron-chrome-bin"), Staged());
+    EXPECT_TRUE(command.HasSwitch("do-not-launch-chrome"));
+    EXPECT_EQ(command.HasSwitch("system-level"), system_level);
+    std::string read;
+    ASSERT_TRUE(base::ReadFileToString(command.GetProgram(), &read));
+    EXPECT_EQ(read, setup);
+    ASSERT_TRUE(base::ReadFileToString(Staged().AppendASCII(kNew).AppendASCII("chrome.dll"), &read));
+    EXPECT_EQ(read, new_dll_);
+  }
+}
+
+TEST_F(ThoronUpdateDeltaTest, ADeltaWithoutASetupIsNotOneForInstalledCopies) {
+  base::CommandLine command(base::CommandLine::NO_PROGRAM);
+  EXPECT_EQ(PrepareInstalledDelta(Delta(), old_folder_, *ParseBuildVersion(kOld),
+                                  *ParseBuildVersion(kNew), false, Staged(), &command),
+            DeltaResult::kNotADelta);
+  EXPECT_FALSE(base::PathExists(Staged()));
+  EXPECT_TRUE(command.GetProgram().empty());
+}
+
+TEST_F(ThoronUpdateDeltaTest, ADeltaForOtherVersionsIsRefused) {
+  std::vector<VersionFile> files;
+  EXPECT_EQ(Apply(Delta(base::BindRepeating([](base::DictValue& d) { d.Set("from", "158.0.8127.2000"); })),
+                  &files),
+            DeltaResult::kWrongVersion);
+  EXPECT_FALSE(base::PathExists(Staged()));
+}
+
+TEST_F(ThoronUpdateDeltaTest, AnOlderFileThatIsNotTheOneNamedIsNeverUsed) {
+  Put(old_folder_, std::string(kOld) + "/chrome.dll", old_dll_ + "x");
+  std::vector<VersionFile> files;
+  EXPECT_EQ(Apply(Delta(), &files), DeltaResult::kOldFileDiffers);
+  EXPECT_FALSE(base::PathExists(Staged()));
+  EXPECT_TRUE(files.empty());
+}
+
+TEST_F(ThoronUpdateDeltaTest, APatchThatDoesNotApplyOrGivesAnotherFileIsRefused) {
+  std::vector<VersionFile> files;
+  EXPECT_EQ(Apply(Delta({}, "not a patch at all"), &files), DeltaResult::kPatchFails);
+  EXPECT_FALSE(base::PathExists(Staged()));
+  // a valid patch to another file: made, then found not to be the newer one
+  const std::string other = new_dll_ + "?";
+  EXPECT_EQ(Apply(Delta({}, Patch(old_dll_, other)), &files), DeltaResult::kPatchFails);
+  EXPECT_FALSE(base::PathExists(Staged()));
+}
+
+TEST_F(ThoronUpdateDeltaTest, APathThatLeavesTheFolderIsRefused) {
+  std::vector<VersionFile> files;
+  for (const char* path : {"../outside.exe", "a/../../b", "C:/x", "a\\b", ""}) {
+    SCOPED_TRACE(path);
+    const std::string bad = path;
+    EXPECT_EQ(Apply(Delta(base::BindRepeating(
+                        [](const std::string& bad, base::DictValue& d) {
+                          (*d.FindList("files"))[2].GetDict().Set("path", bad);
+                        },
+                        bad)),
+                    &files),
+              DeltaResult::kNotADelta);
+    EXPECT_FALSE(base::PathExists(Staged()));
+  }
+}
+
+TEST_F(ThoronUpdateDeltaTest, AnEntryThatClimbsOutOfTheFolderIsRefused) {
+  const std::vector<TestZipEntry> good = ReadTestZip(Delta());
+  ASSERT_FALSE(good.empty());
+  std::vector<VersionFile> files;
+  // The test zips are written by WriteTestZip; one it writes is a good delta.
+  const base::FilePath rewritten = dir_.GetPath().AppendASCII("rewritten.delta");
+  ASSERT_TRUE(WriteTestZip(rewritten, good));
+  ASSERT_EQ(Apply(rewritten, &files), DeltaResult::kDone);
+  ASSERT_TRUE(base::DeletePathRecursively(Staged()));
+  for (const char* bad : {"../outside.txt", "a/../../outside.txt", "./delta.json"}) {
+    SCOPED_TRACE(bad);
+    std::vector<TestZipEntry> crafted = good;
+    crafted.insert(crafted.begin(), {bad, "not from the delta"});
+    const base::FilePath zip = dir_.GetPath().AppendASCII("crafted.delta");
+    ASSERT_TRUE(WriteTestZip(zip, crafted));
+    EXPECT_EQ(Apply(zip, &files), DeltaResult::kNotADelta);
+    EXPECT_FALSE(base::PathExists(Staged()));
+    EXPECT_FALSE(base::PathExists(dir_.GetPath().AppendASCII("outside.txt")));
+    EXPECT_FALSE(base::PathExists(dir_.GetPath().AppendASCII("Application").AppendASCII("outside.txt")));
+  }
+}
+
+TEST_F(ThoronUpdateDeltaTest, ADamagedFileListNeverCrashesOrWritesOutsideTheFolder) {
+  // THREAT_MODEL U9: a fixed mutation run over delta.json (not a coverage-guided fuzzer, which needs a
+  // libFuzzer build): flipped bytes, cut and doubled pieces, inserted characters, a cut end. Each damaged
+  // delta ends in a result; one refused leaves no staging folder, and nothing outside it is ever touched.
+  std::vector<TestZipEntry> good = ReadTestZip(Delta());
+  auto list = std::find_if(good.begin(), good.end(), [](const TestZipEntry& e) { return e.name == "delta.json"; });
+  ASSERT_NE(list, good.end());
+  const std::string json = list->content;
+  const base::FilePath zip = dir_.GetPath().AppendASCII("damaged.delta");
+  auto files_outside = [&] {
+    std::set<std::string> out;
+    base::FileEnumerator all(dir_.GetPath(), true, base::FileEnumerator::FILES);
+    for (base::FilePath path = all.Next(); !path.empty(); path = all.Next()) {
+      if (path != zip && !Staged().IsParent(path)) {
+        out.insert(path.AsUTF8Unsafe());
+      }
+    }
+    return out;
+  };
+  const std::set<std::string> before = files_outside();
+  std::mt19937 random(20261117);
+  const char kInserts[] = "{}[]\",:./\\0-9eE\x01 nullfalsetrue\xff";
+  int done = 0;
+  for (int round = 0; round < 1000; ++round) {
+    std::string damaged = json;
+    const int changes = 1 + static_cast<int>(random() % 4);
+    for (int c = 0; c < changes && !damaged.empty(); ++c) {
+      const size_t at = random() % damaged.size();
+      switch (random() % 5) {
+        case 0:
+          damaged[at] = static_cast<char>(damaged[at] ^ (1 << (random() % 8)));
+          break;
+        case 1:
+          damaged.erase(at, 1 + random() % 16);
+          break;
+        case 2:
+          damaged.insert(at, damaged.substr(at, 1 + random() % 24));
+          break;
+        case 3:
+          damaged.insert(at, 1, kInserts[random() % (sizeof(kInserts) - 1)]);
+          break;
+        default:
+          damaged.resize(at);
+          break;
+      }
+    }
+    std::vector<TestZipEntry> entries = good;
+    for (TestZipEntry& e : entries) {
+      if (e.name == "delta.json") {
+        e.content = damaged;
+      }
+    }
+    ASSERT_TRUE(WriteTestZip(zip, entries));
+    std::vector<VersionFile> files;
+    const DeltaResult result = Apply(zip, &files);
+    if (result == DeltaResult::kDone) {
+      ++done;                                // a change JSON does not mind, such as a space
+      ASSERT_TRUE(base::DeletePathRecursively(Staged()));
+    } else {
+      EXPECT_FALSE(base::PathExists(Staged())) << "round " << round;
+    }
+    ASSERT_EQ(files_outside(), before) << "round " << round;
+  }
+  // nearly every damaged list is refused
+  EXPECT_LT(done, 100);
+}
+
+// The entry point of the fuzzer (delta_list_fuzzer.cc) takes and refuses lists
+// as ApplyDelta() does.
+TEST_F(ThoronUpdateDeltaTest, TheListOnItsOwnIsReadAsTheDeltaReadsIt) {
+  const BuildVersion from = *ParseBuildVersion(kOld);
+  const BuildVersion to = *ParseBuildVersion(kNew);
+  const base::FilePath folder = dir_.GetPath().AppendASCII(kNew);
+  const std::string sha(64, 'a');
+  const std::string good = std::string(R"({"format": 1, "from": ")") + kOld + R"(", "to": ")" + kNew +
+                           R"(", "files": [{"path": "a/b.dll", "size": 3, "sha256": ")" + sha +
+                           R"(", "how": "same", "from_path": "a/b.dll", "from_sha256": ")" + sha +
+                           R"("}, {"path": "c.exe", "size": 1, "sha256": ")" + sha +
+                           R"(", "how": "whole"}]})";
+  size_t count = 9;
+  EXPECT_EQ(CheckDeltaList(good, from, to, folder, &count), DeltaResult::kDone);
+  EXPECT_EQ(count, 2u);
+
+  auto with = [&](const std::string& find, const std::string& put) {
+    std::string text = good;
+    text.replace(text.find(find), find.size(), put);
+    return text;
+  };
+  EXPECT_EQ(CheckDeltaList(with(R"("path": "c.exe")", R"("path": "../c.exe")"), from, to, folder,
+                           &count),
+            DeltaResult::kNotADelta);
+  EXPECT_EQ(count, 0u);
+  EXPECT_EQ(CheckDeltaList(with(R"("from_path": "a/b.dll")", R"("from_path": "C:/b.dll")"), from, to,
+                           folder, &count),
+            DeltaResult::kNotADelta);
+  EXPECT_EQ(CheckDeltaList(good, to, to, folder, &count), DeltaResult::kWrongVersion);
+  EXPECT_EQ(CheckDeltaList("not json", from, to, folder, &count), DeltaResult::kNotADelta);
+  EXPECT_EQ(CheckDeltaList(with(R"("how": "whole")", R"("how": "copy")"), from, to, folder, &count),
+            DeltaResult::kNotADelta);
+}
+
+TEST_F(ThoronUpdateDeltaTest, NotADeltaAtAll) {
+  ASSERT_TRUE(base::WriteFile(dir_.GetPath().AppendASCII("x.delta"), "not a zip"));
+  std::vector<VersionFile> files;
+  EXPECT_EQ(Apply(dir_.GetPath().AppendASCII("x.delta"), &files), DeltaResult::kNotADelta);
+  EXPECT_EQ(Apply(Delta(base::BindRepeating([](base::DictValue& d) { d.Set("format", 2); })), &files),
+            DeltaResult::kNotADelta);
+}
+
+}  // namespace
+}  // namespace thoron_update
diff --git a/components/thoron_update/key_rotation_unittest.cc b/components/thoron_update/key_rotation_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..8667f8436917d6b3795d0abc91e9f3b3f4b71fd3
--- /dev/null
+++ b/components/thoron_update/key_rotation_unittest.cc
@@ -0,0 +1,104 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <string>
+#include <vector>
+
+#include "base/strings/string_number_conversions.h"
+#include "components/thoron_update/manifest.h"
+#include "components/thoron_update/manifest_test_vectors.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+// Key rotation (ROADMAP P4.7), checked against what the reference tool makes.
+// The two keys are the test keys of make_test_vectors.py (no release key):
+// "test" signs the statement that introduces "other", and the example manifest
+// is signed with "other". Made with tools/update/manifest.py:
+//   sign_key_statement(sha256(TEST_KEY_PHRASE), public_key_of(sha256(OTHER_KEY_PHRASE)))
+//   sign(example(), sha256(OTHER_KEY_PHRASE), ..., now=2026-12-01T13:00:00Z)
+
+namespace thoron_update {
+namespace {
+
+constexpr std::string_view kOtherPublicKey =
+    "049f897b6739697fe841cd71a9bc0d6fec6c58688901c4b5d22c1cb0ee9eb163";
+constexpr std::string_view kStatement =
+    "049f897b6739697fe841cd71a9bc0d6fec6c58688901c4b5d22c1cb0ee9eb163"
+    "38eb27fcf6e0371837cf45cc53beec185fee43fad43beb76270a44eda9050a67"
+    "73154f8af0ba0e8659301732bbe9e394c670b5489101d1eab98356c0e1eca105";
+constexpr std::string_view kExampleSignedByOther =
+    "cb2994c32a10e227c84b5a6450ac326a7cbe0762b4498605d029874f369765a5"
+    "3e6b1dcd19e738f262a60bed8d033baab7da1d8ac8721d53fa6760717af36308";
+
+std::string Bytes(std::string_view hex) {
+  std::string out;
+  EXPECT_TRUE(base::HexStringToString(hex, &out));
+  return out;
+}
+
+PublicKey Key(std::string_view hex) {
+  PublicKey key = {};
+  const std::string bytes = Bytes(hex);
+  EXPECT_EQ(bytes.size(), key.size());
+  std::copy(bytes.begin(), bytes.end(), key.begin());
+  return key;
+}
+
+CopyInfo Copy() {
+  CopyInfo copy;
+  copy.allowed_hosts = {"github.com"};
+  copy.channel = "stable";
+  copy.installed = *ParseBuildVersion(test_vectors::kOldVersion);
+  copy.updater = copy.installed;
+  copy.variant = Variant::kWinX64Avx2;
+  copy.kind = Kind::kInstalled;
+  return copy;
+}
+
+TEST(ThoronUpdateKeyRotationTest, TheReferencesStatementIntroducesTheNewKey) {
+  const std::optional<PublicKey> key =
+      KeyFromStatement(Bytes(kStatement), {Key(test_vectors::kTestPublicKey)});
+  ASSERT_TRUE(key);
+  EXPECT_EQ(*key, Key(kOtherPublicKey));
+}
+
+TEST(ThoronUpdateKeyRotationTest, AStatementNoTrustedKeySignedIsIgnored) {
+  EXPECT_FALSE(KeyFromStatement(Bytes(kStatement), {Key(kOtherPublicKey)}));
+  std::string changed = Bytes(kStatement);
+  for (size_t at : {0u, 31u, 32u, 95u}) {
+    std::string bad = changed;
+    bad[at] = static_cast<char>(bad[at] ^ 1);
+    EXPECT_FALSE(KeyFromStatement(bad, {Key(test_vectors::kTestPublicKey)})) << at;
+  }
+  EXPECT_FALSE(KeyFromStatement(changed.substr(0, 95), {Key(test_vectors::kTestPublicKey)}));
+  // no key is never introduced, whoever would sign it
+  EXPECT_FALSE(KeyFromStatement(std::string(96, '\0'), {Key(test_vectors::kTestPublicKey)}));
+}
+
+TEST(ThoronUpdateKeyRotationTest, TheDrill) {
+  const std::string signature = Bytes(kExampleSignedByOther);
+  const PublicKey built_in = Key(test_vectors::kTestPublicKey);
+  // without the statement the release signed with the new key cannot be verified
+  EXPECT_EQ(CheckUpdateWithKeys(test_vectors::kExample, signature, Copy(), {built_in},
+                                test_vectors::kNow)
+                .outcome,
+            Outcome::kBadSignature);
+  // with it, the copy trusts the new key and the release is an update
+  const std::vector<PublicKey> keys = TrustedKeys(built_in, {Bytes(kStatement)});
+  ASSERT_EQ(keys.size(), 2u);
+  EXPECT_EQ(keys[1], Key(kOtherPublicKey));
+  EXPECT_EQ(CheckUpdateWithKeys(test_vectors::kExample, signature, Copy(), keys, test_vectors::kNow)
+                .outcome,
+            Outcome::kUpdate);
+  // a release still signed with the old key verifies as before
+  EXPECT_EQ(CheckUpdateWithKeys(test_vectors::kExample, Bytes(test_vectors::kExampleSignature),
+                                Copy(), keys, test_vectors::kNow)
+                .outcome,
+            Outcome::kUpdate);
+  // a statement that only the new key could have signed does not make itself trusted
+  EXPECT_EQ(TrustedKeys(Key(kOtherPublicKey), {Bytes(kStatement)}).size(), 1u);
+  // a statement given twice is one key
+  EXPECT_EQ(TrustedKeys(built_in, {Bytes(kStatement), Bytes(kStatement)}).size(), 2u);
+}
+
+}  // namespace
+}  // namespace thoron_update
diff --git a/components/thoron_update/launcher/BUILD.gn b/components/thoron_update/launcher/BUILD.gn
new file mode 100644
index 0000000000000000000000000000000000000000..3fffaffeb1eaab12dc19948108a23131366fa787
--- /dev/null
+++ b/components/thoron_update/launcher/BUILD.gn
@@ -0,0 +1,34 @@
+# Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+import("//build/config/compiler/compiler.gni")
+import("//build/config/sanitizers/sanitizers.gni")
+
+# The portable package's launcher, Thoron.exe (ROADMAP P3.12, P4.4). It must
+# start on every x64 processor, so it is built without the build's processor
+# flags and links nothing compiled with them: no base, no C++ library.
+executable("thoron_launcher") {
+  sources = [ "thoron_launcher_win.cc" ]
+
+  # The system headers are precompiled as modules with the processor flags;
+  # this file is compiled without them, so it reads the headers as they are.
+  use_libcxx_modules = false
+  configs -= [
+    "//build/config/compiler:thorium_x86_isa",
+    "//build/config/win:console",
+  ]
+  configs += [ "//build/config/win:windowed" ]
+  libs = [
+    "kernel32.lib",
+    "user32.lib",
+  ]
+  assert_no_deps = [ "//base" ]
+  if (!is_asan && !use_clang_profiling) {
+    no_default_deps = true
+
+    # A sanitizer or profiling build brings the C++ library in with its
+    # default dependencies (the fuzzers of ../BUILD.gn); every other build
+    # links none.
+    assert_no_deps += [ "//buildtools/third_party/libc++" ]
+  }
+}
diff --git a/components/thoron_update/launcher/thoron_launcher_win.cc b/components/thoron_update/launcher/thoron_launcher_win.cc
new file mode 100644
index 0000000000000000000000000000000000000000..1b3b7107ba9827c584d73104ea6f6be381b130f4
--- /dev/null
+++ b/components/thoron_update/launcher/thoron_launcher_win.cc
@@ -0,0 +1,329 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The launcher of Thoron's portable package (ROADMAP P3.12, P4.4): Thoron.exe
+// in the package's folder. It starts the version Application\current names,
+// with the profile in the package's own "User Data" folder, and passes on its
+// command line.
+//
+// It is built for every x64 processor and uses nothing of the browser's code:
+// no base, no C++ library, only Windows. So on a computer whose processor
+// cannot run the browser's build (an AVX2 copy moved to an older PC) it says
+// so, where the browser itself would stop before any of its code ran.
+//
+// Exit status: 0 the browser was started; 2 no browser was found in the
+// package; 3 this processor cannot run the package's build; 4 starting it
+// failed.
+
+#include <windows.h>
+
+#include <intrin.h>
+
+namespace {
+
+constexpr int kStarted = 0;
+constexpr int kNoBrowser = 2;
+constexpr int kWrongProcessor = 3;
+constexpr int kStartFailed = 4;
+
+// Long paths are fine; command lines are limited by Windows to 32767.
+constexpr DWORD kPath = 32768;
+
+// The processor's features the builds are made for (package.h, RunsOn).
+__attribute__((target("xsave"))) bool HasAvx2() {
+  int r[4];
+  __cpuid(r, 0);
+  if (r[0] < 7) {
+    return false;
+  }
+  __cpuid(r, 1);
+  const bool sse41 = r[2] & (1 << 19);
+  const bool sse42 = r[2] & (1 << 20);
+  const bool fma = r[2] & (1 << 12);
+  const bool osxsave = r[2] & (1 << 27);
+  const bool avx = r[2] & (1 << 28);
+  // the system must save the registers AVX uses
+  if (!sse41 || !sse42 || !fma || !osxsave || !avx || (_xgetbv(0) & 6) != 6) {
+    return false;
+  }
+  __cpuidex(r, 7, 0);
+  return r[1] & (1 << 5);
+}
+
+// The avx512_skx profile (build/config/compiler_opt.gni): AVX2 and AVX-512 F,
+// CD, VL, BW and DQ, with the system saving the AVX-512 registers too.
+__attribute__((target("xsave"))) bool HasAvx512() {
+  if (!HasAvx2()) {
+    return false;
+  }
+  // XMM, YMM, the mask registers and both halves of the ZMM registers
+  if ((_xgetbv(0) & 0xE6) != 0xE6) {
+    return false;
+  }
+  int r[4];
+  __cpuidex(r, 7, 0);
+  const unsigned ebx = static_cast<unsigned>(r[1]);
+  constexpr unsigned kF = 1u << 16, kDq = 1u << 17, kCd = 1u << 28, kBw = 1u << 30, kVl = 1u << 31;
+  return (ebx & (kF | kDq | kCd | kBw | kVl)) == (kF | kDq | kCd | kBw | kVl);
+}
+
+bool HasSse42() {
+  int r[4];
+  __cpuid(r, 1);
+  return (r[2] & (1 << 19)) && (r[2] & (1 << 20));
+}
+
+size_t Length(const wchar_t* text) {
+  size_t n = 0;
+  while (text[n]) {
+    ++n;
+  }
+  return n;
+}
+
+// Appends `text` to `out` (of `room` characters), always ending it.
+bool Append(wchar_t* out, size_t room, const wchar_t* text) {
+  size_t at = Length(out);
+  for (size_t i = 0; text[i]; ++i, ++at) {
+    if (at + 1 >= room) {
+      return false;
+    }
+    out[at] = text[i];
+  }
+  out[at] = 0;
+  return true;
+}
+
+bool StartsWith(const wchar_t* text, const wchar_t* start) {
+  for (size_t i = 0; start[i]; ++i) {
+    if (text[i] != start[i]) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool Exists(const wchar_t* path) {
+  return GetFileAttributesW(path) != INVALID_FILE_ATTRIBUTES;
+}
+
+// Reads at most `room - 1` bytes of the file at `path` as ASCII.
+bool ReadSmallFile(const wchar_t* path, char* out, DWORD room) {
+  HANDLE file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE, nullptr,
+                            OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+  if (file == INVALID_HANDLE_VALUE) {
+    return false;
+  }
+  DWORD read = 0;
+  const BOOL ok = ReadFile(file, out, room - 1, &read, nullptr);
+  CloseHandle(file);
+  out[ok ? read : 0] = 0;
+  return ok && read > 0;
+}
+
+// The version of the first line of `text` ("158.0.8127.3010"), copied to
+// `version`, when it is four numbers joined by dots.
+bool FirstVersion(const char* text, wchar_t* version, size_t room) {
+  size_t n = 0;
+  int dots = 0;
+  bool digit = false;
+  for (; text[n] && text[n] != '\n' && text[n] != '\r'; ++n) {
+    const char c = text[n];
+    if (c == '.') {
+      if (!digit) {
+        return false;
+      }
+      ++dots;
+      digit = false;
+    } else if (c >= '0' && c <= '9') {
+      digit = true;
+    } else {
+      return false;
+    }
+    if (n + 1 >= room) {
+      return false;
+    }
+    version[n] = c;
+  }
+  version[n] = 0;
+  return dots == 3 && digit;
+}
+
+enum class Build { kAvx2, kSse4, kAvx512, kUnknown };
+
+// Whether `text` is `name`, then the end, a line end or a space.
+bool IsName(const char* text, const char* name) {
+  size_t i = 0;
+  for (; name[i]; ++i) {
+    if (text[i] != name[i]) {
+      return false;
+    }
+  }
+  return text[i] == 0 || text[i] == '\r' || text[i] == '\n' || text[i] == ' ';
+}
+
+// What the package says it is built for, in the file `variant`. Any other text
+// is a package this launcher does not know, never taken for one it does.
+Build PackageBuild(const wchar_t* folder) {
+  wchar_t path[kPath] = {};
+  char text[64] = {};
+  if (!Append(path, kPath, folder) || !Append(path, kPath, L"\\variant") ||
+      !ReadSmallFile(path, text, sizeof(text) - 1)) {
+    // no file: the package is the AVX2 build, the one made first
+    return Build::kAvx2;
+  }
+  if (IsName(text, "win-x64-avx2")) {
+    return Build::kAvx2;
+  }
+  if (IsName(text, "win-x64-sse4")) {
+    return Build::kSse4;
+  }
+  if (IsName(text, "win-x64-avx512")) {
+    return Build::kAvx512;
+  }
+  return Build::kUnknown;
+}
+
+void Tell(const wchar_t* message) {
+  // The checks read the message from a file instead of a window.
+  wchar_t out[kPath];
+  if (GetEnvironmentVariableW(L"THORON_LAUNCHER_MESSAGE_FILE", out, kPath)) {
+    HANDLE file = CreateFileW(out, GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL,
+                              nullptr);
+    if (file != INVALID_HANDLE_VALUE) {
+      DWORD written = 0;
+      WriteFile(file, message, static_cast<DWORD>(Length(message) * sizeof(wchar_t)), &written,
+                nullptr);
+      CloseHandle(file);
+    }
+    return;
+  }
+  MessageBoxW(nullptr, message, L"Thoron", MB_OK | MB_ICONWARNING);
+}
+
+}  // namespace
+
+int WINAPI wWinMain(HINSTANCE, HINSTANCE, PWSTR, int) {
+  // The package's folder: the one this program is in.
+  wchar_t folder[kPath] = {};
+  const DWORD got = GetModuleFileNameW(nullptr, folder, kPath);
+  if (got == 0 || got >= kPath) {
+    return kNoBrowser;
+  }
+  for (DWORD i = got; i > 0; --i) {
+    if (folder[i - 1] == L'\\') {
+      folder[i - 1] = 0;
+      break;
+    }
+  }
+
+  // The processor: an AVX2 build on a processor without it stops at once, so
+  // this is said before it is started. (Tests may say which processor to
+  // assume.)
+  wchar_t assume[16] = {};
+  GetEnvironmentVariableW(L"THORON_LAUNCHER_ASSUME_CPU", assume, 16);
+  const bool sse4_only = StartsWith(assume, L"sse4");
+  const bool too_old = StartsWith(assume, L"old");
+  const bool avx2_only = StartsWith(assume, L"avx2");
+  const bool avx2 = !sse4_only && !too_old && HasAvx2();
+  const bool avx512 = avx2 && !avx2_only && HasAvx512();
+  const bool sse4 = !too_old && (sse4_only || HasSse42());
+  const Build build = PackageBuild(folder);
+  if (build == Build::kUnknown) {
+    Tell(L"This copy of Thoron is made for a kind of processor this launcher does not know. "
+         L"Unpack the whole package again, or download the package for this computer.");
+    return kWrongProcessor;
+  }
+  const bool runs = build == Build::kAvx512 ? avx512 : build == Build::kAvx2 ? avx2 : sse4;
+  if (!runs) {
+    Tell(!sse4 ? L"This computer's processor is too old for Thoron: it needs SSE4.2 at least."
+         : build == Build::kAvx512
+             ? L"This copy of Thoron is made for processors with AVX-512, which this computer's "
+               L"processor does not have. The AVX2 or SSE4 version of Thoron runs here: download it "
+               L"from the same page and put your \"User Data\" folder into it to keep your profile."
+             : L"This copy of Thoron is made for processors with AVX2, which this computer's processor "
+               L"does not have. The SSE4 version of Thoron runs here: download it from the same page "
+               L"and put your \"User Data\" folder into it to keep your profile.");
+    return kWrongProcessor;
+  }
+
+  // The version to start: the one Application\current names, or the browser
+  // of a package made before there were versions side by side.
+  wchar_t browser[kPath] = {};
+  wchar_t pointer[kPath] = {};
+  char text[64];
+  wchar_t version[32];
+  Append(pointer, kPath, folder);
+  Append(pointer, kPath, L"\\Application\\current");
+  if (ReadSmallFile(pointer, text, sizeof(text)) && FirstVersion(text, version, 32)) {
+    Append(browser, kPath, folder);
+    Append(browser, kPath, L"\\Application\\");
+    Append(browser, kPath, version);
+    Append(browser, kPath, L"\\thoron.exe");
+  }
+  if (!browser[0] || !Exists(browser)) {
+    browser[0] = 0;
+    Append(browser, kPath, folder);
+    Append(browser, kPath, L"\\Application\\thoron.exe");
+  }
+  if (!Exists(browser)) {
+    Tell(L"Thoron's program files are not in this folder. Unpack the whole package again.");
+    return kNoBrowser;
+  }
+
+  // The profile folder is made here: a folder that cannot be made (a drive
+  // that is write-protected) would make the browser use the computer's own
+  // profile folder instead, so nothing is started then.
+  wchar_t profile[kPath] = {};
+  Append(profile, kPath, folder);
+  Append(profile, kPath, L"\\User Data");
+  // A file of that name counts as "already there" for CreateDirectoryW, and the
+  // browser, given a profile folder it cannot use, would take this computer's
+  // own: so what is there must be a folder.
+  const bool made = CreateDirectoryW(profile, nullptr) || GetLastError() == ERROR_ALREADY_EXISTS;
+  const DWORD kind = GetFileAttributesW(profile);
+  if (!made || kind == INVALID_FILE_ATTRIBUTES || !(kind & FILE_ATTRIBUTE_DIRECTORY)) {
+    Tell(L"Thoron cannot use the \"User Data\" folder beside it: the drive is write-protected, or "
+         L"a file has that name. Nothing was started, so that nothing is written to this computer "
+         L"instead.");
+    return kStartFailed;
+  }
+
+  // The command line: the browser, the package's profile, and what this
+  // program was given (after its own name).
+  static wchar_t command[kPath];
+  command[0] = 0;
+  bool fits = Append(command, kPath, L"\"") && Append(command, kPath, browser) &&
+              Append(command, kPath, L"\" --user-data-dir=\"") && Append(command, kPath, folder) &&
+              Append(command, kPath, L"\\User Data\"");
+  const wchar_t* rest = GetCommandLineW();
+  if (*rest == L'"') {
+    for (++rest; *rest && *rest != L'"'; ++rest) {
+    }
+    if (*rest) {
+      ++rest;
+    }
+  } else {
+    while (*rest && *rest != L' ' && *rest != L'\t') {
+      ++rest;
+    }
+  }
+  if (*rest) {
+    fits = fits && Append(command, kPath, rest);
+  }
+  if (!fits) {
+    return kStartFailed;
+  }
+  STARTUPINFOW startup = {};
+  startup.cb = sizeof(startup);
+  PROCESS_INFORMATION process = {};
+  // The caller's working directory is kept, so a file named on the command
+  // line by a relative path is the caller's.
+  if (!CreateProcessW(browser, command, nullptr, nullptr, FALSE, 0, nullptr, nullptr, &startup,
+                      &process)) {
+    return kStartFailed;
+  }
+  CloseHandle(process.hThread);
+  CloseHandle(process.hProcess);
+  return kStarted;
+}
diff --git a/components/thoron_update/make_client_test_data.py b/components/thoron_update/make_client_test_data.py
