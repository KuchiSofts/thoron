+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/user_data_importer/chromium_family/browser_detection.h"
+
+#include <algorithm>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/strings/utf_string_conversions.h"
+#include "components/user_data_importer/common/importer_type.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace user_data_importer::chromium_family {
+namespace {
+
+// Builds a fake LOCALAPPDATA / APPDATA tree and runs detection over it. No real
+// browser data is ever touched.
+class BrowserDetectionTest : public ::testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(local_.CreateUniqueTempDir());
+    ASSERT_TRUE(roaming_.CreateUniqueTempDir());
+    folders_.local_app_data = local_.GetPath();
+    folders_.roaming_app_data = roaming_.GetPath();
+  }
+
+  base::FilePath UserData(const base::FilePath& base,
+                          const std::wstring& rel) {
+    return base.Append(rel);
+  }
+
+  void Write(const base::FilePath& path, const std::string& contents) {
+    ASSERT_TRUE(base::CreateDirectory(path.DirName()));
+    ASSERT_TRUE(base::WriteFile(path, contents));
+  }
+
+  // A multi-profile browser: Local State lists `profiles`, each a {folder,
+  // name}, and a Preferences file is written for those that exist.
+  void MakeMultiProfile(const base::FilePath& user_data,
+                        const std::string& info_cache_json,
+                        const std::vector<std::string>& profile_folders,
+                        bool running) {
+    Write(user_data.Append(L"Local State"),
+          "{\"profile\":{\"info_cache\":" + info_cache_json + "}}");
+    for (const std::string& folder : profile_folders) {
+      Write(user_data.AppendASCII(folder).Append(L"Preferences"), "{}");
+    }
+    if (running) {
+      Write(user_data.Append(L"lockfile"), "");
+    }
+  }
+
+  base::ScopedTempDir local_;
+  base::ScopedTempDir roaming_;
+  DetectionFolders folders_;
+};
+
+TEST_F(BrowserDetectionTest, FindsMultiProfileBrowser) {
+  base::FilePath chrome =
+      UserData(local_.GetPath(), L"Google\\Chrome\\User Data");
+  MakeMultiProfile(
+      chrome,
+      "{\"Default\":{\"name\":\"Person 1\"},\"Profile 1\":{\"name\":\"Work\"}}",
+      {"Default", "Profile 1"}, /*running=*/true);
+
+  std::vector<DetectedBrowser> found = DetectBrowsers(folders_);
+  ASSERT_EQ(1u, found.size());
+  EXPECT_EQ("Chrome", found[0].name);
+  EXPECT_TRUE(found[0].running);
+  ASSERT_EQ(2u, found[0].profiles.size());
+  EXPECT_EQ("Default", found[0].profiles[0].folder);
+  EXPECT_EQ(u"Person 1", found[0].profiles[0].name);
+  EXPECT_EQ("Profile 1", found[0].profiles[1].folder);
+  EXPECT_EQ(u"Work", found[0].profiles[1].name);
+
+  std::vector<SourceProfile> sources = MakeSourceProfiles(found);
+  ASSERT_EQ(2u, sources.size());
+  EXPECT_EQ(TYPE_CHROMIUM_FAMILY, sources[0].importer_type);
+  EXPECT_EQ(u"Chrome (Person 1)", sources[0].importer_name);
+  EXPECT_EQ(u"Chrome (Work)", sources[1].importer_name);
+  EXPECT_EQ(chrome.AppendASCII("Default"), sources[0].source_path);
+  EXPECT_EQ(chrome, sources[0].app_path);
+  EXPECT_EQ(SupportedItems(), sources[0].services_supported);
+}
+
+TEST_F(BrowserDetectionTest, SingleProfileNameIsBrowserAlone) {
+  base::FilePath brave =
+      UserData(local_.GetPath(), L"BraveSoftware\\Brave-Browser\\User Data");
+  MakeMultiProfile(brave, "{\"Default\":{\"name\":\"Main\"}}", {"Default"},
+                   /*running=*/false);
+
+  std::vector<SourceProfile> sources = DetectSourceProfiles(folders_);
+  ASSERT_EQ(1u, sources.size());
+  EXPECT_EQ(u"Brave", sources[0].importer_name);
+}
+
+TEST_F(BrowserDetectionTest, OperaKeepsProfileInItsOwnFolder) {
+  base::FilePath opera =
+      UserData(roaming_.GetPath(), L"Opera Software\\Opera Stable");
+  Write(opera.Append(L"Local State"), "{}");
+  Write(opera.Append(L"Preferences"), "{}");
+
+  std::vector<DetectedBrowser> found = DetectBrowsers(folders_);
+  ASSERT_EQ(1u, found.size());
+  EXPECT_EQ("Opera", found[0].name);
+  ASSERT_EQ(1u, found[0].profiles.size());
+  EXPECT_EQ(".", found[0].profiles[0].folder);
+
+  std::vector<SourceProfile> sources = MakeSourceProfiles(found);
+  ASSERT_EQ(1u, sources.size());
+  // A single-folder browser's source is the user data folder itself.
+  EXPECT_EQ(opera, sources[0].source_path);
+}
+
+TEST_F(BrowserDetectionTest, SkipsProfileWithoutPreferences) {
+  base::FilePath chromium = UserData(local_.GetPath(), L"Chromium\\User Data");
+  // Local State lists two, but only "Default" has a Preferences file.
+  MakeMultiProfile(
+      chromium,
+      "{\"Default\":{\"name\":\"A\"},\"Profile 7\":{\"name\":\"Ghost\"}}",
+      {"Default"}, /*running=*/false);
+
+  std::vector<DetectedBrowser> found = DetectBrowsers(folders_);
+  ASSERT_EQ(1u, found.size());
+  ASSERT_EQ(1u, found[0].profiles.size());
