+  // The Settings section: the blocker's options, and the browser settings
+  // uBlock Origin offers there (each "true" means the protective choice).
+  void GetSettings(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 0);
+    if (!id) {
+      return;
+    }
+    PrefService* prefs = Profile::FromWebUI(web_ui())->GetPrefs();
+    base::DictValue settings;
+    for (const char* name :
+         {"badge", "block-csp-reports", "cname-uncloak", "ignore-generic",
+          "default-media",
+          "default-cosmetic", "default-fonts", "default-3p-script",
+          "default-3p-frame", "auto-update", "context-menu", "advanced",
+          "colorblind", "no-tooltips", "toolbar-shield", "address-shield"}) {
+      settings.Set(name, Service().Option(name));
+    }
+    // where the shields are (P5.73)
+    for (const char* name : {"toolbar-position", "address-position"}) {
+      settings.Set(name, Service().Choice(name));
+    }
+    settings.Set("media-kb", Service().large_media_kb());
+    // the switch for every site (P5.70); not in a backup
+    settings.Set("blocking",
+                 thoron_adblock::ProxyingURLLoaderFactory::BlockingEverywhere(
+                     SiteSettings()));
+    settings.Set("blocking-back", Service().BlockingBackAt());
+    settings.Set("accent", Service().accent());
+    settings.Set("theme",
+                 Service().theme().empty() ? std::string("auto") : Service().theme());
+    // for the troubleshooting information, as uBlock Origin's support page
+    settings.Set("version", std::string(version_info::GetVersionNumber()));
+    base::DictValue shortcuts;
+    for (const auto& [command, keys] : Service().shortcuts()) {
+      shortcuts.Set(command, keys);
+    }
+    settings.Set("shortcuts", std::move(shortcuts));
+    settings.Set("javascript", SiteSettings()->GetDefaultContentSetting(
+                                   ContentSettingsType::JAVASCRIPT) ==
+                                   CONTENT_SETTING_BLOCK);
+    settings.Set("prefetch",
+                 prefs->GetInteger(prefs::kNetworkPredictionOptions) ==
+                     static_cast<int>(
+                         prefetch::NetworkPredictionOptions::kDisabled));
+    settings.Set("hyperlink-auditing",
+                 !prefs->GetBoolean(prefs::kEnableHyperlinkAuditing));
+    // the policies that keep local addresses out (the browser's default here
+    // offers both public and private ones)
+    const std::string& webrtc = prefs->GetString(prefs::kWebRTCIPHandlingPolicy);
+    settings.Set("webrtc",
+                 webrtc == blink::kWebRTCIPHandlingDefaultPublicInterfaceOnly ||
+                     webrtc == blink::kWebRTCIPHandlingDisableNonProxiedUdp);
+    ResolveJavascriptCallback(base::Value(*id), settings);
+  }
+
+  // The switch for every site (P5.70): [id, on, minutes] (minutes: off for
+  // that long, -1 until the browser closes, 0 until switched on again).
+  void SetBlocking(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 2);
+    if (!id || !args[1].is_bool() || !args[2].is_int()) {
+      return;
+    }
+    Answer(*id, thoron_adblock::ProxyingURLLoaderFactory::SetBlockingEverywhere(
+                    SiteSettings(), args[1].GetBool(), args[2].GetInt())
+                    ? std::string()
+                    : std::string("This is not a choice."));
+  }
+
+  void SetSetting(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 2);
+    if (!id || !args[1].is_string()) {
+      return;
+    }
+    const std::string& name = args[1].GetString();
+    // "Block media elements larger than N kB": a whole number
+    if (name == "accent") {
+      Answer(*id, args[2].is_string() && Service().SetAccent(args[2].GetString())
+                      ? std::string()
+                      : std::string("This is not a colour."));
+      return;
+    }
+    if (thoron_adblock::EngineService::KnownChoiceName(name)) {
+      Answer(*id, args[2].is_string() &&
+                          Service().SetChoice(name, args[2].GetString())
+                      ? std::string()
+                      : std::string("This is not a choice."));
+      return;
+    }
+    if (name == "theme") {
+      Answer(*id, args[2].is_string() && Service().SetTheme(args[2].GetString())
+                      ? std::string()
+                      : std::string("This is not a theme."));
+      return;
+    }
+    if (name == "media-kb") {
+      Answer(*id, args[2].is_int() && Service().SetLargeMediaKb(args[2].GetInt())
+                      ? std::string()
+                      : std::string("Give a whole number of kB, from 1 to 1048576."));
+      return;
+    }
+    if (!args[2].is_bool()) {
+      return;
+    }
+    const bool on = args[2].GetBool();
+    PrefService* prefs = Profile::FromWebUI(web_ui())->GetPrefs();
+    if (thoron_adblock::EngineService::KnownOption(name)) {
+      Service().SetOption(name, on);
+    } else if (name == "javascript") {
+      SiteSettings()->SetDefaultContentSetting(
+          ContentSettingsType::JAVASCRIPT,
+          on ? CONTENT_SETTING_BLOCK : CONTENT_SETTING_DEFAULT);
+    } else if (name == "prefetch" || name == "hyperlink-auditing" ||
+               name == "webrtc") {
+      // on: the protective value; off: the browser's own default again
+      const char* pref = name == "prefetch" ? prefs::kNetworkPredictionOptions
+                         : name == "webrtc" ? prefs::kWebRTCIPHandlingPolicy
+                                            : prefs::kEnableHyperlinkAuditing;
+      if (!on) {
+        prefs->ClearPref(pref);
+      } else if (name == "prefetch") {
+        prefs->SetInteger(pref, static_cast<int>(
+                                    prefetch::NetworkPredictionOptions::kDisabled));
+      } else if (name == "webrtc") {
+        prefs->SetString(pref,
+                         blink::kWebRTCIPHandlingDefaultPublicInterfaceOnly);
+      } else {
+        prefs->SetBoolean(pref, false);
+      }
+    } else {
+      Answer(*id, "This is not a setting.");
+      return;
+    }
+    Answer(*id, std::string());
+  }
+
+  // Every open tab of this profile that has blocked requests, and the last
+  // of them. Kept in memory with each page; nothing is stored.
+  void GetLog(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 0);
+    if (!id) {
+      return;
+    }
+    thoron_adblock::BlockedCount::LoggerAsked();
+    Profile* profile = Profile::FromWebUI(web_ui());
+    base::ListValue tabs;
+    for (BrowserWindowInterface* browser : GetAllBrowserWindowInterfaces()) {
+      if (browser->GetProfile() != profile) {
+        continue;
+      }
+      TabStripModel* strip = browser->GetTabStripModel();
+      for (int i = 0; i < strip->count(); ++i) {
+        content::WebContents* tab = strip->GetWebContentsAt(i);
+        std::vector<thoron_adblock::BlockedCount::Entry> entries =
+            thoron_adblock::BlockedCount::Recent(tab->GetPrimaryPage());
+        if (entries.empty()) {
+          continue;
+        }
+        base::ListValue list;
+        const GURL& page = tab->GetLastCommittedURL();
+        for (const auto& entry : entries) {
+          // as uBlock Origin's logger marks them: to another site than the
+          // tab's (by registrable domain)
+          const bool third_party =
+              entry.type != "cosmetic" && entry.type != "scriptlet" &&
+              entry.type != "replace" &&
+              page.SchemeIsHTTPOrHTTPS() &&
+              !net::registry_controlled_domains::SameDomainOrHost(
+                  GURL(entry.url), page,
+                  net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+          list.Append(base::DictValue()
+                          .Set("time", entry.time.InMillisecondsFSinceUnixEpoch())
+                          .Set("url", entry.url)
+                          .Set("blocked", entry.blocked)
+                          .Set("type", entry.type)
+                          .Set("thirdParty", third_party));
+        }
+        tabs.Append(base::DictValue()
+                        .Set("id", sessions::SessionTabHelper::IdForTab(tab).id())
+                        .Set("title", base::UTF16ToUTF8(tab->GetTitle()))
+                        .Set("url", tab->GetLastCommittedURL().spec())
+                        .Set("entries", std::move(list)));
+      }
+    }
+    ResolveJavascriptCallback(base::Value(*id), tabs);
+  }
+
+  // My filters as an editor marks them: [id, text] -> the lines that are not
+  // filters this blocker can use.
+  void CheckFilters(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 1);
+    if (!id || !args[1].is_string()) {
+      return;
+    }
+    const std::string& text = args[1].GetString();
+    base::ListValue problems;
+    if (text.size() <= kMaxRulesLength && base::IsStringUTF8(text)) {
+      for (const rust::String& line :
+           thoron_adblock::filter_problems(rust::Str(text.data(), text.size()))) {
+        problems.Append(std::string(line));
+      }
+    }
+    ResolveJavascriptCallback(base::Value(*id), problems);
+  }
+
+  // uBlock Origin's keyboard shortcuts: [id, command, keys] ("" clears).
+  void SetShortcut(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 2);
+    if (!id || !args[1].is_string() || !args[2].is_string()) {
+      return;
+    }
+    Answer(*id, Service().SetShortcut(args[1].GetString(), args[2].GetString())
+                    ? std::string()
+                    : std::string("That cannot be a shortcut: use Ctrl or Alt "
+                                  "with a letter, a digit or F1 to F12."));
+  }
+
+  // "Allow custom filters requiring trust": [id, on].
+  void SetTrustMyFilters(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 1);
+    if (!id || !args[1].is_bool()) {
+      return;
+    }
+    Service().SetTrustMyFilters(args[1].GetBool(), Changed(*id));
+  }
+
+  // The logger's "Why?": [id, url, type, page]. Only web addresses, and a type
+  // as the lists name one (lower-case letters and "_"); another is "other".
+  void ExplainRequest(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 3);
+    if (!id || !args[1].is_string() || !args[2].is_string() ||
+        !args[3].is_string()) {
+      return;
+    }
+    const GURL url(args[1].GetString());
+    const GURL page(args[3].GetString());
+    std::string type = args[2].GetString();
+    if (type.empty() || type.size() > 24 ||
+        !std::all_of(type.begin(), type.end(),
+                     [](char c) { return (c >= 'a' && c <= 'z') || c == '_'; })) {
+      type = "other";
+    }
+    if (!url.is_valid() || !(url.SchemeIsHTTPOrHTTPS() || url.SchemeIsWSOrWSS())) {
+      ResolveJavascriptCallback(base::Value(*id), base::DictValue());
+      return;
+    }
+    Service().Explain(
+        url, page.SchemeIsHTTPOrHTTPS() ? page : GURL(), std::move(type),
+        base::BindOnce(&ThoronAdblockHandler::AnswerValue,
+                       weak_factory_.GetWeakPtr(), *id));
+  }
+
+  // The text of one list, as uBlock Origin shows a list when its name is
+  // clicked: [id, list id] -> the text, or null when no such list is in use.
+  void GetListText(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 1);
+    if (!id || !args[1].is_string()) {
+      return;
+    }
+    const std::string& list = args[1].GetString();
+    if (list.empty() || list.size() > 64 ||
+        !std::all_of(list.begin(), list.end(), [](char c) {
+          return (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-';
+        })) {
+      ResolveJavascriptCallback(base::Value(*id), base::Value());
+      return;
+    }
+    Service().ListText(list, base::BindOnce(&ThoronAdblockHandler::AnswerText,
+                                            weak_factory_.GetWeakPtr(), *id));
+  }
+
+  void AnswerText(const std::string& id, std::optional<std::string> text) {
+    // only text reaches the page
+    ResolveJavascriptCallback(base::Value(id),
+                              text && base::IsStringUTF8(*text)
+                                  ? base::Value(std::move(*text))
+                                  : base::Value());
+  }
+
+  void AnswerValue(const std::string& id, base::DictValue value) {
+    ResolveJavascriptCallback(base::Value(id), value);
+  }
+
+  void GetState(const base::ListValue& args) {
+    if (const std::string* id = AnswerId(args, 0)) {
+      Service().DescribeSettings(
+          base::BindOnce(&ThoronAdblockHandler::AnswerState,
+                         weak_factory_.GetWeakPtr(), *id));
+    }
+  }
+
+  void SetListEnabled(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 2);
+    if (!id || !args[1].is_string() || !args[2].is_bool()) {
+      return;
+    }
+    Service().SetListEnabled(args[1].GetString(), args[2].GetBool(),
+                             Changed(*id));
+  }
+
+  void AddList(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 1);
+    if (!id || !args[1].is_string()) {
+      return;
+    }
+    const std::string& address = args[1].GetString();
+    const GURL url(address);
+    if (address.size() > kMaxUrlLength || !url.is_valid()) {
+      Answer(*id, "This is not an address.");
+      return;
+    }
+    Service().AddList(url, Changed(*id));
+  }
+
+  void RemoveList(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 1);
+    if (!id || !args[1].is_string()) {
+      return;
+    }
+    Service().RemoveList(args[1].GetString(), Changed(*id));
+  }
+
+  void SetMyFilters(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 1);
+    if (!id || !args[1].is_string()) {
+      return;
+    }
+    if (args[1].GetString().size() > kMaxRulesLength) {
+      Answer(*id, "Your filters are larger than 1 MB.");
+      return;
+    }
+    Service().SetMyFilters(args[1].GetString(), Changed(*id));
+  }
+
+  void UpdateNow(const base::ListValue& args) {
+    if (const std::string* id = AnswerId(args, 0)) {
+      Service().UpdateNow(Changed(*id));
+    }
+  }
+
+  base::WeakPtrFactory<ThoronAdblockHandler> weak_factory_{this};
+};
