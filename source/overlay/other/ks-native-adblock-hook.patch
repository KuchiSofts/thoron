+namespace thoron_update {
+namespace {
+
+constexpr char kVersion[] = "158.0.8127.3010";
+
+class ThoronUpdatePortablePackageTest : public testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(dir_.CreateUniqueTempDir()); }
+
+  base::FilePath Path(const std::string& name) { return dir_.GetPath().AppendASCII(name); }
+
+  void Put(const base::FilePath& root, const std::string& relative, const std::string& content) {
+    const base::FilePath path = root.Append(base::FilePath::FromUTF8Unsafe(relative));
+    ASSERT_TRUE(base::CreateDirectory(path.DirName()));
+    ASSERT_TRUE(base::WriteFile(path, content));
+  }
+
+  // A package as portable.py makes it, with `extra` files beside it in the zip.
+  base::FilePath Package(const std::string& name,
+                         const std::vector<std::pair<std::string, std::string>>& extra = {}) {
+    const base::FilePath tree = Path(name + ".tree");
+    Put(tree, "ThoronPortable/Thoron.exe", "launcher of " + name);
+    Put(tree, "ThoronPortable/README.txt", "readme");
+    Put(tree, "ThoronPortable/variant", "win-x64-avx2\n");
+    Put(tree, "ThoronPortable/Application/current", std::string(kVersion) + "\n");
+    Put(tree, std::string("ThoronPortable/Application/") + kVersion + "/thoron.exe", "browser");
+    Put(tree, std::string("ThoronPortable/Application/") + kVersion + "/" + kVersion + "/chrome.dll",
+        "engine");
+    Put(tree, std::string("ThoronPortable/Application/") + kVersion + "/thoron_update.exe", "updater");
+    Put(tree, "ThoronPortable/Application/158.0.8127.3000/thoron.exe", "an older browser");
+    for (const auto& [relative, content] : extra) {
+      Put(tree, relative, content);
+    }
+    const base::FilePath zip = Path(name + ".zip");
+    EXPECT_TRUE(zip::Zip(tree, zip, /*include_hidden_files=*/true));
+    return zip;
+  }
+
+  base::ScopedTempDir dir_;
+};
+
+TEST_F(ThoronUpdatePortablePackageTest, OnlyTheVersionsFolderIsUnpackedAndListed) {
+  const base::FilePath zip = Package("p");
+  const base::FilePath staged = Path("Application/158.0.8127.3010.staging");
+  std::vector<VersionFile> files;
+  ASSERT_EQ(UnpackVersion(zip, *ParseBuildVersion(kVersion), staged, &files), UnpackResult::kDone);
+  std::vector<std::string> paths;
+  for (const VersionFile& file : files) {
+    paths.push_back(file.path);
+    std::string read;
+    ASSERT_TRUE(base::ReadFileToString(staged.Append(base::FilePath::FromUTF8Unsafe(file.path)), &read));
+    EXPECT_EQ(file.size, static_cast<int64_t>(read.size()));
+    EXPECT_EQ(file.sha256, base::HexEncodeLower(crypto::hash::Sha256(read)));
+  }
+  std::sort(paths.begin(), paths.end());
+  EXPECT_EQ(paths, (std::vector<std::string>{std::string(kVersion) + "/chrome.dll", "thoron.exe",
+                                             "thoron_update.exe"}));
+  // the older version and the rest of the package stay out (Thoron.exe cannot
+  // be asked for: Windows takes it for the browser's thoron.exe)
+  EXPECT_FALSE(base::PathExists(staged.AppendASCII("README.txt")));
+  EXPECT_FALSE(base::PathExists(staged.AppendASCII("variant")));
+  EXPECT_FALSE(base::PathExists(staged.AppendASCII("current")));
+  EXPECT_FALSE(base::PathExists(staged.AppendASCII("158.0.8127.3000")));
+}
+
+TEST_F(ThoronUpdatePortablePackageTest, AVersionThePackageDoesNotHaveIsSaid) {
+  const base::FilePath staged = Path("s");
+  std::vector<VersionFile> files;
+  EXPECT_EQ(UnpackVersion(Package("p"), *ParseBuildVersion("158.0.8127.3999"), staged, &files),
+            UnpackResult::kNoSuchVersion);
+  EXPECT_FALSE(base::PathExists(staged));
+  EXPECT_TRUE(files.empty());
+}
+
+TEST_F(ThoronUpdatePortablePackageTest, APackageWithAnotherTopFolderOrNoZipIsRefused) {
+  const base::FilePath staged = Path("s");
+  std::vector<VersionFile> files;
+  EXPECT_EQ(UnpackVersion(Package("p", {{"Elsewhere/x.txt", "x"}}), *ParseBuildVersion(kVersion), staged,
+                          &files),
+            UnpackResult::kNotAPackage);
+  EXPECT_FALSE(base::PathExists(staged));
+  ASSERT_TRUE(base::WriteFile(Path("not.zip"), "not a zip at all"));
+  EXPECT_EQ(UnpackVersion(Path("not.zip"), *ParseBuildVersion(kVersion), staged, &files),
+            UnpackResult::kNotAPackage);
+  EXPECT_FALSE(base::PathExists(staged));
+}
+
+TEST_F(ThoronUpdatePortablePackageTest, OnlyNamesTheZipReaderMadeSafeCount) {
+  EXPECT_TRUE(ZipPathWasMadeSafe(base::FilePath::FromUTF8Unsafe("a/UP/b")));
+  EXPECT_TRUE(ZipPathWasMadeSafe(base::FilePath::FromUTF8Unsafe("a/DOT/b")));
+  EXPECT_TRUE(ZipPathWasMadeSafe(base::FilePath::FromUTF8Unsafe("ROOT/etc/passwd")));
+  EXPECT_FALSE(ZipPathWasMadeSafe(base::FilePath::FromUTF8Unsafe("a/ROOT/b")));
+  EXPECT_FALSE(ZipPathWasMadeSafe(base::FilePath::FromUTF8Unsafe("ThoronPortable/Application/up/Updater")));
+  EXPECT_FALSE(ZipPathWasMadeSafe(base::FilePath::FromUTF8Unsafe("ThoronPortable/Thoron.exe")));
+}
+
+TEST_F(ThoronUpdatePortablePackageTest, ARewrittenPackageStillUnpacks) {
+  // The test zips below are written by WriteTestZip; one it writes is a good one.
+  const base::FilePath zip = Path("rewritten.zip");
+  ASSERT_TRUE(WriteTestZip(zip, ReadTestZip(Package("p"))));
+  std::vector<VersionFile> files;
+  EXPECT_EQ(UnpackVersion(zip, *ParseBuildVersion(kVersion), Path("s"), &files), UnpackResult::kDone);
+  EXPECT_EQ(files.size(), 3u);
+}
+
+TEST_F(ThoronUpdatePortablePackageTest, AnEntryThatClimbsOutOfTheFolderIsRefused) {
+  const std::vector<TestZipEntry> good = ReadTestZip(Package("p"));
+  ASSERT_FALSE(good.empty());
+  const std::string inside = std::string("ThoronPortable/Application/") + kVersion;
+  // zip::ZipReader keeps each of them inside the folder (as UP/, DOT/); a
+  // package that has one is refused all the same.
+  for (const char* bad : {"/../../../outside.txt", "/a/../../../../outside.txt", "/./thoron.exe",
+                          "/../../current"}) {
+    SCOPED_TRACE(bad);
+    std::vector<TestZipEntry> crafted = good;
+    crafted.push_back({inside + bad, "not from the package"});
+    const base::FilePath zip = Path("crafted.zip");
+    ASSERT_TRUE(WriteTestZip(zip, crafted));
+    const base::FilePath staged = Path("Application/158.0.8127.3010.staging");
+    std::vector<VersionFile> files;
+    EXPECT_EQ(UnpackVersion(zip, *ParseBuildVersion(kVersion), staged, &files), UnpackResult::kUnsafeEntry);
+    EXPECT_FALSE(base::PathExists(staged));
+    EXPECT_FALSE(base::PathExists(Path("outside.txt")));
+    EXPECT_FALSE(base::PathExists(Path("Application/outside.txt")));
+    EXPECT_FALSE(base::PathExists(Path("Application/current")));
+  }
+}
+
+#if BUILDFLAG(IS_POSIX)
+TEST_F(ThoronUpdatePortablePackageTest, ALinkInThePackageIsRefused) {
+  std::vector<TestZipEntry> crafted = ReadTestZip(Package("p"));
+  crafted.push_back({std::string("ThoronPortable/Application/") + kVersion + "/link", "/etc/passwd", true});
+  const base::FilePath zip = Path("link.zip");
+  ASSERT_TRUE(WriteTestZip(zip, crafted));
+  const base::FilePath staged = Path("s");
+  std::vector<VersionFile> files;
+  EXPECT_EQ(UnpackVersion(zip, *ParseBuildVersion(kVersion), staged, &files), UnpackResult::kUnsafeEntry);
+  EXPECT_FALSE(base::PathExists(staged));
+}
+#endif
+
+TEST_F(ThoronUpdatePortablePackageTest, AStagingFolderThatIsThereIsNeverWrittenInto) {
+  const base::FilePath staged = Path("s");
+  ASSERT_TRUE(base::CreateDirectory(staged));
+  ASSERT_TRUE(base::WriteFile(staged.AppendASCII("keep"), "keep"));
+  std::vector<VersionFile> files;
+  EXPECT_EQ(UnpackVersion(Package("p"), *ParseBuildVersion(kVersion), staged, &files),
+            UnpackResult::kIoError);
+  EXPECT_TRUE(base::PathExists(staged.AppendASCII("keep")));
+}
+
+TEST_F(ThoronUpdatePortablePackageTest, TheLauncherIsReplacedOnlyWhenItDiffers) {
+  const base::FilePath launcher = Path("Thoron.exe");
+  ASSERT_TRUE(base::WriteFile(launcher, "an old launcher"));
+  const base::FilePath zip = Package("p");
+  EXPECT_TRUE(ReplaceLauncher(zip, launcher));
+  std::string read;
+  ASSERT_TRUE(base::ReadFileToString(launcher, &read));
+  EXPECT_EQ(read, "launcher of p");
+  EXPECT_FALSE(base::PathExists(launcher.AddExtensionASCII("new")));
+  // the same one again: nothing to do, and still true
+  EXPECT_TRUE(ReplaceLauncher(zip, launcher));
+  // a zip without a launcher changes nothing
+  const base::FilePath tree = Path("bare.tree");
+  Put(tree, "ThoronPortable/README.txt", "readme");
+  ASSERT_TRUE(zip::Zip(tree, Path("bare.zip"), true));
+  EXPECT_FALSE(ReplaceLauncher(Path("bare.zip"), launcher));
+  ASSERT_TRUE(base::ReadFileToString(launcher, &read));
+  EXPECT_EQ(read, "launcher of p");
+}
+
