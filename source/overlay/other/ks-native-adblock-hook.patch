+TEST_F(ChromiumFamilyReaderTest, ImportsCookiesOlderLayoutNoHostHash) {
+  std::array<uint8_t, 32> raw_key = MakeKey();
+  MakeLocalState(raw_key);
+  const base::Time future = base::Time::Now() + base::Days(10);
+
+  // Meta version 23 (< 24): the decrypted value has no host-hash prefix. The
+  // older layout keeps Cookies in the profile folder itself.
+  std::vector<CookieRow> rows = {
+      {"old.example.com", "legacy", "", MakeV10Value(raw_key, "legacy-value"),
+       true, true, future}};
+  MakeCookies(profile_.Append(FILE_PATH_LITERAL("Cookies")), /*version=*/23, rows);
+
+  FakeBridge bridge;
+  ChromiumFamilyReader reader(Options());
+  ChromiumFamilyReader::Stats stats = reader.Import(user_data_importer::COOKIES,
+                                                    &bridge);
+
+  EXPECT_EQ(1, stats.cookies);
+  ASSERT_EQ(1u, bridge.cookies.size());
+  EXPECT_EQ("legacy", bridge.cookies[0].name);
+  EXPECT_EQ("legacy-value", bridge.cookies[0].value);
+}
