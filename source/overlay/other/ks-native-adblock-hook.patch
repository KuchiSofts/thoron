+
+void ThoronMailCenter::OnEncryptor(
+    scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+  encryptor_ = std::move(encryptor);
+  service_->SetImapAccounts(KeptImapAccounts());
+}
+
+std::vector<thoron_mail::ImapAccount> ThoronMailCenter::KeptImapAccounts()
+    const {
+  std::vector<thoron_mail::ImapAccount> accounts;
+  if (!encryptor_) {
+    return accounts;
+  }
+  for (const base::Value& value :
+       profile_->GetPrefs()->GetList(kImapAccountsPref)) {
+    const base::DictValue* dict = value.GetIfDict();
+    const std::string* email = dict ? dict->FindString("email") : nullptr;
+    const std::string* host = dict ? dict->FindString("host") : nullptr;
+    const std::string* secret = dict ? dict->FindString("secret") : nullptr;
+    std::string encrypted;
+    thoron_mail::ImapAccount account;
+    if (!email || !host || !secret ||
+        !base::Base64Decode(*secret, &encrypted) ||
+        !encryptor_->DecryptString(encrypted, &account.password)) {
+      continue;
+    }
+    account.email = *email;
+    account.host = *host;
+    account.port = dict->FindInt("port").value_or(993);
+    if (const std::string* user = dict->FindString("user")) {
+      account.user = *user;
+    }
+    if (const std::string* webmail = dict->FindString("webmail")) {
+      account.webmail = *webmail;
+    }
+    if (const std::string* pin = dict->FindString("pin")) {
+      account.pin = *pin;
+    }
+    if (std::optional<thoron_mail::ImapAccount> checked =
+            CheckedAccount(std::move(account))) {
+      accounts.push_back(std::move(*checked));
+    }
+  }
+  return accounts;
+}
+
+bool ThoronMailCenter::KeepImapAccounts(
+    const std::vector<thoron_mail::ImapAccount>& accounts) {
+  if (!encryptor_) {
+    return false;
+  }
+  base::ListValue kept;
+  for (const thoron_mail::ImapAccount& account : accounts) {
+    std::string encrypted;
+    if (!encryptor_->EncryptString(account.password, &encrypted)) {
+      return false;
+    }
+    base::DictValue entry = base::DictValue()
+                                .Set("email", account.email)
+                                .Set("host", account.host)
+                                .Set("port", account.port)
+                                .Set("user", account.user)
+                                .Set("webmail", account.webmail)
+                                .Set("secret", base::Base64Encode(encrypted));
+    // Proton Mail Bridge: the pin of its certificate (not a secret)
+    if (!account.pin.empty()) {
+      entry.Set("pin", account.pin);
+    }
+    kept.Append(std::move(entry));
+  }
+  profile_->GetPrefs()->SetList(kImapAccountsPref, std::move(kept));
+  service_->SetImapAccounts(accounts);
+  return true;
+}
+
+void ThoronMailCenter::AddImapAccount(thoron_mail::ImapAccount account,
+                                      Told told) {
+  std::optional<thoron_mail::ImapAccount> checked =
+      CheckedAccount(std::move(account));
+  if (!checked) {
+    std::move(told).Run("bad");
+    return;
+  }
+  if (!encryptor_) {
+    std::move(told).Run("locked");
+    return;
+  }
+  const std::vector<thoron_mail::ImapAccount>& known =
+      service_->imap_accounts();
+  if (std::ranges::any_of(known, [&](const thoron_mail::ImapAccount& other) {
+        return base::EqualsCaseInsensitiveASCII(other.email, checked->email);
+      })) {
+    std::move(told).Run("exists");
+    return;
+  }
+  if (known.size() >= thoron_mail::MailService::kMostImapAccounts) {
+    std::move(told).Run("full");
+    return;
+  }
+  if (imap_test_) {
+    std::move(told).Run("busy");
+    return;
+  }
+  // Signed in to once before it is kept: a wrong password is told at once. A
+  // server on this computer (Proton Mail Bridge) is trusted with the
+  // certificate it shows now, which is pinned.
+  thoron_mail::ImapAccount to_test = *checked;
+  to_test.pin.clear();
+  imap_test_ = std::make_unique<thoron_mail::ImapCheck>(
+      profile_->GetDefaultStoragePartition()->GetNetworkContext(), to_test,
+      base::BindOnce(&ThoronMailCenter::OnImapTested,
+                     weak_factory_.GetWeakPtr(), std::move(*checked),
+                     std::move(told)),
+      /*trust_new_certificate=*/true);
+}
+
+void ThoronMailCenter::OnImapTested(thoron_mail::ImapAccount account,
+                                    Told told,
+                                    thoron_mail::ImapCheck::Result result) {
+  // this runs from inside the test
+  base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+      FROM_HERE, std::move(imap_test_));
+  if (!result.problem.empty()) {
+    std::move(told).Run(result.problem);
+    return;
+  }
+  if (thoron_mail::IsLocalImapHost(account.host)) {
+    account.pin = result.pin;
+  }
+  std::vector<thoron_mail::ImapAccount> accounts = service_->imap_accounts();
+  accounts.push_back(std::move(account));
+  std::move(told).Run(KeepImapAccounts(accounts) ? std::string() : "locked");
+}
+
+void ThoronMailCenter::RemoveImapAccount(const std::string& email) {
+  std::vector<thoron_mail::ImapAccount> accounts = service_->imap_accounts();
+  const size_t before = accounts.size();
+  std::erase_if(accounts, [&](const thoron_mail::ImapAccount& account) {
+    return account.email == email;
+  });
+  if (accounts.size() != before) {
+    KeepImapAccounts(accounts);
+  }
+}
+
+void ThoronMailCenter::EditImapAccount(const std::string& before,
+                                       thoron_mail::ImapAccount account,
+                                       Told told) {
+  if (!encryptor_) {
+    std::move(told).Run("locked");
+    return;
+  }
+  const std::vector<thoron_mail::ImapAccount>& known =
+      service_->imap_accounts();
+  const auto old = std::ranges::find_if(
+      known, [&](const thoron_mail::ImapAccount& kept) {
+        return kept.email == before;
+      });
+  if (old == known.end()) {
+    std::move(told).Run("missing");
+    return;
+  }
+  // an empty password keeps the one it has: it is never shown to be edited
+  const bool password_typed = !account.password.empty();
+  if (!password_typed) {
+    account.password = old->password;
+  }
+  std::optional<thoron_mail::ImapAccount> checked =
+      CheckedAccount(std::move(account));
+  if (!checked) {
+    std::move(told).Run("bad");
+    return;
+  }
+  // Proton Mail Bridge: its pin stays while it is the same server; its
+  // password typed again trusts the certificate it shows now (Bridge made a
+  // new one), which is pinned instead
+  const bool local = thoron_mail::IsLocalImapHost(checked->host);
+  if (local && checked->host == old->host && checked->port == old->port) {
+    checked->pin = old->pin;
+  }
+  if (std::ranges::any_of(known, [&](const thoron_mail::ImapAccount& other) {
+        return other.email != before &&
+               base::EqualsCaseInsensitiveASCII(other.email, checked->email);
+      })) {
+    std::move(told).Run("exists");
+    return;
+  }
+  const bool same_sign_in =
+      checked->email == old->email && checked->user == old->user &&
+      checked->host == old->host && checked->port == old->port &&
+      checked->password == old->password && !(local && password_typed);
+  if (same_sign_in) {
+    // only its mail page changed: nothing to sign in to again
+    std::move(told).Run(ReplaceImapAccount(before, std::move(*checked)));
+    return;
+  }
+  if (imap_test_) {
+    std::move(told).Run("busy");
+    return;
+  }
+  // Signed in to once before it is kept: a wrong password is told at once, and
+  // the mailbox stays as it was.
+  thoron_mail::ImapAccount to_test = *checked;
+  if (password_typed) {
+    to_test.pin.clear();
+  }
+  const bool trust_new_certificate = to_test.pin.empty();
+  imap_test_ = std::make_unique<thoron_mail::ImapCheck>(
+      profile_->GetDefaultStoragePartition()->GetNetworkContext(), to_test,
+      base::BindOnce(&ThoronMailCenter::OnImapEditTested,
+                     weak_factory_.GetWeakPtr(), before, std::move(*checked),
+                     std::move(told)),
+      trust_new_certificate);
+}
+
+void ThoronMailCenter::OnImapEditTested(std::string before,
+                                        thoron_mail::ImapAccount account,
+                                        Told told,
+                                        thoron_mail::ImapCheck::Result result) {
+  // this runs from inside the test
+  base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+      FROM_HERE, std::move(imap_test_));
+  if (!result.problem.empty()) {
+    std::move(told).Run(result.problem);
+    return;
+  }
+  if (thoron_mail::IsLocalImapHost(account.host)) {
+    account.pin = result.pin;
+  }
+  std::move(told).Run(ReplaceImapAccount(before, std::move(account)));
+}
+
+std::string ThoronMailCenter::ReplaceImapAccount(
+    const std::string& before,
+    thoron_mail::ImapAccount account) {
+  // looked up again: the list may have changed while it was signed in to
+  std::vector<thoron_mail::ImapAccount> accounts = service_->imap_accounts();
+  const auto at = std::ranges::find_if(
+      accounts, [&](const thoron_mail::ImapAccount& kept) {
+        return kept.email == before;
+      });
+  if (at == accounts.end()) {
+    return "missing";
+  }
+  if (std::ranges::any_of(accounts, [&](const thoron_mail::ImapAccount& other) {
+        return other.email != before &&
+               base::EqualsCaseInsensitiveASCII(other.email, account.email);
+      })) {
+    return "exists";
+  }
+  const std::string after = account.email;
+  *at = std::move(account);
+  if (!KeepImapAccounts(accounts)) {
+    return "locked";
+  }
+  service_->Renamed(before, after);
+  return std::string();
+}
+
+std::vector<ThoronMailCenter::GoogleAccount>
+ThoronMailCenter::KeptGoogleAccounts() const {
+  std::vector<GoogleAccount> accounts;
+  for (const base::Value& value :
+       profile_->GetPrefs()->GetList(kGoogleAccountsPref)) {
+    const base::DictValue* dict = value.GetIfDict();
+    const std::string* email = dict ? dict->FindString("email") : nullptr;
+    if (!email || !IsAddress(*email)) {
+      continue;
+    }
+    GoogleAccount account;
+    account.email = *email;
+    if (const std::string* alias = dict->FindString("alias")) {
+      account.alias = *alias;
+    }
+    if (const std::string* secret = dict->FindString("secret")) {
+      account.secret = *secret;
+      std::string encrypted;
+      if (encryptor_ && base::Base64Decode(*secret, &encrypted) &&
+          !encryptor_->DecryptString(encrypted, &account.password)) {
+        account.password.clear();
+      }
+    }
+    accounts.push_back(std::move(account));
+  }
+  return accounts;
+}
+
+bool ThoronMailCenter::KeepGoogleAccounts(
+    const std::vector<GoogleAccount>& accounts) {
+  if (!encryptor_) {
+    return false;
+  }
+  base::ListValue kept;
+  for (const GoogleAccount& account : accounts) {
+    base::DictValue entry =
+        base::DictValue().Set("email", account.email).Set("alias", account.alias);
+    if (!account.password.empty()) {
+      std::string encrypted;
+      if (!encryptor_->EncryptString(account.password, &encrypted)) {
+        return false;
+      }
+      entry.Set("secret", base::Base64Encode(encrypted));
+    } else if (!account.secret.empty()) {
+      // a password that could not be read now is kept as it is
+      entry.Set("secret", account.secret);
+    }
+    kept.Append(std::move(entry));
+  }
+  profile_->GetPrefs()->SetList(kGoogleAccountsPref, std::move(kept));
+  return true;
+}
+
+int ThoronMailCenter::MergeGoogleAccounts(std::vector<GoogleAccount> given) {
+  if (!encryptor_) {
+    return -1;
+  }
+  std::vector<GoogleAccount> accounts = KeptGoogleAccounts();
+  int taken = 0;
+  for (GoogleAccount& account : given) {
+    account.email = std::string(
+        base::TrimWhitespaceASCII(account.email, base::TRIM_ALL));
+    if (!IsAddress(account.email) || account.password.size() > 1024 ||
+        account.alias.size() > 200 || !base::IsStringUTF8(account.alias)) {
+      continue;
+    }
+    account.secret.clear();
+    const std::string name = thoron_mail::CanonicalAddress(account.email);
+    auto known = std::ranges::find_if(accounts, [&](const GoogleAccount& other) {
+      return thoron_mail::CanonicalAddress(other.email) == name;
+    });
+    if (known != accounts.end()) {
+      if (!account.alias.empty()) {
+        known->alias = account.alias;
+      }
+      if (!account.password.empty()) {
+        known->password = account.password;
+      }
+    } else if (accounts.size() < kMostGoogleAccounts) {
+      accounts.push_back(std::move(account));
+    } else {
+      continue;
+    }
+    ++taken;
+  }
+  return KeepGoogleAccounts(accounts) ? taken : -1;
+}
+
+ThoronMailCenter::GoogleImported ThoronMailCenter::ImportGoogleAccounts(
+    std::vector<GoogleAccount> given) {
+  GoogleImported done;
+  if (!encryptor_) {
+    done.error = "locked";
+    return done;
+  }
+  // An app password opens the mailbox itself, whether or not Thoron is signed
+  // in to the account at Google: such an account is a mailbox as well. It
+  // stays in the list, so it is not lost when the mail server does not take
+  // the password after all.
+  std::vector<thoron_mail::ImapAccount> mailboxes = service_->imap_accounts();
+  std::vector<GoogleAccount> listed;
+  for (GoogleAccount& account : given) {
+    listed.push_back(account);
+    if (!LooksLikeAppPassword(account.password)) {
+      continue;
+    }
+    const std::string name = thoron_mail::CanonicalAddress(account.email);
+    if (std::ranges::any_of(mailboxes,
+                            [&](const thoron_mail::ImapAccount& other) {
+                              return thoron_mail::CanonicalAddress(
+                                         other.email) == name;
+                            }) ||
+        mailboxes.size() >= thoron_mail::MailService::kMostImapAccounts) {
+      continue;
+    }
+    thoron_mail::ImapAccount mailbox;
+    mailbox.email = account.email;
+    mailbox.host = "imap.gmail.com";
+    mailbox.user = account.email;
+    base::RemoveChars(account.password, " ", &mailbox.password);
+    mailbox.webmail = "https://mail.google.com/mail/";
+    if (std::optional<thoron_mail::ImapAccount> checked =
+            CheckedAccount(std::move(mailbox))) {
+      mailboxes.push_back(std::move(*checked));
+      ++done.mailboxes;
+    }
+  }
+  done.google = MergeGoogleAccounts(std::move(listed));
+  if (done.google < 0 || (done.mailboxes > 0 && !KeepImapAccounts(mailboxes))) {
+    done.error = "locked";
+    done.google = std::max(done.google, 0);
+  }
+  return done;
+}
+
+void ThoronMailCenter::RemoveGoogleAccount(const std::string& email) {
+  if (!encryptor_) {
+    return;
+  }
+  std::vector<GoogleAccount> accounts = KeptGoogleAccounts();
+  const size_t before = accounts.size();
+  std::erase_if(accounts, [&](const GoogleAccount& account) {
+    return account.email == email;
+  });
+  if (accounts.size() != before) {
+    KeepGoogleAccounts(accounts);
+  }
+}
+
+std::string ThoronMailCenter::EditGoogleAccount(const std::string& before,
+                                                GoogleAccount account) {
+  if (!encryptor_) {
+    return "locked";
+  }
+  std::vector<GoogleAccount> accounts = KeptGoogleAccounts();
+  const auto at = std::ranges::find_if(
+      accounts, [&](const GoogleAccount& kept) { return kept.email == before; });
+  if (at == accounts.end()) {
+    return "missing";
+  }
+  account.email =
+      std::string(base::TrimWhitespaceASCII(account.email, base::TRIM_ALL));
+  account.alias =
+      std::string(base::TrimWhitespaceASCII(account.alias, base::TRIM_ALL));
+  if (!IsAddress(account.email) || account.password.size() > 1024 ||
+      account.alias.size() > 200 || !base::IsStringUTF8(account.alias) ||
+      !base::IsStringUTF8(account.password)) {
+    return "bad";
+  }
+  const std::string old_name = thoron_mail::CanonicalAddress(before);
+  const std::string new_name = thoron_mail::CanonicalAddress(account.email);
+  if (std::ranges::any_of(accounts, [&](const GoogleAccount& other) {
+        return other.email != before &&
+               thoron_mail::CanonicalAddress(other.email) == new_name;
+      })) {
+    return "exists";
+  }
+  const bool new_password = !account.password.empty();
+  at->email = account.email;
+  at->alias = account.alias;
+  if (new_password) {
+    at->password = account.password;
+    at->secret.clear();
+  }
+  // The mailbox of the account, when an app password reads its mail, follows
+  // the change; a new app password makes one.
+  std::vector<thoron_mail::ImapAccount> mailboxes = service_->imap_accounts();
+  const auto box = std::ranges::find_if(
+      mailboxes, [&](const thoron_mail::ImapAccount& kept) {
+        return thoron_mail::CanonicalAddress(kept.email) == old_name &&
+               kept.host == "imap.gmail.com";
+      });
+  std::string app_password;
+  if (new_password && LooksLikeAppPassword(account.password)) {
+    base::RemoveChars(account.password, " ", &app_password);
+  }
+  bool boxes_changed = false;
+  std::string box_before;
+  if (box != mailboxes.end()) {
+    if (std::ranges::any_of(mailboxes,
+                            [&](const thoron_mail::ImapAccount& other) {
+                              return &other != &*box &&
+                                     thoron_mail::CanonicalAddress(
+                                         other.email) == new_name;
+                            })) {
+      return "exists";
+    }
+    box_before = box->email;
+    if (box->email != account.email) {
+      if (box->user == box->email) {
+        box->user = account.email;
+      }
+      box->email = account.email;
+      boxes_changed = true;
+    }
+    if (!app_password.empty() && box->password != app_password) {
+      box->password = app_password;
+      boxes_changed = true;
+    }
+  } else if (!app_password.empty() &&
+             mailboxes.size() < thoron_mail::MailService::kMostImapAccounts &&
+             std::ranges::none_of(mailboxes,
+                                  [&](const thoron_mail::ImapAccount& other) {
+                                    return thoron_mail::CanonicalAddress(
+                                               other.email) == new_name;
+                                  })) {
+    thoron_mail::ImapAccount mailbox;
+    mailbox.email = account.email;
+    mailbox.host = "imap.gmail.com";
+    mailbox.user = account.email;
+    mailbox.password = app_password;
+    mailbox.webmail = "https://mail.google.com/mail/";
+    if (std::optional<thoron_mail::ImapAccount> checked =
+            CheckedAccount(std::move(mailbox))) {
+      mailboxes.push_back(std::move(*checked));
+      boxes_changed = true;
+    }
+  }
+  if (!KeepGoogleAccounts(accounts) ||
+      (boxes_changed && !KeepImapAccounts(mailboxes))) {
+    return "locked";
+  }
+  service_->Renamed(before, account.email);
+  if (!box_before.empty() && box_before != before) {
+    service_->Renamed(box_before, account.email);
+  }
+  return std::string();
+}
+
+void ThoronMailCenter::SignInGoogle(const std::string& email) {
+  // only for an address of the list: a page cannot have any address opened
+  const std::vector<GoogleAccount> accounts = KeptGoogleAccounts();
+  if (std::ranges::none_of(accounts, [&](const GoogleAccount& account) {
+        return account.email == email;
+      })) {
+    return;
+  }
+  const GURL url = net::AppendQueryParameter(
+      GURL("https://accounts.google.com/AddSession?service=mail&continue="
+           "https%3A%2F%2Fmail.google.com%2Fmail%2F"),
+      "Email", email);
+  NavigateParams params(profile_, url, ui::PAGE_TRANSITION_LINK);
+  params.disposition = WindowOpenDisposition::kNewForegroundTab;
+  params.window_action = NavigateParams::WindowAction::kShowWindow;
+  Navigate(&params);
+}
+
+bool ThoronMailCenter::CopyGooglePassword(const std::string& email) {
+  for (const GoogleAccount& account : KeptGoogleAccounts()) {
+    if (account.email == email && !account.password.empty()) {
+      ui::ScopedClipboardWriter writer(ui::ClipboardBuffer::kCopyPaste);
+      writer.WriteText(base::UTF8ToUTF16(account.password));
+      // not kept in the clipboard's history or sent to other devices
+      writer.MarkAsConfidential();
+      return true;
+    }
+  }
+  return false;
+}
+
+void ThoronMailCenter::OpenPage(const GURL& url) {
+  if (!url.is_valid() || !url.SchemeIs(url::kHttpsScheme)) {
+    return;
+  }
+  BrowserWindowInterface* found = nullptr;
+  int tab = -1;
+  if (service_->Choice("open") != "new") {
+    ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+        [&](BrowserWindowInterface* browser) {
+          if (browser->GetProfile() != profile_) {
+            return true;
+          }
+          TabStripModel* tabs = browser->GetTabStripModel();
+          for (int i = 0; i < tabs->count(); ++i) {
+            if (tabs->GetWebContentsAt(i)->GetLastCommittedURL().host() ==
+                url.host()) {
+              found = browser;
+              tab = i;
+              return false;
+            }
+          }
+          return true;
+        });
+  }
+  if (found) {
+    found->GetTabStripModel()->ActivateTabAt(tab);
+    found->GetWindow()->Activate();
+    return;
+  }
+  NavigateParams params(profile_, url, ui::PAGE_TRANSITION_LINK);
+  params.disposition = WindowOpenDisposition::kNewForegroundTab;
+  params.window_action = NavigateParams::WindowAction::kShowWindow;
+  Navigate(&params);
+}
+
+void ThoronMailCenter::OpenAccount(int index) {
+  for (const thoron_mail::MailAccount& account : service_->accounts()) {
+    if (account.index != index) {
+      continue;
+    }
+    if (!account.imap) {
+      // marks it looked at, too
+      OpenGmail(thoron_mail::MailService::InboxUrl(index), index);
+      return;
+    }
+    const std::string email = account.email;
+    const GURL webmail(account.webmail);
+    service_->MarkLooked(email);
+    OpenPage(webmail);
+    return;
+  }
+}
+
+void ThoronMailCenter::OpenManagePage(bool add) {
+  NavigateParams params(profile_,
+                        GURL(std::string(kThoronMailMenuUrl) +
+                             (add ? "#manage-add" : "#manage")),
+                        ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+  params.disposition = WindowOpenDisposition::kSingletonTab;
+  // P5.82: a page that is open already is brought forward at the part asked
+  // for (its settings, or the form to add a mailbox), not left where it was
+  params.path_behavior = NavigateParams::IGNORE_AND_NAVIGATE;
+  params.window_action = NavigateParams::WindowAction::kShowWindow;
+  Navigate(&params);
+}
+
+base::DictValue ThoronMailCenter::BackupDict(bool with_passwords) const {
+  base::DictValue choices;
+  for (const char* name : {"sound", "count", "open", "messages", "which",
+                           "place", "toolbar-position", "address-position"}) {
+    choices.Set(name, service_->Choice(name));
+  }
+  base::ListValue accounts;
+  for (const thoron_mail::ImapAccount& account : service_->imap_accounts()) {
+    base::DictValue entry = base::DictValue()
+                                .Set("email", account.email)
+                                .Set("host", account.host)
+                                .Set("port", account.port)
+                                .Set("user", account.user)
+                                .Set("webmail", account.webmail);
+    if (with_passwords) {
+      entry.Set("password", account.password);
+    }
+    // Proton Mail Bridge: the pin of its certificate (not a secret)
+    if (!account.pin.empty()) {
+      entry.Set("pin", account.pin);
+    }
+    accounts.Append(std::move(entry));
+  }
+  // P5.80: the Google accounts of the person's list
+  base::ListValue google;
+  for (const GoogleAccount& account : KeptGoogleAccounts()) {
+    base::DictValue entry =
+        base::DictValue().Set("email", account.email).Set("alias", account.alias);
+    if (with_passwords && !account.password.empty()) {
+      entry.Set("password", account.password);
+    }
+    google.Append(std::move(entry));
+  }
+  PrefService* prefs = profile_->GetPrefs();
+  // P5.81: the order the person put the accounts in
+  base::ListValue order;
+  for (const std::string& name : service_->Order()) {
+    order.Append(name);
+  }
+  return base::DictValue()
+      .Set("format", thoron_mail::kBackupFormat)
+      .Set("version", 1)
+      .Set("sealed", false)
+      .Set("settings",
+           base::DictValue()
+               .Set("notify", service_->notify())
+               .Set("interval", service_->interval_minutes())
+               .Set("choices", std::move(choices))
+               .Set("ignored", prefs->GetList("thoron_mail.ignored").Clone())
+               .Set("order", prefs->GetString("thoron.toolbar_order"))
+               .Set("accountOrder", std::move(order))
+               .Set("sound", [&] {
+                 // P5.82: the sound, the quiet rules, each account's own
+                 const SoundSettings sound = sound_settings();
+                 return base::DictValue()
+                     .Set("name", sound.name)
+                     .Set("volume", sound.volume)
+                     .Set("quietFullscreen", sound.quiet_fullscreen)
+                     .Set("quietInFront", sound.quiet_in_front)
+                     .Set("quietFrom", sound.quiet_from)
+                     .Set("quietTo", sound.quiet_to)
+                     .Set("accounts", AccountSounds());
+               }()))
+      .Set("accounts", std::move(accounts))
+      .Set("google", std::move(google));
+}
+
+void ThoronMailCenter::ExportBackup(bool with_passwords,
+                                    std::string passphrase,
+                                    Exported done) {
+  const bool seal = !passphrase.empty();
+  std::string backup =
+      base::WriteJsonWithOptions(BackupDict(with_passwords || seal),
+                                 base::JSONWriter::OPTIONS_PRETTY_PRINT)
+          .value_or(std::string());
+  if (!seal) {
+    std::move(done).Run(std::move(backup));
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&Sealed, std::move(backup), std::move(passphrase)),
+      std::move(done));
+}
+
+void ThoronMailCenter::ImportBackup(std::string file,
+                                    std::string passphrase,
+                                    Imported done) {
+  if (file.empty() || file.size() > kMostBackupBytes) {
+    std::move(done).Run("bad", 0);
+    return;
+  }
+  if (!thoron_mail::IsSealedBackup(file)) {
+    ApplyBackup(std::move(done), std::move(file));
+    return;
+  }
+  if (passphrase.empty()) {
+    std::move(done).Run("passphrase", 0);
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&Opened, std::move(file), std::move(passphrase)),
+      base::BindOnce(&ThoronMailCenter::ApplyBackup, weak_factory_.GetWeakPtr(),
+                     std::move(done)));
+}
+
+void ThoronMailCenter::ApplyBackup(Imported done,
+                                   std::optional<std::string> backup) {
+  if (!backup) {
+    std::move(done).Run("wrong", 0);
+    return;
+  }
+  std::optional<base::DictValue> dict =
+      base::JSONReader::ReadDict(*backup, base::JSON_PARSE_RFC);
+  const std::string* format = dict ? dict->FindString("format") : nullptr;
+  if (!format || *format != thoron_mail::kBackupFormat ||
+      dict->FindBool("sealed").value_or(false) ||
+      dict->FindInt("version").value_or(0) != 1) {
+    std::move(done).Run("bad", 0);
+    return;
+  }
+  if (!encryptor_) {
+    std::move(done).Run("locked", 0);
+    return;
+  }
+  // The settings: only what the M-Notifier knows, each checked as when a
+  // person sets it.
+  PrefService* prefs = profile_->GetPrefs();
+  if (const base::DictValue* settings = dict->FindDict("settings")) {
+    if (std::optional<bool> notify = settings->FindBool("notify")) {
+      service_->SetNotify(*notify);
+    }
+    if (std::optional<int> interval = settings->FindInt("interval")) {
+      service_->SetInterval(*interval);
+    }
+    if (const base::DictValue* choices = settings->FindDict("choices")) {
+      for (const auto [name, value] : *choices) {
+        if (value.is_string()) {
+          service_->SetChoice(name, value.GetString());
+        }
+      }
+    }
+    if (const base::ListValue* ignored = settings->FindList("ignored")) {
+      base::ListValue kept;
+      for (const base::Value& value : *ignored) {
+        if (value.is_string() && IsAddress(value.GetString()) &&
+            kept.size() < 50) {
+          kept.Append(value.GetString());
+        }
+      }
+      prefs->SetList("thoron_mail.ignored", std::move(kept));
+    }
+    if (const std::string* order = settings->FindString("order");
+        order && (*order == "mail,adblock" || *order == "adblock,mail")) {
+      prefs->SetString("thoron.toolbar_order", *order);
+    }
+    if (const base::ListValue* order = settings->FindList("accountOrder")) {
+      std::vector<std::string> emails;
+      for (const base::Value& value : *order) {
+        if (value.is_string() && IsAddress(value.GetString())) {
+          emails.push_back(value.GetString());
+        }
+      }
+      service_->SetOrder(emails);
+    }
+    // P5.82: each value checked as when the person sets it
+    if (const base::DictValue* sound = settings->FindDict("sound")) {
+      if (const std::string* name = sound->FindString("name")) {
+        SetSoundName(*name);
+      }
+      if (std::optional<int> volume = sound->FindInt("volume")) {
+        SetSoundVolume(*volume);
+      }
+      const SoundSettings now = sound_settings();
+      SetQuiet(sound->FindBool("quietFullscreen").value_or(now.quiet_fullscreen),
+               sound->FindBool("quietInFront").value_or(now.quiet_in_front),
+               sound->FindInt("quietFrom").value_or(now.quiet_from),
+               sound->FindInt("quietTo").value_or(now.quiet_to));
+      if (const base::DictValue* own = sound->FindDict("accounts")) {
+        for (const auto [email, value] : *own) {
+          if (value.is_string()) {
+            SetAccountSound(email, value.GetString());
+          }
+        }
+      }
+    }
+  }
+  // P5.80: the Google accounts of the person's list. One the backup names
+  // without its password keeps the password it has here.
+  if (const base::ListValue* list = dict->FindList("google")) {
+    std::vector<GoogleAccount> google;
+    for (const base::Value& value : *list) {
+      const base::DictValue* entry = value.GetIfDict();
+      const std::string* email = entry ? entry->FindString("email") : nullptr;
+      if (!email) {
+        continue;
+      }
+      GoogleAccount account;
+      account.email = *email;
+      if (const std::string* alias = entry->FindString("alias")) {
+        account.alias = *alias;
+      }
+      if (const std::string* password = entry->FindString("password")) {
+        account.password = *password;
+      }
+      google.push_back(std::move(account));
+    }
+    MergeGoogleAccounts(std::move(google));
+  }
+  // The mailboxes: those of the backup, then those there were that it does
+  // not name. One the backup names without its password keeps the password
+  // it has here, or is left out.
+  std::vector<thoron_mail::ImapAccount> accounts;
+  const std::vector<thoron_mail::ImapAccount> known = service_->imap_accounts();
+  auto has = [&accounts](const std::string& email) {
+    return std::ranges::any_of(accounts,
+                               [&](const thoron_mail::ImapAccount& account) {
+                                 return account.email == email;
+                               });
+  };
+  if (const base::ListValue* list = dict->FindList("accounts")) {
+    for (const base::Value& value : *list) {
+      const base::DictValue* entry = value.GetIfDict();
+      const std::string* email = entry ? entry->FindString("email") : nullptr;
+      const std::string* host = entry ? entry->FindString("host") : nullptr;
+      if (!email || !host ||
+          accounts.size() >= thoron_mail::MailService::kMostImapAccounts) {
+        continue;
+      }
+      thoron_mail::ImapAccount account;
+      account.email = *email;
+      account.host = *host;
+      account.port = entry->FindInt("port").value_or(993);
+      if (const std::string* user = entry->FindString("user")) {
+        account.user = *user;
+      }
+      if (const std::string* webmail = entry->FindString("webmail")) {
+        account.webmail = *webmail;
+      }
+      if (const std::string* pin = entry->FindString("pin")) {
+        account.pin = *pin;
+      }
+      if (const std::string* password = entry->FindString("password")) {
+        account.password = *password;
+      } else {
+        for (const thoron_mail::ImapAccount& old : known) {
+          if (old.email == *email) {
+            account.password = old.password;
+          }
+        }
+      }
+      // Proton Mail Bridge: a backup without the pin keeps the one it has here
+      for (const thoron_mail::ImapAccount& old : known) {
+        if (account.pin.empty() && old.email == *email &&
+            old.host == account.host && old.port == account.port) {
+          account.pin = old.pin;
+        }
+      }
+      std::optional<thoron_mail::ImapAccount> checked =
+          CheckedAccount(std::move(account));
+      if (checked && !has(checked->email)) {
+        accounts.push_back(std::move(*checked));
+      }
+    }
+  }
+  for (const thoron_mail::ImapAccount& old : known) {
+    if (!has(old.email) &&
+        accounts.size() < thoron_mail::MailService::kMostImapAccounts) {
+      accounts.push_back(old);
+    }
+  }
+  if (!KeepImapAccounts(accounts)) {
+    std::move(done).Run("locked", 0);
+    return;
+  }
+  std::move(done).Run(std::string(), static_cast<int>(accounts.size()));
+}
+
+namespace {
+
+// P5.82: the sound settings of the profile.
+constexpr char kSoundNamePref[] = "thoron_mail.sound_name";
+constexpr char kSoundVolumePref[] = "thoron_mail.sound_volume";
+constexpr char kQuietFullscreenPref[] = "thoron_mail.quiet_fullscreen";
+constexpr char kQuietInFrontPref[] = "thoron_mail.quiet_in_front";
+constexpr char kQuietFromPref[] = "thoron_mail.quiet_from";
+constexpr char kQuietToPref[] = "thoron_mail.quiet_to";
+constexpr char kAccountSoundsPref[] = "thoron_mail.account_sounds";
+constexpr size_t kMostAccountSounds = 60;
+
+bool ForOfflineChecks() {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(
+      "thoron-mail-feeds-for-testing");
+}
+
+int MinuteOrOff(int minute) {
+  return minute >= 0 && minute < 24 * 60 ? minute : -1;
+}
+
+}  // namespace
+
+ThoronMailCenter::SoundSettings ThoronMailCenter::sound_settings() const {
+  const PrefService* prefs = profile_->GetPrefs();
+  SoundSettings settings;
+  settings.name = prefs->GetString(kSoundNamePref);
+  if (!thoron_mail::IsKnownSound(settings.name)) {
+    settings.name = thoron_mail::kSystemSound;
+  }
+  settings.volume = std::clamp(prefs->GetInteger(kSoundVolumePref), 0, 100);
+  settings.quiet_fullscreen = prefs->GetBoolean(kQuietFullscreenPref);
+  settings.quiet_in_front = prefs->GetBoolean(kQuietInFrontPref);
+  settings.quiet_from = MinuteOrOff(prefs->GetInteger(kQuietFromPref));
+  settings.quiet_to = MinuteOrOff(prefs->GetInteger(kQuietToPref));
+  return settings;
+}
+
+void ThoronMailCenter::SetSoundName(const std::string& name) {
+  if (thoron_mail::IsKnownSound(name)) {
+    profile_->GetPrefs()->SetString(kSoundNamePref, name);
+  }
+}
+
+void ThoronMailCenter::SetSoundVolume(int volume) {
+  profile_->GetPrefs()->SetInteger(kSoundVolumePref, std::clamp(volume, 0, 100));
+}
+
+void ThoronMailCenter::SetQuiet(bool fullscreen, bool in_front, int from, int to) {
+  PrefService* prefs = profile_->GetPrefs();
+  prefs->SetBoolean(kQuietFullscreenPref, fullscreen);
+  prefs->SetBoolean(kQuietInFrontPref, in_front);
+  from = MinuteOrOff(from);
+  to = MinuteOrOff(to);
+  // both, or no quiet hours
+  if (from < 0 || to < 0 || from == to) {
+    from = to = -1;
+  }
+  prefs->SetInteger(kQuietFromPref, from);
+  prefs->SetInteger(kQuietToPref, to);
+}
+
+std::string ThoronMailCenter::AccountSound(const std::string& email) const {
+  const std::string* name = profile_->GetPrefs()
+                                ->GetDict(kAccountSoundsPref)
+                                .FindString(thoron_mail::CanonicalAddress(email));
+  return name && (*name == "off" || thoron_mail::IsKnownSound(*name))
+             ? *name
+             : std::string();
+}
+
+void ThoronMailCenter::SetAccountSound(const std::string& email,
+                                       const std::string& name) {
+  if (!IsAddress(email) ||
+      !(name.empty() || name == "off" || thoron_mail::IsKnownSound(name))) {
+    return;
+  }
+  base::DictValue sounds =
+      profile_->GetPrefs()->GetDict(kAccountSoundsPref).Clone();
+  const std::string key = thoron_mail::CanonicalAddress(email);
+  if (name.empty()) {
+    sounds.Remove(key);
+  } else if (sounds.contains(key) || sounds.size() < kMostAccountSounds) {
+    sounds.Set(key, name);
+  }
+  profile_->GetPrefs()->SetDict(kAccountSoundsPref, std::move(sounds));
+}
+
+base::DictValue ThoronMailCenter::AccountSounds() const {
+  base::DictValue out;
+  for (const auto [key, value] :
+       profile_->GetPrefs()->GetDict(kAccountSoundsPref)) {
+    if (value.is_string() &&
+        (value.GetString() == "off" || thoron_mail::IsKnownSound(value.GetString()))) {
+      out.Set(key, value.GetString());
+    }
+  }
+  return out;
+}
+
+void ThoronMailCenter::PreviewSound(const std::string& name, int volume) {
+  if (thoron_mail::IsKnownSound(name)) {
+    PlayMailSound(name, std::clamp(volume, 0, 100));
+  }
+}
+
+bool ThoronMailCenter::InFront(const thoron_mail::MailAccount& account) const {
+  bool in_front = false;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* browser) {
+        // only the window the person uses last, when it is the active one
+        if (browser->GetProfile() != profile_) {
+          return true;
+        }
+        if (!browser->GetWindow() || !browser->GetWindow()->IsActive()) {
+          return false;
+        }
+        content::WebContents* tab =
+            browser->GetTabStripModel()->GetActiveWebContents();
+        const GURL url = tab ? tab->GetLastCommittedURL() : GURL();
+        if (account.imap) {
+          const GURL webmail(account.webmail);
+          in_front = webmail.is_valid() && url.host() == webmail.host();
+        } else {
+          const std::string inbox =
+              "/mail/u/" + base::NumberToString(account.index);
+          in_front = url.host() == "mail.google.com" &&
+                     (url.path() == inbox ||
+                      base::StartsWith(url.path(), inbox + "/") ||
+                      (account.index == 0 && url.path() == "/mail/"));
+        }
+        return false;
+      });
+  return in_front;
+}
+
+std::string ThoronMailCenter::QuietReason(
+    const thoron_mail::MailAccount& account) const {
+  if (AccountSound(account.email) == "off") {
+    return "account";
+  }
+  const SoundSettings settings = sound_settings();
+  if (settings.quiet_from >= 0 && settings.quiet_to >= 0) {
+    base::Time::Exploded now;
+    base::Time::Now().LocalExplode(&now);
+    const int minute = now.hour * 60 + now.minute;
+    // hours that go past midnight (22:00 to 07:00) as well as those that do not
+    const bool inside =
+        settings.quiet_from < settings.quiet_to
+            ? minute >= settings.quiet_from && minute < settings.quiet_to
+            : minute >= settings.quiet_from || minute < settings.quiet_to;
+    if (inside) {
+      return "hours";
+    }
+  }
+  if (settings.quiet_in_front && InFront(account)) {
+    return "front";
+  }
+#if BUILDFLAG(IS_WIN)
+  // Windows' own word: a full-screen program, a game (Direct3D full screen),
+  // a presentation, or an app in full screen. The offline checks run beside
+  // whatever the PC shows, so they do not ask.
+  QUERY_USER_NOTIFICATION_STATE state = QUNS_ACCEPTS_NOTIFICATIONS;
+  if (settings.quiet_fullscreen && !ForOfflineChecks() &&
+      SUCCEEDED(::SHQueryUserNotificationState(&state)) &&
+      (state == QUNS_BUSY || state == QUNS_RUNNING_D3D_FULL_SCREEN ||
+       state == QUNS_PRESENTATION_MODE || state == QUNS_APP)) {
+    return "fullscreen";
+  }
+#endif
+  return std::string();
+}
+
+void ThoronMailCenter::PlayMailSound(const std::string& name, int volume) {
+  last_sound_ = name;
+  // The offline checks (a local server stands in for Gmail) count the sound
+  // and do not make it.
+  if (ForOfflineChecks()) {
+    return;
+  }
+#if BUILDFLAG(IS_WIN)
+  std::string wav = name == thoron_mail::kSystemSound
+                        ? std::string()
+                        : thoron_mail::MakeSoundWav(name, volume);
+  if (wav.empty()) {
+    // Windows' own sound for new mail (the person's sound scheme), else its
+    // plain notice sound. Not waited for.
+    if (!::PlaySoundW(L"MailBeep", nullptr,
+                      SND_ALIAS | SND_ASYNC | SND_NODEFAULT)) {
+      ::MessageBeep(MB_ICONASTERISK);
+    }
+    return;
+  }
+  // Windows reads a sound from memory while it plays: the one playing is
+  // stopped before its memory is given to the next.
+  ::PlaySoundW(nullptr, nullptr, 0);
+  playing_ = std::move(wav);
+  ::PlaySoundW(reinterpret_cast<LPCWSTR>(playing_.data()), nullptr,
+               SND_MEMORY | SND_ASYNC | SND_NODEFAULT);
+#endif
+}
