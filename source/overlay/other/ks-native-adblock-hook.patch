+// The menu of Thoron's mail notifier, opened from its envelope in the toolbar.
+inline constexpr char kThoronMailMenuHost[] = "mail-notifier.top-chrome";
+inline constexpr char kThoronMailMenuUrl[] = "chrome://mail-notifier.top-chrome/";
+
+// One per profile (P5.75): its mail service (thoron_mail::MailService), the
+// notices of new mail, and opening Gmail where it is already open.
+class ThoronMailCenter : public base::SupportsUserData::Data,
+                         public thoron_mail::MailService::Observer {
+ public:
+  // Made the first time it is asked for, and started.
+  static ThoronMailCenter& For(Profile* profile);
+
+  explicit ThoronMailCenter(Profile* profile);
+  ThoronMailCenter(const ThoronMailCenter&) = delete;
+  ThoronMailCenter& operator=(const ThoronMailCenter&) = delete;
+  ~ThoronMailCenter() override;
+
+  thoron_mail::MailService& service() { return *service_; }
+  // How often new mail made a sound and a notice since the browser started
+  // (for the offline checks, which cannot hear or see them).
+  int sounds_played() const { return sounds_played_; }
+  int notices_shown() const { return notices_shown_; }
+
+  // Opens `url` (Gmail's own, else nothing) in a window of the profile: in
+  // the tab that shows account `index` when there is one, else a new tab.
+  void OpenGmail(const GURL& url, int index);
+  // Opens Google's page to sign in, or to add an account, in a new tab.
+  void OpenSignIn(bool add);
+
+  // P5.77: the mailboxes a person adds with their address and password.
+  // The password is kept in the profile encrypted by the system (as the
+  // browser keeps its own passwords), and is never given back to a page.
+  //
+  // Adds `account` after signing in to it once: `told` gets "" when it was
+  // added, else why not ("sign-in", "offline", "protocol", "too-much", "bad":
+  // not a mailbox's details, "exists", "full", "busy", "locked": the
+  // system's encryption is not there).
+  using Told = base::OnceCallback<void(std::string)>;
+  void AddImapAccount(thoron_mail::ImapAccount account, Told told);
+  void RemoveImapAccount(const std::string& email);
+  // True once passwords can be kept (the system's encryption is there).
+  bool can_keep_passwords() const { return !!encryptor_; }
+
+  // Opens the account of `index`: Gmail's inbox of a Google account, the mail
+  // page of a mailbox (when it has one). Its new mail is counted from now.
+  void OpenAccount(int index);
+  // Opens the M-Notifier's own page in a tab: accounts, settings, backup;
+  // with `add`, its form for a mailbox by address and password.
+  void OpenManagePage(bool add);
+
+  // A backup of the mailboxes and the settings as a file's text (JSON). With
+  // a `passphrase` it is sealed with it and holds the passwords; without one
+  // it holds them only `with_passwords`.
+  using Exported = base::OnceCallback<void(std::string)>;
+  void ExportBackup(bool with_passwords, std::string passphrase, Exported done);
+  // Reads a backup: `done` gets "" and how many mailboxes it holds now, else
+  // why not ("passphrase": it is sealed and none was given; "wrong": it does
+  // not open; "bad": not a backup; "locked").
+  using Imported = base::OnceCallback<void(std::string, int)>;
+  void ImportBackup(std::string file, std::string passphrase, Imported done);
+
+  // thoron_mail::MailService::Observer:
+  void OnNewMail(const thoron_mail::MailAccount& account,
+                 const std::vector<thoron_mail::MailMessage>& messages) override;
+
+ private:
+  // The sound of new mail (P5.78): the M-Notifier's own, so it is heard
+  // with or without a notice.
+  void PlayNewMailSound();
+
+  void OnEncryptor(scoped_refptr<os_crypt_async::Encryptor> encryptor);
+  // The mailboxes kept in the profile, their passwords decrypted.
+  std::vector<thoron_mail::ImapAccount> KeptImapAccounts() const;
+  // Keeps `accounts` in the profile and looks at them.
+  bool KeepImapAccounts(const std::vector<thoron_mail::ImapAccount>& accounts);
+  void OnImapTested(thoron_mail::ImapAccount account,
+                    Told told,
+                    thoron_mail::ImapCheck::Result result);
+  // A backup as a dictionary (ExportBackup), and one taken in (ImportBackup).
+  base::DictValue BackupDict(bool with_passwords) const;
+  void ApplyBackup(Imported done, std::optional<std::string> backup);
+  // Opens `url` in a tab of the profile: the tab that is on that site when
+  // one is open (unless the person wants a new tab), else a new one.
+  void OpenPage(const GURL& url);
+
+  const raw_ptr<Profile> profile_;
+  std::unique_ptr<thoron_mail::MailService> service_;
+  // S.15: tells the service whether somebody is signed in to Google in the
+  // profile, and has it look again when that changes.
+  class GoogleSignIn;
+  std::unique_ptr<GoogleSignIn> google_sign_in_;
+  int sounds_played_ = 0;
+  int notices_shown_ = 0;
+  scoped_refptr<os_crypt_async::Encryptor> encryptor_;
+  // the sign-in to a mailbox that is being added
+  std::unique_ptr<thoron_mail::ImapCheck> imap_test_;
+  base::WeakPtrFactory<ThoronMailCenter> weak_factory_{this};
+};
+
+class ThoronMailMenuUI;
+
+class ThoronMailMenuUIConfig
+    : public DefaultTopChromeWebUIConfig<ThoronMailMenuUI> {
+ public:
+  ThoronMailMenuUIConfig();
+
+  // TopChromeWebUIConfig:
+  bool IsWebUIEnabled(content::BrowserContext* browser_context) override;
+  bool ShouldAutoResizeHost() override;
+};
+
+class ThoronMailMenuUI : public TopChromeWebUIController {
+ public:
+  explicit ThoronMailMenuUI(content::WebUI* web_ui);
+  ThoronMailMenuUI(const ThoronMailMenuUI&) = delete;
+  ThoronMailMenuUI& operator=(const ThoronMailMenuUI&) = delete;
+  ~ThoronMailMenuUI() override;
+
+  static constexpr std::string_view GetWebUIName() {
+    return "ThoronMailMenu";
+  }
+
+  // The page has drawn what it shows and asked to be shown, at least once.
+  bool ready() const { return ready_; }
+  void set_ready() { ready_ = true; }
+  // Shown again with its page kept: the page brings itself up to date, then
+  // asks to be shown. False when the page has not loaded yet.
+  bool TellShown();
+
+ private:
+  bool ready_ = false;
+
+  WEB_UI_CONTROLLER_TYPE_DECL();
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_THORON_MAIL_UI_H_
