+// A file: exactly url, size and sha256, the address on one of `hosts`.
+bool ReadPackageFile(const base::Value& value,
+                     const std::vector<std::string>& hosts,
+                     PackageFile& out) {
+  const base::DictValue* dict = value.GetIfDict();
+  if (!dict || dict->size() != kFileKeys) {
+    return false;
+  }
+  const std::string* url = dict->FindString("url");
+  const std::optional<int> size = dict->FindInt("size");
+  const std::string* sha256 = dict->FindString("sha256");
+  if (!url || !size || !sha256 || *size < 1 || !IsSha256(*sha256)) {
+    return false;
+  }
+  const std::string_view host = HostOfPlainUrl(*url);
+  if (host.empty() || !std::ranges::any_of(hosts, [host](const std::string& h) {
+        return h == host;
+      })) {
+    return false;
+  }
+  out.url = *url;
+  out.size = *size;
+  out.sha256 = *sha256;
+  return true;
+}
+
+// A package: `full` and, only when there are deltas, `deltas`.
+bool ReadPackage(const base::Value& value,
+                 const BuildVersion& version,
+                 const std::vector<std::string>& hosts,
+                 Package& out) {
+  const base::DictValue* dict = value.GetIfDict();
+  if (!dict) {
+    return false;
+  }
+  const base::Value* full = dict->Find("full");
+  const base::Value* deltas = dict->Find("deltas");
+  if (!full || dict->size() != (deltas ? 2u : 1u) ||
+      !ReadPackageFile(*full, hosts, out.full)) {
+    return false;
+  }
+  if (!deltas) {
+    return true;
+  }
+  const base::DictValue* bases = deltas->GetIfDict();
+  if (!bases || bases->empty() || bases->size() > kMaxDeltas) {
+    return false;
+  }
+  for (const auto [base_text, file] : *bases) {
+    // A delta applies from a release below the manifest's version; all zero
+    // stands for nothing installed and is no release.
+    const std::optional<BuildVersion> from = ParseBuildVersion(base_text);
+    if (!from || *from == BuildVersion() || *from >= version ||
+        !ReadPackageFile(file, hosts, out.deltas[*from])) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// Every rule of MANIFEST.md, section 4. Unknown keys are refused at every
+// level: a key the updater does not know is a key it cannot check.
+std::optional<Manifest> ReadManifest(const base::DictValue& dict,
+                                     const std::vector<std::string>& hosts) {
+  const std::optional<int> schema = dict.FindInt("schema");
+  const std::string* channel = dict.FindString("channel");
+  const std::optional<int> serial = dict.FindInt("serial");
+  const std::string* published_text = dict.FindString("published");
+  const std::string* expires_text = dict.FindString("expires");
+  const std::string* version_text = dict.FindString("version");
+  const std::string* thoron_version = dict.FindString("thoron_version");
+  const std::string* chromium_text = dict.FindString("chromium_version");
+  const std::optional<bool> critical = dict.FindBool("critical");
+  const std::string* updater_text = dict.FindString("min_updater_version");
+  const base::DictValue* variants = dict.FindDict("packages");
+  if (dict.size() != kTopLevelKeys || !schema || !channel || !serial ||
+      !published_text || !expires_text || !version_text || !thoron_version ||
+      !chromium_text || !critical || !updater_text || !variants) {
+    return std::nullopt;
+  }
+  if (*schema != 1 || !IsChannel(*channel) ||
+      !IsThoronVersion(*thoron_version)) {
+    return std::nullopt;
+  }
+
+  const std::optional<BuildVersion> version = ParseBuildVersion(*version_text);
+  const std::optional<BuildVersion> chromium =
+      ParseBuildVersion(*chromium_text);
+  const std::optional<BuildVersion> updater = ParseBuildVersion(*updater_text);
+  if (!version || !chromium || !updater || *version == BuildVersion() ||
+      *updater > *version) {
+    return std::nullopt;
+  }
+  // The Chromium version is the build version with its last number divided
+  // by 100, so the two cannot drift apart.
+  BuildVersion expected_chromium = *version;
+  expected_chromium.parts[3] =
+      static_cast<uint16_t>(version->parts[3] / kRebuildsPerChromiumPatch);
+  if (*chromium != expected_chromium) {
+    return std::nullopt;
+  }
+
+  // The serial is the UTC day of `published` and a two-digit count, so it
+  // cannot run ahead of the calendar.
+  const std::optional<Moment> published = ParseTime(*published_text);
+  const std::optional<Moment> expires = ParseTime(*expires_text);
+  if (!published || !expires || expires->seconds <= published->seconds ||
+      expires->seconds - published->seconds > kMaxValidSeconds || *serial < 1 ||
+      *serial / 100 != published->day) {
+    return std::nullopt;
+  }
+
+  Manifest out;
+  out.channel = *channel;
+  out.serial = *serial;
+  out.published = published->seconds;
+  out.expires = expires->seconds;
+  out.version = *version;
+  out.thoron_version = *thoron_version;
+  out.chromium_version = *chromium;
+  out.critical = *critical;
+  out.min_updater_version = *updater;
+
+  if (variants->empty()) {
+    return std::nullopt;
+  }
+  for (const auto [variant_name, kinds_value] : *variants) {
+    const std::optional<Variant> variant = ParseVariant(variant_name);
+    const base::DictValue* kinds = kinds_value.GetIfDict();
+    if (!variant || !kinds || kinds->empty()) {
+      return std::nullopt;
+    }
+    for (const auto [kind_name, package] : *kinds) {
+      const std::optional<Kind> kind = ParseKind(kind_name);
+      if (!kind || !ReadPackage(package, *version, hosts,
+                                out.packages[{*variant, *kind}])) {
+        return std::nullopt;
+      }
+    }
+  }
+  return out;
+}
+
+bool AppendString(std::string_view text, std::string& out) {
+  if (!std::ranges::all_of(text, IsPlainChar)) {
+    return false;
+  }
+  out += '"';
+  out += text;
+  out += '"';
+  return true;
+}
+
+bool AppendValue(const base::Value& value, size_t level, std::string& out);
+
+// The one written form of MANIFEST.md, section 3: members in ascending order
+// of their keys (the order a DictValue keeps them in), each on its own line,
+// two spaces a level. A valid manifest holds no empty object.
+bool AppendDict(const base::DictValue& dict, size_t level, std::string& out) {
+  if (dict.empty()) {
+    return false;
+  }
+  out += "{\n";
+  bool first = true;
+  for (const auto [key, member] : dict) {
+    if (!first) {
+      out += ",\n";
+    }
+    first = false;
+    out.append(2 * (level + 1), ' ');
+    if (!AppendString(key, out)) {
+      return false;
+    }
+    out += ": ";
+    if (!AppendValue(member, level + 1, out)) {
+      return false;
+    }
+  }
+  out += '\n';
+  out.append(2 * level, ' ');
+  out += '}';
+  return true;
+}
+
+// False for what a manifest never holds: a list, null, a fraction, a string
+// that needs an escape.
+bool AppendValue(const base::Value& value, size_t level, std::string& out) {
+  if (value.is_bool()) {
+    out += value.GetBool() ? "true" : "false";
+    return true;
+  }
+  if (value.is_int()) {
+    out += base::NumberToString(value.GetInt());
+    return true;
+  }
+  if (value.is_string()) {
+    return AppendString(value.GetString(), out);
+  }
+  const base::DictValue* dict = value.GetIfDict();
+  return dict && AppendDict(*dict, level, out);
+}
+
+// Steps 3 to 6 of MANIFEST.md: the content of bytes whose signature holds, or
+// nothing when they are still not a manifest. One content has one byte
+// sequence: writing out what was read must give the bytes that were signed,
+// so a repeated key, another spacing or another spelling of a number is
+// refused whatever the JSON reader makes of it.
+std::optional<Manifest> ParseManifest(std::string_view bytes,
+                                      const std::vector<std::string>& hosts) {
+  if (!std::ranges::all_of(bytes, [](char c) {
+        return c == '\n' || (c >= 0x20 && c <= 0x7e);
+      })) {
+    return std::nullopt;
+  }
+  const std::optional<base::DictValue> dict =
+      base::JSONReader::ReadDict(bytes, base::JSON_PARSE_RFC);
+  if (!dict) {
+    return std::nullopt;
+  }
+  std::optional<Manifest> manifest = ReadManifest(*dict, hosts);
+  if (!manifest) {
+    return std::nullopt;
+  }
+  std::string written;
+  written.reserve(bytes.size());
+  if (!AppendDict(*dict, 0, written)) {
+    return std::nullopt;
+  }
+  written += '\n';
+  if (written != bytes) {
+    return std::nullopt;
+  }
+  return manifest;
+}
+
+bool IsKey(const std::array<uint8_t, kPublicKeyBytes>& public_key) {
+  std::array<uint8_t, kPublicKeyBytes> masked = public_key;
+  masked.back() = static_cast<uint8_t>(masked.back() & 0x7f);
+  return std::ranges::none_of(
+      kNoKeys, [&masked](const std::array<uint8_t, kPublicKeyBytes>& none) {
+        return none == masked;
+      });
+}
+
+// True only when `signature` is this key's signature of the purpose prefix
+// and exactly these bytes. BoringSSL's check is the strict one: a signature
+// whose S is not below the group order is refused.
+bool SignatureHolds(std::string_view manifest,
+                    std::string_view signature,
+                    const std::array<uint8_t, kPublicKeyBytes>& public_key) {
+  static_assert(kSignatureBytes == ED25519_SIGNATURE_LEN);
+  static_assert(kPublicKeyBytes == ED25519_PUBLIC_KEY_LEN);
+  if (signature.size() != kSignatureBytes || !IsKey(public_key)) {
+    return false;
+  }
+  std::string message(kSignaturePrefix);
+  message += manifest;
+  return ED25519_verify(reinterpret_cast<const uint8_t*>(message.data()),
+                        message.size(),
+                        reinterpret_cast<const uint8_t*>(signature.data()),
+                        public_key.data()) == 1;
+}
+
+Decision Refused(Outcome outcome) {
+  Decision decision;
+  decision.outcome = outcome;
+  return decision;
+}
+
+}  // namespace
+
+std::optional<BuildVersion> ParseBuildVersion(std::string_view text) {
+  BuildVersion version;
+  if (!ReadNumbers(text, 4, 5, 65535, version.parts)) {
+    return std::nullopt;
+  }
+  return version;
+}
+
+std::string ToString(const BuildVersion& version) {
+  std::string text;
+  for (const uint16_t part : version.parts) {
+    if (!text.empty()) {
+      text += '.';
+    }
+    text += base::NumberToString(int{part});
+  }
+  return text;
+}
+
+std::string_view VariantName(Variant variant) {
+  return kVariantNames[static_cast<size_t>(variant)];
+}
+
+std::string_view KindName(Kind kind) {
+  return kKindNames[static_cast<size_t>(kind)];
+}
+
+std::optional<Variant> ParseVariant(std::string_view name) {
+  for (size_t i = 0; i < kVariantNames.size(); ++i) {
+    if (kVariantNames[i] == name) {
+      return static_cast<Variant>(i);
+    }
+  }
+  return std::nullopt;
+}
+
+std::optional<Kind> ParseKind(std::string_view name) {
+  for (size_t i = 0; i < kKindNames.size(); ++i) {
+    if (kKindNames[i] == name) {
+      return static_cast<Kind>(i);
+    }
+  }
+  return std::nullopt;
+}
+
+std::string_view OutcomeName(Outcome outcome) {
+  switch (outcome) {
+    case Outcome::kUpdate:
+      return "update";
+    case Outcome::kUpToDate:
+      return "up_to_date";
+    case Outcome::kBadSignature:
+      return "bad_signature";
+    case Outcome::kMalformed:
+      return "malformed";
+    case Outcome::kWrongChannel:
+      return "wrong_channel";
+    case Outcome::kReplayed:
+      return "replayed";
+    case Outcome::kNotYetValid:
+      return "not_yet_valid";
+    case Outcome::kExpired:
+      return "expired";
+    case Outcome::kDowngrade:
+      return "downgrade";
+    case Outcome::kUpdaterTooOld:
+      return "updater_too_old";
+    case Outcome::kNoPackage:
+      return "no_package";
+    case Outcome::kInvalidCopy:
+      return "invalid_copy";
+  }
+  return "invalid_copy";
+}
+
+bool CannotVerify(Outcome outcome) {
+  switch (outcome) {
+    case Outcome::kBadSignature:
+    case Outcome::kMalformed:
+    case Outcome::kWrongChannel:
+    case Outcome::kReplayed:
+    case Outcome::kNotYetValid:
+    case Outcome::kExpired:
+    case Outcome::kDowngrade:
+      return true;
+    case Outcome::kUpdate:
+    case Outcome::kUpToDate:
+    case Outcome::kUpdaterTooOld:
+    case Outcome::kNoPackage:
+    case Outcome::kInvalidCopy:
+      return false;
+  }
+  return true;
+}
+
+Decision CheckUpdate(std::string_view manifest,
+                     std::string_view signature,
+                     const CopyInfo& copy,
+                     int64_t now) {
+  // What a copy says about itself has to make sense whatever the files hold.
+  if (!IsChannel(copy.channel) || copy.last_serial < 0 ||
+      copy.allowed_hosts.empty() ||
+      !std::ranges::all_of(copy.allowed_hosts, IsHostName)) {
+    return Refused(Outcome::kInvalidCopy);
+  }
+
+  // Step 1: the length. Step 2: the key and the signature. Nothing of the
+  // manifest is looked at before step 2 has passed.
+  if (manifest.empty() || manifest.size() > kMaxManifestBytes) {
+    return Refused(Outcome::kMalformed);
+  }
+  if (!SignatureHolds(manifest, signature, copy.public_key)) {
+    return Refused(Outcome::kBadSignature);
+  }
+
+  // Steps 3 to 6: the bytes, the JSON, the schema, the written form.
+  std::optional<Manifest> read = ParseManifest(manifest, copy.allowed_hosts);
+  if (!read) {
+    return Refused(Outcome::kMalformed);
+  }
+
+  // Steps 7 to 10: is this the channel's current word? `now` may be any
+  // number; the manifest's times are 0 or later, so nothing overflows.
+  if (read->channel != copy.channel) {
+    return Refused(Outcome::kWrongChannel);
+  }
+  if (read->serial < copy.last_serial) {
+    return Refused(Outcome::kReplayed);
+  }
+  if (read->published - kClockSkewSeconds > now) {
+    return Refused(Outcome::kNotYetValid);
+  }
+  if (now > read->expires + kClockSkewSeconds) {
+    return Refused(Outcome::kExpired);
+  }
+
+  // It is: its serial is stored, whatever steps 11 to 13 say.
+  Decision decision;
+  decision.remember_serial = read->serial;
+  if (read->version < copy.installed) {
+    decision.outcome = Outcome::kDowngrade;
+  } else if (read->version == copy.installed) {
+    decision.outcome = Outcome::kUpToDate;
+  } else if (copy.updater < read->min_updater_version) {
+    decision.outcome = Outcome::kUpdaterTooOld;
+    // P4.6: the whole package, for the updater inside it to apply.
+    const auto package = read->packages.find({copy.variant, copy.kind});
+    if (package != read->packages.end()) {
+      decision.full = package->second.full;
+    }
+  } else if (const auto package =
+                 read->packages.find({copy.variant, copy.kind});
+             package == read->packages.end()) {
+    decision.outcome = Outcome::kNoPackage;
+  } else {
+    decision.outcome = Outcome::kUpdate;
+    decision.full = package->second.full;
+    // A delta is used from exactly the installed version and from no other.
+    const auto delta = package->second.deltas.find(copy.installed);
+    if (delta != package->second.deltas.end()) {
+      decision.delta = delta->second;
+    }
+  }
+  decision.manifest = std::move(*read);
+  return decision;
+}
+
+std::optional<PublicKey> KeyFromStatement(std::string_view statement,
+                                          const std::vector<PublicKey>& trusted) {
+  if (statement.size() != kKeyStatementBytes) {
+    return std::nullopt;
+  }
+  PublicKey key;
+  std::copy(statement.begin(), statement.begin() + kPublicKeyBytes, key.begin());
+  if (!IsKey(key)) {
+    return std::nullopt;
+  }
+  std::string message("thoron-update-key-v1\n");
+  message.append(statement.substr(0, kPublicKeyBytes));
+  const std::string_view signature = statement.substr(kPublicKeyBytes);
+  for (const PublicKey& signer : trusted) {
+    if (IsKey(signer) &&
+        ED25519_verify(reinterpret_cast<const uint8_t*>(message.data()), message.size(),
+                       reinterpret_cast<const uint8_t*>(signature.data()),
+                       signer.data()) == 1) {
+      return key;
+    }
+  }
+  return std::nullopt;
+}
+
+std::vector<PublicKey> TrustedKeys(const PublicKey& built_in,
+                                   const std::vector<std::string>& statements) {
+  std::vector<PublicKey> keys = {built_in};
+  std::vector<std::string_view> pending;
+  for (size_t i = 0; i < statements.size() && i < kMostKeyStatements; ++i) {
+    pending.push_back(statements[i]);
+  }
+  bool found = true;
+  while (found) {
+    found = false;
+    for (auto it = pending.begin(); it != pending.end();) {
+      const std::optional<PublicKey> key = KeyFromStatement(*it, keys);
+      if (!key) {
+        ++it;
+        continue;
+      }
+      it = pending.erase(it);
+      if (std::ranges::find(keys, *key) == keys.end()) {
+        keys.push_back(*key);
+      }
+      found = true;
+    }
+  }
+  return keys;
+}
+
+Decision CheckUpdateWithKeys(std::string_view manifest,
+                             std::string_view signature,
+                             CopyInfo copy,
+                             const std::vector<PublicKey>& keys,
+                             int64_t now) {
+  Decision decision;
+  decision.outcome = Outcome::kBadSignature;
+  for (const PublicKey& key : keys) {
+    copy.public_key = key;
+    decision = CheckUpdate(manifest, signature, copy, now);
+    if (decision.outcome != Outcome::kBadSignature) {
+      return decision;
+    }
+  }
+  return decision;
+}
+
+}  // namespace thoron_update
