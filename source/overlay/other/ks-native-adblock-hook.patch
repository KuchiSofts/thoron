+};
+const AT = {es: 0, fr: 1, de: 2, pt: 3, ru: 4}[LANG];
+const t = (text) => (AT === undefined || !ROWS[text] ? text : ROWS[text][AT]);
+for (const element of document.querySelectorAll('[data-t], option')) {
+  element.textContent = t(element.textContent);
+}
+for (const element of document.querySelectorAll('[title]')) {
+  element.title = t(element.title);
+  element.setAttribute('aria-label', element.title);
+}
+const RELATIVE = new Intl.RelativeTimeFormat(navigator.language || 'en', {numeric: 'auto'});
+
+// "5 minutes ago", in the browser's language
+function ago(ms) {
+  const seconds = Math.round((ms - Date.now()) / 1000);
+  for (const [unit, size] of [['day', 86400], ['hour', 3600], ['minute', 60]]) {
+    if (Math.abs(seconds) >= size) {
+      return RELATIVE.format(Math.round(seconds / size), unit);
+    }
+  }
+  return RELATIVE.format(0, 'second');
+}
+
+let state = null;
+
+function showMessage(message, index) {
+  const button = make('button', 'message');
+  button.type = 'button';
+  const line = make('div', 'line');
+  if (message.isNew) {
+    line.append(make('span', 'dot'));
+  }
+  line.append(make('span', 'from', message.from || message.fromEmail));
+  if (message.spam) {
+    line.append(make('span', 'tag', t('Spam')));
+  }
+  line.append(make('span', 'when', message.issued ? ago(message.issued) : ''));
+  button.append(line, make('div', 'subject', message.subject || '(no subject)'));
+  if (message.snippet) {
+    button.append(make('div', 'snippet', message.snippet));
+  }
+  button.title = message.fromEmail || '';
+  button.addEventListener('click', () => chrome.send('openLink', [message.link, index]));
+  return button;
+}
+
+function showAccounts(next) {
+  const box = $('accounts');
+  box.replaceChildren();
+  if (!next.accounts.length) {
+    const empty = make('div', 'empty');
+    if (next.problem === 'offline' || next.problem === 'error') {
+      empty.append(make('p', '', t('Gmail could not be reached. Thoron tries again by itself.')));
+    } else if (next.lastCheck) {
+      empty.append(make('p', '', t('You are not signed in to Gmail in this browser.')));
+      const signIn = make('button', 'main', t('Sign in to Gmail'));
+      signIn.type = 'button';
+      signIn.addEventListener('click', () => chrome.send('signIn'));
+      empty.append(signIn);
+    } else {
+      empty.append(make('p', '', t('Not looked yet')));
+    }
+    box.append(empty);
+  }
+  // only the accounts and their counts, as X-notifier, unless the messages are asked for
+  const listed = next.choices.messages === 'on';
+  for (const account of next.accounts) {
+    const card = make('section', account.watched ? 'account' : 'account off');
+    // the account opens its inbox, and its new mail is counted from then
+    const row = make('button', 'row');
+    row.type = 'button';
+    row.title = t('Open the inbox (the new mail is counted from then)');
+    row.addEventListener('click', () => chrome.send('openInbox', [account.index]));
+    row.append(make('span', 'face', (account.email || '?').slice(0, 1)), make('span', 'email', account.email));
+    if (account.problem) {
+      // a mailbox the last look could not read
+      const warn = make('span', 'warn', '!');
+      warn.title = t(account.problem === 'sign-in' ?
+          'Sign-in refused: its password may have changed. Remove it and add it again.' :
+          'Could not be reached at the last look.');
+      row.append(warn);
+    }
+    if (account.new) {
+      row.append(make('span', 'count new', String(account.new)));
+    }
+    const unread = make('span', 'count unread', String(account.unread));
+    unread.title = `${account.unread} ${t('unread')}`;
+    row.append(unread);
+    card.append(row);
+    if (listed) {
+      for (const message of account.latest.slice(0, 5)) {
+        card.append(showMessage(message, account.index));
+      }
+      if (account.unread > 5) {
+        card.append(make('p', 'more', `+${account.unread - 5} ${t('more unread')}`));
+      }
+    }
+    box.append(card);
+  }
+}
+
+function showSettings(next) {
+  for (const select of document.querySelectorAll('select[data-choice]')) {
+    select.value = next.choices[select.dataset.choice];
+  }
+  $('toolbar-position-row').hidden = next.choices.place === 'address';
+  $('address-position-row').hidden = next.choices.place === 'toolbar';
+  $('notify').checked = next.notify;
+  $('sound').checked = next.choices.sound !== 'off';
+  $('messages').checked = next.choices.messages === 'on';
+  const interval = $('interval');
+  if (!interval.options.length) {
+    for (const minutes of next.intervals) {
+      const option = make('option', '', `${minutes} ${t('min')}`);
+      option.value = String(minutes);
+      interval.append(option);
+    }
+  }
+  interval.value = String(next.interval);
+  const watch = $('watch');
+  watch.replaceChildren();
+  for (const account of next.accounts) {
+    const label = make('label', 'check');
+    const box = make('input');
+    box.type = 'checkbox';
+    box.checked = account.watched;
+    box.addEventListener('change', () => chrome.send('setWatched', [account.email, box.checked]));
+    label.append(box, make('span', '', account.email));
+    const row = make('div', 'watch-row');
+    row.append(label);
+    if (account.imap) {
+      // a mailbox added by address and password can be taken out again
+      const remove = make('button', '', t('Remove'));
+      remove.type = 'button';
+      remove.addEventListener('click', () => chrome.send('removeImapAccount', [account.email]));
+      row.append(remove);
+    }
+    watch.append(row);
+  }
+  // P5.80: the Google accounts of the person's list (X-notifier's file), on the M-Notifier's own page
+  const wanted = next.wanted || [];
+  $('wanted-box').hidden = !PAGE || !wanted.length;
+  const list = $('wanted');
+  list.replaceChildren();
+  for (const account of wanted) {
+    const row = make('div', 'watch-row');
+    row.dataset.email = account.email;
+    row.append(make('span', 'name', account.alias ? `${account.alias} (${account.email})` : account.email));
+    if (account.counted) {
+      row.append(make('span', 'state', t('Counted')));
+    } else {
+      const signIn = make('button', '', t('Sign in'));
+      signIn.type = 'button';
+      signIn.addEventListener('click', () => chrome.send('signInGoogle', [account.email]));
+      row.append(signIn);
+    }
+    if (account.password && !account.counted) {
+      const copy = make('button', '', t('Copy password'));
+      copy.type = 'button';
+      copy.addEventListener('click', async () => {
+        let done = false;
+        try {
+          done = await sendWithPromise('copyGooglePassword', account.email);
+        } catch {
+          return;
+        }
+        $('wanted-state').textContent = done ? t('The password is on the clipboard.') : '';
+      });
+      row.append(copy);
+    }
+    const remove = make('button', '', t('Remove'));
+    remove.type = 'button';
+    remove.addEventListener('click', () => {
+      chrome.send('removeGoogleAccount', [account.email]);
+      refresh();
+    });
+    row.append(remove);
+    list.append(row);
+  }
+}
+
+// --- A mailbox by address and password (P5.77) ---
+// What is known of the mail services people use: the server, the page the mail is read on, and what to tell
+// about the password. `blocked`: the service takes no password from a mail program.
+const SERVICES = [
+  {match: /@(gmail|googlemail)\.com$/, host: 'imap.gmail.com', hint: 'google',
+   webmail: (email) => `https://mail.google.com/mail/?authuser=${encodeURIComponent(email)}`},
+  {match: /@(yahoo|ymail|rocketmail)\.[a-z.]+$/, host: 'imap.mail.yahoo.com', hint: 'app',
+   webmail: () => 'https://mail.yahoo.com/'},
+  {match: /@aol\.com$/, host: 'imap.aol.com', hint: 'app', webmail: () => 'https://mail.aol.com/'},
+  {match: /@(icloud|me|mac)\.com$/, host: 'imap.mail.me.com', hint: 'app',
+   webmail: () => 'https://www.icloud.com/mail'},
+  {match: /@(outlook|hotmail|live|msn)\.[a-z.]+$/, blocked: 'microsoft'},
+  {match: /@(proton|protonmail)\.(me|com|ch)$|@pm\.me$/, blocked: 'proton'},
+  {match: /@gmx\.[a-z.]+$/, host: 'imap.gmx.com', webmail: () => 'https://www.gmx.com/'},
+  {match: /@(mail|inbox|list|bk)\.ru$/, host: 'imap.mail.ru', hint: 'app',
+   webmail: () => 'https://e.mail.ru/inbox/'},
+  {match: /@(yandex|ya)\.[a-z.]+$/, host: 'imap.yandex.com', hint: 'app',
+   webmail: () => 'https://mail.yandex.com/'},
+  {match: /@zoho\.[a-z.]+$/, host: 'imap.zoho.com', webmail: () => 'https://mail.zoho.com/'},
+  {match: /@fastmail\.[a-z.]+$/, host: 'imap.fastmail.com', hint: 'app',
+   webmail: () => 'https://app.fastmail.com/'},
+];
+const HINTS = {
+  google: 'Google accepts only an app password here, not your normal password: make one in your Google Account ' +
+      'under Security, 2-Step Verification, App passwords.',
+  app: 'This service may ask for an app password, made in its account settings, instead of your normal password.',
+  microsoft: 'Microsoft no longer lets mail programs sign in to these accounts with a password. Open Outlook in ' +
+      'the browser instead.',
+  proton: 'Proton Mail has no mailbox access of this kind without its Bridge app, which Thoron does not use yet.',
+};
+const ADD_ERRORS = {
+  'sign-in': 'The server refused the name or the password.',
+  'offline': 'The server could not be reached.',
+  'protocol': "The server's answers could not be read.",
+  'too-much': "The server's answers could not be read.",
+  'bad': 'Check the address, the password, the server and the port.',
+  'exists': 'This mailbox is already there.',
+  'full': 'No more mailboxes can be added.',
+  'busy': 'Another mailbox is being added.',
+  'locked': 'Passwords cannot be kept yet. Try again in a moment.',
+};
+
+function serviceOf(email) {
+  const address = email.trim().toLowerCase();
+  return SERVICES.find((service) => service.match.test(address)) || null;
+}
+
+// The server and the mail page follow the address, until the person writes their own.
+const typed = new Set();
+function fillFromAddress() {
+  const email = $('imap-email').value.trim();
+  const service = serviceOf(email);
+  const domain = email.includes('@') ? email.slice(email.lastIndexOf('@') + 1).toLowerCase() : '';
+  if (!typed.has('imap-host')) {
+    $('imap-host').value = service ? (service.host || '') : (domain ? `imap.${domain}` : '');
+  }
+  if (!typed.has('imap-webmail')) {
+    $('imap-webmail').value = service && service.webmail ? service.webmail(email) : '';
+  }
+  const hint = service ? (service.blocked || service.hint) : '';
+  $('imap-hint').textContent = hint ? t(HINTS[hint]) : '';
+  $('imap-add').disabled = !!(service && service.blocked);
+  $('imap-error').textContent = '';
+}
+
+async function addMailbox() {
+  const email = $('imap-email').value.trim();
+  $('imap-error').textContent = '';
+  $('imap-add').disabled = true;
+  $('imap-add').textContent = t('Checking...');
+  let error = 'bad';
+  try {
+    error = await sendWithPromise('addImapAccount', {
+      email,
+      password: $('imap-password').value,
+      host: $('imap-host').value.trim(),
+      port: Number($('imap-port').value) || 993,
+      user: $('imap-user').value.trim(),
+      webmail: $('imap-webmail').value.trim(),
+    });
+  } catch {
+    // the window went away
+  }
+  $('imap-add').textContent = t('Add');
+  $('imap-add').disabled = false;
+  if (error) {
+    const service = serviceOf(email);
+    $('imap-error').textContent = t(ADD_ERRORS[error] || ADD_ERRORS.bad);
+    if (error === 'sign-in' && service && service.hint) {
+      $('imap-hint').textContent = t(HINTS[service.hint]);
+    }
+    return;
+  }
+  // added: the form is emptied, the password first
+  for (const id of ['imap-password', 'imap-email', 'imap-host', 'imap-user', 'imap-webmail']) {
+    $(id).value = '';
+  }
+  typed.clear();
+  $('imap-port').value = '993';
+  $('imap-hint').textContent = '';
+  showAddPanel(false);
+  refresh();
+}
+
+// --- The M-Notifier's own page (a tab) and its backup (P5.77) ---
+// In a tab the page shows everything at once; the menu shows one part at a time.
+const PAGE = location.hash.startsWith('#manage');
+
+function showAddPanel(open) {
+  $('add-panel').hidden = !open;
+  if (!PAGE) {
+    $('accounts').hidden = open;
+    $('settings').hidden = true;
+    $('gear').setAttribute('aria-pressed', 'false');
+  }
+  $('imap-form').hidden = !PAGE;
+  $('imap-bubble').hidden = PAGE;
+  if (open && PAGE) {
+    $('imap-email').focus();
+  }
+}
+
+async function saveBackup() {
+  const pass = $('backup-pass').value;
+  const plain = $('backup-plain').checked;
+  let text = '';
+  try {
+    text = await sendWithPromise('exportBackup', plain, pass);
+  } catch {
+    return;
+  }
+  if (!text) {
+    return;
+  }
+  const name = pass ? 'thoron-m-notifier-backup.thoron' : 'thoron-m-notifier-backup.json';
+  const said = pass ? 'Saved, with the passwords sealed.' :
+      plain ? 'Saved, with the passwords as they are: keep this file safe.' : 'Saved, without the passwords.';
+  try {
+    if (window.showSaveFilePicker) {
+      // the person chooses where: their Google Drive folder, for one
+      const handle = await window.showSaveFilePicker({suggestedName: name});
+      const file = await handle.createWritable();
+      await file.write(text);
+      await file.close();
+    } else {
+      const link = make('a');
+      link.href = URL.createObjectURL(new Blob([text], {type: 'application/json'}));
+      link.download = name;
+      link.click();
+      setTimeout(() => URL.revokeObjectURL(link.href), 10000);
+    }
+    $('backup-state').textContent = t(said);
+  } catch {
+    // the person closed the dialog
+  }
+}
+
+// --- X-notifier's file of accounts (P5.80) ---
+// Its text: "[---<info>---]" and a line; "[---<preferences>---]" and lines of name, kind and value;
+// "[---<accounts>---]" and a line for each account; "[------]". The info line and the account lines are
+// encrypted with the file's passphrase: AES in counter mode, the first 8 bytes the start of the counter, all in
+// base64. The key is the passphrase's first 32 bytes, encrypted once with themselves. The file is read here, in
+// the page; the browser is given the accounts.
+const XN_START = '[---<info>---]';
+
+async function xnKey(passphrase) {
+  const raw = new Uint8Array(32);
+  raw.set(new TextEncoder().encode(passphrase).subarray(0, 32));
+  const first = await crypto.subtle.importKey('raw', raw, 'AES-CTR', false, ['encrypt']);
+  // one block encrypted: the counter is the block, the text 16 zero bytes
+  const half = new Uint8Array(await crypto.subtle.encrypt(
+      {name: 'AES-CTR', counter: raw.slice(0, 16), length: 64}, first, new Uint8Array(16)));
+  const key = new Uint8Array(32);
+  key.set(half);
+  key.set(half, 16);
+  return crypto.subtle.importKey('raw', key, 'AES-CTR', false, ['decrypt']);
+}
+
+async function xnDecrypt(key, line) {
+  const bytes = Uint8Array.from(atob(line.trim()), (c) => c.charCodeAt(0));
+  if (bytes.length < 8) {
+    return '';
+  }
+  const counter = new Uint8Array(16);
+  counter.set(bytes.subarray(0, 8));
+  const plain = await crypto.subtle.decrypt({name: 'AES-CTR', counter, length: 64}, key, bytes.subarray(8));
+  return new TextDecoder().decode(plain);
+}
+
+// What the file holds: {error} ("bad", "passphrase", "wrong"), or its Google accounts as {email, alias,
+// password} and how many other entries (not mail) it has.
+async function xnRead(text, passphrase) {
+  const sections = {};
+  const body = text.replace(/\r\n/g, '\n');
+  const pattern = /\[---(.+?)---\]\n([\s\S]+?)\n(?=\[--)/g;
+  for (let found = pattern.exec(body); found; found = pattern.exec(body)) {
+    sections[found[1]] = found[2];
+  }
+  if (!sections['<info>'] || !sections['<accounts>']) {
+    return {error: 'bad'};
+  }
+  if (!passphrase) {
+    return {error: 'passphrase'};
+  }
+  let key;
+  let token = '';
+  try {
+    key = await xnKey(passphrase);
+    token = await xnDecrypt(key, sections['<info>']);
+  } catch {
+    return {error: 'bad'};
+  }
+  if (!/^\d+$/.test(token)) {
+    return {error: 'wrong'};
+  }
+  // the names people gave their accounts
+  const alias = new Map();
+  for (const line of (sections['<preferences>'] || '').split('\n')) {
+    const [name, , value] = line.split('\t');
+    const found = /^accounts\.\[gmail#(.+?)\]\.alias$/.exec(name || '');
+    if (found && value) {
+      alias.set(found[1], value);
+    }
+  }
+  const accounts = [];
+  let other = 0;
+  for (const line of sections['<accounts>'].split('\n')) {
+    let parts = [];
+    try {
+      parts = (await xnDecrypt(key, line)).split('\t');
+    } catch {
+      continue;
+    }
+    // the kind, the user, the password, and the file's own token: a line without it is not of this file
+    if (parts.length < 4 || parts[3] !== token) {
+      continue;
+    }
+    const user = parts[1].trim();
+    if (parts[0] !== 'gmail' || !user) {
+      other++;
+      continue;
+    }
+    accounts.push({email: user.includes('@') ? user : `${user}@gmail.com`, alias: alias.get(parts[1]) || '',
+                   password: parts[2]});
+  }
+  return {accounts, other};
+}
+
+async function readXnotifier(text) {
+  const say = (words) => {
+    $('backup-state').textContent = words;
+  };
+  const errors = {
+    passphrase: 'This file of X-notifier needs its passphrase: type it above and read it again.',
+    wrong: 'The passphrase does not open this file of X-notifier.',
+    bad: 'This is not a backup of Thoron M-Notifier.',
+    locked: 'Passwords cannot be kept yet. Try again in a moment.',
+  };
+  const read = await xnRead(text, $('backup-pass').value);
+  if (read.error) {
+    say(t(errors[read.error] || errors.bad));
+    return;
+  }
+  let answer = {error: 'bad', google: 0, mailboxes: 0};
+  try {
+    answer = await sendWithPromise('importGoogleAccounts', read.accounts);
+  } catch {
+    return;
+  }
+  if (answer.error) {
+    say(t(errors[answer.error] || errors.bad));
+    return;
+  }
+  say(`${t('Read from X-notifier. Google accounts:')} ${answer.google}; ${t('as mailboxes by app password:')} ` +
+      `${answer.mailboxes}; ${t('left out (not mail):')} ${read.other}`);
+  refresh();
+}
+
+async function readBackup(file) {
+  if (!file || file.size > 4 * 1024 * 1024) {
+    $('backup-state').textContent = t('This is not a backup of Thoron M-Notifier.');
+    return;
+  }
+  const whole = await file.text();
+  if (whole.trimStart().startsWith(XN_START)) {
+    await readXnotifier(whole);
+    return;
+  }
+  let answer = {error: 'bad', accounts: 0};
+  try {
+    answer = await sendWithPromise('importBackup', await file.text(), $('backup-pass').value);
+  } catch {
+    return;
+  }
+  const errors = {
+    passphrase: 'This backup is sealed: type its passphrase above and read it again.',
+    wrong: 'The passphrase does not open this backup.',
+    bad: 'This is not a backup of Thoron M-Notifier.',
+    locked: 'Passwords cannot be kept yet. Try again in a moment.',
+  };
+  $('backup-state').textContent =
+      answer.error ? t(errors[answer.error] || errors.bad) : `${t('Read. Mailboxes now:')} ${answer.accounts}`;
+  refresh();
+}
+
+function show(next) {
+  state = next;
+  const parts = [];
+  if (next.accounts.length) {
+    if (next.totalNew) {
+      parts.push(`${next.totalNew} ${t('new')}`);
+    }
+    parts.push(`${next.total} ${t('unread')}`);
+  }
+  $('total').textContent = parts.join(' · ');
+  $('check').disabled = next.checking;
+  $('state').textContent = next.lastCheck ? `${t('Looked')} ${ago(next.lastCheck)}` : '';
+  showAccounts(next);
+  showSettings(next);
+}
+
+async function refresh() {
+  try {
+    show(await sendWithPromise('getMailState'));
+  } catch {
+    // the window went away
+  }
+}
+
+$('check').addEventListener('click', () => chrome.send('checkNow'));
+$('gear').addEventListener('click', () => {
+  const open = $('settings').hidden;
+  $('settings').hidden = !open;
+  $('accounts').hidden = open;
+  $('add-panel').hidden = true;
+  $('gear').setAttribute('aria-pressed', String(open));
+});
+// "Add an account" opens the two ways to add one
+$('add').addEventListener('click', () => showAddPanel($('add-panel').hidden));
+$('add-google').addEventListener('click', () => chrome.send('addAccount'));
+// the form is on the M-Notifier's own page: a menu closes when another window is used (a password manager)
+$('add-mailbox').addEventListener('click', () => chrome.send('openManage', [true]));
+$('manage').addEventListener('click', () => chrome.send('openManage', [false]));
+$('imap-email').addEventListener('input', fillFromAddress);
+for (const id of ['imap-host', 'imap-webmail']) {
+  $(id).addEventListener('input', () => typed.add(id));
+}
+$('imap-add').addEventListener('click', addMailbox);
+$('imap-cancel').addEventListener('click', () => {
+  $('imap-password').value = '';
+  showAddPanel(false);
+});
+$('imap-password').addEventListener('keydown', (event) => {
+  if (event.key === 'Enter' && !$('imap-add').disabled) {
+    addMailbox();
+  }
+});
+$('export').addEventListener('click', saveBackup);
+$('import').addEventListener('click', () => $('import-file').click());
+$('import-xn').addEventListener('click', () => $('import-file').click());
+$('import-file').addEventListener('change', () => {
+  readBackup($('import-file').files[0]);
+  $('import-file').value = '';
+});
+if (PAGE) {
+  document.body.classList.add('page');
+  $('settings').hidden = false;
+  $('backup').hidden = false;
+  showAddPanel(location.hash === '#manage-add');
+  addEventListener('hashchange', () => showAddPanel(location.hash === '#manage-add'));
+}
+$('notify').addEventListener('change', () => chrome.send('setNotify', [$('notify').checked]));
+$('sound').addEventListener('change', () => chrome.send('setChoice', ['sound', $('sound').checked ? 'on' : 'off']));
+$('messages').addEventListener(
+    'change', () => chrome.send('setChoice', ['messages', $('messages').checked ? 'on' : 'off']));
+$('interval').addEventListener('change', () => chrome.send('setInterval', [Number($('interval').value)]));
+for (const select of document.querySelectorAll('select[data-choice]')) {
+  select.addEventListener('change', () => chrome.send('setChoice', [select.dataset.choice, select.value]));
+}
+document.addEventListener('keydown', (event) => {
+  if (event.key === 'Escape') {
+    chrome.send('closeMenu');
+  }
+});
+addWebUiListener('mail-changed', refresh);
+addWebUiListener('menu-shown', async () => {
+  // the theme may have changed since this page was kept: its colours are read again
+  $('theme').href = `chrome://theme/colors.css?sets=ui,chrome&version=${Date.now()}`;
+  await refresh();
+  chrome.send('menuReady');
+});
+refresh().then(() => chrome.send('menuReady'));
+// the times shown ("2 minutes ago") stay right while the menu is open
+setInterval(() => {
+  if (state && !document.hidden) {
+    show(state);
+  }
+}, 30000);
+)thoron";
+
+}  // namespace
+
+std::string_view MailPageHtml() {
+  return kHtml;
+}
+
