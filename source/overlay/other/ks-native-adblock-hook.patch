+++ b/chrome/install_static/thoron_portable.cc
@@ -0,0 +1,49 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/install_static/thoron_portable.h"
+
+#include <windows.h>
+
+#include <string>
+
+namespace install_static {
+
+namespace {
+
+// The folder `path` names, without its last part, or "" at the top.
+std::wstring Parent(const std::wstring& path) {
+  const size_t slash = path.find_last_of(L"\\/");
+  return slash == std::wstring::npos ? std::wstring() : path.substr(0, slash);
+}
+
+bool Exists(const std::wstring& path) {
+  return ::GetFileAttributesW(path.c_str()) != INVALID_FILE_ATTRIBUTES;
+}
+
+bool LooksPortable() {
+  std::wstring exe(32768, L'\0');
+  const DWORD length = ::GetModuleFileNameW(
+      nullptr, exe.data(), static_cast<DWORD>(exe.size()));
+  if (length == 0 || length >= exe.size()) {
+    return false;
+  }
+  exe.resize(length);
+  // <copy>\Application\<version>\thoron.exe
+  const std::wstring application = Parent(Parent(exe));
+  const std::wstring copy = Parent(application);
+  return !application.empty() && !copy.empty() &&
+         Exists(application + L"\\current") &&
+         Exists(copy + L"\\Thoron.exe");
+}
+
+}  // namespace
+
+// Not kept in a function-local static: chrome_elf calls it from DllMain, under
+// the loader lock, where a thread-safe static's guard is best avoided. It is
+// two file checks, and its callers ask once or rarely.
+bool IsThoronPortableCopy() {
+  return LooksPortable();
+}
+
+}  // namespace install_static
