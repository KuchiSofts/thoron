+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_portable_key/local_state_key.h"
+
+#include <string>
+
+#include "base/base64.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "build/build_config.h"
+#include "components/thoron_portable_key/key_file.h"
+#include "components/thoron_portable_key/key_store.h"
+#include "crypto/random.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace thoron_portable_key {
+namespace {
+
+#if BUILDFLAG(IS_WIN)
+// The key a copy keeps in Local State, as Chromium writes it, is read back,
+// and nothing else is taken for it.
+TEST(ThoronLocalStateKeyTest, RoundTrip) {
+  SecretBytes key(kProfileKeyBytes);
+  crypto::RandBytes(key.span());
+  std::optional<std::string> stored = ProtectLocalStateKey(key);
+  ASSERT_TRUE(stored);
+  std::optional<std::vector<uint8_t>> decoded = base::Base64Decode(*stored);
+  ASSERT_TRUE(decoded);
+  EXPECT_EQ(std::string(decoded->begin(), decoded->begin() + 5), "DPAPI");
+  std::optional<SecretBytes> back = UnprotectLocalStateKey(*stored);
+  ASSERT_TRUE(back);
+  EXPECT_TRUE(*back == key);
+
+  EXPECT_FALSE(UnprotectLocalStateKey(""));
+  EXPECT_FALSE(UnprotectLocalStateKey("not base64!"));
+  EXPECT_FALSE(UnprotectLocalStateKey(base::Base64Encode(
+      std::string("XPAPI") + std::string(decoded->begin() + 5, decoded->end()))));
+  EXPECT_FALSE(ProtectLocalStateKey(SecretBytes(16)));
+}
+#endif
+
+TEST(ThoronLocalStateKeyTest, FloorIsMeasured) {
+  EXPECT_TRUE(MeasureFloor().is_positive());
+}
+
+TEST(ThoronLocalStateKeyTest, KeyFileFoundAndRemoved) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  EXPECT_FALSE(HasKeyFile(dir.GetPath()));
+  const base::FilePath main = dir.GetPath().Append(kKeyFileName);
+  for (const base::FilePath& path :
+       {main, main.AddExtensionASCII("new"), main.AddExtensionASCII("old")}) {
+    ASSERT_TRUE(base::WriteFile(path, "x"));
+    EXPECT_TRUE(HasKeyFile(dir.GetPath()));
+  }
+  EXPECT_TRUE(RemoveKeyFile(dir.GetPath()));
+  EXPECT_FALSE(HasKeyFile(dir.GetPath()));
+  EXPECT_TRUE(base::IsDirectoryEmpty(dir.GetPath()));
+}
+
+}  // namespace
+}  // namespace thoron_portable_key
diff --git a/components/thoron_portable_key/os_key_store.cc b/components/thoron_portable_key/os_key_store.cc
new file mode 100644
index 0000000000000000000000000000000000000000..c5e0a9337da52e6caed400bf5dab3cf29f7cddfb
--- /dev/null
+++ b/components/thoron_portable_key/os_key_store.cc
@@ -0,0 +1,112 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_portable_key/os_key_store.h"
+
+#include <string_view>
+
+#include "base/compiler_specific.h"
+#include "build/build_config.h"
+#include "build/config/linux/dbus/buildflags.h"
+
+#if BUILDFLAG(IS_WIN)
+#include <windows.h>
+
+#include <dpapi.h>
+#endif
+
+#if BUILDFLAG(IS_LINUX) && BUILDFLAG(USE_DBUS)
+#include "components/thoron_portable_key/os_key_store_linux.h"
+#endif
+
+namespace thoron_portable_key {
+
+namespace {
+
+#if BUILDFLAG(IS_WIN)
+
+// Mixed into every DPAPI call, so that a blob made here opens only here and a
+// blob made for anything else does not open here.
+constexpr std::string_view kEntropy = "Thoron portable key: this PC";
+
+DATA_BLOB EntropyBlob() {
+  DATA_BLOB blob;
+  blob.pbData = reinterpret_cast<BYTE*>(const_cast<char*>(kEntropy.data()));
+  blob.cbData = static_cast<DWORD>(kEntropy.size());
+  return blob;
+}
+
+class DpapiKeyStore : public OsKeyStore {
+ public:
+  bool IsAvailable() const override { return true; }
+
+  std::optional<std::vector<uint8_t>> Protect(
+      base::span<const uint8_t> secret) override {
+    DATA_BLOB input;
+    input.pbData = const_cast<BYTE*>(secret.data());
+    input.cbData = static_cast<DWORD>(secret.size());
+    DATA_BLOB entropy = EntropyBlob();
+    DATA_BLOB output = {};
+    if (!::CryptProtectData(&input, L"Thoron portable key", &entropy, nullptr,
+                            nullptr, CRYPTPROTECT_UI_FORBIDDEN, &output)) {
+      return std::nullopt;
+    }
+    // SAFETY: CryptProtectData gives cbData bytes at pbData.
+    const base::span<const uint8_t> made =
+        UNSAFE_BUFFERS(base::span(output.pbData, output.cbData));
+    std::vector<uint8_t> blob(made.begin(), made.end());
+    ::LocalFree(output.pbData);
+    return blob;
+  }
+
+  std::optional<SecretBytes> Unprotect(
+      base::span<const uint8_t> blob) override {
+    DATA_BLOB input;
+    input.pbData = const_cast<BYTE*>(blob.data());
+    input.cbData = static_cast<DWORD>(blob.size());
+    DATA_BLOB entropy = EntropyBlob();
+    DATA_BLOB output = {};
+    if (!::CryptUnprotectData(&input, nullptr, &entropy, nullptr, nullptr,
+                              CRYPTPROTECT_UI_FORBIDDEN, &output)) {
+      return std::nullopt;
+    }
+    // SAFETY: CryptUnprotectData gives cbData bytes at pbData.
+    const base::span<uint8_t> plain =
+        UNSAFE_BUFFERS(base::span(output.pbData, output.cbData));
+    SecretBytes secret(plain);
+    Wipe(plain);
+    ::LocalFree(output.pbData);
+    return secret;
+  }
+};
+
+#else
+
+class NoKeyStore : public OsKeyStore {
+ public:
+  bool IsAvailable() const override { return false; }
+  std::optional<std::vector<uint8_t>> Protect(
+      base::span<const uint8_t> secret) override {
+    return std::nullopt;
+  }
+  std::optional<SecretBytes> Unprotect(
+      base::span<const uint8_t> blob) override {
+    return std::nullopt;
+  }
+};
+
+#endif
+
+}  // namespace
+
+std::unique_ptr<OsKeyStore> CreateOsKeyStore() {
+#if BUILDFLAG(IS_WIN)
+  return std::make_unique<DpapiKeyStore>();
+#elif BUILDFLAG(IS_LINUX) && BUILDFLAG(USE_DBUS)
+  return CreateSecretServiceKeyStore();
+#else
+  return std::make_unique<NoKeyStore>();
+#endif
+}
+
+}  // namespace thoron_portable_key
