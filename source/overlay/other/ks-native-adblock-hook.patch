+
+namespace {
+
+// The count has at most four characters ("999", "1k", "12k"). Its colours and
+// the shield's are the browser theme's (P5.78, thoron::ColorsOf).
+// The menu closes when anything else is pressed, the shields too: a press
+// within this long of it closing is the one that closed it, and does not open
+// it again.
+constexpr base::TimeDelta kReopenGuard = base::Milliseconds(300);
+// How often at most the address bar's shield is drawn again while a page
+// blocks a lot.
+constexpr base::TimeDelta kAddressBarRefresh = base::Milliseconds(150);
+// A kept page brings itself up to date before it is shown: if it has not
+// asked to be shown by then, it is shown as it is.
+constexpr base::TimeDelta kShowAnyway = base::Milliseconds(250);
+
+std::string BadgeText(int count) {
+  if (count <= 0) {
+    return std::string();
+  }
+  if (count < 1000) {
+    return base::NumberToString(count);
+  }
+  if (count < 1000000) {
+    return base::NumberToString(count / 1000) + "k";
+  }
+  return "1M+";
+}
+
+struct Shield {
+  // -1: not a web page, where the blocker does nothing
+  int count = -1;
+  bool off_everywhere = false;
+  bool off_here = false;
+  bool off() const { return count < 0 || off_everywhere || off_here; }
+};
+
+Shield ShieldFor(content::WebContents* tab) {
+  Shield shield;
+  if (!tab) {
+    return shield;
+  }
+  const GURL url = tab->GetPrimaryMainFrame()->GetLastCommittedURL();
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return shield;
+  }
+  const HostContentSettingsMap* settings =
+      HostContentSettingsMapFactory::GetForProfile(
+          Profile::FromBrowserContext(tab->GetBrowserContext()));
+  shield.count = thoron_adblock::BlockedCount::Get(tab->GetPrimaryPage());
+  shield.off_everywhere =
+      !thoron_adblock::ProxyingURLLoaderFactory::BlockingEverywhere(settings);
+  shield.off_here = settings && settings->GetContentSetting(
+                                    url, url, ContentSettingsType::ADS) ==
+                                    CONTENT_SETTING_ALLOW;
+  return shield;
+}
+
+std::u16string ShieldTooltip(const Shield& shield) {
+  if (shield.count < 0) {
+    return u"Thoron adblock: nothing to block on this page";
+  }
+  if (shield.off_everywhere) {
+    return u"Thoron adblock: off for every site";
+  }
+  if (shield.off_here) {
+    return u"Thoron adblock: off on this site";
+  }
+  return shield.count == 1
+             ? std::u16string(u"Thoron adblock: 1 blocked on this page")
+             : u"Thoron adblock: " + base::NumberToString16(shield.count) +
+                   u" blocked on this page";
+}
+
+// Thoron adblock's own shield (P5.74): Thoron's T in a shield, filled with
+// the theme's accent while it blocks. Where it does not, an outline in the toolbar's
+// own colour: with the T where there is nothing to block (not a web page), with
+// a slash where the site is allowed, and with two bars while blocking is off
+// for every site. Drawn on a 20 x 20 grid, as large as the icons next to it.
+enum class ShieldLook { kOn, kNotWeb, kOffHere, kOffEverywhere };
+
+ShieldLook LookOf(const Shield& shield) {
+  if (shield.count < 0) {
+    return ShieldLook::kNotWeb;
+  }
+  if (shield.off_everywhere) {
+    return ShieldLook::kOffEverywhere;
+  }
+  return shield.off_here ? ShieldLook::kOffHere : ShieldLook::kOn;
+}
+
+class ShieldSource : public gfx::CanvasImageSource {
+ public:
+  ShieldSource(int size,
+               ShieldLook look,
+               SkColor off_color,
+               SkColor on_color,
+               SkColor on_mark)
+      : gfx::CanvasImageSource(gfx::Size(size, size)),
+        look_(look),
+        off_color_(off_color),
+        on_color_(on_color),
+        on_mark_(on_mark) {}
+
+  void Draw(gfx::Canvas* canvas) override {
+    const float s = size().width() / 20.0f;
+    const bool on = look_ == ShieldLook::kOn;
+    // an outline is drawn a little inside, so it is as large as the filled one
+    const float k = on ? 1.0f : 0.92f;
+    auto at = [s, k](float x, float y) {
+      return SkPoint::Make((10 + (x - 10) * k) * s, (10 + (y - 10) * k) * s);
+    };
+    SkPathBuilder outline;
+    outline.moveTo(at(10, 1.8f));
+    outline.lineTo(at(16.3f, 4.1f));
+    outline.cubicTo(at(16.6f, 4.2f), at(16.8f, 4.5f), at(16.8f, 4.8f));
+    outline.lineTo(at(16.8f, 9.4f));
+    outline.cubicTo(at(16.8f, 13.4f), at(14.1f, 16.8f), at(10.3f, 18.1f));
+    outline.cubicTo(at(10.1f, 18.2f), at(9.9f, 18.2f), at(9.7f, 18.1f));
+    outline.cubicTo(at(5.9f, 16.8f), at(3.2f, 13.4f), at(3.2f, 9.4f));
+    outline.lineTo(at(3.2f, 4.8f));
+    outline.cubicTo(at(3.2f, 4.5f), at(3.4f, 4.2f), at(3.7f, 4.1f));
+    outline.close();
+    cc::PaintFlags body;
+    body.setAntiAlias(true);
+    body.setColor(on ? on_color_ : off_color_);
+    if (!on) {
+      body.setStyle(cc::PaintFlags::kStroke_Style);
+      body.setStrokeWidth(1.5f * s);
+      body.setStrokeJoin(cc::PaintFlags::kRound_Join);
+    }
+    canvas->DrawPath(outline.detach(), body);
+
+    cc::PaintFlags mark;
+    mark.setAntiAlias(true);
+    mark.setColor(on ? on_mark_ : off_color_);
+    auto rect = [s](float x, float y, float w, float h) {
+      return gfx::RectF(x * s, y * s, w * s, h * s);
+    };
+    switch (look_) {
+      case ShieldLook::kOn:
+      case ShieldLook::kNotWeb:
+        // Thoron's T
+        canvas->DrawRect(rect(6.4f, 6.2f, 7.2f, 2.0f), mark);
+        canvas->DrawRect(rect(9.0f, 8.2f, 2.0f, 5.6f), mark);
+        break;
+      case ShieldLook::kOffEverywhere:
+        // paused
+        canvas->DrawRect(rect(7.4f, 6.6f, 1.9f, 6.6f), mark);
+        canvas->DrawRect(rect(10.7f, 6.6f, 1.9f, 6.6f), mark);
+        break;
+      case ShieldLook::kOffHere: {
+        // allowed here
+        cc::PaintFlags slash(mark);
+        slash.setStyle(cc::PaintFlags::kStroke_Style);
+        slash.setStrokeWidth(1.6f * s);
+        slash.setStrokeCap(cc::PaintFlags::kRound_Cap);
+        canvas->DrawLine(gfx::PointF(6.6f * s, 6.4f * s),
+                         gfx::PointF(13.4f * s, 13.6f * s), slash);
+        break;
+      }
+    }
+  }
+
+ private:
+  const ShieldLook look_;
+  const SkColor off_color_;
+  const SkColor on_color_;
+  const SkColor on_mark_;
+};
+
+// The shield, `size` px, in the colours of `view`'s theme. In the toolbar
+// (`area` larger than `size`) it is in the middle of an image `area` px wide
+// and high, as an extension's, with the count in the image's corner: the
+// shield stays in view. In the address bar (`area` is `size`) the count is
+// right of the shield: its icons are small.
+ui::ImageModel DrawShield(const Shield& shield,
+                          const views::View* view,
+                          int size,
+                          int area,
+                          SkColor off_color) {
+  const thoron::IconColors colors = thoron::ColorsOf(view->GetColorProvider());
+  // The shield fills its place as the icons next to it do (P5.73).
+  const gfx::ImageSkia icon(
+      std::make_unique<ShieldSource>(size, LookOf(shield), off_color,
+                                     colors.accent, colors.on_accent),
+      gfx::Size(size, size));
+  // the setting of chrome://adblock, as in uBlock Origin
+  const bool badge = thoron_adblock::EngineService::Get().Option("badge");
+  const std::string text =
+      shield.off() || !badge ? std::string() : BadgeText(shield.count);
+  if (area == size) {
+    return ui::ImageModel::FromImageSkia(
+        thoron::WithCountBeside(icon, text, colors.accent));
+  }
+  return ui::ImageModel::FromImageSkia(thoron::WithCountBadge(
+      icon, area, text, colors.badge, colors.badge_text));
+}
+
+}  // namespace
+
+// The menu's bubble manager (P5.72): WebUIBubbleManagerImpl's, and it can load
+// the menu's page ahead of a click (WarmUp), so the menu opens at once. The
+// page is kept as a closed menu's page is (30 seconds after it was shown).
+class ThoronMenuBubbleManager : public WebUIBubbleManager {
+ public:
+  explicit ThoronMenuBubbleManager(BrowserWindowInterface* browser)
+      : browser_(browser) {}
+  ~ThoronMenuBubbleManager() override = default;
+
+  // Loads the menu's page, unless it is loaded or the menu is open.
+  void WarmUp() {
+    if (GetBubbleWidget() || cached_contents_wrapper()) {
+      return;
+    }
+    set_cached_contents_wrapper(MakeContents(/*warm=*/true));
+    // the tab the page is about, before it is shown
+    webui::SetBrowserWindowInterface(cached_contents_wrapper()->web_contents(),
+                                     browser_.get());
+  }
+
+  // The page's controller, once the page is there.
+  ThoronAdblockMenuUI* MenuUI() {
+    WebUIContentsWrapper* contents = cached_contents_wrapper();
+    content::WebUI* web_ui = contents && contents->web_contents()
+                                 ? contents->web_contents()->GetWebUI()
+                                 : nullptr;
+    return web_ui && web_ui->GetController()
+               ? web_ui->GetController()->GetAs<ThoronAdblockMenuUI>()
+               : nullptr;
+  }
+
+  // WebUIBubbleManager:
+  WebUIContentsWrapper* GetContentsWrapper() override {
+    return cached_contents_wrapper();
+  }
+
+ private:
+  // The page is told where it is: in a bubble, loaded ahead (`warm`, it waits
+  // without asking for its state) or for a click (popup_page.js).
+  std::unique_ptr<WebUIContentsWrapper> MakeContents(bool warm) {
+    return std::make_unique<WebUIContentsWrapperT<ThoronAdblockMenuUI>>(
+        GURL(std::string(kThoronAdblockMenuUrl) +
+             (warm ? "?bubble=warm" : "?bubble=open")),
+        browser_->GetProfile(), IDS_THORON_ADBLOCK_MENU);
+  }
+
+  // As WebUIBubbleManagerImpl's.
+  base::WeakPtr<WebUIBubbleDialogView> CreateWebUIBubbleDialog(
+      Anchor anchor,
+      views::BubbleBorder::Arrow arrow) override {
+    set_bubble_using_cached_web_contents(!!cached_contents_wrapper());
+    if (!cached_contents_wrapper()) {
+      set_cached_contents_wrapper(MakeContents(/*warm=*/false));
+    }
+    WebUIContentsWrapper* contents_wrapper = cached_contents_wrapper();
+    webui::SetBrowserWindowInterface(contents_wrapper->web_contents(),
+                                     browser_.get());
+    views::View* anchor_view = nullptr;
+    std::optional<gfx::Rect> anchor_rect;
+    if (std::holds_alternative<raw_ptr<views::View>>(anchor)) {
+      anchor_view = std::get<raw_ptr<views::View>>(anchor);
+      CHECK(anchor_view);
+    } else {
+      anchor_rect = std::get<gfx::Rect>(anchor);
+    }
+    auto bubble_view = std::make_unique<WebUIBubbleDialogView>(
+        anchor_view, contents_wrapper->GetWeakPtr(), anchor_rect, arrow);
+    if (!anchor_view) {
+      gfx::NativeWindow parent_window = browser_->GetWindow()->GetNativeWindow();
+      if (parent_window) {
+        bubble_view->set_parent_window(
+            platform_util::GetViewForWindow(parent_window));
+      }
+    }
+    if (!widget_initialization_callback_.is_null()) {
+      bubble_view->RegisterWidgetInitializedCallback(
+          std::move(widget_initialization_callback_));
+    }
+    auto weak_ptr = bubble_view->GetWeakPtr();
+    views::BubbleDialogDelegateView::CreateBubble(std::move(bubble_view));
+    return weak_ptr;
+  }
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+};
+
+ui::ImageModel ThoronAdblockShield(content::WebContents* tab,
+                                   const views::View* view,
+                                   int size,
+                                   SkColor off_color,
+                                   std::u16string* tooltip) {
+  const Shield shield = ShieldFor(tab);
+  if (tooltip) {
+    *tooltip = ShieldTooltip(shield);
+  }
+  // the address bar's: the image is the icon itself
+  return DrawShield(shield, view, size, /*area=*/size, off_color);
+}
+
+ThoronAdblockButton::ThoronAdblockButton(BrowserWindowInterface* browser)
+    : ToolbarButton(base::BindRepeating(&ThoronAdblockButton::ButtonPressed,
+                                        base::Unretained(this))),
+      browser_(browser) {
+  SetTooltipText(u"Thoron adblock");
+  GetViewAccessibility().SetName(u"Thoron adblock");
+  browser_->GetTabStripModel()->AddObserver(this);
+  Observe(browser_->GetTabStripModel()->GetActiveWebContents());
+  thoron_adblock::AddMenuOpener(this);
+  // base::Unretained is safe: the subscriptions end with this button.
+  blocked_subscription_ = thoron_adblock::BlockedCount::AddObserver(
+      base::BindRepeating(&ThoronAdblockButton::OnBlocked,
+                          base::Unretained(this)));
+  blocking_subscription_ =
+      thoron_adblock::EngineService::Get().AddBlockingObserver(
+          base::BindRepeating(&ThoronAdblockButton::OnStateChanged,
+                              base::Unretained(this)));
+  SetVisible(thoron_adblock::EngineService::Get().ShieldInToolbar());
+  // The image is larger than the shield, as an extension's (the count is in
+  // its corner): the button's insets are smaller by as much, so the button is
+  // as large as the others.
+  SetLayoutInsetDelta(gfx::Insets(-thoron::kToolbarImageMargin / 2));
+  // Moved with the mouse (P5.78): where it is is chrome://adblock's setting,
+  // its place among Thoron's buttons the profile's.
+  drag_ = std::make_unique<thoron::ToolbarDrag>(
+      this, thoron::kAdblockId, prefs(), base::BindRepeating([] {
+        return thoron_adblock::EngineService::Get().Choice("toolbar-position");
+      }),
+      base::BindRepeating([](const std::string& where) {
+        thoron_adblock::EngineService::Get().SetChoice("toolbar-position",
+                                                       where);
+      }));
+  if (PrefService* settings = prefs()) {
+    order_registrar_.Init(settings);
+    // base::Unretained is safe: the registrar ends with this button.
+    order_registrar_.Add(
+        thoron::kToolbarOrderPref,
+        base::BindRepeating(&ThoronAdblockButton::ApplyPosition,
+                            base::Unretained(this)));
+  }
+  // The icon is drawn once the button is in a window (ToolbarButton calls
+  // UpdateIcon() when the theme is known).
+}
+
+ThoronAdblockButton::~ThoronAdblockButton() {
+  thoron_adblock::RemoveMenuOpener(this);
+  browser_->GetTabStripModel()->RemoveObserver(this);
+}
+
+void ThoronAdblockButton::UpdateIcon() {
+  if (!GetWidget() || !GetColorProvider()) {
+    return;
+  }
+  const Shield shield = ShieldFor(web_contents());
+  const ui::ImageModel image =
+      DrawShield(shield, this, GetIconSize(),
+                 GetIconSize() + thoron::kToolbarImageMargin,
+                 GetForegroundColor(ButtonState::STATE_DISABLED));
+  for (auto state : kButtonStates) {
+    SetImageModel(state, image);
+  }
+  SetTooltipText(ShieldTooltip(shield));
+}
+
+void ThoronAdblockButton::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (selection.active_tab_changed()) {
+    Observe(tab_strip_model->GetActiveWebContents());
+    UpdateIcon();
+  }
+}
+
+void ThoronAdblockButton::PrimaryPageChanged(content::Page& page) {
+  // a new page starts at 0
+  UpdateIcon();
+}
+
+void ThoronAdblockButton::OnBlocked(content::Page& page) {
+  content::WebContents* tab = web_contents();
+  if (tab && &tab->GetPrimaryPage() == &page) {
+    UpdateIcon();
+    RefreshAddressBar();
+  }
+}
+
+void ThoronAdblockButton::OnMouseEntered(const ui::MouseEvent& event) {
+  ToolbarButton::OnMouseEntered(event);
+  WarmUpMenu();
+}
+
+void ThoronAdblockButton::AddedToWidget() {
+  ToolbarButton::AddedToWidget();
+  // after the toolbar has made its other buttons
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&ThoronAdblockButton::ApplyPosition,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void ThoronAdblockButton::ApplyPosition() {
+  // with Thoron's other buttons, in their order (P5.78)
+  thoron::ArrangeToolbar(views::AsViewClass<ToolbarView>(parent()));
+}
+
+PrefService* ThoronAdblockButton::prefs() const {
+  Profile* profile = browser_ ? browser_->GetProfile() : nullptr;
+  // kept, also from an off-the-record window
+  return profile ? profile->GetOriginalProfile()->GetPrefs() : nullptr;
+}
+
+bool ThoronAdblockButton::OnMousePressed(const ui::MouseEvent& event) {
+  drag_->Pressed(event);
+  return ToolbarButton::OnMousePressed(event);
+}
+
+bool ThoronAdblockButton::OnMouseDragged(const ui::MouseEvent& event) {
+  if (drag_->Dragged(event)) {
+    return true;
+  }
+  return ToolbarButton::OnMouseDragged(event);
+}
+
+void ThoronAdblockButton::OnMouseReleased(const ui::MouseEvent& event) {
+  if (drag_->Ended()) {
+    // the press moved the shield: it opens no menu
+    OnClickCanceled(event);
+    SetState(STATE_NORMAL);
+    return;
+  }
+  ToolbarButton::OnMouseReleased(event);
+}
+
+void ThoronAdblockButton::OnMouseCaptureLost() {
+  drag_->Ended();
+  ToolbarButton::OnMouseCaptureLost();
+}
+
+void ThoronAdblockButton::OnStateChanged() {
+  ApplyPosition();
+  SetVisible(thoron_adblock::EngineService::Get().ShieldInToolbar());
+  UpdateIcon();
+  RefreshAddressBar();
+}
+
+void ThoronAdblockButton::RefreshAddressBar() {
+  if (address_bar_refresh_pending_) {
+    return;
+  }
+  address_bar_refresh_pending_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&ThoronAdblockButton::DoRefreshAddressBar,
+                     weak_factory_.GetWeakPtr()),
+      kAddressBarRefresh);
+}
+
+void ThoronAdblockButton::DoRefreshAddressBar() {
+  address_bar_refresh_pending_ = false;
+  if (ToolbarView* toolbar = views::AsViewClass<ToolbarView>(parent())) {
+    if (LocationBar* location_bar = toolbar->location_bar()) {
+      location_bar->UpdateContentSettingsIcons();
+    }
+    // where its shield is may have changed (P5.73)
+    if (views::View* location_bar_view = toolbar->location_bar_view()) {
+      location_bar_view->InvalidateLayout();
+    }
+  }
+}
+
+bool ThoronAdblockButton::OpenMenuFor(content::WebContents* tab,
+                                      views::View* anchor) {
+  if (browser_->GetTabStripModel()->GetIndexOfWebContents(tab) ==
+      TabStripModel::kNoTab) {
+    return false;
+  }
+  ShowMenu(anchor);
+  return true;
+}
+
+void ThoronAdblockButton::WarmUpMenuFor(content::WebContents* tab) {
+  if (warm_up_pending_ || browser_->GetTabStripModel()->GetIndexOfWebContents(
+                              tab) == TabStripModel::kNoTab) {
+    return;
+  }
+  // after this call: it comes while the address bar draws its icons
+  warm_up_pending_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&ThoronAdblockButton::WarmUpMenu,
+                                weak_factory_.GetWeakPtr()));
+}
+
+ThoronMenuBubbleManager& ThoronAdblockButton::Menu() {
+  if (!menu_) {
+    menu_ = std::make_unique<ThoronMenuBubbleManager>(browser_);
+  }
+  return *menu_;
+}
+
+void ThoronAdblockButton::WarmUpMenu() {
+  warm_up_pending_ = false;
+  Menu().WarmUp();
+}
+
+void ThoronAdblockButton::ButtonPressed() {
+  ShowMenu(nullptr);
+}
+
+void ThoronAdblockButton::ShowMenu(views::View* anchor) {
+  Menu();
+  // open: this press closes it
+  if (menu_->GetBubbleWidget()) {
+    menu_->CloseBubble();
+    return;
+  }
+  // it closed a moment ago because of this very press (it closes when
+  // anything else is pressed): leave it closed
+  if (!menu_closed_at_.is_null() &&
+      base::TimeTicks::Now() - menu_closed_at_ < kReopenGuard) {
+    return;
+  }
+  views::View* from = anchor;
+  if (!from) {
+    from = this;
+    if (!GetVisible()) {
+      // the shield is not in the toolbar: from the address bar
+      if (ToolbarView* toolbar = views::AsViewClass<ToolbarView>(parent())) {
+        from = toolbar->location_bar_view();
+      }
+    }
+  }
+  if (!from || !menu_->ShowBubble(from, views::BubbleBorder::TOP_RIGHT)) {
+    return;
+  }
+  // A page loaded before (kept for 30 seconds after the menu closed, or
+  // loaded ahead when the pointer came over a shield, P5.72) told the bubble
+  // it was ready when there was no bubble to hear it, and the bubble waits for
+  // that before it shows (P5.71: "the menu did not open"). It is told it is
+  // shown: it brings itself up to date, for the tab now in front, and asks to
+  // be shown, a moment later; if it does not, it is shown as it is. A page
+  // still loading asks to be shown once it has loaded. (Loading the page again
+  // does not help: the new page's controller is not the one the bubble knows.)
+  if (menu_->bubble_using_cached_web_contents()) {
+    ThoronAdblockMenuUI* ui = menu_->MenuUI();
+    if (!ui) {
+      ShowMenuNow();
+    } else {
+      ui->TellShown();
+      show_anyway_.Start(FROM_HERE, kShowAnyway,
+                         base::BindOnce(&ThoronAdblockButton::ShowMenuNow,
+                                        base::Unretained(this)));
+    }
+  }
+  if (views::Widget* widget = menu_->GetBubbleWidget()) {
+    menu_observation_.Reset();
+    menu_observation_.Observe(widget);
+  }
+}
+
+void ThoronAdblockButton::ShowMenuNow() {
+  views::Widget* widget = menu_ ? menu_->GetBubbleWidget() : nullptr;
+  if (widget && !widget->IsVisible()) {
+    if (WebUIContentsWrapper* contents = menu_->GetContentsWrapper()) {
+      contents->ShowUI();
+    }
+  }
+}
+
+void ThoronAdblockButton::OnWidgetDestroying(views::Widget* widget) {
+  menu_closed_at_ = base::TimeTicks::Now();
+  menu_observation_.Reset();
+  show_anyway_.Stop();
+  // the kept page waits quietly until it is shown again
+  if (menu_) {
+    if (ThoronAdblockMenuUI* ui = menu_->MenuUI()) {
+      ui->TellHidden();
+    }
+  }
+}
+
+BEGIN_METADATA(ThoronAdblockButton)
+END_METADATA
