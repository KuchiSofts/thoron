+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_portable_key/recovery_key.h"
+
+#include <stdint.h>
+
+#include <array>
+#include <string_view>
+
+#include "base/containers/span.h"
+#include "crypto/hash.h"
+#include "crypto/random.h"
+#include "third_party/boringssl/src/include/openssl/mem.h"
+
+namespace thoron_portable_key {
+
+namespace {
+
+constexpr size_t kCheckBytes = 4;
+constexpr size_t kAllBytes = kRecoveryKeyBytes + kCheckBytes;  // 160 bits
+constexpr std::string_view kAlphabet = "0123456789ABCDEFGHJKMNPQRSTVWXYZ";
+constexpr char kCheckLabel[] = "Thoron portable recovery key check";
+
+std::array<uint8_t, kCheckBytes> CheckOf(base::span<const uint8_t> key) {
+  crypto::hash::Hasher hasher(crypto::hash::kSha256);
+  hasher.Update(base::as_byte_span(std::string_view(kCheckLabel)));
+  hasher.Update(key);
+  std::array<uint8_t, crypto::hash::kSha256Size> digest;
+  hasher.Finish(digest);
+  std::array<uint8_t, kCheckBytes> check;
+  base::span(check).copy_from(base::span(digest).first<kCheckBytes>());
+  Wipe(digest);
+  return check;
+}
+
+// The value of one character of Crockford's base 32, or -1.
+int ValueOf(char c) {
+  if (c >= 'a' && c <= 'z') {
+    c = static_cast<char>(c - 'a' + 'A');
+  }
+  if (c == 'O') {
+    return 0;
+  }
+  if (c == 'I' || c == 'L') {
+    return 1;
+  }
+  const size_t at = kAlphabet.find(c);
+  return at == std::string_view::npos ? -1 : static_cast<int>(at);
+}
+
+}  // namespace
+
+SecretBytes NewRecoveryKey() {
+  SecretBytes key(kRecoveryKeyBytes);
+  crypto::RandBytes(key.span());
+  return key;
+}
+
+std::string FormatRecoveryKey(const SecretBytes& key) {
+  if (key.size() != kRecoveryKeyBytes) {
+    return std::string();
+  }
+  SecretBytes all(kAllBytes);
+  all.span().first<kRecoveryKeyBytes>().copy_from(
+      key.span().first<kRecoveryKeyBytes>());
+  std::array<uint8_t, kCheckBytes> check = CheckOf(key.span());
+  all.span().last<kCheckBytes>().copy_from(check);
+  Wipe(check);
+  std::string text;
+  text.reserve(kRecoveryKeyCharacters + 7);
+  // 160 bits, five at a time, from the first byte's highest bit
+  for (size_t i = 0; i < kRecoveryKeyCharacters; ++i) {
+    if (i > 0 && i % 4 == 0) {
+      text.push_back('-');
+    }
+    int value = 0;
+    for (size_t bit = i * 5; bit < i * 5 + 5; ++bit) {
+      value = (value << 1) | ((all.span()[bit / 8] >> (7 - bit % 8)) & 1);
+    }
+    text.push_back(kAlphabet.at(static_cast<size_t>(value)));
+  }
+  return text;
+}
+
+std::optional<SecretBytes> ParseRecoveryKey(std::string_view typed) {
+  SecretBytes all(kAllBytes);
+  size_t count = 0;
+  for (char c : typed) {
+    if (c == '-' || c == ' ') {
+      continue;
+    }
+    const int value = ValueOf(c);
+    if (value < 0 || count == kRecoveryKeyCharacters) {
+      return std::nullopt;
+    }
+    for (int bit = 4; bit >= 0; --bit) {
+      const size_t at = count * 5 + static_cast<size_t>(4 - bit);
+      if ((value >> bit) & 1) {
+        all.span()[at / 8] |= static_cast<uint8_t>(0x80 >> (at % 8));
+      }
+    }
+    ++count;
+  }
+  if (count != kRecoveryKeyCharacters) {
+    return std::nullopt;
+  }
+  SecretBytes key(all.span().first<kRecoveryKeyBytes>());
+  std::array<uint8_t, kCheckBytes> check = CheckOf(key.span());
+  const bool holds = CRYPTO_memcmp(check.data(),
+                                   all.span().last<kCheckBytes>().data(),
+                                   kCheckBytes) == 0;
+  Wipe(check);
+  if (!holds) {
+    return std::nullopt;
+  }
+  return key;
+}
+
+}  // namespace thoron_portable_key
diff --git a/components/thoron_portable_key/recovery_key.h b/components/thoron_portable_key/recovery_key.h
