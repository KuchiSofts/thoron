@@ -0,0 +1,324 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_update/delta_package.h"
+
+#include <algorithm>
+#include <random>
+#include <set>
+#include <string>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/files/file_enumerator.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/values.h"
+#include "components/zucchini/buffer_view.h"
+#include "components/zucchini/patch_writer.h"
+#include "components/zucchini/zucchini.h"
+#include "crypto/hash.h"
+#include "components/thoron_update/test_zip.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/zlib/google/zip.h"
+
+namespace thoron_update {
+namespace {
+
+constexpr char kOld[] = "158.0.8127.3000";
+constexpr char kNew[] = "158.0.8127.3010";
+
+std::string Hex(const std::string& data) {
+  return base::HexEncodeLower(crypto::hash::Sha256(data));
+}
+
+std::string Patch(const std::string& from, const std::string& to) {
+  const zucchini::ConstBufferView a(reinterpret_cast<const uint8_t*>(from.data()), from.size());
+  const zucchini::ConstBufferView b(reinterpret_cast<const uint8_t*>(to.data()), to.size());
+  zucchini::EnsemblePatchWriter writer(a, b);
+  EXPECT_EQ(zucchini::GenerateBuffer(a, b, zucchini::GenerateOptions(), &writer),
+            zucchini::status::kStatusSuccess);
+  std::string out(writer.SerializedSize(), '\0');
+  EXPECT_TRUE(writer.SerializeInto(
+      zucchini::MutableBufferView(reinterpret_cast<uint8_t*>(out.data()), out.size())));
+  return out;
+}
+
+class ThoronUpdateDeltaTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(dir_.CreateUniqueTempDir());
+    old_folder_ = dir_.GetPath().AppendASCII("Application").AppendASCII(kOld);
+    // The older version's folder: a file that stays, one that changes, one that goes.
+    Put(old_folder_, "thoron.exe", launcher_);
+    Put(old_folder_, std::string(kOld) + "/chrome.dll", old_dll_);
+    Put(old_folder_, std::string(kOld) + "/gone.dat", "gone");
+  }
+
+  void Put(const base::FilePath& root, const std::string& relative, const std::string& data) {
+    const base::FilePath path = root.Append(base::FilePath::FromUTF8Unsafe(relative));
+    ASSERT_TRUE(base::CreateDirectory(path.DirName()));
+    ASSERT_TRUE(base::WriteFile(path, data));
+  }
+
+  // A delta as tools/release/delta.py makes it, changed by `change` first.
+  base::FilePath Delta(base::RepeatingCallback<void(base::DictValue&)> change = {},
+                       const std::string& patch_bytes = "") {
+    base::ListValue files;
+    auto add = [&](const std::string& path, const std::string& data, const std::string& how,
+                   const std::string& from_path, const std::string& from_data) {
+      base::DictValue entry;
+      entry.Set("path", path);
+      entry.Set("size", static_cast<double>(data.size()));
+      entry.Set("sha256", Hex(data));
+      entry.Set("how", how);
+      if (how != "whole") {
+        entry.Set("from_path", from_path);
+        entry.Set("from_sha256", Hex(from_data));
+      }
+      files.Append(std::move(entry));
+    };
+    add("thoron.exe", launcher_, "same", "thoron.exe", launcher_);
+    add(std::string(kNew) + "/chrome.dll", new_dll_, "patch", std::string(kOld) + "/chrome.dll",
+        old_dll_);
+    add(std::string(kNew) + "/new.dat", "new", "whole", "", "");
+    base::DictValue list;
+    list.Set("format", 1);
+    list.Set("from", kOld);
+    list.Set("to", kNew);
+    list.Set("files", std::move(files));
+    if (change) {
+      change.Run(list);
+    }
+    const base::FilePath tree = dir_.GetPath().AppendASCII("tree" + base::NumberToString(++made_));
+    std::string json;
+    EXPECT_TRUE(base::JSONWriter::Write(list, &json));
+    Put(tree, "delta.json", json);
+    Put(tree, "patch/1", patch_bytes.empty() ? Patch(old_dll_, new_dll_) : patch_bytes);
+    Put(tree, "whole/2", "new");
+    const base::FilePath zip = dir_.GetPath().AppendASCII("d" + base::NumberToString(made_) + ".delta");
+    EXPECT_TRUE(zip::Zip(tree, zip, true));
+    return zip;
+  }
+
+  DeltaResult Apply(const base::FilePath& delta, std::vector<VersionFile>* files) {
+    return ApplyDelta(delta, old_folder_, *ParseBuildVersion(kOld), *ParseBuildVersion(kNew), Staged(),
+                      files);
+  }
+
+  base::FilePath Staged() { return dir_.GetPath().AppendASCII("Application").AppendASCII("s.staging"); }
+
+  base::ScopedTempDir dir_;
+  base::FilePath old_folder_;
+  int made_ = 0;
+  const std::string launcher_ = "the launcher, unchanged";
+  const std::string old_dll_ = std::string(3000, 'a') + "an engine of the older version" + std::string(500, 'b');
+  const std::string new_dll_ = std::string(3000, 'a') + "an engine of the NEWER version!" + std::string(520, 'b');
+};
+
+TEST_F(ThoronUpdateDeltaTest, TheNewerFolderIsMadeAndListed) {
+  std::vector<VersionFile> files;
+  ASSERT_EQ(Apply(Delta(), &files), DeltaResult::kDone);
+  ASSERT_EQ(files.size(), 3u);
+  std::string read;
+  ASSERT_TRUE(base::ReadFileToString(Staged().AppendASCII(kNew).AppendASCII("chrome.dll"), &read));
+  EXPECT_EQ(read, new_dll_);
+  ASSERT_TRUE(base::ReadFileToString(Staged().AppendASCII("thoron.exe"), &read));
+  EXPECT_EQ(read, launcher_);
+  ASSERT_TRUE(base::ReadFileToString(Staged().AppendASCII(kNew).AppendASCII("new.dat"), &read));
+  EXPECT_EQ(read, "new");
+  // the file the newer version does not have is not made
+  EXPECT_FALSE(base::PathExists(Staged().AppendASCII(kNew).AppendASCII("gone.dat")));
+  EXPECT_EQ(files[1].sha256, Hex(new_dll_));
+}
+
+// An installed copy (P4.1): the delta also makes the newer setup.exe, from the
+// one the installed copy keeps in its version folder, and that setup is the
+// command that installs the staged folder.
+TEST_F(ThoronUpdateDeltaTest, AnInstalledCopysDeltaGivesTheNewerSetupToInstallIt) {
+  const std::string setup = "the older setup, the same in the newer version";
+  Put(old_folder_, std::string(kOld) + "/Installer/setup.exe", setup);
+  const auto with_setup = base::BindRepeating(
+      [](const std::string& data, base::DictValue& d) {
+        base::DictValue entry;
+        entry.Set("path", std::string(kNew) + "/Installer/setup.exe");
+        entry.Set("size", static_cast<double>(data.size()));
+        entry.Set("sha256", Hex(data));
+        entry.Set("how", "same");
+        entry.Set("from_path", std::string(kOld) + "/Installer/setup.exe");
+        entry.Set("from_sha256", Hex(data));
+        d.FindList("files")->Append(std::move(entry));
+      },
+      setup);
+  for (const bool system_level : {false, true}) {
+    base::DeletePathRecursively(Staged());
+    base::CommandLine command(base::CommandLine::NO_PROGRAM);
+    ASSERT_EQ(PrepareInstalledDelta(Delta(with_setup), old_folder_, *ParseBuildVersion(kOld),
+                                    *ParseBuildVersion(kNew), system_level, Staged(), &command),
+              DeltaResult::kDone);
+    EXPECT_EQ(command.GetProgram(),
+              Staged().AppendASCII(kNew).AppendASCII("Installer").AppendASCII("setup.exe"));
+    EXPECT_EQ(command.GetSwitchValuePath("thoron-chrome-bin"), Staged());
+    EXPECT_TRUE(command.HasSwitch("do-not-launch-chrome"));
+    EXPECT_EQ(command.HasSwitch("system-level"), system_level);
+    std::string read;
+    ASSERT_TRUE(base::ReadFileToString(command.GetProgram(), &read));
+    EXPECT_EQ(read, setup);
+    ASSERT_TRUE(base::ReadFileToString(Staged().AppendASCII(kNew).AppendASCII("chrome.dll"), &read));
+    EXPECT_EQ(read, new_dll_);
+  }
+}
+
+TEST_F(ThoronUpdateDeltaTest, ADeltaWithoutASetupIsNotOneForInstalledCopies) {
+  base::CommandLine command(base::CommandLine::NO_PROGRAM);
+  EXPECT_EQ(PrepareInstalledDelta(Delta(), old_folder_, *ParseBuildVersion(kOld),
+                                  *ParseBuildVersion(kNew), false, Staged(), &command),
+            DeltaResult::kNotADelta);
+  EXPECT_FALSE(base::PathExists(Staged()));
+  EXPECT_TRUE(command.GetProgram().empty());
+}
+
+TEST_F(ThoronUpdateDeltaTest, ADeltaForOtherVersionsIsRefused) {
+  std::vector<VersionFile> files;
+  EXPECT_EQ(Apply(Delta(base::BindRepeating([](base::DictValue& d) { d.Set("from", "158.0.8127.2000"); })),
+                  &files),
+            DeltaResult::kWrongVersion);
+  EXPECT_FALSE(base::PathExists(Staged()));
+}
+
+TEST_F(ThoronUpdateDeltaTest, AnOlderFileThatIsNotTheOneNamedIsNeverUsed) {
+  Put(old_folder_, std::string(kOld) + "/chrome.dll", old_dll_ + "x");
+  std::vector<VersionFile> files;
+  EXPECT_EQ(Apply(Delta(), &files), DeltaResult::kOldFileDiffers);
+  EXPECT_FALSE(base::PathExists(Staged()));
+  EXPECT_TRUE(files.empty());
+}
+
+TEST_F(ThoronUpdateDeltaTest, APatchThatDoesNotApplyOrGivesAnotherFileIsRefused) {
+  std::vector<VersionFile> files;
+  EXPECT_EQ(Apply(Delta({}, "not a patch at all"), &files), DeltaResult::kPatchFails);
+  EXPECT_FALSE(base::PathExists(Staged()));
+  // a valid patch to another file: made, then found not to be the newer one
+  const std::string other = new_dll_ + "?";
+  EXPECT_EQ(Apply(Delta({}, Patch(old_dll_, other)), &files), DeltaResult::kPatchFails);
+  EXPECT_FALSE(base::PathExists(Staged()));
+}
+
+TEST_F(ThoronUpdateDeltaTest, APathThatLeavesTheFolderIsRefused) {
+  std::vector<VersionFile> files;
+  for (const char* path : {"../outside.exe", "a/../../b", "C:/x", "a\\b", ""}) {
+    SCOPED_TRACE(path);
+    const std::string bad = path;
+    EXPECT_EQ(Apply(Delta(base::BindRepeating(
+                        [](const std::string& bad, base::DictValue& d) {
+                          (*d.FindList("files"))[2].GetDict().Set("path", bad);
+                        },
+                        bad)),
+                    &files),
+              DeltaResult::kNotADelta);
+    EXPECT_FALSE(base::PathExists(Staged()));
+  }
+}
+
+TEST_F(ThoronUpdateDeltaTest, AnEntryThatClimbsOutOfTheFolderIsRefused) {
+  const std::vector<TestZipEntry> good = ReadTestZip(Delta());
+  ASSERT_FALSE(good.empty());
+  std::vector<VersionFile> files;
+  // The test zips are written by WriteTestZip; one it writes is a good delta.
+  const base::FilePath rewritten = dir_.GetPath().AppendASCII("rewritten.delta");
+  ASSERT_TRUE(WriteTestZip(rewritten, good));
+  ASSERT_EQ(Apply(rewritten, &files), DeltaResult::kDone);
+  ASSERT_TRUE(base::DeletePathRecursively(Staged()));
+  for (const char* bad : {"../outside.txt", "a/../../outside.txt", "./delta.json"}) {
+    SCOPED_TRACE(bad);
+    std::vector<TestZipEntry> crafted = good;
+    crafted.insert(crafted.begin(), {bad, "not from the delta"});
+    const base::FilePath zip = dir_.GetPath().AppendASCII("crafted.delta");
+    ASSERT_TRUE(WriteTestZip(zip, crafted));
+    EXPECT_EQ(Apply(zip, &files), DeltaResult::kNotADelta);
+    EXPECT_FALSE(base::PathExists(Staged()));
+    EXPECT_FALSE(base::PathExists(dir_.GetPath().AppendASCII("outside.txt")));
+    EXPECT_FALSE(base::PathExists(dir_.GetPath().AppendASCII("Application").AppendASCII("outside.txt")));
+  }
+}
+
+TEST_F(ThoronUpdateDeltaTest, ADamagedFileListNeverCrashesOrWritesOutsideTheFolder) {
+  // THREAT_MODEL U9: a fixed mutation run over delta.json (not a coverage-guided fuzzer, which needs a
+  // libFuzzer build): flipped bytes, cut and doubled pieces, inserted characters, a cut end. Each damaged
+  // delta ends in a result; one refused leaves no staging folder, and nothing outside it is ever touched.
+  std::vector<TestZipEntry> good = ReadTestZip(Delta());
+  auto list = std::find_if(good.begin(), good.end(), [](const TestZipEntry& e) { return e.name == "delta.json"; });
+  ASSERT_NE(list, good.end());
+  const std::string json = list->content;
+  const base::FilePath zip = dir_.GetPath().AppendASCII("damaged.delta");
+  auto files_outside = [&] {
+    std::set<std::string> out;
+    base::FileEnumerator all(dir_.GetPath(), true, base::FileEnumerator::FILES);
+    for (base::FilePath path = all.Next(); !path.empty(); path = all.Next()) {
+      if (path != zip && !Staged().IsParent(path)) {
+        out.insert(path.AsUTF8Unsafe());
+      }
+    }
+    return out;
+  };
+  const std::set<std::string> before = files_outside();
+  std::mt19937 random(20261117);
+  const char kInserts[] = "{}[]\",:./\\0-9eE\x01 nullfalsetrue\xff";
+  int done = 0;
+  for (int round = 0; round < 1000; ++round) {
+    std::string damaged = json;
+    const int changes = 1 + static_cast<int>(random() % 4);
+    for (int c = 0; c < changes && !damaged.empty(); ++c) {
+      const size_t at = random() % damaged.size();
+      switch (random() % 5) {
+        case 0:
+          damaged[at] = static_cast<char>(damaged[at] ^ (1 << (random() % 8)));
+          break;
+        case 1:
+          damaged.erase(at, 1 + random() % 16);
+          break;
+        case 2:
+          damaged.insert(at, damaged.substr(at, 1 + random() % 24));
+          break;
+        case 3:
+          damaged.insert(at, 1, kInserts[random() % (sizeof(kInserts) - 1)]);
+          break;
+        default:
+          damaged.resize(at);
+          break;
+      }
+    }
+    std::vector<TestZipEntry> entries = good;
+    for (TestZipEntry& e : entries) {
+      if (e.name == "delta.json") {
+        e.content = damaged;
+      }
+    }
+    ASSERT_TRUE(WriteTestZip(zip, entries));
+    std::vector<VersionFile> files;
+    const DeltaResult result = Apply(zip, &files);
+    if (result == DeltaResult::kDone) {
+      ++done;                                // a change JSON does not mind, such as a space
+      ASSERT_TRUE(base::DeletePathRecursively(Staged()));
+    } else {
+      EXPECT_FALSE(base::PathExists(Staged())) << "round " << round;
+    }
+    ASSERT_EQ(files_outside(), before) << "round " << round;
+  }
+  // nearly every damaged list is refused
+  EXPECT_LT(done, 100);
+}
+
+TEST_F(ThoronUpdateDeltaTest, NotADeltaAtAll) {
+  ASSERT_TRUE(base::WriteFile(dir_.GetPath().AppendASCII("x.delta"), "not a zip"));
+  std::vector<VersionFile> files;
+  EXPECT_EQ(Apply(dir_.GetPath().AppendASCII("x.delta"), &files), DeltaResult::kNotADelta);
+  EXPECT_EQ(Apply(Delta(base::BindRepeating([](base::DictValue& d) { d.Set("format", 2); })), &files),
+            DeltaResult::kNotADelta);
+}
+
+}  // namespace
+}  // namespace thoron_update
