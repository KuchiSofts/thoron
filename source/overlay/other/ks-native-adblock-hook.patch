@@ -0,0 +1,76 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_PORTABLE_KEY_KEY_STORE_H_
+#define COMPONENTS_THORON_PORTABLE_KEY_KEY_STORE_H_
+
+#include <stdint.h>
+
+#include <optional>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "components/thoron_portable_key/key_file.h"
+
+namespace thoron_portable_key {
+
+// The key file's place: "Thoron Portable Key" in the portable copy's User
+// Data folder, next to Local State.
+inline constexpr base::FilePath::CharType kKeyFileName[] =
+    FILE_PATH_LITERAL("Thoron Portable Key");
+
+// Writing a key file never leaves a copy that cannot be opened, even when the
+// drive is pulled out at any moment (threat model E3). A new file is written
+// whole beside the old one and flushed ("... .new"), the old one is moved
+// aside ("... .old"), the new one takes its name, and the old one goes:
+//
+//   1. write and flush  Thoron Portable Key.new
+//   2. move             Thoron Portable Key     -> Thoron Portable Key.old
+//   3. move             Thoron Portable Key.new -> Thoron Portable Key
+//   4. remove           Thoron Portable Key.old
+//
+// ReadKeyFile() finishes or undoes what an interrupted write left: with the
+// file in its place, any ".new" (an unfinished or unconfirmed change) and any
+// ".old" go; without it, a ".new" that reads as a key file is complete
+// (step 2 comes only after the flush) and takes the place, else the ".old"
+// is put back. A changed passphrase therefore counts from step 2 on; before
+// that, the previous passphrase still opens the copy.
+
+enum class StoreProblem {
+  kNone,
+  kNoKeyFile,  // the copy has no key file: it is not locked with a passphrase
+  kUnreadable, // the file could not be read, or a finishing move failed
+  kBadFile,    // see `read_problem`
+};
+
+struct StoredKeyFile {
+  StoredKeyFile();
+  StoredKeyFile(StoredKeyFile&&);
+  StoredKeyFile& operator=(StoredKeyFile&&);
+  ~StoredKeyFile();
+
+  StoreProblem problem = StoreProblem::kNone;
+  ReadProblem read_problem = ReadProblem::kNone;
+  std::optional<KeyFile> file;
+};
+
+// The key file of the User Data folder `folder`, after finishing what an
+// interrupted write left there.
+StoredKeyFile ReadKeyFile(const base::FilePath& folder);
+
+// For the tests of a pulled drive: called after each numbered step above;
+// returning false stops the write there, as a pulled drive would.
+using AfterStep = base::RepeatingCallback<bool(int step)>;
+
+// Writes `bytes` as the key file of `folder` in the four steps above. False
+// when a step fails (or `after_step` stops it); what is left is what
+// ReadKeyFile() then finishes or undoes.
+bool WriteKeyFile(const base::FilePath& folder,
+                  base::span<const uint8_t> bytes,
+                  const AfterStep& after_step = AfterStep());
+
+}  // namespace thoron_portable_key
+
+#endif  // COMPONENTS_THORON_PORTABLE_KEY_KEY_STORE_H_
diff --git a/components/thoron_portable_key/key_store_unittest.cc b/components/thoron_portable_key/key_store_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..8d64f9c8e695b7af9906e78e3c4a5b32339c6e18
--- /dev/null
+++ b/components/thoron_portable_key/key_store_unittest.cc
@@ -0,0 +1,158 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_portable_key/key_store.h"
+
+#include <stdint.h>
+
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/functional/bind.h"
+#include "components/thoron_portable_key/key_file.h"
+#include "components/thoron_portable_key/local_state_key.h"
+#include "crypto/random.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace thoron_portable_key {
+namespace {
+
+// A key file's bytes made without Argon2id: what matters here is which file a
+// read finds, so the locks are random bytes and the MAC is made with a key of
+// the test's own.
+std::vector<uint8_t> FakeKeyFile(uint8_t mark) {
+  KeyFile file;
+  file.passphrase.params = kFloor;
+  crypto::RandBytes(file.passphrase.salt);
+  crypto::RandBytes(file.passphrase.nonce);
+  file.passphrase.sealed.fill(mark);
+  SecretBytes key(kProfileKeyBytes);
+  crypto::RandBytes(key.span());
+  return SerializeKeyFile(file, key);
+}
+
+class ThoronKeyStoreTest : public testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(dir_.CreateUniqueTempDir()); }
+
+  base::FilePath Main() const { return dir_.GetPath().Append(kKeyFileName); }
+  base::FilePath New() const { return Main().AddExtensionASCII("new"); }
+  base::FilePath Old() const { return Main().AddExtensionASCII("old"); }
+
+  // The sealed bytes' mark of the file a read finds, or -1.
+  int Found() {
+    StoredKeyFile stored = ReadKeyFile(dir_.GetPath());
+    if (!stored.file) {
+      return -1;
+    }
+    EXPECT_EQ(stored.problem, StoreProblem::kNone);
+    return stored.file->passphrase.sealed[0];
+  }
+
+  base::ScopedTempDir dir_;
+};
+
+TEST_F(ThoronKeyStoreTest, WritesAndReads) {
+  EXPECT_EQ(ReadKeyFile(dir_.GetPath()).problem, StoreProblem::kNoKeyFile);
+  ASSERT_TRUE(WriteKeyFile(dir_.GetPath(), FakeKeyFile(1)));
+  EXPECT_EQ(Found(), 1);
+  ASSERT_TRUE(WriteKeyFile(dir_.GetPath(), FakeKeyFile(2)));
+  EXPECT_EQ(Found(), 2);
+  EXPECT_FALSE(base::PathExists(New()));
+  EXPECT_FALSE(base::PathExists(Old()));
+}
+
+// Threat model E3: the drive pulled out after each step of a first setup and
+// of a change. Every time, the copy has a key file that reads: in a change, the
+// previous one before step 2 and the new one from step 2 on; in a first setup
+// the new one (it is complete after step 1, and there is no other); and
+// nothing is left beside it.
+TEST_F(ThoronKeyStoreTest, PulledDriveAtEveryStep) {
+  for (int stop = 1; stop <= 4; ++stop) {
+    for (bool first_setup : {true, false}) {
+      ASSERT_TRUE(base::DeletePathRecursively(dir_.GetPath()));
+      ASSERT_TRUE(base::CreateDirectory(dir_.GetPath()));
+      if (!first_setup) {
+        ASSERT_TRUE(WriteKeyFile(dir_.GetPath(), FakeKeyFile(1)));
+      }
+      const bool done = WriteKeyFile(
+          dir_.GetPath(), FakeKeyFile(2),
+          base::BindRepeating([](int stop, int step) { return step < stop; },
+                              stop));
+      EXPECT_FALSE(done);
+      const int expected = (stop >= 2 || first_setup) ? 2 : 1;
+      EXPECT_EQ(Found(), expected) << "stop " << stop << " first " << first_setup;
+      EXPECT_FALSE(base::PathExists(New())) << stop;
+      EXPECT_FALSE(base::PathExists(Old())) << stop;
+      // and a second read finds the same
+      EXPECT_EQ(Found(), expected) << stop;
+    }
+  }
+}
+
+// A write cut off in its first step leaves part of a file: it is dropped, and
+// the file in its place, or the one moved aside, is what is read.
+TEST_F(ThoronKeyStoreTest, PartOfANewFile) {
+  const std::vector<uint8_t> whole = FakeKeyFile(2);
+  const std::vector<uint8_t> part(whole.begin(), whole.begin() + 40);
+  ASSERT_TRUE(WriteKeyFile(dir_.GetPath(), FakeKeyFile(1)));
+  ASSERT_TRUE(base::WriteFile(New(), part));
+  EXPECT_EQ(Found(), 1);
+  EXPECT_FALSE(base::PathExists(New()));
+
+  ASSERT_TRUE(base::Move(Main(), Old()));
+  ASSERT_TRUE(base::WriteFile(New(), part));
+  EXPECT_EQ(Found(), 1);
+  EXPECT_TRUE(base::PathExists(Main()));
+  EXPECT_FALSE(base::PathExists(New()));
+  EXPECT_FALSE(base::PathExists(Old()));
+}
+
+TEST_F(ThoronKeyStoreTest, ADamagedFileDoesNotCostTheGoodOneBesideIt) {
+  // a write moved the file aside (.old) and put the new one in place, which
+  // the drive then damaged: the old one is read, the damaged one kept aside
+  ASSERT_TRUE(base::WriteFile(Old(), FakeKeyFile(1)));
+  ASSERT_TRUE(base::WriteFile(Main(), "damaged by the drive"));
+  EXPECT_EQ(Found(), 1);
+  EXPECT_FALSE(base::PathExists(Old()));
+  EXPECT_TRUE(base::PathExists(Main().AddExtensionASCII("damaged")));
+
+  // a complete new file beside a damaged one in place comes before an old one
+  ASSERT_TRUE(base::WriteFile(Old(), FakeKeyFile(1)));
+  ASSERT_TRUE(base::WriteFile(New(), FakeKeyFile(2)));
+  ASSERT_TRUE(base::WriteFile(Main(), "damaged again"));
+  EXPECT_EQ(Found(), 2);
+  EXPECT_FALSE(base::PathExists(New()));
+
+  // nothing good beside it: the damaged file stays where it is, with its problem
+  ASSERT_TRUE(base::DeleteFile(Old()));
+  ASSERT_TRUE(base::WriteFile(Main(), "damaged, and nothing beside it"));
+  StoredKeyFile stored = ReadKeyFile(dir_.GetPath());
+  EXPECT_FALSE(stored.file);
+  EXPECT_EQ(stored.problem, StoreProblem::kBadFile);
+  EXPECT_TRUE(base::PathExists(Main()));
+
+  // the lock's removal takes the damaged copy too
+  EXPECT_TRUE(RemoveKeyFile(dir_.GetPath()));
+  EXPECT_FALSE(base::PathExists(Main().AddExtensionASCII("damaged")));
+}
+
+TEST_F(ThoronKeyStoreTest, WhatIsNotAKeyFile) {
+  ASSERT_TRUE(base::WriteFile(Main(), "not a key file at all"));
+  StoredKeyFile stored = ReadKeyFile(dir_.GetPath());
+  EXPECT_FALSE(stored.file);
+  EXPECT_EQ(stored.problem, StoreProblem::kBadFile);
+  EXPECT_EQ(stored.read_problem, ReadProblem::kNotAKeyFile);
+
+  // far larger than any key file
+  ASSERT_TRUE(base::WriteFile(Main(), std::string(100 * 1024, 'x')));
+  stored = ReadKeyFile(dir_.GetPath());
+  EXPECT_FALSE(stored.file);
+  EXPECT_EQ(stored.problem, StoreProblem::kUnreadable);
+}
+
+}  // namespace
+}  // namespace thoron_portable_key
