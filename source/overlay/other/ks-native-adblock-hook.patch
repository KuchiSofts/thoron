+
+#ifndef CHROME_BROWSER_THORON_UPDATE_THORON_UPDATE_LINUX_H_
+#define CHROME_BROWSER_THORON_UPDATE_THORON_UPDATE_LINUX_H_
+
+#include <string>
+
+#include "components/thoron_update/update_client.h"
+
+namespace base {
+class FilePath;
+}  // namespace base
+
+// The browser's updater on Linux (ROADMAP P3.23), as on Windows
+// (thoron_update_win.h): the update client of this copy, and the looks it takes
+// on its own. A copy that updates itself is one whose version folder sits
+// beside the file `current` (the portable package, and the per-user install of
+// design 7.5a); its own updater (thoron_update) puts a checked release in place,
+// and the next start runs it. A copy installed by the system's package manager
+// (the .deb) is updated by it: the client only says what is out, and looks only
+// when the person opens the About page.
+namespace thoron_update_linux {
+
+// The update client of this copy, made on first use; on the UI thread.
+thoron_update::UpdateClient* Client();
+
+// The client's configuration for this copy. Exposed for tests.
+thoron_update::UpdateClient::Config ConfigForThisCopy();
+
+// The folder with this copy's version folders and `current`, or an empty path
+// for a copy the package manager installed.
+base::FilePath SelfUpdatingFolder();
+
+// The looks the copy takes on its own: a few minutes after the start, then
+// every few hours, in the update mode `auto` only; none for a copy the package
+// manager installed.
+void StartScheduledChecks();
+
+// The update of a copy that updates itself: its own updater unpacks the
+// version's folder of the checked package (thoron_update --apply-package), or
+// makes it from this version's folder with a delta (--apply-delta), and puts it
+// in place.
+bool RunSelfUpdate(const base::FilePath& package, bool delta, const std::string& version);
+
+}  // namespace thoron_update_linux
+
+#endif  // CHROME_BROWSER_THORON_UPDATE_THORON_UPDATE_LINUX_H_
diff --git a/chrome/browser/thoron_update/thoron_update_win.cc b/chrome/browser/thoron_update/thoron_update_win.cc
new file mode 100644
index 0000000000000000000000000000000000000000..bda1e9ed270116f45333d33e2c5a563efb452af7
--- /dev/null
+++ b/chrome/browser/thoron_update/thoron_update_win.cc
@@ -0,0 +1,232 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/thoron_update/thoron_update_win.h"
+
+#include <optional>
+#include <string>
+
+#include "base/base64.h"
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/no_destructor.h"
+#include "base/path_service.h"
+#include "base/process/launch.h"
+#include "base/process/process.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/time/default_clock.h"
+#include "base/time/time.h"
+#include "base/version_info/version_info.h"
+#include "base/version.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/upgrade_detector/build_state.h"
+#include "chrome/install_static/install_util.h"
+#include "components/thoron_update/cli.h"
+#include "components/thoron_update/delta_package.h"
+#include "content/public/browser/browser_thread.h"
+#include "net/base/network_change_notifier.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+
+namespace thoron_update_win {
+
+namespace {
+
+// The build's own values (chrome/browser/thoron_update/BUILD.gn).
+constexpr char kPublicKey[] = THORON_UPDATE_PUBLIC_KEY;
+constexpr char kManifestUrl[] = THORON_UPDATE_MANIFEST_URL;
+constexpr char kChannel[] = THORON_UPDATE_CHANNEL;
+constexpr char kVariant[] = THORON_UPDATE_VARIANT;
+
+constexpr base::TimeDelta kFirstLook = base::Minutes(10);
+constexpr base::TimeDelta kBetweenLooks = base::Hours(5);
+constexpr base::TimeDelta kMostInstallerTime = base::Minutes(15);
+
+// The installer's exit codes that mean it installed
+// (chrome/installer/util/util_constants.h): FIRST_INSTALL_SUCCESS,
+// INSTALL_REPAIRED, NEW_VERSION_UPDATED, IN_USE_UPDATED.
+constexpr int kInstalledCodes[] = {0, 1, 2, 30};
+
+// The program folder of this copy: the one with the version folders. An
+// installed copy has thoron.exe in it; a portable one (launcher/) has the
+// version folder's thoron.exe, one folder further down.
+base::FilePath ProgramFolder(bool* portable) {
+  base::FilePath exe;
+  base::PathService::Get(base::DIR_EXE, &exe);
+  const base::FilePath parent = exe.DirName();
+  *portable = base::PathExists(parent.AppendASCII("current")) &&
+              base::PathExists(parent.DirName().AppendASCII("Thoron.exe"));
+  return *portable ? parent : exe;
+}
+
+void ScheduledLook() {
+  bool portable = false;
+  const thoron_update::UpdateMode mode = thoron_update::ReadUpdateMode(ProgramFolder(&portable));
+  if (mode == thoron_update::UpdateMode::kAuto) {
+    Client()->Check(/*install=*/true, base::DoNothing(), /*asked=*/false);
+  }
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, base::BindOnce(&ScheduledLook), kBetweenLooks);
+}
+
+// The relaunch badge (P3.6): Chromium's build state learns of the installed
+// version, and its upgrade detector shows the menu's relaunch item; a critical
+// release asks sooner.
+void TellBuildState(const std::string& version, bool critical) {
+  const base::Version installed(version);
+  if (!installed.IsValid()) {
+    return;
+  }
+  g_browser_process->GetBuildState()->SetUpdate(
+      BuildState::UpdateType::kNormalUpdate, installed,
+      critical ? std::optional<base::Version>(installed) : std::nullopt);
+}
+
+}  // namespace
+
+bool InstallerSucceeded(int exit_code) {
+  for (int code : kInstalledCodes) {
+    if (exit_code == code) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool RunPortableUpdate(const base::FilePath& package, bool delta, const std::string& version) {
+  base::FilePath exe;
+  base::PathService::Get(base::DIR_EXE, &exe);
+  bool portable = false;
+  const base::FilePath root = ProgramFolder(&portable);
+  if (!portable) {
+    return false;
+  }
+  base::CommandLine command(exe.Append(FILE_PATH_LITERAL("thoron_update.exe")));
+  command.AppendSwitchPath("root", root);
+  // A delta makes the new version from this one's folder (P4.1); a package
+  // holds it whole.
+  command.AppendSwitchPath(delta ? "apply-delta" : "apply-package", package);
+  command.AppendSwitchASCII("version", version);
+  base::LaunchOptions options;
+  options.start_hidden = true;
+  base::Process process = base::LaunchProcess(command, options);
+  if (!process.IsValid()) {
+    return false;
+  }
+  int exit_code = -1;
+  if (!process.WaitForExitWithTimeout(kMostInstallerTime, &exit_code)) {
+    process.Terminate(/*exit_code=*/1, /*wait=*/false);
+    return false;
+  }
+  return exit_code == 0;
+}
+
+bool RunInstaller(const base::FilePath& package, bool delta, const std::string& version) {
+  base::CommandLine command(package);
+  base::FilePath staged;
+  if (delta) {
+    // P4.1: the next version is made from this copy's own Application folder
+    // with the delta, and installed by the newer setup.exe the delta made.
+    const std::optional<thoron_update::BuildVersion> from =
+        thoron_update::ParseBuildVersion(version_info::GetVersionNumber());
+    const std::optional<thoron_update::BuildVersion> to = thoron_update::ParseBuildVersion(version);
+    bool portable = false;
+    const base::FilePath program = ProgramFolder(&portable);
+    if (!from || !to || portable) {
+      return false;
+    }
+    staged = package.DirName().AppendASCII(version + ".staging");
+    base::DeletePathRecursively(staged);
+    if (thoron_update::PrepareInstalledDelta(package, program, *from, *to, /*system_level=*/false,
+                                             staged, &command) != thoron_update::DeltaResult::kDone) {
+      return false;
+    }
+  } else {
+    // Without --silent the installer shows its Install and OK buttons and
+    // waits for them; the running browser stays as it is, and the new version
+    // starts at the relaunch.
+    command.AppendSwitch("silent");
+    command.AppendSwitch("do-not-launch-chrome");
+  }
+  base::LaunchOptions options;
+  options.start_hidden = true;
+  base::Process process = base::LaunchProcess(command, options);
+  int exit_code = -1;
+  const bool ended = process.IsValid() && process.WaitForExitWithTimeout(kMostInstallerTime, &exit_code);
+  if (process.IsValid() && !ended) {
+    process.Terminate(/*exit_code=*/1, /*wait=*/false);
+  }
+  if (!staged.empty()) {
+    base::DeletePathRecursively(staged);
+  }
+  return ended && InstallerSucceeded(exit_code);
+}
+
+thoron_update::UpdateClient::Config ConfigForThisCopy() {
+  thoron_update::UpdateClient::Config config;
+  std::string key;
+  if (base::Base64Decode(kPublicKey, &key) && key.size() == thoron_update::kPublicKeyBytes) {
+    std::copy(key.begin(), key.end(), config.public_key.begin());
+  }
+  config.allowed_hosts = {"github.com"};
+  config.manifest_url = GURL(kManifestUrl);
+  config.channel = kChannel;
+  const std::optional<thoron_update::BuildVersion> version =
+      thoron_update::ParseBuildVersion(version_info::GetVersionNumber());
+  if (version) {
+    config.installed = *version;
+    config.updater = *version;
+  }
+  config.variant =
+      thoron_update::ParseVariant(kVariant).value_or(thoron_update::Variant::kWinX64Sse4);
+  config.on_installed = base::BindRepeating(&TellBuildState);
+  // A metered connection (a phone's hotspot, a data plan): the looks on a
+  // schedule download nothing then (P4.3).
+  config.is_metered = base::BindRepeating([] {
+    return net::NetworkChangeNotifier::GetConnectionCost() ==
+           net::NetworkChangeNotifier::CONNECTION_COST_METERED;
+  });
+  bool portable = false;
+  const base::FilePath program = ProgramFolder(&portable);
+  config.kind = portable ? thoron_update::Kind::kPortable : thoron_update::Kind::kInstalled;
+  if (portable) {
+    // Beside the version folders, never in the package's User Data.
+    config.download_dir = program.AppendASCII("Update");
+    config.install = base::BindRepeating(&RunPortableUpdate);
+  } else if (install_static::IsSystemInstall()) {
+    // An install for every user: its installer needs administrator rights,
+    // and the updater never asks for them (P3.10), so it only says what is out.
+    config.by_hand =
+        "this copy is installed for every user of this computer, so someone with administrator "
+        "rights installs the update with Thoron's installer";
+  } else {
+    // %LOCALAPPDATA%\Thoron\Update, beside Application and User Data.
+    config.download_dir = program.DirName().AppendASCII("Update");
+    config.install = base::BindRepeating(&RunInstaller);
+  }
+  return config;
+}
+
+thoron_update::UpdateClient* Client() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  static base::NoDestructor<std::unique_ptr<thoron_update::UpdateClient>> client(
+      std::make_unique<thoron_update::UpdateClient>(
+          ConfigForThisCopy(), g_browser_process->shared_url_loader_factory(),
+          g_browser_process->local_state(), base::DefaultClock::GetInstance()));
+  return client->get();
+}
+
+void StartScheduledChecks() {
+  // The switch that keeps the browser from contacting anything on its own
+  // (tests, and people who use it) keeps the updater quiet too; the About page
+  // still looks when it is opened.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("disable-background-networking")) {
+    return;
+  }
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, base::BindOnce(&ScheduledLook), kFirstLook);
+}
+
+}  // namespace thoron_update_win
