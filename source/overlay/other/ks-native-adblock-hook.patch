index 0000000000000000000000000000000000000000..731c89928d409e9885d0877a95b99c00b30d7a7f
--- /dev/null
+++ b/components/user_data_importer/chromium_family/browser_detection_linux_unittest.cc
@@ -0,0 +1,104 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <unistd.h>
+
+#include <array>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/process/process_handle.h"
+#include "base/strings/string_number_conversions.h"
+#include "components/user_data_importer/chromium_family/browser_detection.h"
+#include "components/user_data_importer/common/importer_type.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace user_data_importer::chromium_family {
+namespace {
+
+// A fake ~/.config with browsers' folders; no real browser data is touched.
+class BrowserDetectionLinuxTest : public ::testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(config_.CreateUniqueTempDir());
+    folders_.config_home = config_.GetPath();
+  }
+
+  void Write(const base::FilePath& path, const std::string& contents) {
+    ASSERT_TRUE(base::CreateDirectory(path.DirName()));
+    ASSERT_TRUE(base::WriteFile(path, contents));
+  }
+
+  base::FilePath MakeBrowser(const std::string& folder) {
+    const base::FilePath user_data = config_.GetPath().Append(folder);
+    Write(user_data.Append("Local State"),
+          R"({"profile":{"info_cache":{"Default":{"name":"Person 1"},)"
+          R"("Profile 1":{"name":"Work"}}}})");
+    Write(user_data.Append("Default").Append("Preferences"), "{}");
+    Write(user_data.Append("Profile 1").Append("Preferences"), "{}");
+    return user_data;
+  }
+
+  base::ScopedTempDir config_;
+  DetectionFolders folders_;
+};
+
+TEST_F(BrowserDetectionLinuxTest, FindsTheBrowsersInTheConfigFolder) {
+  MakeBrowser("google-chrome");
+  MakeBrowser("BraveSoftware/Brave-Browser");
+  MakeBrowser("chromium");
+  const base::FilePath opera = config_.GetPath().Append("opera");
+  Write(opera.Append("Local State"), "{}");
+  Write(opera.Append("Preferences"), "{}");
+  const std::vector<SourceProfile> sources = DetectSourceProfiles(folders_);
+  ASSERT_EQ(sources.size(), 7u);
+  EXPECT_EQ(sources[0].importer_name, u"Chrome (Person 1)");
+  EXPECT_EQ(sources[0].source_path,
+            config_.GetPath().Append("google-chrome").Append("Default"));
+  EXPECT_EQ(sources[1].importer_name, u"Chrome (Work)");
+  EXPECT_EQ(sources[2].importer_name, u"Brave (Person 1)");
+  EXPECT_EQ(sources[4].importer_name, u"Opera");
+  EXPECT_EQ(sources[4].source_path, opera);
+  EXPECT_EQ(sources[5].importer_name, u"Chromium (Person 1)");
+  for (const SourceProfile& source : sources) {
+    EXPECT_EQ(source.importer_type, TYPE_CHROMIUM_FAMILY);
+  }
+}
+
+TEST_F(BrowserDetectionLinuxTest, NeverDetectsThoronItself) {
+  folders_.own_user_data = MakeBrowser("thorium");
+  EXPECT_TRUE(DetectSourceProfiles(folders_).empty());
+}
+
+// As Chromium's ProcessSingleton: the lock names this computer and a process
+// that runs; one left by a browser that ended, or by another computer, does not
+// count.
+TEST_F(BrowserDetectionLinuxTest, RunningFollowsTheSingletonLock) {
+  const base::FilePath user_data = MakeBrowser("google-chrome");
+  const base::FilePath lock = user_data.Append("SingletonLock");
+  EXPECT_FALSE(IsBrowserRunning(user_data));
+  std::array<char, 256> host = {};
+  ASSERT_EQ(::gethostname(host.data(), host.size() - 1), 0);
+  const std::string here(host.data());
+  ASSERT_TRUE(base::CreateSymbolicLink(
+      base::FilePath(here + "-" +
+                     base::NumberToString(base::GetCurrentProcId())),
+      lock));
+  EXPECT_TRUE(IsBrowserRunning(user_data));
+  ASSERT_TRUE(base::DeleteFile(lock));
+  // A process number no process has (above the kernel's limit).
+  ASSERT_TRUE(base::CreateSymbolicLink(base::FilePath(here + "-2147483646"),
+                                       lock));
+  EXPECT_FALSE(IsBrowserRunning(user_data));
+  ASSERT_TRUE(base::DeleteFile(lock));
+  ASSERT_TRUE(base::CreateSymbolicLink(
+      base::FilePath("another-computer-" +
+                     base::NumberToString(base::GetCurrentProcId())),
+      lock));
+  EXPECT_FALSE(IsBrowserRunning(user_data));
+}
+
+}  // namespace
+}  // namespace user_data_importer::chromium_family
