@@ -0,0 +1,29 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "services/preferences/tracked/thoron_portable_copy.h"
+
+#include "base/base_paths.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/path_service.h"
+
+namespace {
+
+bool LooksPortable() {
+  base::FilePath exe_dir;
+  if (!base::PathService::Get(base::DIR_EXE, &exe_dir)) {
+    return false;
+  }
+  // <copy>\Application\<version>\thoron.exe
+  const base::FilePath application = exe_dir.DirName();
+  return base::PathExists(application.AppendASCII("current")) &&
+         base::PathExists(application.DirName().AppendASCII("Thoron.exe"));
+}
+
+}  // namespace
+
+bool IsThoronPortableCopy() {
+  static const bool portable = LooksPortable();
+  return portable;
+}
