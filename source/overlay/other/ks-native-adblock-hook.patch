@@ -0,0 +1,42 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_THORON_PORTABLE_UNLOCK_WIN_H_
+#define CHROME_BROWSER_THORON_PORTABLE_UNLOCK_WIN_H_
+
+#include "base/files/file_path.h"
+
+class PrefService;
+
+namespace thoron_portable {
+
+// Local State: this copy was locked with a passphrase (set by
+// chrome://thoron-portable). With it and no key file, the copy does not start
+// as if it had never been locked.
+inline constexpr char kLockedPref[] = "thoron_portable.locked";
+
+enum class UnlockResult {
+  kNotLocked,  // no key file: the copy keeps its key in Local State
+  kUnlocked,   // the profile key is given to os_crypt
+  kQuit,       // the person quit, or the key file cannot be used
+};
+
+// Called before os_crypt starts (ChromeBrowserMainPartsWin): when the User
+// Data folder `user_data_dir` has a key file (ROADMAP P4.9), the copy is
+// marked as locked, then opened with a lock this PC remembers, else with the
+// passphrase or the recovery key the person types in Thoron's unlock window.
+// A key file that cannot be used is said so and the browser quits; it never
+// carries on without it, so nothing new is saved unprotected and no other key
+// takes the profile key's place (threat model E2, E3). A copy that was locked
+// (`local_state`'s kLockedPref) and has lost its key file starts only when the
+// person chooses to start without its passwords and sign-ins.
+UnlockResult UnlockIfLocked(const base::FilePath& user_data_dir,
+                            PrefService* local_state);
+
+// True after UnlockIfLocked() gave kQuit: the browser stops before it
+// starts its threads.
+bool QuitBeforeStart();
+
+}  // namespace thoron_portable
+
+#endif  // CHROME_BROWSER_THORON_PORTABLE_UNLOCK_WIN_H_
diff --git a/chrome/browser/thoron_update/BUILD.gn b/chrome/browser/thoron_update/BUILD.gn
