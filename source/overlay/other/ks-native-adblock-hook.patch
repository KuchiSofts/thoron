+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_PORTABLE_KEY_REENCRYPT_LINUX_H_
+#define COMPONENTS_THORON_PORTABLE_KEY_REENCRYPT_LINUX_H_
+
+#include <stdint.h>
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/functional/function_ref.h"
+
+namespace base {
+class FilePath;
+}  // namespace base
+
+// Thoron (ROADMAP P4.9, Linux): a portable copy locked with a passphrase on
+// Linux. Chromium keeps no key of its own per copy there (its values are "v10",
+// a fixed key, or "v11", a key from the desktop's keyring), so locking gives the
+// copy a new random key and its saved passwords and cookies are encrypted again
+// with it (the owner's decision of 2026-11-21: with a backup first, each value
+// read back). The new values are as Chromium's Encryptor writes them for an
+// AES-256-GCM key: the tag kPortableKeyTag, a 12-byte nonce, the sealed text.
+
+namespace thoron_portable_key {
+
+inline constexpr char kPortableKeyTag[] = "t10";
+
+struct ReencryptCounts {
+  int passwords = 0;   // passwords and password notes encrypted again
+  int cookies = 0;     // cookies encrypted again
+  int other = 0;       // Web Data's: cards, IBANs, stored CVCs, sign-in tokens,
+                       // Autofill AI values
+  int already = 0;     // values that had the portable key already
+  int unreadable = 0;  // values the old key does not read, or reads to what such a
+                       // value cannot be (another PC's keyring): left as they were
+};
+
+enum class ReencryptResult {
+  kDone,            // every value encrypted again and read back; no copy left
+  kBackupFailed,    // a database's copy could not be made or checked
+  kDatabaseFailed,  // a database could not be read or written
+  kCheckFailed,     // a value did not read back as it was
+};
+
+// Reads a value of Chromium's Linux keys ("v10", "v11"): its plain text, or
+// nothing when the value is not one of them or does not decrypt.
+using ReadOldValue =
+    base::FunctionRef<std::optional<std::string>(base::span<const uint8_t>)>;
+
+// Encrypts again, with `new_key` (32 bytes), the saved passwords and password
+// notes (Login Data, Login Data For Account), the cookies (Network/Cookies, or
+// the older Cookies) and Web Data's own values (Web Data, Account Web Data:
+// cards, IBANs, stored CVCs, sign-in tokens, Autofill AI values) of the profile
+// folder `profile`, with the browser not running. A value read with the old key
+// must be what its column holds (a cookie starts with its host's hash, the
+// rest is text), or it is left as it is and counted unreadable. A database
+// with nothing to turn is not touched. For each database that is: a copy beside it
+// ("<name>.thoron-before-lock"), checked byte for byte; then one transaction in
+// which each value is encrypted again and read back with the new key; on any
+// problem the database is put back from its copy and nothing after it is
+// touched. Once every database is done the copies are removed: they hold the
+// values in a form that opens without the passphrase.
+ReencryptResult ReencryptProfile(const base::FilePath& profile,
+                                 ReadOldValue read_old,
+                                 base::span<const uint8_t, 32> new_key,
+                                 ReencryptCounts* counts);
+
+// The way back, when the lock is removed: every value of the copy's key
+// encrypted again with one of Chromium's own Linux keys, `chromium_key` (16
+// bytes: PBKDF2 of the keyring's secret, or of Chromium's fixed password) under
+// `prefix` ("v11" or "v10"), the same way: a checked copy of each database
+// first, each new value read back, the copies wiped. Values of Chromium's keys
+// stay as they are.
+ReencryptResult ReturnProfileToChromium(const base::FilePath& profile,
+                                        base::span<const uint8_t, 32> portable_key,
+                                        base::span<const uint8_t, 16> chromium_key,
+                                        std::string_view prefix,
+                                        ReencryptCounts* counts);
+
+// The password and cookie databases of `profile` that hold a value of a
+// portable key ("t10"): the copy was locked. Read only; for a key file that
+// went missing while Local State says the copy is not locked.
+std::vector<base::FilePath> FilesWithPortableValues(const base::FilePath& profile);
+
+// The databases FilesWithPortableValues names moved aside
+// ("<name>.thoron-without-key"), never deleted: the person chose to start
+// without the key file, and its values open again if the key file is found.
+// The browser then starts with new, empty ones. False when one stays.
+bool SetAsideLockedDatabases(const base::FilePath& profile);
+
+// A value of Chromium's Linux keys ("v10"/"v11" and AES-128-CBC), and its plain
+// text again, or nothing.
+std::string EncryptForChromiumLinux(base::span<const uint8_t, 16> key,
+                                    std::string_view prefix,
+                                    std::string_view plaintext);
+std::optional<std::string> DecryptForChromiumLinux(base::span<const uint8_t, 16> key,
+                                                   std::string_view prefix,
+                                                   base::span<const uint8_t> value);
+
+// A value encrypted with `key` as Chromium's Encryptor writes it (for tests and
+// the engine).
+std::string EncryptWithPortableKey(base::span<const uint8_t, 32> key,
+                                   std::string_view plaintext);
+
+// The plain text of a value of the portable key, or nothing.
+std::optional<std::string> DecryptWithPortableKey(
+    base::span<const uint8_t, 32> key,
+    base::span<const uint8_t> value);
+
+}  // namespace thoron_portable_key
+
+#endif  // COMPONENTS_THORON_PORTABLE_KEY_REENCRYPT_LINUX_H_
