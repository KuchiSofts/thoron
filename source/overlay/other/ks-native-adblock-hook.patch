--- /dev/null
+++ b/components/user_data_importer/chromium_family/open_tabs.h
@@ -0,0 +1,73 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_USER_DATA_IMPORTER_CHROMIUM_FAMILY_OPEN_TABS_H_
+#define COMPONENTS_USER_DATA_IMPORTER_CHROMIUM_FAMILY_OPEN_TABS_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <vector>
+
+#include "base/containers/span.h"
+
+namespace sessions {
+class SessionCommand;
+struct SessionWindow;
+}  // namespace sessions
+
+namespace user_data_importer::chromium_family {
+
+// Thoron (ROADMAP P3.22): the open windows, tabs and tab groups of a
+// Chromium-family browser, from its last session file (`Session_<time>` in the
+// profile's `Sessions` folder), to open in Thoron.
+
+// The largest session file read; a heavy real session is a few MB.
+inline constexpr size_t kMostOpenTabsFileBytes = 64 * 1024 * 1024;
+// The most windows and tabs one import opens, and the most entries of a tab's
+// back and forward history kept.
+inline constexpr size_t kMostOpenTabsWindows = 50;
+inline constexpr size_t kMostOpenTabs = 500;
+inline constexpr size_t kMostNavigationsPerTab = 50;
+
+// The commands of a session file, read the way Chromium reads its own: the
+// "SNSS" header and version 3 (not encrypted, with the marker written once the
+// whole state is in the file), then every command up to the end or to the first
+// one cut short. nullopt when the header is not that or the marker never comes
+// (the browser was still writing it). The marker itself is not returned.
+std::optional<std::vector<std::unique_ptr<sessions::SessionCommand>>>
+ReadSessionCommands(base::span<const uint8_t> file);
+
+struct OpenTabsCounts {
+  int windows = 0;
+  int tabs = 0;
+  int groups = 0;
+};
+
+// The windows of a session file to open in Thoron, replayed by Chromium's own
+// code (sessions::RestoreSessionFromCommands), after the commands it would stop
+// at are left out (another browser's own, or one it cannot read: it would lose
+// everything after them), and then cut down to what is safe and means something
+// here:
+//  - normal browser windows only (no app or pop-up windows), at most
+//    kMostOpenTabsWindows, with at most kMostOpenTabs tabs in all;
+//  - in each tab only web pages (http, https and file), never a browser's own
+//    page or a script; a tab left with none is dropped, and so is a window
+//    left with no tab;
+//  - no page state of the other browser (form contents, scroll positions,
+//    POST data): each page is loaded again from its address; a page reached by
+//    a form's POST is left out;
+//  - nothing tied to the other browser or its data: no app or extension IDs,
+//    user agent overrides, session storage, tab data, workspace, links to its
+//    saved tab groups, or split views;
+//  - tab groups keep their name, colour and whether they were collapsed; a
+//    minimized window opens as a normal one.
+// Empty when the file is not a complete session. `counts` may be null.
+std::vector<std::unique_ptr<sessions::SessionWindow>> ReadOpenTabs(
+    base::span<const uint8_t> file,
+    OpenTabsCounts* counts);
+
+}  // namespace user_data_importer::chromium_family
+
+#endif  // COMPONENTS_USER_DATA_IMPORTER_CHROMIUM_FAMILY_OPEN_TABS_H_
diff --git a/components/user_data_importer/chromium_family/open_tabs_fuzzer.cc b/components/user_data_importer/chromium_family/open_tabs_fuzzer.cc
new file mode 100644
index 0000000000000000000000000000000000000000..7f1661e71b21958d7b2a1550b236d047af38b90b
--- /dev/null
+++ b/components/user_data_importer/chromium_family/open_tabs_fuzzer.cc
@@ -0,0 +1,71 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Coverage-guided fuzzing of the reading of another browser's session file in
+// Settings' import (ROADMAP P3.22, threat model I3): the file is input from
+// outside, read in the browser process before its windows open.
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "base/at_exit.h"
+#include "base/check_op.h"
+#include "base/command_line.h"
+#include "base/compiler_specific.h"
+#include "base/containers/span.h"
+#include "base/i18n/icu_util.h"
+#include "base/no_destructor.h"
+#include "components/sessions/core/session_types.h"
+#include "components/user_data_importer/chromium_family/open_tabs.h"
+#include "ui/base/resource/resource_bundle.h"
+
+namespace cf = user_data_importer::chromium_family;
+
+namespace {
+
+// Chromium's tab groups name their colours from the resource bundle, which a
+// browser or utility process loads; here an empty one stands in. It reads the
+// command line, which a process has and a fuzzer must set up first, as it does
+// the at-exit list the session ids' generator registers with and ICU, which
+// reads the international domain names of the pages' addresses.
+struct Environment {
+  base::AtExitManager at_exit;
+  bool command_line = base::CommandLine::Init(0, nullptr);
+  bool icu = base::i18n::InitializeICU();
+  ui::ResourceBundle bundle{nullptr};
+  ui::ResourceBundle::SharedInstanceSwapperForTesting swap{&bundle};
+};
+
+}  // namespace
+
+extern "C" int LLVMFuzzerTestOneInput(const uint8_t* data, size_t size) {
+  static base::NoDestructor<Environment> environment;
+  // SAFETY: libFuzzer gives `size` bytes at `data`.
+  const base::span<const uint8_t> bytes = UNSAFE_BUFFERS(base::span(data, size));
+  cf::OpenTabsCounts counts;
+  const auto windows = cf::ReadOpenTabs(bytes, &counts);
+  // What comes out keeps the limits the reader promises.
+  CHECK_LE(windows.size(), cf::kMostOpenTabsWindows);
+  size_t tabs = 0;
+  for (const auto& window : windows) {
+    CHECK(!window->tabs.empty());
+    CHECK_EQ(window->type, sessions::SessionWindow::TYPE_NORMAL);
+    CHECK_GE(window->selected_tab_index, 0);
+    CHECK_LT(static_cast<size_t>(window->selected_tab_index),
+             window->tabs.size());
+    tabs += window->tabs.size();
+    for (const auto& tab : window->tabs) {
+      CHECK(!tab->navigations.empty());
+      CHECK_LE(tab->navigations.size(), cf::kMostNavigationsPerTab);
+      CHECK_GE(tab->current_navigation_index, 0);
+      CHECK_LT(static_cast<size_t>(tab->current_navigation_index),
+               tab->navigations.size());
+      for (const auto& entry : tab->navigations) {
+        CHECK(entry.encoded_page_state().empty());
+      }
+    }
+  }
+  CHECK_LE(tabs, cf::kMostOpenTabs);
+  CHECK_EQ(static_cast<size_t>(counts.tabs), tabs);
+  return 0;
+}
