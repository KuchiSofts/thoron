+std::array<uint8_t, 32> MakeKey() {
+  std::array<uint8_t, 32> key = {};
+  crypto::RandBytes(key);
+  return key;
+}
+
+#if BUILDFLAG(IS_WIN)
+std::vector<uint8_t> WrapForCurrentUser(base::span<const uint8_t> plaintext) {
+  DATA_BLOB input = {};
+  input.pbData = const_cast<BYTE*>(plaintext.data());
+  input.cbData = static_cast<DWORD>(plaintext.size());
+  DATA_BLOB output = {};
+  EXPECT_TRUE(::CryptProtectData(&input, FILE_PATH_LITERAL(""), nullptr, nullptr, nullptr, 0,
+                                 &output));
+  auto owned = base::win::TakeLocalAlloc(output.pbData);
+  return std::vector<uint8_t>(owned.get(),
+                              UNSAFE_TODO(owned.get() + output.cbData));
+}
+
+std::vector<uint8_t> MakeV10Value(base::span<const uint8_t> raw_key,
+                                  const std::string& plaintext) {
+  std::array<uint8_t, 12> nonce = {};
+  crypto::RandBytes(nonce);
+  std::vector<uint8_t> sealed =
+      crypto::aead::Seal(crypto::aead::AES_256_GCM, raw_key,
+                         base::as_byte_span(plaintext), nonce, {});
+  std::vector<uint8_t> value = {'v', '1', '0'};
+  value.insert(value.end(), nonce.begin(), nonce.end());
+  value.insert(value.end(), sealed.begin(), sealed.end());
+  return value;
+}
+#else
+// Linux keeps no key in Local State; the wrapped key is not read there.
+std::vector<uint8_t> WrapForCurrentUser(base::span<const uint8_t> plaintext) {
+  return std::vector<uint8_t>(plaintext.begin(), plaintext.end());
+}
+
+// A "v10" value as Chromium writes it on Linux: AES-128-CBC with the fixed key
+// and an IV of 16 spaces (`raw_key` is the Windows test's key, not used).
+std::vector<uint8_t> MakeV10Value(base::span<const uint8_t> raw_key,
+                                  const std::string& plaintext) {
+  const std::array<uint8_t, 16> key = PasswordKey::DeriveKey("peanuts");
+  std::array<uint8_t, 16> iv;
+  iv.fill(' ');
+  std::vector<uint8_t> sealed =
+      crypto::aes_cbc::Encrypt(key, iv, base::as_byte_span(plaintext));
+  std::vector<uint8_t> value = {'v', '1', '0'};
+  value.insert(value.end(), sealed.begin(), sealed.end());
+  return value;
+}
+
+#endif  // BUILDFLAG(IS_WIN)
