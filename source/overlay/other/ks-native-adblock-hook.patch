+
+base::CommandLine Command(const std::vector<std::string>& args) {
+  base::CommandLine::StringVector argv = {FILE_PATH_LITERAL("thoron_update")};
+  for (const std::string& arg : args) {
+#if BUILDFLAG(IS_WIN)
+    argv.push_back(base::UTF8ToWide(arg));
+#else
+    argv.push_back(arg);
+#endif
+  }
+  return base::CommandLine(argv);
+}
+
+class ThoronUpdateCliTest : public testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(dir_.CreateUniqueTempDir()); }
+
+  int Run(const std::vector<std::string>& args) {
+    out_.clear();
+    return RunUpdateCommand(Command(args), &out_);
+  }
+
+  std::string Root() { return dir_.GetPath().AsUTF8Unsafe(); }
+
+  // A staged folder of `version` with one file, and its files.json.
+  void Stage(const std::string& version, std::string* staged, std::string* files) {
+    const std::string content = "program " + version;
+    const base::FilePath folder = dir_.GetPath().AppendASCII(version + ".staging");
+    ASSERT_TRUE(base::CreateDirectory(folder));
+    ASSERT_TRUE(base::WriteFile(folder.AppendASCII("thoron.exe"), content));
+    const base::FilePath list = dir_.GetPath().AppendASCII(version + ".files.json");
+    ASSERT_TRUE(base::WriteFile(
+        list, "[{\"path\": \"thoron.exe\", \"size\": " + base::NumberToString(content.size()) +
+                  ", \"sha256\": \"" + base::HexEncodeLower(crypto::hash::Sha256(content)) +
+                  "\"}]"));
+    *staged = folder.AsUTF8Unsafe();
+    *files = list.AsUTF8Unsafe();
+  }
+
+  int Apply(const std::string& version) {
+    std::string staged, files;
+    Stage(version, &staged, &files);
+    return Run({"--root=" + Root(), "--apply=" + staged, "--version=" + version, "--files=" + files});
+  }
+
+  base::ScopedTempDir dir_;
+  std::string out_;
+};
+
+TEST_F(ThoronUpdateCliTest, StatusApplyAndRollBackGiveTheirExitCodes) {
+  EXPECT_EQ(Run({"--root=" + Root(), "--status"}), kExitNoVersion);
+  EXPECT_EQ(out_, "current: none\nprevious: none\nmode: auto\n");
+  EXPECT_EQ(Apply("158.0.8127.3000"), kExitOk);
+  EXPECT_EQ(Apply("158.0.8127.3010"), kExitOk);
+  EXPECT_EQ(Run({"--root=" + Root(), "--status"}), kExitOk);
+  EXPECT_EQ(out_, "current: 158.0.8127.3010\nprevious: 158.0.8127.3000\nmode: auto\n");
+  // without --confirm it only says what it would do
+  EXPECT_EQ(Run({"--root=" + Root(), "--rollback"}), kExitNeedsConfirmation);
+  EXPECT_NE(out_.find("rolling back makes 158.0.8127.3000 the version that starts"), std::string::npos);
+  Run({"--root=" + Root(), "--status"});
+  EXPECT_EQ(out_, "current: 158.0.8127.3010\nprevious: 158.0.8127.3000\nmode: auto\n");
+  EXPECT_EQ(Run({"--root=" + Root(), "--rollback", "--confirm"}), kExitOk);
+  Run({"--root=" + Root(), "--status"});
+  EXPECT_EQ(out_, "current: 158.0.8127.3000\nprevious: 158.0.8127.3010\nmode: auto\n");
+}
+
+TEST_F(ThoronUpdateCliTest, WhatCannotBeDoneHasItsOwnExitCode) {
+  EXPECT_EQ(Run({"--root=" + Root(), "--rollback", "--confirm"}), kExitNothingToRollBack);
+  EXPECT_EQ(Apply("158.0.8127.3000"), kExitOk);
+  // the staged folder is not the files list's
+  std::string staged, files;
+  Stage("158.0.8127.3010", &staged, &files);
+  ASSERT_TRUE(base::WriteFile(base::FilePath::FromUTF8Unsafe(staged).AppendASCII("thoron.exe"), "x"));
+  EXPECT_EQ(Run({"--root=" + Root(), "--apply=" + staged, "--version=158.0.8127.3010",
+                 "--files=" + files}),
+            kExitBadFiles);
+  EXPECT_EQ(Run({"--root=" + Root(), "--apply=x", "--version=158.0.8127", "--files=" + files}),
+            kExitUsage);
+  EXPECT_EQ(Run({"--status"}), kExitUsage);
+  EXPECT_EQ(Run({"--root=" + Root()}), kExitUsage);
+}
+
+TEST_F(ThoronUpdateCliTest, TheModeIsKeptAndReadBack) {
+  EXPECT_EQ(Run({"--root=" + Root(), "--mode"}), kExitOk);
+  EXPECT_EQ(out_, "auto\n");
+  for (const char* mode : {"notify", "off", "auto"}) {
+    EXPECT_EQ(Run({"--root=" + Root(), std::string("--mode=") + mode}), kExitOk);
+    Run({"--root=" + Root(), "--mode"});
+    EXPECT_EQ(out_, std::string(mode) + "\n");
+  }
+  EXPECT_EQ(Run({"--root=" + Root(), "--mode=sometimes"}), kExitUsage);
+  ASSERT_TRUE(base::WriteFile(dir_.GetPath().AppendASCII("update-mode"), "nonsense"));
+  EXPECT_EQ(ReadUpdateMode(dir_.GetPath()), UpdateMode::kAuto);
+}
+
+TEST(ThoronUpdateModeTest, EachModeDoesWhatItSays) {
+  EXPECT_EQ(ActionFor(UpdateMode::kAuto, Outcome::kUpdate), Action::kInstall);
+  EXPECT_EQ(ActionFor(UpdateMode::kNotify, Outcome::kUpdate), Action::kTell);
+  EXPECT_EQ(ActionFor(UpdateMode::kOff, Outcome::kUpdate), Action::kNothing);
+  for (UpdateMode mode : {UpdateMode::kAuto, UpdateMode::kNotify}) {
+    EXPECT_EQ(ActionFor(mode, Outcome::kUpToDate), Action::kNothing);
+    EXPECT_EQ(ActionFor(mode, Outcome::kExpired), Action::kWarn);
+    EXPECT_EQ(ActionFor(mode, Outcome::kBadSignature), Action::kWarn);
+    EXPECT_EQ(ActionFor(mode, Outcome::kUpdaterTooOld), Action::kTell);
+    EXPECT_EQ(ActionFor(mode, Outcome::kNoPackage), Action::kNothing);
+  }
+  EXPECT_EQ(ActionFor(UpdateMode::kOff, Outcome::kExpired), Action::kNothing);
+}
+
+// P4.6: an updater that is too old installs the release like an update when
+// the decision carries the package (the updater inside it applies it).
+TEST(ThoronUpdateModeTest, AnUpdaterThatIsTooOldInstallsWhenItHasThePackage) {
+  Decision decision;
+  decision.outcome = Outcome::kUpdaterTooOld;
+  EXPECT_EQ(ActionFor(UpdateMode::kAuto, decision), Action::kTell);
+  decision.full = PackageFile{"https://github.com/a.zip", 30, std::string(64, 'a')};
+  EXPECT_EQ(ActionFor(UpdateMode::kAuto, decision), Action::kInstall);
+  EXPECT_EQ(ActionFor(UpdateMode::kNotify, decision), Action::kTell);
+  EXPECT_EQ(ActionFor(UpdateMode::kOff, decision), Action::kNothing);
+  decision.outcome = Outcome::kExpired;
+  EXPECT_EQ(ActionFor(UpdateMode::kAuto, decision), Action::kWarn);
+}
+
+TEST_F(ThoronUpdateCliTest, TheUpdaterOfTheReleaseIsFoundAndCopiedOnlyWhenItMatches) {
+  const std::string program = "an updater";
+  const base::FilePath staged = dir_.GetPath().AppendASCII("158.0.8127.3010.staging");
+  ASSERT_TRUE(base::CreateDirectory(staged));
+  ASSERT_TRUE(base::WriteFile(staged.AppendASCII(kUpdaterFile), program));
+  const VersionFile entry{kUpdaterFile, static_cast<int64_t>(program.size()),
+                          base::HexEncodeLower(crypto::hash::Sha256(program))};
+  EXPECT_FALSE(UpdaterEntry({{"thoron.exe", 1, std::string(64, 'a')}}));
+  const std::optional<VersionFile> found =
+      UpdaterEntry({{"thoron.exe", 1, std::string(64, 'a')}, entry});
+  ASSERT_TRUE(found);
+  EXPECT_EQ(found->sha256, entry.sha256);
+
+  const base::FilePath copy = dir_.GetPath().AppendASCII(kHandOffFile);
+  EXPECT_TRUE(CopyCheckedUpdater(staged, entry, copy));
+  std::string read;
+  ASSERT_TRUE(base::ReadFileToString(copy, &read));
+  EXPECT_EQ(read, program);
+  ASSERT_TRUE(base::DeleteFile(copy));
+
+  // another program of the same length, or another length: no copy is left
+  ASSERT_TRUE(base::WriteFile(staged.AppendASCII(kUpdaterFile), "an updatex"));
+  EXPECT_FALSE(CopyCheckedUpdater(staged, entry, copy));
+  EXPECT_FALSE(base::PathExists(copy));
+  ASSERT_TRUE(base::WriteFile(staged.AppendASCII(kUpdaterFile), "longer than it says"));
+  EXPECT_FALSE(CopyCheckedUpdater(staged, entry, copy));
+  EXPECT_FALSE(base::PathExists(copy));
+}
+
+// An apply whose staged updater is not the one its files name starts nothing
+// and switches nothing.
+TEST_F(ThoronUpdateCliTest, AStagedUpdaterThatDoesNotMatchIsNeverStarted) {
+  EXPECT_EQ(Apply("158.0.8127.3000"), kExitOk);
+  const std::string program = "an updater";
+  const base::FilePath staged = dir_.GetPath().AppendASCII("158.0.8127.3010.staging");
+  ASSERT_TRUE(base::CreateDirectory(staged));
+  ASSERT_TRUE(base::WriteFile(staged.AppendASCII(kUpdaterFile), "not the updater"));
+  const base::FilePath list = dir_.GetPath().AppendASCII("158.0.8127.3010.files.json");
+  ASSERT_TRUE(base::WriteFile(
+      list, std::string("[{\"path\": \"") + kUpdaterFile + "\", \"size\": " +
+                base::NumberToString(program.size()) + ", \"sha256\": \"" +
+                base::HexEncodeLower(crypto::hash::Sha256(program)) + "\"}]"));
+  EXPECT_EQ(Run({"--root=" + Root(), "--apply=" + staged.AsUTF8Unsafe(), "--version=158.0.8127.3010",
+                 "--files=" + list.AsUTF8Unsafe()}),
+            kExitBadFiles);
+  EXPECT_NE(out_.find("is not the one its files name"), std::string::npos);
+  EXPECT_FALSE(base::PathExists(dir_.GetPath().AppendASCII(kHandOffFile)));
+  EXPECT_FALSE(base::PathExists(staged));
+  Run({"--root=" + Root(), "--status"});
+  EXPECT_EQ(out_, "current: 158.0.8127.3000\nprevious: none\nmode: auto\n");
+}
