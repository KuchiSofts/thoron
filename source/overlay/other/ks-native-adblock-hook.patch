+    sql::Statement s(db.GetUniqueStatement(
+        "INSERT INTO urls(url, title, visit_count, typed_count, "
+        "last_visit_time, hidden) VALUES(?,?,0,0,0,0)"));
+    for (int i = 0; i < 400; ++i) {
