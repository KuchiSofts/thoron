+
+std::optional<tpk::SecretBytes> PassphraseOf(const base::Value& value) {
+  if (!value.is_string()) {
+    return std::nullopt;
+  }
+  std::u16string typed = base::UTF8ToUTF16(value.GetString());
+  return tpk::PassphraseFromTyped(typed);
+}
+
+// What the page shows after a step.
+// The one sequence that reads and writes the copy's key file.
+scoped_refptr<base::SequencedTaskRunner> KeyFileTasks() {
+  static base::NoDestructor<scoped_refptr<base::SequencedTaskRunner>> tasks(
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_BLOCKING,
+           base::TaskShutdownBehavior::BLOCK_SHUTDOWN}));
+  return *tasks;
+}
+
+struct Result {
+  bool locked = false;
+  bool remembered = false;
+  bool can_remember = false;
+  bool has_recovery = false;
+  std::string problem;
+  std::string message;
+  std::string recovery;  // a recovery key to write down
+  // removing the lock: the profile key to put back into Local State
+  std::optional<tpk::SecretBytes> key;
+  // removing the lock on Linux: the proof for the next start (base64)
+  std::string proof;
+};
+
+// The copy's lock as it is now. Blocking.
+Result ReadState(const base::FilePath& folder) {
+  Result result;
+  std::unique_ptr<tpk::OsKeyStore> store = tpk::CreateOsKeyStore();
+  result.can_remember = store->IsAvailable();
+  if (!tpk::HasKeyFile(folder)) {
+    return result;
+  }
+  result.locked = true;
+  tpk::StoredKeyFile stored = tpk::ReadKeyFile(folder);
+  if (!stored.file) {
+    result.problem = "This copy's key file cannot be read.";
+    return result;
+  }
+  result.remembered = tpk::IsRememberedHere(*stored.file, *store);
+  result.has_recovery = stored.file->recovery.has_value();
+  return result;
+}
+
+Result WithState(const base::FilePath& folder,
+                 std::string problem,
+                 std::string message) {
+  Result result = ReadState(folder);
+  if (result.problem.empty()) {
+    result.problem = std::move(problem);
+  }
+  result.message = std::move(message);
+  return result;
+}
+
+// Writes `file`, reads it back and opens it with the passphrase (and the
+// recovery key): "" when it opens to `key`. Otherwise `previous` is written
+// back (no key file at all when it is empty) and a problem is given. Blocking.
+std::string WriteAndCheck(const base::FilePath& folder,
+                          const tpk::KeyFile& file,
+                          const tpk::SecretBytes& key,
+                          tpk::SecretBytes passphrase,
+                          const tpk::SecretBytes* recovery,
+                          const std::vector<uint8_t>& previous) {
+  auto put_back = [&folder, &previous] {
+    if (previous.empty()) {
+      tpk::RemoveKeyFile(folder);
+    } else {
+      tpk::WriteKeyFile(folder, previous);
+    }
+  };
+  if (!tpk::WriteKeyFile(folder, tpk::SerializeKeyFile(file, key))) {
+    put_back();
+    return kWriteProblem;
+  }
+  tpk::StoredKeyFile stored = tpk::ReadKeyFile(folder);
+  tpk::OpenProblem problem = tpk::OpenProblem::kNone;
+  bool opens = false;
+  if (stored.file) {
+    std::optional<tpk::SecretBytes> opened =
+        tpk::OpenWithPassphrase(*stored.file, std::move(passphrase), &problem);
+    opens = opened && *opened == key;
+    if (opens && recovery) {
+      opened = tpk::OpenWithRecoveryKey(*stored.file, *recovery, &problem);
+      opens = opened && *opened == key;
+    }
+  }
+  if (!opens) {
+    put_back();
+    return kCheckProblem;
+  }
+  return std::string();
+}
+
+// Locks a copy that is not locked yet. Blocking.
+Result Lock(base::FilePath folder,
+            tpk::SecretBytes key,
+            tpk::SecretBytes passphrase,
+            std::optional<tpk::SecretBytes> recovery,
+            bool remember) {
+  if (tpk::HasKeyFile(folder)) {
+    return WithState(folder, "This copy is locked already.", "");
+  }
+  const tpk::Argon2Params params = tpk::Calibrate(tpk::MeasureFloor());
+  tpk::SecretBytes again(passphrase.span());
+  std::optional<tpk::KeyFile> file = tpk::NewKeyFile(
+      key, std::move(passphrase), params, recovery ? &*recovery : nullptr);
+  if (!file) {
+    return WithState(folder, kMemoryProblem, "");
+  }
+  std::unique_ptr<tpk::OsKeyStore> store = tpk::CreateOsKeyStore();
+  if (remember) {
+    tpk::RememberThisPc(*file, key, *store);
+  }
+  const std::string problem =
+      WriteAndCheck(folder, *file, key, std::move(again),
+                    recovery ? &*recovery : nullptr, std::vector<uint8_t>());
+  return WithState(folder, problem,
+                   problem.empty() ? "This copy is locked with your passphrase."
+                                   : "");
+}
+
+// The key file opened with the passphrase, for a change to it. Blocking.
+struct Opened {
+  std::optional<tpk::KeyFile> file;
+  std::optional<tpk::SecretBytes> key;
+  std::vector<uint8_t> bytes;  // as it is now
+  std::string problem;
+};
+
+Opened OpenFile(const base::FilePath& folder, tpk::SecretBytes passphrase) {
+  Opened opened;
+  tpk::StoredKeyFile stored = tpk::ReadKeyFile(folder);
+  if (!stored.file) {
+    opened.problem = "This copy's key file cannot be read.";
+    return opened;
+  }
+  tpk::OpenProblem problem = tpk::OpenProblem::kNone;
+  opened.key =
+      tpk::OpenWithPassphrase(*stored.file, std::move(passphrase), &problem);
+  if (!opened.key) {
+    opened.problem = problem == tpk::OpenProblem::kWrongSecret
+                         ? kWrongPassphrase
+                         : (problem == tpk::OpenProblem::kChanged
+                                ? kChangedProblem
+                                : kMemoryProblem);
+    return opened;
+  }
+  opened.bytes = tpk::SerializeKeyFile(*stored.file, *opened.key);
+  opened.file = std::move(stored.file);
+  return opened;
+}
+
+Result ChangePassphrase(base::FilePath folder,
+                        tpk::SecretBytes current,
+                        tpk::SecretBytes fresh) {
+  Opened opened = OpenFile(folder, std::move(current));
+  if (!opened.key) {
+    return WithState(folder, opened.problem, "");
+  }
+  tpk::SecretBytes again(fresh.span());
+  std::optional<tpk::PassphraseLock> lock = tpk::LockWithPassphrase(
+      *opened.key, std::move(fresh), tpk::Calibrate(tpk::MeasureFloor()));
+  if (!lock) {
+    return WithState(folder, kMemoryProblem, "");
+  }
+  opened.file->passphrase = *lock;
+  const std::string problem =
+      WriteAndCheck(folder, *opened.file, *opened.key, std::move(again),
+                    nullptr, opened.bytes);
+  return WithState(folder, problem,
+                   problem.empty() ? "The passphrase is changed." : "");
+}
+
+Result NewRecovery(base::FilePath folder, tpk::SecretBytes passphrase) {
+  tpk::SecretBytes again(passphrase.span());
+  Opened opened = OpenFile(folder, std::move(passphrase));
+  if (!opened.key) {
+    return WithState(folder, opened.problem, "");
+  }
+  tpk::SecretBytes recovery = tpk::NewRecoveryKey();
+  opened.file->recovery = tpk::LockWithRecoveryKey(*opened.key, recovery);
+  const std::string problem =
+      WriteAndCheck(folder, *opened.file, *opened.key, std::move(again),
+                    &recovery, opened.bytes);
+  Result result = WithState(
+      folder, problem,
+      problem.empty() ? "Write down the new recovery key now. The old one no "
+                        "longer opens this copy."
+                      : "");
+  if (problem.empty()) {
+    result.recovery = tpk::FormatRecoveryKey(recovery);
+  }
+  return result;
+}
+
+// "Remember this PC" or "Forget this PC", with the key the copy was opened
+// with. A file that this key did not sign is left alone. Blocking.
+Result RememberOrForget(base::FilePath folder,
+                        tpk::SecretBytes key,
+                        bool remember) {
+  tpk::StoredKeyFile stored = tpk::ReadKeyFile(folder);
+  if (!stored.file) {
+    return WithState(folder, "This copy's key file cannot be read.", "");
+  }
+  if (!tpk::IsSignedBy(*stored.file, key)) {
+    return WithState(folder, kChangedProblem, "");
+  }
+  std::unique_ptr<tpk::OsKeyStore> store = tpk::CreateOsKeyStore();
+  const bool changed = remember
+                           ? tpk::RememberThisPc(*stored.file, key, *store)
+                           : tpk::ForgetThisPc(*stored.file, *store);
+  if (!changed) {
+    return WithState(folder,
+                     remember ? ForThisSystem("This PC cannot be remembered: Windows keeps "
+                                              "no key for this account, or the copy "
+                                              "remembers as many PCs as it can.")
+                              : ForThisSystem("This PC could not be forgotten: Windows did not "
+                                              "answer for this account. It is still "
+                                              "remembered; try again."),
+                     "");
+  }
+  const std::vector<uint8_t> bytes = tpk::SerializeKeyFile(*stored.file, key);
+  if (!tpk::WriteKeyFile(folder, bytes)) {
+    return WithState(folder, kWriteProblem, "");
+  }
+  return WithState(folder, "",
+                   remember ? ForThisSystem("This PC is remembered for this Windows account: "
+                                            "the copy opens here without the passphrase.")
+                            : "This PC is forgotten: the copy asks for the "
+                              "passphrase here again.");
+}
+
+// Removing the lock, first step: the passphrase opens the file; the key goes
+// back into Local State on the UI thread. Blocking.
+Result OpenForRemoval(base::FilePath folder, tpk::SecretBytes passphrase) {
+  Opened opened = OpenFile(folder, std::move(passphrase));
+  Result result = WithState(folder, opened.problem, "");
+#if BUILDFLAG(IS_LINUX)
+  if (opened.key && opened.file) {
+    result.proof = base::Base64Encode(tpk::RemovalProof(*opened.file, *opened.key));
+  }
+#endif
+  result.key = std::move(opened.key);
+  return result;
+}
+
+// Second step, once Local State holds the key again. Blocking.
+Result RemoveFile(base::FilePath folder) {
+  const bool removed = tpk::RemoveKeyFile(folder);
+  return WithState(
+      folder,
+      removed ? "" : "Thoron could not remove the key file. Remove the file "
+                     "\"Thoron Portable Key\" from this copy's User Data "
+                     "folder yourself.",
+      removed ? "The lock is removed. This copy's passwords and sign-ins open "
+                "again only on this PC and this Windows account."
+              : "");
+}
+
+// The page's words about Windows, said for Linux (where the desktop's keyring
+// remembers a PC and the lock cannot be removed yet).
+std::string ForThisSystem(std::string text) {
+#if BUILDFLAG(IS_LINUX)
+  static constexpr std::pair<std::string_view, std::string_view> kLinux[] = {
+      {"locked by Windows for your account on this PC.",
+       "locked by the desktop's keyring for your account on this PC."},
+      {"Today this copy's saved passwords and sign-ins (cookies) open only on this PC and this Windows\n"
+       "account.",
+       "Today this copy's saved passwords and sign-ins (cookies) are protected only by this desktop's\n"
+       "keyring, or, where there is none, by Chromium's fixed key, which anyone can use."},
+      {"Remember this PC for\nthis Windows account (no passphrase here)",
+       "Remember this PC for\nthis user, in the desktop's keyring (no passphrase here)"},
+      {"Without the lock, this copy's\npasswords and sign-ins open only on this PC and this Windows account, as "
+       "an installed Thoron's do.",
+       "Without the lock, this copy's\npasswords, sign-ins and cards are under Chromium's own key for Linux "
+       "again, which anyone can use, as an unlocked copy's are. The lock goes at the next start, once every "
+       "value is back."},
+      {"This PC is remembered for this Windows account:", "This PC is remembered in the desktop keyring for this user:"},
+      {"This PC cannot be remembered: Windows keeps no key for this account,",
+       "This PC cannot be remembered: the desktop's keyring is locked or not there,"},
+      {"This PC could not be forgotten: Windows did not answer for this account.",
+       "This PC could not be forgotten: the desktop's keyring is locked or did not answer."},
+  };
+  for (const auto& [from, to] : kLinux) {
+    base::ReplaceSubstringsAfterOffset(&text, 0, from, to);
+  }
+#endif
+  return text;
+}
+
+std::string Page() {
+  return R"html(<!doctype html><html lang="en" dir="ltr"><head><meta charset="utf-8">
