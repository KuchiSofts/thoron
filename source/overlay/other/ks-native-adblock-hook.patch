+// The mailboxes a person added by address and password (P5.77): a list of
+// {email, host, port, user, webmail, secret}; `secret` is the password
+// encrypted by the system (os_crypt), in base64.
+constexpr char kImapAccountsPref[] = "thoron_mail.imap_accounts";
+// A backup is small; a file larger than this is not one.
+constexpr size_t kMostBackupBytes = 4 * 1024 * 1024;
+// P5.80: the Google accounts a person wants counted: a list of {email,
+// alias, secret}; `secret` is the password encrypted by the system, in
+// base64.
+constexpr char kGoogleAccountsPref[] = "thoron_mail.google_accounts";
+constexpr size_t kMostGoogleAccounts = 40;
+
+// A Google app password: 16 letters, written with or without spaces.
+bool LooksLikeAppPassword(const std::string& password) {
+  std::string letters;
+  base::RemoveChars(password, " ", &letters);
+  return letters.size() == 16 && std::ranges::all_of(letters, [](char c) {
+    return c >= 'a' && c <= 'z';
+  });
+}
+
+bool IsAddress(const std::string& email) {
+  const size_t at = email.find('@');
+  return at != std::string::npos && at > 0 && at + 1 < email.size() &&
+         email.size() <= 254 && base::IsStringASCII(email) &&
+         std::ranges::none_of(email, [](char c) {
+           return base::IsAsciiWhitespace(c) || c == '<' || c == '>' ||
+                  c == '"';
+         });
+}
+
+// The page a mailbox's mail is read on: https, or nothing.
+std::string CheckedWebmail(const std::string& webmail) {
+  const GURL url(webmail);
+  return url.is_valid() && url.SchemeIs(url::kHttpsScheme) &&
+                 webmail.size() <= 500
+             ? url.spec()
+             : std::string();
+}
+
+// `account` with what is left out filled in, or nullopt when it is not a
+// mailbox's details.
+std::optional<thoron_mail::ImapAccount> CheckedAccount(
+    thoron_mail::ImapAccount account) {
+  account.email = std::string(
+      base::TrimWhitespaceASCII(account.email, base::TRIM_ALL));
+  account.host = base::ToLowerASCII(
+      base::TrimWhitespaceASCII(account.host, base::TRIM_ALL));
+  if (account.user.empty()) {
+    account.user = account.email;
+  }
+  account.webmail = CheckedWebmail(account.webmail);
+  if (!IsAddress(account.email) || !thoron_mail::IsImapHost(account.host) ||
+      account.port <= 0 || account.port > 65535 || account.password.empty() ||
+      account.password.size() > 1024 || account.user.size() > 320) {
+    return std::nullopt;
+  }
+  return account;
+}
+
+// The backup's text sealed, or opened, off the UI thread (slow on purpose).
+std::string Sealed(std::string backup, std::string passphrase) {
+  return thoron_mail::SealBackup(backup, passphrase);
+}
+
+std::optional<std::string> Opened(std::string file, std::string passphrase) {
+  return thoron_mail::OpenBackup(file, passphrase);
+}
+
+}  // namespace
+
+void ThoronMailCenter::OnEncryptor(
+    scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+  encryptor_ = std::move(encryptor);
+  service_->SetImapAccounts(KeptImapAccounts());
+}
+
+std::vector<thoron_mail::ImapAccount> ThoronMailCenter::KeptImapAccounts()
+    const {
+  std::vector<thoron_mail::ImapAccount> accounts;
+  if (!encryptor_) {
+    return accounts;
+  }
+  for (const base::Value& value :
+       profile_->GetPrefs()->GetList(kImapAccountsPref)) {
+    const base::DictValue* dict = value.GetIfDict();
+    const std::string* email = dict ? dict->FindString("email") : nullptr;
+    const std::string* host = dict ? dict->FindString("host") : nullptr;
+    const std::string* secret = dict ? dict->FindString("secret") : nullptr;
+    std::string encrypted;
+    thoron_mail::ImapAccount account;
+    if (!email || !host || !secret ||
+        !base::Base64Decode(*secret, &encrypted) ||
+        !encryptor_->DecryptString(encrypted, &account.password)) {
+      continue;
+    }
+    account.email = *email;
+    account.host = *host;
+    account.port = dict->FindInt("port").value_or(993);
+    if (const std::string* user = dict->FindString("user")) {
+      account.user = *user;
+    }
+    if (const std::string* webmail = dict->FindString("webmail")) {
+      account.webmail = *webmail;
+    }
+    if (std::optional<thoron_mail::ImapAccount> checked =
+            CheckedAccount(std::move(account))) {
+      accounts.push_back(std::move(*checked));
+    }
+  }
+  return accounts;
+}
+
+bool ThoronMailCenter::KeepImapAccounts(
+    const std::vector<thoron_mail::ImapAccount>& accounts) {
+  if (!encryptor_) {
+    return false;
+  }
+  base::ListValue kept;
+  for (const thoron_mail::ImapAccount& account : accounts) {
+    std::string encrypted;
+    if (!encryptor_->EncryptString(account.password, &encrypted)) {
+      return false;
+    }
+    kept.Append(base::DictValue()
+                    .Set("email", account.email)
+                    .Set("host", account.host)
+                    .Set("port", account.port)
+                    .Set("user", account.user)
+                    .Set("webmail", account.webmail)
+                    .Set("secret", base::Base64Encode(encrypted)));
+  }
+  profile_->GetPrefs()->SetList(kImapAccountsPref, std::move(kept));
+  service_->SetImapAccounts(accounts);
+  return true;
+}
+
+void ThoronMailCenter::AddImapAccount(thoron_mail::ImapAccount account,
+                                      Told told) {
+  std::optional<thoron_mail::ImapAccount> checked =
+      CheckedAccount(std::move(account));
+  if (!checked) {
+    std::move(told).Run("bad");
+    return;
+  }
+  if (!encryptor_) {
+    std::move(told).Run("locked");
+    return;
+  }
+  const std::vector<thoron_mail::ImapAccount>& known =
+      service_->imap_accounts();
+  if (std::ranges::any_of(known, [&](const thoron_mail::ImapAccount& other) {
+        return base::EqualsCaseInsensitiveASCII(other.email, checked->email);
+      })) {
+    std::move(told).Run("exists");
+    return;
+  }
+  if (known.size() >= thoron_mail::MailService::kMostImapAccounts) {
+    std::move(told).Run("full");
+    return;
+  }
+  if (imap_test_) {
+    std::move(told).Run("busy");
+    return;
+  }
+  // Signed in to once before it is kept: a wrong password is told at once.
+  thoron_mail::ImapAccount to_test = *checked;
+  imap_test_ = std::make_unique<thoron_mail::ImapCheck>(
+      profile_->GetDefaultStoragePartition()->GetNetworkContext(), to_test,
+      base::BindOnce(&ThoronMailCenter::OnImapTested,
+                     weak_factory_.GetWeakPtr(), std::move(*checked),
+                     std::move(told)));
+}
+
+void ThoronMailCenter::OnImapTested(thoron_mail::ImapAccount account,
+                                    Told told,
+                                    thoron_mail::ImapCheck::Result result) {
+  // this runs from inside the test
+  base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+      FROM_HERE, std::move(imap_test_));
+  if (!result.problem.empty()) {
+    std::move(told).Run(result.problem);
+    return;
+  }
+  std::vector<thoron_mail::ImapAccount> accounts = service_->imap_accounts();
+  accounts.push_back(std::move(account));
+  std::move(told).Run(KeepImapAccounts(accounts) ? std::string() : "locked");
+}
+
+void ThoronMailCenter::RemoveImapAccount(const std::string& email) {
+  std::vector<thoron_mail::ImapAccount> accounts = service_->imap_accounts();
+  const size_t before = accounts.size();
+  std::erase_if(accounts, [&](const thoron_mail::ImapAccount& account) {
+    return account.email == email;
+  });
+  if (accounts.size() != before) {
+    KeepImapAccounts(accounts);
+  }
+}
+
+std::vector<ThoronMailCenter::GoogleAccount>
+ThoronMailCenter::KeptGoogleAccounts() const {
+  std::vector<GoogleAccount> accounts;
+  for (const base::Value& value :
+       profile_->GetPrefs()->GetList(kGoogleAccountsPref)) {
+    const base::DictValue* dict = value.GetIfDict();
+    const std::string* email = dict ? dict->FindString("email") : nullptr;
+    if (!email || !IsAddress(*email)) {
+      continue;
+    }
+    GoogleAccount account;
+    account.email = *email;
+    if (const std::string* alias = dict->FindString("alias")) {
+      account.alias = *alias;
+    }
+    if (const std::string* secret = dict->FindString("secret")) {
+      account.secret = *secret;
+      std::string encrypted;
+      if (encryptor_ && base::Base64Decode(*secret, &encrypted) &&
+          !encryptor_->DecryptString(encrypted, &account.password)) {
+        account.password.clear();
+      }
+    }
+    accounts.push_back(std::move(account));
+  }
+  return accounts;
+}
+
+bool ThoronMailCenter::KeepGoogleAccounts(
+    const std::vector<GoogleAccount>& accounts) {
+  if (!encryptor_) {
+    return false;
+  }
+  base::ListValue kept;
+  for (const GoogleAccount& account : accounts) {
+    base::DictValue entry =
+        base::DictValue().Set("email", account.email).Set("alias", account.alias);
+    if (!account.password.empty()) {
+      std::string encrypted;
+      if (!encryptor_->EncryptString(account.password, &encrypted)) {
+        return false;
+      }
+      entry.Set("secret", base::Base64Encode(encrypted));
+    } else if (!account.secret.empty()) {
+      // a password that could not be read now is kept as it is
+      entry.Set("secret", account.secret);
+    }
+    kept.Append(std::move(entry));
+  }
+  profile_->GetPrefs()->SetList(kGoogleAccountsPref, std::move(kept));
+  return true;
+}
+
+int ThoronMailCenter::MergeGoogleAccounts(std::vector<GoogleAccount> given) {
+  if (!encryptor_) {
+    return -1;
+  }
+  std::vector<GoogleAccount> accounts = KeptGoogleAccounts();
+  int taken = 0;
+  for (GoogleAccount& account : given) {
+    account.email = std::string(
+        base::TrimWhitespaceASCII(account.email, base::TRIM_ALL));
+    if (!IsAddress(account.email) || account.password.size() > 1024 ||
+        account.alias.size() > 200 || !base::IsStringUTF8(account.alias)) {
+      continue;
+    }
+    account.secret.clear();
+    const std::string name = thoron_mail::CanonicalAddress(account.email);
+    auto known = std::ranges::find_if(accounts, [&](const GoogleAccount& other) {
+      return thoron_mail::CanonicalAddress(other.email) == name;
+    });
+    if (known != accounts.end()) {
+      if (!account.alias.empty()) {
+        known->alias = account.alias;
+      }
+      if (!account.password.empty()) {
+        known->password = account.password;
+      }
+    } else if (accounts.size() < kMostGoogleAccounts) {
+      accounts.push_back(std::move(account));
+    } else {
+      continue;
+    }
+    ++taken;
+  }
+  return KeepGoogleAccounts(accounts) ? taken : -1;
+}
+
+ThoronMailCenter::GoogleImported ThoronMailCenter::ImportGoogleAccounts(
+    std::vector<GoogleAccount> given) {
+  GoogleImported done;
+  if (!encryptor_) {
+    done.error = "locked";
+    return done;
+  }
+  // An app password opens the mailbox itself, whether or not Thoron is signed
+  // in to the account at Google: such an account is a mailbox as well. It
+  // stays in the list, so it is not lost when the mail server does not take
+  // the password after all.
+  std::vector<thoron_mail::ImapAccount> mailboxes = service_->imap_accounts();
+  std::vector<GoogleAccount> listed;
+  for (GoogleAccount& account : given) {
+    listed.push_back(account);
+    if (!LooksLikeAppPassword(account.password)) {
+      continue;
+    }
+    const std::string name = thoron_mail::CanonicalAddress(account.email);
+    if (std::ranges::any_of(mailboxes,
+                            [&](const thoron_mail::ImapAccount& other) {
+                              return thoron_mail::CanonicalAddress(
+                                         other.email) == name;
+                            }) ||
+        mailboxes.size() >= thoron_mail::MailService::kMostImapAccounts) {
+      continue;
+    }
+    thoron_mail::ImapAccount mailbox;
+    mailbox.email = account.email;
+    mailbox.host = "imap.gmail.com";
+    mailbox.user = account.email;
+    base::RemoveChars(account.password, " ", &mailbox.password);
+    mailbox.webmail = "https://mail.google.com/mail/";
+    if (std::optional<thoron_mail::ImapAccount> checked =
+            CheckedAccount(std::move(mailbox))) {
+      mailboxes.push_back(std::move(*checked));
+      ++done.mailboxes;
+    }
+  }
+  done.google = MergeGoogleAccounts(std::move(listed));
+  if (done.google < 0 || (done.mailboxes > 0 && !KeepImapAccounts(mailboxes))) {
+    done.error = "locked";
+    done.google = std::max(done.google, 0);
+  }
+  return done;
+}
+
+void ThoronMailCenter::RemoveGoogleAccount(const std::string& email) {
+  if (!encryptor_) {
+    return;
+  }
+  std::vector<GoogleAccount> accounts = KeptGoogleAccounts();
+  const size_t before = accounts.size();
+  std::erase_if(accounts, [&](const GoogleAccount& account) {
+    return account.email == email;
+  });
+  if (accounts.size() != before) {
+    KeepGoogleAccounts(accounts);
+  }
+}
+
+void ThoronMailCenter::SignInGoogle(const std::string& email) {
+  // only for an address of the list: a page cannot have any address opened
+  const std::vector<GoogleAccount> accounts = KeptGoogleAccounts();
+  if (std::ranges::none_of(accounts, [&](const GoogleAccount& account) {
+        return account.email == email;
+      })) {
+    return;
+  }
+  const GURL url = net::AppendQueryParameter(
+      GURL("https://accounts.google.com/AddSession?service=mail&continue="
+           "https%3A%2F%2Fmail.google.com%2Fmail%2F"),
+      "Email", email);
+  NavigateParams params(profile_, url, ui::PAGE_TRANSITION_LINK);
+  params.disposition = WindowOpenDisposition::kNewForegroundTab;
+  params.window_action = NavigateParams::WindowAction::kShowWindow;
+  Navigate(&params);
+}
+
+bool ThoronMailCenter::CopyGooglePassword(const std::string& email) {
+  for (const GoogleAccount& account : KeptGoogleAccounts()) {
+    if (account.email == email && !account.password.empty()) {
+      ui::ScopedClipboardWriter writer(ui::ClipboardBuffer::kCopyPaste);
+      writer.WriteText(base::UTF8ToUTF16(account.password));
+      // not kept in the clipboard's history or sent to other devices
+      writer.MarkAsConfidential();
+      return true;
+    }
+  }
+  return false;
+}
+
+void ThoronMailCenter::OpenPage(const GURL& url) {
+  if (!url.is_valid() || !url.SchemeIs(url::kHttpsScheme)) {
+    return;
+  }
+  BrowserWindowInterface* found = nullptr;
+  int tab = -1;
+  if (service_->Choice("open") != "new") {
+    ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+        [&](BrowserWindowInterface* browser) {
+          if (browser->GetProfile() != profile_) {
+            return true;
+          }
+          TabStripModel* tabs = browser->GetTabStripModel();
+          for (int i = 0; i < tabs->count(); ++i) {
+            if (tabs->GetWebContentsAt(i)->GetLastCommittedURL().host() ==
+                url.host()) {
+              found = browser;
+              tab = i;
+              return false;
+            }
+          }
+          return true;
+        });
+  }
+  if (found) {
+    found->GetTabStripModel()->ActivateTabAt(tab);
+    found->GetWindow()->Activate();
+    return;
+  }
+  NavigateParams params(profile_, url, ui::PAGE_TRANSITION_LINK);
+  params.disposition = WindowOpenDisposition::kNewForegroundTab;
+  params.window_action = NavigateParams::WindowAction::kShowWindow;
+  Navigate(&params);
+}
+
+void ThoronMailCenter::OpenAccount(int index) {
+  for (const thoron_mail::MailAccount& account : service_->accounts()) {
+    if (account.index != index) {
+      continue;
+    }
+    if (!account.imap) {
+      // marks it looked at, too
+      OpenGmail(thoron_mail::MailService::InboxUrl(index), index);
+      return;
+    }
+    const std::string email = account.email;
+    const GURL webmail(account.webmail);
+    service_->MarkLooked(email);
+    OpenPage(webmail);
+    return;
+  }
+}
+
+void ThoronMailCenter::OpenManagePage(bool add) {
+  NavigateParams params(profile_,
+                        GURL(std::string(kThoronMailMenuUrl) +
+                             (add ? "#manage-add" : "#manage")),
+                        ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+  params.disposition = WindowOpenDisposition::kSingletonTab;
+  params.window_action = NavigateParams::WindowAction::kShowWindow;
+  Navigate(&params);
+}
+
+base::DictValue ThoronMailCenter::BackupDict(bool with_passwords) const {
+  base::DictValue choices;
+  for (const char* name : {"sound", "count", "open", "messages", "which",
+                           "place", "toolbar-position", "address-position"}) {
+    choices.Set(name, service_->Choice(name));
+  }
+  base::ListValue accounts;
+  for (const thoron_mail::ImapAccount& account : service_->imap_accounts()) {
+    base::DictValue entry = base::DictValue()
+                                .Set("email", account.email)
+                                .Set("host", account.host)
+                                .Set("port", account.port)
+                                .Set("user", account.user)
+                                .Set("webmail", account.webmail);
+    if (with_passwords) {
+      entry.Set("password", account.password);
+    }
+    accounts.Append(std::move(entry));
+  }
+  // P5.80: the Google accounts of the person's list
+  base::ListValue google;
+  for (const GoogleAccount& account : KeptGoogleAccounts()) {
+    base::DictValue entry =
+        base::DictValue().Set("email", account.email).Set("alias", account.alias);
+    if (with_passwords && !account.password.empty()) {
+      entry.Set("password", account.password);
+    }
+    google.Append(std::move(entry));
+  }
+  PrefService* prefs = profile_->GetPrefs();
+  return base::DictValue()
+      .Set("format", thoron_mail::kBackupFormat)
+      .Set("version", 1)
+      .Set("sealed", false)
+      .Set("settings",
+           base::DictValue()
+               .Set("notify", service_->notify())
+               .Set("interval", service_->interval_minutes())
+               .Set("choices", std::move(choices))
+               .Set("ignored", prefs->GetList("thoron_mail.ignored").Clone())
+               .Set("order", prefs->GetString("thoron.toolbar_order")))
+      .Set("accounts", std::move(accounts))
+      .Set("google", std::move(google));
+}
+
+void ThoronMailCenter::ExportBackup(bool with_passwords,
+                                    std::string passphrase,
+                                    Exported done) {
+  const bool seal = !passphrase.empty();
+  std::string backup =
+      base::WriteJsonWithOptions(BackupDict(with_passwords || seal),
+                                 base::JSONWriter::OPTIONS_PRETTY_PRINT)
+          .value_or(std::string());
+  if (!seal) {
+    std::move(done).Run(std::move(backup));
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&Sealed, std::move(backup), std::move(passphrase)),
+      std::move(done));
+}
+
+void ThoronMailCenter::ImportBackup(std::string file,
+                                    std::string passphrase,
+                                    Imported done) {
+  if (file.empty() || file.size() > kMostBackupBytes) {
+    std::move(done).Run("bad", 0);
+    return;
+  }
+  if (!thoron_mail::IsSealedBackup(file)) {
+    ApplyBackup(std::move(done), std::move(file));
+    return;
+  }
+  if (passphrase.empty()) {
+    std::move(done).Run("passphrase", 0);
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&Opened, std::move(file), std::move(passphrase)),
+      base::BindOnce(&ThoronMailCenter::ApplyBackup, weak_factory_.GetWeakPtr(),
+                     std::move(done)));
+}
+
+void ThoronMailCenter::ApplyBackup(Imported done,
+                                   std::optional<std::string> backup) {
+  if (!backup) {
+    std::move(done).Run("wrong", 0);
+    return;
+  }
+  std::optional<base::DictValue> dict =
+      base::JSONReader::ReadDict(*backup, base::JSON_PARSE_RFC);
+  const std::string* format = dict ? dict->FindString("format") : nullptr;
+  if (!format || *format != thoron_mail::kBackupFormat ||
+      dict->FindBool("sealed").value_or(false) ||
+      dict->FindInt("version").value_or(0) != 1) {
+    std::move(done).Run("bad", 0);
+    return;
+  }
+  if (!encryptor_) {
+    std::move(done).Run("locked", 0);
+    return;
+  }
+  // The settings: only what the M-Notifier knows, each checked as when a
+  // person sets it.
+  PrefService* prefs = profile_->GetPrefs();
+  if (const base::DictValue* settings = dict->FindDict("settings")) {
+    if (std::optional<bool> notify = settings->FindBool("notify")) {
+      service_->SetNotify(*notify);
+    }
+    if (std::optional<int> interval = settings->FindInt("interval")) {
+      service_->SetInterval(*interval);
+    }
+    if (const base::DictValue* choices = settings->FindDict("choices")) {
+      for (const auto [name, value] : *choices) {
+        if (value.is_string()) {
+          service_->SetChoice(name, value.GetString());
+        }
+      }
+    }
+    if (const base::ListValue* ignored = settings->FindList("ignored")) {
+      base::ListValue kept;
+      for (const base::Value& value : *ignored) {
+        if (value.is_string() && IsAddress(value.GetString()) &&
+            kept.size() < 50) {
+          kept.Append(value.GetString());
+        }
+      }
+      prefs->SetList("thoron_mail.ignored", std::move(kept));
+    }
+    if (const std::string* order = settings->FindString("order");
+        order && (*order == "mail,adblock" || *order == "adblock,mail")) {
+      prefs->SetString("thoron.toolbar_order", *order);
+    }
+  }
+  // P5.80: the Google accounts of the person's list. One the backup names
+  // without its password keeps the password it has here.
+  if (const base::ListValue* list = dict->FindList("google")) {
+    std::vector<GoogleAccount> google;
+    for (const base::Value& value : *list) {
+      const base::DictValue* entry = value.GetIfDict();
+      const std::string* email = entry ? entry->FindString("email") : nullptr;
+      if (!email) {
+        continue;
+      }
+      GoogleAccount account;
+      account.email = *email;
+      if (const std::string* alias = entry->FindString("alias")) {
+        account.alias = *alias;
+      }
+      if (const std::string* password = entry->FindString("password")) {
+        account.password = *password;
+      }
+      google.push_back(std::move(account));
+    }
+    MergeGoogleAccounts(std::move(google));
+  }
+  // The mailboxes: those of the backup, then those there were that it does
+  // not name. One the backup names without its password keeps the password
+  // it has here, or is left out.
+  std::vector<thoron_mail::ImapAccount> accounts;
+  const std::vector<thoron_mail::ImapAccount> known = service_->imap_accounts();
+  auto has = [&accounts](const std::string& email) {
+    return std::ranges::any_of(accounts,
+                               [&](const thoron_mail::ImapAccount& account) {
+                                 return account.email == email;
+                               });
+  };
+  if (const base::ListValue* list = dict->FindList("accounts")) {
+    for (const base::Value& value : *list) {
+      const base::DictValue* entry = value.GetIfDict();
+      const std::string* email = entry ? entry->FindString("email") : nullptr;
+      const std::string* host = entry ? entry->FindString("host") : nullptr;
+      if (!email || !host ||
+          accounts.size() >= thoron_mail::MailService::kMostImapAccounts) {
+        continue;
+      }
+      thoron_mail::ImapAccount account;
+      account.email = *email;
+      account.host = *host;
+      account.port = entry->FindInt("port").value_or(993);
+      if (const std::string* user = entry->FindString("user")) {
+        account.user = *user;
+      }
+      if (const std::string* webmail = entry->FindString("webmail")) {
+        account.webmail = *webmail;
+      }
+      if (const std::string* password = entry->FindString("password")) {
+        account.password = *password;
+      } else {
+        for (const thoron_mail::ImapAccount& old : known) {
+          if (old.email == *email) {
+            account.password = old.password;
+          }
+        }
+      }
+      std::optional<thoron_mail::ImapAccount> checked =
+          CheckedAccount(std::move(account));
+      if (checked && !has(checked->email)) {
+        accounts.push_back(std::move(*checked));
+      }
+    }
+  }
+  for (const thoron_mail::ImapAccount& old : known) {
+    if (!has(old.email) &&
+        accounts.size() < thoron_mail::MailService::kMostImapAccounts) {
+      accounts.push_back(old);
+    }
+  }
+  if (!KeepImapAccounts(accounts)) {
+    std::move(done).Run("locked", 0);
+    return;
+  }
+  std::move(done).Run(std::string(), static_cast<int>(accounts.size()));
+}
+
+void ThoronMailCenter::PlayNewMailSound() {
+  // The offline checks (a local server stands in for Gmail) count the sound
+  // and do not make it.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "thoron-mail-feeds-for-testing")) {
+    return;
+  }
+#if BUILDFLAG(IS_WIN)
+  // Windows' own sound for new mail (the person's sound scheme), else its
+  // plain notice sound. Not waited for.
+  if (!::PlaySoundW(L"MailBeep", nullptr,
+                    SND_ALIAS | SND_ASYNC | SND_NODEFAULT)) {
+    ::MessageBeep(MB_ICONASTERISK);
+  }
+#endif
+}
+
+void ThoronMailCenter::OpenSignIn(bool add) {
+  const GURL url(
+      add ? "https://accounts.google.com/AddSession?service=mail&continue="
+            "https%3A%2F%2Fmail.google.com%2Fmail%2F"
+          : "https://accounts.google.com/ServiceLogin?service=mail&continue="
+            "https%3A%2F%2Fmail.google.com%2Fmail%2F");
+  NavigateParams params(profile_, url, ui::PAGE_TRANSITION_LINK);
+  params.disposition = WindowOpenDisposition::kNewForegroundTab;
+  params.window_action = NavigateParams::WindowAction::kShowWindow;
+  Navigate(&params);
+}
+
+void ThoronMailCenter::OnNewMail(
+    const thoron_mail::MailAccount& account,
+    const std::vector<thoron_mail::MailMessage>& messages) {
+  if (messages.empty()) {
+    return;
+  }
+  // The sound is the M-Notifier's own, so it comes with or without a notice
+  // (P5.78); a notice is then silent, or there would be two.
+  if (service_->Choice("sound") == "on") {
+    PlayNewMailSound();
+    ++sounds_played_;
+  }
+  NotificationDisplayService* display =
+      NotificationDisplayServiceFactory::GetForProfile(profile_);
+  if (!service_->notify() || !display) {
+    return;
+  }
+  auto notice = [&](const std::string& id, const std::u16string& title,
+                    const std::u16string& text, const GURL& open) {
+    // Unretained: a notice that outlives the profile is never clicked.
+    auto delegate =
+        base::MakeRefCounted<message_center::HandleNotificationClickDelegate>(
+            base::BindRepeating(
+                [](ThoronMailCenter* center, GURL url, int index,
+                   std::optional<int> button) {
+                  center->OpenGmail(url, index);
+                },
+                base::Unretained(this), open, account.index));
+    // silent: the sound is the M-Notifier's own (above)
+    message_center::RichNotificationData data;
+    data.silent = true;
+    ++notices_shown_;
+    message_center::Notification notification(
+        message_center::NOTIFICATION_TYPE_SIMPLE, id, title, text,
+        ui::ImageModel(), base::UTF8ToUTF16(account.email),
+        GURL("https://mail.google.com/"),
+#if BUILDFLAG(IS_CHROMEOS)
+        message_center::NotifierId(
+            message_center::NotifierType::SYSTEM_COMPONENT, kNotifierId,
+            ash::NotificationCatalogName::kNone),
+#else
+        message_center::NotifierId(
+            message_center::NotifierType::SYSTEM_COMPONENT, kNotifierId),
+#endif
+        data, delegate);
+    display->Display(NotificationHandler::Type::TRANSIENT, notification,
+                     /*metadata=*/nullptr);
+  };
+  if (messages.size() > kMostNotices) {
+    notice("thoron.mail." + account.email,
+           base::NumberToString16(messages.size()) + u" new messages",
+           base::UTF8ToUTF16(account.email),
+           thoron_mail::MailService::InboxUrl(account.index));
+    return;
+  }
+  for (const thoron_mail::MailMessage& message : messages) {
+    const std::string link = thoron_mail::GmailLink(message.link);
+    notice("thoron.mail." + account.email + "." + message.id,
+           base::UTF8ToUTF16(message.from_name.empty() ? message.from_email
+                                                       : message.from_name),
+           base::UTF8ToUTF16(message.subject),
+           link.empty() ? thoron_mail::MailService::InboxUrl(account.index)
+                        : GURL(link));
+  }
+}
+
+ThoronMailMenuUIConfig::ThoronMailMenuUIConfig()
+    : DefaultTopChromeWebUIConfig(content::kChromeUIScheme,
+                                  kThoronMailMenuHost) {}
+
+bool ThoronMailMenuUIConfig::IsWebUIEnabled(
+    content::BrowserContext* browser_context) {
+  return base::FeatureList::IsEnabled(thoron_mail::kThoronMailNotifier);
+}
+
+bool ThoronMailMenuUIConfig::ShouldAutoResizeHost() {
+  return true;
+}
+
+ThoronMailMenuUI::ThoronMailMenuUI(content::WebUI* web_ui)
+    : TopChromeWebUIController(web_ui, /*enable_chrome_send=*/true) {
+  content::URLDataSource::Add(Profile::FromWebUI(web_ui),
+                              std::make_unique<MailDataSource>());
+  // the browser theme's colours for the menu (chrome://theme/colors.css)
+  content::URLDataSource::Add(
+      Profile::FromWebUI(web_ui),
+      std::make_unique<ThemeSource>(Profile::FromWebUI(web_ui)));
+  web_ui->AddMessageHandler(std::make_unique<MailHandler>(this));
+}
+
+ThoronMailMenuUI::~ThoronMailMenuUI() = default;
+
+bool ThoronMailMenuUI::TellShown() {
+  if (!ready_) {
+    return false;
+  }
+  const base::Value event("menu-shown");
+  web_ui()->CallJavascriptFunctionUnsafe("cr.webUIListenerCallback", event);
+  return true;
+}
+
+WEB_UI_CONTROLLER_TYPE_IMPL(ThoronMailMenuUI)
