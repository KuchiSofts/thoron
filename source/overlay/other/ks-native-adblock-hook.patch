+
+import("//testing/test.gni")
+
+# Thoron's updater, the part that needs no network and no file (ROADMAP P3.3):
+# what a copy of Thoron makes of a signed update manifest. The format and the
+# rules are docs/update/MANIFEST.md of Thoron's repository.
+static_library("thoron_update") {
+  sources = [
+    "cli.cc",
+    "cli.h",
+    "delta_package.cc",
+    "delta_package.h",
+    "manifest.cc",
+    "manifest.h",
+    "package.cc",
+    "package.h",
+    "setup_plan.cc",
+    "setup_plan.h",
+    "portable_package.cc",
+    "portable_package.h",
+    "snapshot.cc",
+    "snapshot.h",
+    "swap.cc",
+    "swap.h",
+  ]
+  deps = [
+    "//base",
+    "//components/zucchini:zucchini_lib",
+    "//crypto",
+    "//third_party/boringssl",
+    "//third_party/sqlite",
+    "//third_party/zlib",
+    "//third_party/zlib/google:zip",
+  ]
+}
+
+# The browser's own updater (ROADMAP P3.20, P3.9): fetches the manifest and the
+# package over the network and hands the checked package to an installer.
+static_library("client") {
+  sources = [
+    "update_client.cc",
+    "update_client.h",
+  ]
+  public_deps = [ ":thoron_update" ]
+  deps = [
+    "//base",
+    "//components/prefs",
+    "//net",
+    "//services/network/public/cpp",
+    "//services/network/public/mojom",
+    "//url",
+  ]
+}
+
+# The vectors are made by make_test_vectors.py from the reference tool; see
+# README.md.
+source_set("unit_tests") {
+  testonly = true
+  sources = [
+    "cli_unittest.cc",
+    "delta_package_unittest.cc",
+    "key_rotation_unittest.cc",
+    "manifest_test_vectors.h",
+    "manifest_unittest.cc",
+    "package_unittest.cc",
+    "portable_package_unittest.cc",
+    "setup_plan_unittest.cc",
+    "snapshot_unittest.cc",
+    "swap_unittest.cc",
+    "test_zip.cc",
+    "test_zip.h",
+    "update_client_test_data.h",
+    "update_client_unittest.cc",
+  ]
+  deps = [
+    ":client",
+    ":thoron_update",
+    "//base",
+    "//base/test:test_support",
+    "//components/prefs:test_support",
+    "//components/zucchini:zucchini_lib",
+    "//crypto",
+    "//net",
+    "//services/network:test_support",
