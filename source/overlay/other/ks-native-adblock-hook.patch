+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_TOOLBAR_THORON_WINDOWS_SECURITY_H_
+#define CHROME_BROWSER_UI_VIEWS_TOOLBAR_THORON_WINDOWS_SECURITY_H_
+
+namespace thoron {
+
+// Windows asks "is it you?" in a window of its own (Windows Security: Windows
+// Hello or the PIN, for showing and filling saved passwords, for passkeys and
+// security keys, and for a password manager's own check), and it may open
+// that window behind the browser. From the first call on, every such window
+// that opens while the browser is in front, or behind one of its windows, is
+// brought to the front at once. Windows only; elsewhere it does nothing.
+void WatchWindowsSecurityPrompts();
+
+}  // namespace thoron
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TOOLBAR_THORON_WINDOWS_SECURITY_H_
diff --git a/chrome/browser/ui/webui/help/version_updater_thoron_linux.cc b/chrome/browser/ui/webui/help/version_updater_thoron_linux.cc
new file mode 100644
index 0000000000000000000000000000000000000000..6df624e2439d260e13e399c4644a681275ee4e35
--- /dev/null
+++ b/chrome/browser/ui/webui/help/version_updater_thoron_linux.cc
@@ -0,0 +1,78 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The About page's updater on Linux builds without Google's branding
+// (ROADMAP P3.23): the states of Thoron's own update client
+// (chrome/browser/thoron_update), as the page shows them; the same as on
+// Windows (version_updater_thoron_win.cc).
+
+#include <memory>
+#include <string>
+
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/thoron_update/thoron_update_linux.h"
+#include "chrome/browser/ui/webui/help/version_updater.h"
+
+namespace {
+
+class VersionUpdaterThoron : public VersionUpdater {
+ public:
+  VersionUpdaterThoron() = default;
+  VersionUpdaterThoron(const VersionUpdaterThoron&) = delete;
+  VersionUpdaterThoron& operator=(const VersionUpdaterThoron&) = delete;
+  ~VersionUpdaterThoron() override = default;
+
+  // VersionUpdater:
+  void CheckForUpdate(StatusCallback callback, PromoteCallback) override {
+    callback_ = std::move(callback);
+    // Opening the page is asking: a copy that updates itself installs what it
+    // finds, in every mode; a .deb copy only says what is out.
+    thoron_update_linux::Client()->Check(
+        /*install=*/true,
+        base::BindRepeating(&VersionUpdaterThoron::OnStatus, weak_factory_.GetWeakPtr()));
+  }
+
+ private:
+  void OnStatus(const thoron_update::UpdateClient::Status& status) {
+    using Kind = thoron_update::UpdateClient::PageKind;
+    const thoron_update::UpdateClient::Page page =
+        thoron_update::UpdateClient::ForAboutPage(status);
+    Status shown = FAILED;
+    switch (page.kind) {
+      case Kind::kChecking:
+        shown = CHECKING;
+        break;
+      case Kind::kUpdating:
+        shown = UPDATING;
+        break;
+      case Kind::kRelaunch:
+        shown = NEARLY_UPDATED;
+        break;
+      case Kind::kUpToDate:
+        shown = UPDATED;
+        break;
+      case Kind::kFailed:
+        shown = FAILED;
+        break;
+      case Kind::kFailedDownload:
+        shown = FAILED_DOWNLOAD;
+        break;
+      case Kind::kDisabled:
+        shown = DISABLED;
+        break;
+    }
+    callback_.Run(shown, page.progress, false, false, status.version, 0,
+                  base::UTF8ToUTF16(page.message));
+  }
+
+  StatusCallback callback_;
+  base::WeakPtrFactory<VersionUpdaterThoron> weak_factory_{this};
+};
+
+}  // namespace
+
+std::unique_ptr<VersionUpdater> VersionUpdater::Create(content::WebContents* web_contents) {
+  return std::make_unique<VersionUpdaterThoron>();
+}
diff --git a/chrome/browser/ui/webui/help/version_updater_thoron_win.cc b/chrome/browser/ui/webui/help/version_updater_thoron_win.cc
new file mode 100644
index 0000000000000000000000000000000000000000..1a6b50d5f31156d3373b20fc72eb4f04be80f38f
--- /dev/null
+++ b/chrome/browser/ui/webui/help/version_updater_thoron_win.cc
@@ -0,0 +1,78 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The About page's updater on Windows builds without Google's branding
+// (ROADMAP P3.9, P3.20): the states of Thoron's own update client
+// (chrome/browser/thoron_update), as the page shows them.
+
+#include <memory>
+#include <string>
+
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/thoron_update/thoron_update_win.h"
+#include "chrome/browser/ui/webui/help/version_updater.h"
+
+namespace {
+
+using State = thoron_update::UpdateClient::State;
+
+class VersionUpdaterThoron : public VersionUpdater {
+ public:
+  VersionUpdaterThoron() = default;
+  VersionUpdaterThoron(const VersionUpdaterThoron&) = delete;
+  VersionUpdaterThoron& operator=(const VersionUpdaterThoron&) = delete;
+  ~VersionUpdaterThoron() override = default;
+
+  // VersionUpdater:
+  void CheckForUpdate(StatusCallback callback, PromoteCallback) override {
+    callback_ = std::move(callback);
+    // Opening the page is asking: it installs what it finds, in every mode.
+    thoron_update_win::Client()->Check(
+        /*install=*/true,
+        base::BindRepeating(&VersionUpdaterThoron::OnStatus, weak_factory_.GetWeakPtr()));
+  }
+
+ private:
+  void OnStatus(const thoron_update::UpdateClient::Status& status) {
+    using Kind = thoron_update::UpdateClient::PageKind;
+    const thoron_update::UpdateClient::Page page =
+        thoron_update::UpdateClient::ForAboutPage(status);
+    Status shown = FAILED;
+    switch (page.kind) {
+      case Kind::kChecking:
+        shown = CHECKING;
+        break;
+      case Kind::kUpdating:
+        shown = UPDATING;
+        break;
+      case Kind::kRelaunch:
+        shown = NEARLY_UPDATED;
+        break;
+      case Kind::kUpToDate:
+        shown = UPDATED;
+        break;
+      case Kind::kFailed:
+        shown = FAILED;
+        break;
+      case Kind::kFailedDownload:
+        shown = FAILED_DOWNLOAD;
+        break;
+      case Kind::kDisabled:
+        shown = DISABLED;
+        break;
+    }
+    callback_.Run(shown, page.progress, false, false, status.version, 0,
+                  base::UTF8ToUTF16(page.message));
+  }
+
+  StatusCallback callback_;
+  base::WeakPtrFactory<VersionUpdaterThoron> weak_factory_{this};
+};
+
+}  // namespace
+
+std::unique_ptr<VersionUpdater> VersionUpdater::Create(content::WebContents* web_contents) {
+  return std::make_unique<VersionUpdaterThoron>();
+}
