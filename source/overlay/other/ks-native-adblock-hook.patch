+
+import("//build/rust/rust_static_library.gni")
+
+# What a mail server sends is read here, in Rust: one look at a mailbox over
+# IMAP (P5.77). The browser only carries the bytes (imap_check.cc).
+rust_static_library("imap") {
+  crate_root = "imap.rs"
+  sources = [ crate_root ]
+  allow_unsafe = true  # the cxx bridge's generated glue
+  cxx_bindings = [ crate_root ]
+  deps = [ "//third_party/rust/base64/v0_22:lib" ]
+  build_native_rust_unit_tests = true
+}
+
+# Thoron's mail notifier, Thoron M-Notifier: the unread mail of the Google
+# accounts a profile is signed in to, read from Gmail's own feed with the
+# profile's sign-in, and of the mailboxes a person added by address and
+# password (IMAP).
+static_library("thoron_mail") {
+  sources = [
+    "features.cc",
+    "features.h",
+    "imap_check.cc",
+    "imap_check.h",
+    "mail_backup.cc",
+    "mail_backup.h",
+    "mail_feed.cc",
+    "mail_feed.h",
+    "mail_page.cc",
+    "mail_page.h",
+    "mail_service.cc",
+    "mail_service.h",
+  ]
+  public_deps = [
+    ":imap",
+    "//mojo/public/cpp/bindings",
+    "//mojo/public/cpp/system",
+    "//services/network/public/mojom",
+  ]
+  deps = [
+    "//base",
+    "//base:i18n",
+    "//components/prefs",
+    "//crypto",
+    "//net",
+    "//services/data_decoder/public/cpp",
+    "//services/data_decoder/public/mojom",
+    "//services/network/public/cpp",
+    "//third_party/boringssl",
+    "//url",
+  ]
+}
