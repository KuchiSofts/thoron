@@ -0,0 +1,36 @@
+# Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+declare_args() {
+  # The base64 of the Ed25519 public key update manifests are checked with
+  # (docs/update/MANIFEST.md). Empty: the browser never looks for updates and
+  # ThoronSetup.exe installs nothing.
+  thoron_update_public_key = ""
+
+  # The channel's update.json; update.json.sig and update.key are beside it.
+  thoron_update_manifest_url =
+      "https://github.com/KuchiSofts/thoron/releases/latest/download/update.json"
+
+  thoron_update_channel = "stable"
+}
+
+# The public half of the published test key of the reference tool
+# (components/thoron_update/make_test_vectors.py: its private half is in the
+# repository). Only programs made for tests trust it; nothing shipped does.
+thoron_update_test_public_key = "9i/S9Os0cVBrrPIeJJEiTNqJucILUa97MBNquyuERHM="
+
+# The variant this build is, as the manifest names it.
+if (is_linux) {
+  _os = "linux"
+} else {
+  _os = "win"
+}
+if (current_cpu == "arm64") {
+  thoron_update_variant = "$_os-arm64-armv8"
+} else if (thorium_x86_profile == "avx512_skx") {
+  thoron_update_variant = "$_os-x64-avx512"
+} else if (thorium_x86_profile == "avx2_fma") {
+  thoron_update_variant = "$_os-x64-avx2"
+} else {
+  thoron_update_variant = "$_os-x64-sse4"
+}
