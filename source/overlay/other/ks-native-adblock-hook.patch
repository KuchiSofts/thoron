@@ -0,0 +1,266 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/thoron_portable/unlock_dialog_win.h"
+
+#include <windows.h>
+
+#include <algorithm>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/strings/string_util_win.h"
+#include "base/strings/utf_string_conversions.h"
+#include "components/thoron_portable_key/secret_bytes.h"
+
+namespace thoron_portable {
+
+namespace {
+
+// The window's controls.
+constexpr WORD kTextId = 100;
+constexpr WORD kLabelId = 101;
+constexpr WORD kEditId = 102;
+constexpr WORD kRememberId = 103;
+constexpr WORD kStatusId = 104;
+constexpr WORD kSwitchId = 105;
+
+// Windows' own classes of controls, by atom.
+constexpr WORD kButton = 0x0080;
+constexpr WORD kEdit = 0x0081;
+constexpr WORD kStatic = 0x0082;
+
+constexpr wchar_t kTitle[] = L"Thoron";
+constexpr wchar_t kText[] =
+    L"This portable copy of Thoron keeps its saved passwords and sign-ins "
+    L"locked with a passphrase. Type it to open them.";
+constexpr wchar_t kPassphraseLabel[] = L"Passphrase:";
+constexpr wchar_t kRecoveryLabel[] =
+    L"Recovery key (the eight groups of four you wrote down):";
+constexpr wchar_t kUseRecovery[] = L"Use the recovery key";
+constexpr wchar_t kUsePassphrase[] = L"Use the passphrase";
+constexpr wchar_t kRemember[] =
+    L"Remember this PC for this Windows account (no passphrase here next time)";
+constexpr wchar_t kChecking[] = L"Checking...";
+constexpr wchar_t kBullet = 0x25CF;
+
+// A dialog template built in memory (DLGTEMPLATE and its DLGITEMTEMPLATEs),
+// so the window needs no resource file.
+class DialogTemplate {
+ public:
+  DialogTemplate(DWORD style, DWORD ex_style, short cx, short cy) {
+    Dword(style);
+    Dword(ex_style);
+    count_at_ = words_.size();
+    Word(0);  // the number of controls, counted in Add()
+    Short(0);
+    Short(0);
+    Short(cx);
+    Short(cy);
+    Word(0);  // no menu
+    Word(0);  // the default class
+    String(kTitle);
+    Word(9);  // DS_SETFONT: 9 points
+    String(L"Segoe UI");
+  }
+
+  void Add(WORD id,
+           WORD atom,
+           DWORD style,
+           short x,
+           short y,
+           short cx,
+           short cy,
+           std::wstring_view text) {
+    // every control starts on a DWORD
+    if (words_.size() % 2) {
+      Word(0);
+    }
+    Dword(style | WS_CHILD | WS_VISIBLE);
+    Dword(0);
+    Short(x);
+    Short(y);
+    Short(cx);
+    Short(cy);
+    Word(id);
+    Word(0xFFFF);
+    Word(atom);
+    String(text);
+    Word(0);  // no creation data
+    ++words_[count_at_];
+  }
+
+  const DLGTEMPLATE* get() const {
+    return reinterpret_cast<const DLGTEMPLATE*>(words_.data());
+  }
+
+ private:
+  void Word(WORD w) { words_.push_back(w); }
+  void Short(short s) { words_.push_back(static_cast<WORD>(s)); }
+  void Dword(DWORD d) {
+    Word(LOWORD(d));
+    Word(HIWORD(d));
+  }
+  void String(std::wstring_view s) {
+    for (wchar_t c : s) {
+      Word(static_cast<WORD>(c));
+    }
+    Word(0);
+  }
+
+  std::vector<WORD> words_;
+  size_t count_at_ = 0;
+};
+
+struct DialogState {
+  bool can_remember = false;
+  bool recovery = false;
+  TryUnlock try_unlock;
+};
+
+void Enable(HWND dialog, bool enable) {
+  for (int id : {int{kEditId}, int{kRememberId}, int{kSwitchId}, IDOK, IDCANCEL}) {
+    ::EnableWindow(::GetDlgItem(dialog, id), enable);
+  }
+}
+
+void ShowMode(HWND dialog, const DialogState& state) {
+  HWND edit = ::GetDlgItem(dialog, kEditId);
+  ::SetDlgItemTextW(dialog, kLabelId,
+                    state.recovery ? kRecoveryLabel : kPassphraseLabel);
+  ::SetDlgItemTextW(dialog, kSwitchId,
+                    state.recovery ? kUsePassphrase : kUseRecovery);
+  ::SetWindowTextW(edit, L"");
+  ::SendMessageW(edit, EM_SETPASSWORDCHAR, state.recovery ? 0 : kBullet, 0);
+  ::InvalidateRect(edit, nullptr, TRUE);
+  ::SetFocus(edit);
+}
+
+// The edit field's text; the field is emptied.
+void TakeText(HWND dialog, std::u16string& out) {
+  HWND edit = ::GetDlgItem(dialog, kEditId);
+  const int length = ::GetWindowTextLengthW(edit);
+  out.assign(static_cast<size_t>(std::max(length, 0)) + 1, u'\0');
+  const int got = ::GetWindowTextW(edit, reinterpret_cast<wchar_t*>(out.data()),
+                                   static_cast<int>(out.size()));
+  thoron_portable_key::Wipe(base::as_writable_byte_span(out).subspan(
+      static_cast<size_t>(std::max(got, 0)) * sizeof(char16_t)));
+  out.resize(static_cast<size_t>(std::max(got, 0)));
+  ::SetWindowTextW(edit, L"");
+}
+
+INT_PTR CALLBACK DialogProc(HWND dialog,
+                            UINT message,
+                            WPARAM wparam,
+                            LPARAM lparam) {
+  DialogState* state =
+      reinterpret_cast<DialogState*>(::GetWindowLongPtrW(dialog, DWLP_USER));
+  switch (message) {
+    case WM_INITDIALOG: {
+      state = reinterpret_cast<DialogState*>(lparam);
+      ::SetWindowLongPtrW(dialog, DWLP_USER, lparam);
+      if (!state->can_remember) {
+        ::ShowWindow(::GetDlgItem(dialog, kRememberId), SW_HIDE);
+      }
+      ShowMode(dialog, *state);
+      ::SetForegroundWindow(dialog);
+      return FALSE;  // the focus is set
+    }
+    case WM_COMMAND:
+      switch (LOWORD(wparam)) {
+        case IDOK: {
+          UnlockAttempt attempt;
+          TakeText(dialog, attempt.secret);
+          if (attempt.secret.empty()) {
+            ::SetFocus(::GetDlgItem(dialog, kEditId));
+            return TRUE;
+          }
+          attempt.recovery = state->recovery;
+          attempt.remember =
+              state->can_remember &&
+              ::IsDlgButtonChecked(dialog, kRememberId) == BST_CHECKED;
+          Enable(dialog, false);
+          ::SetDlgItemTextW(dialog, kStatusId, kChecking);
+          ::UpdateWindow(dialog);
+          HCURSOR before = ::SetCursor(::LoadCursorW(nullptr, IDC_WAIT));
+          const std::u16string problem = state->try_unlock.Run(attempt);
+          ::SetCursor(before);
+          if (problem.empty()) {
+            ::EndDialog(dialog, 1);
+            return TRUE;
+          }
+          ::SetDlgItemTextW(dialog, kStatusId, base::as_wcstr(problem));
+          Enable(dialog, true);
+          ::SetFocus(::GetDlgItem(dialog, kEditId));
+          return TRUE;
+        }
+        case IDCANCEL:
+          ::EndDialog(dialog, 0);
+          return TRUE;
+        case kSwitchId:
+          state->recovery = !state->recovery;
+          ::SetDlgItemTextW(dialog, kStatusId, L"");
+          ShowMode(dialog, *state);
+          return TRUE;
+      }
+      return FALSE;
+  }
+  return FALSE;
+}
+
+}  // namespace
+
+UnlockAttempt::UnlockAttempt() = default;
+
+UnlockAttempt::~UnlockAttempt() {
+  thoron_portable_key::Wipe(base::as_writable_byte_span(secret));
+}
+
+bool RunUnlockDialog(bool can_remember, const TryUnlock& try_unlock) {
+  DialogTemplate dialog(DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP |
+                            WS_CAPTION | WS_SYSMENU,
+                        WS_EX_APPWINDOW, 270, 150);
+  dialog.Add(kTextId, kStatic, SS_LEFT, 10, 10, 250, 26, kText);
+  dialog.Add(kLabelId, kStatic, SS_LEFT, 10, 42, 250, 10, kPassphraseLabel);
+  dialog.Add(kEditId, kEdit, ES_PASSWORD | ES_AUTOHSCROLL | WS_BORDER |
+                                 WS_TABSTOP,
+             10, 54, 250, 14, L"");
+  dialog.Add(kRememberId, kButton, BS_AUTOCHECKBOX | WS_TABSTOP, 10, 74, 250,
+             12, kRemember);
+  dialog.Add(kStatusId, kStatic, SS_LEFT, 10, 92, 250, 26, L"");
+  dialog.Add(kSwitchId, kButton, BS_PUSHBUTTON | WS_TABSTOP, 10, 126, 110, 14,
+             kUseRecovery);
+  dialog.Add(IDOK, kButton, BS_DEFPUSHBUTTON | WS_TABSTOP, 156, 126, 50, 14,
+             L"Unlock");
+  dialog.Add(IDCANCEL, kButton, BS_PUSHBUTTON | WS_TABSTOP, 210, 126, 50, 14,
+             L"Quit");
+  DialogState state;
+  state.can_remember = can_remember;
+  state.try_unlock = try_unlock;
+  return ::DialogBoxIndirectParamW(::GetModuleHandleW(nullptr), dialog.get(),
+                                   nullptr, &DialogProc,
+                                   reinterpret_cast<LPARAM>(&state)) == 1;
+}
+
+bool AskToStartWithoutKeyFile() {
+  return ::MessageBoxW(
+             nullptr,
+             L"This portable copy was locked with a passphrase, but its key "
+             L"file (\"Thoron Portable Key\" in its User Data folder) is "
+             L"missing, so its saved passwords and sign-ins cannot be "
+             L"opened.\n\nChoose No to quit and put the file back from a "
+             L"backup of this copy.\n\nChoose Yes to start without them: "
+             L"they stay unreadable unless the file comes back, and new ones "
+             L"are kept for this PC and this Windows account only.",
+             kTitle,
+             MB_YESNO | MB_DEFBUTTON2 | MB_ICONWARNING | MB_SETFOREGROUND |
+                 MB_TOPMOST) == IDYES;
+}
+
+void ShowStartupProblem(const std::u16string& text) {
+  ::MessageBoxW(nullptr, base::as_wcstr(text), kTitle,
+                MB_OK | MB_ICONERROR | MB_SETFOREGROUND | MB_TOPMOST);
+}
+
+}  // namespace thoron_portable
