+
+#ifndef COMPONENTS_THORON_MAIL_IMAP_CHECK_H_
+#define COMPONENTS_THORON_MAIL_IMAP_CHECK_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "components/thoron_mail/imap.rs.h"
+#include "components/thoron_mail/mail_feed.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "mojo/public/cpp/system/data_pipe.h"
+#include "mojo/public/cpp/system/simple_watcher.h"
+#include "net/base/ip_endpoint.h"
+#include "net/ssl/ssl_info.h"
+#include "services/network/public/mojom/network_context.mojom-forward.h"
+#include "services/network/public/mojom/proxy_resolving_socket.mojom.h"
+#include "services/network/public/mojom/tcp_socket.mojom.h"
+#include "services/network/public/mojom/tls_socket.mojom.h"
+#include "third_party/rust/cxx/v1/cxx.h"
+
+namespace thoron_mail {
+
+// A mailbox the person added with its address and password (P5.77): any mail
+// service that speaks IMAP over TLS. Thoron signs in to it by itself, so it
+// does not depend on the accounts the browser is signed in to.
+struct ImapAccount {
+  ImapAccount();
+  ImapAccount(const ImapAccount&);
+  ImapAccount& operator=(const ImapAccount&);
+  ImapAccount(ImapAccount&&);
+  ImapAccount& operator=(ImapAccount&&);
+  ~ImapAccount();
+
+  std::string email;
+  std::string host;  // imap.example.com
+  int port = 993;    // IMAP over TLS
+  std::string user;  // what the server knows the person as; often the address
+  std::string password;
+  // The service's page for reading mail (https), opened from the menu; may be
+  // empty.
+  std::string webmail;
+  // A server on this computer (Proton Mail Bridge): the SHA-256 of the
+  // certificate it showed when the mailbox was added, in hex. Such a server
+  // makes its own certificate, which no authority signs; it is trusted by
+  // this pin alone.
+  std::string pin;
+};
+
+// True for a host name a look may connect to: letters, digits, dots and
+// hyphens, as a mail server's name is.
+bool IsImapHost(const std::string& host);
+// True for a server on this computer ("127.0.0.1" or "localhost"), as Proton
+// Mail Bridge is.
+bool IsLocalImapHost(const std::string& host);
+// True for a pin as ImapAccount keeps it (64 hex digits).
+bool IsCertificatePin(const std::string& pin);
+
+// One look at one mailbox: connects (TLS, through the browser's network
+// service, so the person's proxy settings hold), signs in, counts the unread
+// messages of the inbox and reads who sent the newest and what about. What the
+// server sends is read in Rust (imap.rs); this only carries the bytes.
+// Nothing in the mailbox is changed. The look ends after kTimeout at the
+// latest.
+//
+// A server on this computer (Proton Mail Bridge) is reached directly, never
+// through a proxy. It starts TLS with STARTTLS when it greets in plain text
+// (Bridge's default), or at once when it waits silently for TLS (Bridge's
+// "SSL"). Its certificate is checked against the account's pin; with no pin,
+// only a look that may trust a new certificate (adding or editing the
+// mailbox) takes it, and gives its pin.
+class ImapCheck {
+ public:
+  struct Result {
+    Result();
+    Result(Result&&);
+    Result& operator=(Result&&);
+    ~Result();
+    // "" when the look went well; else "sign-in" (the name or the password
+    // was refused), "offline" (no connection, or it ended early), "protocol"
+    // or "too-much" (the server's answers could not be used), "certificate"
+    // (a server on this computer showed another certificate than its pin).
+    std::string problem;
+    int unread = 0;
+    std::vector<MailMessage> latest;
+    // a server on this computer: the pin of the certificate it showed
+    std::string pin;
+  };
+  using Done = base::OnceCallback<void(Result)>;
+
+  // Starts the look. `done` runs once, unless this is destroyed first; it may
+  // destroy this. `trust_new_certificate`: a server on this computer whose
+  // account has no pin yet is trusted with the certificate it shows.
+  ImapCheck(network::mojom::NetworkContext* context,
+            const ImapAccount& account,
+            Done done,
+            bool trust_new_certificate = false);
+  ImapCheck(const ImapCheck&) = delete;
+  ImapCheck& operator=(const ImapCheck&) = delete;
+  ~ImapCheck();
+
+ private:
+  // how a server on this computer is being reached
+  enum class Local {
+    kNo,         // a server elsewhere: TLS from the start, through a proxy
+    kGreeting,   // connected in plain text: its greeting, or its silence
+    kStartTls,   // STARTTLS asked for: its answer
+    kUpgrading,  // TLS being set up
+    kTls,        // TLS up: the look itself
+  };
+
+  void OnConnected(int result,
+                   const std::optional<net::IPEndPoint>& local,
+                   const std::optional<net::IPEndPoint>& peer,
+                   mojo::ScopedDataPipeConsumerHandle receive,
+                   mojo::ScopedDataPipeProducerHandle send);
+  void OnReadable(MojoResult result, const mojo::HandleSignalsState& state);
+  void OnWritable(MojoResult result, const mojo::HandleSignalsState& state);
+  void Write();
+  // the server's bytes given to the session; false when the look ended
+  bool Feed(base::span<const uint8_t> data);
+  // a server on this computer: what it says in plain text before TLS; false
+  // when the look ended
+  bool OnPlainText(base::span<const uint8_t> data);
+  // It said nothing: it waits for TLS.
+  void OnSilence();
+  void StartTls();
+  void OnTlsReady(int32_t net_error,
+                  mojo::ScopedDataPipeConsumerHandle receive,
+                  mojo::ScopedDataPipeProducerHandle send,
+                  const std::optional<net::SSLInfo>& ssl_info);
+  void Watch();
+  // the server closed the connection, or it broke
+  void OnClosed();
+  void Finish(std::string problem);
+
+  rust::Box<ImapSession> session_;
+  Done done_;
+  mojo::Remote<network::mojom::ProxyResolvingSocketFactory> factory_;
+  mojo::Remote<network::mojom::ProxyResolvingSocket> socket_;
+  mojo::Remote<network::mojom::TCPConnectedSocket> tcp_;
+  mojo::Remote<network::mojom::TLSClientSocket> tls_;
+  mojo::ScopedDataPipeConsumerHandle receive_;
+  mojo::ScopedDataPipeProducerHandle send_;
+  mojo::SimpleWatcher read_watcher_;
+  mojo::SimpleWatcher write_watcher_;
+  // what is still to be sent
+  std::string pending_;
+  base::OneShotTimer timeout_;
+  // a server on this computer: how far, its name and port, what it said in
+  // plain text, whether it greeted that way, the pin it must show, and the
+  // one it showed
+  Local local_ = Local::kNo;
+  std::string local_host_;
+  int local_port_ = 0;
+  std::string plain_;
+  bool greeted_ = false;
+  std::string expected_pin_;
+  bool trust_new_certificate_ = false;
+  std::string pin_;
+  base::OneShotTimer silence_;
+  base::WeakPtrFactory<ImapCheck> weak_factory_{this};
+};
+
+}  // namespace thoron_mail
+
+#endif  // COMPONENTS_THORON_MAIL_IMAP_CHECK_H_
