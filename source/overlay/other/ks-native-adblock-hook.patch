+
+# The passphrase of a portable copy (ROADMAP P4.9, design 7.8, threat model
+# section 6): the key file that keeps the profile key locked with the
+# passphrase, a recovery key and remembered PCs. See README.md.
+static_library("thoron_portable_key") {
+  sources = [
+    "argon2id.cc",
+    "argon2id.h",
+    "key_file.cc",
+    "key_file.h",
+    "key_store.cc",
+    "key_store.h",
+    "local_state_key.cc",
+    "local_state_key.h",
+    "os_key_store.cc",
+    "os_key_store.h",
+    "recovery_key.cc",
+    "recovery_key.h",
+    "secret_bytes.cc",
+    "secret_bytes.h",
+  ]
+  deps = [
+    "//base",
+    "//base:i18n",
+    "//build/config/linux/dbus:buildflags",
+    "//crypto",
+    "//third_party/argon2",
+    "//third_party/boringssl",
+    "//third_party/icu",
+  ]
+  if (is_win) {
+    libs = [ "crypt32.lib" ]
+  }
+  if (is_linux && use_dbus) {
+    # Thoron (ROADMAP P4.9): "Remember this PC" with the desktop's keyring.
+    sources += [
+      "os_key_store_linux.cc",
+      "os_key_store_linux.h",
+    ]
+    deps += [ "//dbus" ]
+  }
+  if (is_linux) {
+    # Thoron (ROADMAP P4.9): a locked Linux copy's values encrypted again.
+    sources += [
+      "reencrypt_linux.cc",
+      "reencrypt_linux.h",
+    ]
+    deps += [ "//sql" ]
+  }
+}
+
+source_set("unit_tests") {
+  testonly = true
+  sources = [
+    "argon2id_unittest.cc",
+    "key_file_unittest.cc",
+    "key_store_unittest.cc",
+    "local_state_key_unittest.cc",
+    "os_key_store_unittest.cc",
+    "recovery_key_unittest.cc",
+  ]
+  deps = [
+    ":thoron_portable_key",
+    "//base",
+    "//base/test:test_support",
+    "//build/config/linux/dbus:buildflags",
+    "//crypto",
+    "//testing/gtest",
+  ]
+  if (is_linux) {
+    sources += [ "reencrypt_linux_unittest.cc" ]
+    deps += [
+      "//components/os_crypt/async/browser",
+      "//components/os_crypt/async/browser:posix_key_provider",
+      "//components/os_crypt/async/common",
+      "//sql",
+    ]
+  }
+}
+
+test("thoron_portable_key_unittests") {
+  deps = [
+    ":unit_tests",
+    "//base/test:run_all_unittests",
+    "//testing/gtest",
+  ]
+}
+
+# Coverage-guided fuzzing of the key file's reader (ROADMAP S.2, E2 and E3; P4.9:
