+    const HEADERS: &str = "From: =?UTF-8?B?QWxpY2Ug4pyT?= <alice@example.com>\r\nSubject: =?utf-8?Q?Hello_=E2=9C=93?=\r\n =?utf-8?Q?_again?=\r\n\r\n";
+
+    fn fetch(uid: u32, date: &str, headers: &str) -> String {
+        format!(
+            "* {uid} FETCH (UID {uid} INTERNALDATE \"{date}\" BODY[HEADER.FIELDS (FROM SUBJECT)] {{{}}}\r\n{headers})\r\n",
+            headers.len()
+        )
+    }
