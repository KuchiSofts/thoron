+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_update/swap.h"
+
+#include <set>
+#include <string>
+#include <vector>
+
+#include "base/files/file_enumerator.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/important_file_writer.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "build/build_config.h"
+#include "components/thoron_update/package.h"
+
+namespace thoron_update {
+
+namespace {
+
+constexpr char kCurrentFile[] = "current";
+// The file is a few bytes; more is not it.
+constexpr int64_t kMostPointerBytes = 64;
+// A folder is renamed to this before it is deleted, so a folder that is half
+// deleted never looks like a version.
+constexpr char kRemovingSuffix[] = ".removing";
+
+// Line `line` (0: current, 1: previous) of the pointer file, when it names a
+// version whose folder is there.
+std::optional<BuildVersion> ReadPointer(const base::FilePath& root,
+                                        size_t line) {
+  std::string text;
+  if (!base::ReadFileToStringWithMaxSize(root.AppendASCII(kCurrentFile), &text,
+                                         kMostPointerBytes)) {
+    return std::nullopt;
+  }
+  const std::vector<std::string_view> lines = base::SplitStringPiece(
+      text, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  if (line >= lines.size()) {
+    return std::nullopt;
+  }
+  std::optional<BuildVersion> version = ParseBuildVersion(lines[line]);
+  if (!version || !base::DirectoryExists(VersionFolder(root, *version))) {
+    return std::nullopt;
+  }
+  return version;
+}
+
+// Names `current` and, when there is one, `previous`, in one atomic step.
+bool WritePointer(const base::FilePath& root,
+                  const BuildVersion& current,
+                  const std::optional<BuildVersion>& previous) {
+  std::string text = ToString(current) + "\n";
+  if (previous && *previous != current) {
+    text += ToString(*previous) + "\n";
+  }
+  return base::ImportantFileWriter::WriteFileAtomically(
+      root.AppendASCII(kCurrentFile), text);
+}
+
+// The file of `file` inside `folder`, or nothing for a path that would leave it.
+std::optional<base::FilePath> Inside(const base::FilePath& folder,
+                                     const VersionFile& file) {
+  if (file.path.empty() || file.path.front() == '/' ||
+      file.path.find('\\') != std::string::npos ||
+      file.path.find(':') != std::string::npos) {
+    return std::nullopt;
+  }
+  const base::FilePath relative = base::FilePath::FromUTF8Unsafe(file.path);
+  if (relative.IsAbsolute() || relative.ReferencesParent()) {
+    return std::nullopt;
+  }
+  return folder.Append(relative.NormalizePathSeparators());
+}
+
+// Whether `folder` holds exactly `files`: each verifies, and there is no other.
+bool HoldsExactly(const base::FilePath& folder,
+                  const std::vector<VersionFile>& files) {
+  std::set<base::FilePath> wanted;
+  for (const VersionFile& file : files) {
+    const std::optional<base::FilePath> path = Inside(folder, file);
+    if (!path || !wanted.insert(*path).second) {
+      return false;
+    }
+    if (CheckFile(*path, PackageFile{std::string(), file.size, file.sha256}) !=
+        FileCheck::kOk) {
+      return false;
+    }
+  }
+  base::FileEnumerator found(folder, /*recursive=*/true,
+                             base::FileEnumerator::FILES);
+  for (base::FilePath path = found.Next(); !path.empty(); path = found.Next()) {
+    if (!wanted.contains(path)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool Remove(const base::FilePath& folder) {
+  if (!base::PathExists(folder)) {
+    return true;
+  }
+  base::FilePath away = folder;
+  if (!folder.BaseName().MaybeAsASCII().ends_with(kRemovingSuffix)) {
+    const base::FilePath renamed = folder.AddExtensionASCII("removing");
+    if (base::Move(folder, renamed)) {
+      away = renamed;
+    }
+  }
+  return base::DeletePathRecursively(away);
+}
+
+bool Stop(std::optional<SwapStep> stop_after, SwapStep step) {
+  return stop_after && *stop_after == step;
+}
+
+}  // namespace
+
+std::string_view SwapResultName(SwapResult result) {
+  switch (result) {
+    case SwapResult::kDone:
+      return "done";
+    case SwapResult::kBadFiles:
+      return "bad_files";
+    case SwapResult::kBadRequest:
+      return "bad_request";
+    case SwapResult::kAlreadyCurrent:
+      return "already_current";
+    case SwapResult::kIoError:
+      return "io_error";
+    case SwapResult::kNothingToRollBack:
+      return "nothing_to_roll_back";
+    case SwapResult::kInterrupted:
+      return "interrupted";
+  }
+  return "unknown";
+}
+
+base::FilePath VersionFolder(const base::FilePath& root,
+                             const BuildVersion& version) {
+  return root.AppendASCII(ToString(version));
+}
+
+std::optional<BuildVersion> CurrentVersion(const base::FilePath& root) {
+  return ReadPointer(root, 0);
+}
+
+std::optional<BuildVersion> PreviousVersion(const base::FilePath& root) {
+  return ReadPointer(root, 1);
+}
+
+bool VersionIsComplete(const base::FilePath& root,
+                       const BuildVersion& version,
+                       const std::vector<VersionFile>& files) {
+  const base::FilePath folder = VersionFolder(root, version);
+  return base::DirectoryExists(folder) && HoldsExactly(folder, files);
+}
+
+bool BrowserOfCurrentVersion(const base::FilePath& running_exe, base::FilePath* browser) {
+  const base::FilePath folder = running_exe.DirName();
+  const std::optional<BuildVersion> running = ParseBuildVersion(folder.BaseName().MaybeAsASCII());
+  if (!running) {
+    return false;
+  }
+  const base::FilePath root = folder.DirName();
+  const std::optional<BuildVersion> current = CurrentVersion(root);
+  if (!current || *current == *running) {
+    return false;
+  }
+  const base::FilePath next = VersionFolder(root, *current).Append(running_exe.BaseName());
+  if (!base::PathExists(next)) {
+    return false;
+  }
+  *browser = next;
+  return true;
+}
+
+void CleanUp(const base::FilePath& root) {
+  const std::optional<BuildVersion> current = CurrentVersion(root);
+  const std::optional<BuildVersion> previous = PreviousVersion(root);
+  if (!current) {
+    // Without a version that starts nothing is removed: what is there may be
+    // all there is.
+    return;
+  }
+  std::vector<base::FilePath> away;
+  base::FileEnumerator found(root, /*recursive=*/false,
+                             base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath path = found.Next(); !path.empty(); path = found.Next()) {
+    const std::string name = path.BaseName().MaybeAsASCII();
+    const std::optional<BuildVersion> version = ParseBuildVersion(name);
+    if (version) {
+      if (*version != *current && (!previous || *version != *previous)) {
+        away.push_back(path);
+      }
+    } else if (name.ends_with(".staging") || name.ends_with(kRemovingSuffix)) {
+      away.push_back(path);
+    }
+  }
+  for (const base::FilePath& path : away) {
+    Remove(path);
+  }
+  // The copy of an updater that was handed an apply and was killed (cli.h); it
+  // cannot be removed while it runs, and then stays for the next clean-up.
+#if BUILDFLAG(IS_WIN)
+  base::DeleteFile(root.AppendASCII("thoron_update.handoff.exe"));
+#else
+  base::DeleteFile(root.AppendASCII("thoron_update.handoff"));
+#endif
+}
+
+SwapResult InstallVersion(const base::FilePath& root,
+                          const base::FilePath& staged,
+                          const BuildVersion& version,
+                          const std::vector<VersionFile>& files,
+                          std::optional<SwapStep> stop_after) {
+  if (version == BuildVersion() || files.empty() ||
+      std::ranges::any_of(files, [&](const VersionFile& file) {
+        return !Inside(root, file);
+      })) {
+    return SwapResult::kBadRequest;
+  }
+  const std::optional<BuildVersion> was = CurrentVersion(root);
+  if (was && *was == version) {
+    return SwapResult::kAlreadyCurrent;
+  }
+  const base::FilePath folder = VersionFolder(root, version);
+  if (!base::DirectoryExists(folder)) {
+    // Not yet moved: the staged folder is checked and becomes the version.
+    if (!HoldsExactly(staged, files)) {
+      Remove(staged);
+      return SwapResult::kBadFiles;
+    }
+    if (Stop(stop_after, SwapStep::kVerified)) {
+      return SwapResult::kInterrupted;
+    }
+    if (!base::Move(staged, folder)) {
+      return SwapResult::kIoError;
+    }
+  } else if (!HoldsExactly(folder, files)) {
+    // A folder of that name that is not the version: it goes, and the staged
+    // one is tried again on the next run.
+    Remove(folder);
+    return SwapResult::kIoError;
+  }
+  if (Stop(stop_after, SwapStep::kMoved)) {
+    return SwapResult::kInterrupted;
+  }
+  // The switch, in one step: from here on the new version starts.
+  if (!WritePointer(root, version, was)) {
+    return SwapResult::kIoError;
+  }
+  if (Stop(stop_after, SwapStep::kSwitched)) {
+    return SwapResult::kInterrupted;
+  }
+  CleanUp(root);
+  if (Stop(stop_after, SwapStep::kCleaned)) {
+    return SwapResult::kInterrupted;
+  }
+  return SwapResult::kDone;
+}
+
+SwapResult RollBack(const base::FilePath& root) {
+  const std::optional<BuildVersion> current = CurrentVersion(root);
+  const std::optional<BuildVersion> previous = PreviousVersion(root);
+  if (!current || !previous || *current == *previous) {
+    return SwapResult::kNothingToRollBack;
+  }
+  if (!WritePointer(root, *previous, *current)) {
+    return SwapResult::kIoError;
+  }
+  return SwapResult::kDone;
+}
+
+}  // namespace thoron_update
