+#include "components/thoron_adblock/proxying_url_loader_factory.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/page_navigator.h"
+#include "content/public/browser/reload_type.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/blink/public/common/input/web_input_event.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace thoron_adblock {
+
+namespace {
+
+// Windows key codes (ui::KeyboardCode) of the keys a shortcut may end in.
+constexpr int kKeyA = 0x41;
+constexpr int kKeyZ = 0x5A;
+constexpr int kKey0 = 0x30;
+constexpr int kKey9 = 0x39;
+constexpr int kKeyF1 = 0x70;
+constexpr int kKeyF12 = 0x7B;
+
+void Open(content::WebContents* tab, const char* url) {
+  tab->OpenURL(content::OpenURLParams(GURL(url), content::Referrer(),
+                                      WindowOpenDisposition::kNewForegroundTab,
+                                      ui::PAGE_TRANSITION_AUTO_TOPLEVEL,
+                                      /*is_renderer_initiated=*/false),
+               /*navigation_handle_callback=*/{});
+}
+
+void Reload(content::WebContents* tab) {
+  tab->GetController().Reload(content::ReloadType::NORMAL, true);
+}
+
+}  // namespace
+
+std::string ShortcutKeys(const input::NativeWebKeyboardEvent& event) {
+  using blink::WebInputEvent;
+  const int modifiers = event.GetModifiers();
+  // the Windows key and AltGr are never part of one
+  if (modifiers & (WebInputEvent::kMetaKey | WebInputEvent::kAltGrKey)) {
+    return std::string();
+  }
+  const int code = event.windows_key_code;
+  std::string key;
+  if ((code >= kKeyA && code <= kKeyZ) || (code >= kKey0 && code <= kKey9)) {
+    key = std::string(1, static_cast<char>(code));
+  } else if (code >= kKeyF1 && code <= kKeyF12) {
+    key = base::StrCat({"F", base::NumberToString(code - kKeyF1 + 1)});
+  } else {
+    return std::string();
+  }
+  std::string keys;
+  if (modifiers & WebInputEvent::kControlKey) {
+    keys += "Ctrl+";
+  }
+  if (modifiers & WebInputEvent::kAltKey) {
+    keys += "Alt+";
+  }
+  if (modifiers & WebInputEvent::kShiftKey) {
+    keys += "Shift+";
+  }
+  keys += key;
+  return EngineService::ValidKeys(keys) ? keys : std::string();
+}
+
+bool HandleShortcut(content::WebContents* tab,
+                    const input::NativeWebKeyboardEvent& event) {
+  if (!tab || event.GetType() != blink::WebInputEvent::Type::kRawKeyDown ||
+      !base::FeatureList::IsEnabled(kThoronNativeAdblock)) {
+    return false;
+  }
+  EngineService& service = EngineService::Get();
+  if (service.shortcuts().empty()) {
+    return false;
+  }
+  const std::string keys = ShortcutKeys(event);
+  const std::string command = keys.empty() ? std::string()
+                                           : service.ShortcutCommand(keys);
+  if (command.empty()) {
+    return false;
+  }
+  if (command == "logger") {
+    Open(tab, "chrome://adblock/#logger");
+    return true;
+  }
+  if (command == "dashboard") {
+    Open(tab, "chrome://adblock/");
+    return true;
+  }
+  if (command == "blocking") {
+    // the switch for every site (P5.70): off until switched on again, or on
+    HostContentSettingsMap* map = HostContentSettingsMapFactory::GetForProfile(
+        Profile::FromBrowserContext(tab->GetBrowserContext()));
+    ProxyingURLLoaderFactory::SetBlockingEverywhere(
+        map, !ProxyingURLLoaderFactory::BlockingEverywhere(map), 0);
+    if (tab->GetPrimaryMainFrame()->GetLastCommittedURL().SchemeIsHTTPOrHTTPS()) {
+      Reload(tab);
+    }
+    return true;
+  }
+  // the rest act on the page of the tab, when it is one the blocker works on
+  const GURL site = tab->GetPrimaryMainFrame()->GetLastCommittedURL();
+  if (!site.SchemeIsHTTPOrHTTPS()) {
+    return false;
+  }
+  HostContentSettingsMap* settings = HostContentSettingsMapFactory::GetForProfile(
+      Profile::FromBrowserContext(tab->GetBrowserContext()));
+  if (command == "picker" || command == "zapper") {
+    StartPicker(tab, /*zapper=*/command == "zapper");
+  } else if (command == "power") {
+    // as the menu's big button: the "Ads and trackers" site setting
+    settings->SetContentSettingDefaultScope(
+        site, GURL(), ContentSettingsType::ADS,
+        ProxyingURLLoaderFactory::AdsAllowedOn(settings, site)
+            ? CONTENT_SETTING_DEFAULT
+            : CONTENT_SETTING_ALLOW);
+    Reload(tab);
+  } else if (command == "cosmetic") {
+    service.SetSiteSwitch(site, "cosmetic", !service.SiteSwitch(site, "cosmetic"));
+    Reload(tab);
+  } else if (command == "javascript") {
+    const bool blocked =
+        settings->GetContentSetting(site, site, ContentSettingsType::JAVASCRIPT) ==
+        CONTENT_SETTING_BLOCK;
+    settings->SetContentSettingDefaultScope(
+        site, GURL(), ContentSettingsType::JAVASCRIPT,
+        blocked ? CONTENT_SETTING_DEFAULT : CONTENT_SETTING_BLOCK);
+    Reload(tab);
+  } else {
+    return false;
+  }
+  return true;
+}
+
+}  // namespace thoron_adblock
