+constexpr char kModeFile[] = "update-mode";
+constexpr int64_t kMostFilesBytes = 16 * 1024 * 1024;
+
+std::string Arg(const base::CommandLine& command, const char* name) {
+  return command.GetSwitchValueASCII(name);
+}
+
+std::optional<std::vector<VersionFile>> ReadFiles(const base::FilePath& path) {
+  std::string text;
+  if (!base::ReadFileToStringWithMaxSize(path, &text, kMostFilesBytes)) {
+    return std::nullopt;
+  }
+  std::optional<base::Value> read = base::JSONReader::Read(text, base::JSON_PARSE_RFC);
+  if (!read || !read->is_list()) {
+    return std::nullopt;
+  }
+  std::vector<VersionFile> files;
+  for (const base::Value& value : read->GetList()) {
+    const base::DictValue* entry = value.GetIfDict();
+    const std::string* path_text = entry ? entry->FindString("path") : nullptr;
+    const std::string* sha256 = entry ? entry->FindString("sha256") : nullptr;
+    const std::optional<double> size = entry ? entry->FindDouble("size") : std::nullopt;
+    if (!path_text || !sha256 || !size || *size < 0 || *size > 2147483647.0) {
+      return std::nullopt;
+    }
+    files.push_back({*path_text, static_cast<int64_t>(*size), *sha256});
+  }
+  return files;
+}
+
+int Status(const base::FilePath& root, std::string* out) {
+  const std::optional<BuildVersion> current = CurrentVersion(root);
+  const std::optional<BuildVersion> previous = PreviousVersion(root);
+  *out += "current: " + (current ? ToString(*current) : std::string("none")) + "\n";
+  *out += "previous: " + (previous ? ToString(*previous) : std::string("none")) + "\n";
+  *out += std::string("mode: ") + std::string(UpdateModeName(ReadUpdateMode(root))) + "\n";
+  return current ? kExitOk : kExitNoVersion;
+}
+
+int FromSwap(SwapResult result, std::string* out) {
+  *out += std::string(SwapResultName(result)) + "\n";
+  switch (result) {
+    case SwapResult::kDone:
+      return kExitOk;
+    case SwapResult::kAlreadyCurrent:
+      return kExitAlreadyCurrent;
+    case SwapResult::kBadFiles:
+      return kExitBadFiles;
+    case SwapResult::kBadRequest:
+      return kExitBadRequest;
+    case SwapResult::kNothingToRollBack:
+      return kExitNothingToRollBack;
+    case SwapResult::kIoError:
+    case SwapResult::kInterrupted:
+      return kExitIoError;
+  }
+  return kExitIoError;
+}
+
+// --rollback: says what it would do, and does it with --confirm. With
+// --restore-profile the profile is first put back from the snapshot taken
+// before the current version, all or nothing; then the version is switched.
+int RollBackCommand(const base::CommandLine& command, const base::FilePath& root, std::string* out) {
+  const std::optional<BuildVersion> current = CurrentVersion(root);
+  const std::optional<BuildVersion> previous = PreviousVersion(root);
+  if (!current || !previous) {
+    return FromSwap(SwapResult::kNothingToRollBack, out);
+  }
+  const base::FilePath user_data = command.GetSwitchValuePath("restore-profile");
+  const base::FilePath snapshots = command.GetSwitchValuePath("snapshots");
+  const base::FilePath snapshot = snapshots.empty()
+                                      ? base::FilePath()
+                                      : snapshots.AppendASCII(SnapshotLabel(*current));
+  if (!user_data.empty() && (snapshots.empty() || !base::DirectoryExists(snapshot))) {
+    *out += "there is no snapshot of the profile from before " + ToString(*current) + "\n";
+    return kExitSnapshotBad;
+  }
+  if (!command.HasSwitch("confirm")) {
+    *out += "rolling back makes " + ToString(*previous) + " the version that starts instead of " +
+            ToString(*current) + "; it can be undone the same way.\n";
+    if (!user_data.empty()) {
+      *out += "the profile is put back as it was before " + ToString(*current) +
+              " was put in place: what changed since then in bookmarks, settings, saved passwords, "
+              "history, cookies, autofill and open tabs is lost.\n";
+    }
+    *out += "close Thoron first, then run this again with --confirm.\n";
+    return kExitNeedsConfirmation;
+  }
+  if (!user_data.empty()) {
+    std::vector<std::string> problems;
+    if (!RestoreSnapshot(snapshot, user_data, &problems)) {
+      for (const std::string& problem : problems) {
+        *out += "snapshot: " + problem + "\n";
+      }
+      *out += "the snapshot does not verify; nothing was changed\n";
+      return kExitSnapshotBad;
+    }
+    *out += "profile: put back from " + SnapshotLabel(*current) + "\n";
+  }
+  return FromSwap(RollBack(root), out);
+}
+
+int Check(const base::CommandLine& command, std::string* out) {
+  const base::FilePath manifest_path = command.GetSwitchValuePath("manifest");
+  const base::FilePath signature_path = command.GetSwitchValuePath("signature");
+  if (!base::PathExists(manifest_path) || !base::PathExists(signature_path)) {
+    *out += "the manifest or its signature could not be read\n";
+    return kExitUsage;
+  }
+  // A file that is too long is read up to one byte more than may be, so that
+  // CheckUpdate refuses it as it refuses any other.
+  std::string manifest;
+  std::string signature;
+  base::ReadFileToStringWithMaxSize(manifest_path, &manifest, kMaxManifestBytes + 1);
+  base::ReadFileToStringWithMaxSize(signature_path, &signature, kSignatureBytes + 1);
+  CopyInfo copy;
+  std::string key;
+  if (!base::Base64Decode(Arg(command, "public-key"), &key) || key.size() != kPublicKeyBytes) {
+    *out += "--public-key is not base64 of 32 bytes\n";
+    return kExitUsage;
+  }
+  std::copy(key.begin(), key.end(), copy.public_key.begin());
+  const std::string host = Arg(command, "allowed-host");
+  if (!host.empty()) {
+    copy.allowed_hosts.push_back(host);
+  }
+  copy.channel = Arg(command, "channel");
+  const std::optional<BuildVersion> installed = ParseBuildVersion(Arg(command, "installed"));
+  const std::optional<BuildVersion> updater = ParseBuildVersion(Arg(command, "updater"));
+  const std::optional<Variant> variant = ParseVariant(Arg(command, "variant"));
+  const std::optional<Kind> kind = ParseKind(Arg(command, "kind"));
+  if (!installed || !updater || !variant || !kind) {
+    *out += "--installed, --updater, --variant or --kind is missing or wrong\n";
+    return kExitUsage;
+  }
+  copy.installed = *installed;
+  copy.updater = *updater;
+  copy.variant = *variant;
+  copy.kind = *kind;
+  if (command.HasSwitch("last-serial") &&
+      !base::StringToInt64(Arg(command, "last-serial"), &copy.last_serial)) {
+    *out += "--last-serial is not a number\n";
+    return kExitUsage;
+  }
+  int64_t now = (base::Time::Now() - base::Time::UnixEpoch()).InSeconds();
+  if (command.HasSwitch("now") && !base::StringToInt64(Arg(command, "now"), &now)) {
+    *out += "--now is not a number\n";
+    return kExitUsage;
+  }
+  const Decision decision = CheckUpdate(manifest, signature, copy, now);
+  *out += "outcome: " + std::string(OutcomeName(decision.outcome)) + "\n";
+  if (decision.manifest) {
+    *out += "version: " + ToString(decision.manifest->version) + " (" +
+            decision.manifest->thoron_version + ")\n";
+  }
+  if (decision.remember_serial) {
+    *out += "serial: " + base::NumberToString(*decision.remember_serial) + "\n";
+  }
+  for (const DownloadStep& step : PlanDownloads(decision)) {
+    *out += std::string(step.delta ? "delta: " : "full: ") + step.file.url + " " +
+            base::NumberToString(step.file.size) + " " + step.file.sha256 + "\n";
+  }
+  switch (decision.outcome) {
+    case Outcome::kUpToDate:
+      return kExitOk;
+    case Outcome::kUpdate:
+      return kExitUpdate;
+    case Outcome::kUpdaterTooOld:
+      return kExitUpdaterTooOld;
+    case Outcome::kNoPackage:
+      return kExitNoPackage;
+    case Outcome::kInvalidCopy:
+      return kExitUsage;
+    default:
+      return CannotVerify(decision.outcome) ? kExitCannotVerify : kExitUsage;
+  }
+}
+
+// --apply, by the updater of the release when the staged folder has one.
+// Puts the staged folder in place, through the updater in it when it has one.
+// `files_path` is the file that lists `files`, for the updater handed the apply.
+int ApplyStaged(const base::FilePath& root,
+                const base::FilePath& staged,
+                const BuildVersion& version,
+                const std::vector<VersionFile>& files,
+                const base::FilePath& files_path,
+                bool handed_off,
+                std::string* out) {
+  const std::optional<VersionFile> updater = UpdaterEntry(files);
+  if (updater && !handed_off) {
+    const base::FilePath copy = root.AppendASCII(kHandOffFile);
+    base::DeleteFile(copy);
+    if (!CopyCheckedUpdater(staged, *updater, copy)) {
+      // As for any other bad files: the staged folder goes (when a version
+      // starts in the folder; see CleanUp).
+      CleanUp(root);
+      *out += "the updater of " + ToString(version) + " is not the one its files name\n";
+      return FromSwap(SwapResult::kBadFiles, out);
+    }
+    base::CommandLine next(copy);
+    next.AppendSwitchPath("root", root);
+    next.AppendSwitchPath("apply", staged);
+    next.AppendSwitchASCII("version", ToString(version));
+    next.AppendSwitchPath("files", files_path);
+    next.AppendSwitch("handed-off");
+    *out += "handed off to the updater of " + ToString(version) + "\n";
+    std::string said;
+    int code = kExitIoError;
+    const bool ran = base::GetAppOutputWithExitCode(next, &said, &code);
+    base::DeleteFile(copy);
+    *out += said;
+    return ran ? code : kExitIoError;
+  }
+  return FromSwap(InstallVersion(root, staged, version, files), out);
+}
+
+// --apply, by the updater of the release when the staged folder has one.
+int Apply(const base::CommandLine& command, const base::FilePath& root, std::string* out) {
+  const std::optional<BuildVersion> version = ParseBuildVersion(Arg(command, "version"));
+  const base::FilePath files_path = command.GetSwitchValuePath("files");
+  const std::optional<std::vector<VersionFile>> files = ReadFiles(files_path);
+  if (!version || !files) {
+    *out += "--version or --files is missing or wrong\n";
+    return kExitUsage;
+  }
+  return ApplyStaged(root, command.GetSwitchValuePath("apply"), *version, *files, files_path,
+                     command.HasSwitch("handed-off"), out);
+}
+
+int SnapshotAndApply(const base::CommandLine& command,
+                     const base::FilePath& root,
+                     const base::FilePath& staged,
+                     const BuildVersion& version_value,
+                     const std::vector<VersionFile>& files,
+                     std::string* out);
+
+// --apply-package: a portable copy's update from its release's package.
+int ApplyPackage(const base::CommandLine& command, const base::FilePath& root, std::string* out) {
+  const std::optional<BuildVersion> version = ParseBuildVersion(Arg(command, "version"));
+  const base::FilePath package = command.GetSwitchValuePath("apply-package");
+  if (!version || package.empty()) {
+    *out += "--version or --apply-package is missing or wrong\n";
+    return kExitUsage;
+  }
+  if (CurrentVersion(root) == *version) {
+    return FromSwap(SwapResult::kAlreadyCurrent, out);
+  }
+  const base::FilePath staged = root.AppendASCII(ToString(*version) + ".staging");
+  // What a run that was stopped left; never a version in use (CleanUp).
+  base::DeletePathRecursively(staged);
+  std::vector<VersionFile> files;
+  const UnpackResult unpacked = UnpackVersion(package, *version, staged, &files);
+  if (unpacked != UnpackResult::kDone) {
+    *out += std::string(UnpackResultName(unpacked)) + "\n";
+    return unpacked == UnpackResult::kIoError ? kExitIoError : kExitBadFiles;
+  }
+  const int code = SnapshotAndApply(command, root, staged, *version, files, out);
+  // The launcher of a portable copy sits beside its program folder.
+  const base::FilePath launcher = root.DirName().AppendASCII("Thoron.exe");
+  if (code == kExitOk && base::PathExists(launcher)) {
+    *out += ReplaceLauncher(package, launcher) ? "launcher: current\n" : "launcher: kept\n";
+  }
+  return code;
+}
+
+// --apply-delta: the newer version made from the current one's folder (P4.1).
+int ApplyDeltaCommand(const base::CommandLine& command, const base::FilePath& root, std::string* out) {
+  const std::optional<BuildVersion> version = ParseBuildVersion(Arg(command, "version"));
+  const base::FilePath delta = command.GetSwitchValuePath("apply-delta");
+  const std::optional<BuildVersion> current = CurrentVersion(root);
+  if (!version || delta.empty()) {
+    *out += "--version or --apply-delta is missing or wrong\n";
+    return kExitUsage;
+  }
+  if (!current) {
+    *out += "no version starts in the folder, so there is nothing to make the delta from\n";
+    return kExitNoVersion;
+  }
+  if (*current == *version) {
+    return FromSwap(SwapResult::kAlreadyCurrent, out);
+  }
+  const base::FilePath staged = root.AppendASCII(ToString(*version) + ".staging");
+  base::DeletePathRecursively(staged);
+  std::vector<VersionFile> files;
+  const DeltaResult made =
+      ApplyDelta(delta, VersionFolder(root, *current), *current, *version, staged, &files);
+  if (made != DeltaResult::kDone) {
+    *out += std::string(DeltaResultName(made)) + "\n";
+    return made == DeltaResult::kIoError        ? kExitIoError
+           : made == DeltaResult::kWrongVersion ? kExitBadRequest
+                                                : kExitBadFiles;
+  }
+  *out += "delta: " + ToString(*current) + " -> " + ToString(*version) + ", " +
+          base::NumberToString(files.size()) + " files made and checked\n";
+  return SnapshotAndApply(command, root, staged, *version, files, out);
+}
+
+// --apply-installed-delta: an installed copy's next version made from its own
+// Application folder with the delta, and installed by the newer setup.exe the
+// delta made (P4.1). The staged files go in Update beside Application, as the
+// browser's own downloads do, and are removed when the setup has ended.
+int ApplyInstalledDeltaCommand(const base::CommandLine& command,
+                               const base::FilePath& root,
+                               std::string* out) {
+  const std::optional<BuildVersion> version = ParseBuildVersion(Arg(command, "version"));
+  const std::optional<BuildVersion> from = ParseBuildVersion(Arg(command, "from"));
+  const base::FilePath delta = command.GetSwitchValuePath("apply-installed-delta");
+  if (!version || !from || delta.empty()) {
+    *out += "--version, --from or --apply-installed-delta is missing or wrong\n";
+    return kExitUsage;
+  }
+  const base::FilePath update = root.DirName().AppendASCII("Update");
+  const base::FilePath staged = update.AppendASCII(ToString(*version) + ".staging");
+  if (!base::CreateDirectory(update)) {
+    *out += "the Update folder could not be made\n";
+    return kExitIoError;
+  }
+  base::DeletePathRecursively(staged);
+  base::CommandLine setup(base::CommandLine::NO_PROGRAM);
+  const DeltaResult made = PrepareInstalledDelta(delta, root, *from, *version,
+                                                 command.HasSwitch("system-level"), staged, &setup);
+  if (made != DeltaResult::kDone) {
+    *out += std::string(DeltaResultName(made)) + "\n";
+    return made == DeltaResult::kIoError        ? kExitIoError
+           : made == DeltaResult::kWrongVersion ? kExitBadRequest
+                                                : kExitBadFiles;
+  }
+  *out += "delta: " + ToString(*from) + " -> " + ToString(*version) + ", installing with " +
+          setup.GetProgram().AsUTF8Unsafe() + "\n";
+  base::LaunchOptions options;
+#if BUILDFLAG(IS_WIN)
+  options.start_hidden = true;  // setup.exe, the only installer this runs, shows no window
+#endif
+  base::Process process = base::LaunchProcess(setup, options);
+  int exit_code = -1;
+  const bool ended =
+      process.IsValid() && process.WaitForExitWithTimeout(base::Minutes(15), &exit_code);
+  if (process.IsValid() && !ended) {
+    process.Terminate(/*exit_code=*/1, /*wait=*/true);
+  }
+  base::DeletePathRecursively(staged);
+  if (!ended) {
+    *out += "the newer setup did not end\n";
+    return kExitInstallerFailed;
+  }
+  *out += "setup ended with " + base::NumberToString(exit_code) + "\n";
+  return exit_code == 0 ? kExitOk : kExitInstallerFailed;
+}
+
+// The end of --apply-package and --apply-delta: the profile's snapshot when
+// asked for, the list of the staged files, and the apply through the updater
+// in the staged folder.
+int SnapshotAndApply(const base::CommandLine& command,
+                     const base::FilePath& root,
+                     const base::FilePath& staged,
+                     const BuildVersion& version_value,
+                     const std::vector<VersionFile>& files,
+                     std::string* out) {
+  const BuildVersion* version = &version_value;
+  // The profile as it is, before the version changes (P3.7), when asked for.
+  const base::FilePath user_data = command.GetSwitchValuePath("snapshot-profile");
+  const base::FilePath snapshots = command.GetSwitchValuePath("snapshots");
+  if (!user_data.empty() && !snapshots.empty()) {
+    const SnapshotReport report = TakeSnapshot(user_data, snapshots, SnapshotLabel(*version));
+    if (!report.ok && report.folder.empty()) {
+      base::DeletePathRecursively(staged);
+      *out += "the profile's snapshot could not be taken; nothing was changed\n";
+      return kExitIoError;
+    }
+    *out += "snapshot: " + SnapshotLabel(*version) + " (" + base::NumberToString(report.files) +
+            " files" + (report.ok ? "" : ", with problems") + ")\n";
+  }
+  const base::FilePath files_path = root.AppendASCII(ToString(*version) + ".files.json");
+  base::ListValue list;
+  for (const VersionFile& file : files) {
+    base::DictValue entry;
+    entry.Set("path", file.path);
+    entry.Set("size", static_cast<double>(file.size));
+    entry.Set("sha256", file.sha256);
+    list.Append(std::move(entry));
+  }
+  std::string json;
+  if (!base::JSONWriter::Write(list, &json) ||
+      !base::ImportantFileWriter::WriteFileAtomically(files_path, json)) {
+    base::DeletePathRecursively(staged);
+    return kExitIoError;
+  }
+  const int code = ApplyStaged(root, staged, *version, files, files_path,
+                               command.HasSwitch("handed-off"), out);
+  base::DeleteFile(files_path);
+  return code;
+}
+
+}  // namespace
+
+#if BUILDFLAG(IS_WIN)
+const char kUpdaterFile[] = "thoron_update.exe";
+const char kHandOffFile[] = "thoron_update.handoff.exe";
+#else
+const char kUpdaterFile[] = "thoron_update";
+const char kHandOffFile[] = "thoron_update.handoff";
+#endif
+
+std::string SnapshotLabel(const BuildVersion& version) {
+  return "before-" + ToString(version);
+}
+
+std::optional<VersionFile> UpdaterEntry(const std::vector<VersionFile>& files) {
+  for (const VersionFile& file : files) {
+    if (file.path == kUpdaterFile) {
+      return file;
+    }
+  }
+  return std::nullopt;
+}
+
+bool CopyCheckedUpdater(const base::FilePath& staged,
+                        const VersionFile& entry,
+                        const base::FilePath& to) {
+  const std::optional<int64_t> size = base::GetFileSize(staged.AppendASCII(kUpdaterFile));
+  if (!size || *size != entry.size || !base::CopyFile(staged.AppendASCII(kUpdaterFile), to) ||
+      !MakeRunnableIfProgram(to)) {
+    base::DeleteFile(to);
+    return false;
+  }
+  // What runs is the copy, so the copy is what is checked.
+  if (CheckFile(to, PackageFile{std::string(), entry.size, entry.sha256}) != FileCheck::kOk) {
+    base::DeleteFile(to);
+    return false;
+  }
+  return true;
+}
+
+std::string_view UpdateModeName(UpdateMode mode) {
+  switch (mode) {
+    case UpdateMode::kAuto:
+      return "auto";
+    case UpdateMode::kNotify:
+      return "notify";
+    case UpdateMode::kOff:
+      return "off";
+  }
+  return "auto";
+}
+
+UpdateMode ReadUpdateMode(const base::FilePath& root) {
+  std::string text;
+  if (!base::ReadFileToStringWithMaxSize(root.AppendASCII(kModeFile), &text, 16)) {
+    return UpdateMode::kAuto;
+  }
+  const std::string_view name = base::TrimWhitespaceASCII(text, base::TRIM_ALL);
+  if (name == "notify") {
+    return UpdateMode::kNotify;
+  }
+  if (name == "off") {
+    return UpdateMode::kOff;
+  }
+  return UpdateMode::kAuto;
+}
+
+bool WriteUpdateMode(const base::FilePath& root, UpdateMode mode) {
+  return base::ImportantFileWriter::WriteFileAtomically(
+      root.AppendASCII(kModeFile), std::string(UpdateModeName(mode)) + "\n");
+}
+
+Action ActionFor(UpdateMode mode, Outcome outcome) {
+  if (mode == UpdateMode::kOff) {
+    return Action::kNothing;
+  }
+  if (outcome == Outcome::kUpdate) {
+    return mode == UpdateMode::kAuto ? Action::kInstall : Action::kTell;
+  }
+  if (outcome == Outcome::kUpdaterTooOld) {
+    return Action::kTell;
+  }
+  return CannotVerify(outcome) ? Action::kWarn : Action::kNothing;
+}
+
+Action ActionFor(UpdateMode mode, const Decision& decision) {
+  if (decision.outcome == Outcome::kUpdaterTooOld && decision.full) {
+    return ActionFor(mode, Outcome::kUpdate);
+  }
+  return ActionFor(mode, decision.outcome);
+}
+
+int RunUpdateCommand(const base::CommandLine& command, std::string* out) {
+  if (command.HasSwitch("check")) {
+    return Check(command, out);
+  }
+  const base::FilePath root = command.GetSwitchValuePath("root");
+  if (root.empty()) {
+    *out += "--root is missing\n";
+    return kExitUsage;
+  }
+  if (command.HasSwitch("status")) {
+    return Status(root, out);
+  }
+  if (command.HasSwitch("rollback")) {
+    return RollBackCommand(command, root, out);
+  }
+  if (command.HasSwitch("apply-package")) {
+    return ApplyPackage(command, root, out);
+  }
+  if (command.HasSwitch("apply-delta")) {
+    return ApplyDeltaCommand(command, root, out);
+  }
+  if (command.HasSwitch("apply-installed-delta")) {
+    return ApplyInstalledDeltaCommand(command, root, out);
+  }
+  if (command.HasSwitch("apply")) {
+    return Apply(command, root, out);
+  }
+  if (command.HasSwitch("mode")) {
+    const std::string name = Arg(command, "mode");
+    if (name.empty()) {
+      *out += std::string(UpdateModeName(ReadUpdateMode(root))) + "\n";
+      return kExitOk;
+    }
+    if (name != "auto" && name != "notify" && name != "off") {
+      *out += "--mode is auto, notify or off\n";
+      return kExitUsage;
+    }
+    const UpdateMode mode = name == "notify" ? UpdateMode::kNotify
+                            : name == "off"  ? UpdateMode::kOff
+                                             : UpdateMode::kAuto;
+    if (!WriteUpdateMode(root, mode)) {
+      return kExitIoError;
+    }
+    *out += name + "\n";
+    return kExitOk;
+  }
+  *out += "one of --status, --apply, --rollback, --check or --mode\n";
+  return kExitUsage;
+}
+
+}  // namespace thoron_update
