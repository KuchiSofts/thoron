+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Coverage-guided fuzzing of a delta's file list, delta.json (ROADMAP S.2,
+// U9), read as the updater reads it before it makes any file: the input is the
+// list. A list that is taken names at least one file and at most as many as a
+// package may hold, and none of its paths leaves the version's folder.
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <string_view>
+
+#include "base/check.h"
+#include "base/check_op.h"
+#include "base/files/file_path.h"
+#include "components/thoron_update/delta_package.h"
+#include "components/thoron_update/portable_package.h"
+
+extern "C" int LLVMFuzzerTestOneInput(const uint8_t* data, size_t size) {
+  static const thoron_update::BuildVersion from =
+      *thoron_update::ParseBuildVersion("158.0.8127.3010");
+  static const thoron_update::BuildVersion to =
+      *thoron_update::ParseBuildVersion("158.0.8127.6500");
+  static const base::FilePath folder(FILE_PATH_LITERAL("C:\\fuzz\\158.0.8127.6500"));
+  size_t count = 0;
+  const thoron_update::DeltaResult result = thoron_update::CheckDeltaList(
+      std::string_view(reinterpret_cast<const char*>(data), size), from, to, folder, &count);
+  if (result == thoron_update::DeltaResult::kDone) {
+    CHECK_GE(count, 1u);
+    CHECK_LE(count, static_cast<size_t>(thoron_update::kMostUnpackedFiles));
+  } else {
+    CHECK_EQ(count, 0u);
+  }
+  return 0;
+}
