+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_INSTALLER_SETUP_THORON_UPDATE_TASK_H_
+#define CHROME_INSTALLER_SETUP_THORON_UPDATE_TASK_H_
+
+#include <string>
+
+namespace base {
+class FilePath;
+}  // namespace base
+
+namespace installer {
+
+// Thoron (ROADMAP P3.10): the daily look of a per-user install for a newer
+// release. A task of Task Scheduler runs `<version>\ThoronSetup.exe
+// --scheduled --variant=<this build>` as the user (no administrator rights),
+// once a day, and as soon as the PC is on again when it was off at that time;
+// it needs the network. ThoronSetup does what the browser's update setting
+// says (automatic only) and installs a newer signed release of the same build
+// silently. Every install and update registers the task again (with the new
+// version's ThoronSetup); the uninstall removes it. A system install has none:
+// its administrator updates it (P3.9).
+
+// The task's name: one per user, as each user of the PC may have a per-user
+// Thoron.
+std::wstring ThoronUpdateTaskName();
+
+// The task's definition for Task Scheduler (its XML); `enabled` false keeps a
+// task the person switched off that way.
+std::wstring ThoronUpdateTaskXml(const base::FilePath& thoron_setup, bool enabled);
+
+// Registers (or replaces) the task, through Task Scheduler's own interface;
+// a task the person switched off stays off. False when it was not taken.
+bool RegisterThoronUpdateTask(const base::FilePath& thoron_setup);
+
+// Removes the task, when there is one.
+void RemoveThoronUpdateTask();
+
+}  // namespace installer
+
+#endif  // CHROME_INSTALLER_SETUP_THORON_UPDATE_TASK_H_
diff --git a/components/os_crypt/async/browser/thoron_portable_key_provider.cc b/components/os_crypt/async/browser/thoron_portable_key_provider.cc
new file mode 100644
index 0000000000000000000000000000000000000000..c404266c32bd7cc661120e7e5383882358380655
--- /dev/null
+++ b/components/os_crypt/async/browser/thoron_portable_key_provider.cc
@@ -0,0 +1,44 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/os_crypt/async/browser/thoron_portable_key_provider.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/types/expected.h"
+#include "components/os_crypt/async/common/algorithm.mojom.h"
+#include "components/os_crypt/async/common/encryptor.h"
+
+namespace os_crypt_async {
+
+namespace {
+constexpr char kTag[] = "t10";
+}  // namespace
+
+ThoronPortableKeyProvider::ThoronPortableKeyProvider(std::vector<uint8_t> key,
+                                                     bool use_for_encryption)
+    : key_(std::move(key)), use_for_encryption_(use_for_encryption) {}
+
+ThoronPortableKeyProvider::~ThoronPortableKeyProvider() {
+  // volatile writes, which the compiler keeps although the memory is freed next
+  volatile uint8_t* bytes = key_.data();
+  for (size_t i = 0; i < key_.size(); ++i) {
+    bytes[i] = 0;
+  }
+}
+
+void ThoronPortableKeyProvider::GetKey(KeyCallback callback) {
+  if (key_.size() != Encryptor::Key::kAES256GCMKeySize) {
+    // Never "permanently unavailable": that could have the values dropped.
+    std::move(callback).Run(kTag, base::unexpected(KeyError::kTemporarilyUnavailable));
+    return;
+  }
+  std::move(callback).Run(kTag, Encryptor::Key(key_, mojom::Algorithm::kAES256GCM));
+}
+
+bool ThoronPortableKeyProvider::UseForEncryption() {
+  return use_for_encryption_;
+}
+
+}  // namespace os_crypt_async
diff --git a/components/os_crypt/async/browser/thoron_portable_key_provider.h b/components/os_crypt/async/browser/thoron_portable_key_provider.h
new file mode 100644
index 0000000000000000000000000000000000000000..ab70e740a1496fe911f683f2f843bd5b79d03679
--- /dev/null
+++ b/components/os_crypt/async/browser/thoron_portable_key_provider.h
@@ -0,0 +1,42 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_OS_CRYPT_ASYNC_BROWSER_THORON_PORTABLE_KEY_PROVIDER_H_
+#define COMPONENTS_OS_CRYPT_ASYNC_BROWSER_THORON_PORTABLE_KEY_PROVIDER_H_
+
+#include <stdint.h>
+
+#include <vector>
+
+#include "components/os_crypt/async/browser/key_provider.h"
+
+namespace os_crypt_async {
+
+// Thoron (ROADMAP P4.9, Linux): the key of a portable copy locked with a
+// passphrase, unlocked at the start (chrome/browser/thoron_portable). Its values
+// are AES-256-GCM under the tag "t10" (components/thoron_portable_key/
+// reencrypt_linux.h, kPortableKeyTag); while the copy is locked it is used for
+// every new value, and the providers of Chromium's own Linux keys stay for
+// reading what is not encrypted again. Once the lock was removed it stays only
+// for reading the values still under it.
+class ThoronPortableKeyProvider : public KeyProvider {
+ public:
+  // `use_for_encryption`: true while the copy is locked; after its lock was
+  // removed the key only reads what is still under it.
+  ThoronPortableKeyProvider(std::vector<uint8_t> key, bool use_for_encryption);
+  ThoronPortableKeyProvider(const ThoronPortableKeyProvider&) = delete;
+  ThoronPortableKeyProvider& operator=(const ThoronPortableKeyProvider&) = delete;
+  ~ThoronPortableKeyProvider() override;
+
+  // KeyProvider:
+  void GetKey(KeyCallback callback) override;
+  bool UseForEncryption() override;
+
+ private:
+  std::vector<uint8_t> key_;
+  const bool use_for_encryption_;
+};
+
+}  // namespace os_crypt_async
+
+#endif  // COMPONENTS_OS_CRYPT_ASYNC_BROWSER_THORON_PORTABLE_KEY_PROVIDER_H_
diff --git a/components/os_crypt/async/browser/thoron_profile_key.cc b/components/os_crypt/async/browser/thoron_profile_key.cc
new file mode 100644
index 0000000000000000000000000000000000000000..a8e2cdf6435dde72735842a8fbb4edf2137b8e79
--- /dev/null
+++ b/components/os_crypt/async/browser/thoron_profile_key.cc
@@ -0,0 +1,65 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/os_crypt/async/browser/thoron_profile_key.h"
+
+#include <algorithm>
+
+#include "base/check_op.h"
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
+
+namespace os_crypt_async {
+
+namespace {
+
+struct State {
+  base::Lock lock;
+  bool locked = false;
+  std::optional<std::vector<uint8_t>> key;
+};
+
+State& GetState() {
+  static base::NoDestructor<State> state;
+  return *state;
+}
+
+}  // namespace
+
+void SetThoronProfileLocked() {
+  State& state = GetState();
+  base::AutoLock hold(state.lock);
+  state.locked = true;
+}
+
+bool IsThoronProfileLocked() {
+  State& state = GetState();
+  base::AutoLock hold(state.lock);
+  return state.locked;
+}
+
+void SetThoronProfileKey(base::span<const uint8_t> key) {
+  CHECK_EQ(key.size(), 32u);
+  State& state = GetState();
+  base::AutoLock hold(state.lock);
+  state.locked = true;
+  state.key.emplace(key.begin(), key.end());
+}
+
+std::optional<std::vector<uint8_t>> GetThoronProfileKey() {
+  State& state = GetState();
+  base::AutoLock hold(state.lock);
+  return state.key;
+}
+
+void ResetThoronProfileKeyForTesting() {
+  State& state = GetState();
+  base::AutoLock hold(state.lock);
+  state.locked = false;
+  if (state.key) {
+    std::fill(state.key->begin(), state.key->end(), 0);
+  }
+  state.key.reset();
+}
+
+}  // namespace os_crypt_async
