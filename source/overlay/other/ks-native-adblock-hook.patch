+// The unread mail of every Google account a profile is signed in to (Gmail's
+// u/0, u/1, ...), from Gmail's own feed of unread mail, as a person who opens
+// Gmail is sent it: with the profile's own sign-in, and nothing else. No
+// password is asked for or kept; the feed is read in the data decoder's
+// sandboxed process. Looked at when the browser starts, every few minutes
+// after, and when asked; a message not seen before is told to the observers
+// (not on the first look, which only learns what is there). Its two settings,
+// "thoron_mail.notify" and "thoron_mail.interval_minutes", are registered with
+// the profile's (chrome/browser/prefs/browser_prefs.cc).
+class MailService {
+ public:
+  using FactoryGetter =
+      base::RepeatingCallback<scoped_refptr<network::SharedURLLoaderFactory>()>;
+  // The profile's network context, for the mailboxes added by address and
+  // password (P5.77).
+  using ContextGetter =
+      base::RepeatingCallback<network::mojom::NetworkContext*()>;
+  // The most mailboxes added by address and password.
+  static constexpr size_t kMostImapAccounts = 20;
+
+  class Observer : public base::CheckedObserver {
+   public:
+    // the accounts, their counts or the state of a look changed
+    virtual void OnMailChanged() {}
+    // `messages` came to `account` since the last look
+    virtual void OnNewMail(const MailAccount& account,
+                           const std::vector<MailMessage>& messages) {}
+  };
+
+  // How often it looks, in minutes: the person's choice among these.
+  static constexpr int kIntervals[] = {1, 2, 5, 10, 15, 30};
+  static constexpr int kDefaultInterval = 2;
+  // the most accounts looked at (u/0 to u/9)
+  static constexpr int kMostAccounts = 10;
+
+  MailService(PrefService* prefs, FactoryGetter factory);
+  MailService(const MailService&) = delete;
+  MailService& operator=(const MailService&) = delete;
+  ~MailService();
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  // Starts looking (the first look a moment later). Again: no-op.
+  void Start();
+  // Looks now, unless a look is under way.
+  void CheckNow();
+
+  // P5.77: the mailboxes added by address and password, looked at after the
+  // browser's Google accounts. Setting them looks again.
+  void SetContextGetter(ContextGetter context);
+  void SetImapAccounts(std::vector<ImapAccount> accounts);
+  const std::vector<ImapAccount>& imap_accounts() const { return imap_; }
+
+  // S.15: whether somebody is signed in to Google in this profile. While
+  // nobody is, Gmail is not asked at all (the mailboxes still are). Not set:
+  // Gmail is always asked.
+  using GoogleSignedIn = base::RepeatingCallback<bool()>;
+  void SetGoogleSignedIn(GoogleSignedIn signed_in);
+
+  const std::vector<MailAccount>& accounts() const { return accounts_; }
+  // The unread messages of every watched account.
+  int total_unread() const;
+  // P5.76: an account's messages that came since the person last looked at it
+  // (opened its inbox from the M-Notifier), and those of every watched account.
+  int new_count(const MailAccount& account) const;
+  // `message` of `account` came since the person last looked at it.
+  bool is_new(const MailAccount& account, const MailMessage& message) const {
+    return message.issued.is_null() || message.issued > Looked(account.email);
+  }
+  int total_new() const;
+  // What the icon counts: total_new() or total_unread(), as the person chose.
+  int icon_count() const;
+  // The person looked at `email`'s inbox: its new mail is counted from now.
+  void MarkLooked(const std::string& email);
+  // Accounts the person does not want counted or told of (still listed).
+  bool watched(const std::string& email) const;
+  void SetWatched(const std::string& email, bool on);
+  bool checking() const { return checking_; }
+  // when the last look ended; null before the first
+  base::Time last_check() const { return last_check_; }
+  // why the last look found no account ("" when it found some): "signed-out"
+  // (no Google account), "offline", "error"
+  const std::string& problem() const { return problem_; }
+
+  int interval_minutes() const;
+  bool SetInterval(int minutes);
+  bool notify() const;
+  void SetNotify(bool on);
+
+  // P5.76: the settings with named values, the first of each the default:
+  // "sound" (new mail makes a sound, with or without a notice: "on", "off"),
+  // "messages" (P5.78: the menu lists the unread messages, "on", or only the
+  // accounts with their counts, "off", as X-notifier), "count" (the icon counts
+  // "new" mail since the person looked, or all "unread"), "open" (mail opens
+  // in the account's Gmail tab when one is open, "reuse", or a "new" tab),
+  // "which" (P5.77: of a Google account's mail, the whole "inbox" is counted,
+  // only its "primary" tab, or "all": the inbox and the spam),
+  // "place" (the envelope in the "toolbar", the "address" bar, or "both"),
+  // "toolbar-position" ("extensions", "address", "menu") and
+  // "address-position" ("icons", "start", "end"), as Thoron adblock's shield.
+  static bool KnownChoice(const std::string& name, const std::string& value);
+  std::string Choice(const std::string& name) const;
+  bool SetChoice(const std::string& name, const std::string& value);
+
+  // Gmail's address of the feed of account `index`: of what the person chose
+  // to count, or of its spam.
+  GURL FeedUrl(int index, bool spam = false) const;
+  // Gmail's inbox of account `index`.
+  static GURL InboxUrl(int index);
+
+ private:
+  void Fetch(int index, bool spam);
+  void OnFetched(int index, bool spam, std::optional<std::string> body);
+  void OnParsed(int index,
+                bool spam,
+                data_decoder::DataDecoder::ValueOrError result);
+  // After Google account `index`: its spam when that is counted too, the
+  // next account, or the mailboxes added by address and password.
+  void AfterAccount(int index, bool spam_done);
+  // The mailboxes added by address and password, one after the other; then
+  // the look is over. `problem` is that of the Google accounts.
+  void CheckImap(size_t at, std::string problem);
+  void OnImapChecked(size_t at, std::string problem, ImapCheck::Result result);
+  void Finish(std::string problem);
+  void Reschedule();
+  // S.15: whether a look asks Gmail (see SetGoogleSignedIn).
+  bool AsksGmail() const;
+  // when the person last looked at `email` (the first look's time until then)
+  base::Time Looked(const std::string& email) const;
+
+  const raw_ptr<PrefService> prefs_;
+  const FactoryGetter factory_;
+  base::ObserverList<Observer> observers_;
+  bool started_ = false;
+  bool checking_ = false;
+  bool first_look_done_ = false;
+  base::Time first_look_;
+  std::vector<MailAccount> accounts_;
+  std::vector<MailAccount> next_;
+  // per account: the messages already seen (only those still unread are kept)
+  std::map<std::string, std::set<std::string>> seen_;
+  base::Time last_check_;
+  std::string problem_;
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  ContextGetter context_;
+  GoogleSignedIn google_signed_in_;
+  std::vector<ImapAccount> imap_;
+  std::unique_ptr<ImapCheck> imap_check_;
+  // Gmail refused the feed of the Primary tab in this look: the inbox's is
+  // read instead.
+  bool primary_refused_ = false;
+  // the mailboxes changed during a look: it is done again right after
+  bool look_again_ = false;
+  base::OneShotTimer timer_;
+  base::WeakPtrFactory<MailService> weak_factory_{this};
+};
