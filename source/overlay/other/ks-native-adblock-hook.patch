index 0000000000000000000000000000000000000000..ba6c062ddc3f7e98cb3dd62a4958f88ca64c5783
--- /dev/null
+++ b/components/user_data_importer/chromium_family/password_decryptor_win.h
@@ -0,0 +1,80 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_USER_DATA_IMPORTER_CHROMIUM_FAMILY_PASSWORD_DECRYPTOR_WIN_H_
+#define COMPONENTS_USER_DATA_IMPORTER_CHROMIUM_FAMILY_PASSWORD_DECRYPTOR_WIN_H_
+
+#include <stdint.h>
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/containers/span.h"
+
+// Reads the saved-password values a Chromium-family browser wrote in its
+// `Login Data` on Windows (ROADMAP P3.14). The profile key lives in the
+// browser's `Local State` under os_crypt.encrypted_key: base64 of the bytes
+// "DPAPI" followed by the key wrapped for the current Windows user. Only the
+// user who wrapped it can unwrap it, so only that user's own data is readable.
+//
+// Value formats handled:
+//  - "v10" + 12-byte nonce + ciphertext + 16-byte tag: AES-256-GCM with the
+//    profile key.
+//  - No known prefix: an older value wrapped directly for the current user.
+//  - "v20" (app-bound) and anything else: reported as unsupported and left
+//    alone. Thoron's design forbids working around another browser's
+//    protection, so these are only counted, never read.
+namespace user_data_importer::chromium_family {
+
+// The 32-byte AES-256-GCM key of a profile, recovered from the browser's
+// `Local State`. Holds the key only as long as it is needed and clears it on
+// destruction.
+class PasswordKey {
+ public:
+  PasswordKey();
+  PasswordKey(const PasswordKey&) = delete;
+  PasswordKey& operator=(const PasswordKey&) = delete;
+  PasswordKey(PasswordKey&&) noexcept;
+  PasswordKey& operator=(PasswordKey&&) noexcept;
+  ~PasswordKey();
+
+  // Reads os_crypt.encrypted_key from the JSON text of a `Local State` file and
+  // recovers the profile key. Returns nullopt when the field is missing, not
+  // the expected "DPAPI"-prefixed shape, or cannot be unwrapped for the current
+  // user. `local_state_json` is the file's contents, not a path.
+  static std::optional<PasswordKey> FromLocalState(
+      const std::string& local_state_json);
+
+  // A key built directly from 32 raw bytes, for tests.
+  static std::optional<PasswordKey> FromRawKeyForTesting(
+      base::span<const uint8_t> raw_key);
+
+  bool is_valid() const { return !key_.empty(); }
+  base::span<const uint8_t> bytes() const { return key_; }
+
+  // Zeroes the stored key.
+  void Clear();
+
+ private:
+  std::vector<uint8_t> key_;
+};
+
+// What became of one stored value.
+enum class DecryptResult {
+  kOk,           // Decrypted into `plaintext`.
+  kSkippedV20,   // "v20" app-bound value: left alone and counted.
+  kSkippedOther,  // Unrecognised or malformed value: left alone and counted.
+  kError,        // A known format that failed to decrypt (e.g. bad tag).
+};
+
+// Reads one `password_value` blob. For a "v10" value it uses `key`; for an
+// unprefixed value it unwraps for the current user; "v20" and unknown values
+// return kSkippedV20 / kSkippedOther without touching `plaintext`.
+DecryptResult DecryptPasswordValue(const PasswordKey& key,
+                                   base::span<const uint8_t> value,
+                                   std::string* plaintext);
+
+}  // namespace user_data_importer::chromium_family
+
+#endif  // COMPONENTS_USER_DATA_IMPORTER_CHROMIUM_FAMILY_PASSWORD_DECRYPTOR_WIN_H_
diff --git a/components/user_data_importer/chromium_family/password_decryptor_win_unittest.cc b/components/user_data_importer/chromium_family/password_decryptor_win_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..20b177fffd4d5f893565a8295d2c0330fc08d245
--- /dev/null
+++ b/components/user_data_importer/chromium_family/password_decryptor_win_unittest.cc
@@ -0,0 +1,139 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/user_data_importer/chromium_family/password_decryptor_win.h"
+
+#include <windows.h>
+
+#include <wincrypt.h>
+
+#include <array>
+#include <string>
+#include <vector>
+
+#include "base/base64.h"
+#include "base/compiler_specific.h"
+#include "base/containers/span.h"
+#include "base/strings/strcat.h"
+#include "base/win/scoped_localalloc.h"
+#include "crypto/aead.h"
+#include "crypto/random.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace user_data_importer::chromium_family {
+namespace {
+
+// Wraps `plaintext` for the current Windows user, as the browser's os_crypt
+// does for its key.
+std::vector<uint8_t> WrapForCurrentUser(base::span<const uint8_t> plaintext) {
+  DATA_BLOB input = {};
+  input.pbData = const_cast<BYTE*>(plaintext.data());
+  input.cbData = static_cast<DWORD>(plaintext.size());
+  DATA_BLOB output = {};
+  EXPECT_TRUE(::CryptProtectData(&input, L"", nullptr, nullptr, nullptr, 0,
+                                 &output));
+  auto owned = base::win::TakeLocalAlloc(output.pbData);
+  return std::vector<uint8_t>(owned.get(),
+                              UNSAFE_TODO(owned.get() + output.cbData));
+}
+
+// A Local State JSON whose os_crypt.encrypted_key wraps `raw_key`.
+std::string LocalStateWithKey(base::span<const uint8_t> raw_key) {
+  std::vector<uint8_t> wrapped = WrapForCurrentUser(raw_key);
+  std::vector<uint8_t> prefixed = {'D', 'P', 'A', 'P', 'I'};
+  prefixed.insert(prefixed.end(), wrapped.begin(), wrapped.end());
+  std::string encoded = base::Base64Encode(prefixed);
+  return base::StrCat(
+      {"{\"os_crypt\":{\"encrypted_key\":\"", encoded, "\"}}"});
+}
+
+// A "v10" password value: "v10" + 12-byte nonce + ciphertext + 16-byte tag.
+std::vector<uint8_t> MakeV10Value(base::span<const uint8_t> raw_key,
+                                  const std::string& plaintext) {
+  std::array<uint8_t, 12> nonce = {};
+  crypto::RandBytes(nonce);
+  std::vector<uint8_t> sealed = crypto::aead::Seal(
+      crypto::aead::AES_256_GCM, raw_key, base::as_byte_span(plaintext), nonce,
+      /*associated_data=*/{});
+  std::vector<uint8_t> value = {'v', '1', '0'};
+  value.insert(value.end(), nonce.begin(), nonce.end());
+  value.insert(value.end(), sealed.begin(), sealed.end());
+  return value;
+}
+
+std::array<uint8_t, 32> MakeKey() {
+  std::array<uint8_t, 32> key = {};
+  crypto::RandBytes(key);
+  return key;
+}
+
+TEST(ChromiumFamilyPasswordDecryptorTest, V10RoundTrip) {
+  std::array<uint8_t, 32> raw_key = MakeKey();
+  std::optional<PasswordKey> key =
+      PasswordKey::FromLocalState(LocalStateWithKey(raw_key));
+  ASSERT_TRUE(key);
+  EXPECT_TRUE(key->is_valid());
+
+  std::vector<uint8_t> value = MakeV10Value(raw_key, "hunter2");
+  std::string plaintext;
+  EXPECT_EQ(DecryptResult::kOk,
+            DecryptPasswordValue(*key, value, &plaintext));
+  EXPECT_EQ("hunter2", plaintext);
+}
+
+TEST(ChromiumFamilyPasswordDecryptorTest, V20IsSkippedAndNotRead) {
+  std::array<uint8_t, 32> raw_key = MakeKey();
+  std::optional<PasswordKey> key =
+      PasswordKey::FromLocalState(LocalStateWithKey(raw_key));
+  ASSERT_TRUE(key);
+
+  // "v20" app-bound value. It must be refused outright, never read.
+  std::vector<uint8_t> value = {'v', '2', '0', 1, 2, 3, 4, 5};
+  std::string plaintext = "untouched";
+  EXPECT_EQ(DecryptResult::kSkippedV20,
+            DecryptPasswordValue(*key, value, &plaintext));
+  EXPECT_EQ("untouched", plaintext);
+}
+
+TEST(ChromiumFamilyPasswordDecryptorTest, OldDpapiValueRoundTrip) {
+  // A value with no "v10"/"v20" prefix is an old blob wrapped for the user.
+  std::vector<uint8_t> value = WrapForCurrentUser(base::as_byte_span(
+      std::string_view("legacy-secret")));
+  PasswordKey no_key;  // Not needed for an unprefixed value.
+  std::string plaintext;
+  EXPECT_EQ(DecryptResult::kOk,
+            DecryptPasswordValue(no_key, value, &plaintext));
+  EXPECT_EQ("legacy-secret", plaintext);
+}
+
+TEST(ChromiumFamilyPasswordDecryptorTest, V10WithWrongKeyFails) {
+  std::array<uint8_t, 32> raw_key = MakeKey();
+  std::vector<uint8_t> value = MakeV10Value(raw_key, "secret");
+
+  std::array<uint8_t, 32> other_key = MakeKey();
+  std::optional<PasswordKey> key = PasswordKey::FromRawKeyForTesting(other_key);
+  ASSERT_TRUE(key);
+  std::string plaintext;
+  EXPECT_EQ(DecryptResult::kError,
+            DecryptPasswordValue(*key, value, &plaintext));
+}
+
+TEST(ChromiumFamilyPasswordDecryptorTest, GarbageValueSkipped) {
+  std::array<uint8_t, 32> raw_key = MakeKey();
+  std::optional<PasswordKey> key = PasswordKey::FromRawKeyForTesting(raw_key);
+  ASSERT_TRUE(key);
+  std::vector<uint8_t> value = {1, 2, 3};  // Too short for an old blob.
+  std::string plaintext;
+  EXPECT_EQ(DecryptResult::kSkippedOther,
+            DecryptPasswordValue(*key, value, &plaintext));
+}
+
+TEST(ChromiumFamilyPasswordDecryptorTest, BadLocalStateHasNoKey) {
+  EXPECT_FALSE(PasswordKey::FromLocalState("not json"));
+  EXPECT_FALSE(PasswordKey::FromLocalState("{}"));
+  EXPECT_FALSE(PasswordKey::FromLocalState(
+      "{\"os_crypt\":{\"encrypted_key\":\"!!!notbase64\"}}"));
+}
