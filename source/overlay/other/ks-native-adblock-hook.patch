 // ContentSettingSubresourceFilterBubbleModel ----------------------------------
 
+// Thoron native ad blocking uses this bubble to report its blocking: how many
+// requests it stopped on the page, and a checkbox to allow ads and trackers on
+// the site (its per-site switch).
+namespace {
+bool ThoronNativeAdblock() {
+  return base::FeatureList::IsEnabled(thoron_adblock::kThoronNativeAdblock);
+}
+
+// The sites the page's blocked requests were for, the most first, as the
+// lines of the bubble's list. Kept in memory with the page, as the count is.
+std::vector<std::u16string> ThoronBlockedSites(content::Page& page) {
+  constexpr size_t kShown = 8;
+  const std::vector<std::pair<std::string, int>> hosts =
+      thoron_adblock::BlockedCount::Hosts(page);
+  std::vector<std::u16string> lines;
+  for (size_t i = 0; i < hosts.size() && i < kShown; ++i) {
+    lines.push_back(l10n_util::GetStringFUTF16(
+        IDS_THORON_ADBLOCK_BUBBLE_SITE, base::UTF8ToUTF16(hosts[i].first),
+        base::NumberToString16(hosts[i].second)));
+  }
+  if (hosts.size() > kShown) {
+    lines.push_back(l10n_util::GetPluralStringFUTF16(
+        IDS_THORON_ADBLOCK_BUBBLE_MORE_SITES,
+        static_cast<int>(hosts.size() - kShown)));
+  }
+  return lines;
+}
+}  // namespace
