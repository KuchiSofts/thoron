index 0000000000000000000000000000000000000000..112547e7177417e43a9abda99d120ec6845faeec
--- /dev/null
+++ b/components/thoron_portable_key/argon2id.cc
@@ -0,0 +1,104 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_portable_key/argon2id.h"
+
+#include <algorithm>
+#include <limits>
+
+#include "base/numerics/safe_conversions.h"
+#include "components/thoron_portable_key/secret_bytes.h"
+#include "third_party/argon2/src/include/argon2.h"
+
+namespace thoron_portable_key {
+
+namespace {
+
+constexpr uint32_t kMemoryStepKib = 65536;  // 64 MiB
+
+bool Derive(base::span<uint8_t> password,
+            base::span<const uint8_t> salt,
+            base::span<const uint8_t> secret,
+            base::span<const uint8_t> associated_data,
+            const Argon2Params& params,
+            base::span<uint8_t> out) {
+  constexpr size_t kMost = std::numeric_limits<uint32_t>::max();
+  bool ok = !out.empty() && out.size() <= kMost && password.size() <= kMost &&
+            salt.size() <= kMost && secret.size() <= kMost &&
+            associated_data.size() <= kMost;
+  if (ok) {
+    argon2_context context = {};
+    context.out = out.data();
+    context.outlen = base::checked_cast<uint32_t>(out.size());
+    context.pwd = password.data();
+    context.pwdlen = base::checked_cast<uint32_t>(password.size());
+    // The library only reads these; its interface is not const.
+    context.salt = const_cast<uint8_t*>(salt.data());
+    context.saltlen = base::checked_cast<uint32_t>(salt.size());
+    context.secret = const_cast<uint8_t*>(secret.data());
+    context.secretlen = base::checked_cast<uint32_t>(secret.size());
+    context.ad = const_cast<uint8_t*>(associated_data.data());
+    context.adlen = base::checked_cast<uint32_t>(associated_data.size());
+    context.t_cost = params.passes;
+    context.m_cost = params.memory_kib;
+    context.lanes = params.lanes;
+    context.threads = 1;  // built without threads: the lanes run in turn
+    context.version = ARGON2_VERSION_13;
+    context.flags = ARGON2_FLAG_CLEAR_PASSWORD;
+    ok = argon2_ctx(&context, Argon2_id) == ARGON2_OK;
+  }
+  // The library clears the password once it has hashed it; when it stopped
+  // before that, it is wiped here.
+  Wipe(password);
+  if (!ok) {
+    Wipe(out);
+  }
+  return ok;
+}
+
+}  // namespace
+
+bool AreAcceptable(const Argon2Params& params) {
+  return params.memory_kib >= kFloor.memory_kib &&
+         params.memory_kib <= kCeiling.memory_kib &&
+         params.passes >= kFloor.passes && params.passes <= kCeiling.passes &&
+         params.lanes >= kFloor.lanes && params.lanes <= kCeiling.lanes &&
+         params.memory_kib >= 8 * params.lanes;
+}
+
+Argon2Params Calibrate(base::TimeDelta floor_time) {
+  Argon2Params params = kFloor;
+  if (!floor_time.is_positive()) {
+    return params;
+  }
+  // The time grows with the memory: each 64 MiB more costs about what the
+  // floor costs.
+  const int64_t steps = std::clamp<int64_t>(
+      kCalibrationTarget.IntDiv(floor_time), 1,
+      kMostCalibratedMemoryKib / kMemoryStepKib);
+  params.memory_kib = base::checked_cast<uint32_t>(steps * kMemoryStepKib);
+  return params;
+}
+
+bool Argon2id(base::span<uint8_t> password,
+              base::span<const uint8_t> salt,
+              const Argon2Params& params,
+              base::span<uint8_t> out) {
+  if (!AreAcceptable(params)) {
+    Wipe(password);
+    Wipe(out);
+    return false;
+  }
+  return Derive(password, salt, {}, {}, params, out);
+}
+
+bool Argon2idForTesting(base::span<uint8_t> password,
+                        base::span<const uint8_t> salt,
+                        base::span<const uint8_t> secret,
+                        base::span<const uint8_t> associated_data,
+                        const Argon2Params& params,
+                        base::span<uint8_t> out) {
+  return Derive(password, salt, secret, associated_data, params, out);
+}
+
+}  // namespace thoron_portable_key
