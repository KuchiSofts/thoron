+
+std::string CanonicalAddress(std::string_view email) {
+  std::string out =
+      base::ToLowerASCII(base::TrimWhitespaceASCII(email, base::TRIM_ALL));
+  const size_t at = out.rfind('@');
+  if (at == std::string::npos) {
+    return out;
+  }
+  std::string name = out.substr(0, at);
+  std::string domain = out.substr(at + 1);
+  if (domain == "googlemail.com") {
+    domain = "gmail.com";
+  }
+  if (domain == "gmail.com") {
+    std::erase(name, '.');
+  }
+  return name + "@" + domain;
+}
+
+size_t PlaceInOrder(const std::vector<std::string>& order,
+                    std::string_view email) {
+  const std::string name = CanonicalAddress(email);
+  const auto at = std::ranges::find(order, name);
+  return static_cast<size_t>(at - order.begin());
+}
