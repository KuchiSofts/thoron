+constexpr char kWriteProblem[] =
+    "Thoron could not write the key file into this copy's folder. Check that "
+    "the drive is not full or read-only, then try again. Nothing changed.";
+constexpr char kCheckProblem[] =
+    "The key file Thoron wrote did not open again as it should, so Thoron put "
+    "back what was there. Nothing changed.";
+constexpr char kMemoryProblem[] =
+    "Thoron could not get the memory it needs for the passphrase. Close other "
+    "programs and try again.";
+constexpr char kWrongPassphrase[] =
