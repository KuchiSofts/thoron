@@ -0,0 +1,111 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Coverage-guided fuzzing of the manifest reader (ROADMAP S.2, U9). A copy
+// reads a manifest only after its signature holds, so random bytes would never
+// get past the signature: each input is signed here with the published test
+// key (make_test_vectors.py), and the whole check runs as a copy runs it. The
+// first byte of the input picks the copy (its kind, build, channel and
+// versions); the rest is the manifest.
+//
+// Every input ends in a decision, and a decision to update keeps the promises
+// of manifest.h: the package is newer than the copy, and its URL, size and
+// SHA-256 have the documented form, on an allowed host.
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <array>
+#include <string>
+#include <string_view>
+
+#include "base/check.h"
+#include "base/check_op.h"
+#include "components/thoron_update/manifest.h"
+#include "crypto/hash.h"
+#include "third_party/boringssl/src/include/openssl/curve25519.h"
+#include "url/gurl.h"
+
+namespace {
+
+using thoron_update::BuildVersion;
+using thoron_update::Decision;
+using thoron_update::Kind;
+using thoron_update::Outcome;
+using thoron_update::PackageFile;
+using thoron_update::Variant;
+
+constexpr std::string_view kTestKeyPhrase =
+    "thoron-update test vectors: a key for tests only, never a release key";
+constexpr std::string_view kSignaturePrefix = "thoron-update-manifest-v1\n";
+constexpr int64_t kNow = 1795000000;  // 2026-11-18
+
+struct TestKey {
+  TestKey() {
+    const auto seed = crypto::hash::Sha256(kTestKeyPhrase);
+    ED25519_keypair_from_seed(public_key.data(), private_key, seed.data());
+  }
+  std::array<uint8_t, 32> public_key;
+  uint8_t private_key[64];
+};
+
+void CheckPackage(const PackageFile& file) {
+  CHECK_LE(file.url.size(), 1024u);
+  const GURL url(file.url);
+  CHECK(url.is_valid());
+  CHECK(url.SchemeIs("https"));
+  CHECK_EQ(url.host(), "github.com");
+  CHECK_GE(file.size, 1);
+  CHECK_LE(file.size, 2147483647);
+  CHECK_EQ(file.sha256.size(), 64u);
+  for (char c : file.sha256) {
+    CHECK((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'));
+  }
+}
+
+}  // namespace
+
+extern "C" int LLVMFuzzerTestOneInput(const uint8_t* data, size_t size) {
+  static const TestKey key;
+  if (size < 1) {
+    return 0;
+  }
+  const uint8_t pick = data[0];
+  const std::string_view manifest(reinterpret_cast<const char*>(data + 1), size - 1);
+
+  // Signed as the release tool signs: the prefix, then the bytes exactly.
+  std::string message(kSignaturePrefix);
+  message.append(manifest);
+  uint8_t signature[64];
+  CHECK(ED25519_sign(signature, reinterpret_cast<const uint8_t*>(message.data()), message.size(),
+                     key.private_key));
+
+  static constexpr Variant kVariants[] = {Variant::kWinX64Avx2, Variant::kWinX64Sse4,
+                                          Variant::kWinArm64Armv8, Variant::kLinuxX64Avx2};
+  thoron_update::CopyInfo copy;
+  copy.public_key = key.public_key;
+  copy.allowed_hosts = {"github.com"};
+  copy.channel = (pick & 1) ? "stable" : "beta";
+  copy.kind = (pick & 2) ? Kind::kPortable : Kind::kInstalled;
+  copy.variant = kVariants[(pick >> 2) & 3];
+  copy.installed = (pick & 16) ? BuildVersion() : *thoron_update::ParseBuildVersion("158.0.8127.3010");
+  copy.updater = *thoron_update::ParseBuildVersion((pick & 32) ? "158.0.8127.3010" : "158.0.8127.6500");
+  copy.last_serial = (pick & 64) ? 5 : 0;
+
+  const Decision decision = thoron_update::CheckUpdate(
+      manifest, std::string_view(reinterpret_cast<const char*>(signature), sizeof(signature)), copy,
+      kNow);
+  if (decision.outcome == Outcome::kUpdate) {
+    CHECK(decision.manifest);
+    CHECK(decision.full);
+    CHECK(decision.manifest->version > copy.installed);
+    CheckPackage(*decision.full);
+    if (decision.delta) {
+      CheckPackage(*decision.delta);
+    }
+  }
+  if (decision.remember_serial) {
+    CHECK_GE(*decision.remember_serial, copy.last_serial);
+  }
+  return 0;
+}
