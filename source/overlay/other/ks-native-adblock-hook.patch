@@ -0,0 +1,314 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_update/snapshot.h"
+
+#include <algorithm>
+#include <array>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/files/file.h"
+#include "base/files/file_enumerator.h"
+#include "base/files/file_util.h"
+#include "base/files/important_file_writer.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/values.h"
+#include "components/thoron_update/package.h"
+#include "crypto/hash.h"
+#include "third_party/sqlite/sqlite3.h"
+
+namespace thoron_update {
+
+namespace {
+
+constexpr char kRecord[] = "snapshot.json";
+constexpr char kLocalState[] = "Local State";
+constexpr char kSessions[] = "Sessions";
+constexpr int64_t kMostRecordBytes = 4 * 1024 * 1024;
+
+// Files of a profile; true for an SQLite database.
+constexpr std::array<std::pair<const char*, bool>, 10> kProfileFiles = {{
+    {"Bookmarks", false},
+    {"Preferences", false},
+    {"Secure Preferences", false},
+    {"Login Data", true},
+    {"Login Data For Account", true},
+    {"History", true},
+    {"Web Data", true},
+    {"Network/Cookies", true},
+    {"Shortcuts", true},
+    {"Top Sites", true},
+}};
+
+base::FilePath Under(const base::FilePath& folder, std::string_view path) {
+  return folder.Append(base::FilePath::FromUTF8Unsafe(path))
+      .NormalizePathSeparators();
+}
+
+std::optional<std::string> Sha256Of(const base::FilePath& path) {
+  base::File file(path, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  if (!file.IsValid()) {
+    return std::nullopt;
+  }
+  crypto::hash::Hasher hasher(crypto::hash::kSha256);
+  std::vector<uint8_t> buffer(1024 * 1024);
+  while (true) {
+    const std::optional<size_t> read = file.ReadAtCurrentPos(buffer);
+    if (!read) {
+      return std::nullopt;
+    }
+    if (*read == 0) {
+      break;
+    }
+    hasher.Update(base::span(buffer).first(*read));
+  }
+  std::array<uint8_t, crypto::hash::kSha256Size> digest;
+  hasher.Finish(digest);
+  return base::HexEncodeLower(digest);
+}
+
+// SQLite's own check of the database at `path`. It is opened for writing, so
+// that a journal next to it is rolled back first, as the browser would.
+std::string DatabaseCheck(const base::FilePath& path) {
+  // Chromium builds SQLite without its automatic start.
+  if (sqlite3_initialize() != SQLITE_OK) {
+    return "could not be checked";
+  }
+  sqlite3* db = nullptr;
+  if (sqlite3_open_v2(path.AsUTF8Unsafe().c_str(), &db, SQLITE_OPEN_READWRITE,
+                      nullptr) != SQLITE_OK) {
+    sqlite3_close(db);
+    return "could not be opened";
+  }
+  std::string result = "could not be checked";
+  sqlite3_stmt* statement = nullptr;
+  if (sqlite3_prepare_v2(db, "PRAGMA integrity_check", -1, &statement,
+                         nullptr) == SQLITE_OK &&
+      sqlite3_step(statement) == SQLITE_ROW) {
+    const unsigned char* text = sqlite3_column_text(statement, 0);
+    result = text ? std::string(reinterpret_cast<const char*>(text)) : "";
+    result = result == "ok" ? "ok" : "damaged";
+  } else {
+    result = "damaged";
+  }
+  sqlite3_finalize(statement);
+  sqlite3_close(db);
+  return result;
+}
+
+bool IsLabel(std::string_view label) {
+  return !label.empty() && label.size() <= 80 && label.front() != '.' &&
+         std::ranges::all_of(label, [](char c) {
+           return base::IsAsciiAlphaNumeric(c) || c == '-' || c == '_' ||
+                  c == '.';
+         });
+}
+
+// The profile folders of `user_data`: those that hold a Preferences file.
+std::vector<base::FilePath> Profiles(const base::FilePath& user_data) {
+  std::vector<base::FilePath> out;
+  base::FileEnumerator found(user_data, /*recursive=*/false,
+                             base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath path = found.Next(); !path.empty(); path = found.Next()) {
+    if (base::PathExists(path.AppendASCII("Preferences"))) {
+      out.push_back(path);
+    }
+  }
+  std::ranges::sort(out);
+  return out;
+}
+
+// Copies `from` to `to` and gives the copy's length and SHA-256 when the copy
+// is the same as what was read.
+std::optional<std::pair<int64_t, std::string>> CopyChecked(
+    const base::FilePath& from,
+    const base::FilePath& to) {
+  const std::optional<std::string> before = Sha256Of(from);
+  if (!before || !base::CreateDirectory(to.DirName()) ||
+      !base::CopyFile(from, to)) {
+    return std::nullopt;
+  }
+  const std::optional<std::string> after = Sha256Of(to);
+  std::optional<int64_t> size = base::GetFileSize(to);
+  if (!after || !size || *after != *before) {
+    return std::nullopt;
+  }
+  return std::make_pair(*size, *after);
+}
+
+void RemoveOldest(const base::FilePath& snapshots, int keep) {
+  std::vector<std::pair<base::Time, base::FilePath>> found;
+  base::FileEnumerator all(snapshots, /*recursive=*/false,
+                           base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath path = all.Next(); !path.empty(); path = all.Next()) {
+    if (base::PathExists(path.AppendASCII(kRecord))) {
+      found.emplace_back(all.GetInfo().GetLastModifiedTime(), path);
+    }
+  }
+  std::ranges::sort(found);
+  for (size_t i = 0; i + keep < found.size(); ++i) {
+    base::DeletePathRecursively(found[i].second);
+  }
+}
+
+}  // namespace
+
+std::vector<std::string> SnapshotFiles() {
+  std::vector<std::string> out;
+  for (const auto& [path, database] : kProfileFiles) {
+    out.emplace_back(path);
+  }
+  out.emplace_back(std::string(kSessions) + "/");
+  return out;
+}
+
+SnapshotReport TakeSnapshot(const base::FilePath& user_data,
+                            const base::FilePath& snapshots,
+                            std::string_view label,
+                            int keep) {
+  SnapshotReport report;
+  if (!IsLabel(label) || keep < 1 || !base::DirectoryExists(user_data)) {
+    report.problems.push_back("nothing to take a snapshot of, or a bad label");
+    return report;
+  }
+  report.folder = snapshots.AppendASCII(label);
+  if (base::PathExists(report.folder) ||
+      !base::CreateDirectory(report.folder)) {
+    report.problems.push_back("the snapshot's folder exists or cannot be made");
+    return report;
+  }
+  base::ListValue files;
+  auto take = [&](const base::FilePath& from, const std::string& name,
+                  bool database) {
+    const base::FilePath to = Under(report.folder, name);
+    const std::optional<std::pair<int64_t, std::string>> copied =
+        CopyChecked(from, to);
+    if (!copied) {
+      report.problems.push_back(name + ": the copy does not verify");
+      return;
+    }
+    const base::FilePath journal(from.value() + FILE_PATH_LITERAL("-journal"));
+    if (database && base::PathExists(journal)) {
+      // The journal goes with it, so the copy is what the browser would read.
+      base::CopyFile(journal, base::FilePath(to.value() + FILE_PATH_LITERAL("-journal")));
+    }
+    std::string sha256 = copied->second;
+    int64_t size = copied->first;
+    if (database) {
+      const std::string check = DatabaseCheck(to);
+      if (check != "ok") {
+        report.problems.push_back(name + ": " + check);
+      }
+      // A journal that was rolled back changed the copy: record what is kept.
+      std::optional<std::string> now = Sha256Of(to);
+      std::optional<int64_t> now_size = base::GetFileSize(to);
+      base::DeleteFile(base::FilePath(to.value() + FILE_PATH_LITERAL("-journal")));
+      if (now && now_size) {
+        sha256 = *now;
+        size = *now_size;
+      }
+    }
+    files.Append(base::DictValue()
+                     .Set("path", name)
+                     .Set("size", base::NumberToString(size))
+                     .Set("sha256", sha256));
+    ++report.files;
+    report.bytes += size;
+  };
+
+  if (base::PathExists(user_data.AppendASCII(kLocalState))) {
+    take(user_data.AppendASCII(kLocalState), kLocalState, false);
+  }
+  for (const base::FilePath& profile : Profiles(user_data)) {
+    const std::string profile_name = profile.BaseName().AsUTF8Unsafe();
+    ++report.profiles;
+    for (const auto& [path, database] : kProfileFiles) {
+      const base::FilePath from = Under(profile, path);
+      if (base::PathExists(from)) {
+        take(from, profile_name + "/" + path, database);
+      }
+    }
+    base::FileEnumerator sessions(profile.AppendASCII(kSessions),
+                                  /*recursive=*/false,
+                                  base::FileEnumerator::FILES);
+    for (base::FilePath path = sessions.Next(); !path.empty();
+         path = sessions.Next()) {
+      take(path,
+           profile_name + "/" + kSessions + "/" + path.BaseName().AsUTF8Unsafe(),
+           false);
+    }
+  }
+  const std::optional<std::string> record =
+      base::WriteJsonWithOptions(base::DictValue()
+                                     .Set("format", "thoron-profile-snapshot")
+                                     .Set("version", 1)
+                                     .Set("files", std::move(files)),
+                                 base::JSONWriter::OPTIONS_PRETTY_PRINT);
+  if (!record || !base::ImportantFileWriter::WriteFileAtomically(
+                     report.folder.AppendASCII(kRecord), *record)) {
+    report.problems.push_back("the snapshot's record could not be written");
+    return report;
+  }
+  RemoveOldest(snapshots, keep);
+  report.ok = report.problems.empty();
+  return report;
+}
+
+bool RestoreSnapshot(const base::FilePath& folder,
+                     const base::FilePath& user_data,
+                     std::vector<std::string>* problems) {
+  std::string text;
+  std::optional<base::DictValue> record;
+  if (base::ReadFileToStringWithMaxSize(folder.AppendASCII(kRecord), &text,
+                                        kMostRecordBytes)) {
+    record = base::JSONReader::ReadDict(text, base::JSON_PARSE_RFC);
+  }
+  const std::string* format = record ? record->FindString("format") : nullptr;
+  const base::ListValue* files = record ? record->FindList("files") : nullptr;
+  if (!format || *format != "thoron-profile-snapshot" || !files) {
+    problems->push_back("not a snapshot");
+    return false;
+  }
+  // First every file is checked; only then is anything put back.
+  std::vector<std::string> paths;
+  for (const base::Value& value : *files) {
+    const base::DictValue* entry = value.GetIfDict();
+    const std::string* path = entry ? entry->FindString("path") : nullptr;
+    const std::string* size = entry ? entry->FindString("size") : nullptr;
+    const std::string* sha256 = entry ? entry->FindString("sha256") : nullptr;
+    int64_t length = 0;
+    const base::FilePath relative =
+        path ? base::FilePath::FromUTF8Unsafe(*path) : base::FilePath();
+    if (!path || !size || !sha256 || !base::StringToInt64(*size, &length) ||
+        relative.IsAbsolute() || relative.ReferencesParent() ||
+        CheckFile(Under(folder, *path), PackageFile{std::string(), length, *sha256}) !=
+            FileCheck::kOk) {
+      problems->push_back((path ? *path : std::string("an entry")) +
+                          ": does not verify");
+      continue;
+    }
+    paths.push_back(*path);
+  }
+  if (!problems->empty()) {
+    return false;
+  }
+  for (const std::string& path : paths) {
+    const base::FilePath to = Under(user_data, path);
+    if (!base::CreateDirectory(to.DirName()) ||
+        !base::CopyFile(Under(folder, path), to)) {
+      problems->push_back(path + ": could not be put back");
+      continue;
+    }
+    // A journal of the file that is there now belongs to the file that went.
+    base::DeleteFile(base::FilePath(to.value() + FILE_PATH_LITERAL("-journal")));
+  }
+  return problems->empty();
+}
+
+}  // namespace thoron_update
