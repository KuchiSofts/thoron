+TEST_F(ChromiumFamilyReaderTest, SourceUntouchedAndCopiesDeleted) {
+  std::array<uint8_t, 32> raw_key = MakeKey();
+  MakeBookmarks();
+  MakeHistory(base::Time::Now());
+  MakeWebData();
+  MakeLocalState(raw_key);
+  MakeLoginData(raw_key);
+
+  const std::vector<base::FilePath> sources = {
+      profile_.Append(FILE_PATH_LITERAL("Bookmarks")), profile_.Append(FILE_PATH_LITERAL("History")),
+      profile_.Append(FILE_PATH_LITERAL("Web Data")), profile_.Append(FILE_PATH_LITERAL("Login Data")),
+      user_data_.Append(FILE_PATH_LITERAL("Local State"))};
+  std::vector<std::string> before;
+  for (const base::FilePath& path : sources) {
+    std::string contents;
+    ASSERT_TRUE(base::ReadFileToString(path, &contents));
+    before.push_back(std::move(contents));
+  }
+
+  base::FilePath copies;
+  {
+    FakeBridge bridge;
+    ChromiumFamilyReader reader(Options());
+    reader.Import(ALL, &bridge);
+    copies = reader.copies_folder_for_testing();
+    ASSERT_FALSE(copies.empty());
+    // The copies sit outside the source profile.
+    EXPECT_FALSE(dir_.GetPath().IsParent(copies));
+    EXPECT_TRUE(base::PathExists(copies));
+  }
+  // Copies are deleted with the reader.
+  EXPECT_FALSE(base::PathExists(copies));
+
