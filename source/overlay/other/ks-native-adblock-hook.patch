+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "url/gurl.h"
+
+namespace {
+
+// The page with the browser's language and its direction in <html>: i18n.js
+// puts the page's text into that language.
+std::string LocalizedPage(std::string_view html) {
+  std::string page(html);
+  const std::string locale =
+      g_browser_process ? g_browser_process->GetApplicationLocale() : "en";
+  // the theme chosen on the settings page ("light" or "dark"; none: as the
+  // system)
+  const std::string& theme = thoron_adblock::EngineService::Get().theme();
+  base::ReplaceFirstSubstringAfterOffset(
+      &page, 0, "<html lang=\"en\" dir=\"ltr\">",
+      base::StrCat({"<html lang=\"", base::EscapeForHTML(locale), "\" dir=\"",
+                    base::i18n::IsRTL() ? "rtl" : "ltr", "\"",
+                    theme.empty() ? "" : " data-theme=\"",
+                    theme.empty() ? "" : theme, theme.empty() ? "" : "\"",
+                    ">"}));
+  return page;
+}
+
+constexpr char kScriptPath[] = "/adblock.js";
+constexpr char kI18nPath[] = "/i18n.js";
+// What the page may send: an address, and rules of at most the size the store
+// accepts (it checks again).
+constexpr size_t kMaxUrlLength = 2048;
+constexpr size_t kMaxRulesLength = 1024 * 1024;
+// uBlock Origin's cloud storage: the synced preference, and the most it holds
+// (as uBlock Origin's, about 100 kB).
+constexpr char kCloudPref[] = "thoron_adblock.cloud_backup";
+constexpr size_t kMaxCloudBytes = 100 * 1024;
+
+// Serves the page and its script. Both are part of the engine library
+// (components/thoron_adblock/settings_page.html and .js). The default security
+// policy of a data source stays in force: script only from this page and from
+// chrome://resources, and no markup made from text.
+class ThoronAdblockDataSource : public content::URLDataSource {
+ public:
+  ThoronAdblockDataSource() = default;
+  ThoronAdblockDataSource(const ThoronAdblockDataSource&) = delete;
+  ThoronAdblockDataSource& operator=(const ThoronAdblockDataSource&) = delete;
+
+  // content::URLDataSource:
+  std::string GetSource() override { return kThoronAdblockHost; }
+
+  std::string GetMimeType(const GURL& url) override {
+    return url.path() == kScriptPath || url.path() == kI18nPath
+               ? "text/javascript"
+               : "text/html";
+  }
+
+  // A module script is only run when it comes with its type.
+  bool ShouldServeMimeTypeAsContentTypeHeader() override { return true; }
+
+  void StartDataRequest(const GURL& url,
+                        const content::WebContents::Getter& wc_getter,
+                        GotDataCallback callback) override {
+    const std::string path(url.path());
+    if (path == kScriptPath) {
+      std::move(callback).Run(base::MakeRefCounted<base::RefCountedString>(
+          std::string(thoron_adblock::settings_page_js())));
+    } else if (path == kI18nPath) {
+      std::move(callback).Run(base::MakeRefCounted<base::RefCountedString>(
+          std::string(thoron_adblock::page_i18n_js())));
+    } else if (path.empty() || path == "/") {
+      std::move(callback).Run(base::MakeRefCounted<base::RefCountedString>(
+          LocalizedPage(std::string(thoron_adblock::settings_page_html()))));
+    } else {
+      std::move(callback).Run(nullptr);
+    }
+  }
+};
+
+// Takes what the page asks for (settings_page.js) to the engine service and
+// brings the answer back. Every message starts with the id of its answer.
+class ThoronAdblockHandler : public content::WebUIMessageHandler {
+ public:
+  ThoronAdblockHandler() = default;
+  ThoronAdblockHandler(const ThoronAdblockHandler&) = delete;
+  ThoronAdblockHandler& operator=(const ThoronAdblockHandler&) = delete;
+  ~ThoronAdblockHandler() override = default;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override {
+    Register("getState", &ThoronAdblockHandler::GetState);
+    Register("setListEnabled", &ThoronAdblockHandler::SetListEnabled);
+    Register("addList", &ThoronAdblockHandler::AddList);
+    Register("removeList", &ThoronAdblockHandler::RemoveList);
+    Register("setMyFilters", &ThoronAdblockHandler::SetMyFilters);
+    Register("updateNow", &ThoronAdblockHandler::UpdateNow);
+    Register("getSites", &ThoronAdblockHandler::GetSites);
+    Register("allowSite", &ThoronAdblockHandler::AllowSite);
+    Register("forgetSite", &ThoronAdblockHandler::ForgetSite);
+    Register("clearSwitches", &ThoronAdblockHandler::ClearSwitches);
+    Register("getLog", &ThoronAdblockHandler::GetLog);
+    Register("setTrustMyFilters", &ThoronAdblockHandler::SetTrustMyFilters);
+    Register("setShortcut", &ThoronAdblockHandler::SetShortcut);
+    Register("checkFilters", &ThoronAdblockHandler::CheckFilters);
+    Register("getListText", &ThoronAdblockHandler::GetListText);
+    Register("explainRequest", &ThoronAdblockHandler::ExplainRequest);
+    Register("getSettings", &ThoronAdblockHandler::GetSettings);
+    Register("allowPattern", &ThoronAdblockHandler::AllowPattern);
+    Register("setHostSwitches", &ThoronAdblockHandler::SetHostSwitches);
+    Register("setSiteJavascript", &ThoronAdblockHandler::SetSiteJavascript);
+    Register("addFilter", &ThoronAdblockHandler::AddFilter);
+    Register("getMyRules", &ThoronAdblockHandler::GetMyRules);
+    Register("getRulesForNow", &ThoronAdblockHandler::GetRulesForNow);
+    Register("sendToCloud", &ThoronAdblockHandler::SendToCloud);
+    Register("getFromCloud", &ThoronAdblockHandler::GetFromCloud);
+    Register("getStorageUsed", &ThoronAdblockHandler::GetStorageUsed);
+    Register("reloadTab", &ThoronAdblockHandler::ReloadTab);
+    Register("setMyRules", &ThoronAdblockHandler::SetMyRules);
+    Register("setSetting", &ThoronAdblockHandler::SetSetting);
+    Register("setBlocking", &ThoronAdblockHandler::SetBlocking);
+  }
+
+  void OnJavascriptDisallowed() override { weak_factory_.InvalidateWeakPtrs(); }
+
+ private:
+  using Method = void (ThoronAdblockHandler::*)(const base::ListValue&);
+
+  void Register(std::string_view message, Method method) {
+    web_ui()->RegisterMessageCallback(
+        message, base::BindRepeating(method, base::Unretained(this)));
+  }
+
+  // The service, set up the way the request hook sets it up, for a page that
+  // is opened before any other page was loaded.
+  static thoron_adblock::EngineService& Service() {
+    thoron_adblock::EngineService& service =
+        thoron_adblock::EngineService::Get();
+    if (!service.is_configured()) {
+      service.Configure(
+          base::PathService::CheckedGet(chrome::DIR_USER_DATA),
+          base::BindRepeating(
+              []() -> scoped_refptr<network::SharedURLLoaderFactory> {
+                return g_browser_process
+                           ? g_browser_process->shared_url_loader_factory()
+                           : nullptr;
+              }));
+    }
+    return service;
+  }
+
+  // The id of the answer, when the message has the shape `count` arguments
+  // after it give; else nothing, and the message is dropped.
+  const std::string* AnswerId(const base::ListValue& args, size_t count) {
+    AllowJavascript();
+    return args.size() == count + 1 ? args[0].GetIfString() : nullptr;
+  }
+
+  thoron_adblock::EngineService::Changed Changed(const std::string& id) {
+    return base::BindOnce(&ThoronAdblockHandler::Answer,
+                          weak_factory_.GetWeakPtr(), id);
+  }
+
+  void Answer(const std::string& id, std::string error) {
+    if (IsJavascriptAllowed()) {
+      ResolveJavascriptCallback(base::Value(id), base::Value(std::move(error)));
+    }
+  }
+
+  void AnswerState(const std::string& id, base::DictValue state) {
+    // whether "Next check" times apply: lists are looked for on their own
+    state.Set("autoUpdate", Service().Option("auto-update"));
+    if (IsJavascriptAllowed()) {
+      ResolveJavascriptCallback(base::Value(id), state);
+    }
+  }
+
+  HostContentSettingsMap* SiteSettings() {
+    return HostContentSettingsMapFactory::GetForProfile(
+        Profile::FromWebUI(web_ui()));
+  }
+
+  // Sites where ads are allowed (the person's own choices), the menu's
+  // switches, and the total.
+  void GetSites(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 0);
+    if (!id) {
+      return;
+    }
+    base::ListValue allowed;
+    for (const ContentSettingPatternSource& setting :
+         SiteSettings()->GetSettingsForOneType(ContentSettingsType::ADS)) {
+      if (setting.source == content_settings::ProviderType::kPrefProvider &&
+          setting.GetContentSetting() == CONTENT_SETTING_ALLOW) {
+        allowed.Append(setting.primary_pattern.ToString());
+      }
+    }
+    // the menu's JavaScript switch, as uBlock Origin's "no-scripting" writes it
+    base::ListValue javascript;
+    for (const ContentSettingPatternSource& setting :
+         SiteSettings()->GetSettingsForOneType(ContentSettingsType::JAVASCRIPT)) {
+      if (setting.source == content_settings::ProviderType::kPrefProvider &&
+          setting.GetContentSetting() == CONTENT_SETTING_BLOCK &&
+          !setting.primary_pattern.MatchesAllHosts()) {
+        const std::string host(
+            setting.primary_pattern.ToRepresentativeUrl().host());
+        if (!host.empty()) {
+          javascript.Append(host);
+        }
+      }
+    }
+    base::ListValue switches;
+    for (const auto& [host, names] : Service().site_switches()) {
+      base::ListValue list;
+      for (const std::string& name : names) {
+        list.Append(name);
+      }
+      switches.Append(base::DictValue().Set("host", host).Set("names", std::move(list)));
+    }
+    // the menu's Chrome switches (pop-ups, JavaScript) are site settings of
+    // their own and are listed on the site settings pages
+    ResolveJavascriptCallback(
+        base::Value(*id),
+        base::DictValue()
+            .Set("allowed", std::move(allowed))
+            .Set("switches", std::move(switches))
+            .Set("javascript", std::move(javascript))
+            .Set("total", static_cast<double>(
+                              thoron_adblock::BlockedCount::Total())));
+  }
+
+  void AllowSite(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 1);
+    if (!id || !args[1].is_string()) {
+      return;
+    }
+    const std::string& host = args[1].GetString();
+    const GURL url("https://" + host + "/");
+    if (host.empty() || host.size() > 253 || !url.is_valid() ||
+        url.host() != host) {
+      Answer(*id, "This is not the name of a site.");
+      return;
+    }
+    SiteSettings()->SetContentSettingCustomScope(
+        ContentSettingsPattern::FromString("[*.]" + host),
+        ContentSettingsPattern::Wildcard(), ContentSettingsType::ADS,
+        CONTENT_SETTING_ALLOW);
+    Answer(*id, std::string());
+  }
+
+  // "My rules": the text, and replacing it; the answer lists the lines that
+  // are not rules.
+  void GetMyRules(const base::ListValue& args) {
+    if (const std::string* id = AnswerId(args, 0)) {
+      ResolveJavascriptCallback(base::Value(*id),
+                                base::Value(Service().my_rules()));
+    }
+  }
+
+  // uBlock Origin's "Storage used": [id] -> bytes.
+  void GetStorageUsed(const base::ListValue& args) {
+    if (const std::string* id = AnswerId(args, 0)) {
+      Service().StorageUsed(base::BindOnce(
+          [](base::WeakPtr<ThoronAdblockHandler> self, std::string id,
+             int64_t bytes) {
+            if (self) {
+              self->ResolveJavascriptCallback(
+                  base::Value(id), base::Value(static_cast<double>(bytes)));
+            }
+          },
+          weak_factory_.GetWeakPtr(), *id));
+    }
+  }
+
+  // The logger's "Reload": [id, tab id (getLog's)] -> "" or what went wrong.
+  void ReloadTab(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 1);
+    if (!id || !args[1].is_int()) {
+      return;
+    }
+    Profile* profile = Profile::FromWebUI(web_ui());
+    for (BrowserWindowInterface* browser : GetAllBrowserWindowInterfaces()) {
+      if (browser->GetProfile() != profile) {
+        continue;
+      }
+      TabStripModel* strip = browser->GetTabStripModel();
+      for (int i = 0; i < strip->count(); ++i) {
+        content::WebContents* tab = strip->GetWebContentsAt(i);
+        if (sessions::SessionTabHelper::IdForTab(tab).id() == args[1].GetInt()) {
+          tab->GetController().Reload(content::ReloadType::NORMAL, true);
+          Answer(*id, std::string());
+          return;
+        }
+      }
+    }
+    Answer(*id, "That tab is closed.");
+  }
+
+  // uBlock Origin's cloud storage: the backup (settings_page.js makeBackup),
+  // kept in a synced preference of the profile, so the browser's own sync
+  // carries it to the person's other computers when it is on for settings.
+  // [id, text] -> "" or what went wrong.
+  void SendToCloud(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 1);
+    if (!id || !args[1].is_string()) {
+      return;
+    }
+    const std::string& text = args[1].GetString();
+    if (text.size() > kMaxCloudBytes) {
+      Answer(*id, "This is too large for cloud storage (more than 100 kB): back up to a file instead.");
+      return;
+    }
+    if (!base::IsStringUTF8(text)) {
+      return;
+    }
+    Profile::FromWebUI(web_ui())->GetPrefs()->SetString(kCloudPref, text);
+    Answer(*id, std::string());
+  }
+
+  void GetFromCloud(const base::ListValue& args) {
+    if (const std::string* id = AnswerId(args, 0)) {
+      ResolveJavascriptCallback(
+          base::Value(*id),
+          base::Value(Profile::FromWebUI(web_ui())->GetPrefs()->GetString(kCloudPref)));
+    }
+  }
+
+  // uBlock Origin's temporary rules: the rules in force now (with what the
+  // menu's grid changed and did not save).
+  void GetRulesForNow(const base::ListValue& args) {
+    if (const std::string* id = AnswerId(args, 0)) {
+      ResolveJavascriptCallback(base::Value(*id),
+                                base::Value(Service().session_rules()));
+    }
+  }
+
+  void SetMyRules(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 1);
+    if (!id || !args[1].is_string()) {
+      return;
+    }
+    base::ListValue problems;
+    for (std::string& line : Service().SetMyRules(args[1].GetString())) {
+      problems.Append(std::move(line));
+    }
+    ResolveJavascriptCallback(base::Value(*id), problems);
+  }
+
+  // One rule the logger made (its "Block" and "Allow" buttons), added to the
+  // person's own rules: one line, as long as a rule may be.
+  void AddFilter(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 1);
+    if (!id || !args[1].is_string()) {
+      return;
+    }
+    const std::string& rule = args[1].GetString();
+    if (rule.empty() || rule.size() > 2000 ||
+        rule.find_first_of("\r\n") != std::string::npos) {
+      Answer(*id, "This is not one rule.");
+      return;
+    }
+    Service().AddToMyFilters(rule, Changed(*id));
+  }
+
+  // A site of a restored backup, as the site settings wrote it
+  // ("[*.]example.com", "https://example.com:443"). Never every site at once.
+  void AllowPattern(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 1);
+    if (!id || !args[1].is_string()) {
+      return;
+    }
+    const ContentSettingsPattern pattern =
+        ContentSettingsPattern::FromString(args[1].GetString());
+    if (args[1].GetString().size() > kMaxUrlLength || !pattern.IsValid() ||
+        pattern.MatchesAllHosts()) {
+      Answer(*id, "This is not a site.");
+      return;
+    }
+    SiteSettings()->SetContentSettingCustomScope(
+        pattern, ContentSettingsPattern::Wildcard(), ContentSettingsType::ADS,
+        CONTENT_SETTING_ALLOW);
+    Answer(*id, std::string());
+  }
+
+  // The menu's switches of one host, as a restored backup has them.
+  void SetHostSwitches(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 2);
+    if (!id || !args[1].is_string() || !args[2].is_list()) {
+      return;
+    }
+    const std::string& host = args[1].GetString();
+    const GURL url("https://" + host + "/");
+    if (host.empty() || host.size() > 253 || !url.is_valid() ||
+        url.host() != host || args[2].GetList().size() > 16) {
+      Answer(*id, "This is not the name of a site.");
+      return;
+    }
+    std::vector<std::string> names;
+    for (const base::Value& name : args[2].GetList()) {
+      if (name.is_string()) {
+        names.push_back(name.GetString());
+      }
+    }
+    Service().SetHostSwitches(host, names);
+    Answer(*id, std::string());
+  }
+
+  // [id, host, blocked]: the menu's JavaScript switch for a site, as the menu
+  // sets it (uBlock Origin's "no-scripting: <host> true|false").
+  void SetSiteJavascript(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 2);
+    if (!id || !args[1].is_string() || !args[2].is_bool()) {
+      return;
+    }
+    const std::string& host = args[1].GetString();
+    const GURL url("https://" + host + "/");
+    if (host.empty() || host.size() > 253 || !url.is_valid() ||
+        url.host() != host) {
+      Answer(*id, "This is not the name of a site.");
+      return;
+    }
+    thoron_adblock::SetSiteJavascript(SiteSettings(), url, args[2].GetBool());
+    Answer(*id, std::string());
+  }
+
+  void ForgetSite(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 1);
+    if (!id || !args[1].is_string()) {
+      return;
+    }
+    const ContentSettingsPattern pattern =
+        ContentSettingsPattern::FromString(args[1].GetString());
+    if (pattern.IsValid()) {
+      SiteSettings()->SetContentSettingCustomScope(
+          pattern, ContentSettingsPattern::Wildcard(), ContentSettingsType::ADS,
+          CONTENT_SETTING_DEFAULT);
+    }
+    Answer(*id, std::string());
+  }
+
+  void ClearSwitches(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 1);
+    if (!id || !args[1].is_string()) {
+      return;
+    }
+    Service().ClearSiteSwitches(args[1].GetString());
+    Answer(*id, std::string());
+  }
+
+  // The Settings section: the blocker's options, and the browser settings
+  // uBlock Origin offers there (each "true" means the protective choice).
+  void GetSettings(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 0);
+    if (!id) {
+      return;
+    }
+    PrefService* prefs = Profile::FromWebUI(web_ui())->GetPrefs();
+    base::DictValue settings;
+    for (const char* name :
+         {"badge", "block-csp-reports", "cname-uncloak", "ignore-generic",
+          "default-media",
+          "default-cosmetic", "default-fonts", "default-3p-script",
+          "default-3p-frame", "auto-update", "context-menu", "advanced",
+          "colorblind", "no-tooltips", "toolbar-shield", "address-shield"}) {
+      settings.Set(name, Service().Option(name));
+    }
+    // where the shields are (P5.73)
+    for (const char* name : {"toolbar-position", "address-position"}) {
+      settings.Set(name, Service().Choice(name));
+    }
+    settings.Set("media-kb", Service().large_media_kb());
+    // the switch for every site (P5.70); not in a backup
+    settings.Set("blocking",
+                 thoron_adblock::ProxyingURLLoaderFactory::BlockingEverywhere(
+                     SiteSettings()));
+    settings.Set("blocking-back", Service().BlockingBackAt());
+    settings.Set("accent", Service().accent());
+    settings.Set("theme",
+                 Service().theme().empty() ? std::string("auto") : Service().theme());
+    // for the troubleshooting information, as uBlock Origin's support page
+    settings.Set("version", std::string(version_info::GetVersionNumber()));
+    base::DictValue shortcuts;
+    for (const auto& [command, keys] : Service().shortcuts()) {
+      shortcuts.Set(command, keys);
+    }
+    settings.Set("shortcuts", std::move(shortcuts));
+    settings.Set("javascript", SiteSettings()->GetDefaultContentSetting(
+                                   ContentSettingsType::JAVASCRIPT) ==
+                                   CONTENT_SETTING_BLOCK);
+    settings.Set("prefetch",
+                 prefs->GetInteger(prefs::kNetworkPredictionOptions) ==
+                     static_cast<int>(
+                         prefetch::NetworkPredictionOptions::kDisabled));
+    settings.Set("hyperlink-auditing",
+                 !prefs->GetBoolean(prefs::kEnableHyperlinkAuditing));
+    // the policies that keep local addresses out (the browser's default here
+    // offers both public and private ones)
+    const std::string& webrtc = prefs->GetString(prefs::kWebRTCIPHandlingPolicy);
+    settings.Set("webrtc",
+                 webrtc == blink::kWebRTCIPHandlingDefaultPublicInterfaceOnly ||
+                     webrtc == blink::kWebRTCIPHandlingDisableNonProxiedUdp);
+    ResolveJavascriptCallback(base::Value(*id), settings);
+  }
+
+  // The switch for every site (P5.70): [id, on, minutes] (minutes: off for
+  // that long, -1 until the browser closes, 0 until switched on again).
+  void SetBlocking(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 2);
+    if (!id || !args[1].is_bool() || !args[2].is_int()) {
+      return;
+    }
+    Answer(*id, thoron_adblock::ProxyingURLLoaderFactory::SetBlockingEverywhere(
+                    SiteSettings(), args[1].GetBool(), args[2].GetInt())
+                    ? std::string()
+                    : std::string("This is not a choice."));
+  }
+
+  void SetSetting(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 2);
+    if (!id || !args[1].is_string()) {
+      return;
+    }
+    const std::string& name = args[1].GetString();
+    // "Block media elements larger than N kB": a whole number
+    if (name == "accent") {
+      Answer(*id, args[2].is_string() && Service().SetAccent(args[2].GetString())
+                      ? std::string()
+                      : std::string("This is not a colour."));
+      return;
+    }
+    if (thoron_adblock::EngineService::KnownChoiceName(name)) {
+      Answer(*id, args[2].is_string() &&
+                          Service().SetChoice(name, args[2].GetString())
+                      ? std::string()
+                      : std::string("This is not a choice."));
+      return;
+    }
+    if (name == "theme") {
+      Answer(*id, args[2].is_string() && Service().SetTheme(args[2].GetString())
+                      ? std::string()
+                      : std::string("This is not a theme."));
+      return;
+    }
+    if (name == "media-kb") {
+      Answer(*id, args[2].is_int() && Service().SetLargeMediaKb(args[2].GetInt())
+                      ? std::string()
+                      : std::string("Give a whole number of kB, from 1 to 1048576."));
+      return;
+    }
+    if (!args[2].is_bool()) {
+      return;
+    }
+    const bool on = args[2].GetBool();
+    PrefService* prefs = Profile::FromWebUI(web_ui())->GetPrefs();
+    if (thoron_adblock::EngineService::KnownOption(name)) {
+      Service().SetOption(name, on);
+    } else if (name == "javascript") {
+      SiteSettings()->SetDefaultContentSetting(
+          ContentSettingsType::JAVASCRIPT,
+          on ? CONTENT_SETTING_BLOCK : CONTENT_SETTING_DEFAULT);
+    } else if (name == "prefetch" || name == "hyperlink-auditing" ||
+               name == "webrtc") {
+      // on: the protective value; off: the browser's own default again
+      const char* pref = name == "prefetch" ? prefs::kNetworkPredictionOptions
+                         : name == "webrtc" ? prefs::kWebRTCIPHandlingPolicy
+                                            : prefs::kEnableHyperlinkAuditing;
+      if (!on) {
+        prefs->ClearPref(pref);
+      } else if (name == "prefetch") {
+        prefs->SetInteger(pref, static_cast<int>(
+                                    prefetch::NetworkPredictionOptions::kDisabled));
+      } else if (name == "webrtc") {
+        prefs->SetString(pref,
+                         blink::kWebRTCIPHandlingDefaultPublicInterfaceOnly);
+      } else {
+        prefs->SetBoolean(pref, false);
+      }
+    } else {
+      Answer(*id, "This is not a setting.");
+      return;
+    }
+    Answer(*id, std::string());
+  }
+
+  // Every open tab of this profile that has blocked requests, and the last
+  // of them. Kept in memory with each page; nothing is stored.
+  void GetLog(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 0);
+    if (!id) {
+      return;
+    }
+    thoron_adblock::BlockedCount::LoggerAsked();
+    Profile* profile = Profile::FromWebUI(web_ui());
+    base::ListValue tabs;
+    for (BrowserWindowInterface* browser : GetAllBrowserWindowInterfaces()) {
+      if (browser->GetProfile() != profile) {
+        continue;
+      }
+      TabStripModel* strip = browser->GetTabStripModel();
+      for (int i = 0; i < strip->count(); ++i) {
+        content::WebContents* tab = strip->GetWebContentsAt(i);
+        std::vector<thoron_adblock::BlockedCount::Entry> entries =
+            thoron_adblock::BlockedCount::Recent(tab->GetPrimaryPage());
+        if (entries.empty()) {
+          continue;
+        }
+        base::ListValue list;
+        const GURL& page = tab->GetLastCommittedURL();
+        for (const auto& entry : entries) {
+          // as uBlock Origin's logger marks them: to another site than the
+          // tab's (by registrable domain)
+          const bool third_party =
+              entry.type != "cosmetic" && entry.type != "scriptlet" &&
+              entry.type != "replace" &&
+              page.SchemeIsHTTPOrHTTPS() &&
+              !net::registry_controlled_domains::SameDomainOrHost(
+                  GURL(entry.url), page,
+                  net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+          list.Append(base::DictValue()
+                          .Set("time", entry.time.InMillisecondsFSinceUnixEpoch())
+                          .Set("url", entry.url)
+                          .Set("blocked", entry.blocked)
+                          .Set("type", entry.type)
+                          .Set("thirdParty", third_party));
+        }
+        tabs.Append(base::DictValue()
+                        .Set("id", sessions::SessionTabHelper::IdForTab(tab).id())
+                        .Set("title", base::UTF16ToUTF8(tab->GetTitle()))
+                        .Set("url", tab->GetLastCommittedURL().spec())
+                        .Set("entries", std::move(list)));
+      }
+    }
+    ResolveJavascriptCallback(base::Value(*id), tabs);
+  }
+
+  // My filters as an editor marks them: [id, text] -> the lines that are not
+  // filters this blocker can use.
+  void CheckFilters(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 1);
+    if (!id || !args[1].is_string()) {
+      return;
+    }
+    const std::string& text = args[1].GetString();
+    base::ListValue problems;
+    if (text.size() <= kMaxRulesLength && base::IsStringUTF8(text)) {
+      for (const rust::String& line :
+           thoron_adblock::filter_problems(rust::Str(text.data(), text.size()))) {
+        problems.Append(std::string(line));
+      }
+    }
+    ResolveJavascriptCallback(base::Value(*id), problems);
+  }
+
+  // uBlock Origin's keyboard shortcuts: [id, command, keys] ("" clears).
+  void SetShortcut(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 2);
+    if (!id || !args[1].is_string() || !args[2].is_string()) {
+      return;
+    }
+    Answer(*id, Service().SetShortcut(args[1].GetString(), args[2].GetString())
+                    ? std::string()
+                    : std::string("That cannot be a shortcut: use Ctrl or Alt "
+                                  "with a letter, a digit or F1 to F12."));
+  }
+
+  // "Allow custom filters requiring trust": [id, on].
+  void SetTrustMyFilters(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 1);
+    if (!id || !args[1].is_bool()) {
+      return;
+    }
+    Service().SetTrustMyFilters(args[1].GetBool(), Changed(*id));
+  }
+
+  // The logger's "Why?": [id, url, type, page]. Only web addresses, and a type
+  // as the lists name one (lower-case letters and "_"); another is "other".
+  void ExplainRequest(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 3);
+    if (!id || !args[1].is_string() || !args[2].is_string() ||
+        !args[3].is_string()) {
+      return;
+    }
+    const GURL url(args[1].GetString());
+    const GURL page(args[3].GetString());
+    std::string type = args[2].GetString();
+    if (type.empty() || type.size() > 24 ||
+        !std::all_of(type.begin(), type.end(),
+                     [](char c) { return (c >= 'a' && c <= 'z') || c == '_'; })) {
+      type = "other";
+    }
+    if (!url.is_valid() || !(url.SchemeIsHTTPOrHTTPS() || url.SchemeIsWSOrWSS())) {
+      ResolveJavascriptCallback(base::Value(*id), base::DictValue());
+      return;
+    }
+    Service().Explain(
+        url, page.SchemeIsHTTPOrHTTPS() ? page : GURL(), std::move(type),
+        base::BindOnce(&ThoronAdblockHandler::AnswerValue,
+                       weak_factory_.GetWeakPtr(), *id));
+  }
+
+  // The text of one list, as uBlock Origin shows a list when its name is
+  // clicked: [id, list id] -> the text, or null when no such list is in use.
+  void GetListText(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 1);
+    if (!id || !args[1].is_string()) {
+      return;
+    }
+    const std::string& list = args[1].GetString();
+    if (list.empty() || list.size() > 64 ||
+        !std::all_of(list.begin(), list.end(), [](char c) {
+          return (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-';
+        })) {
+      ResolveJavascriptCallback(base::Value(*id), base::Value());
+      return;
+    }
+    Service().ListText(list, base::BindOnce(&ThoronAdblockHandler::AnswerText,
+                                            weak_factory_.GetWeakPtr(), *id));
+  }
+
+  void AnswerText(const std::string& id, std::optional<std::string> text) {
+    // only text reaches the page
+    ResolveJavascriptCallback(base::Value(id),
+                              text && base::IsStringUTF8(*text)
+                                  ? base::Value(std::move(*text))
+                                  : base::Value());
+  }
+
+  void AnswerValue(const std::string& id, base::DictValue value) {
+    ResolveJavascriptCallback(base::Value(id), value);
+  }
+
+  void GetState(const base::ListValue& args) {
+    if (const std::string* id = AnswerId(args, 0)) {
+      Service().DescribeSettings(
+          base::BindOnce(&ThoronAdblockHandler::AnswerState,
+                         weak_factory_.GetWeakPtr(), *id));
+    }
+  }
+
+  void SetListEnabled(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 2);
+    if (!id || !args[1].is_string() || !args[2].is_bool()) {
+      return;
+    }
+    Service().SetListEnabled(args[1].GetString(), args[2].GetBool(),
+                             Changed(*id));
+  }
+
+  void AddList(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 1);
+    if (!id || !args[1].is_string()) {
+      return;
+    }
+    const std::string& address = args[1].GetString();
+    const GURL url(address);
+    if (address.size() > kMaxUrlLength || !url.is_valid()) {
+      Answer(*id, "This is not an address.");
+      return;
+    }
+    Service().AddList(url, Changed(*id));
+  }
+
+  void RemoveList(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 1);
+    if (!id || !args[1].is_string()) {
+      return;
+    }
+    Service().RemoveList(args[1].GetString(), Changed(*id));
+  }
+
+  void SetMyFilters(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 1);
+    if (!id || !args[1].is_string()) {
+      return;
+    }
+    if (args[1].GetString().size() > kMaxRulesLength) {
+      Answer(*id, "Your filters are larger than 1 MB.");
+      return;
+    }
+    Service().SetMyFilters(args[1].GetString(), Changed(*id));
+  }
+
+  void UpdateNow(const base::ListValue& args) {
+    if (const std::string* id = AnswerId(args, 0)) {
+      Service().UpdateNow(Changed(*id));
+    }
+  }
+
+  base::WeakPtrFactory<ThoronAdblockHandler> weak_factory_{this};
+};
+
+}  // namespace
+
+ThoronAdblockUIConfig::ThoronAdblockUIConfig()
+    : DefaultWebUIConfig(content::kChromeUIScheme,
+                         kThoronAdblockHost) {}
+
+bool ThoronAdblockUIConfig::IsWebUIEnabled(
+    content::BrowserContext* browser_context) {
+  return base::FeatureList::IsEnabled(thoron_adblock::kThoronNativeAdblock);
+}
+
+ThoronAdblockUI::ThoronAdblockUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  content::URLDataSource::Add(Profile::FromWebUI(web_ui),
+                              std::make_unique<ThoronAdblockDataSource>());
+  // the browser theme's colours for the page (chrome://theme/colors.css)
+  content::URLDataSource::Add(
+      Profile::FromWebUI(web_ui),
+      std::make_unique<ThemeSource>(Profile::FromWebUI(web_ui)));
+  web_ui->AddMessageHandler(std::make_unique<ThoronAdblockHandler>());
+}
+
+ThoronAdblockUI::~ThoronAdblockUI() = default;
