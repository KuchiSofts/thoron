+
+namespace thoron {
+
+namespace {
+
+// An icon in the middle of a larger image, and a count in the image's bottom
+// right corner (WithCountBadge).
+class BadgedIconSource : public gfx::CanvasImageSource {
+ public:
+  BadgedIconSource(const gfx::ImageSkia& icon,
+                   int area,
+                   const std::string& text,
+                   SkColor background,
+                   SkColor foreground)
+      : gfx::CanvasImageSource(gfx::Size(area, area)),
+        icon_(icon),
+        text_(base::UTF8ToUTF16(text)),
+        background_(background),
+        foreground_(foreground) {}
+
+  void Draw(gfx::Canvas* canvas) override {
+    const int area = size().width();
+    canvas->DrawImageInt(icon_, (area - icon_.width()) / 2,
+                         (area - icon_.height()) / 2);
+    if (text_.empty()) {
+      return;
+    }
+    // as an extension's badge
+    constexpr int height = 14;
+    const gfx::FontList font = views::TypographyProvider::Get().GetFont(
+        views::style::CONTEXT_BADGE, views::style::STYLE_SECONDARY);
+    constexpr int kPadding = 2;
+    const int text_width =
+        std::min(area - 2 * kPadding, gfx::Canvas::GetStringWidth(text_, font));
+    const int width = std::max(height, text_width + 2 * kPadding);
+    const gfx::Rect badge(area - width, area - height, width, height);
+    constexpr int radius = 4;
+
+    cc::PaintFlags fill;
+    fill.setAntiAlias(true);
+    fill.setStyle(cc::PaintFlags::kFill_Style);
+    fill.setColor(background_);
+    // the icon is cleared a little around the count, as around an extension's
+    cc::PaintFlags clear = fill;
+    clear.setBlendMode(SkBlendMode::kClear);
+    gfx::Rect ring = badge;
+    ring.Inset(-1);
+    canvas->DrawRoundRect(ring, radius + 1, clear);
+    canvas->DrawRoundRect(badge, radius, fill);
+
+    gfx::Rect text_rect = badge;
+    const int top = (height - font.GetHeight()) / 2;
+    const int left = (width - text_width) / 2;
+    text_rect.Inset(gfx::Insets::TLBR(top, left,
+                                      (height - font.GetHeight()) - top,
+                                      (width - text_width) - left));
+    std::unique_ptr<gfx::RenderText> text = gfx::RenderText::CreateRenderText();
+    text->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+    text->SetCursorEnabled(false);
+    text->SetFontList(font);
+    text->SetColor(foreground_);
+    text->SetText(text_);
+    text->SetDisplayRect(text_rect);
+    text->Draw(canvas);
+  }
+
+ private:
+  const gfx::ImageSkia icon_;
+  const std::u16string text_;
+  const SkColor background_;
+  const SkColor foreground_;
+};
+
+gfx::FontList CountFont() {
+  return views::TypographyProvider::Get()
+      .GetFont(views::style::CONTEXT_BADGE, views::style::STYLE_SECONDARY)
+      .DeriveWithWeight(gfx::Font::Weight::MEDIUM);
+}
+
+// An icon and a count right of it (WithCountBeside).
+class IconWithCountSource : public gfx::CanvasImageSource {
+ public:
+  static constexpr int kGap = 3;
+
+  IconWithCountSource(const gfx::ImageSkia& icon,
+                      const std::u16string& text,
+                      int text_width,
+                      SkColor color)
+      : gfx::CanvasImageSource(
+            gfx::Size(icon.width() + kGap + text_width, icon.height())),
+        icon_(icon),
+        text_(text),
+        text_width_(text_width),
+        color_(color) {}
+
+  void Draw(gfx::Canvas* canvas) override {
+    canvas->DrawImageInt(icon_, 0, 0);
+    const gfx::FontList font = CountFont();
+    std::unique_ptr<gfx::RenderText> text = gfx::RenderText::CreateRenderText();
+    text->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    text->SetCursorEnabled(false);
+    text->SetFontList(font);
+    text->SetColor(color_);
+    text->SetText(text_);
+    text->SetDisplayRect(gfx::Rect(icon_.width() + kGap,
+                                   (icon_.height() - font.GetHeight()) / 2,
+                                   text_width_, font.GetHeight()));
+    text->Draw(canvas);
+  }
+
+ private:
+  const gfx::ImageSkia icon_;
+  const std::u16string text_;
+  const int text_width_;
+  const SkColor color_;
+};
+
+// One of Thoron's buttons in a toolbar: which, and where its setting puts it.
+struct Item {
+  raw_ptr<views::View> view;
+  std::string id;
+  std::string where;
+};
+
+std::vector<Item> ItemsOf(ToolbarView* toolbar, PrefService** prefs) {
+  std::vector<Item> items;
+  for (views::View* child : toolbar->children()) {
+    if (auto* shield = views::AsViewClass<ThoronAdblockButton>(child)) {
+      items.push_back({shield, kAdblockId,
+                       thoron_adblock::EngineService::Get().Choice(
+                           "toolbar-position")});
+      if (prefs) {
+        *prefs = shield->prefs();
+      }
+    } else if (auto* mail = views::AsViewClass<ThoronMailButton>(child)) {
+      items.push_back({mail, kMailId, mail->toolbar_position()});
+      if (prefs) {
+        *prefs = mail->prefs();
+      }
+    }
+  }
+  return items;
+}
+
+// The toolbar has no getters for its extensions and its menu: they are found
+// by their kind.
+views::View* ChildNamed(ToolbarView* toolbar, std::string_view name) {
+  for (views::View* child : toolbar->children()) {
+    if (child->GetClassName() == name) {
+      return child;
+    }
+  }
+  return nullptr;
+}
+
+views::View* Extensions(ToolbarView* toolbar) {
+  return ChildNamed(toolbar, "ExtensionsToolbarDesktop");
+}
+
+views::View* Menu(ToolbarView* toolbar) {
+  return ChildNamed(toolbar, "BrowserAppMenuButton");
+}
+
+// Moves `view` right after `anchor` (or right before it). True when it moved.
+bool MoveNextTo(ToolbarView* toolbar,
+                views::View* view,
+                views::View* anchor,
+                bool after) {
+  const std::optional<size_t> mine = toolbar->GetIndexOf(view);
+  const std::optional<size_t> index = toolbar->GetIndexOf(anchor);
+  if (!mine || !index || view == anchor) {
+    return false;
+  }
+  // the view's own place is taken out first
+  size_t target = *index;
+  if (*mine < target) {
+    --target;
+  }
+  if (after) {
+    ++target;
+  }
+  if (target == *mine) {
+    return false;
+  }
+  toolbar->ReorderChildView(view, target);
+  return true;
+}
+
+size_t RankOf(const std::vector<std::string>& order, const std::string& id) {
+  return std::find(order.begin(), order.end(), id) - order.begin();
+}
+
+}  // namespace
+
+IconColors ColorsOf(const ui::ColorProvider* provider) {
+  // A count is in the theme's plainest strong pair, so it reads on the shield
+  // (filled with the accent) and on the envelope alike.
+  return {provider->GetColor(ui::kColorSysPrimary),
+          provider->GetColor(ui::kColorSysOnPrimary),
+          provider->GetColor(ui::kColorSysOnSurface),
+          provider->GetColor(ui::kColorSysSurface)};
+}
+
+gfx::ImageSkia WithCountBadge(const gfx::ImageSkia& icon,
+                              int area,
+                              const std::string& text,
+                              SkColor background,
+                              SkColor foreground) {
+  if (text.empty() && area == icon.width()) {
+    return icon;
+  }
+  return gfx::ImageSkia(std::make_unique<BadgedIconSource>(icon, area, text,
+                                                           background,
+                                                           foreground),
+                        gfx::Size(area, area));
+}
+
+gfx::ImageSkia WithCountBeside(const gfx::ImageSkia& icon,
+                               const std::string& text,
+                               SkColor color) {
+  if (text.empty()) {
+    return icon;
+  }
+  const std::u16string count = base::UTF8ToUTF16(text);
+  const int text_width = gfx::Canvas::GetStringWidth(count, CountFont());
+  return gfx::ImageSkia(
+      std::make_unique<IconWithCountSource>(icon, count, text_width, color),
+      gfx::Size(icon.width() + IconWithCountSource::kGap + text_width,
+                icon.height()));
+}
+
+std::vector<std::string> ToolbarOrder(const PrefService* prefs) {
+  std::vector<std::string> order;
+  if (prefs) {
+    for (const std::string& id :
+         base::SplitString(prefs->GetString(kToolbarOrderPref), ",",
+                           base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+      if ((id == kAdblockId || id == kMailId) &&
+          std::find(order.begin(), order.end(), id) == order.end()) {
+        order.push_back(id);
+      }
+    }
+  }
+  // unless a person chose: the envelope, then the shield
+  for (const char* id : {kMailId, kAdblockId}) {
+    if (std::find(order.begin(), order.end(), id) == order.end()) {
+      order.push_back(id);
+    }
+  }
+  return order;
+}
+
+void SetToolbarOrder(PrefService* prefs,
+                     const std::vector<std::string>& order) {
+  if (prefs) {
+    prefs->SetString(kToolbarOrderPref, base::JoinString(order, ","));
+  }
+}
+
+bool MailBeforeAdblock(const PrefService* prefs) {
+  const std::vector<std::string> order = ToolbarOrder(prefs);
+  return RankOf(order, kMailId) < RankOf(order, kAdblockId);
+}
+
+void ArrangeToolbar(ToolbarView* toolbar) {
+  if (!toolbar) {
+    return;
+  }
+  PrefService* prefs = nullptr;
+  std::vector<Item> items = ItemsOf(toolbar, &prefs);
+  const std::vector<std::string> order = ToolbarOrder(prefs);
+  std::sort(items.begin(), items.end(), [&order](const Item& a, const Item& b) {
+    return RankOf(order, a.id) < RankOf(order, b.id);
+  });
+  views::View* const address = toolbar->location_bar_view();
+  views::View* const extensions = Extensions(toolbar);
+  views::View* const menu = Menu(toolbar);
+  // Right after the address bar and after the extensions, each goes right
+  // after the one before it; next to the menu, each right before the menu.
+  views::View* after_address = address;
+  views::View* after_extensions = extensions;
+  bool moved = false;
+  for (const Item& item : items) {
+    if (item.where == "menu" && menu) {
+      moved |= MoveNextTo(toolbar, item.view, menu, /*after=*/false);
+      continue;
+    }
+    views::View*& previous = item.where == "extensions" && extensions
+                                 ? after_extensions
+                                 : after_address;
+    if (!previous || previous->parent() != toolbar) {
+      continue;
+    }
+    moved |= MoveNextTo(toolbar, item.view, previous, /*after=*/true);
+    previous = item.view;
+  }
+  if (moved) {
+    toolbar->InvalidateLayout();
+  }
+}
+
+ToolbarDrag::ToolbarDrag(views::View* button,
+                         const char* id,
+                         PrefService* prefs,
+                         GetPlace get_place,
+                         SetPlace set_place)
+    : button_(button),
+      id_(id),
+      prefs_(prefs),
+      get_place_(std::move(get_place)),
+      set_place_(std::move(set_place)) {}
+
+ToolbarDrag::~ToolbarDrag() = default;
+
+void ToolbarDrag::Pressed(const ui::MouseEvent& event) {
+  pressed_ = event.IsOnlyLeftMouseButton();
+  dragging_ = false;
+  start_ = event.location();
+}
+
+bool ToolbarDrag::Dragged(const ui::MouseEvent& event) {
+  if (!pressed_) {
+    return false;
+  }
+  if (!dragging_) {
+    if (!views::View::ExceededDragThreshold(event.location() - start_)) {
+      return false;
+    }
+    dragging_ = true;
+  }
+  Place(event);
+  return true;
+}
+
+bool ToolbarDrag::Ended() {
+  const bool was_drag = dragging_;
+  pressed_ = false;
+  dragging_ = false;
+  return was_drag;
+}
+
+void ToolbarDrag::Place(const ui::MouseEvent& event) {
+  ToolbarView* toolbar = views::AsViewClass<ToolbarView>(button_->parent());
+  if (!toolbar) {
+    return;
+  }
+  gfx::Point pointer = event.location();
+  views::View::ConvertPointToTarget(button_, toolbar, &pointer);
+  const int x = pointer.x();
+  const int width = button_->width();
+  // Where a view is when this button is somewhere right of it (the address
+  // bar takes up the room a button leaves): the same wherever the button is
+  // now, so the answer does not change as the button moves.
+  auto left_of = [this, width](const views::View* view) {
+    return view->x() - (view->x() > button_->x() ? width : 0);
+  };
+  std::vector<Item> others = ItemsOf(toolbar, nullptr);
+  std::erase_if(others, [this](const Item& item) {
+    return item.view == button_ || !item.view->GetVisible();
+  });
+
+  // The three places, each from where its first button would be to the end of
+  // Thoron's buttons there.
+  struct Slot {
+    const char* where;
+    int left;
+    int right;
+  };
+  std::vector<Slot> slots;
+  auto add_slot = [&](const char* where, int left) {
+    int right = left + width;
+    for (const Item& other : others) {
+      if (other.where == where) {
+        right += other.view->width();
+      }
+    }
+    slots.push_back({where, left, right});
+  };
+  views::View* const address = toolbar->location_bar_view();
+  const int address_end = address ? left_of(address) + address->width() : 0;
+  if (address) {
+    add_slot("address", address_end);
+  }
+  if (views::View* extensions = Extensions(toolbar)) {
+    if (extensions->GetVisible()) {
+      add_slot("extensions", left_of(extensions) + extensions->width());
+    } else {
+      // No extension is shown: "after the extensions" is right after what is
+      // right after the address bar.
+      int left = address_end;
+      for (const Item& other : others) {
+        if (other.where == "address") {
+          left += other.view->width();
+        }
+      }
+      add_slot("extensions", left);
+    }
+  }
+  if (views::View* menu = Menu(toolbar)) {
+    // the menu stays where it is: Thoron's buttons end at it
+    int left = menu->x() - width;
+    for (const Item& other : others) {
+      if (other.where == "menu") {
+        left -= other.view->width();
+      }
+    }
+    add_slot("menu", left);
+  }
+  if (slots.empty()) {
+    return;
+  }
+  const std::string current = get_place_.Run();
+  auto distance = [x](const Slot& slot) {
+    return x < slot.left ? slot.left - x : (x > slot.right ? x - slot.right : 0);
+  };
+  const Slot* nearest = nullptr;
+  for (const Slot& slot : slots) {
+    // of two as near, the one the button is in: it does not flicker
+    if (!nearest || distance(slot) < distance(*nearest) ||
+        (distance(slot) == distance(*nearest) && current == slot.where)) {
+      nearest = &slot;
+    }
+  }
+  const std::string where = nearest->where;
+
+  // Before or after Thoron's other buttons there: before the first whose
+  // middle (as it is shown now) is right of the pointer. The pointer has to
+  // pass a button's middle to change places with it, so nothing flickers.
+  std::vector<std::string> order = ToolbarOrder(prefs_);
+  const std::vector<std::string> before = order;
+  std::vector<const Item*> there;
+  for (const Item& other : others) {
+    if (other.where == where) {
+      there.push_back(&other);
+    }
+  }
+  if (!there.empty()) {
+    std::sort(there.begin(), there.end(), [](const Item* a, const Item* b) {
+      return a->view->x() < b->view->x();
+    });
+    std::erase(order, id_);
+    auto at = order.end();
+    for (const Item* other : there) {
+      at = std::find(order.begin(), order.end(), other->id);
+      if (x < other->view->x() + other->view->width() / 2) {
+        break;
+      }
+      at = at == order.end() ? at : at + 1;
+    }
+    order.insert(at, id_);
+  }
+
+  if (order != before) {
+    SetToolbarOrder(prefs_, order);
+  }
+  if (where != current) {
+    set_place_.Run(where);
+  }
+  if (order != before || where != current) {
+    ArrangeToolbar(toolbar);
+  }
+}
+
+}  // namespace thoron
