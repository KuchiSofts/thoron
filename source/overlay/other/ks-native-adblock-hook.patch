+  void GetListText(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 1);
+    if (!id || !args[1].is_string()) {
+      return;
+    }
+    const std::string& list = args[1].GetString();
+    if (list.empty() || list.size() > 64 ||
+        !std::all_of(list.begin(), list.end(), [](char c) {
+          return (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-';
+        })) {
+      ResolveJavascriptCallback(base::Value(*id), base::Value());
+      return;
+    }
+    Service().ListText(list, base::BindOnce(&ThoronAdblockHandler::AnswerText,
+                                            weak_factory_.GetWeakPtr(), *id));
+  }
