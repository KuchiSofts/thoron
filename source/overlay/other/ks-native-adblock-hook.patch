+  // The Settings section: the blocker's options, and the browser settings
+  // uBlock Origin offers there (each "true" means the protective choice).
+  void GetSettings(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 0);
+    if (!id) {
+      return;
+    }
+    PrefService* prefs = Profile::FromWebUI(web_ui())->GetPrefs();
+    base::DictValue settings;
+    for (const char* name :
+         {"badge", "block-csp-reports", "cname-uncloak", "ignore-generic",
+          "default-media",
+          "default-cosmetic", "default-fonts", "default-3p-script",
+          "default-3p-frame", "auto-update", "context-menu", "advanced",
+          "colorblind", "no-tooltips", "toolbar-shield", "address-shield"}) {
+      settings.Set(name, Service().Option(name));
+    }
+    // where the shields are (P5.73)
+    for (const char* name : {"toolbar-position", "address-position"}) {
+      settings.Set(name, Service().Choice(name));
+    }
+    settings.Set("media-kb", Service().large_media_kb());
+    // the switch for every site (P5.70); not in a backup
+    settings.Set("blocking",
+                 thoron_adblock::ProxyingURLLoaderFactory::BlockingEverywhere(
+                     SiteSettings()));
+    settings.Set("blocking-back", Service().BlockingBackAt());
+    settings.Set("accent", Service().accent());
+    settings.Set("theme",
+                 Service().theme().empty() ? std::string("auto") : Service().theme());
+    // for the troubleshooting information, as uBlock Origin's support page
+    settings.Set("version", std::string(version_info::GetVersionNumber()));
+    base::DictValue shortcuts;
+    for (const auto& [command, keys] : Service().shortcuts()) {
+      shortcuts.Set(command, keys);
+    }
+    settings.Set("shortcuts", std::move(shortcuts));
+    settings.Set("javascript", SiteSettings()->GetDefaultContentSetting(
+                                   ContentSettingsType::JAVASCRIPT) ==
+                                   CONTENT_SETTING_BLOCK);
+    settings.Set("prefetch",
+                 prefs->GetInteger(prefs::kNetworkPredictionOptions) ==
+                     static_cast<int>(
+                         prefetch::NetworkPredictionOptions::kDisabled));
+    settings.Set("hyperlink-auditing",
+                 !prefs->GetBoolean(prefs::kEnableHyperlinkAuditing));
+    // the policies that keep local addresses out (the browser's default here
+    // offers both public and private ones)
+    const std::string& webrtc = prefs->GetString(prefs::kWebRTCIPHandlingPolicy);
+    settings.Set("webrtc",
+                 webrtc == blink::kWebRTCIPHandlingDefaultPublicInterfaceOnly ||
+                     webrtc == blink::kWebRTCIPHandlingDisableNonProxiedUdp);
+    ResolveJavascriptCallback(base::Value(*id), settings);
+  }
