+constexpr char kNotifyPref[] = "thoron_mail.notify";
+constexpr char kIntervalPref[] = "thoron_mail.interval_minutes";
+// P5.76: the named settings (one pref each, "thoron_mail.<name>"), when each
+// account was last looked at (ms since 1970, by address), and the accounts
+// not watched.
+constexpr char kLookedPref[] = "thoron_mail.looked";
+constexpr char kIgnoredPref[] = "thoron_mail.ignored";
+// the most accounts remembered as looked at: a few more than are ever shown
+constexpr size_t kMostLooked = 50;
+
+struct ChoiceValues {
+  const char* name;
+  const char* values[3];
+};
+constexpr ChoiceValues kChoices[] = {
+    {"sound", {"on", "off", nullptr}},
+    {"count", {"new", "unread", nullptr}},
+    {"open", {"reuse", "new", nullptr}},
+    {"place", {"toolbar", "address", "both"}},
+    {"toolbar-position", {"extensions", "address", "menu"}},
+    {"address-position", {"icons", "start", "end"}},
+};
+
+const ChoiceValues* FindChoice(const std::string& name) {
+  for (const ChoiceValues& choice : kChoices) {
+    if (name == choice.name) {
+      return &choice;
+    }
+  }
+  return nullptr;
+}
+// The first look comes after the browser has started and opened its pages.
+constexpr base::TimeDelta kFirstLook = base::Seconds(15);
+constexpr base::TimeDelta kTimeout = base::Seconds(20);
+// A feed is small (20 messages at most); anything far larger is not one.
+constexpr size_t kMostBytes = 512 * 1024;
+// Tests: Gmail's address is replaced by a local server's ("http://127.0.0.1:port/").
+constexpr char kFeedsForTesting[] = "thoron-mail-feeds-for-testing";
