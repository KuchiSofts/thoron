+#ifndef COMPONENTS_THORON_UPDATE_MANIFEST_H_
+#define COMPONENTS_THORON_UPDATE_MANIFEST_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <array>
+#include <compare>
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+// The update manifest, schema 1 (ROADMAP P3.3): what a copy of Thoron makes of
+// the two files a release publishes, update.json and update.json.sig.
+//
+// The format, the order of the checks and the reason for each are in
+// docs/update/MANIFEST.md of Thoron's repository. tools/update/manifest.py
+// there is the reference: CheckUpdate() gives the answer its check_update()
+// gives, for every input.
+//
+// Nothing here touches the network or a file. The caller fetches the two
+// files, keeps the highest serial it has accepted, and acts on the decision.
+
+namespace thoron_update {
+
+// update.json is 1 to 262144 bytes. Whoever fetches it reads at most one byte
+// more: a file that long is too long.
+inline constexpr size_t kMaxManifestBytes = 256 * 1024;
+// update.json.sig is exactly the 64 bytes of the Ed25519 signature.
+inline constexpr size_t kSignatureBytes = 64;
+inline constexpr size_t kPublicKeyBytes = 32;
+// How far a copy's clock may be off, either way.
+inline constexpr int64_t kClockSkewSeconds = 24 * 60 * 60;
+
+// A build version: four numbers of 0 to 65535, as 158.0.8127.4500. It decides
+// what is newer. All zero stands for "nothing installed" (the installer).
+struct BuildVersion {
+  std::array<uint16_t, 4> parts = {};
+
+  friend constexpr auto operator<=>(const BuildVersion&,
+                                    const BuildVersion&) = default;
+};
+
+// The build version written as `text`. Only its one written form is taken:
+// four numbers joined by '.', ASCII digits, no leading zeros.
+std::optional<BuildVersion> ParseBuildVersion(std::string_view text);
+std::string ToString(const BuildVersion& version);
+
+// What a package is built for. The names are the keys of the manifest.
+enum class Variant {
+  kWinX64Avx2,       // win-x64-avx2
+  kWinX64Sse4,       // win-x64-sse4
+  kWinArm64Armv8,    // win-arm64-armv8
+  kLinuxX64Avx2,     // linux-x64-avx2
+  kLinuxX64Sse4,     // linux-x64-sse4
+  kLinuxArm64Armv8,  // linux-arm64-armv8
+  // Opt-in (ROADMAP P5.11): in the schema from the start, since a reader
+  // refuses a variant it does not know. VariantsFor() never offers them.
+  kWinX64Avx512,     // win-x64-avx512
+  kLinuxX64Avx512,   // linux-x64-avx512
+};
+
+// How a copy is installed.
+enum class Kind {
+  kInstalled,  // installed
+  kPortable,   // portable
+};
+
+std::string_view VariantName(Variant variant);
+std::string_view KindName(Kind kind);
+std::optional<Variant> ParseVariant(std::string_view name);
+std::optional<Kind> ParseKind(std::string_view name);
+
+// One file to download. It is used only after its length is `size` and its
+// SHA-256 is `sha256`; the host it came from proves nothing.
+struct PackageFile {
+  std::string url;     // https://<an allowed host>/<path>, at most 1024 long
+  int64_t size = 0;    // in bytes, 1 to 2147483647
+  std::string sha256;  // 64 characters of 0-9a-f
+
+  friend bool operator==(const PackageFile&, const PackageFile&) = default;
+};
+
+struct Package {
+  PackageFile full;
+  // At most 8. Each turns exactly the version it is keyed by into the
+  // manifest's version.
+  std::map<BuildVersion, PackageFile> deltas;
+};
+
+// The content of a manifest that passed every rule of the schema.
+struct Manifest {
+  std::string channel;
+  int64_t serial = 0;
+  int64_t published = 0;  // seconds since 1970, UTC
+  int64_t expires = 0;    // seconds since 1970, UTC
+  BuildVersion version;
+  std::string thoron_version;  // Thoron's own version, for people: 0.1.2
+  BuildVersion chromium_version;
+  bool critical = false;  // a security release that should not wait
+  BuildVersion min_updater_version;
+  std::map<std::pair<Variant, Kind>, Package> packages;
+};
+
+// The outcomes of MANIFEST.md (section 7), and one more for a caller's mistake.
+enum class Outcome {
+  // A newer release with a package for this copy.
+  kUpdate,
+  // The channel's current manifest names the installed version. The only
+  // outcome ever shown as "up to date".
+  kUpToDate,
+  // The signature does not hold, or there is no usable key. Nothing was read.
+  kBadSignature,
+  // Not a schema 1 manifest: empty, too long, or signed and still against the
+  // schema or its one written form.
+  kMalformed,
+  // A manifest of another channel.
+  kWrongChannel,
+  // Older than a manifest this copy has already accepted.
+  kReplayed,
+  // Dated after the clock: the clock is behind, or the manifest is wrong.
+  kNotYetValid,
+  // Too old to show what the newest release is.
+  kExpired,
+  // Names a version below the installed one. Nothing older is ever installed.
+  kDowngrade,
+  // A newer release that this updater may not apply.
+  kUpdaterTooOld,
+  // A newer release with nothing for this variant and kind.
+  kNoPackage,
+  // What the caller said about its own copy makes no sense (CopyInfo). The two
+  // files were not looked at. The reference raises an error here.
+  kInvalidCopy,
+};
+
+// The outcome's name in MANIFEST.md and in the reference, for a log.
+std::string_view OutcomeName(Outcome outcome);
+
+// True for the outcomes after which the updater does not know whether this
+// copy is current, kBadSignature to kDowngrade: the "cannot verify updates"
+// state. None of them is ever shown as "up to date".
+bool CannotVerify(Outcome outcome);
+
+// What a copy knows without the manifest. None of it comes from the network.
+struct CopyInfo {
+  // The key manifests are signed with. All zero, or another point of small
+  // order, is no key: every check then ends in kBadSignature.
+  std::array<uint8_t, kPublicKeyBytes> public_key = {};
+  // The hosts packages may be downloaded from, each as a whole name in lower
+  // case, such as github.com. At least one.
+  std::vector<std::string> allowed_hosts;
+  std::string channel;     // the channel this copy follows, such as stable
+  BuildVersion installed;  // all zero for the installer
+  BuildVersion updater;    // the build the updater itself came with
+  Variant variant = Variant::kWinX64Avx2;
+  Kind kind = Kind::kInstalled;
+  // The highest serial this copy has accepted on the channel; 0 for none.
+  int64_t last_serial = 0;
+};
+
+struct Decision {
+  Outcome outcome = Outcome::kInvalidCopy;
+  // The content of the manifest, only when it is the channel's current word:
+  // with kUpdate, kUpToDate, kDowngrade, kUpdaterTooOld and kNoPackage.
+  std::optional<Manifest> manifest;
+  // With the same five outcomes: the serial to store as the highest accepted
+  // on the channel. The stored serial only goes up.
+  std::optional<int64_t> remember_serial;
+  // With kUpdate: the whole package, and the delta that applies from exactly
+  // the installed version when the manifest has one. With kUpdaterTooOld, when
+  // the release has a package for this copy: the whole package only, so that
+  // the old updater fetches it and the updater inside it applies it (P4.6); an
+  // updater that is too old never applies a delta.
+  std::optional<PackageFile> full;
+  std::optional<PackageFile> delta;
+};
+
+// The whole check, from the two files as fetched to a decision. `now` is the
+// clock in seconds since 1970 (UTC).
+//
+// The signature is checked over the exact bytes of `manifest` before any of
+// them is read as data, and what is read is that same buffer. Whatever the two
+// files hold is an outcome.
+Decision CheckUpdate(std::string_view manifest,
+                     std::string_view signature,
+                     const CopyInfo& copy,
+                     int64_t now);
+
+// --- Key rotation (ROADMAP P4.7) ---------------------------------------------
+//
+// A copy trusts the key it was built with. A release that moves to a new key
+// publishes a key statement beside the manifest (update.key): the new public key
+// (32 bytes) and the signature (64 bytes) of a key the copy trusts over the
+// prefix "thoron-update-key-v1" and LF, then the new key. A copy that trusts the
+// signing key then trusts the new one too, and keeps it. A statement no trusted
+// key signed is ignored. tools/update/manifest.py is the reference here too.
+
+inline constexpr size_t kKeyStatementBytes = 96;
+inline constexpr size_t kMostKeyStatements = 8;
+using PublicKey = std::array<uint8_t, kPublicKeyBytes>;
+
+// The key `statement` introduces, when it is a statement and one of `trusted`
+// signed it. No key (all zero, a point of small order) is never introduced.
+std::optional<PublicKey> KeyFromStatement(std::string_view statement,
+                                          const std::vector<PublicKey>& trusted);
+
+// The keys a copy trusts: `built_in`, and every key a chain of `statements`
+// leads to from it, in the order they were reached. At most
+// kMostKeyStatements statements are read.
+std::vector<PublicKey> TrustedKeys(const PublicKey& built_in,
+                                   const std::vector<std::string>& statements);
+
+// CheckUpdate() under each of `keys` in turn (copy.public_key is not used): the
+// first decision that is not kBadSignature, else that one.
+Decision CheckUpdateWithKeys(std::string_view manifest,
+                             std::string_view signature,
+                             CopyInfo copy,
+                             const std::vector<PublicKey>& keys,
+                             int64_t now);
+
+}  // namespace thoron_update
