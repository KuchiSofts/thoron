@@ -0,0 +1,553 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_portable_key/reencrypt_linux.h"
+
+#include <algorithm>
+#include <array>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/files/file.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/function_ref.h"
+#include "base/strings/cstring_view.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/string_view_util.h"
+#include "components/thoron_portable_key/secret_bytes.h"
+#include "crypto/aead.h"
+#include "crypto/aes_cbc.h"
+#include "crypto/hash.h"
+#include "crypto/random.h"
+#include "sql/database.h"
+#include "sql/statement.h"
+#include "sql/transaction.h"
+
+namespace thoron_portable_key {
+
+namespace {
+
+constexpr size_t kTagSize = 3;
+constexpr size_t kNonceSize = 12;
+constexpr char kBackupSuffix[] = ".thoron-before-lock";
+constexpr char kWithoutKeySuffix[] = ".thoron-without-key";
+inline constexpr sql::Database::Tag kDatabaseTag{"ThoronPortableKey"};
+// Chromium's Linux values ("v10", "v11"): AES-128-CBC with sixteen spaces as the
+// IV (components/os_crypt/async/browser/posix_key_provider.cc).
+constexpr std::array<uint8_t, 16> kChromiumIv = {' ', ' ', ' ', ' ', ' ', ' ', ' ', ' ',
+                                                 ' ', ' ', ' ', ' ', ' ', ' ', ' ', ' '};
+
+// The tables and columns Chromium keeps encrypted values in, by database.
+enum class Kind {
+  kPassword,  // a saved password or a password's note
+  kCookie,    // a cookie's value
+  kOther,     // a card number, an IBAN, a stored CVC, a sign-in token, an
+              // Autofill AI value
+};
+
+struct Column {
+  const char* table;
+  const char* column;
+  Kind kind;
+};
+
+struct Place {
+  base::FilePath::StringViewType file;  // relative to the profile folder
+  std::vector<Column> columns;
+};
+
+std::vector<Place> Places() {
+  const std::vector<Column> logins = {{"logins", "password_value", Kind::kPassword},
+                                      {"password_notes", "value", Kind::kPassword}};
+  const std::vector<Column> cookies = {{"cookies", "encrypted_value", Kind::kCookie}};
+  // Web Data's encrypted values that are a person's own (components/autofill
+  // payments_autofill_table.cc and autofill_ai/entity_table.cc, components/
+  // signin token_service_table.cc).
+  const std::vector<Column> web_data = {{"credit_cards", "card_number_encrypted", Kind::kOther},
+                                        {"local_ibans", "value_encrypted", Kind::kOther},
+                                        {"local_stored_cvc", "value_encrypted", Kind::kOther},
+                                        {"server_stored_cvc", "value_encrypted", Kind::kOther},
+                                        {"token_service", "encrypted_token", Kind::kOther},
+                                        {"autofill_ai_attributes", "value_encrypted", Kind::kOther}};
+  return {{FILE_PATH_LITERAL("Login Data"), logins},
+          {FILE_PATH_LITERAL("Login Data For Account"), logins},
+          {FILE_PATH_LITERAL("Network/Cookies"), cookies},
+          {FILE_PATH_LITERAL("Cookies"), cookies},
+          {FILE_PATH_LITERAL("Web Data"), web_data},
+          {FILE_PATH_LITERAL("Account Web Data"), web_data}};
+}
+
+// Chromium's cookie database from version 24 on starts each cookie's plain text
+// with the SHA-256 of its host (net/extras/sqlite/sqlite_persistent_cookie_store.cc).
+constexpr int kCookieHashVersion = 24;
+
+// Whether a value read with an old key is what such a column holds. "v11" has
+// no tag: read with another PC's keyring key, about one value in 256 still
+// decrypts, to bytes that would be encrypted again as if they were the value
+// and the value lost. A cookie must start with its host's hash; everything
+// else Chromium keeps there is text (UTF-8).
+bool Plausible(Kind kind, std::string_view plain, std::string_view host, bool hashed_cookies) {
+  if (kind == Kind::kCookie && hashed_cookies) {
+    const std::array<uint8_t, crypto::hash::kSha256Size> hash =
+        crypto::hash::Sha256(base::as_byte_span(host));
+    return plain.size() >= hash.size() && plain.substr(0, hash.size()) == base::as_string_view(hash);
+  }
+  return base::IsStringUTF8(plain);
+}
+
+// The cookie database's version (meta table), or 0.
+int CookieVersion(sql::Database& db) {
+  if (!db.DoesTableExist("meta")) {
+    return 0;
+  }
+  sql::Statement version(db.GetUniqueStatement("SELECT value FROM meta WHERE key = 'version'"));
+  int number = 0;
+  if (version.Step() && base::StringToInt(version.ColumnString(0), &number)) {
+    return number;
+  }
+  return 0;
+}
+
+// The SELECT of a column's values: the row, the value and, for a cookie, its host.
+std::string SelectOf(const Column& column) {
+  return std::string("SELECT rowid, ") + column.column +
+         (column.kind == Kind::kCookie ? ", host_key" : "") + " FROM " + column.table;
+}
+
+bool HasColumn(sql::Database& db, const Column& column) {
+  return db.DoesTableExist(base::cstring_view(column.table)) &&
+         db.DoesColumnExist(base::cstring_view(column.table), base::cstring_view(column.column)) &&
+         (column.kind != Kind::kCookie ||
+          db.DoesColumnExist(base::cstring_view(column.table), "host_key"));
+}
+
+std::optional<std::array<uint8_t, crypto::hash::kSha256Size>> HashOf(const base::FilePath& file) {
+  std::optional<std::vector<uint8_t>> bytes = base::ReadFileToBytes(file);
+  if (!bytes) {
+    return std::nullopt;
+  }
+  return crypto::hash::Sha256(*bytes);
+}
+
+// Writes the database's last changes into the file itself (a browser that
+// ended cleanly leaves none), so the file alone is the whole database.
+bool Checkpoint(const base::FilePath& file) {
+  sql::Database db(sql::DatabaseOptions(), kDatabaseTag);
+  if (!db.Open(file)) {
+    return false;
+  }
+  const bool done = db.Execute("PRAGMA wal_checkpoint(TRUNCATE)");
+  db.Close();
+  return done;
+}
+
+// A file that held values the old keys open (a copy, SQLite's journal): its
+// bytes are overwritten with zeros before it is deleted, so its blocks on the
+// drive no longer hold them (a flash drive may still keep older blocks of its
+// own; docs/security/THREAT_MODEL.md, E11).
+void WipeAndDelete(const base::FilePath& path) {
+  {
+    base::File file(path, base::File::FLAG_OPEN | base::File::FLAG_WRITE);
+    if (file.IsValid()) {
+      const int64_t length = file.GetLength();
+      const std::vector<uint8_t> zeros(64 * 1024, 0);
+      for (int64_t at = 0; at < length;) {
+        const size_t chunk = static_cast<size_t>(std::min<int64_t>(length - at, zeros.size()));
+        if (!file.WriteAndCheck(at, base::span(zeros).first(chunk))) {
+          break;
+        }
+        at += chunk;
+      }
+      file.Flush();
+    }
+  }
+  base::DeleteFile(path);
+}
+
+base::FilePath SideFile(const base::FilePath& file, const char* suffix) {
+  // SQLite's side files are named after the database with a suffix, no dot.
+  return base::FilePath(file.value() + suffix);
+}
+
+bool MakeBackup(const base::FilePath& file, const base::FilePath& backup) {
+  WipeAndDelete(backup);  // one an interrupted start left
+  if (!Checkpoint(file) || !base::CopyFile(file, backup)) {
+    return false;
+  }
+  const auto a = HashOf(file);
+  const auto b = HashOf(backup);
+  return a && b && *a == *b;
+}
+
+// The database put back from its copy, in one step (a copy beside it, then
+// renamed over it), so an end in between leaves one or the other whole.
+void Restore(const base::FilePath& file, const base::FilePath& backup) {
+  for (const char* suffix : {"-wal", "-shm", "-journal"}) {
+    WipeAndDelete(SideFile(file, suffix));
+  }
+  const base::FilePath restored(file.value() + ".thoron-restore");
+  if (base::CopyFile(backup, restored) && !base::ReplaceFile(restored, file, nullptr)) {
+    WipeAndDelete(restored);
+  }
+}
+
+bool HasPortableTag(base::span<const uint8_t> value) {
+  return value.size() > kTagSize &&
+         base::as_string_view(value.first(kTagSize)) == kPortableKeyTag;
+}
+
+// How each value is turned: `done` tells a value already in the new form, `read`
+// gives the plain text of one in the old form, `seal` makes the new value and
+// `open` reads a new value back.
+struct Transform {
+  base::FunctionRef<bool(base::span<const uint8_t>)> done;
+  base::FunctionRef<std::optional<std::string>(base::span<const uint8_t>)> read;
+  base::FunctionRef<std::string(std::string_view)> seal;
+  base::FunctionRef<std::optional<std::string>(base::span<const uint8_t>)> open;
+};
+
+// The plain text of a value in the old form, when it reads and is what its
+// column holds; nothing otherwise.
+std::optional<std::string> ReadChecked(const Transform& how,
+                                       const Column& column,
+                                       base::span<const uint8_t> value,
+                                       std::string_view host,
+                                       bool hashed_cookies) {
+  std::optional<std::string> plain = how.read(value);
+  if (plain && !Plausible(column.kind, *plain, host, hashed_cookies)) {
+    WipeString(*plain);
+    return std::nullopt;
+  }
+  return plain;
+}
+
+// How many values of the database are still in the old form and read, and how
+// many are in the old form but do not; read only, nothing is written.
+struct Work {
+  int turnable = 0;
+  int unreadable = 0;
+};
+
+std::optional<Work> WorkIn(const base::FilePath& file, const std::vector<Column>& columns, const Transform& how) {
+  sql::Database db(sql::DatabaseOptions().set_read_only(true), kDatabaseTag);
+  if (!db.Open(file)) {
+    return std::nullopt;
+  }
+  {
+    // a file that is not a database, or does not read, is not "nothing to do"
+    sql::Statement readable(db.GetUniqueStatement("SELECT count(*) FROM sqlite_master"));
+    if (!readable.Step()) {
+      return std::nullopt;
+    }
+  }
+  const bool hashed_cookies = CookieVersion(db) >= kCookieHashVersion;
+  Work work;
+  for (const Column& column : columns) {
+    if (!HasColumn(db, column)) {
+      continue;
+    }
+    sql::Statement select(db.GetUniqueStatement(SelectOf(column)));
+    while (select.Step()) {
+      base::span<const uint8_t> value = select.ColumnBlob(1);
+      if (value.empty() || how.done(value)) {
+        continue;
+      }
+      const std::string host = column.kind == Kind::kCookie ? select.ColumnString(2) : std::string();
+      std::optional<std::string> plain = ReadChecked(how, column, value, host, hashed_cookies);
+      if (plain) {
+        WipeString(*plain);
+        ++work.turnable;
+      } else {
+        ++work.unreadable;
+      }
+    }
+    if (!select.Succeeded()) {
+      return std::nullopt;
+    }
+  }
+  return work;
+}
+
+// One database: every value of its columns turned in one transaction, each new
+// value read back from its row before the transaction is kept.
+ReencryptResult TransformDatabase(const base::FilePath& file,
+                                  const std::vector<Column>& columns,
+                                  const Transform& how,
+                                  ReencryptCounts* counts) {
+  sql::Database db(sql::DatabaseOptions(), kDatabaseTag);
+  if (!db.Open(file)) {
+    return ReencryptResult::kDatabaseFailed;
+  }
+  const bool hashed_cookies = CookieVersion(db) >= kCookieHashVersion;
+  // The journal (the old pages, while the change is made) stays after the
+  // commit, so it can be overwritten before it goes (TransformProfile); SQLite
+  // in Chromium overwrites freed parts of the database itself (secure delete).
+  {
+    sql::Statement mode(db.GetUniqueStatement("PRAGMA journal_mode=PERSIST"));
+    if (!mode.Step()) {
+      return ReencryptResult::kDatabaseFailed;
+    }
+  }
+  sql::Transaction transaction(&db);
+  if (!transaction.Begin()) {
+    return ReencryptResult::kDatabaseFailed;
+  }
+  ReencryptCounts found;
+  for (const Column& column : columns) {
+    if (!HasColumn(db, column)) {
+      continue;
+    }
+    std::vector<std::pair<int64_t, std::string>> changes;
+    {
+      sql::Statement select(db.GetUniqueStatement(SelectOf(column)));
+      while (select.Step()) {
+        base::span<const uint8_t> value = select.ColumnBlob(1);
+        if (value.empty()) {
+          continue;
+        }
+        if (how.done(value)) {
+          ++found.already;
+          continue;
+        }
+        const std::string host = column.kind == Kind::kCookie ? select.ColumnString(2) : std::string();
+        std::optional<std::string> plain = ReadChecked(how, column, value, host, hashed_cookies);
+        if (!plain) {
+          ++found.unreadable;
+          continue;
+        }
+        std::string sealed = how.seal(*plain);
+        std::optional<std::string> back = how.open(base::as_byte_span(sealed));
+        const bool same = back && *back == *plain;
+        WipeString(*plain);
+        if (back) {
+          WipeString(*back);
+        }
+        if (!same) {
+          return ReencryptResult::kCheckFailed;
+        }
+        changes.emplace_back(select.ColumnInt64(0), std::move(sealed));
+        switch (column.kind) {
+          case Kind::kPassword:
+            ++found.passwords;
+            break;
+          case Kind::kCookie:
+            ++found.cookies;
+            break;
+          case Kind::kOther:
+            ++found.other;
+            break;
+        }
+      }
+      if (!select.Succeeded()) {
+        return ReencryptResult::kDatabaseFailed;
+      }
+    }
+    for (const auto& [rowid, sealed] : changes) {
+      sql::Statement update(db.GetUniqueStatement(
+          std::string("UPDATE ") + column.table + " SET " + column.column + " = ? WHERE rowid = ?"));
+      update.BindBlob(0, base::as_byte_span(sealed));
+      update.BindInt64(1, rowid);
+      if (!update.Run()) {
+        return ReencryptResult::kDatabaseFailed;
+      }
+    }
+    // Read back what is now in each changed row: the new value, which opens.
+    for (const auto& [rowid, sealed] : changes) {
+      sql::Statement again(db.GetUniqueStatement(
+          std::string("SELECT ") + column.column + " FROM " + column.table + " WHERE rowid = ?"));
+      again.BindInt64(0, rowid);
+      if (!again.Step() || base::as_string_view(again.ColumnBlob(0)) != sealed ||
+          !how.done(again.ColumnBlob(0)) || !how.open(again.ColumnBlob(0))) {
+        return ReencryptResult::kCheckFailed;
+      }
+    }
+  }
+  if (!transaction.Commit()) {
+    return ReencryptResult::kDatabaseFailed;
+  }
+  counts->passwords += found.passwords;
+  counts->cookies += found.cookies;
+  counts->other += found.other;
+  counts->already += found.already;
+  counts->unreadable += found.unreadable;
+  return ReencryptResult::kDone;
+}
+
+// Every database of the profile, each with a checked copy first (see
+// ReencryptProfile in the header).
+ReencryptResult TransformProfile(const base::FilePath& profile,
+                                 const Transform& how,
+                                 ReencryptCounts* counts) {
+  std::vector<base::FilePath> backups;
+  ReencryptResult result = ReencryptResult::kDone;
+  for (const Place& place : Places()) {
+    const base::FilePath file = profile.Append(place.file);
+    if (!base::PathExists(file)) {
+      continue;
+    }
+    // Nothing to turn (the usual start of a copy whose values are done): no
+    // copy is made and the file is not written.
+    if (std::optional<Work> work = WorkIn(file, place.columns, how); work && work->turnable == 0) {
+      counts->unreadable += work->unreadable;
+      continue;
+    }
+    const base::FilePath backup(file.value() + kBackupSuffix);
+    if (!MakeBackup(file, backup)) {
+      WipeAndDelete(backup);
+      result = ReencryptResult::kBackupFailed;
+      break;
+    }
+    backups.push_back(backup);
+    result = TransformDatabase(file, place.columns, how, counts);
+    if (result != ReencryptResult::kDone) {
+      Restore(file, backup);
+      break;
+    }
+    WipeAndDelete(SideFile(file, "-journal"));
+  }
+  // The copies hold the values in their old form. When a later database
+  // failed, the earlier ones are turned already and read back fine, so their
+  // copies go too; the failed one was put back from its copy.
+  for (const base::FilePath& backup : backups) {
+    WipeAndDelete(backup);
+  }
+  return result;
+}
+
+}  // namespace
+
+std::string EncryptWithPortableKey(base::span<const uint8_t, 32> key,
+                                   std::string_view plaintext) {
+  std::array<uint8_t, kNonceSize> nonce = {};
+  crypto::RandBytes(nonce);
+  std::vector<uint8_t> sealed = crypto::aead::Seal(
+      crypto::aead::AES_256_GCM, key, base::as_byte_span(plaintext), nonce, {});
+  std::string out(kPortableKeyTag);
+  out.append(base::as_string_view(nonce));
+  out.append(base::as_string_view(sealed));
+  return out;
+}
+
+std::optional<std::string> DecryptWithPortableKey(base::span<const uint8_t, 32> key,
+                                                  base::span<const uint8_t> value) {
+  if (!HasPortableTag(value) || value.size() < kTagSize + kNonceSize) {
+    return std::nullopt;
+  }
+  const base::span<const uint8_t> nonce = value.subspan(kTagSize, kNonceSize);
+  std::optional<std::vector<uint8_t>> plain =
+      crypto::aead::Open(crypto::aead::AES_256_GCM, key,
+                         value.subspan(kTagSize + kNonceSize), nonce, {});
+  if (!plain) {
+    return std::nullopt;
+  }
+  std::string text(plain->begin(), plain->end());
+  Wipe(*plain);
+  return text;
+}
+
+std::vector<base::FilePath> FilesWithPortableValues(const base::FilePath& profile) {
+  std::vector<base::FilePath> files;
+  for (const Place& place : Places()) {
+    const base::FilePath file = profile.Append(place.file);
+    if (!base::PathExists(file)) {
+      continue;
+    }
+    sql::Database db(sql::DatabaseOptions().set_read_only(true), kDatabaseTag);
+    if (!db.Open(file)) {
+      continue;
+    }
+    for (const Column& column : place.columns) {
+      if (column.kind == Kind::kOther || !HasColumn(db, column)) {
+        continue;
+      }
+      sql::Statement any(db.GetUniqueStatement(std::string("SELECT 1 FROM ") + column.table +
+                                               " WHERE CAST(substr(" + column.column + ", 1, 3) AS TEXT) = ? LIMIT 1"));
+      any.BindString(0, kPortableKeyTag);
+      if (any.Step()) {
+        files.push_back(file);
+        break;
+      }
+    }
+  }
+  return files;
+}
+
+bool SetAsideLockedDatabases(const base::FilePath& profile) {
+  bool all = true;
+  for (const base::FilePath& file : FilesWithPortableValues(profile)) {
+    Checkpoint(file);
+    base::FilePath aside(file.value() + kWithoutKeySuffix);
+    for (int n = 2; base::PathExists(aside) && n < 100; ++n) {
+      aside = base::FilePath(file.value() + kWithoutKeySuffix + "-" + base::NumberToString(n));
+    }
+    if (!base::Move(file, aside)) {
+      all = false;
+      continue;
+    }
+    for (const char* suffix : {"-wal", "-shm", "-journal"}) {
+      base::DeleteFile(SideFile(file, suffix));
+    }
+  }
+  return all;
+}
+
+ReencryptResult ReencryptProfile(const base::FilePath& profile,
+                                 ReadOldValue read_old,
+                                 base::span<const uint8_t, 32> new_key,
+                                 ReencryptCounts* counts) {
+  auto done = [](base::span<const uint8_t> value) { return HasPortableTag(value); };
+  auto seal = [new_key](std::string_view plain) { return EncryptWithPortableKey(new_key, plain); };
+  auto open = [new_key](base::span<const uint8_t> value) {
+    return DecryptWithPortableKey(new_key, value);
+  };
+  return TransformProfile(profile, Transform{done, read_old, seal, open}, counts);
+}
+
+std::string EncryptForChromiumLinux(base::span<const uint8_t, 16> key,
+                                    std::string_view prefix,
+                                    std::string_view plaintext) {
+  std::string out(prefix);
+  out.append(base::as_string_view(crypto::aes_cbc::Encrypt(key, kChromiumIv, base::as_byte_span(plaintext))));
+  return out;
+}
+
+std::optional<std::string> DecryptForChromiumLinux(base::span<const uint8_t, 16> key,
+                                                   std::string_view prefix,
+                                                   base::span<const uint8_t> value) {
+  if (value.size() <= prefix.size() || base::as_string_view(value.first(prefix.size())) != prefix) {
+    return std::nullopt;
+  }
+  std::optional<std::vector<uint8_t>> plain =
+      crypto::aes_cbc::Decrypt(key, kChromiumIv, value.subspan(prefix.size()));
+  if (!plain) {
+    return std::nullopt;
+  }
+  std::string text(plain->begin(), plain->end());
+  Wipe(*plain);
+  return text;
+}
+
+ReencryptResult ReturnProfileToChromium(const base::FilePath& profile,
+                                        base::span<const uint8_t, 32> portable_key,
+                                        base::span<const uint8_t, 16> chromium_key,
+                                        std::string_view prefix,
+                                        ReencryptCounts* counts) {
+  // Anything not of the copy's key is Chromium's already (or unreadable to it
+  // anyway) and stays as it is.
+  auto done = [](base::span<const uint8_t> value) { return !HasPortableTag(value); };
+  auto read = [portable_key](base::span<const uint8_t> value) {
+    return DecryptWithPortableKey(portable_key, value);
+  };
+  auto seal = [chromium_key, prefix](std::string_view plain) {
+    return EncryptForChromiumLinux(chromium_key, prefix, plain);
+  };
+  auto open = [chromium_key, prefix](base::span<const uint8_t> value) {
+    return DecryptForChromiumLinux(chromium_key, prefix, value);
+  };
+  return TransformProfile(profile, Transform{done, read, seal, open}, counts);
+}
+
+}  // namespace thoron_portable_key
