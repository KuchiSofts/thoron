+namespace {
+
+constexpr char kLastSerialPref[] = "thoron_update.last_serial";
+constexpr char kKeyStatementsPref[] = "thoron_update.key_statements";
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("thoron_update", R"(
+        semantics {
+          sender: "Thoron updater"
+          description:
+            "Fetches Thoron's signed update manifest, its signature and its "
+            "key statements, and then the package of a newer release, from "
+            "Thoron's releases on GitHub."
+          trigger:
+            "A look for updates on a schedule, or from the About page."
+          data: "None: plain requests for public files, without cookies."
+          destination: OTHER
+          destination_other: "Thoron's releases on GitHub."
+          internal { contacts { email: "updates@example.com" } }
+          user_data { type: NONE }
+          last_reviewed: "2026-11-16"
+        }
+        policy {
+          cookies_allowed: NO
+          setting:
+            "The update mode in Settings: automatic, notify only, or off."
+          policy_exception_justification: "Not implemented."
+        })");
+
+// Every key statement is 96 bytes; update.key holds one or more, at most
+// kMostKeyStatements.
+std::vector<std::string> SplitStatements(const std::string& body) {
+  std::vector<std::string> out;
+  if (body.empty() || body.size() % kKeyStatementBytes != 0 ||
+      body.size() > kKeyStatementBytes * kMostKeyStatements) {
+    return out;
+  }
+  for (size_t at = 0; at < body.size(); at += kKeyStatementBytes) {
+    out.push_back(body.substr(at, kKeyStatementBytes));
+  }
+  return out;
+}
+
+bool IsNoKey(const PublicKey& key) {
+  return std::all_of(key.begin(), key.end(), [](uint8_t b) { return b == 0; });
+}
+
+// The file name a package is kept under: the last part of its address, when
+// it is a plain name.
+std::string PackageName(const PackageFile& file, bool delta) {
+  const std::string name = GURL(file.url).ExtractFileName();
+  const bool plain =
+      !name.empty() && name.size() <= 128 && name[0] != '.' &&
+      std::all_of(name.begin(), name.end(), [](char c) {
+        return base::IsAsciiAlphaNumeric(c) || c == '.' || c == '-' || c == '_';
+      });
+  return plain ? name : (delta ? "package.delta" : "package");
+}
