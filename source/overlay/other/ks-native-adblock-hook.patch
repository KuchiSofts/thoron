+      s.BindString(0, base::StrCat({"https://example.com/", std::to_string(i)}));
+      s.BindString16(1, u"pad");
+      ASSERT_TRUE(s.Run());
+    }
+  }
+  base::File file(history, base::File::FLAG_OPEN | base::File::FLAG_READ |
+                               base::File::FLAG_WRITE);
+  ASSERT_TRUE(file.IsValid());
+  ASSERT_GT(file.GetLength(), 8192);
+  std::array<uint8_t, 4096> garbage;
+  garbage.fill(0xA5);
+  // Overwrite the second page onward; page 1 (schema) stays intact.
+  std::optional<size_t> written = file.Write(4096, garbage);
+  ASSERT_EQ(garbage.size(), written);
