+// static
+ThoronMailCenter& ThoronMailCenter::For(Profile* profile) {
+  auto* center = static_cast<ThoronMailCenter*>(profile->GetUserData(kCenterKey));
+  if (!center) {
+    auto made = std::make_unique<ThoronMailCenter>(profile);
+    center = made.get();
+    profile->SetUserData(kCenterKey, std::move(made));
+    center->service().Start();
+  }
+  return *center;
+}
+
+ThoronMailCenter::ThoronMailCenter(Profile* profile)
+    : profile_(profile),
+      service_(std::make_unique<thoron_mail::MailService>(
+          profile->GetPrefs(),
+          base::BindRepeating(
+              [](Profile* profile)
+                  -> scoped_refptr<network::SharedURLLoaderFactory> {
+                return profile->GetDefaultStoragePartition()
+                    ->GetURLLoaderFactoryForBrowserProcess();
+              },
+              // Unretained: the service is owned by this, which is the
+              // profile's own (user data): it ends before the profile.
+              base::Unretained(profile)))) {
+  service_->AddObserver(this);
+}
+
+ThoronMailCenter::~ThoronMailCenter() {
+  service_->RemoveObserver(this);
+}
+
+void ThoronMailCenter::OpenGmail(const GURL& url, int index) {
+  if (!url.is_valid() || url.host() != "mail.google.com" ||
+      !url.SchemeIs(url::kHttpsScheme)) {
+    return;
+  }
+  // The inbox opened (from the menu or a notice): the account's new mail is
+  // counted from now (P5.76).
+  if (url == thoron_mail::MailService::InboxUrl(index)) {
+    for (const thoron_mail::MailAccount& account : service_->accounts()) {
+      if (account.index == index) {
+        service_->MarkLooked(account.email);
+      }
+    }
+  }
+  const std::string inbox = "/mail/u/" + base::NumberToString(index);
+  BrowserWindowInterface* found = nullptr;
+  int tab = -1;
+  // the person's choice: the account's Gmail tab when one is open, or a new tab
+  const bool reuse = service_->Choice("open") != "new";
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* browser) {
+        if (!reuse) {
+          return false;  // a new tab
+        }
+        if (browser->GetProfile() != profile_) {
+          return true;
+        }
+        TabStripModel* tabs = browser->GetTabStripModel();
+        for (int i = 0; i < tabs->count(); ++i) {
+          const GURL& at = tabs->GetWebContentsAt(i)->GetLastCommittedURL();
+          if (at.host() == "mail.google.com" &&
+              (at.path() == inbox || base::StartsWith(at.path(), inbox + "/"))) {
+            found = browser;
+            tab = i;
+            return false;
+          }
+        }
+        return true;
+      });
+  if (found) {
+    // a message is opened in that tab; the inbox is only brought forward
+    if (url != thoron_mail::MailService::InboxUrl(index)) {
+      found->GetTabStripModel()->GetWebContentsAt(tab)->GetController().LoadURL(
+          url, content::Referrer(), ui::PAGE_TRANSITION_LINK, std::string());
+    }
+    found->GetTabStripModel()->ActivateTabAt(tab);
+    found->GetWindow()->Activate();
+    return;
+  }
+  NavigateParams params(profile_, url, ui::PAGE_TRANSITION_LINK);
+  params.disposition = WindowOpenDisposition::kNewForegroundTab;
+  params.window_action = NavigateParams::WindowAction::kShowWindow;
+  Navigate(&params);
+}
+
+void ThoronMailCenter::OpenSignIn(bool add) {
+  const GURL url(
+      add ? "https://accounts.google.com/AddSession?service=mail&continue="
+            "https%3A%2F%2Fmail.google.com%2Fmail%2F"
+          : "https://accounts.google.com/ServiceLogin?service=mail&continue="
+            "https%3A%2F%2Fmail.google.com%2Fmail%2F");
+  NavigateParams params(profile_, url, ui::PAGE_TRANSITION_LINK);
+  params.disposition = WindowOpenDisposition::kNewForegroundTab;
+  params.window_action = NavigateParams::WindowAction::kShowWindow;
+  Navigate(&params);
+}
+
+void ThoronMailCenter::OnNewMail(
+    const thoron_mail::MailAccount& account,
+    const std::vector<thoron_mail::MailMessage>& messages) {
+  NotificationDisplayService* display =
+      NotificationDisplayServiceFactory::GetForProfile(profile_);
+  if (!service_->notify() || messages.empty() || !display) {
+    return;
+  }
+  auto notice = [&](const std::string& id, const std::u16string& title,
+                    const std::u16string& text, const GURL& open) {
+    // Unretained: a notice that outlives the profile is never clicked.
+    auto delegate =
+        base::MakeRefCounted<message_center::HandleNotificationClickDelegate>(
+            base::BindRepeating(
+                [](ThoronMailCenter* center, GURL url, int index,
+                   std::optional<int> button) {
+                  center->OpenGmail(url, index);
+                },
+                base::Unretained(this), open, account.index));
+    // the person's choice: a notice with its sound, or a silent one
+    message_center::RichNotificationData data;
+    data.silent = service_->Choice("sound") == "off";
+    message_center::Notification notification(
+        message_center::NOTIFICATION_TYPE_SIMPLE, id, title, text,
+        ui::ImageModel(), base::UTF8ToUTF16(account.email),
+        GURL("https://mail.google.com/"),
+#if BUILDFLAG(IS_CHROMEOS)
+        message_center::NotifierId(
+            message_center::NotifierType::SYSTEM_COMPONENT, kNotifierId,
+            ash::NotificationCatalogName::kNone),
+#else
+        message_center::NotifierId(
+            message_center::NotifierType::SYSTEM_COMPONENT, kNotifierId),
+#endif
+        data, delegate);
+    display->Display(NotificationHandler::Type::TRANSIENT, notification,
+                     /*metadata=*/nullptr);
+  };
+  if (messages.size() > kMostNotices) {
+    notice("thoron.mail." + account.email,
+           base::NumberToString16(messages.size()) + u" new messages",
+           base::UTF8ToUTF16(account.email),
+           thoron_mail::MailService::InboxUrl(account.index));
+    return;
+  }
+  for (const thoron_mail::MailMessage& message : messages) {
+    const std::string link = thoron_mail::GmailLink(message.link);
+    notice("thoron.mail." + account.email + "." + message.id,
+           base::UTF8ToUTF16(message.from_name.empty() ? message.from_email
+                                                       : message.from_name),
+           base::UTF8ToUTF16(message.subject),
+           link.empty() ? thoron_mail::MailService::InboxUrl(account.index)
+                        : GURL(link));
+  }
+}
+
+ThoronMailMenuUIConfig::ThoronMailMenuUIConfig()
+    : DefaultTopChromeWebUIConfig(content::kChromeUIScheme,
+                                  kThoronMailMenuHost) {}
+
