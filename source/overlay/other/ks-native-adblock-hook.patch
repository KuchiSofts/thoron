+    "//testing/gtest",
+    "//third_party/sqlite",
+    "//third_party/zlib",
+    "//third_party/zlib/google:zip",
+  ]
+}
+
+# The tests alone, without the rest of components_unittests:
+#   thoron_update_unittests
+test("thoron_update_unittests") {
+  deps = [
+    ":unit_tests",
+    "//mojo/core/test:run_all_unittests",
+    "//testing/gtest",
+  ]
+}
+
+# The portable launcher is built with the tests, so it is built and checked
+# whenever they are.
+group("thoron_update_all") {
