index 0000000000000000000000000000000000000000..97dfc3f6866ed7ab120bee39f31f6d56acdad4b0
--- /dev/null
+++ b/chrome/browser/ui/views/toolbar/thoron_windows_security.cc
@@ -0,0 +1,134 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/toolbar/thoron_windows_security.h"
+
+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_WIN)
+#include <windows.h>
+
+#include <stdint.h>
+#include <wchar.h>
+
+#include <iterator>
+
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/time/time.h"
+#endif
+
+namespace thoron {
+
+#if BUILDFLAG(IS_WIN)
+namespace {
+
+// The window Windows Security asks in (Windows Hello, the PIN, passkeys),
+// shown by Windows' own process, not the browser's.
+constexpr wchar_t kPromptClass[] = L"Credential Dialog Xaml Host";
+// It may lay itself out after it is shown, and fall behind again: it is
+// brought up once more then.
+constexpr base::TimeDelta kAgain = base::Milliseconds(350);
+
+HWINEVENTHOOK g_hook = nullptr;
+
+bool IsSecurityPrompt(HWND window) {
+  wchar_t name[64] = {};
+  return ::GetClassNameW(window, name, static_cast<int>(std::size(name))) &&
+         wcscmp(name, kPromptClass) == 0;
+}
+
+bool OfThisBrowser(HWND window) {
+  DWORD process = 0;
+  ::GetWindowThreadProcessId(window, &process);
+  return process == ::GetCurrentProcessId();
+}
+
+// The prompt belongs in front: the browser is the window in front (the person
+// was using it when the prompt came), or a window of the browser covers the
+// prompt from above.
+bool BelongsInFront(HWND prompt) {
+  if (HWND front = ::GetForegroundWindow(); front && OfThisBrowser(front)) {
+    return true;
+  }
+  RECT prompt_rect;
+  if (!::GetWindowRect(prompt, &prompt_rect)) {
+    return false;
+  }
+  for (HWND above = ::GetWindow(prompt, GW_HWNDPREV); above;
+       above = ::GetWindow(above, GW_HWNDPREV)) {
+    RECT rect;
+    RECT overlap;
+    if (OfThisBrowser(above) && ::IsWindowVisible(above) &&
+        ::GetWindowRect(above, &rect) &&
+        ::IntersectRect(&overlap, &rect, &prompt_rect)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void BringToFront(HWND prompt) {
+  if (!::IsWindow(prompt) || !::IsWindowVisible(prompt)) {
+    return;
+  }
+  // Above every window, then a window like the others again, in front of
+  // them; posted to the prompt's own thread, so the browser never waits for
+  // it.
+  constexpr UINT kFlags =
+      SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE | SWP_ASYNCWINDOWPOS;
+  ::SetWindowPos(prompt, HWND_TOPMOST, 0, 0, 0, 0, kFlags);
+  ::SetWindowPos(prompt, HWND_NOTOPMOST, 0, 0, 0, 0, kFlags);
+  // The keyboard too, so the PIN can be typed at once. Windows allows it only
+  // while the browser is in front, which is when the person asked.
+  if (HWND front = ::GetForegroundWindow(); front && OfThisBrowser(front)) {
+    ::SetForegroundWindow(prompt);
+  }
+}
+
+void CALLBACK OnShown(HWINEVENTHOOK hook,
+                      DWORD event,
+                      HWND window,
+                      LONG object,
+                      LONG child,
+                      DWORD thread,
+                      DWORD time) {
+  if (object != OBJID_WINDOW || child != CHILDID_SELF || !window ||
+      ::GetAncestor(window, GA_ROOT) != window || !IsSecurityPrompt(window) ||
+      !BelongsInFront(window)) {
+    return;
+  }
+  BringToFront(window);
+  // the window as a number: it may be gone by then (BringToFront checks)
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](uintptr_t prompt) {
+            BringToFront(reinterpret_cast<HWND>(prompt));
+          },
+          reinterpret_cast<uintptr_t>(window)),
+      kAgain);
+}
+
+}  // namespace
+
+void WatchWindowsSecurityPrompts() {
+  if (g_hook) {
+    return;
+  }
+  // Out of context: Windows tells the browser's UI thread, through its
+  // message loop, of every window shown by another process; nothing is
+  // loaded into that process.
+  g_hook = ::SetWinEventHook(EVENT_OBJECT_SHOW, EVENT_OBJECT_SHOW, nullptr,
+                             &OnShown, 0, 0,
+                             WINEVENT_OUTOFCONTEXT | WINEVENT_SKIPOWNPROCESS);
+}
+
+#else
+
+void WatchWindowsSecurityPrompts() {}
+
+#endif  // BUILDFLAG(IS_WIN)
+
+}  // namespace thoron
