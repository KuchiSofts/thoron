@@ -0,0 +1,129 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_portable_key/local_state_key.h"
+
+#include <array>
+#include <vector>
+
+#include "base/base64.h"
+#include "base/compiler_specific.h"
+#include "base/files/file_util.h"
+#include "base/time/time.h"
+#include "build/build_config.h"
+#include "components/thoron_portable_key/argon2id.h"
+#include "components/thoron_portable_key/key_file.h"
+#include "components/thoron_portable_key/key_store.h"
+
+#if BUILDFLAG(IS_WIN)
+#include <windows.h>
+
+#include <dpapi.h>
+#endif
+
+namespace thoron_portable_key {
+
+namespace {
+
+constexpr std::string_view kDpapiPrefix = "DPAPI";
+
+std::vector<base::FilePath> KeyFilePaths(const base::FilePath& folder) {
+  const base::FilePath main = folder.Append(kKeyFileName);
+  return {main, main.AddExtensionASCII("new"), main.AddExtensionASCII("old")};
+}
+
+}  // namespace
+
+std::optional<SecretBytes> UnprotectLocalStateKey(
+    std::string_view encrypted_key) {
+#if BUILDFLAG(IS_WIN)
+  std::optional<std::vector<uint8_t>> decoded =
+      base::Base64Decode(encrypted_key);
+  if (!decoded || decoded->size() <= kDpapiPrefix.size() ||
+      base::span(*decoded).first(kDpapiPrefix.size()) !=
+          base::as_byte_span(kDpapiPrefix)) {
+    return std::nullopt;
+  }
+  const base::span<uint8_t> blob =
+      base::span(*decoded).subspan(kDpapiPrefix.size());
+  DATA_BLOB input;
+  input.pbData = blob.data();
+  input.cbData = static_cast<DWORD>(blob.size());
+  DATA_BLOB output = {};
+  if (!::CryptUnprotectData(&input, nullptr, nullptr, nullptr, nullptr,
+                            CRYPTPROTECT_UI_FORBIDDEN, &output)) {
+    return std::nullopt;
+  }
+  // SAFETY: CryptUnprotectData gives cbData bytes at pbData.
+  const base::span<uint8_t> plain =
+      UNSAFE_BUFFERS(base::span(output.pbData, output.cbData));
+  std::optional<SecretBytes> key;
+  if (plain.size() == kProfileKeyBytes) {
+    key.emplace(plain);
+  }
+  Wipe(plain);
+  ::LocalFree(output.pbData);
+  return key;
+#else
+  return std::nullopt;
+#endif
+}
+
+std::optional<std::string> ProtectLocalStateKey(const SecretBytes& key) {
+#if BUILDFLAG(IS_WIN)
+  if (key.size() != kProfileKeyBytes) {
+    return std::nullopt;
+  }
+  DATA_BLOB input;
+  input.pbData = const_cast<BYTE*>(key.span().data());
+  input.cbData = static_cast<DWORD>(key.size());
+  DATA_BLOB output = {};
+  if (!::CryptProtectData(&input, L"", nullptr, nullptr, nullptr,
+                          CRYPTPROTECT_UI_FORBIDDEN, &output)) {
+    return std::nullopt;
+  }
+  // SAFETY: CryptProtectData gives cbData bytes at pbData.
+  const base::span<const uint8_t> blob =
+      UNSAFE_BUFFERS(base::span(output.pbData, output.cbData));
+  std::vector<uint8_t> with_prefix(kDpapiPrefix.begin(), kDpapiPrefix.end());
+  with_prefix.insert(with_prefix.end(), blob.begin(), blob.end());
+  ::LocalFree(output.pbData);
+  return base::Base64Encode(with_prefix);
+#else
+  return std::nullopt;
+#endif
+}
+
+base::TimeDelta MeasureFloor() {
+  std::array<uint8_t, 16> password;
+  password.fill(0x5a);
+  std::array<uint8_t, 16> salt;
+  salt.fill(0xa5);
+  std::array<uint8_t, 32> out;
+  const base::TimeTicks start = base::TimeTicks::Now();
+  if (!Argon2id(password, salt, kFloor, out)) {
+    return base::TimeDelta();
+  }
+  return base::TimeTicks::Now() - start;
+}
+
+bool HasKeyFile(const base::FilePath& folder) {
+  for (const base::FilePath& path : KeyFilePaths(folder)) {
+    if (base::PathExists(path)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool RemoveKeyFile(const base::FilePath& folder) {
+  bool removed = true;
+  for (const base::FilePath& path : KeyFilePaths(folder)) {
+    removed = base::DeleteFile(path) && removed;
+  }
+  // a damaged file a read kept aside (key_store.cc) goes with the lock too
+  removed = base::DeleteFile(folder.Append(kKeyFileName).AddExtensionASCII("damaged")) && removed;
+  return removed && !HasKeyFile(folder);
+}
+
+}  // namespace thoron_portable_key
