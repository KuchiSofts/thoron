@@ -0,0 +1,74 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_UPDATE_PORTABLE_PACKAGE_H_
+#define COMPONENTS_THORON_UPDATE_PORTABLE_PACKAGE_H_
+
+#include <stdint.h>
+
+#include <string_view>
+#include <vector>
+
+#include "components/thoron_update/manifest.h"
+#include "components/thoron_update/swap.h"
+
+namespace base {
+class FilePath;
+}  // namespace base
+
+// Updating a portable copy from its release's package (ROADMAP P3.20, P3.12).
+// The package is the .zip of tools/release/portable.py: one folder,
+// ThoronPortable, with Thoron.exe, README.txt, variant, Application/current and
+// Application/<version>/. Only the version's folder is unpacked, into a staging
+// folder of the copy's program folder, and then put in place by InstallVersion
+// (swap.h) through the release's own updater (cli.h). The package was checked
+// against the signed manifest before it gets here; what is unpacked from it is
+// still held to limits, since a mistake in a release must not fill a USB drive.
+namespace thoron_update {
+
+inline constexpr char kPortableFolder[] = "ThoronPortable";
+inline constexpr int64_t kMostUnpackedBytes = int64_t{4} * 1024 * 1024 * 1024;
+inline constexpr size_t kMostUnpackedFiles = 20000;
+
+enum class UnpackResult {
+  kDone,
+  // Not a .zip, or not one ThoronPortable folder.
+  kNotAPackage,
+  // The package has no folder for that version.
+  kNoSuchVersion,
+  // An entry that is a link, encrypted, or a name that cannot be made safe.
+  kUnsafeEntry,
+  // More than kMostUnpackedBytes or kMostUnpackedFiles.
+  kTooLarge,
+  // The staging folder is there already, or writing failed.
+  kIoError,
+};
+
+std::string_view UnpackResultName(UnpackResult result);
+
+// Whether a path, as zip::ZipReader hands it out, had a part that could leave
+// the folder it is unpacked into. The reader keeps every entry inside: it turns
+// a ".." part into "UP", a "." part into "DOT" and a leading "/" into "ROOT"
+// (and calls the entry unsafe only when such a part is the last one). A package
+// or delta Thoron made never has such a name, so one that has is refused
+// (THREAT_MODEL U9).
+bool ZipPathWasMadeSafe(const base::FilePath& path);
+
+// Unpacks the folder of `version` from `package` into `staged`, which must not
+// exist, and lists its files in `files`: each path inside the version's folder,
+// its length and the SHA-256 of what was written. Everything else in the
+// package is left out. With anything but kDone, nothing is left at `staged`.
+UnpackResult UnpackVersion(const base::FilePath& package,
+                           const BuildVersion& version,
+                           const base::FilePath& staged,
+                           std::vector<VersionFile>* files);
+
+// Puts the package's launcher (ThoronPortable/Thoron.exe) at `launcher` when it
+// differs from what is there: written beside it, then moved over it in one
+// step, so a stop at any moment leaves a launcher that starts. False when the
+// package has none or it could not be placed; the one there then stays.
+bool ReplaceLauncher(const base::FilePath& package, const base::FilePath& launcher);
+
+}  // namespace thoron_update
+
+#endif  // COMPONENTS_THORON_UPDATE_PORTABLE_PACKAGE_H_
