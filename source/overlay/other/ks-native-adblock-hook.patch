+#ifndef SERVICES_PREFERENCES_TRACKED_THORON_PORTABLE_COPY_H_
+#define SERVICES_PREFERENCES_TRACKED_THORON_PORTABLE_COPY_H_
+
+// Thoron (ROADMAP P3.10, P3.12): true when this browser runs from a portable
+// copy's layout, <copy>\Thoron.exe beside <copy>\Application, which holds
+// `current` and the version folder this program is in. Such a copy moves
+// between PCs: the signatures of its protected settings name no PC (as with
+// Thorium's --disable-machine-id), and it keeps no checksums of them in this
+// PC's registry. Read once.
+bool IsThoronPortableCopy();
+
+#endif  // SERVICES_PREFERENCES_TRACKED_THORON_PORTABLE_COPY_H_
diff --git a/third_party/argon2/BUILD.gn b/third_party/argon2/BUILD.gn
new file mode 100644
index 0000000000000000000000000000000000000000..6e0b12975b15c9cb4a3beed4a8c3c9a72ee03a8b
--- /dev/null
+++ b/third_party/argon2/BUILD.gn
@@ -0,0 +1,35 @@
+# Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+# Argon2 (RFC 9106), the reference C implementation of its authors, for the
+# passphrase of Thoron's portable copies (components/thoron_portable_key,
+# ROADMAP P4.9). Only the portable reference code is built (ref.c, no SIMD),
+# without threads of its own: the lanes are computed one after another, which
+# gives the same result. See README.chromium.
+
+config("argon2_config") {
+  include_dirs = [ "src/include" ]
+  defines = [ "ARGON2_NO_THREADS" ]
+}
+
+static_library("argon2") {
+  sources = [
+    "src/include/argon2.h",
+    "src/src/argon2.c",
+    "src/src/blake2/blake2-impl.h",
+    "src/src/blake2/blake2.h",
+    "src/src/blake2/blake2b.c",
+    "src/src/blake2/blamka-round-ref.h",
+    "src/src/core.c",
+    "src/src/core.h",
+    "src/src/encoding.c",
+    "src/src/encoding.h",
+    "src/src/ref.c",
+    "src/src/thread.c",
+    "src/src/thread.h",
+  ]
+  configs -= [ "//build/config/compiler:chromium_code" ]
+  configs += [ "//build/config/compiler:no_chromium_code" ]
+  public_configs = [ ":argon2_config" ]
+  visibility = [ "//components/thoron_portable_key:*" ]
+}
