+TEST_F(ThoronUpdateClientResumeTest, ARangeThatStartsElsewhereIsNeverAppended) {
+  const std::string whole = Bytes(data::kInstaller);
+  Serve(base::BindLambdaForTesting([&](const std::string& range) {
+    if (range.empty()) {
+      Answer(200, whole.substr(0, 1000));
+    } else {
+      Answer(206, whole.substr(0, 1048), "bytes 0-1047/2048");   // not what was asked
+    }
+  }));
+  const UpdateClient::Status status = Look(*Client(), /*install=*/true);
+  EXPECT_EQ(status.state, State::kError);
+  EXPECT_EQ(ranges_.size(), static_cast<size_t>(UpdateClient::kMostAttempts));
+  EXPECT_TRUE(installed_.empty());
+  // what did arrive is kept for the next look, and nothing else
+  std::string part;
+  ASSERT_TRUE(base::ReadFileToString(Part(), &part));
+  EXPECT_EQ(part, whole.substr(0, 1000));
+  EXPECT_FALSE(base::PathExists(Part().AddExtensionASCII("more")));
+}
