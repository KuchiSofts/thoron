+namespace thoron_portable_key {
+namespace {
+
+inline constexpr sql::Database::Tag kTag{"ThoronPortableKey"};
+
+// A stand-in for Chromium's Linux keys: "old:<text>" reads as <text>.
+std::optional<std::string> ReadOld(base::span<const uint8_t> value) {
+  const std::string_view text = base::as_string_view(value);
+  if (!base::StartsWith(text, "old:")) {
+    return std::nullopt;
+  }
+  return std::string(text.substr(4));
+}
+
+class ThoronReencryptTest : public ::testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(dir_.CreateUniqueTempDir());
+    key_.fill(7);
+  }
+
+  base::FilePath Make(const char* name, const std::vector<std::string>& statements) {
+    const base::FilePath file = dir_.GetPath().Append(name);
+    EXPECT_TRUE(base::CreateDirectory(file.DirName()));
+    sql::Database db(sql::DatabaseOptions(), kTag);
+    EXPECT_TRUE(db.Open(file));
+    for (const std::string& s : statements) {
+      EXPECT_TRUE(db.Execute(s)) << s;
+    }
+    return file;
+  }
+
+  void Insert(const base::FilePath& file, base::cstring_view sql, const std::string& value) {
+    sql::Database db(sql::DatabaseOptions(), kTag);
+    ASSERT_TRUE(db.Open(file));
+    sql::Statement s(db.GetUniqueStatement(sql));
+    s.BindBlob(0, base::as_byte_span(value));
+    ASSERT_TRUE(s.Run());
+  }
+
+  std::vector<std::string> Values(const base::FilePath& file, base::cstring_view sql) {
+    sql::Database db(sql::DatabaseOptions(), kTag);
+    EXPECT_TRUE(db.Open(file));
+    sql::Statement s(db.GetUniqueStatement(sql));
+    std::vector<std::string> out;
+    while (s.Step()) {
+      out.emplace_back(base::as_string_view(s.ColumnBlob(0)));
+    }
+    return out;
+  }
+
+  base::ScopedTempDir dir_;
+  std::array<uint8_t, 32> key_;
+};
+
+TEST_F(ThoronReencryptTest, PasswordsNotesAndCookiesAreEncryptedAgainAndReadBack) {
+  const base::FilePath login = Make(
+      "Login Data", {"CREATE TABLE logins (id INTEGER PRIMARY KEY, password_value BLOB)",
+                     "CREATE TABLE password_notes (id INTEGER PRIMARY KEY, value BLOB)"});
+  Insert(login, "INSERT INTO logins (password_value) VALUES (?)", "old:hunter2");
+  Insert(login, "INSERT INTO logins (password_value) VALUES (?)", "garbage that reads as nothing");
+  Insert(login, "INSERT INTO logins (password_value) VALUES (?)",
+         EncryptWithPortableKey(key_, "done already"));
+  Insert(login, "INSERT INTO password_notes (value) VALUES (?)", "old:a note");
+  const base::FilePath cookies = Make(
+      "Network/Cookies", {"CREATE TABLE cookies (host_key TEXT, encrypted_value BLOB)"});
+  Insert(cookies, "INSERT INTO cookies (host_key, encrypted_value) VALUES ('a', ?)", "old:cookie");
+
+  ReencryptCounts counts;
+  ASSERT_EQ(ReencryptProfile(dir_.GetPath(), ReadOld, key_, &counts), ReencryptResult::kDone);
+  EXPECT_EQ(counts.passwords, 2);
+  EXPECT_EQ(counts.cookies, 1);
+  EXPECT_EQ(counts.already, 1);
+  EXPECT_EQ(counts.unreadable, 1);
+
+  std::vector<std::string> plain;
+  for (const std::string& v : Values(login, "SELECT password_value FROM logins ORDER BY id")) {
+    const std::optional<std::string> p = DecryptWithPortableKey(key_, base::as_byte_span(v));
+    plain.push_back(p ? *p : "(" + v.substr(0, 7) + ")");
+  }
+  EXPECT_EQ(plain, (std::vector<std::string>{"hunter2", "(garbage)", "done already"}));
+  const std::vector<std::string> notes = Values(login, "SELECT value FROM password_notes");
+  ASSERT_EQ(notes.size(), 1u);
+  EXPECT_EQ(DecryptWithPortableKey(key_, base::as_byte_span(notes[0])), "a note");
+  const std::vector<std::string> jar = Values(cookies, "SELECT encrypted_value FROM cookies");
+  ASSERT_EQ(jar.size(), 1u);
+  EXPECT_EQ(DecryptWithPortableKey(key_, base::as_byte_span(jar[0])), "cookie");
+  // no copy of the old values is left behind
+  EXPECT_FALSE(base::PathExists(dir_.GetPath().Append("Login Data.thoron-before-lock")));
+  EXPECT_FALSE(base::PathExists(dir_.GetPath().Append("Network/Cookies.thoron-before-lock")));
+}
+
+TEST_F(ThoronReencryptTest, ADatabaseThatCannotBeReadIsLeftAsItWas) {
+  const base::FilePath login = Make(
+      "Login Data", {"CREATE TABLE logins (id INTEGER PRIMARY KEY, password_value BLOB)"});
+  Insert(login, "INSERT INTO logins (password_value) VALUES (?)", "old:hunter2");
+  const base::FilePath cookies = dir_.GetPath().Append("Cookies");
+  ASSERT_TRUE(base::WriteFile(cookies, "this is not a database, and stays as it is"));
+
+  ReencryptCounts counts;
+  const ReencryptResult result = ReencryptProfile(dir_.GetPath(), ReadOld, key_, &counts);
+  EXPECT_NE(result, ReencryptResult::kDone);
+  std::string text;
+  ASSERT_TRUE(base::ReadFileToString(cookies, &text));
+  EXPECT_EQ(text, "this is not a database, and stays as it is");
+  EXPECT_FALSE(base::PathExists(dir_.GetPath().Append("Cookies.thoron-before-lock")));
+  EXPECT_FALSE(base::PathExists(dir_.GetPath().Append("Login Data.thoron-before-lock")));
+}
+
+TEST_F(ThoronReencryptTest, TheFormatIsTheEncryptorsAndAnotherKeyDoesNotOpenIt) {
+  const std::string sealed = EncryptWithPortableKey(key_, "secret");
+  EXPECT_EQ(sealed.substr(0, 3), kPortableKeyTag);
+  EXPECT_EQ(sealed.size(), 3u + 12u + 6u + 16u);  // tag, nonce, text, GCM tag
+  EXPECT_EQ(DecryptWithPortableKey(key_, base::as_byte_span(sealed)), "secret");
+  std::array<uint8_t, 32> other;
+  other.fill(8);
+  EXPECT_EQ(DecryptWithPortableKey(other, base::as_byte_span(sealed)), std::nullopt);
+  std::string changed = sealed;
+  changed.back() ^= 1;
+  EXPECT_EQ(DecryptWithPortableKey(key_, base::as_byte_span(changed)), std::nullopt);
+  EXPECT_EQ(DecryptWithPortableKey(key_, base::as_byte_span(std::string("v10abc"))), std::nullopt);
+}
+
+// Nothing the old keys open is left in any file of the profile: not in the
+// database (SQLite overwrites what it frees), its journal or the copies.
+TEST_F(ThoronReencryptTest, NoOldValueIsLeftInAnyFile) {
+  const base::FilePath login = Make(
+      "Login Data", {"CREATE TABLE logins (id INTEGER PRIMARY KEY, password_value BLOB)"});
+  // a value a little shorter than the new one, so the row grows and moves
+  Insert(login, "INSERT INTO logins (password_value) VALUES (?)", "old:MARKER-of-the-old-value");
+  // a copy an interrupted start left behind
+  ASSERT_TRUE(base::WriteFile(dir_.GetPath().Append("Login Data.thoron-before-lock"),
+                              "old:MARKER-of-the-old-value in a stale copy"));
+
+  ReencryptCounts counts;
+  ASSERT_EQ(ReencryptProfile(dir_.GetPath(), ReadOld, key_, &counts), ReencryptResult::kDone);
+  EXPECT_EQ(counts.passwords, 1);
+  base::FileEnumerator files(dir_.GetPath(), /*recursive=*/true, base::FileEnumerator::FILES);
+  std::vector<std::string> names;
+  for (base::FilePath f = files.Next(); !f.empty(); f = files.Next()) {
+    names.push_back(f.BaseName().value());
+    std::string bytes;
+    ASSERT_TRUE(base::ReadFileToString(f, &bytes));
+    EXPECT_EQ(bytes.find("MARKER-of-the-old-value"), std::string::npos) << f;
+  }
+  EXPECT_EQ(names, std::vector<std::string>{"Login Data"});
+}
+
+// The browser's Encryptor, with Thoron's provider as the browser makes it on
+// Linux, opens the engine's values and writes values the engine opens.
+TEST_F(ThoronReencryptTest, TheBrowsersEncryptorReadsAndWritesTheSameValues) {
+  base::test::TaskEnvironment tasks;
+  std::vector<std::pair<size_t, std::unique_ptr<os_crypt_async::KeyProvider>>> providers;
+  providers.emplace_back(20u, std::make_unique<os_crypt_async::ThoronPortableKeyProvider>(
+                                  std::vector<uint8_t>(key_.begin(), key_.end()), /*use_for_encryption=*/true));
+  os_crypt_async::OSCryptAsync crypt(std::move(providers));
+  scoped_refptr<os_crypt_async::Encryptor> encryptor;
+  base::RunLoop loop;
+  crypt.GetInstance(base::BindLambdaForTesting([&](scoped_refptr<os_crypt_async::Encryptor> e) {
+    encryptor = std::move(e);
+    loop.Quit();
+  }));
+  loop.Run();
+  ASSERT_TRUE(encryptor);
+  std::string plain;
+  ASSERT_TRUE(encryptor->DecryptString(EncryptWithPortableKey(key_, "from the engine"), &plain));
+  EXPECT_EQ(plain, "from the engine");
+  std::string sealed;
+  ASSERT_TRUE(encryptor->EncryptString("from the browser", &sealed));
+  EXPECT_EQ(sealed.substr(0, 3), kPortableKeyTag);
+  EXPECT_EQ(DecryptWithPortableKey(key_, base::as_byte_span(sealed)), "from the browser");
+}
+
+// Removing the lock: each value of the copy's key goes back under Chromium's key,
+// read back; Chromium's own values stay as they are; no copy is left.
+TEST_F(ThoronReencryptTest, RemovingTheLockPutsEveryValueBackUnderChromiumsKey) {
+  const base::FilePath login = Make(
+      "Login Data", {"CREATE TABLE logins (id INTEGER PRIMARY KEY, password_value BLOB)"});
+  Insert(login, "INSERT INTO logins (password_value) VALUES (?)", EncryptWithPortableKey(key_, "hunter2"));
+  Insert(login, "INSERT INTO logins (password_value) VALUES (?)", "v10 as Chromium wrote it");
+  const base::FilePath cookies = Make(
+      "Network/Cookies", {"CREATE TABLE cookies (host_key TEXT, encrypted_value BLOB)"});
+  Insert(cookies, "INSERT INTO cookies (host_key, encrypted_value) VALUES ('a', ?)",
+         EncryptWithPortableKey(key_, "cookie"));
+  std::array<uint8_t, 16> chromium_key;
+  chromium_key.fill(5);
+
+  ReencryptCounts counts;
+  ASSERT_EQ(ReturnProfileToChromium(dir_.GetPath(), key_, chromium_key, "v11", &counts), ReencryptResult::kDone);
+  EXPECT_EQ(counts.passwords, 1);
+  EXPECT_EQ(counts.cookies, 1);
+  EXPECT_EQ(counts.already, 1);
+  const std::vector<std::string> values = Values(login, "SELECT password_value FROM logins ORDER BY id");
+  ASSERT_EQ(values.size(), 2u);
+  EXPECT_EQ(values[0].substr(0, 3), "v11");
+  EXPECT_EQ(DecryptForChromiumLinux(chromium_key, "v11", base::as_byte_span(values[0])), "hunter2");
+  EXPECT_EQ(values[1], "v10 as Chromium wrote it");
+  const std::vector<std::string> jar = Values(cookies, "SELECT encrypted_value FROM cookies");
+  ASSERT_EQ(jar.size(), 1u);
+  EXPECT_EQ(DecryptForChromiumLinux(chromium_key, "v11", base::as_byte_span(jar[0])), "cookie");
+  EXPECT_FALSE(base::PathExists(dir_.GetPath().Append("Login Data.thoron-before-lock")));
+  EXPECT_FALSE(base::PathExists(dir_.GetPath().Append("Network/Cookies.thoron-before-lock")));
+
+  // and a lock again after it: the same values under a portable key once more
+  ReencryptCounts again;
+  auto read = [&chromium_key](base::span<const uint8_t> v) {
+    return DecryptForChromiumLinux(chromium_key, "v11", v);
+  };
+  ASSERT_EQ(ReencryptProfile(dir_.GetPath(), read, key_, &again), ReencryptResult::kDone);
+  EXPECT_EQ(again.passwords, 1);
+  EXPECT_EQ(again.unreadable, 1);  // the "v10" stand-in opens with neither
+}
+
+// Chromium's own Linux format, pinned by a vector OpenSSL made: AES-128-CBC with
+// PKCS#7 padding and sixteen spaces as the IV, under Chromium's fixed key
+// (PBKDF2-HMAC-SHA1 of "peanuts" with "saltysalt", one round, 16 bytes).
+TEST_F(ThoronReencryptTest, ChromiumsFormatIsOpenSslsAes128Cbc) {
+  const std::array<uint8_t, 16> fixed_key = {0xfd, 0x62, 0x1f, 0xe5, 0xa2, 0xb4, 0x02, 0x53,
+                                             0x9d, 0xfa, 0x14, 0x7c, 0xa9, 0x27, 0x27, 0x78};
+  const std::array<uint8_t, 16> vector = {0x37, 0xf3, 0x31, 0xb8, 0xd6, 0xaf, 0xe7, 0xed,
+                                          0x0b, 0x38, 0x77, 0x1e, 0xe5, 0x7c, 0x38, 0x17};
+  std::string expected = "v10";
+  expected.append(base::as_string_view(vector));
+  EXPECT_EQ(EncryptForChromiumLinux(fixed_key, "v10", "made-up-secret"), expected);
+  EXPECT_EQ(DecryptForChromiumLinux(fixed_key, "v10", base::as_byte_span(expected)), "made-up-secret");
+  EXPECT_EQ(DecryptForChromiumLinux(fixed_key, "v11", base::as_byte_span(expected)), std::nullopt);
+}
+
+// A value read with another PC's keyring key can decrypt to bytes with good
+// padding (about one in 256): what it reads to must be what its column holds,
+// or the value is left as it was, never encrypted again as garbage.
+TEST_F(ThoronReencryptTest, AValueReadWithAnotherPcsKeyIsLeftAsItWas) {
+  const base::FilePath cookies = Make(
+      "Network/Cookies", {"CREATE TABLE meta (key LONGVARCHAR NOT NULL UNIQUE PRIMARY KEY, value LONGVARCHAR)",
+                          "INSERT INTO meta (key, value) VALUES ('version', '24')",
+                          "CREATE TABLE cookies (host_key TEXT, encrypted_value BLOB)"});
+  const std::array<uint8_t, crypto::hash::kSha256Size> hash =
+      crypto::hash::Sha256(base::as_byte_span(std::string_view("example.org")));
+  Insert(cookies, "INSERT INTO cookies (host_key, encrypted_value) VALUES ('example.org', ?)",
+         "old:" + std::string(base::as_string_view(hash)) + "a cookie");
+  Insert(cookies, "INSERT INTO cookies (host_key, encrypted_value) VALUES ('example.org', ?)",
+         "old:bytes without the host's hash");
+  const base::FilePath login = Make("Login Data", {"CREATE TABLE logins (id INTEGER PRIMARY KEY, password_value BLOB)"});
+  Insert(login, "INSERT INTO logins (password_value) VALUES (?)", std::string("old:\xff\xfe not text", 15));
+  Insert(login, "INSERT INTO logins (password_value) VALUES (?)", "old:a password");
+
+  ReencryptCounts counts;
+  ASSERT_EQ(ReencryptProfile(dir_.GetPath(), ReadOld, key_, &counts), ReencryptResult::kDone);
+  EXPECT_EQ(counts.cookies, 1);
+  EXPECT_EQ(counts.passwords, 1);
+  EXPECT_EQ(counts.unreadable, 2);
+  const std::vector<std::string> jar = Values(cookies, "SELECT encrypted_value FROM cookies ORDER BY rowid");
+  ASSERT_EQ(jar.size(), 2u);
+  EXPECT_TRUE(DecryptWithPortableKey(key_, base::as_byte_span(jar[0])));
+  EXPECT_EQ(jar[1], "old:bytes without the host's hash");
+  const std::vector<std::string> logins = Values(login, "SELECT password_value FROM logins ORDER BY id");
+  ASSERT_EQ(logins.size(), 2u);
+  EXPECT_EQ(logins[0], std::string("old:\xff\xfe not text", 15));
+  EXPECT_EQ(DecryptWithPortableKey(key_, base::as_byte_span(logins[1])), "a password");
+}
+
+// A start of a copy whose values are done (or not readable) writes nothing and
+// makes no copy: the work is looked for at every start of a locked copy.
+TEST_F(ThoronReencryptTest, NothingToTurnLeavesTheDatabaseAlone) {
+  const base::FilePath login = Make("Login Data", {"CREATE TABLE logins (id INTEGER PRIMARY KEY, password_value BLOB)"});
+  Insert(login, "INSERT INTO logins (password_value) VALUES (?)", "old:hunter2");
+  Insert(login, "INSERT INTO logins (password_value) VALUES (?)", "unreadable");
+  ReencryptCounts first;
+  ASSERT_EQ(ReencryptProfile(dir_.GetPath(), ReadOld, key_, &first), ReencryptResult::kDone);
+  EXPECT_EQ(first.passwords, 1);
+  const std::optional<std::vector<uint8_t>> before = base::ReadFileToBytes(login);
+  ReencryptCounts again;
+  ASSERT_EQ(ReencryptProfile(dir_.GetPath(), ReadOld, key_, &again), ReencryptResult::kDone);
+  EXPECT_EQ(again.passwords, 0);
+  EXPECT_EQ(again.unreadable, 1);
+  EXPECT_EQ(base::ReadFileToBytes(login), before);
+  EXPECT_FALSE(base::PathExists(dir_.GetPath().Append("Login Data.thoron-before-lock")));
+}
+
+// Web Data's own values (cards, stored CVCs, sign-in tokens) are locked too.
+TEST_F(ThoronReencryptTest, CardsAndSignInTokensAreEncryptedToo) {
+  const base::FilePath web = Make("Web Data", {"CREATE TABLE credit_cards (guid TEXT, card_number_encrypted BLOB)",
+                                               "CREATE TABLE local_stored_cvc (guid TEXT, value_encrypted BLOB)",
+                                               "CREATE TABLE token_service (service TEXT, encrypted_token BLOB)"});
+  Insert(web, "INSERT INTO credit_cards (guid, card_number_encrypted) VALUES ('c', ?)", "old:4111111111111111");
+  Insert(web, "INSERT INTO local_stored_cvc (guid, value_encrypted) VALUES ('c', ?)", "old:123");
+  Insert(web, "INSERT INTO token_service (service, encrypted_token) VALUES ('s', ?)", "old:a refresh token");
+  ReencryptCounts counts;
+  ASSERT_EQ(ReencryptProfile(dir_.GetPath(), ReadOld, key_, &counts), ReencryptResult::kDone);
+  EXPECT_EQ(counts.other, 3);
+  const std::vector<std::string> card = Values(web, "SELECT card_number_encrypted FROM credit_cards");
+  ASSERT_EQ(card.size(), 1u);
+  EXPECT_EQ(DecryptWithPortableKey(key_, base::as_byte_span(card[0])), "4111111111111111");
+  const std::vector<std::string> token = Values(web, "SELECT encrypted_token FROM token_service");
+  ASSERT_EQ(token.size(), 1u);
+  EXPECT_EQ(DecryptWithPortableKey(key_, base::as_byte_span(token[0])), "a refresh token");
+}
+
+// A lock's values with no key file: found in the password and cookie
+// databases, and set aside (not deleted) for a start without the key file.
+TEST_F(ThoronReencryptTest, ALocksValuesAreFoundAndSetAside) {
+  const base::FilePath login = Make("Login Data", {"CREATE TABLE logins (id INTEGER PRIMARY KEY, password_value BLOB)"});
+  const base::FilePath web = Make("Web Data", {"CREATE TABLE credit_cards (guid TEXT, card_number_encrypted BLOB)"});
+  Insert(web, "INSERT INTO credit_cards (guid, card_number_encrypted) VALUES ('c', ?)",
+         EncryptWithPortableKey(key_, "4111111111111111"));
+  EXPECT_TRUE(FilesWithPortableValues(dir_.GetPath()).empty());
+  Insert(login, "INSERT INTO logins (password_value) VALUES (?)", EncryptWithPortableKey(key_, "hunter2"));
+  EXPECT_EQ(FilesWithPortableValues(dir_.GetPath()), std::vector<base::FilePath>{login});
+  ASSERT_TRUE(SetAsideLockedDatabases(dir_.GetPath()));
+  EXPECT_FALSE(base::PathExists(login));
+  EXPECT_TRUE(base::PathExists(dir_.GetPath().Append("Login Data.thoron-without-key")));
+  EXPECT_TRUE(base::PathExists(web));  // Web Data holds more than locked values: it stays
+  EXPECT_TRUE(FilesWithPortableValues(dir_.GetPath()).empty());
+}
+
+}  // namespace
+}  // namespace thoron_portable_key
diff --git a/components/thoron_portable_key/secret_bytes.cc b/components/thoron_portable_key/secret_bytes.cc
new file mode 100644
index 0000000000000000000000000000000000000000..b00056db4e6bd9934eb4c1ce0b487cbd9a5403d3
--- /dev/null
+++ b/components/thoron_portable_key/secret_bytes.cc
@@ -0,0 +1,65 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_portable_key/secret_bytes.h"
+
+#include <utility>
+
+#include "third_party/boringssl/src/include/openssl/crypto.h"
+#include "third_party/boringssl/src/include/openssl/mem.h"
+
+namespace thoron_portable_key {
+
+void Wipe(base::span<uint8_t> bytes) {
+  if (!bytes.empty()) {
+    OPENSSL_cleanse(bytes.data(), bytes.size());
+  }
+}
+
+void WipeString(std::string& text) {
+  if (!text.empty()) {
+    OPENSSL_cleanse(text.data(), text.size());
+  }
+}
+
+void WipeString(std::u16string& text) {
+  if (!text.empty()) {
+    OPENSSL_cleanse(text.data(), text.size() * sizeof(char16_t));
+  }
+}
+
+SecretBytes::SecretBytes() = default;
+
+SecretBytes::SecretBytes(size_t size) : bytes_(size, 0) {}
+
+SecretBytes::SecretBytes(base::span<const uint8_t> bytes)
+    : bytes_(bytes.begin(), bytes.end()) {}
+
+SecretBytes::SecretBytes(SecretBytes&& other) : bytes_(std::move(other.bytes_)) {
+  other.bytes_.clear();
+}
+
+SecretBytes& SecretBytes::operator=(SecretBytes&& other) {
+  if (this != &other) {
+    Clear();
+    bytes_ = std::move(other.bytes_);
+    other.bytes_.clear();
+  }
+  return *this;
+}
+
+SecretBytes::~SecretBytes() {
+  Clear();
+}
+
+void SecretBytes::Clear() {
+  Wipe(bytes_);
+  bytes_.clear();
+}
+
+bool SecretBytes::operator==(const SecretBytes& other) const {
+  return bytes_.size() == other.bytes_.size() &&
+         CRYPTO_memcmp(bytes_.data(), other.bytes_.data(), bytes_.size()) == 0;
+}
+
+}  // namespace thoron_portable_key
diff --git a/components/thoron_portable_key/secret_bytes.h b/components/thoron_portable_key/secret_bytes.h
new file mode 100644
index 0000000000000000000000000000000000000000..dfd28c953c0c718c90b10617196d422f58dc8fcf
--- /dev/null
+++ b/components/thoron_portable_key/secret_bytes.h
@@ -0,0 +1,53 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_PORTABLE_KEY_SECRET_BYTES_H_
+#define COMPONENTS_THORON_PORTABLE_KEY_SECRET_BYTES_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <string>
+#include <vector>
+
+#include "base/containers/span.h"
+
+namespace thoron_portable_key {
+
+// Bytes that are a secret (a passphrase, a key): wiped when they go, and
+// never copied by accident (moves only).
+class SecretBytes {
+ public:
+  SecretBytes();
+  explicit SecretBytes(size_t size);
+  explicit SecretBytes(base::span<const uint8_t> bytes);
+  SecretBytes(SecretBytes&& other);
+  SecretBytes& operator=(SecretBytes&& other);
+  SecretBytes(const SecretBytes&) = delete;
+  SecretBytes& operator=(const SecretBytes&) = delete;
+  ~SecretBytes();
+
+  base::span<uint8_t> span() { return bytes_; }
+  base::span<const uint8_t> span() const { return bytes_; }
+  size_t size() const { return bytes_.size(); }
+  bool empty() const { return bytes_.empty(); }
+  // Wipes the bytes and makes it empty.
+  void Clear();
+
+  bool operator==(const SecretBytes& other) const;
+
+ private:
+  std::vector<uint8_t> bytes_;
+};
+
+// Overwrites `bytes` with zeros in a way the compiler keeps.
+void Wipe(base::span<uint8_t> bytes);
+
+// The same for text that held a secret (a passphrase, a key read from a pipe,
+// a value's plain text), before it is freed or emptied.
+void WipeString(std::string& text);
+void WipeString(std::u16string& text);
+
+}  // namespace thoron_portable_key
+
+#endif  // COMPONENTS_THORON_PORTABLE_KEY_SECRET_BYTES_H_
