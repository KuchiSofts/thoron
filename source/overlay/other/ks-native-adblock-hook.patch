+
+#ifndef COMPONENTS_THORON_MAIL_MAIL_FEED_H_
+#define COMPONENTS_THORON_MAIL_MAIL_FEED_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/time/time.h"
+#include "base/values.h"
+
+namespace thoron_mail {
+
+// One unread message, as Gmail's feed of unread mail tells of it.
+struct MailMessage {
+  MailMessage();
+  MailMessage(const MailMessage&);
+  MailMessage& operator=(const MailMessage&);
+  ~MailMessage();
+
+  std::string id;  // Gmail's own, for telling new mail from mail seen before
+  std::string subject;
+  std::string snippet;
+  std::string from_name;
+  std::string from_email;
+  // the conversation in Gmail (https://mail.google.com/ only; empty if not)
+  std::string link;
+  base::Time issued;
+};
+
+// One Google account the browser is signed in to: Gmail's u/<index>.
+struct MailAccount {
+  MailAccount();
+  MailAccount(const MailAccount&);
+  MailAccount& operator=(const MailAccount&);
+  ~MailAccount();
+
+  int index = 0;
+  std::string email;
+  int unread = 0;
+  // the newest unread messages, as many as the feed has (at most 20)
+  std::vector<MailMessage> latest;
+};
+
+// The account of Gmail's feed of unread mail (Atom 0.3) for u/`index`, from
+// the tree the data decoder (a sandboxed process) parsed it into. Nullopt for
+// anything else.
+std::optional<MailAccount> AccountFromFeed(const base::Value& feed, int index);
+
+// "2026-11-15T10:20:30Z" (the feed's times), or a null time.
+base::Time FeedTime(const std::string& text);
+
+// `link` if it opens something of Gmail's, made https; else empty.
+std::string GmailLink(const std::string& link);
+
+}  // namespace thoron_mail
+
+#endif  // COMPONENTS_THORON_MAIL_MAIL_FEED_H_
