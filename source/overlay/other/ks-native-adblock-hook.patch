+        args[1].GetString(), args[2].GetString(),
+        base::BindOnce(&MailHandler::AnswerImported, weak_factory_.GetWeakPtr(),
+                       args[0].GetString()));
+  }
+
+  void OpenManage(const base::ListValue& args) {
+    Center().OpenManagePage(!args.empty() && args[0].is_bool() &&
+                            args[0].GetBool());
+    CloseMenu(args);
+  }
+
+  void Answer(const std::string& id, std::string text) {
+    if (IsJavascriptAllowed()) {
+      ResolveJavascriptCallback(base::Value(id), base::Value(std::move(text)));
+    }
+  }
+
+  void AnswerImported(const std::string& id, std::string error, int accounts) {
