@@ -0,0 +1,36 @@
+# Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+# The passphrase of a portable copy in the browser (ROADMAP P4.9): the unlock
+# before the browser starts (on Windows in Thoron's own window, on Linux with
+# what the copy's launcher asked for). Elsewhere the target is empty.
+source_set("thoron_portable") {
+  sources = []
+  if (is_win) {
+    sources += [
+      "unlock_dialog_win.cc",
+      "unlock_dialog_win.h",
+      "unlock_win.cc",
+      "unlock_win.h",
+    ]
+    deps = [
+      "//base",
+      "//components/os_crypt/async/browser",
+      "//components/prefs",
+      "//components/thoron_portable_key",
+    ]
+  }
+  if (is_linux) {
+    sources += [
+      "unlock_linux.cc",
+      "unlock_linux.h",
+    ]
+    deps = [
+      "//base",
+      "//components/os_crypt/async/browser",
+      "//components/prefs",
+      "//components/thoron_portable_key",
+      "//components/user_data_importer/chromium_family",
+    ]
+  }
+}
