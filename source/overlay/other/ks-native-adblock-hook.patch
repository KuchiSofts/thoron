+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_portable_key/key_file.h"
+
+#include <string_view>
+#include <utility>
+
+#include "base/check_op.h"
+#include "base/compiler_specific.h"
+#include "base/containers/span_reader.h"
+#include "base/numerics/byte_conversions.h"
+#include "base/numerics/safe_conversions.h"
+#include "base/strings/utf_string_conversion_utils.h"
+#include "components/thoron_portable_key/os_key_store.h"
+#include "crypto/aead.h"
+#include "crypto/hash.h"
+#include "crypto/hmac.h"
+#include "crypto/kdf.h"
+#include "crypto/random.h"
+#include "third_party/icu/source/common/unicode/normalizer2.h"
+#include "third_party/icu/source/common/unicode/unistr.h"
+
+namespace thoron_portable_key {
+
+namespace {
+
+constexpr std::string_view kMagic = "THORONPK";
+constexpr uint8_t kPassphraseKind = 1;
+constexpr uint8_t kRecoveryKind = 2;
+constexpr uint8_t kRememberedPcKind = 3;
+constexpr size_t kPassphraseBody = 4 + 4 + 1 + kSaltBytes + kNonceBytes + kSealedBytes;
+constexpr size_t kRecoveryBody = kSaltBytes + kNonceBytes + kSealedBytes;
+constexpr std::string_view kRecoveryInfo = "Thoron portable key: recovery";
+constexpr std::string_view kMacInfo = "Thoron portable key: file";
+// A passphrase longer than this (in UTF-16 units) is not taken.
+constexpr size_t kMostPassphraseUnits = 1024;
+
+void Append(std::vector<uint8_t>& out, base::span<const uint8_t> bytes) {
+  out.insert(out.end(), bytes.begin(), bytes.end());
+}
+
+// What a lock's seal binds besides the profile key: the file's magic and
+// format, the lock's kind, and its body up to the sealed bytes.
+std::vector<uint8_t> AssociatedData(uint8_t kind,
+                                    base::span<const uint8_t> body_head) {
+  std::vector<uint8_t> data;
+  Append(data, base::as_byte_span(kMagic));
+  data.push_back(kFormat);
+  data.push_back(kind);
+  Append(data, body_head);
+  return data;
+}
+
+std::vector<uint8_t> PassphraseHead(const PassphraseLock& lock) {
+  std::vector<uint8_t> head;
+  Append(head, base::U32ToLittleEndian(lock.params.memory_kib));
+  Append(head, base::U32ToLittleEndian(lock.params.passes));
+  head.push_back(base::checked_cast<uint8_t>(lock.params.lanes));
+  Append(head, lock.salt);
+  Append(head, lock.nonce);
+  return head;
+}
+
+std::vector<uint8_t> RecoveryHead(const RecoveryLock& lock) {
+  std::vector<uint8_t> head;
+  Append(head, lock.salt);
+  Append(head, lock.nonce);
+  return head;
+}
+
+std::array<uint8_t, kMacBytes> MacOf(base::span<const uint8_t> signed_bytes,
+                                     const SecretBytes& profile_key) {
+  std::array<uint8_t, 32> mac_key = crypto::kdf::Hkdf<32>(
+      crypto::hash::kSha256, profile_key.span(), {},
+      base::as_byte_span(kMacInfo));
+  std::array<uint8_t, kMacBytes> mac =
+      crypto::hmac::SignSha256(mac_key, signed_bytes);
+  Wipe(mac_key);
+  return mac;
+}
+
+bool MacHolds(const KeyFile& file, const SecretBytes& profile_key) {
+  std::array<uint8_t, 32> mac_key = crypto::kdf::Hkdf<32>(
+      crypto::hash::kSha256, profile_key.span(), {},
+      base::as_byte_span(kMacInfo));
+  const bool holds =
+      crypto::hmac::VerifySha256(mac_key, SignedBytesOf(file), file.mac);
+  Wipe(mac_key);
+  return holds;
+}
+
+// The profile key out of a seal, checked against the file's MAC.
+std::optional<SecretBytes> Unseal(const KeyFile& file,
+                                  base::span<const uint8_t> sealing_key,
+                                  base::span<const uint8_t> sealed,
+                                  base::span<const uint8_t> nonce,
+                                  base::span<const uint8_t> associated_data,
+                                  OpenProblem wrong,
+                                  OpenProblem* problem) {
+  std::optional<std::vector<uint8_t>> opened = crypto::aead::Open(
+      crypto::aead::AES_256_GCM, sealing_key, sealed, nonce, associated_data);
+  if (!opened || opened->size() != kProfileKeyBytes) {
+    if (opened) {
+      Wipe(*opened);
+    }
+    *problem = wrong;
+    return std::nullopt;
+  }
+  SecretBytes key(*opened);
+  Wipe(*opened);
+  if (!MacHolds(file, key)) {
+    *problem = OpenProblem::kChanged;
+    return std::nullopt;
+  }
+  *problem = OpenProblem::kNone;
+  return key;
+}
+
+std::array<uint8_t, 32> RecoverySealingKey(const SecretBytes& recovery_key,
+                                           base::span<const uint8_t> salt) {
+  return crypto::kdf::Hkdf<32>(crypto::hash::kSha256, recovery_key.span(),
+                               salt, base::as_byte_span(kRecoveryInfo));
+}
+
+}  // namespace
+
+RememberedPcLock::RememberedPcLock() = default;
+RememberedPcLock::RememberedPcLock(const RememberedPcLock&) = default;
+RememberedPcLock& RememberedPcLock::operator=(const RememberedPcLock&) =
+    default;
+RememberedPcLock::~RememberedPcLock() = default;
+
+KeyFile::KeyFile() = default;
+KeyFile::KeyFile(const KeyFile&) = default;
+KeyFile& KeyFile::operator=(const KeyFile&) = default;
+KeyFile::~KeyFile() = default;
+
+std::optional<KeyFile> ParseKeyFile(base::span<const uint8_t> bytes,
+                                    ReadProblem* problem) {
+  *problem = ReadProblem::kDamaged;
+  base::SpanReader reader(bytes);
+  std::optional<base::span<const uint8_t>> magic = reader.Read(kMagic.size());
+  if (!magic || *magic != base::as_byte_span(kMagic)) {
+    *problem = ReadProblem::kNotAKeyFile;
+    return std::nullopt;
+  }
+  uint8_t format = 0;
+  uint8_t count = 0;
+  if (!reader.ReadU8LittleEndian(format)) {
+    return std::nullopt;
+  }
+  if (format != kFormat) {
+    *problem = format > kFormat ? ReadProblem::kNewerFormat
+                                : ReadProblem::kDamaged;
+    return std::nullopt;
+  }
+  if (!reader.ReadU8LittleEndian(count) || count < 1 || count > kMostLocks) {
+    return std::nullopt;
+  }
+  KeyFile file;
+  // the order of the kinds: passphrase, recovery, remembered PCs
+  uint8_t last_kind = 0;
+  for (uint8_t i = 0; i < count; ++i) {
+    uint8_t kind = 0;
+    uint16_t length = 0;
+    if (!reader.ReadU8LittleEndian(kind) ||
+        !reader.ReadU16LittleEndian(length)) {
+      return std::nullopt;
+    }
+    std::optional<base::span<const uint8_t>> body = reader.Read(length);
+    if (!body) {
+      return std::nullopt;
+    }
+    // one passphrase lock, first; one recovery lock at most; then PCs
+    if (i == 0 ? kind != kPassphraseKind
+               : (kind < last_kind || kind == kPassphraseKind ||
+                  (kind == kRecoveryKind && last_kind == kRecoveryKind))) {
+      return std::nullopt;
+    }
+    last_kind = kind;
+    base::SpanReader part(*body);
+    if (kind == kPassphraseKind) {
+      uint8_t lanes = 0;
+      PassphraseLock& lock = file.passphrase;
+      if (length != kPassphraseBody ||
+          !part.ReadU32LittleEndian(lock.params.memory_kib) ||
+          !part.ReadU32LittleEndian(lock.params.passes) ||
+          !part.ReadU8LittleEndian(lanes) || !part.ReadCopy(lock.salt) ||
+          !part.ReadCopy(lock.nonce) || !part.ReadCopy(lock.sealed)) {
+        return std::nullopt;
+      }
+      lock.params.lanes = lanes;
+    } else if (kind == kRecoveryKind) {
+      RecoveryLock lock;
+      if (length != kRecoveryBody || !part.ReadCopy(lock.salt) ||
+          !part.ReadCopy(lock.nonce) || !part.ReadCopy(lock.sealed)) {
+        return std::nullopt;
+      }
+      file.recovery = lock;
+    } else if (kind == kRememberedPcKind) {
+      if (length < 1 || length > kMostRememberedPcBytes ||
+          file.remembered_pcs.size() == kMostRememberedPcs) {
+        return std::nullopt;
+      }
+      RememberedPcLock lock;
+      lock.blob.assign(body->begin(), body->end());
+      file.remembered_pcs.push_back(std::move(lock));
+    } else {
+      return std::nullopt;
+    }
+  }
+  if (!reader.ReadCopy(file.mac) || reader.remaining() != 0) {
+    return std::nullopt;
+  }
+  const Argon2Params& params = file.passphrase.params;
+  if (params.memory_kib < kFloor.memory_kib || params.passes < kFloor.passes ||
+      params.lanes < kFloor.lanes) {
+    *problem = ReadProblem::kTooWeak;
+    return std::nullopt;
+  }
+  if (!AreAcceptable(params)) {
+    *problem = ReadProblem::kTooCostly;
+    return std::nullopt;
+  }
+  *problem = ReadProblem::kNone;
+  return file;
+}
+
+std::vector<uint8_t> SignedBytesOf(const KeyFile& file) {
+  CHECK_LE(file.remembered_pcs.size(), kMostRememberedPcs);
+  std::vector<uint8_t> out;
+  Append(out, base::as_byte_span(kMagic));
+  out.push_back(kFormat);
+  out.push_back(base::checked_cast<uint8_t>(
+      1 + (file.recovery ? 1 : 0) + file.remembered_pcs.size()));
+  auto lock = [&out](uint8_t kind, base::span<const uint8_t> head,
+                     base::span<const uint8_t> tail) {
+    out.push_back(kind);
+    Append(out, base::U16ToLittleEndian(
+                    base::checked_cast<uint16_t>(head.size() + tail.size())));
+    Append(out, head);
+    Append(out, tail);
+  };
+  lock(kPassphraseKind, PassphraseHead(file.passphrase),
+       file.passphrase.sealed);
+  if (file.recovery) {
+    lock(kRecoveryKind, RecoveryHead(*file.recovery), file.recovery->sealed);
+  }
+  for (const RememberedPcLock& pc : file.remembered_pcs) {
+    CHECK(!pc.blob.empty());
+    CHECK_LE(pc.blob.size(), kMostRememberedPcBytes);
+    lock(kRememberedPcKind, pc.blob, {});
+  }
+  return out;
+}
+
+bool IsSignedBy(const KeyFile& file, const SecretBytes& profile_key) {
+  return profile_key.size() == kProfileKeyBytes && MacHolds(file, profile_key);
+}
+
+std::vector<uint8_t> SerializeKeyFile(const KeyFile& file,
+                                      const SecretBytes& profile_key) {
+  std::vector<uint8_t> out = SignedBytesOf(file);
+  Append(out, MacOf(out, profile_key));
+  return out;
+}
+
+namespace {
+
+std::vector<uint8_t> RemovalProofInput(const KeyFile& file) {
+  static constexpr std::string_view kLabel = "Thoron portable: remove this lock";
+  std::vector<uint8_t> data(kLabel.begin(), kLabel.end());
+  data.insert(data.end(), file.mac.begin(), file.mac.end());
+  return data;
+}
+
+}  // namespace
+
+std::array<uint8_t, kMacBytes> RemovalProof(const KeyFile& file,
+                                            const SecretBytes& profile_key) {
+  CHECK_EQ(profile_key.size(), kProfileKeyBytes);
+  return crypto::hmac::SignSha256(profile_key.span(), RemovalProofInput(file));
+}
+
+bool IsRemovalProof(const KeyFile& file,
+                    const SecretBytes& profile_key,
+                    base::span<const uint8_t> proof) {
+  if (profile_key.size() != kProfileKeyBytes || proof.size() != kMacBytes) {
+    return false;
+  }
+  return crypto::hmac::VerifySha256(profile_key.span(), RemovalProofInput(file),
+                                    proof.first<kMacBytes>());
+}
+
+std::optional<SecretBytes> PassphraseFromTyped(std::u16string& typed) {
+  std::optional<SecretBytes> result;
+  UErrorCode status = U_ZERO_ERROR;
+  const icu::Normalizer2* nfc = icu::Normalizer2::getNFCInstance(status);
+  if (U_SUCCESS(status) && typed.size() <= kMostPassphraseUnits) {
+    // a read-only view of `typed`, not a copy
+    const icu::UnicodeString view(false, typed.data(),
+                                  static_cast<int32_t>(typed.size()));
+    icu::UnicodeString normal = nfc->normalize(view, status);
+    if (U_SUCCESS(status) && !normal.isBogus()) {
+      const int32_t length = normal.length();
+      const std::u16string_view units(normal.getBuffer(),
+                                      static_cast<size_t>(length));
+      std::string utf8;
+      // reserved once, so that it never moves and leaves no copy behind
+      utf8.reserve(units.size() * 3);
+      size_t characters = 0;
+      bool text = true;
+      for (size_t i = 0; i < units.size(); ++i) {
+        base_icu::UChar32 c = 0;
+        // a lone surrogate is not text
+        if (!base::ReadUnicodeCharacter(units, &i, &c)) {
+          text = false;
+          break;
+        }
+        base::WriteUnicodeCharacter(c, &utf8);
+        ++characters;
+      }
+      if (text && characters >= kMinPassphraseCharacters) {
+        result.emplace(base::as_byte_span(utf8));
+      }
+      Wipe(base::as_writable_byte_span(utf8));
+      // the normalized copy is wiped before it goes
+      if (length > 0) {
+        char16_t* buffer = normal.getBuffer(length);
+        if (buffer) {
+          // SAFETY: getBuffer(n) gives at least n writable units.
+          Wipe(base::as_writable_byte_span(UNSAFE_BUFFERS(
+              base::span(buffer, static_cast<size_t>(length)))));
+          normal.releaseBuffer(0);
+        }
+      }
+    }
+  }
+  Wipe(base::as_writable_byte_span(typed));
+  typed.clear();
+  return result;
+}
+
+std::optional<SecretBytes> OpenWithPassphrase(const KeyFile& file,
+                                              SecretBytes passphrase,
+                                              OpenProblem* problem) {
+  std::array<uint8_t, 32> sealing_key = {};
+  const PassphraseLock& lock = file.passphrase;
+  if (!Argon2id(passphrase.span(), lock.salt, lock.params, sealing_key)) {
+    passphrase.Clear();
+    *problem = OpenProblem::kCannotDerive;
+    return std::nullopt;
+  }
+  passphrase.Clear();
+  std::optional<SecretBytes> key =
+      Unseal(file, sealing_key, lock.sealed, lock.nonce,
+             AssociatedData(kPassphraseKind, PassphraseHead(lock)),
+             OpenProblem::kWrongSecret, problem);
+  Wipe(sealing_key);
+  return key;
+}
+
+std::optional<SecretBytes> OpenWithRecoveryKey(const KeyFile& file,
+                                               const SecretBytes& recovery_key,
+                                               OpenProblem* problem) {
+  if (!file.recovery) {
+    *problem = OpenProblem::kNoLock;
+    return std::nullopt;
+  }
+  const RecoveryLock& lock = *file.recovery;
+  std::array<uint8_t, 32> sealing_key =
+      RecoverySealingKey(recovery_key, lock.salt);
+  std::optional<SecretBytes> key =
+      Unseal(file, sealing_key, lock.sealed, lock.nonce,
+             AssociatedData(kRecoveryKind, RecoveryHead(lock)),
+             OpenProblem::kWrongSecret, problem);
+  Wipe(sealing_key);
+  return key;
+}
+
+std::optional<SecretBytes> OpenOnThisPc(const KeyFile& file,
+                                        OsKeyStore& store,
+                                        OpenProblem* problem) {
+  *problem = OpenProblem::kNoLock;
+  if (!store.IsAvailable()) {
+    return std::nullopt;
+  }
+  for (const RememberedPcLock& pc : file.remembered_pcs) {
+    std::optional<SecretBytes> key = store.Unprotect(pc.blob);
+    if (!key) {
+      continue;
+    }
+    if (key->size() != kProfileKeyBytes || !MacHolds(file, *key)) {
+      *problem = OpenProblem::kChanged;
+      return std::nullopt;
+    }
+    *problem = OpenProblem::kNone;
+    return key;
+  }
+  return std::nullopt;
+}
+
+std::optional<PassphraseLock> LockWithPassphrase(
+    const SecretBytes& profile_key,
+    SecretBytes passphrase,
+    const Argon2Params& params) {
+  CHECK_EQ(profile_key.size(), kProfileKeyBytes);
+  PassphraseLock lock;
+  lock.params = params;
+  crypto::RandBytes(lock.salt);
+  crypto::RandBytes(lock.nonce);
+  std::array<uint8_t, 32> sealing_key = {};
+  if (!Argon2id(passphrase.span(), lock.salt, params, sealing_key)) {
+    passphrase.Clear();
+    return std::nullopt;
+  }
+  passphrase.Clear();
+  const std::vector<uint8_t> sealed = crypto::aead::Seal(
+      crypto::aead::AES_256_GCM, sealing_key, profile_key.span(), lock.nonce,
+      AssociatedData(kPassphraseKind, PassphraseHead(lock)));
+  Wipe(sealing_key);
+  CHECK_EQ(sealed.size(), kSealedBytes);
+  base::span(lock.sealed).copy_from(sealed);
+  return lock;
+}
+
+RecoveryLock LockWithRecoveryKey(const SecretBytes& profile_key,
+                                 const SecretBytes& recovery_key) {
+  CHECK_EQ(profile_key.size(), kProfileKeyBytes);
+  RecoveryLock lock;
+  crypto::RandBytes(lock.salt);
+  crypto::RandBytes(lock.nonce);
+  std::array<uint8_t, 32> sealing_key =
+      RecoverySealingKey(recovery_key, lock.salt);
+  const std::vector<uint8_t> sealed = crypto::aead::Seal(
+      crypto::aead::AES_256_GCM, sealing_key, profile_key.span(), lock.nonce,
+      AssociatedData(kRecoveryKind, RecoveryHead(lock)));
+  Wipe(sealing_key);
+  CHECK_EQ(sealed.size(), kSealedBytes);
+  base::span(lock.sealed).copy_from(sealed);
+  return lock;
+}
+
+bool RememberThisPc(KeyFile& file,
+                    const SecretBytes& profile_key,
+                    OsKeyStore& store) {
+  if (!store.IsAvailable()) {
+    return false;
+  }
+  ForgetThisPc(file, store);
+  if (file.remembered_pcs.size() >= kMostRememberedPcs ||
+      1 + (file.recovery ? 1u : 0u) + file.remembered_pcs.size() >=
+          kMostLocks) {
+    return false;
+  }
+  std::optional<std::vector<uint8_t>> blob = store.Protect(profile_key.span());
+  if (!blob || blob->empty() || blob->size() > kMostRememberedPcBytes) {
+    return false;
+  }
+  RememberedPcLock lock;
+  lock.blob = std::move(*blob);
+  file.remembered_pcs.push_back(std::move(lock));
+  return true;
+}
+
+bool ForgetThisPc(KeyFile& file, OsKeyStore& store) {
+  if (!store.IsAvailable()) {
+    return false;
+  }
+  const size_t before = file.remembered_pcs.size();
+  std::erase_if(file.remembered_pcs, [&store](const RememberedPcLock& pc) {
+    if (!store.Unprotect(pc.blob).has_value()) {
+      return false;
+    }
+    // the system's own part goes too, so no older file opens here either
+    store.Forget(pc.blob);
+    return true;
+  });
+  return file.remembered_pcs.size() != before;
+}
+
+bool IsRememberedHere(const KeyFile& file, OsKeyStore& store) {
+  if (!store.IsAvailable()) {
+    return false;
+  }
+  for (const RememberedPcLock& pc : file.remembered_pcs) {
+    if (store.Unprotect(pc.blob)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+std::optional<KeyFile> NewKeyFile(const SecretBytes& profile_key,
+                                  SecretBytes passphrase,
+                                  const Argon2Params& params,
+                                  const SecretBytes* recovery_key) {
+  std::optional<PassphraseLock> lock =
+      LockWithPassphrase(profile_key, std::move(passphrase), params);
+  if (!lock) {
+    return std::nullopt;
+  }
+  KeyFile file;
+  file.passphrase = *lock;
+  if (recovery_key) {
+    file.recovery = LockWithRecoveryKey(profile_key, *recovery_key);
+  }
+  return file;
+}
+
+}  // namespace thoron_portable_key
diff --git a/components/thoron_portable_key/key_file.h b/components/thoron_portable_key/key_file.h
new file mode 100644
index 0000000000000000000000000000000000000000..5a5c49ea97e6174d2e5825798f691b71050e9e23
--- /dev/null
+++ b/components/thoron_portable_key/key_file.h
@@ -0,0 +1,201 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_PORTABLE_KEY_KEY_FILE_H_
+#define COMPONENTS_THORON_PORTABLE_KEY_KEY_FILE_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <array>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "components/thoron_portable_key/argon2id.h"
+#include "components/thoron_portable_key/secret_bytes.h"
+
+namespace thoron_portable_key {
+
+class OsKeyStore;
+
+// A portable copy's saved passwords and cookies stay encrypted the way
+// Chromium encrypts them (os_crypt's AES-256-GCM, "v10"), with the profile
+// key: 32 random bytes. The key file ("Thoron Portable Key" in the copy's
+// User Data folder) keeps that key locked, never in the clear (design 7.8,
+// threat model section 6):
+//
+//   - always with the passphrase: Argon2id of the passphrase, with the cost
+//     and the salt the file names, gives the key that seals the profile key
+//     (AES-256-GCM);
+//   - when the person kept one, with the recovery key (recovery_key.h): HKDF of
+//     its 128 random bits seals another copy;
+//   - for each PC the person told to remember the copy, a copy protected by
+//     that PC's system for that Windows account (OsKeyStore, DPAPI).
+//
+// Each sealed copy binds what the file says about it (its kind, its cost, its
+// salt), and the whole file carries an HMAC made with a key derived from the
+// profile key: once any copy opens, a file that was changed in any other way
+// is refused (threat model E2). A changed passphrase seals the same profile
+// key again; nothing else is encrypted again.
+//
+// Format 1, integers little-endian:
+//
+//   "THORONPK"  8 bytes
+//   format      1 byte, 1
+//   count       1 byte, how many locks follow (1 to kMostLocks)
+//   locks       each: kind (1 byte), length (2 bytes), body; in this order:
+//                 kind 1, the passphrase, exactly once, body 85 bytes:
+//                   memory KiB (4), passes (4), lanes (1), salt (16),
+//                   nonce (12), sealed profile key (48);
+//                 kind 2, the recovery key, at most once, body 76 bytes:
+//                   salt (16), nonce (12), sealed profile key (48);
+//                 kind 3, a remembered PC, at most kMostRememberedPcs,
+//                   body 1 to kMostRememberedPcBytes bytes: the system's blob
+//   mac         32 bytes: HMAC-SHA256 of everything before it
+//
+// Nothing else is accepted: no other kind, no other order, no trailing byte.
+
+inline constexpr size_t kProfileKeyBytes = 32;
+// The shortest passphrase taken, in characters (Unicode code points).
+inline constexpr size_t kMinPassphraseCharacters = 12;
+inline constexpr size_t kMostLocks = 8;
+inline constexpr size_t kMostRememberedPcs = 6;
+inline constexpr size_t kMostRememberedPcBytes = 2048;
+inline constexpr size_t kSaltBytes = 16;
+inline constexpr size_t kNonceBytes = 12;
+inline constexpr size_t kSealedBytes = kProfileKeyBytes + 16;
+inline constexpr size_t kMacBytes = 32;
+inline constexpr uint8_t kFormat = 1;
+
+struct PassphraseLock {
+  Argon2Params params;
+  std::array<uint8_t, kSaltBytes> salt = {};
+  std::array<uint8_t, kNonceBytes> nonce = {};
+  std::array<uint8_t, kSealedBytes> sealed = {};
+};
+
+struct RecoveryLock {
+  std::array<uint8_t, kSaltBytes> salt = {};
+  std::array<uint8_t, kNonceBytes> nonce = {};
+  std::array<uint8_t, kSealedBytes> sealed = {};
+};
+
+struct RememberedPcLock {
+  RememberedPcLock();
+  RememberedPcLock(const RememberedPcLock&);
+  RememberedPcLock& operator=(const RememberedPcLock&);
+  ~RememberedPcLock();
+
+  std::vector<uint8_t> blob;
+};
+
+// A key file as read, nothing opened yet.
+struct KeyFile {
+  KeyFile();
+  KeyFile(const KeyFile&);
+  KeyFile& operator=(const KeyFile&);
+  ~KeyFile();
+
+  PassphraseLock passphrase;
+  std::optional<RecoveryLock> recovery;
+  std::vector<RememberedPcLock> remembered_pcs;
+  std::array<uint8_t, kMacBytes> mac = {};
+};
+
+enum class ReadProblem {
+  kNone,
+  kNotAKeyFile,   // it does not start as one
+  kNewerFormat,   // a later Thoron's; this one cannot read it
+  kDamaged,       // anything else that is not format 1
+  kTooWeak,       // the passphrase's cost is below kFloor
+  kTooCostly,     // the passphrase's cost is above kCeiling
+};
+
+// What `bytes` hold, or nullopt and why not.
+std::optional<KeyFile> ParseKeyFile(base::span<const uint8_t> bytes,
+                                    ReadProblem* problem);
+
+// Everything a key file's MAC covers, in the order above (the file's bytes
+// without the MAC). ParseKeyFile takes only files that this gives back
+// byte for byte.
+std::vector<uint8_t> SignedBytesOf(const KeyFile& file);
+
+// True when `file`'s MAC was made with `profile_key`: nobody without the key
+// changed it. A file is only signed again after this holds.
+bool IsSignedBy(const KeyFile& file, const SecretBytes& profile_key);
+
+// The file's bytes with a MAC made with `profile_key`.
+std::vector<uint8_t> SerializeKeyFile(const KeyFile& file,
+                                      const SecretBytes& profile_key);
+
+// Linux removes a lock at the next start, from a request in Local State,
+// which anyone holding the drive can edit. The request carries this proof: an
+// HMAC with the profile key over a label and `file`'s own MAC, so only
+// someone who opened the copy can make it, and it fits only the key file it
+// was made for (a later lock's file has another MAC).
+std::array<uint8_t, kMacBytes> RemovalProof(const KeyFile& file,
+                                            const SecretBytes& profile_key);
+bool IsRemovalProof(const KeyFile& file,
+                    const SecretBytes& profile_key,
+                    base::span<const uint8_t> proof);
+
+// The passphrase as typed (a field's UTF-16 text) the way a key file takes
+// it: Unicode NFC, so that the same characters typed on another system give
+// the same bytes, in UTF-8. `typed` is wiped. nullopt when it is shorter than
+// kMinPassphraseCharacters or not text.
+std::optional<SecretBytes> PassphraseFromTyped(std::u16string& typed);
+
+enum class OpenProblem {
+  kNone,
+  kWrongSecret,   // the passphrase or the recovery key does not open it
+  kNoLock,        // no recovery key was kept, or no lock is for this PC
+  kChanged,       // a lock opened, but the file was changed since (its MAC)
+  kCannotDerive,  // Argon2id could not run (the memory it needs)
+};
+
+// The profile key, or nullopt and why not. The passphrase is wiped.
+std::optional<SecretBytes> OpenWithPassphrase(const KeyFile& file,
+                                              SecretBytes passphrase,
+                                              OpenProblem* problem);
+std::optional<SecretBytes> OpenWithRecoveryKey(const KeyFile& file,
+                                               const SecretBytes& recovery_key,
+                                               OpenProblem* problem);
+// With the first lock this PC's store opens, if any.
+std::optional<SecretBytes> OpenOnThisPc(const KeyFile& file,
+                                        OsKeyStore& store,
+                                        OpenProblem* problem);
+
+// The locks, made with the profile key at hand. The passphrase is wiped.
+// nullopt when `params` are not acceptable or Argon2id cannot run.
+std::optional<PassphraseLock> LockWithPassphrase(
+    const SecretBytes& profile_key,
+    SecretBytes passphrase,
+    const Argon2Params& params);
+RecoveryLock LockWithRecoveryKey(const SecretBytes& profile_key,
+                                 const SecretBytes& recovery_key);
+
+// "Remember this PC": `file` gets a lock this PC's store opens, in place of
+// any it had. False when the store is not available, refuses, or the file has
+// no room for one more PC.
+bool RememberThisPc(KeyFile& file,
+                    const SecretBytes& profile_key,
+                    OsKeyStore& store);
+// "Forget this PC": every lock this PC's store opens is removed; true when
+// there was one.
+bool ForgetThisPc(KeyFile& file, OsKeyStore& store);
+// True when a lock in `file` is this PC's.
+bool IsRememberedHere(const KeyFile& file, OsKeyStore& store);
+
+// A new key file for `profile_key`: its passphrase lock, and a recovery lock
+// when `recovery_key` is given. nullopt when the passphrase lock cannot be
+// made.
+std::optional<KeyFile> NewKeyFile(const SecretBytes& profile_key,
+                                  SecretBytes passphrase,
+                                  const Argon2Params& params,
+                                  const SecretBytes* recovery_key);
+
+}  // namespace thoron_portable_key
+
+#endif  // COMPONENTS_THORON_PORTABLE_KEY_KEY_FILE_H_
diff --git a/components/thoron_portable_key/key_file_fuzzer.cc b/components/thoron_portable_key/key_file_fuzzer.cc
new file mode 100644
index 0000000000000000000000000000000000000000..2581e26d32d4a17cd033038000f79dd507e56277
--- /dev/null
+++ b/components/thoron_portable_key/key_file_fuzzer.cc
@@ -0,0 +1,41 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Coverage-guided fuzzing of the key file's reader (ROADMAP P4.9, threat model
+// E2 and E3): the input is a key file as found in a portable copy, which
+// anyone who held the drive may have written. A file that is read writes back
+// byte for byte, names exactly one passphrase lock with a cost within the
+// limits, and no more locks than the format allows.
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <vector>
+
+#include "base/check.h"
+#include "base/check_op.h"
+#include "base/compiler_specific.h"
+#include "base/containers/span.h"
+#include "components/thoron_portable_key/argon2id.h"
+#include "components/thoron_portable_key/key_file.h"
+
+extern "C" int LLVMFuzzerTestOneInput(const uint8_t* data, size_t size) {
+  // SAFETY: libFuzzer gives `size` bytes at `data`.
+  const base::span<const uint8_t> bytes = UNSAFE_BUFFERS(base::span(data, size));
+  thoron_portable_key::ReadProblem problem =
+      thoron_portable_key::ReadProblem::kNone;
+  const std::optional<thoron_portable_key::KeyFile> file =
+      thoron_portable_key::ParseKeyFile(bytes, &problem);
+  if (!file) {
+    CHECK_NE(problem, thoron_portable_key::ReadProblem::kNone);
+    return 0;
+  }
+  CHECK_EQ(problem, thoron_portable_key::ReadProblem::kNone);
+  CHECK(thoron_portable_key::AreAcceptable(file->passphrase.params));
+  CHECK_LE(file->remembered_pcs.size(),
+           thoron_portable_key::kMostRememberedPcs);
+  std::vector<uint8_t> again = thoron_portable_key::SignedBytesOf(*file);
+  again.insert(again.end(), file->mac.begin(), file->mac.end());
+  CHECK(base::span(again) == bytes);
+  return 0;
+}
diff --git a/components/thoron_portable_key/key_file_unittest.cc b/components/thoron_portable_key/key_file_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..6af89325f760d7c7000648ef8608a7c13005764c
--- /dev/null
+++ b/components/thoron_portable_key/key_file_unittest.cc
@@ -0,0 +1,545 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_portable_key/key_file.h"
+
+#include <stdint.h>
+
+#include <array>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/check.h"
+#include "components/thoron_portable_key/os_key_store.h"
+#include "components/thoron_portable_key/recovery_key.h"
+#include "crypto/random.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace thoron_portable_key {
+namespace {
+
+// Where the fields of a serialized file are (key_file.h, format 1).
+constexpr size_t kFormatAt = 8;
+constexpr size_t kCountAt = 9;
+constexpr size_t kPassphraseKindAt = 10;
+constexpr size_t kMemoryAt = 13;
+constexpr size_t kPassesAt = 17;
+constexpr size_t kLanesAt = 21;
+constexpr size_t kSaltAt = 22;
+constexpr size_t kNonceAt = 38;
+constexpr size_t kSealedAt = 50;
+constexpr size_t kRecoveryKindAt = 98;
+constexpr size_t kRecoverySaltAt = 101;
+
+// A system store of one PC for one account: what it protects opens only with
+// a store of the same PC.
+class FakeStore : public OsKeyStore {
+ public:
+  explicit FakeStore(uint8_t pc, bool available = true)
+      : pc_(pc), available_(available) {}
+
+  bool IsAvailable() const override { return available_; }
+
+  std::optional<std::vector<uint8_t>> Protect(
+      base::span<const uint8_t> secret) override {
+    if (!available_) {
+      return std::nullopt;
+    }
+    std::vector<uint8_t> blob = {'P', 'C', pc_};
+    for (uint8_t b : secret) {
+      blob.push_back(b ^ static_cast<uint8_t>(pc_ + 1));
+    }
+    return blob;
+  }
+
+  std::optional<SecretBytes> Unprotect(
+      base::span<const uint8_t> blob) override {
+    if (!available_ || blob.size() < 3 || blob[0] != 'P' || blob[1] != 'C' ||
+        blob[2] != pc_) {
+      return std::nullopt;
+    }
+    SecretBytes secret(blob.size() - 3);
+    for (size_t i = 3; i < blob.size(); ++i) {
+      secret.span()[i - 3] = blob[i] ^ static_cast<uint8_t>(pc_ + 1);
+    }
+    return secret;
+  }
+
+  bool Forget(base::span<const uint8_t> blob) override {
+    ++forgotten_;
+    return true;
+  }
+
+  int forgotten() const { return forgotten_; }
+
+ private:
+  const uint8_t pc_;
+  const bool available_;
+  int forgotten_ = 0;
+};
+
+SecretBytes NewProfileKey() {
+  SecretBytes key(kProfileKeyBytes);
+  crypto::RandBytes(key.span());
+  return key;
+}
+
+SecretBytes Pass(std::u16string typed) {
+  std::optional<SecretBytes> passphrase = PassphraseFromTyped(typed);
+  CHECK(passphrase);
+  return std::move(*passphrase);
+}
+
+const char16_t kPassphrase[] = u"correct horse battery staple";
+const char16_t kOtherPassphrase[] = u"another passphrase entirely";
+
+class ThoronKeyFileTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    recovery_key_ = NewRecoveryKey();
+    std::optional<KeyFile> file =
+        NewKeyFile(key_, Pass(kPassphrase), kFloor, &recovery_key_);
+    ASSERT_TRUE(file);
+    bytes_ = SerializeKeyFile(*file, key_);
+    // as read back, with its MAC
+    ReadProblem read = ReadProblem::kDamaged;
+    std::optional<KeyFile> parsed = ParseKeyFile(bytes_, &read);
+    ASSERT_TRUE(parsed);
+    file_ = std::move(*parsed);
+  }
+
+  // `bytes` read and opened with the passphrase: the problem.
+  OpenProblem OpenBytes(const std::vector<uint8_t>& bytes,
+                        const char16_t* passphrase = kPassphrase) {
+    ReadProblem read = ReadProblem::kNone;
+    std::optional<KeyFile> file = ParseKeyFile(bytes, &read);
+    if (!file) {
+      return OpenProblem::kChanged;
+    }
+    OpenProblem problem = OpenProblem::kNone;
+    std::optional<SecretBytes> key =
+        OpenWithPassphrase(*file, Pass(passphrase), &problem);
+    if (key) {
+      EXPECT_TRUE(*key == key_);
+    }
+    return problem;
+  }
+
+  const SecretBytes key_ = NewProfileKey();
+  SecretBytes recovery_key_;
+  KeyFile file_;
+  std::vector<uint8_t> bytes_;
+};
+
+// The round trip of P4.9: locked with the passphrase, written, read back,
+// and opened by the passphrase alone.
+TEST_F(ThoronKeyFileTest, PassphraseRoundTrip) {
+  ReadProblem read = ReadProblem::kDamaged;
+  std::optional<KeyFile> file = ParseKeyFile(bytes_, &read);
+  ASSERT_TRUE(file);
+  EXPECT_EQ(read, ReadProblem::kNone);
+  EXPECT_EQ(file->passphrase.params, kFloor);
+  EXPECT_TRUE(file->recovery.has_value());
+  EXPECT_TRUE(file->remembered_pcs.empty());
+  OpenProblem problem = OpenProblem::kChanged;
+  std::optional<SecretBytes> key =
+      OpenWithPassphrase(*file, Pass(kPassphrase), &problem);
+  ASSERT_TRUE(key);
+  EXPECT_EQ(problem, OpenProblem::kNone);
+  EXPECT_TRUE(*key == key_);
+  // what is read is written back byte for byte
+  std::vector<uint8_t> again = SignedBytesOf(*file);
+  again.insert(again.end(), file->mac.begin(), file->mac.end());
+  EXPECT_EQ(again, bytes_);
+}
+
+TEST_F(ThoronKeyFileTest, WrongPassphraseDoesNotOpen) {
+  EXPECT_EQ(OpenBytes(bytes_, kOtherPassphrase), OpenProblem::kWrongSecret);
+}
+
+// Threat model E4: the recovery key opens it; another one does not, and a file
+// without a recovery lock says so.
+TEST_F(ThoronKeyFileTest, RecoveryKey) {
+  OpenProblem problem = OpenProblem::kChanged;
+  std::optional<SecretBytes> key =
+      OpenWithRecoveryKey(file_, recovery_key_, &problem);
+  ASSERT_TRUE(key);
+  EXPECT_TRUE(*key == key_);
+  // as typed from the paper
+  std::optional<SecretBytes> typed =
+      ParseRecoveryKey(FormatRecoveryKey(recovery_key_));
+  ASSERT_TRUE(typed);
+  EXPECT_TRUE(OpenWithRecoveryKey(file_, *typed, &problem));
+  EXPECT_FALSE(OpenWithRecoveryKey(file_, NewRecoveryKey(), &problem));
+  EXPECT_EQ(problem, OpenProblem::kWrongSecret);
+  KeyFile without = file_;
+  without.recovery.reset();
+  EXPECT_FALSE(OpenWithRecoveryKey(without, recovery_key_, &problem));
+  EXPECT_EQ(problem, OpenProblem::kNoLock);
+}
+
+// The "new PC" round trip: remembered on one PC, the copy opens there without
+// the passphrase; on a new PC with a fresh system store no lock opens, and the
+// passphrase does.
+TEST_F(ThoronKeyFileTest, RememberedPcAndANewPc) {
+  FakeStore home(1);
+  FakeStore new_pc(2);
+  ASSERT_TRUE(RememberThisPc(file_, key_, home));
+  EXPECT_TRUE(IsRememberedHere(file_, home));
+  EXPECT_FALSE(IsRememberedHere(file_, new_pc));
+  ReadProblem read = ReadProblem::kNone;
+  std::optional<KeyFile> file =
+      ParseKeyFile(SerializeKeyFile(file_, key_), &read);
+  ASSERT_TRUE(file);
+  ASSERT_EQ(file->remembered_pcs.size(), 1u);
+  OpenProblem problem = OpenProblem::kChanged;
+  std::optional<SecretBytes> key = OpenOnThisPc(*file, home, &problem);
+  ASSERT_TRUE(key);
+  EXPECT_TRUE(*key == key_);
+  EXPECT_FALSE(OpenOnThisPc(*file, new_pc, &problem));
+  EXPECT_EQ(problem, OpenProblem::kNoLock);
+  key = OpenWithPassphrase(*file, Pass(kPassphrase), &problem);
+  ASSERT_TRUE(key);
+  EXPECT_TRUE(*key == key_);
+  // remembering again replaces this PC's lock; another PC adds its own
+  ASSERT_TRUE(RememberThisPc(*file, key_, home));
+  // the system's part of the lock it replaced goes too (no keyring items pile up)
+  EXPECT_EQ(home.forgotten(), 1);
+  ASSERT_TRUE(RememberThisPc(*file, key_, new_pc));
+  EXPECT_EQ(file->remembered_pcs.size(), 2u);
+  // "Forget this PC" removes this PC's lock only
+  EXPECT_TRUE(ForgetThisPc(*file, home));
+  // and the store's own part of it (the desktop keyring's item on Linux)
+  EXPECT_EQ(home.forgotten(), 2);
+  EXPECT_FALSE(ForgetThisPc(*file, home));
+  EXPECT_EQ(home.forgotten(), 2);
+  EXPECT_EQ(new_pc.forgotten(), 0);
+  EXPECT_FALSE(IsRememberedHere(*file, home));
+  EXPECT_TRUE(IsRememberedHere(*file, new_pc));
+  EXPECT_FALSE(OpenOnThisPc(*file, home, &problem));
+}
+
+// Threat model E5: with no system store, "Remember this PC" does nothing and
+// nothing is written without protection.
+TEST_F(ThoronKeyFileTest, NoSystemStoreNoRememberedPc) {
+  FakeStore none(1, /*available=*/false);
+  EXPECT_FALSE(RememberThisPc(file_, key_, none));
+  EXPECT_TRUE(file_.remembered_pcs.empty());
+  EXPECT_EQ(SerializeKeyFile(file_, key_), bytes_);
+  OpenProblem problem = OpenProblem::kNone;
+  EXPECT_FALSE(OpenOnThisPc(file_, none, &problem));
+  EXPECT_EQ(problem, OpenProblem::kNoLock);
+}
+
+TEST_F(ThoronKeyFileTest, RememberedPcsAreLimited) {
+  for (uint8_t pc = 1; pc <= kMostRememberedPcs; ++pc) {
+    FakeStore store(pc);
+    EXPECT_TRUE(RememberThisPc(file_, key_, store)) << int{pc};
+  }
+  FakeStore one_more(100);
+  EXPECT_FALSE(RememberThisPc(file_, key_, one_more));
+  ReadProblem read = ReadProblem::kDamaged;
+  EXPECT_TRUE(ParseKeyFile(SerializeKeyFile(file_, key_), &read));
+}
+
+// A new passphrase seals the same profile key: the old passphrase no longer
+// opens the file, the new one does, and the recovery key and the remembered
+// PCs still do.
+TEST_F(ThoronKeyFileTest, ChangedPassphrase) {
+  FakeStore home(1);
+  ASSERT_TRUE(RememberThisPc(file_, key_, home));
+  std::optional<PassphraseLock> lock =
+      LockWithPassphrase(key_, Pass(kOtherPassphrase), kFloor);
+  ASSERT_TRUE(lock);
+  file_.passphrase = *lock;
+  const std::vector<uint8_t> bytes = SerializeKeyFile(file_, key_);
+  EXPECT_EQ(OpenBytes(bytes, kPassphrase), OpenProblem::kWrongSecret);
+  EXPECT_EQ(OpenBytes(bytes, kOtherPassphrase), OpenProblem::kNone);
+  ReadProblem read = ReadProblem::kNone;
+  std::optional<KeyFile> file = ParseKeyFile(bytes, &read);
+  ASSERT_TRUE(file);
+  OpenProblem problem = OpenProblem::kChanged;
+  EXPECT_TRUE(OpenWithRecoveryKey(*file, recovery_key_, &problem));
+  EXPECT_TRUE(OpenOnThisPc(*file, home, &problem));
+}
+
+// Threat model E2: each field of the header changed in the file stops it from
+// being read or opened; none gives the profile key.
+TEST_F(ThoronKeyFileTest, EveryChangedFieldIsRefused) {
+  struct Change {
+    const char* name;
+    size_t at;
+    uint8_t value;
+  };
+  // the file's own cost is 64 MiB: one with 128 MiB, written by setup on a
+  // faster PC, is checked below
+  for (const Change& change : {
+           Change{"format: an older one", kFormatAt, 0},
+           Change{"passes", kPassesAt, 4},
+           Change{"lanes", kLanesAt, 2},
+           Change{"memory (more)", kMemoryAt + 2, 2},
+           Change{"salt", kSaltAt + 3, 0},
+           Change{"nonce", kNonceAt + 5, 0},
+           Change{"sealed key", kSealedAt + 7, 0},
+           Change{"recovery salt", kRecoverySaltAt, 0},
+           Change{"mac", 0, 0},
+       }) {
+    std::vector<uint8_t> bytes = bytes_;
+    const size_t at = change.at ? change.at : bytes.size() - 1;
+    bytes[at] = bytes[at] == change.value ? change.value + 1 : change.value;
+    EXPECT_NE(OpenBytes(bytes), OpenProblem::kNone) << change.name;
+  }
+}
+
+// Threat model E1 and E2: a file asking for less than the floor is refused
+// before anything is derived, and a cost lowered within the limits does not
+// open the file (the seal binds the cost).
+TEST_F(ThoronKeyFileTest, LoweredCost) {
+  std::vector<uint8_t> weaker = bytes_;
+  weaker[kMemoryAt + 2] = 0;  // 65536 KiB -> 0 KiB in its third byte
+  ReadProblem read = ReadProblem::kNone;
+  EXPECT_FALSE(ParseKeyFile(weaker, &read));
+  EXPECT_EQ(read, ReadProblem::kTooWeak);
+  std::vector<uint8_t> fewer_passes = bytes_;
+  fewer_passes[kPassesAt] = 2;
+  EXPECT_FALSE(ParseKeyFile(fewer_passes, &read));
+  EXPECT_EQ(read, ReadProblem::kTooWeak);
+  std::vector<uint8_t> costly = bytes_;
+  costly[kMemoryAt + 3] = 1;  // 16 GiB more
+  EXPECT_FALSE(ParseKeyFile(costly, &read));
+  EXPECT_EQ(read, ReadProblem::kTooCostly);
+
+  std::optional<KeyFile> stronger =
+      NewKeyFile(key_, Pass(kPassphrase), Argon2Params{131072, 3, 4}, nullptr);
+  ASSERT_TRUE(stronger);
+  std::vector<uint8_t> bytes = SerializeKeyFile(*stronger, key_);
+  ASSERT_EQ(bytes[kMemoryAt + 2], 2);
+  EXPECT_EQ(OpenBytes(bytes), OpenProblem::kNone);
+  bytes[kMemoryAt + 2] = 1;  // 131072 KiB -> 65536 KiB: the floor
+  EXPECT_EQ(OpenBytes(bytes), OpenProblem::kWrongSecret);
+}
+
+// Threat model E2: "not encrypted", "old format" and "newer format" markers.
+TEST_F(ThoronKeyFileTest, FormatMarkers) {
+  ReadProblem read = ReadProblem::kNone;
+  std::vector<uint8_t> bytes = bytes_;
+  bytes[0] = 'X';
+  EXPECT_FALSE(ParseKeyFile(bytes, &read));
+  EXPECT_EQ(read, ReadProblem::kNotAKeyFile);
+  bytes = bytes_;
+  bytes[kFormatAt] = 0;
+  EXPECT_FALSE(ParseKeyFile(bytes, &read));
+  EXPECT_EQ(read, ReadProblem::kDamaged);
+  bytes[kFormatAt] = 2;
+  EXPECT_FALSE(ParseKeyFile(bytes, &read));
+  EXPECT_EQ(read, ReadProblem::kNewerFormat);
+  EXPECT_FALSE(ParseKeyFile({}, &read));
+  EXPECT_EQ(read, ReadProblem::kNotAKeyFile);
+}
+
+// The MAC binds the locks together: a lock removed or added by someone without
+// the profile key is found once any lock opens.
+TEST_F(ThoronKeyFileTest, LocksAddedOrRemovedAreFound) {
+  // the recovery lock removed, the MAC left as it was
+  KeyFile removed = file_;
+  removed.recovery.reset();
+  std::vector<uint8_t> bytes = SignedBytesOf(removed);
+  bytes.insert(bytes.end(), file_.mac.begin(), file_.mac.end());
+  EXPECT_EQ(OpenBytes(bytes), OpenProblem::kChanged);
+
+  // a lock for another PC added (it would hand the attacker's own key to a
+  // copy that trusts that PC)
+  FakeStore attacker(9);
+  KeyFile added = file_;
+  RememberedPcLock lock;
+  lock.blob = *attacker.Protect(NewProfileKey().span());
+  added.remembered_pcs.push_back(lock);
+  bytes = SignedBytesOf(added);
+  bytes.insert(bytes.end(), file_.mac.begin(), file_.mac.end());
+  EXPECT_EQ(OpenBytes(bytes), OpenProblem::kChanged);
+  ReadProblem read = ReadProblem::kNone;
+  std::optional<KeyFile> file = ParseKeyFile(bytes, &read);
+  ASSERT_TRUE(file);
+  OpenProblem problem = OpenProblem::kNone;
+  EXPECT_FALSE(OpenOnThisPc(*file, attacker, &problem));
+  EXPECT_EQ(problem, OpenProblem::kChanged);
+
+  // a whole new file with a passphrase of the attacker's does not open with
+  // the person's passphrase
+  std::optional<KeyFile> other =
+      NewKeyFile(NewProfileKey(), Pass(kOtherPassphrase), kFloor, nullptr);
+  ASSERT_TRUE(other);
+  EXPECT_EQ(OpenBytes(SerializeKeyFile(*other, NewProfileKey())),
+            OpenProblem::kWrongSecret);
+}
+
+// A file is signed again (a PC remembered or forgotten while the copy is open)
+// only when the open copy's key signed it.
+TEST_F(ThoronKeyFileTest, SignedBy) {
+  EXPECT_TRUE(IsSignedBy(file_, key_));
+  EXPECT_FALSE(IsSignedBy(file_, NewProfileKey()));
+  EXPECT_FALSE(IsSignedBy(file_, SecretBytes(16)));
+  KeyFile changed = file_;
+  changed.recovery.reset();
+  EXPECT_FALSE(IsSignedBy(changed, key_));
+}
+
+// Only format 1 exactly as written is read: no other count, order, kind,
+// length or trailing byte.
+TEST_F(ThoronKeyFileTest, ReadsOnlyTheFormat) {
+  FakeStore home(1);
+  ASSERT_TRUE(RememberThisPc(file_, key_, home));
+  const std::vector<uint8_t> good = SerializeKeyFile(file_, key_);
+  ReadProblem read = ReadProblem::kNone;
+  ASSERT_TRUE(ParseKeyFile(good, &read));
+
+  auto refused = [&read](std::vector<uint8_t> bytes) {
+    return !ParseKeyFile(bytes, &read).has_value();
+  };
+  std::vector<uint8_t> bytes = good;
+  bytes.push_back(0);
+  EXPECT_TRUE(refused(bytes)) << "a trailing byte";
+  bytes = good;
+  bytes.pop_back();
+  EXPECT_TRUE(refused(bytes)) << "a short MAC";
+  for (uint8_t count : {0, 2, 4, 9, 255}) {
+    bytes = good;
+    bytes[kCountAt] = count;
+    EXPECT_TRUE(refused(bytes)) << "count " << int{count};
+  }
+  for (uint8_t kind : {0, 2, 3, 4, 255}) {
+    bytes = good;
+    bytes[kPassphraseKindAt] = kind;
+    EXPECT_TRUE(refused(bytes)) << "first kind " << int{kind};
+  }
+  for (uint8_t kind : {0, 1, 4}) {
+    bytes = good;
+    bytes[kRecoveryKindAt] = kind;
+    EXPECT_TRUE(refused(bytes)) << "second kind " << int{kind};
+  }
+  bytes = good;
+  bytes[kPassphraseKindAt + 1] += 1;  // the passphrase lock one byte longer
+  EXPECT_TRUE(refused(bytes)) << "length";
+  // every truncation
+  for (size_t size = 0; size < good.size(); ++size) {
+    EXPECT_TRUE(refused(std::vector<uint8_t>(good.begin(), good.begin() + size)))
+        << size;
+  }
+}
+
+// The reader under random damage (a mutation fuzzer that runs with the unit
+// tests; the coverage-guided one is thoron_portable_key_file_fuzzer): every
+// changed, cut or lengthened copy of a real key file is either refused with a
+// reason or read as a file that writes back byte for byte, with its cost
+// within the limits.
+TEST_F(ThoronKeyFileTest, RandomDamage) {
+  FakeStore home(1);
+  ASSERT_TRUE(RememberThisPc(file_, key_, home));
+  const std::vector<uint8_t> good = SerializeKeyFile(file_, key_);
+  uint32_t seed = 0x7407u;
+  auto next = [&seed]() {
+    seed = seed * 1664525u + 1013904223u;
+    return seed >> 8;
+  };
+  size_t read = 0;
+  for (int round = 0; round < 300000; ++round) {
+    std::vector<uint8_t> bytes = good;
+    const int changes = 1 + static_cast<int>(next() % 4);
+    for (int c = 0; c < changes; ++c) {
+      switch (next() % 4) {
+        case 0:  // a byte changed
+          bytes[next() % bytes.size()] = static_cast<uint8_t>(next());
+          break;
+        case 1:  // cut short
+          bytes.resize(next() % (bytes.size() + 1));
+          break;
+        case 2:  // a byte added
+          bytes.insert(bytes.begin() + static_cast<ptrdiff_t>(
+                                           next() % (bytes.size() + 1)),
+                       static_cast<uint8_t>(next()));
+          break;
+        default:  // a length or count field set to anything
+          if (bytes.size() > kPassphraseKindAt + 1) {
+            bytes[next() % 2 ? kCountAt : kPassphraseKindAt + 1] =
+                static_cast<uint8_t>(next());
+          }
+          break;
+      }
+      if (bytes.empty()) {
+        break;
+      }
+    }
+    ReadProblem problem = ReadProblem::kNone;
+    std::optional<KeyFile> file = ParseKeyFile(bytes, &problem);
+    if (!file) {
+      ASSERT_NE(problem, ReadProblem::kNone);
+      continue;
+    }
+    ++read;
+    ASSERT_EQ(problem, ReadProblem::kNone);
+    ASSERT_TRUE(AreAcceptable(file->passphrase.params));
+    ASSERT_LE(file->remembered_pcs.size(), kMostRememberedPcs);
+    std::vector<uint8_t> again = SignedBytesOf(*file);
+    again.insert(again.end(), file->mac.begin(), file->mac.end());
+    ASSERT_EQ(again, bytes);
+  }
+  // some damage leaves a readable file (a changed salt, nonce or MAC byte):
+  // the MAC then refuses it once a lock opens (EveryChangedFieldIsRefused)
+  EXPECT_GT(read, 0u);
+}
+
+TEST(ThoronPassphraseTest, ShortestAndNormalForm) {
+  std::u16string eleven = u"abcdefghijk";
+  EXPECT_FALSE(PassphraseFromTyped(eleven));
+  EXPECT_TRUE(eleven.empty());
+  std::u16string twelve = u"abcdefghijkl";
+  std::optional<SecretBytes> bytes = PassphraseFromTyped(twelve);
+  ASSERT_TRUE(bytes);
+  EXPECT_EQ(bytes->size(), 12u);
+  EXPECT_TRUE(twelve.empty());
+
+  // twelve characters typed composed and decomposed give the same bytes
+  std::u16string composed;
+  std::u16string decomposed;
+  for (int i = 0; i < 12; ++i) {
+    composed += u"é";
+    decomposed += u"é";
+  }
+  std::optional<SecretBytes> a = PassphraseFromTyped(composed);
+  std::optional<SecretBytes> b = PassphraseFromTyped(decomposed);
+  ASSERT_TRUE(a);
+  ASSERT_TRUE(b);
+  EXPECT_TRUE(*a == *b);
+  EXPECT_EQ(a->size(), 24u);
+
+  // a lone surrogate is not text
+  std::u16string broken = u"abcdefghijkl";
+  broken += static_cast<char16_t>(0xd800);
+  EXPECT_FALSE(PassphraseFromTyped(broken));
+  // nor is a passphrase of more than a thousand units taken
+  std::u16string huge(1025, u'a');
+  EXPECT_FALSE(PassphraseFromTyped(huge));
+}
+
+TEST(ThoronKeyFileRemovalTest, OnlyTheKeyMakesAProofAndItFitsOneFile) {
+  SecretBytes key(kProfileKeyBytes);
+  crypto::RandBytes(key.span());
+  SecretBytes other(kProfileKeyBytes);
+  crypto::RandBytes(other.span());
+  KeyFile file;
+  file.mac.fill(7);
+  const std::array<uint8_t, kMacBytes> proof = RemovalProof(file, key);
+  EXPECT_TRUE(IsRemovalProof(file, key, proof));
+  // someone without the key cannot make one
+  EXPECT_FALSE(IsRemovalProof(file, other, proof));
+  EXPECT_FALSE(IsRemovalProof(file, key, std::array<uint8_t, kMacBytes>{}));
+  EXPECT_FALSE(IsRemovalProof(file, key, base::span(proof).first<16>()));
+  // a later lock's file (another MAC) does not take an old proof
+  KeyFile later = file;
+  later.mac[0] ^= 1;
+  EXPECT_FALSE(IsRemovalProof(later, key, proof));
+}
+
+}  // namespace
+}  // namespace thoron_portable_key
