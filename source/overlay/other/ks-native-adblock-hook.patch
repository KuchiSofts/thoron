diff --git a/components/user_data_importer/chromium_family/browser_detection.cc b/components/user_data_importer/chromium_family/browser_detection.cc
new file mode 100644
index 0000000000000000000000000000000000000000..77d3dfdead018f2bd18fa5ac627b0619f9145291
--- /dev/null
+++ b/components/user_data_importer/chromium_family/browser_detection.cc
@@ -0,0 +1,275 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/user_data_importer/chromium_family/browser_detection.h"
+
+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_WIN)
+#include <windows.h>
+#else
+#include <errno.h>
+#include <signal.h>
+#include <unistd.h>
+
+#include <array>
+#endif
+
+#include <string_view>
+
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversion_utils.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/values.h"
+#include "components/user_data_importer/common/importer_type.h"
+
+namespace user_data_importer::chromium_family {
+
+namespace {
+
+enum class Base { kLocalAppData, kRoamingAppData, kConfigHome };
+
+struct KnownBrowser {
+  const char* name;
+  Base base;
+  const base::FilePath::CharType* folder;
+  // Opera keeps its only profile in the folder that holds `Local State`.
+  bool single_profile;
+};
+
+#if BUILDFLAG(IS_WIN)
+// detect.py's BROWSERS, in the same order.
+constexpr KnownBrowser kKnownBrowsers[] = {
+    {"Thorium", Base::kLocalAppData, L"Thorium\\User Data", false},
+    {"Chrome", Base::kLocalAppData, L"Google\\Chrome\\User Data", false},
+    {"Edge", Base::kLocalAppData, L"Microsoft\\Edge\\User Data", false},
+    {"Brave", Base::kLocalAppData, L"BraveSoftware\\Brave-Browser\\User Data",
+     false},
+    {"Vivaldi", Base::kLocalAppData, L"Vivaldi\\User Data", false},
+    {"Opera", Base::kRoamingAppData, L"Opera Software\\Opera Stable", true},
+    {"Opera GX", Base::kRoamingAppData, L"Opera Software\\Opera GX Stable",
+     true},
+    {"Chromium", Base::kLocalAppData, L"Chromium\\User Data", false},
+};
+#else
+// Linux: the folders under $XDG_CONFIG_HOME (~/.config) these browsers keep
+// their user data in, in detect.py's order (Opera GX has no Linux version).
+constexpr KnownBrowser kKnownBrowsers[] = {
+    {"Thorium", Base::kConfigHome, "thorium", false},
+    {"Chrome", Base::kConfigHome, "google-chrome", false},
+    {"Edge", Base::kConfigHome, "microsoft-edge", false},
+    {"Brave", Base::kConfigHome, "BraveSoftware/Brave-Browser", false},
+    {"Vivaldi", Base::kConfigHome, "vivaldi", false},
+    {"Opera", Base::kConfigHome, "opera", true},
+    {"Chromium", Base::kConfigHome, "chromium", false},
+};
+#endif
+
+// Another browser's file: a larger one is not read at all.
+constexpr size_t kMostLocalStateBytes = 8 * 1024 * 1024;
+constexpr size_t kMostProfileNameCharacters = 100;
+
+constexpr base::FilePath::CharType kLocalStateFile[] =
+    FILE_PATH_LITERAL("Local State");
+constexpr base::FilePath::CharType kPreferencesFile[] =
+    FILE_PATH_LITERAL("Preferences");
+#if BUILDFLAG(IS_WIN)
+constexpr base::FilePath::CharType kLockFile[] = L"lockfile";
+#else
+// A link whose target is "<host>-<process id>" while the browser runs.
+constexpr char kSingletonLock[] = "SingletonLock";
+#endif
+
+bool SameFolder(const base::FilePath& a, const base::FilePath& b) {
+#if BUILDFLAG(IS_WIN)
+  return base::FilePath::CompareEqualIgnoreCase(
+      a.StripTrailingSeparators().value(), b.StripTrailingSeparators().value());
+#else
+  return a.StripTrailingSeparators() == b.StripTrailingSeparators();
+#endif
+}
+
+bool IsFile(const base::FilePath& path) {
+  return base::PathExists(path) && !base::DirectoryExists(path);
+}
+
+// At most kMostProfileNameCharacters code points of `name`, as detect.py's
+// `[:100]`.
+std::u16string ShortenName(const std::string& name) {
+  std::u16string wide = base::UTF8ToUTF16(name);
+  size_t index = 0;
+  size_t characters = 0;
+  for (; index < wide.size(); ++index) {
+    if (characters == kMostProfileNameCharacters) {
+      wide.resize(index);
+      break;
+    }
+    base_icu::UChar32 code_point;
+    base::ReadUnicodeCharacter(wide, &index, &code_point);
+    ++characters;
+  }
+  return wide;
+}
+
+// A profile folder name taken from another browser's file: only a plain name
+// of one folder is used.
+bool IsPlainFolderName(std::string_view folder) {
+  return !folder.empty() && folder != "." && folder != ".." &&
+         folder.find_first_of("/\\:") == std::string_view::npos;
+}
+
+// The profiles `Local State` lists that have their folder (detect.py's
+// profiles_of()).
+std::vector<DetectedProfile> ProfilesOf(const base::FilePath& user_data,
+                                        bool single_profile) {
+  std::vector<DetectedProfile> profiles;
+  if (single_profile) {
+    if (IsFile(user_data.Append(kPreferencesFile))) {
+      profiles.push_back({".", u"Default"});
+    }
+    return profiles;
+  }
+
+  std::string json;
+  if (!base::ReadFileToStringWithMaxSize(user_data.Append(kLocalStateFile),
+                                         &json, kMostLocalStateBytes)) {
+    return profiles;
+  }
+  // Another browser's file: any part of it may have another shape than the
+  // browser writes.
+  std::optional<base::DictValue> state =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  if (!state) {
+    return profiles;
+  }
+  const base::DictValue* cache =
+      state->FindDictByDottedPath("profile.info_cache");
+  if (!cache) {
+    return profiles;
+  }
+  // DictValue keeps its keys sorted, as detect.py's sorted().
+  for (const auto [folder, info] : *cache) {
+    const base::DictValue* info_dict = info.GetIfDict();
+    if (!info_dict || !IsPlainFolderName(folder)) {
+      continue;
+    }
+    if (!IsFile(user_data.Append(base::FilePath::FromUTF8Unsafe(folder))
+                    .Append(kPreferencesFile))) {
+      continue;
+    }
+    const std::string* name = info_dict->FindString("name");
+    profiles.push_back(
+        {folder, ShortenName(name && !name->empty() ? *name : folder)});
+  }
+  return profiles;
+}
+
+}  // namespace
+
+DetectedBrowser::DetectedBrowser() = default;
+DetectedBrowser::DetectedBrowser(const DetectedBrowser&) = default;
+DetectedBrowser& DetectedBrowser::operator=(const DetectedBrowser&) = default;
+DetectedBrowser::~DetectedBrowser() = default;
+
+std::vector<DetectedBrowser> DetectBrowsers(const DetectionFolders& folders) {
+  std::vector<DetectedBrowser> found;
+  for (const KnownBrowser& known : kKnownBrowsers) {
+    const base::FilePath& root =
+        known.base == Base::kLocalAppData     ? folders.local_app_data
+        : known.base == Base::kRoamingAppData ? folders.roaming_app_data
+                                              : folders.config_home;
+    if (root.empty()) {
+      continue;
+    }
+    base::FilePath user_data = root.Append(known.folder);
+    if (!folders.own_user_data.empty() &&
+        SameFolder(user_data, folders.own_user_data)) {
+      continue;
+    }
+    if (!IsFile(user_data.Append(kLocalStateFile))) {
+      continue;
+    }
+    DetectedBrowser browser;
+    browser.name = known.name;
+    browser.user_data = user_data;
+    browser.running = IsBrowserRunning(user_data);
+    browser.profiles = ProfilesOf(user_data, known.single_profile);
+    found.push_back(std::move(browser));
+  }
+  return found;
+}
+
+std::vector<SourceProfile> MakeSourceProfiles(
+    const std::vector<DetectedBrowser>& browsers) {
+  std::vector<SourceProfile> sources;
+  for (const DetectedBrowser& browser : browsers) {
+    for (const DetectedProfile& profile : browser.profiles) {
+      SourceProfile source;
+      source.importer_type = TYPE_CHROMIUM_FAMILY;
+      source.importer_name = base::UTF8ToUTF16(browser.name);
+      if (browser.profiles.size() > 1) {
+        source.importer_name += u" (" + profile.name + u")";
+      }
+      source.source_path = profile.folder == "."
+                               ? browser.user_data
+                               : browser.user_data.Append(
+                                     base::FilePath::FromUTF8Unsafe(
+                                         profile.folder));
+      source.app_path = browser.user_data;
+      source.services_supported = SupportedItems();
+      sources.push_back(std::move(source));
+    }
+  }
+  return sources;
+}
+
+std::vector<SourceProfile> DetectSourceProfiles(
+    const DetectionFolders& folders) {
+  return MakeSourceProfiles(DetectBrowsers(folders));
+}
+
+uint16_t SupportedItems() {
+  return FAVORITES | HISTORY | PASSWORDS | SEARCH_ENGINES |
+         AUTOFILL_FORM_DATA | COOKIES | HOME_PAGE | EXTENSIONS | OPEN_TABS;
+}
+
+bool IsBrowserRunning(const base::FilePath& user_data) {
+  if (user_data.empty()) {
+    return false;
+  }
+#if BUILDFLAG(IS_WIN)
+  // GetFileAttributes() instead of base::PathExists(): no file is opened, and
+  // it may be called on the UI thread (see the header).
+  return ::GetFileAttributesW(user_data.Append(kLockFile).value().c_str()) !=
+         INVALID_FILE_ATTRIBUTES;
+#else
+  // As Chromium's ProcessSingleton reads it: the link names the host and the
+  // process; a link left by a browser that crashed, or one of another
+  // computer (a shared home folder), does not count. readlink() and kill()
+  // open no file, so this may be called on the UI thread (see the header).
+  std::array<char, 256> target = {};
+  const ssize_t length =
+      ::readlink(user_data.Append(kSingletonLock).value().c_str(),
+                 target.data(), target.size() - 1);
+  if (length <= 0) {
+    return false;
+  }
+  const std::string_view link(target.data(), static_cast<size_t>(length));
+  const size_t dash = link.rfind('-');
+  int pid = 0;
+  if (dash == std::string_view::npos ||
+      !base::StringToInt(link.substr(dash + 1), &pid) || pid <= 0) {
+    return false;
+  }
+  std::array<char, 256> host = {};
+  if (::gethostname(host.data(), host.size() - 1) != 0 ||
+      link.substr(0, dash) != std::string_view(host.data())) {
+    return false;
+  }
+  return ::kill(pid, 0) == 0 || errno == EPERM;
+#endif
+}
+
+}  // namespace user_data_importer::chromium_family
diff --git a/components/user_data_importer/chromium_family/browser_detection.h b/components/user_data_importer/chromium_family/browser_detection.h
new file mode 100644
index 0000000000000000000000000000000000000000..ae7f26ecb783b424a3683c51c1d244cfdb66065a
--- /dev/null
+++ b/components/user_data_importer/chromium_family/browser_detection.h
@@ -0,0 +1,90 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_USER_DATA_IMPORTER_CHROMIUM_FAMILY_BROWSER_DETECTION_H_
+#define COMPONENTS_USER_DATA_IMPORTER_CHROMIUM_FAMILY_BROWSER_DETECTION_H_
+
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "components/user_data_importer/common/importer_data_types.h"
+
+// Which browsers of the Chromium family the current Windows user has, and
+// their profiles (ROADMAP P3.13, P3.14). A port of Thoron's
+// tools/migrate/detect.py: the same browsers, the same folders, the same rules.
+//
+// Only the current user's own folders are looked at, never another user's or a
+// system-wide one. Nothing is read beyond each browser's `Local State` and the
+// names of its profile folders.
+namespace user_data_importer::chromium_family {
+
+// The folders detection looks in. The browser fills them from the current
+// user's known folders; tests point them at a fake tree.
+struct DetectionFolders {
+  // %LOCALAPPDATA% of the current user.
+  base::FilePath local_app_data;
+  // %APPDATA% (roaming) of the current user.
+  base::FilePath roaming_app_data;
+  // Linux: $XDG_CONFIG_HOME, or ~/.config, of the current user.
+  base::FilePath config_home;
+  // The running browser's own user data folder. A browser found there is never
+  // offered as a source, so Thoron never imports from itself.
+  base::FilePath own_user_data;
+};
+
+// A profile `Local State` lists that has its folder.
+struct DetectedProfile {
+  // The folder's name under the user data folder ("Default", "Profile 1"), or
+  // "." for a browser whose user data folder is its only profile (Opera).
+  std::string folder;
+  // The name the person gave the profile, at most 100 characters.
+  std::u16string name;
+};
+
+// A browser found for the current user.
+struct DetectedBrowser {
+  DetectedBrowser();
+  DetectedBrowser(const DetectedBrowser&);
+  DetectedBrowser& operator=(const DetectedBrowser&);
+  ~DetectedBrowser();
+
+  // As detect.py names it: "Thorium", "Chrome", "Edge", "Brave", "Vivaldi",
+  // "Opera", "Opera GX" or "Chromium".
+  std::string name;
+  // The folder that holds `Local State` and, while the browser runs, its
+  // `lockfile`.
+  base::FilePath user_data;
+  // Whether the browser runs (IsBrowserRunning()) at the time of detection.
+  bool running = false;
+  std::vector<DetectedProfile> profiles;
+};
+
+// The browsers found in `folders`, in detect.py's order (Thorium, Chrome, Edge,
+// Brave, Vivaldi, Opera, Opera GX, Chromium). A browser counts once its user
+// data folder holds a `Local State` file, even with no usable profile.
+std::vector<DetectedBrowser> DetectBrowsers(const DetectionFolders& folders);
+
+// One SourceProfile of type TYPE_CHROMIUM_FAMILY per profile of `browsers`,
+// named "Brave (Work)", or "Brave" alone for a browser with one profile.
+// `source_path` is the profile folder and `app_path` the browser's user data
+// folder (where `Local State` and `lockfile` are).
+std::vector<SourceProfile> MakeSourceProfiles(
+    const std::vector<DetectedBrowser>& browsers);
+
+// MakeSourceProfiles(DetectBrowsers(folders)).
+std::vector<SourceProfile> DetectSourceProfiles(
+    const DetectionFolders& folders);
+
+// The data a profile of the Chromium family offers to an import.
+uint16_t SupportedItems();
+
+// Whether the browser whose user data folder is `user_data` runs: Chromium
+// keeps a `lockfile` there, deleted by Windows when its last process ends. The
+// check only asks Windows for the file's attributes, so it is cheap enough for
+// the UI thread, like the Firefox profile lock check. It never closes anything.
+bool IsBrowserRunning(const base::FilePath& user_data);
+
+}  // namespace user_data_importer::chromium_family
+
+#endif  // COMPONENTS_USER_DATA_IMPORTER_CHROMIUM_FAMILY_BROWSER_DETECTION_H_
