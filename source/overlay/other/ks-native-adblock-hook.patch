+  const base::FilePath target = unpack_path.Append(kInstallSourceChromeDir);
+  if (!base::CreateDirectory(target)) {
+    return false;
+  }
+  base::FileEnumerator entries(folder, /*recursive=*/true,
+                               base::FileEnumerator::FILES | base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath entry = entries.Next(); !entry.empty(); entry = entries.Next()) {
+    base::FilePath relative;
+    if (!folder.AppendRelativePath(entry, &relative)) {
+      return false;
+    }
+    const std::vector<base::FilePath::StringType> parts = relative.GetComponents();
+    if (parts.size() >= 2 && base::FilePath::CompareEqualIgnoreCase(parts[1], kInstallerDir)) {
+      continue;
+    }
+    const base::FilePath to = target.Append(relative);
+    const bool copied = entries.GetInfo().IsDirectory() ? base::CreateDirectory(to)
+                                                        : base::CopyFile(entry, to);
+    if (!copied) {
+      PLOG(ERROR) << "Copying " << entry << " to " << to << " failed";
+      return false;
+    }
+  }
+  return true;
+}
