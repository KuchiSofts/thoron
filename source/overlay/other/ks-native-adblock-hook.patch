+#include "components/thoron_update/cli.h"
+#include "content/public/browser/browser_thread.h"
+#include "net/base/network_change_notifier.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+
+namespace thoron_update_linux {
+
+namespace {
+
+// The build's own values (chrome/browser/thoron_update/BUILD.gn).
+constexpr char kPublicKey[] = THORON_UPDATE_PUBLIC_KEY;
+constexpr char kManifestUrl[] = THORON_UPDATE_MANIFEST_URL;
+constexpr char kChannel[] = THORON_UPDATE_CHANNEL;
+constexpr char kVariant[] = THORON_UPDATE_VARIANT;
+
+constexpr base::TimeDelta kFirstLook = base::Minutes(10);
+constexpr base::TimeDelta kBetweenLooks = base::Hours(5);
+constexpr base::TimeDelta kMostUpdateTime = base::Minutes(15);
+
+void ScheduledLook() {
+  const base::FilePath folder = SelfUpdatingFolder();
+  if (!folder.empty() &&
+      thoron_update::ReadUpdateMode(folder) == thoron_update::UpdateMode::kAuto) {
+    Client()->Check(/*install=*/true, base::DoNothing(), /*asked=*/false);
+  }
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, base::BindOnce(&ScheduledLook), kBetweenLooks);
+}
+
+// The relaunch badge (P3.6), as on Windows.
+void TellBuildState(const std::string& version, bool critical) {
+  const base::Version installed(version);
+  if (!installed.IsValid()) {
+    return;
+  }
+  g_browser_process->GetBuildState()->SetUpdate(
+      BuildState::UpdateType::kNormalUpdate, installed,
+      critical ? std::optional<base::Version>(installed) : std::nullopt);
+}
+
+// The run of the systemd user timer of a per-user install (P3.10): one look
+// that installs what it finds, then the browser exits, also when the look takes
+// too long.
+constexpr char kScheduledUpdateSwitch[] = "thoron-scheduled-update";
+constexpr base::TimeDelta kMostScheduledRun = base::Minutes(20);
+
+bool IsAnswer(thoron_update::UpdateClient::State state) {
+  using State = thoron_update::UpdateClient::State;
+  return state != State::kIdle && state != State::kChecking && state != State::kDownloading &&
+         state != State::kInstalling;
+}
+
+void QuitOnce() {
+  static bool quitting = false;
+  if (quitting) {
+    return;
+  }
+  quitting = true;
+  chrome::AttemptExit();
+}
+
+void RunOnceAndQuit() {
+  if (SelfUpdatingFolder().empty()) {
+    // A copy the package manager installed is updated by it.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+                                                                base::BindOnce(&QuitOnce));
+    return;
+  }
+  Client()->Check(
+      /*install=*/true,
+      base::BindRepeating([](const thoron_update::UpdateClient::Status& status) {
+        if (IsAnswer(status.state)) {
+          base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+              FROM_HERE, base::BindOnce(&QuitOnce));
+        }
+      }),
+      /*asked=*/false);
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, base::BindOnce(&QuitOnce), kMostScheduledRun);
+}
+
+}  // namespace
+
+base::FilePath SelfUpdatingFolder() {
+  base::FilePath exe;
+  base::PathService::Get(base::DIR_EXE, &exe);
+  const base::FilePath parent = exe.DirName();
+  return base::PathExists(parent.AppendASCII("current")) ? parent : base::FilePath();
+}
+
+bool RunSelfUpdate(const base::FilePath& package, bool delta, const std::string& version) {
+  const base::FilePath root = SelfUpdatingFolder();
+  if (root.empty()) {
+    return false;
+  }
+  base::FilePath exe;
+  base::PathService::Get(base::DIR_EXE, &exe);
+  base::CommandLine command(exe.AppendASCII("thoron_update"));
+  command.AppendSwitchPath("root", root);
+  // A delta makes the new version from this one's folder (P4.1); a package
+  // holds it whole.
+  command.AppendSwitchPath(delta ? "apply-delta" : "apply-package", package);
+  command.AppendSwitchASCII("version", version);
+  base::Process process = base::LaunchProcess(command, base::LaunchOptions());
+  if (!process.IsValid()) {
+    return false;
+  }
+  int exit_code = -1;
+  if (!process.WaitForExitWithTimeout(kMostUpdateTime, &exit_code)) {
+    process.Terminate(/*exit_code=*/1, /*wait=*/false);
+    return false;
+  }
+  return exit_code == 0;
+}
+
+thoron_update::UpdateClient::Config ConfigForThisCopy() {
+  thoron_update::UpdateClient::Config config;
+  std::string key;
+  if (base::Base64Decode(kPublicKey, &key) && key.size() == thoron_update::kPublicKeyBytes) {
+    std::copy(key.begin(), key.end(), config.public_key.begin());
+  }
+  config.allowed_hosts = {"github.com"};
+  config.manifest_url = GURL(kManifestUrl);
+  config.channel = kChannel;
+  const std::optional<thoron_update::BuildVersion> version =
+      thoron_update::ParseBuildVersion(version_info::GetVersionNumber());
+  if (version) {
+    config.installed = *version;
+    config.updater = *version;
+  }
+  config.variant =
+      thoron_update::ParseVariant(kVariant).value_or(thoron_update::Variant::kLinuxX64Sse4);
+  config.on_installed = base::BindRepeating(&TellBuildState);
+  // A metered connection: the looks on a schedule download nothing then (P4.3).
+  config.is_metered = base::BindRepeating([] {
+    return net::NetworkChangeNotifier::GetConnectionCost() ==
+           net::NetworkChangeNotifier::CONNECTION_COST_METERED;
+  });
+  const base::FilePath folder = SelfUpdatingFolder();
+  // Both copies that update themselves take the portable package: the per-user
+  // install has the same folder of versions, its profile in ~/.config/thoron.
+  config.kind = thoron_update::Kind::kPortable;
+  if (!folder.empty()) {
+    // Beside the version folders, never in a profile.
+    config.download_dir = folder.AppendASCII("Update");
+    config.install = base::BindRepeating(&RunSelfUpdate);
+  } else {
+    // The .deb: apt owns its files (design 7.5a), and the updater never
+    // changes them.
+    config.by_hand =
+        "this copy was installed by your system's package manager, which also updates it";
+  }
+  return config;
+}
+
+thoron_update::UpdateClient* Client() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  static base::NoDestructor<std::unique_ptr<thoron_update::UpdateClient>> client(
+      std::make_unique<thoron_update::UpdateClient>(
+          ConfigForThisCopy(), g_browser_process->shared_url_loader_factory(),
+          g_browser_process->local_state(), base::DefaultClock::GetInstance()));
+  return client->get();
+}
+
+void StartScheduledChecks() {
+  const base::CommandLine& command = *base::CommandLine::ForCurrentProcess();
+  if (command.HasSwitch(kScheduledUpdateSwitch)) {
+    RunOnceAndQuit();
+    return;
+  }
+  // As on Windows, the switch that keeps the browser from contacting anything
+  // on its own keeps the updater quiet too; a copy the package manager
+  // installed looks only when the About page is opened.
+  if (command.HasSwitch("disable-background-networking") || SelfUpdatingFolder().empty()) {
+    return;
+  }
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, base::BindOnce(&ScheduledLook), kFirstLook);
+}
+
+}  // namespace thoron_update_linux
