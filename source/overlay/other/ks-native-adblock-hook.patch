+  // The logger's "Why?": [id, url, type, page]. Only web addresses, and a type
+  // as the lists name one (lower-case letters and "_"); another is "other".
+  void ExplainRequest(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 3);
+    if (!id || !args[1].is_string() || !args[2].is_string() ||
+        !args[3].is_string()) {
+      return;
+    }
+    const GURL url(args[1].GetString());
+    const GURL page(args[3].GetString());
+    std::string type = args[2].GetString();
+    if (type.empty() || type.size() > 24 ||
+        !std::all_of(type.begin(), type.end(),
+                     [](char c) { return (c >= 'a' && c <= 'z') || c == '_'; })) {
+      type = "other";
+    }
+    if (!url.is_valid() || !(url.SchemeIsHTTPOrHTTPS() || url.SchemeIsWSOrWSS())) {
+      ResolveJavascriptCallback(base::Value(*id), base::DictValue());
+      return;
+    }
+    Service().Explain(
+        url, page.SchemeIsHTTPOrHTTPS() ? page : GURL(), std::move(type),
+        base::BindOnce(&ThoronAdblockHandler::AnswerValue,
+                       weak_factory_.GetWeakPtr(), *id));
+  }
