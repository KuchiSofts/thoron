+// The page with the browser's language and its direction in <html>: i18n.js
+// puts the page's text into that language.
+std::string LocalizedPage(std::string_view html) {
+  std::string page(html);
+  const std::string locale =
+      g_browser_process ? g_browser_process->GetApplicationLocale() : "en";
+  // the theme chosen on the settings page ("light" or "dark"; none: as the
+  // system)
+  const std::string& theme = thoron_adblock::EngineService::Get().theme();
+  base::ReplaceFirstSubstringAfterOffset(
+      &page, 0, "<html lang=\"en\" dir=\"ltr\">",
+      base::StrCat({"<html lang=\"", base::EscapeForHTML(locale), "\" dir=\"",
+                    base::i18n::IsRTL() ? "rtl" : "ltr", "\"",
+                    theme.empty() ? "" : " data-theme=\"",
+                    theme.empty() ? "" : theme, theme.empty() ? "" : "\"",
+                    ">"}));
+  return page;
+}
