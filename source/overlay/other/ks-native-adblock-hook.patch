+class BrowserWindowInterface;
+class PrefService;
+class ThoronMailMenu;
+
+// Thoron M-Notifier in the toolbar (P5.75, P5.76): an envelope with the count
+// of new mail (or of all unread mail, as the person chose) of every watched
+// Google account the profile is signed in to. Pressed, it opens the
+// M-Notifier's menu (thoron_mail_ui.h). Where it is and where in the toolbar
+// are the person's choice, as for Thoron adblock's shield. Not in an
+// off-the-record window.
+class ThoronMailButton : public ToolbarButton,
+                         public thoron_mail::MailService::Observer {
+  METADATA_HEADER(ThoronMailButton, ToolbarButton)
+
+ public:
+  explicit ThoronMailButton(BrowserWindowInterface* browser);
+  ThoronMailButton(const ThoronMailButton&) = delete;
+  ThoronMailButton& operator=(const ThoronMailButton&) = delete;
+  ~ThoronMailButton() override;
+
+  // ToolbarButton:
+  void UpdateIcon() override;
+  void AddedToWidget() override;
+  // The envelope is moved with the mouse (P5.78, thoron::ToolbarDrag).
+  bool OnMousePressed(const ui::MouseEvent& event) override;
+  bool OnMouseDragged(const ui::MouseEvent& event) override;
+  void OnMouseReleased(const ui::MouseEvent& event) override;
+  void OnMouseCaptureLost() override;
+
+  // thoron_mail::MailService::Observer:
+  void OnMailChanged() override;
+
+  // The profile's settings, and where in the toolbar its setting puts the
+  // envelope ("extensions", "address", "menu").
+  PrefService* prefs() const;
+  std::string toolbar_position() const;
+
+ private:
+  void ButtonPressed();
+  // Shown or not, and where in the toolbar: after the extensions, right after
+  // the address bar, or next to the menu; with Thoron's other buttons in
+  // their order.
+  void ApplyPlace();
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  std::unique_ptr<ThoronMailMenu> menu_;
+  base::ScopedObservation<thoron_mail::MailService,
+                          thoron_mail::MailService::Observer>
+      mail_observation_{this};
+  std::unique_ptr<thoron::ToolbarDrag> drag_;
+  PrefChangeRegistrar order_registrar_;
+  base::WeakPtrFactory<ThoronMailButton> weak_factory_{this};
+};
+
+// Thoron M-Notifier in the address bar (P5.76), when the person put it there:
+// the same envelope and menu, as large as the address bar's other icons. The
+// address bar lays it out (LocationBarView::Layout) where position() says.
+class ThoronMailAddressIcon : public views::ImageButton,
+                              public thoron_mail::MailService::Observer {
+  METADATA_HEADER(ThoronMailAddressIcon, views::ImageButton)
+
+ public:
+  explicit ThoronMailAddressIcon(BrowserWindowInterface* browser);
+  ThoronMailAddressIcon(const ThoronMailAddressIcon&) = delete;
+  ThoronMailAddressIcon& operator=(const ThoronMailAddressIcon&) = delete;
+  ~ThoronMailAddressIcon() override;
+
+  // Where among the address bar's icons: "icons" (with the others), "start"
+  // (before them) or "end" (at the far end).
+  std::string position() const;
+  // Left of Thoron adblock's shield where the two are next to each other (the
+  // order of Thoron's buttons, P5.78).
+  bool before_shield() const;
+
+  // views::ImageButton:
+  void OnThemeChanged() override;
+  // Moved with the mouse past the shield next to it, the two change places.
+  bool OnMousePressed(const ui::MouseEvent& event) override;
+  bool OnMouseDragged(const ui::MouseEvent& event) override;
+  void OnMouseReleased(const ui::MouseEvent& event) override;
+  void OnMouseCaptureLost() override;
+
+  // thoron_mail::MailService::Observer:
+  void OnMailChanged() override;
+
+ private:
+  void ButtonPressed();
+  void Update();
+  PrefService* prefs() const;
+  void OnOrderChanged();
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  std::unique_ptr<ThoronMailMenu> menu_;
+  base::ScopedObservation<thoron_mail::MailService,
+                          thoron_mail::MailService::Observer>
+      mail_observation_{this};
+  PrefChangeRegistrar order_registrar_;
+  gfx::Point press_;
+  bool pressed_ = false;
+  bool dragging_ = false;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TOOLBAR_THORON_MAIL_BUTTON_H_
