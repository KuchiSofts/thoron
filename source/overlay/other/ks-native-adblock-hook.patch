+TEST_F(BrowserDetectionTest, RunningCheckFollowsLockfile) {
+  base::FilePath chromium = UserData(local_.GetPath(), L"Chromium\\User Data");
+  Write(chromium.Append(L"Local State"), "{}");
+  EXPECT_FALSE(IsBrowserRunning(chromium));
+  ASSERT_TRUE(base::WriteFile(chromium.Append(L"lockfile"), ""));
