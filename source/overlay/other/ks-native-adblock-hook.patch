+# Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+import("//chrome/browser/thoron_update/args.gni")
+
+# The variant this build is, as the manifest names it.
+if (current_cpu == "arm64") {
+  _thoron_update_variant = "win-arm64-armv8"
+} else if (thorium_x86_profile == "avx512_skx") {
+  _thoron_update_variant = "win-x64-avx512"
+} else if (thorium_x86_profile == "avx2_fma") {
+  _thoron_update_variant = "win-x64-avx2"
+} else {
+  _thoron_update_variant = "win-x64-sse4"
+}
+
+# The browser's updater on Windows (ROADMAP P3.20).
+source_set("thoron_update") {
+  # Linux and macOS get their updater later; the target is empty there.
+  sources = []
+  if (is_win) {
+    sources += [
+      "thoron_update_win.cc",
+      "thoron_update_win.h",
+    ]
+  }
+  defines = [
+    "THORON_UPDATE_PUBLIC_KEY=\"$thoron_update_public_key\"",
+    "THORON_UPDATE_MANIFEST_URL=\"$thoron_update_manifest_url\"",
+    "THORON_UPDATE_CHANNEL=\"$thoron_update_channel\"",
+    "THORON_UPDATE_VARIANT=\"$_thoron_update_variant\"",
+  ]
+  public_deps = [ "//components/thoron_update:client" ]
+  deps = [
+    "//base",
+    "//chrome/browser:browser_process",
+    "//chrome/browser/upgrade_detector",
+    "//content/public/browser",
+    "//net",
+    "//services/network/public/cpp",
+    "//url",
+  ]
+  if (is_win) {
+    # An install for every user is told apart (install_static::IsSystemInstall).
+    deps += [ "//chrome/install_static:install_static_util" ]
+  }
+}
