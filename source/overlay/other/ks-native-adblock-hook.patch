+namespace {
+
+// P5.77: the backup written by itself: {on, folder, keep, secret (its
+// passphrase encrypted by the system, base64), mark (a hash of what the last
+// one held, encrypted by the system, so the profile keeps no hash of the
+// passwords), name, time, error}.
+constexpr char kAutoBackupPref[] = "thoron_mail.auto_backup";
+constexpr char kAutoBackupPrefix[] = "thoron-m-notifier-auto-";
+constexpr int kMostAutoBackupsKept = 50;
+
+// How often it looks whether a new one is needed (the offline checks look
+// more often).
+base::TimeDelta AutoBackupLook() {
+  int seconds = 0;
+  if (base::StringToInt(
+          base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+              "thoron-mail-auto-backup-seconds-for-testing"),
+          &seconds) &&
+      seconds > 0) {
+    return base::Seconds(seconds);
+  }
+  return base::Minutes(2);
+}
+
+// One of its own files: the prefix, the time it was written
+// (YYYY-MM-DD-HHMMSS) and ".thoron" (sealed) or ".json"; nothing else is.
+bool IsAutoBackupName(std::string_view name) {
+  if (!base::StartsWith(name, kAutoBackupPrefix)) {
+    return false;
+  }
+  std::string_view stamp = name.substr(std::string_view(kAutoBackupPrefix).size());
+  if (base::EndsWith(stamp, ".thoron")) {
+    stamp.remove_suffix(7);
+  } else if (base::EndsWith(stamp, ".json")) {
+    stamp.remove_suffix(5);
+  } else {
+    return false;
+  }
+  constexpr std::string_view kShape = "0000-00-00-000000";
+  if (stamp.size() != kShape.size()) {
+    return false;
+  }
+  for (size_t i = 0; i < kShape.size(); ++i) {
+    if (kShape[i] == '-' ? stamp[i] != '-' : !base::IsAsciiDigit(stamp[i])) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// Off the UI thread: the backup's `json`, sealed with `passphrase` when
+// there is one, written into `folder` as a new file (WriteBackupFile: whole
+// and read back), then only the newest `keep` of its own files left there.
+// With `unchanged`, the last one's name: while that file is still there,
+// nothing is written. Gives {the new file's name, ""}, {"", why not}, or
+// {"", ""} when none was needed.
+std::pair<std::string, std::string> WriteAutoBackup(base::FilePath folder,
+                                                    std::string unchanged,
+                                                    std::string json,
+                                                    std::string passphrase,
+                                                    int keep,
+                                                    base::Time now) {
+  if (!base::DirectoryExists(folder)) {
+    return {std::string(), "folder"};
+  }
+  if (IsAutoBackupName(unchanged) &&
+      base::PathExists(folder.AppendASCII(unchanged))) {
+    return {std::string(), std::string()};
+  }
+  const bool seal = !passphrase.empty();
+  std::string text =
+      seal ? thoron_mail::SealBackup(json, passphrase) : std::move(json);
+  if (text.empty()) {
+    return {std::string(), "write"};
+  }
+  base::Time::Exploded at;
+  now.LocalExplode(&at);
+  const std::string name = base::StringPrintf(
+      "%s%04d-%02d-%02d-%02d%02d%02d.%s", kAutoBackupPrefix, at.year, at.month,
+      at.day_of_month, at.hour, at.minute, at.second, seal ? "thoron" : "json");
+  std::string error = WriteBackupFile(folder.AppendASCII(name), std::move(text));
+  if (!error.empty()) {
+    return {std::string(), std::move(error)};
+  }
+  // its own files, the newest first (their names sort by their time)
+  std::vector<std::string> own;
+  base::FileEnumerator files(folder, /*recursive=*/false,
+                             base::FileEnumerator::FILES);
+  for (base::FilePath path = files.Next(); !path.empty(); path = files.Next()) {
+    std::string found = path.BaseName().AsUTF8Unsafe();
+    if (IsAutoBackupName(found)) {
+      own.push_back(std::move(found));
+    }
+  }
+  std::ranges::sort(own, std::greater<>());
+  for (size_t i = static_cast<size_t>(keep); i < own.size(); ++i) {
+    if (own[i] != name) {
+      base::DeleteFile(folder.AppendASCII(own[i]));
+    }
+  }
+  return {name, std::string()};
+}
