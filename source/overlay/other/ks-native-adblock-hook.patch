+class MailHandler : public content::WebUIMessageHandler,
+                    public thoron_mail::MailService::Observer,
+                    public ui::SelectFileDialog::Listener {
+ public:
+  explicit MailHandler(ThoronMailMenuUI* controller)
+      : controller_(controller) {}
+  MailHandler(const MailHandler&) = delete;
+  MailHandler& operator=(const MailHandler&) = delete;
+  ~MailHandler() override {
+    if (select_file_dialog_) {
+      select_file_dialog_->ListenerDestroyed();
+    }
+  }
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override {
+    Register("getMailState", &MailHandler::GetState);
+    Register("checkNow", &MailHandler::CheckNow);
+    Register("openInbox", &MailHandler::OpenInbox);
+    Register("openLink", &MailHandler::OpenLink);
+    Register("signIn", &MailHandler::SignIn);
+    Register("addAccount", &MailHandler::AddAccount);
+    Register("setNotify", &MailHandler::SetNotify);
+    Register("setInterval", &MailHandler::SetInterval);
+    Register("setChoice", &MailHandler::SetChoice);
+    Register("setWatched", &MailHandler::SetWatched);
+    Register("addImapAccount", &MailHandler::AddImapAccount);
+    Register("removeImapAccount", &MailHandler::RemoveImapAccount);
+    Register("exportBackup", &MailHandler::ExportBackup);
+    Register("saveBackup", &MailHandler::SaveBackup);
+    Register("importBackup", &MailHandler::ImportBackup);
+    Register("setAutoBackup", &MailHandler::SetAutoBackup);
+    Register("chooseAutoBackupFolder", &MailHandler::ChooseAutoBackupFolder);
+    Register("setAutoBackupPassphrase", &MailHandler::SetAutoBackupPassphrase);
+    Register("saveAutoBackupNow", &MailHandler::SaveAutoBackupNow);
+    Register("editImapAccount", &MailHandler::EditImapAccount);
+    Register("editGoogleAccount", &MailHandler::EditGoogleAccount);
+    Register("setOrder", &MailHandler::SetOrder);
+    Register("setSound", &MailHandler::SetSound);
+    Register("setQuiet", &MailHandler::SetQuiet);
+    Register("setAccountSound", &MailHandler::SetAccountSound);
+    Register("previewSound", &MailHandler::PreviewSound);
+    Register("importGoogleAccounts", &MailHandler::ImportGoogleAccounts);
+    Register("removeGoogleAccount", &MailHandler::RemoveGoogleAccount);
+    Register("signInGoogle", &MailHandler::SignInGoogle);
+    Register("copyGooglePassword", &MailHandler::CopyGooglePassword);
+    Register("openManage", &MailHandler::OpenManage);
+    Register("menuReady", &MailHandler::MenuReady);
+    Register("closeMenu", &MailHandler::CloseMenu);
+  }
+  void OnJavascriptAllowed() override {
+    if (!observation_.IsObserving()) {
+      observation_.Observe(&Center().service());
+    }
+  }
+  void OnJavascriptDisallowed() override { observation_.Reset(); }
+
+  // thoron_mail::MailService::Observer:
+  void OnMailChanged() override {
+    if (IsJavascriptAllowed()) {
+      FireWebUIListener("mail-changed");
+    }
+  }
+
+ private:
+  using Method = void (MailHandler::*)(const base::ListValue&);
+  void Register(std::string_view message, Method method) {
+    web_ui()->RegisterMessageCallback(
+        message, base::BindRepeating(method, base::Unretained(this)));
+  }
+
+  ThoronMailCenter& Center() {
+    return ThoronMailCenter::For(Profile::FromWebUI(web_ui()));
+  }
+
+  void GetState(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.empty()) {
+      return;
+    }
+    const thoron_mail::MailService& service = Center().service();
+    base::ListValue accounts;
+    for (const thoron_mail::MailAccount& account : service.accounts()) {
+      // P5.81: a mailbox's details, for the person to edit (not its password)
+      base::DictValue server;
+      if (account.imap) {
+        for (const thoron_mail::ImapAccount& box : service.imap_accounts()) {
+          if (box.email == account.email) {
+            server = base::DictValue()
+                         .Set("host", box.host)
+                         .Set("port", box.port)
+                         .Set("user", box.user)
+                         .Set("webmail", box.webmail);
+          }
+        }
+      }
+      base::ListValue latest;
+      for (const thoron_mail::MailMessage& message : account.latest) {
+        latest.Append(base::DictValue()
+                          .Set("subject", message.subject)
+                          .Set("from", message.from_name)
+                          .Set("fromEmail", message.from_email)
+                          .Set("snippet", message.snippet)
+                          .Set("link", message.link)
+                          .Set("spam", message.spam)
+                          .Set("isNew", service.is_new(account, message))
+                          .Set("issued", JsTime(message.issued)));
+      }
+      accounts.Append(base::DictValue()
+                          .Set("index", account.index)
+                          .Set("email", account.email)
+                          .Set("unread", account.unread)
+                          .Set("new", service.new_count(account))
+                          .Set("watched", service.watched(account.email))
+                          // a mailbox added by address and password, and
+                          // why the last look at it failed ("" when not)
+                          .Set("imap", account.imap)
+                          .Set("server", std::move(server))
+                          .Set("problem", account.problem)
+                          .Set("latest", std::move(latest)));
+    }
+    // P5.80: the Google accounts of the person's list, each with whether it is
+    // counted (found at Google, or read as a mailbox) and whether a password
+    // is kept for it. The password itself is not sent.
+    base::ListValue wanted;
+    // in the person's order too (P5.81)
+    std::vector<ThoronMailCenter::GoogleAccount> listed =
+        Center().KeptGoogleAccounts();
+    const std::vector<std::string> order = service.Order();
+    std::ranges::stable_sort(
+        listed, {}, [&order](const ThoronMailCenter::GoogleAccount& account) {
+          return thoron_mail::PlaceInOrder(order, account.email);
+        });
+    for (const ThoronMailCenter::GoogleAccount& account : listed) {
+      const std::string name = thoron_mail::CanonicalAddress(account.email);
+      const bool counted = std::ranges::any_of(
+          service.accounts(), [&](const thoron_mail::MailAccount& found) {
+            return thoron_mail::CanonicalAddress(found.email) == name;
+          });
+      wanted.Append(base::DictValue()
+                        .Set("email", account.email)
+                        .Set("alias", account.alias)
+                        .Set("counted", counted)
+                        .Set("password", !account.password.empty() ||
+                                             !account.secret.empty()));
+    }
+    base::ListValue intervals;
+    for (int minutes : thoron_mail::MailService::kIntervals) {
+      intervals.Append(minutes);
+    }
+    base::DictValue choices;
+    for (const char* name :
+         {"sound", "count", "open", "messages", "which", "place",
+          "toolbar-position", "address-position"}) {
+      choices.Set(name, service.Choice(name));
+    }
+    // P5.82: the sound, its volume, the quiet rules and each account's own
+    const ThoronMailCenter::SoundSettings settings = Center().sound_settings();
+    base::ListValue names;
+    for (const std::string& made : thoron_mail::MadeSoundNames()) {
+      names.Append(made);
+    }
+    base::DictValue sound = base::DictValue()
+                                .Set("name", settings.name)
+                                .Set("volume", settings.volume)
+                                .Set("names", std::move(names))
+                                .Set("quietFullscreen", settings.quiet_fullscreen)
+                                .Set("quietInFront", settings.quiet_in_front)
+                                .Set("quietFrom", settings.quiet_from)
+                                .Set("quietTo", settings.quiet_to)
+                                .Set("accounts", Center().AccountSounds())
+                                .Set("last", Center().last_sound())
+                                .Set("held", Center().sounds_held())
+                                .Set("lastQuiet", Center().last_quiet());
+    // P5.81: the person's order, for the page's one list of every account
+    base::ListValue account_order;
+    for (const std::string& name : service.Order()) {
+      account_order.Append(name);
+    }
+    // P5.77: the backup written by itself (its passphrase is not sent)
+    const ThoronMailCenter::AutoBackup auto_backup = Center().auto_backup();
+    base::DictValue auto_state =
+        base::DictValue()
+            .Set("on", auto_backup.on)
+            .Set("folder", auto_backup.folder.AsUTF8Unsafe())
+            .Set("keep", auto_backup.keep)
+            .Set("sealed", auto_backup.sealed)
+            .Set("last", JsTime(auto_backup.last))
+            .Set("name", auto_backup.name)
+            .Set("error", auto_backup.error)
+            .Set("writing", auto_backup.writing);
+    ResolveJavascriptCallback(
+        args[0], base::DictValue()
+                     .Set("autoBackup", std::move(auto_state))
+                     .Set("sound", std::move(sound))
+                     .Set("order", std::move(account_order))
+                     .Set("accounts", std::move(accounts))
+                     .Set("wanted", std::move(wanted))
+                     .Set("choices", std::move(choices))
+                     .Set("totalNew", service.total_new())
+                     // how often new mail made a sound and a notice (the
+                     // offline checks cannot hear or see them)
+                     .Set("sounds", Center().sounds_played())
+                     .Set("notices", Center().notices_shown())
+                     // passwords can be kept (the system's encryption)
+                     .Set("canAddMailbox", Center().can_keep_passwords())
+                     .Set("total", service.total_unread())
+                     .Set("checking", service.checking())
+                     .Set("lastCheck", JsTime(service.last_check()))
+                     .Set("problem", service.problem())
+                     .Set("notify", service.notify())
+                     .Set("interval", service.interval_minutes())
+                     .Set("intervals", std::move(intervals)));
+  }
+
+  void CheckNow(const base::ListValue& args) { Center().service().CheckNow(); }
+
+  // The account's inbox (its address or "Open inbox" pressed): its new mail
+  // is counted from now (P5.76).
+  void OpenInbox(const base::ListValue& args) {
+    if (args.empty() || !args[0].is_int()) {
+      return;
+    }
+    Center().OpenAccount(args[0].GetInt());
+    CloseMenu(args);
+  }
+
+  // P5.77: a mailbox by its address and password. The answer is "" or why
+  // it was not added; the password is never sent back.
+  void AddImapAccount(const base::ListValue& args) {
+    AllowJavascript();
+    const base::DictValue* given =
+        args.size() >= 2 && args[0].is_string() ? args[1].GetIfDict() : nullptr;
+    if (!given) {
+      return;
+    }
+    thoron_mail::ImapAccount account;
+    auto text = [given](const char* name) {
+      const std::string* value = given->FindString(name);
+      return value ? *value : std::string();
+    };
+    account.email = text("email");
+    account.password = text("password");
+    account.host = text("host");
+    account.user = text("user");
+    account.webmail = text("webmail");
+    account.port = given->FindInt("port").value_or(993);
+    Center().AddImapAccount(
+        std::move(account),
+        base::BindOnce(&MailHandler::Answer, weak_factory_.GetWeakPtr(),
+                       args[0].GetString()));
+  }
+
+  void RemoveImapAccount(const base::ListValue& args) {
+    if (!args.empty() && args[0].is_string()) {
+      Center().RemoveImapAccount(args[0].GetString());
+    }
+  }
+
+  // The backup's text: [with passwords, passphrase].
+  void ExportBackup(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.size() < 3 || !args[0].is_string() || !args[1].is_bool() ||
+        !args[2].is_string()) {
+      return;
+    }
+    Center().ExportBackup(
+        args[1].GetBool(), args[2].GetString(),
+        base::BindOnce(&MailHandler::Answer, weak_factory_.GetWeakPtr(),
+                       args[0].GetString()));
+  }
+
+  // P5.81: a backup saved into a file the person chooses with the system's
+  // own Save dialog: [with passwords, passphrase] gives {error, name}. The
+  // browser writes the file and reads it back (WriteBackupFile), so a file
+  // that could not be written whole is told, never left empty. "error" is
+  // "" when it was saved, else "cancelled", "busy", "bad", "write" or
+  // "verify".
+  void SaveBackup(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.size() < 3 || !args[0].is_string() || !args[1].is_bool() ||
+        !args[2].is_string()) {
+      return;
+    }
+    if (select_file_dialog_ || !save_id_.empty() || !folder_id_.empty()) {
+      AnswerSaved(args[0].GetString(), "busy", base::FilePath());
+      return;
+    }
+    save_id_ = args[0].GetString();
+    save_sealed_ = !args[2].GetString().empty();
+    Center().ExportBackup(args[1].GetBool(), args[2].GetString(),
+                          base::BindOnce(&MailHandler::OnBackupMade,
+                                         weak_factory_.GetWeakPtr()));
+  }
+
+  void OnBackupMade(std::string text) {
+    if (text.empty()) {
+      AnswerSaved(std::exchange(save_id_, std::string()), "bad",
+                  base::FilePath());
+      return;
+    }
+    save_text_ = std::move(text);
+    // The offline checks give the file; nobody is there to choose one.
+    const base::CommandLine& command = *base::CommandLine::ForCurrentProcess();
+    if (command.HasSwitch("thoron-mail-backup-file-for-testing")) {
+      Write(command.GetSwitchValuePath("thoron-mail-backup-file-for-testing"));
+      return;
+    }
+    PrefService* prefs = Profile::FromWebUI(web_ui())->GetPrefs();
+    base::FilePath folder = prefs->GetFilePath("thoron_mail.backup_folder");
+    if (folder.empty()) {
+      folder = DownloadPrefs::FromBrowserContext(
+                   web_ui()->GetWebContents()->GetBrowserContext())
+                   ->DownloadPath();
+    }
+    // the day in the name: backups made on other days are kept beside it
+    const base::Time::Exploded now = [] {
+      base::Time::Exploded exploded;
+      base::Time::Now().LocalExplode(&exploded);
+      return exploded;
+    }();
+    const std::string extension = save_sealed_ ? "thoron" : "json";
+    const std::string name = base::StringPrintf(
+        "thoron-m-notifier-backup-%04d-%02d-%02d.%s", now.year, now.month,
+        now.day_of_month, extension.c_str());
+    content::WebContents* contents = web_ui()->GetWebContents();
+    select_file_dialog_ = ui::SelectFileDialog::Create(
+        this, std::make_unique<ChromeSelectFilePolicy>(contents));
+    const base::FilePath::StringType suffix =
+        base::FilePath::FromASCII(extension).value();
+    ui::SelectFileDialog::FileTypeInfo types{{suffix}};
+    select_file_dialog_->SelectFile(
+        ui::SelectFileDialog::SELECT_SAVEAS_FILE, std::u16string(),
+        folder.AppendASCII(name), &types, 0, suffix,
+        contents->GetTopLevelNativeWindow());
+  }
+
