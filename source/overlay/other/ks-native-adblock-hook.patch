@@ -0,0 +1,488 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/toolbar/thoron_mail_button.h"
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/browser/ui/extensions/icon_with_badge_image_source.h"
+#include "chrome/browser/ui/layout_constants.h"
+#include "chrome/browser/ui/views/bubble/webui_bubble_manager.h"
+#include "chrome/browser/ui/views/toolbar/toolbar_view.h"
+#include "chrome/browser/ui/webui/thoron_mail_ui.h"
+#include "chrome/browser/ui/webui/top_chrome/webui_contents_wrapper.h"
+#include "components/prefs/pref_service.h"
+#include "components/strings/grit/components_strings.h"
+#include "components/vector_icons/vector_icons.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_controller.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/color/color_provider.h"
+#include "ui/gfx/image/image.h"
+#include "ui/gfx/image/image_skia.h"
+#include "ui/gfx/image/image_skia_operations.h"
+#include "ui/gfx/paint_vector_icon.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/animation/ink_drop.h"
+#include "ui/views/bubble/bubble_border.h"
+#include "ui/views/controls/highlight_path_generator.h"
+#include "ui/views/view_utils.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/widget/widget_observer.h"
+
+namespace {
+
+// The envelope's colours and its count's are the browser theme's (P5.78,
+// thoron::ColorsOf), as the shield's.
+constexpr base::TimeDelta kReopenGuard = base::Milliseconds(300);
+constexpr base::TimeDelta kShowAnyway = base::Milliseconds(250);
+
+thoron_mail::MailService* ServiceOf(BrowserWindowInterface* browser) {
+  Profile* profile = browser ? browser->GetProfile() : nullptr;
+  return profile && !profile->IsOffTheRecord()
+             ? &ThoronMailCenter::For(profile).service()
+             : nullptr;
+}
+
+std::string BadgeText(int count) {
+  if (count <= 0) {
+    return std::string();
+  }
+  return count < 1000 ? base::NumberToString(count)
+                      : base::NumberToString(count / 1000) + "k";
+}
+
+std::u16string Tooltip(const thoron_mail::MailService& service) {
+  if (service.accounts().empty()) {
+    return service.last_check().is_null()
+               ? std::u16string(u"Thoron M-Notifier")
+               : u"Thoron M-Notifier: sign in to Gmail to see your mail here";
+  }
+  const int fresh = service.total_new();
+  const int unread = service.total_unread();
+  std::u16string text = u"Thoron M-Notifier: ";
+  if (fresh > 0) {
+    text += base::NumberToString16(fresh) + u" new, ";
+  }
+  text += unread == 0 ? std::u16string(u"no unread mail")
+                      : base::NumberToString16(unread) + u" unread";
+  return text;
+}
+
+// The envelope, `size` px, in the theme's accent while there is mail to
+// count. In the toolbar (`area` larger than `size`) it is in the middle of an
+// image `area` px wide and high with the count in the image's corner, as an
+// extension's badge: the envelope stays in view. In the address bar (`area`
+// is `size`) the count is right of the envelope: its icons are small.
+ui::ImageModel Envelope(const thoron_mail::MailService& service,
+                        const views::View* view,
+                        int size,
+                        int area,
+                        SkColor plain) {
+  const thoron::IconColors colors = thoron::ColorsOf(view->GetColorProvider());
+  const int count = service.icon_count();
+  const gfx::ImageSkia icon = gfx::CreateVectorIcon(
+      vector_icons::kMailIcon, size, count > 0 ? colors.accent : plain);
+  if (area == size) {
+    return ui::ImageModel::FromImageSkia(
+        thoron::WithCountBeside(icon, BadgeText(count), colors.accent));
+  }
+  return ui::ImageModel::FromImageSkia(thoron::WithCountBadge(
+      icon, area, BadgeText(count), colors.badge, colors.badge_text));
+}
+
+PrefService* PrefsOf(BrowserWindowInterface* browser) {
+  Profile* profile = browser ? browser->GetProfile() : nullptr;
+  return profile ? profile->GetOriginalProfile()->GetPrefs() : nullptr;
+}
+
+}  // namespace
+
+// The M-Notifier's menu of one envelope: opened from it, closed by a second
+// press, and shown at once with a page kept since it closed (as Thoron
+// adblock's menu, P5.71/P5.72).
+class ThoronMailMenu : public views::WidgetObserver {
+ public:
+  explicit ThoronMailMenu(BrowserWindowInterface* browser) : browser_(browser) {}
+  ThoronMailMenu(const ThoronMailMenu&) = delete;
+  ThoronMailMenu& operator=(const ThoronMailMenu&) = delete;
+  ~ThoronMailMenu() override = default;
+
+  void Toggle(views::View* anchor) {
+    if (!manager_) {
+      manager_ = WebUIBubbleManager::Create<ThoronMailMenuUI>(
+          browser_, GURL(kThoronMailMenuUrl), IDS_THORON_MAIL_MENU);
+    }
+    if (manager_->GetBubbleWidget()) {
+      manager_->CloseBubble();
+      return;
+    }
+    if (!closed_at_.is_null() &&
+        base::TimeTicks::Now() - closed_at_ < kReopenGuard) {
+      return;
+    }
+    if (!manager_->ShowBubble(anchor, views::BubbleBorder::TOP_RIGHT)) {
+      return;
+    }
+    if (manager_->bubble_using_cached_web_contents()) {
+      if (ThoronMailMenuUI* ui = MenuUI()) {
+        ui->TellShown();
+      }
+      show_anyway_.Start(FROM_HERE, kShowAnyway,
+                         base::BindOnce(&ThoronMailMenu::ShowNow,
+                                        base::Unretained(this)));
+    }
+    if (views::Widget* widget = manager_->GetBubbleWidget()) {
+      observation_.Reset();
+      observation_.Observe(widget);
+    }
+    // what is shown is as new as can be
+    if (thoron_mail::MailService* service = ServiceOf(browser_)) {
+      service->CheckNow();
+    }
+  }
+
+  // views::WidgetObserver:
+  void OnWidgetDestroying(views::Widget* widget) override {
+    closed_at_ = base::TimeTicks::Now();
+    observation_.Reset();
+    show_anyway_.Stop();
+  }
+
+ private:
+  ThoronMailMenuUI* MenuUI() {
+    WebUIContentsWrapper* contents = manager_->GetContentsWrapper();
+    content::WebUI* web_ui = contents && contents->web_contents()
+                                 ? contents->web_contents()->GetWebUI()
+                                 : nullptr;
+    return web_ui && web_ui->GetController()
+               ? web_ui->GetController()->GetAs<ThoronMailMenuUI>()
+               : nullptr;
+  }
+
+  void ShowNow() {
+    views::Widget* widget = manager_ ? manager_->GetBubbleWidget() : nullptr;
+    if (widget && !widget->IsVisible()) {
+      if (WebUIContentsWrapper* contents = manager_->GetContentsWrapper()) {
+        contents->ShowUI();
+      }
+    }
+  }
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  std::unique_ptr<WebUIBubbleManager> manager_;
+  base::ScopedObservation<views::Widget, views::WidgetObserver> observation_{
+      this};
+  base::TimeTicks closed_at_;
+  base::OneShotTimer show_anyway_;
+};
+
+// --- In the toolbar ---
+
+ThoronMailButton::ThoronMailButton(BrowserWindowInterface* browser)
+    : ToolbarButton(base::BindRepeating(&ThoronMailButton::ButtonPressed,
+                                        base::Unretained(this))),
+      browser_(browser),
+      menu_(std::make_unique<ThoronMailMenu>(browser)) {
+  SetTooltipText(u"Thoron M-Notifier");
+  GetViewAccessibility().SetName(u"Thoron M-Notifier");
+  thoron_mail::MailService* service = ServiceOf(browser_);
+  // the profile's own sign-in only: never in an off-the-record window
+  if (!service) {
+    SetVisible(false);
+    return;
+  }
+  mail_observation_.Observe(service);
+  SetVisible(service->Choice("place") != "address");
+  // The image is larger than the envelope, as an extension's (the count is in
+  // its corner): the button's insets are smaller by as much.
+  SetLayoutInsetDelta(gfx::Insets(-thoron::kToolbarImageMargin / 2));
+  // base::Unretained is safe: the drag and the registrar end with this button.
+  drag_ = std::make_unique<thoron::ToolbarDrag>(
+      this, thoron::kMailId, prefs(),
+      base::BindRepeating(&ThoronMailButton::toolbar_position,
+                          base::Unretained(this)),
+      base::BindRepeating(
+          [](ThoronMailButton* button, const std::string& where) {
+            if (thoron_mail::MailService* mail = ServiceOf(button->browser_)) {
+              mail->SetChoice("toolbar-position", where);
+            }
+          },
+          base::Unretained(this)));
+  if (PrefService* settings = prefs()) {
+    order_registrar_.Init(settings);
+    order_registrar_.Add(thoron::kToolbarOrderPref,
+                         base::BindRepeating(&ThoronMailButton::ApplyPlace,
+                                             base::Unretained(this)));
+  }
+}
+
+ThoronMailButton::~ThoronMailButton() = default;
+
+PrefService* ThoronMailButton::prefs() const {
+  return PrefsOf(browser_);
+}
+
+std::string ThoronMailButton::toolbar_position() const {
+  thoron_mail::MailService* service = ServiceOf(browser_);
+  return service ? service->Choice("toolbar-position")
+                 : std::string("extensions");
+}
+
+bool ThoronMailButton::OnMousePressed(const ui::MouseEvent& event) {
+  if (drag_) {
+    drag_->Pressed(event);
+  }
+  return ToolbarButton::OnMousePressed(event);
+}
+
+bool ThoronMailButton::OnMouseDragged(const ui::MouseEvent& event) {
+  if (drag_ && drag_->Dragged(event)) {
+    return true;
+  }
+  return ToolbarButton::OnMouseDragged(event);
+}
+
+void ThoronMailButton::OnMouseReleased(const ui::MouseEvent& event) {
+  if (drag_ && drag_->Ended()) {
+    // the press moved the envelope: it opens no menu
+    OnClickCanceled(event);
+    SetState(STATE_NORMAL);
+    return;
+  }
+  ToolbarButton::OnMouseReleased(event);
+}
+
+void ThoronMailButton::OnMouseCaptureLost() {
+  if (drag_) {
+    drag_->Ended();
+  }
+  ToolbarButton::OnMouseCaptureLost();
+}
+
+void ThoronMailButton::UpdateIcon() {
+  thoron_mail::MailService* service = ServiceOf(browser_);
+  if (!GetWidget() || !GetColorProvider() || !service) {
+    return;
+  }
+  const ui::ImageModel image =
+      Envelope(*service, this, GetIconSize(),
+               GetIconSize() + thoron::kToolbarImageMargin,
+               GetForegroundColor(ButtonState::STATE_NORMAL));
+  for (auto state : kButtonStates) {
+    SetImageModel(state, image);
+  }
+  const std::u16string tooltip = Tooltip(*service);
+  SetTooltipText(tooltip);
+  GetViewAccessibility().SetName(tooltip);
+}
+
+void ThoronMailButton::AddedToWidget() {
+  ToolbarButton::AddedToWidget();
+  // after the toolbar has made its other buttons
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&ThoronMailButton::ApplyPlace,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void ThoronMailButton::OnMailChanged() {
+  ApplyPlace();
+  UpdateIcon();
+}
+
+void ThoronMailButton::ButtonPressed() {
+  menu_->Toggle(this);
+}
+
+void ThoronMailButton::ApplyPlace() {
+  thoron_mail::MailService* service = ServiceOf(browser_);
+  ToolbarView* toolbar = views::AsViewClass<ToolbarView>(parent());
+  if (!service || !toolbar) {
+    return;
+  }
+  SetVisible(service->Choice("place") != "address");
+  // with Thoron's other buttons, in their order (P5.78)
+  thoron::ArrangeToolbar(toolbar);
+}
+
+// --- In the address bar ---
+
+ThoronMailAddressIcon::ThoronMailAddressIcon(BrowserWindowInterface* browser)
+    : views::ImageButton(
+          base::BindRepeating(&ThoronMailAddressIcon::ButtonPressed,
+                              base::Unretained(this))),
+      browser_(browser),
+      menu_(std::make_unique<ThoronMailMenu>(browser)) {
+  SetImageHorizontalAlignment(views::ImageButton::ALIGN_CENTER);
+  SetImageVerticalAlignment(views::ImageButton::ALIGN_MIDDLE);
+  views::InkDrop::Get(this)->SetMode(views::InkDropHost::InkDropMode::ON);
+  SetHasInkDropActionOnClick(true);
+  views::InstallCircleHighlightPathGenerator(this);
+  SetTooltipText(u"Thoron M-Notifier");
+  GetViewAccessibility().SetName(u"Thoron M-Notifier");
+  const int size =
+      GetLayoutConstant(LayoutConstant::kLocationBarTrailingIconSize);
+  SetPreferredSize(gfx::Size(size + 4, size + 4));
+  thoron_mail::MailService* service = ServiceOf(browser_);
+  if (!service) {
+    SetVisible(false);
+    return;
+  }
+  mail_observation_.Observe(service);
+  SetVisible(service->Choice("place") != "toolbar");
+  if (PrefService* settings = prefs()) {
+    order_registrar_.Init(settings);
+    // base::Unretained is safe: the registrar ends with this icon.
+    order_registrar_.Add(
+        thoron::kToolbarOrderPref,
+        base::BindRepeating(&ThoronMailAddressIcon::OnOrderChanged,
+                            base::Unretained(this)));
+  }
+}
+
+ThoronMailAddressIcon::~ThoronMailAddressIcon() = default;
+
+PrefService* ThoronMailAddressIcon::prefs() const {
+  return PrefsOf(browser_);
+}
+
+bool ThoronMailAddressIcon::before_shield() const {
+  return thoron::MailBeforeAdblock(prefs());
+}
+
+void ThoronMailAddressIcon::OnOrderChanged() {
+  if (parent()) {
+    parent()->InvalidateLayout();
+  }
+}
+
+bool ThoronMailAddressIcon::OnMousePressed(const ui::MouseEvent& event) {
+  pressed_ = event.IsOnlyLeftMouseButton();
+  dragging_ = false;
+  press_ = event.location();
+  return views::ImageButton::OnMousePressed(event);
+}
+
+bool ThoronMailAddressIcon::OnMouseDragged(const ui::MouseEvent& event) {
+  if (!pressed_ || !parent()) {
+    return views::ImageButton::OnMouseDragged(event);
+  }
+  if (!dragging_) {
+    if (!views::View::ExceededDragThreshold(event.location() - press_)) {
+      return views::ImageButton::OnMouseDragged(event);
+    }
+    dragging_ = true;
+  }
+  // The shield next to this icon: the address bar's icon whose words are
+  // Thoron adblock's. Past its middle, the two change places.
+  gfx::Point pointer = event.location();
+  views::View::ConvertPointToTarget(this, parent(), &pointer);
+  for (views::View* sibling : parent()->children()) {
+    if (sibling == this || !sibling->GetVisible() ||
+        !sibling->GetRenderedTooltipText(gfx::Point()).starts_with(
+            u"Thoron adblock")) {
+      continue;
+    }
+    const bool first = pointer.x() < sibling->x() + sibling->width() / 2;
+    if (first != before_shield()) {
+      thoron::SetToolbarOrder(
+          prefs(), first ? std::vector<std::string>{thoron::kMailId,
+                                                    thoron::kAdblockId}
+                         : std::vector<std::string>{thoron::kAdblockId,
+                                                    thoron::kMailId});
+    }
+    break;
+  }
+  return true;
+}
+
+void ThoronMailAddressIcon::OnMouseReleased(const ui::MouseEvent& event) {
+  const bool was_drag = dragging_;
+  pressed_ = false;
+  dragging_ = false;
+  if (was_drag) {
+    // the press moved the envelope: it opens no menu
+    OnClickCanceled(event);
+    SetState(STATE_NORMAL);
+    return;
+  }
+  views::ImageButton::OnMouseReleased(event);
+}
+
+void ThoronMailAddressIcon::OnMouseCaptureLost() {
+  pressed_ = false;
+  dragging_ = false;
+  views::ImageButton::OnMouseCaptureLost();
+}
+
+std::string ThoronMailAddressIcon::position() const {
+  thoron_mail::MailService* service = ServiceOf(browser_);
+  return service ? service->Choice("address-position") : std::string("icons");
+}
+
+void ThoronMailAddressIcon::OnThemeChanged() {
+  views::ImageButton::OnThemeChanged();
+  Update();
+}
+
+void ThoronMailAddressIcon::OnMailChanged() {
+  thoron_mail::MailService* service = ServiceOf(browser_);
+  const bool shown = service && service->Choice("place") != "toolbar";
+  if (shown != GetVisible()) {
+    SetVisible(shown);
+  }
+  Update();
+  // the place among the address bar's icons may have changed
+  if (parent()) {
+    parent()->InvalidateLayout();
+  }
+}
+
+void ThoronMailAddressIcon::ButtonPressed() {
+  menu_->Toggle(this);
+}
+
+void ThoronMailAddressIcon::Update() {
+  thoron_mail::MailService* service = ServiceOf(browser_);
+  if (!service || !GetColorProvider()) {
+    return;
+  }
+  const int size =
+      GetLayoutConstant(LayoutConstant::kLocationBarTrailingIconSize);
+  // the address bar's: the image is the icon itself, and its count beside it
+  const ui::ImageModel image =
+      Envelope(*service, this, size, /*area=*/size,
+               GetColorProvider()->GetColor(kColorOmniboxResultsIcon));
+  SetImageModel(views::Button::STATE_NORMAL, image);
+  // as wide as what is drawn
+  const gfx::Size wanted(image.Size().width() + 4, size + 4);
+  if (GetPreferredSize() != wanted) {
+    SetPreferredSize(wanted);
+    if (parent()) {
+      parent()->InvalidateLayout();
+    }
+  }
+  const std::u16string tooltip = Tooltip(*service);
+  SetTooltipText(tooltip);
+  GetViewAccessibility().SetName(tooltip);
+}
+
+BEGIN_METADATA(ThoronMailButton)
+END_METADATA
+
+BEGIN_METADATA(ThoronMailAddressIcon)
+END_METADATA
