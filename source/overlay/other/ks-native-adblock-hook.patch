+TEST(ThoronUpdateManifestTest, ReadsTheExampleIntoEveryField) {
+  const Decision decision = CheckExample(ExampleCopy());
+  ASSERT_EQ(decision.outcome, Outcome::kUpdate);
+  EXPECT_EQ(decision.remember_serial, kSerial);
+  ASSERT_TRUE(decision.manifest);
+  const Manifest& manifest = *decision.manifest;
+  EXPECT_EQ(manifest.channel, "stable");
+  EXPECT_EQ(manifest.serial, kSerial);
+  EXPECT_EQ(manifest.published, kPublished);
+  EXPECT_EQ(manifest.expires, kExpires);
+  EXPECT_EQ(manifest.expires - manifest.published, int64_t{30} * 24 * 60 * 60);
+  EXPECT_EQ(ToString(manifest.version), "158.0.8127.4500");
+  EXPECT_EQ(manifest.thoron_version, "0.1.2");
+  EXPECT_EQ(ToString(manifest.chromium_version), "158.0.8127.45");
+  EXPECT_TRUE(manifest.critical);
+  EXPECT_EQ(ToString(manifest.min_updater_version), "158.0.8127.3000");
+
+  ASSERT_EQ(manifest.packages.size(), 3u);
+  const auto installed =
+      manifest.packages.find({Variant::kWinX64Avx2, Kind::kInstalled});
+  const auto portable =
+      manifest.packages.find({Variant::kWinX64Avx2, Kind::kPortable});
+  const auto sse4 =
+      manifest.packages.find({Variant::kWinX64Sse4, Kind::kInstalled});
+  ASSERT_TRUE(installed != manifest.packages.end());
+  ASSERT_TRUE(portable != manifest.packages.end());
+  ASSERT_TRUE(sse4 != manifest.packages.end());
+
+  const PackageFile& full = installed->second.full;
+  EXPECT_EQ(full.url,
+            "https://github.com/KuchiSofts/thoron/releases/download/v0.1.2/"
+            "thoron-158.0.8127.4500-win-x64-avx2-installer.exe");
+  EXPECT_EQ(full.size, 104857600);
+  EXPECT_EQ(full.sha256,
+            "ac60555676060f4ff7febfa0fdb5c52754fe64ed443f6951de80230807218ed4");
+  ASSERT_EQ(installed->second.deltas.size(), 1u);
+  const auto delta = installed->second.deltas.begin();
+  EXPECT_EQ(ToString(delta->first), "158.0.8127.3000");
+  EXPECT_EQ(delta->second.url,
+            "https://github.com/KuchiSofts/thoron/releases/download/v0.1.2/"
+            "thoron-158.0.8127.3000-to-158.0.8127.4500-win-x64-avx2-installed"
+            ".delta");
+  EXPECT_EQ(delta->second.size, 9437184);
+  EXPECT_EQ(delta->second.sha256,
+            "d1453fc2ac526446e9daf1379c4701e2af24ee7eb8686ffc6dd7700c45d49f29");
+  EXPECT_EQ(portable->second.full.size, 157286400);
+  EXPECT_TRUE(portable->second.deltas.empty());
+  EXPECT_EQ(sse4->second.full.size, 103809024);
+  EXPECT_TRUE(sse4->second.deltas.empty());
+
+  // What the copy downloads: the full package, or the delta from exactly the
+  // version it has.
+  ASSERT_TRUE(decision.full);
+  ASSERT_TRUE(decision.delta);
+  EXPECT_EQ(*decision.full, full);
+  EXPECT_EQ(*decision.delta, delta->second);
+}
