+    return {"--check", "--manifest=" + manifest.AsUTF8Unsafe(),
+            "--signature=" + signature.AsUTF8Unsafe(), "--public-key=" + base::Base64Encode(key),
+            "--channel=stable", "--installed=" + installed, "--updater=158.0.8127.3000",
+            "--variant=win-x64-avx2", "--kind=installed", "--allowed-host=github.com",
+            "--now=" + base::NumberToString(now)};
