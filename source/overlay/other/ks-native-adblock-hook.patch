@@ -0,0 +1,191 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_update/snapshot.h"
+
+#include <algorithm>
+#include <cstdlib>
+#include <map>
+#include <string>
+#include <vector>
+
+#include "base/environment.h"
+#include "base/files/file_enumerator.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/strings/string_number_conversions.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/sqlite/sqlite3.h"
+
+namespace thoron_update {
+namespace {
+
+void MakeDatabase(const base::FilePath& path, const std::string& row) {
+  ASSERT_TRUE(base::CreateDirectory(path.DirName()));
+  ASSERT_EQ(sqlite3_initialize(), SQLITE_OK);
+  sqlite3* db = nullptr;
+  ASSERT_EQ(sqlite3_open_v2(path.AsUTF8Unsafe().c_str(), &db,
+                            SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE, nullptr),
+            SQLITE_OK);
+  const std::string sql = "CREATE TABLE t(v TEXT); INSERT INTO t VALUES('" + row + "');";
+  ASSERT_EQ(sqlite3_exec(db, sql.c_str(), nullptr, nullptr, nullptr), SQLITE_OK);
+  sqlite3_close(db);
+}
+
+std::map<std::string, std::string> AllFiles(const base::FilePath& root) {
+  std::map<std::string, std::string> out;
+  base::FileEnumerator found(root, /*recursive=*/true, base::FileEnumerator::FILES);
+  for (base::FilePath path = found.Next(); !path.empty(); path = found.Next()) {
+    base::FilePath relative;
+    root.AppendRelativePath(path, &relative);
+    std::string content;
+    EXPECT_TRUE(base::ReadFileToString(path, &content));
+    std::string name = relative.AsUTF8Unsafe();
+    std::replace(name.begin(), name.end(), '\\', '/');
+    out[name] = content;
+  }
+  return out;
+}
+
+class ThoronUpdateSnapshotTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(dir_.CreateUniqueTempDir());
+    user_data_ = dir_.GetPath().AppendASCII("User Data");
+    snapshots_ = dir_.GetPath().AppendASCII("snapshots");
+    // two profiles, as the browser lays them out (made-up content)
+    for (const char* profile : {"Default", "Profile 1"}) {
+      const base::FilePath p = user_data_.AppendASCII(profile);
+      ASSERT_TRUE(base::CreateDirectory(p.AppendASCII("Sessions")));
+      ASSERT_TRUE(base::WriteFile(p.AppendASCII("Preferences"), "{\"made\":\"up\"}"));
+      ASSERT_TRUE(base::WriteFile(p.AppendASCII("Bookmarks"), std::string("{\"b\":") + profile + "}"));
+      ASSERT_TRUE(base::WriteFile(p.AppendASCII("Sessions").AppendASCII("Session_1"), "tabs"));
+      MakeDatabase(p.AppendASCII("History"), profile);
+      MakeDatabase(p.AppendASCII("Network").AppendASCII("Cookies"), "c");
+      // not part of a snapshot
+      ASSERT_TRUE(base::WriteFile(p.AppendASCII("Cache.bin"), std::string(5000, 'x')));
+    }
+    ASSERT_TRUE(base::WriteFile(user_data_.AppendASCII("Local State"), "{\"profile\":{}}"));
+  }
+
+  base::ScopedTempDir dir_;
+  base::FilePath user_data_;
+  base::FilePath snapshots_;
+};
+
+TEST_F(ThoronUpdateSnapshotTest, TakesTheCriticalFilesOfEveryProfileAndVerifiesThem) {
+  const SnapshotReport report = TakeSnapshot(user_data_, snapshots_, "before-159");
+  EXPECT_TRUE(report.ok) << (report.problems.empty() ? "" : report.problems[0]);
+  EXPECT_EQ(report.profiles, 2);
+  // Local State, and in each profile Preferences, Bookmarks, History, Cookies, a session
+  EXPECT_EQ(report.files, 11);
+  EXPECT_GT(report.bytes, 0);
+  const std::map<std::string, std::string> taken = AllFiles(report.folder);
+  EXPECT_TRUE(taken.contains("snapshot.json"));
+  EXPECT_FALSE(taken.contains("Default/Cache.bin"));
+  EXPECT_EQ(taken.at("Profile 1/Bookmarks"), "{\"b\":Profile 1}");
+}
+
+TEST_F(ThoronUpdateSnapshotTest, ADamagedDatabaseIsNamedAndTheSnapshotKept) {
+  const base::FilePath history = user_data_.AppendASCII("Default").AppendASCII("History");
+  std::string bytes;
+  ASSERT_TRUE(base::ReadFileToString(history, &bytes));
+  // The second page is the table's; its header says what kind of page it is.
+  // A header that is no kind of page is damage SQLite's check finds.
+  const size_t page = static_cast<uint8_t>(bytes[16]) * 256 + static_cast<uint8_t>(bytes[17]);
+  ASSERT_GE(page, 512u);
+  ASSERT_GE(bytes.size(), 2 * page);
+  for (size_t i = page; i < page + 12; ++i) {
+    bytes[i] = static_cast<char>(0xff);
+  }
+  ASSERT_TRUE(base::WriteFile(history, bytes));
+  const SnapshotReport report = TakeSnapshot(user_data_, snapshots_, "damaged");
+  EXPECT_FALSE(report.ok);
+  ASSERT_EQ(report.problems.size(), 1u);
+  EXPECT_EQ(report.problems[0], "Default/History: damaged");
+  EXPECT_TRUE(base::PathExists(report.folder.AppendASCII("snapshot.json")));
+}
+
+TEST_F(ThoronUpdateSnapshotTest, OnlyTheLastTwoAreKept) {
+  for (const char* label : {"one", "two", "three"}) {
+    ASSERT_TRUE(TakeSnapshot(user_data_, snapshots_, label).ok);
+    base::TouchFile(snapshots_.AppendASCII(label), base::Time::Now(), base::Time::Now());
+  }
+  EXPECT_FALSE(base::PathExists(snapshots_.AppendASCII("one")));
+  EXPECT_TRUE(base::PathExists(snapshots_.AppendASCII("two")));
+  EXPECT_TRUE(base::PathExists(snapshots_.AppendASCII("three")));
+}
+
+TEST_F(ThoronUpdateSnapshotTest, ABadLabelOrATakenOneIsRefused) {
+  for (const char* label : {"", "../out", "a/b", ".hidden"}) {
+    EXPECT_FALSE(TakeSnapshot(user_data_, snapshots_, label).ok) << label;
+  }
+  ASSERT_TRUE(TakeSnapshot(user_data_, snapshots_, "same").ok);
+  EXPECT_FALSE(TakeSnapshot(user_data_, snapshots_, "same").ok);
+}
+
+// P3.8, the profile's half: changed after the snapshot, put back byte for byte.
+TEST_F(ThoronUpdateSnapshotTest, ARestoreGivesBackTheSnapshotByteForByte) {
+  const std::map<std::string, std::string> before = AllFiles(user_data_);
+  const SnapshotReport report = TakeSnapshot(user_data_, snapshots_, "before-159");
+  ASSERT_TRUE(report.ok);
+  // what a new version might do to the profile
+  const base::FilePath p = user_data_.AppendASCII("Default");
+  ASSERT_TRUE(base::WriteFile(p.AppendASCII("Preferences"), "{\"made\":\"other\"}"));
+  ASSERT_TRUE(base::DeleteFile(p.AppendASCII("Bookmarks")));
+  MakeDatabase(p.AppendASCII("Web Data"), "new");
+  std::vector<std::string> problems;
+  ASSERT_TRUE(RestoreSnapshot(report.folder, user_data_, &problems));
+  std::map<std::string, std::string> after = AllFiles(user_data_);
+  // a file the snapshot did not hold is left alone
+  EXPECT_TRUE(after.contains("Default/Web Data"));
+  after.erase("Default/Web Data");
+  EXPECT_EQ(after, before);
+}
+
+TEST_F(ThoronUpdateSnapshotTest, NothingIsPutBackFromASnapshotThatDoesNotVerify) {
+  const SnapshotReport report = TakeSnapshot(user_data_, snapshots_, "before-159");
+  ASSERT_TRUE(report.ok);
+  ASSERT_TRUE(base::WriteFile(report.folder.AppendASCII("Default").AppendASCII("Bookmarks"), "x"));
+  ASSERT_TRUE(base::WriteFile(user_data_.AppendASCII("Default").AppendASCII("Preferences"), "{}"));
+  std::vector<std::string> problems;
+  EXPECT_FALSE(RestoreSnapshot(report.folder, user_data_, &problems));
+  ASSERT_EQ(problems.size(), 1u);
+  EXPECT_EQ(problems[0], "Default/Bookmarks: does not verify");
+  // the profile is as it was before the attempt
+  std::string preferences;
+  ASSERT_TRUE(base::ReadFileToString(user_data_.AppendASCII("Default").AppendASCII("Preferences"),
+                                     &preferences));
+  EXPECT_EQ(preferences, "{}");
+}
+
+// On a copy of a real profile, when one is named (THORON_SNAPSHOT_PROFILE_COPY):
+// the snapshot is taken, every file verifies, and what SQLite finds is reported.
+// Only counts and file names are printed.
+TEST(ThoronUpdateSnapshotRealTest, OnACopyOfARealProfile) {
+  const std::unique_ptr<base::Environment> env = base::Environment::Create();
+  const std::optional<std::string> copy = env->GetVar("THORON_SNAPSHOT_PROFILE_COPY");
+  if (!copy || copy->empty()) {
+    GTEST_SKIP() << "no profile copy named";
+  }
+  base::ScopedTempDir out;
+  ASSERT_TRUE(out.CreateUniqueTempDir());
+  const SnapshotReport report =
+      TakeSnapshot(base::FilePath::FromUTF8Unsafe(*copy), out.GetPath(), "real");
+  printf("snapshot of a profile copy: %d profiles, %d files, %lld bytes, %zu problem(s)\n",
+         report.profiles, report.files, static_cast<long long>(report.bytes),
+         report.problems.size());
+  for (const std::string& problem : report.problems) {
+    printf("  %s\n", problem.c_str());
+  }
+  EXPECT_GT(report.profiles, 0);
+  EXPECT_GT(report.files, 0);
+  EXPECT_TRUE(base::PathExists(report.folder.AppendASCII("snapshot.json")));
+  for (const std::string& problem : report.problems) {
+    EXPECT_EQ(problem.find("does not verify"), std::string::npos) << problem;
+  }
+}
+
+}  // namespace
+}  // namespace thoron_update
