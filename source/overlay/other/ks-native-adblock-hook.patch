+function showAccounts(next) {
+  const box = $('accounts');
+  box.replaceChildren();
+  if (!next.accounts.length) {
+    const empty = make('div', 'empty');
+    if (next.problem === 'offline' || next.problem === 'error') {
+      empty.append(make('p', '', t('Gmail could not be reached. Thoron tries again by itself.')));
+    } else if (next.lastCheck) {
+      empty.append(make('p', '', t('You are not signed in to Gmail in this browser.')));
+      const signIn = make('button', 'main', t('Sign in to Gmail'));
+      signIn.type = 'button';
+      signIn.addEventListener('click', () => chrome.send('signIn'));
+      empty.append(signIn);
+    } else {
+      empty.append(make('p', '', t('Not looked yet')));
+    }
+    box.append(empty);
+  }
+  // only the accounts and their counts, as X-notifier, unless the messages are asked for
+  const listed = next.choices.messages === 'on';
+  for (const account of next.accounts) {
+    const card = make('section', account.watched ? 'account' : 'account off');
+    // the account opens its inbox, and its new mail is counted from then
+    const row = make('button', 'row');
+    row.type = 'button';
+    row.title = t('Open the inbox (the new mail is counted from then)');
+    row.addEventListener('click', () => chrome.send('openInbox', [account.index]));
+    row.append(make('span', 'face', (account.email || '?').slice(0, 1)), make('span', 'email', account.email));
+    if (account.problem) {
+      // a mailbox the last look could not read
+      const warn = make('span', 'warn', '!');
+      warn.title = t(account.problem === 'sign-in' ?
+          'Sign-in refused: its password may have changed. Remove it and add it again.' :
+          'Could not be reached at the last look.');
+      row.append(warn);
+    }
+    if (account.new) {
+      row.append(make('span', 'count new', String(account.new)));
+    }
+    const unread = make('span', 'count unread', String(account.unread));
+    unread.title = `${account.unread} ${t('unread')}`;
+    row.append(unread);
+    card.append(row);
+    if (listed) {
+      for (const message of account.latest.slice(0, 5)) {
+        card.append(showMessage(message, account.index));
+      }
+      if (account.unread > 5) {
+        card.append(make('p', 'more', `+${account.unread - 5} ${t('more unread')}`));
+      }
+    }
+    box.append(card);
+  }
