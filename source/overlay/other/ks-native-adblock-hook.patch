+TEST_F(ThoronUpdateClientTest, AFarLongerDownloadIsCutOffAtTheSignedSize) {
+  Publish();
+  const std::string delta = Bytes(data::kDelta), full = Bytes(data::kInstaller);
+  network_.AddResponse(data::kDeltaUrl, delta + std::string(4 << 20, 'x'));
+  network_.AddResponse(data::kInstallerUrl, full + std::string(4 << 20, 'x'));
+  EXPECT_EQ(Look(*Client(), /*install=*/true).state, State::kError);
+  EXPECT_TRUE(installed_.empty());
+  // No more than one byte past the signed size was ever written (U2).
+  const int64_t most = static_cast<int64_t>(std::max(delta.size(), full.size())) + 1;
+  base::FileEnumerator left(config_.download_dir, false, base::FileEnumerator::FILES);
+  for (base::FilePath path = left.Next(); !path.empty(); path = left.Next()) {
+    EXPECT_LE(left.GetInfo().GetSize(), most) << path;
+  }
+}
