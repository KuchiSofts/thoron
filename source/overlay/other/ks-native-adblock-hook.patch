--- /dev/null
+++ b/components/thoron_portable_key/os_key_store_linux.cc
@@ -0,0 +1,330 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_portable_key/os_key_store_linux.h"
+
+#include <stdlib.h>
+
+#include <algorithm>
+#include <string>
+#include <string_view>
+#include <utility>
+
+#include "base/memory/scoped_refptr.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_view_util.h"
+#include "base/task/sequenced_task_runner.h"
+#include "crypto/aead.h"
+#include "crypto/random.h"
+#include "dbus/bus.h"
+#include "dbus/message.h"
+#include "dbus/object_path.h"
+#include "dbus/object_proxy.h"
+
+namespace thoron_portable_key {
+
+namespace {
+
+constexpr size_t kTagSize = 4;
+constexpr size_t kNonceSize = 12;
+constexpr size_t kItemKeySize = 32;
+
+constexpr char kService[] = "org.freedesktop.secrets";
+constexpr char kServicePath[] = "/org/freedesktop/secrets";
+constexpr char kDefaultCollection[] = "/org/freedesktop/secrets/aliases/default";
+constexpr char kServiceInterface[] = "org.freedesktop.Secret.Service";
+constexpr char kCollectionInterface[] = "org.freedesktop.Secret.Collection";
+constexpr char kItemInterface[] = "org.freedesktop.Secret.Item";
+constexpr char kSessionInterface[] = "org.freedesktop.Secret.Session";
+constexpr int kTimeoutMs = 5000;
+
+std::vector<uint8_t> AssociatedData(base::span<const uint8_t> id) {
+  std::vector<uint8_t> out(kSecretServiceBlobTag, kSecretServiceBlobTag + kTagSize);
+  out.insert(out.end(), id.begin(), id.end());
+  return out;
+}
+
+std::unique_ptr<dbus::Response> Call(dbus::ObjectProxy* proxy, dbus::MethodCall* call) {
+  auto result = proxy->CallMethodAndBlock(call, kTimeoutMs);
+  if (!result.has_value()) {
+    return nullptr;
+  }
+  return std::move(result.value());
+}
+
+void AppendAttributes(dbus::MessageWriter* writer, const std::string& id_hex) {
+  dbus::MessageWriter attributes(nullptr);
+  writer->OpenArray("{ss}", &attributes);
+  for (const auto& [name, value] : {std::pair<std::string, std::string>(
+                                        "application", kSecretServiceApplication),
+                                    std::pair<std::string, std::string>(kSecretServiceIdAttribute, id_hex)}) {
+    dbus::MessageWriter entry(nullptr);
+    attributes.OpenDictEntry(&entry);
+    entry.AppendString(name);
+    entry.AppendString(value);
+    attributes.CloseContainer(&entry);
+  }
+  writer->CloseContainer(&attributes);
+}
+
+// A private connection to the session bus with a "plain" session of the
+// Secret Service (the secret travels on the local bus only, as Chromium's own
+// keyring code sends it), for one Protect() or Unprotect().
+class Session {
+ public:
+  Session() {
+    // The bus needs a task runner on this sequence (the browser's start and
+    // the page's sequenced tasks have one).
+    if (!getenv("DBUS_SESSION_BUS_ADDRESS") || !base::SequencedTaskRunner::HasCurrentDefault()) {
+      return;
+    }
+    dbus::Bus::Options options;
+    options.bus_type = dbus::Bus::SESSION;
+    options.connection_type = dbus::Bus::PRIVATE;
+    bus_ = base::MakeRefCounted<dbus::Bus>(std::move(options));
+    if (!bus_->Connect()) {
+      return;
+    }
+    dbus::MethodCall open(kServiceInterface, "OpenSession");
+    dbus::MessageWriter writer(&open);
+    writer.AppendString("plain");
+    writer.AppendVariantOfString(std::string());
+    std::unique_ptr<dbus::Response> opened = Call(service(), &open);
+    if (!opened) {
+      return;
+    }
+    dbus::MessageReader reader(opened.get());
+    dbus::MessageReader output(nullptr);
+    if (!reader.PopVariant(&output) || !reader.PopObjectPath(&session_) || !session_.IsValid()) {
+      session_ = dbus::ObjectPath();
+    }
+  }
+  Session(const Session&) = delete;
+  Session& operator=(const Session&) = delete;
+  ~Session() {
+    if (!bus_) {
+      return;
+    }
+    if (session_.IsValid()) {
+      dbus::MethodCall close(kSessionInterface, "Close");
+      Call(bus_->GetObjectProxy(kService, session_), &close);
+    }
+    bus_->ShutdownAndBlock();
+  }
+
+  bool ok() const { return bus_ && session_.IsValid(); }
+
+  // A new item in the default collection holding `secret`; false when the
+  // collection is locked (a prompt would be needed: none is shown) or missing.
+  bool Create(const std::string& id_hex, base::span<const uint8_t> secret) {
+    dbus::MethodCall create(kCollectionInterface, "CreateItem");
+    dbus::MessageWriter writer(&create);
+    dbus::MessageWriter properties(nullptr);
+    writer.OpenArray("{sv}", &properties);
+    {
+      dbus::MessageWriter entry(nullptr);
+      properties.OpenDictEntry(&entry);
+      entry.AppendString("org.freedesktop.Secret.Item.Label");
+      entry.AppendVariantOfString("Thoron portable copy: this PC");
+      properties.CloseContainer(&entry);
+    }
+    {
+      dbus::MessageWriter entry(nullptr);
+      properties.OpenDictEntry(&entry);
+      entry.AppendString("org.freedesktop.Secret.Item.Attributes");
+      dbus::MessageWriter variant(nullptr);
+      entry.OpenVariant("a{ss}", &variant);
+      AppendAttributes(&variant, id_hex);
+      entry.CloseContainer(&variant);
+      properties.CloseContainer(&entry);
+    }
+    writer.CloseContainer(&properties);
+    AppendSecret(&writer, secret);
+    writer.AppendBool(false);  // never replace another item
+    std::unique_ptr<dbus::Response> made =
+        Call(bus_->GetObjectProxy(kService, dbus::ObjectPath(kDefaultCollection)), &create);
+    if (!made) {
+      return false;
+    }
+    dbus::MessageReader reader(made.get());
+    dbus::ObjectPath item;
+    dbus::ObjectPath prompt;
+    return reader.PopObjectPath(&item) && reader.PopObjectPath(&prompt) && item.IsValid() &&
+           item.value() != "/";
+  }
+
+  // The secret of the unlocked item with `id_hex`, or nothing.
+  std::optional<SecretBytes> Find(const std::string& id_hex) {
+    dbus::MethodCall search(kServiceInterface, "SearchItems");
+    dbus::MessageWriter writer(&search);
+    AppendAttributes(&writer, id_hex);
+    std::unique_ptr<dbus::Response> found = Call(service(), &search);
+    if (!found) {
+      return std::nullopt;
+    }
+    dbus::MessageReader reader(found.get());
+    std::vector<dbus::ObjectPath> unlocked;
+    if (!reader.PopArrayOfObjectPaths(&unlocked) || unlocked.empty()) {
+      return std::nullopt;
+    }
+    dbus::MethodCall get(kItemInterface, "GetSecret");
+    dbus::MessageWriter get_writer(&get);
+    get_writer.AppendObjectPath(session_);
+    std::unique_ptr<dbus::Response> secret = Call(bus_->GetObjectProxy(kService, unlocked.front()), &get);
+    if (!secret) {
+      return std::nullopt;
+    }
+    // (o session, ay parameters, ay value, s content type)
+    dbus::MessageReader secret_reader(secret.get());
+    dbus::MessageReader fields(nullptr);
+    dbus::ObjectPath secret_session;
+    base::span<const uint8_t> parameters;
+    base::span<const uint8_t> value;
+    if (!secret_reader.PopStruct(&fields) || !fields.PopObjectPath(&secret_session) ||
+        !fields.PopArrayOfBytes(&parameters) || !fields.PopArrayOfBytes(&value) ||
+        value.size() != kItemKeySize) {
+      return std::nullopt;
+    }
+    return SecretBytes(value);
+  }
+
+  // Every unlocked item with `id_hex` deleted; true when none is left. A locked
+  // one would need a prompt, which is never shown: it stays, and false.
+  bool Remove(const std::string& id_hex) {
+    dbus::MethodCall search(kServiceInterface, "SearchItems");
+    dbus::MessageWriter writer(&search);
+    AppendAttributes(&writer, id_hex);
+    std::unique_ptr<dbus::Response> found = Call(service(), &search);
+    if (!found) {
+      return false;
+    }
+    dbus::MessageReader reader(found.get());
+    std::vector<dbus::ObjectPath> unlocked;
+    std::vector<dbus::ObjectPath> locked;
+    if (!reader.PopArrayOfObjectPaths(&unlocked) || !reader.PopArrayOfObjectPaths(&locked)) {
+      return false;
+    }
+    bool all = locked.empty();
+    for (const dbus::ObjectPath& item : unlocked) {
+      dbus::MethodCall remove(kItemInterface, "Delete");
+      std::unique_ptr<dbus::Response> removed = Call(bus_->GetObjectProxy(kService, item), &remove);
+      dbus::ObjectPath prompt;
+      if (!removed || !dbus::MessageReader(removed.get()).PopObjectPath(&prompt) || prompt.value() != "/") {
+        all = false;  // a prompt is asked for: it is not shown
+      }
+    }
+    return all;
+  }
+
+ private:
+  dbus::ObjectProxy* service() { return bus_->GetObjectProxy(kService, dbus::ObjectPath(kServicePath)); }
+
+  void AppendSecret(dbus::MessageWriter* writer, base::span<const uint8_t> secret) {
+    dbus::MessageWriter fields(nullptr);
+    writer->OpenStruct(&fields);
+    fields.AppendObjectPath(session_);
+    fields.AppendArrayOfBytes(base::span<const uint8_t>());
+    fields.AppendArrayOfBytes(secret);
+    fields.AppendString("application/octet-stream");
+    writer->CloseContainer(&fields);
+  }
+
+  scoped_refptr<dbus::Bus> bus_;
+  dbus::ObjectPath session_;
+};
+
+class SecretServiceKeyStore : public OsKeyStore {
+ public:
+  // Only whether a session bus is there: a quick look, as the page asks it on
+  // its thread; Protect() says whether the keyring took the key.
+  bool IsAvailable() const override { return getenv("DBUS_SESSION_BUS_ADDRESS") != nullptr; }
+
+  std::optional<std::vector<uint8_t>> Protect(base::span<const uint8_t> secret) override {
+    Session session;
+    if (!session.ok()) {
+      return std::nullopt;
+    }
+    std::array<uint8_t, kSecretServiceIdSize> id;
+    crypto::RandBytes(id);
+    SecretBytes item_key(kItemKeySize);
+    crypto::RandBytes(item_key.span());
+    if (!session.Create(base::HexEncode(id), item_key.span())) {
+      return std::nullopt;
+    }
+    return SealForThisPc(item_key.span().first<kItemKeySize>(), id, secret);
+  }
+
+  std::optional<SecretBytes> Unprotect(base::span<const uint8_t> blob) override {
+    const std::optional<std::array<uint8_t, kSecretServiceIdSize>> id = IdOfBlob(blob);
+    if (!id) {
+      return std::nullopt;
+    }
+    Session session;
+    if (!session.ok()) {
+      return std::nullopt;
+    }
+    std::optional<SecretBytes> item_key = session.Find(base::HexEncode(*id));
+    if (!item_key) {
+      return std::nullopt;
+    }
+    return OpenForThisPc(item_key->span(), blob);
+  }
+
+  bool Forget(base::span<const uint8_t> blob) override {
+    const std::optional<std::array<uint8_t, kSecretServiceIdSize>> id = IdOfBlob(blob);
+    if (!id) {
+      return true;  // not one of this store's: nothing of it is in the keyring
+    }
+    Session session;
+    return session.ok() && session.Remove(base::HexEncode(*id));
+  }
+};
+
+}  // namespace
+
+std::vector<uint8_t> SealForThisPc(base::span<const uint8_t, 32> item_key,
+                                   base::span<const uint8_t, kSecretServiceIdSize> id,
+                                   base::span<const uint8_t> secret) {
+  std::array<uint8_t, kNonceSize> nonce;
+  crypto::RandBytes(nonce);
+  const std::vector<uint8_t> sealed =
+      crypto::aead::Seal(crypto::aead::AES_256_GCM, item_key, secret, nonce, AssociatedData(id));
+  std::vector<uint8_t> out = AssociatedData(id);
+  out.insert(out.end(), nonce.begin(), nonce.end());
+  out.insert(out.end(), sealed.begin(), sealed.end());
+  return out;
+}
+
+std::optional<std::array<uint8_t, kSecretServiceIdSize>> IdOfBlob(base::span<const uint8_t> blob) {
+  if (blob.size() < kTagSize + kSecretServiceIdSize + kNonceSize + 16 ||
+      base::as_string_view(blob.first(kTagSize)) != kSecretServiceBlobTag) {
+    return std::nullopt;
+  }
+  std::array<uint8_t, kSecretServiceIdSize> id;
+  std::ranges::copy(blob.subspan(kTagSize, kSecretServiceIdSize), id.begin());
+  return id;
+}
+
+std::optional<SecretBytes> OpenForThisPc(base::span<const uint8_t> item_key,
+                                         base::span<const uint8_t> blob) {
+  const std::optional<std::array<uint8_t, kSecretServiceIdSize>> id = IdOfBlob(blob);
+  if (!id || item_key.size() != kItemKeySize) {
+    return std::nullopt;
+  }
+  const size_t head = kTagSize + kSecretServiceIdSize;
+  std::optional<std::vector<uint8_t>> plain = crypto::aead::Open(
+      crypto::aead::AES_256_GCM, item_key, blob.subspan(head + kNonceSize), blob.subspan(head, kNonceSize),
+      AssociatedData(*id));
+  if (!plain) {
+    return std::nullopt;
+  }
+  SecretBytes secret(*plain);
+  Wipe(*plain);
+  return secret;
+}
+
+std::unique_ptr<OsKeyStore> CreateSecretServiceKeyStore() {
+  return std::make_unique<SecretServiceKeyStore>();
+}
+
+}  // namespace thoron_portable_key
