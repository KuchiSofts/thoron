+
+// The menu of Thoron's mail notifier, opened from its envelope in the toolbar.
+inline constexpr char kThoronMailMenuHost[] = "mail-notifier.top-chrome";
+inline constexpr char kThoronMailMenuUrl[] = "chrome://mail-notifier.top-chrome/";
+
+// One per profile (P5.75): its mail service (thoron_mail::MailService), the
+// notices of new mail, and opening Gmail where it is already open.
+class ThoronMailCenter : public base::SupportsUserData::Data,
+                         public thoron_mail::MailService::Observer {
+ public:
+  // Made the first time it is asked for, and started.
+  static ThoronMailCenter& For(Profile* profile);
+
+  explicit ThoronMailCenter(Profile* profile);
+  ThoronMailCenter(const ThoronMailCenter&) = delete;
+  ThoronMailCenter& operator=(const ThoronMailCenter&) = delete;
+  ~ThoronMailCenter() override;
+
+  thoron_mail::MailService& service() { return *service_; }
+  // How often new mail made a sound and a notice since the browser started
+  // (for the offline checks, which cannot hear or see them).
+  int sounds_played() const { return sounds_played_; }
+  int notices_shown() const { return notices_shown_; }
+
+  // Opens `url` (Gmail's own, else nothing) in a window of the profile: in
+  // the tab that shows account `index` when there is one, else a new tab.
+  void OpenGmail(const GURL& url, int index);
+  // Opens Google's page to sign in, or to add an account, in a new tab.
+  void OpenSignIn(bool add);
+
+  // P5.77: the mailboxes a person adds with their address and password.
+  // The password is kept in the profile encrypted by the system (as the
+  // browser keeps its own passwords), and is never given back to a page.
+  //
+  // Adds `account` after signing in to it once: `told` gets "" when it was
+  // added, else why not ("sign-in", "offline", "protocol", "too-much", "bad":
+  // not a mailbox's details, "exists", "full", "busy", "locked": the
+  // system's encryption is not there).
+  using Told = base::OnceCallback<void(std::string)>;
+  void AddImapAccount(thoron_mail::ImapAccount account, Told told);
+  void RemoveImapAccount(const std::string& email);
+  // P5.81: changes the mailbox kept as `before` to `account`. An empty
+  // password keeps the one it has. When what it signs in with changes (the
+  // address, the sign-in name, the server, the port or the password), it is
+  // signed in to once first and kept only when that works, as when it is
+  // added; `told` as for AddImapAccount, or "missing": no such mailbox.
+  void EditImapAccount(const std::string& before,
+                       thoron_mail::ImapAccount account,
+                       Told told);
+  // True once passwords can be kept (the system's encryption is there).
+  bool can_keep_passwords() const { return !!encryptor_; }
+
+  // P5.80: the Google accounts a person wants counted, as X-notifier keeps
+  // them: the address, the name the person gave it, and its password. They
+  // are kept in the profile (the password encrypted by the system), are
+  // part of the backup, and are shown with whether each is counted.
+  struct GoogleAccount {
+    std::string email;
+    std::string alias;
+    std::string password;
+    // the password as it is kept, for one that cannot be read just now
+    std::string secret;
+  };
+  struct GoogleImported {
+    // "" or "locked": the system's encryption is not there
+    std::string error;
+    int google = 0;
+    int mailboxes = 0;
+  };
+  // Takes the accounts of a list (X-notifier's file) into the list, where one
+  // that is there already takes the new name and password. One whose password
+  // is an app password is a mailbox as well (its mail is read with it).
+  GoogleImported ImportGoogleAccounts(std::vector<GoogleAccount> accounts);
+  std::vector<GoogleAccount> KeptGoogleAccounts() const;
+  void RemoveGoogleAccount(const std::string& email);
+  // P5.81: changes the account of the list kept as `before`: its address,
+  // name and password (an empty one keeps the password it has). Its mailbox
+  // (one an app password reads) follows: a new address, a new app password,
+  // or a mailbox made when the new password is an app password. "" when it
+  // was changed, else "bad", "exists", "missing" or "locked".
+  std::string EditGoogleAccount(const std::string& before,
+                                GoogleAccount account);
+  // Opens Google's page to sign in to an account of the list, the address
+  // filled in.
+  void SignInGoogle(const std::string& email);
+  // Puts the kept password of an account of the list on the clipboard, for
+  // the person to paste on Google's page. It is not given to any page.
+  bool CopyGooglePassword(const std::string& email);
+
+  // Opens the account of `index`: Gmail's inbox of a Google account, the mail
+  // page of a mailbox (when it has one). Its new mail is counted from now.
+  void OpenAccount(int index);
+  // Opens the M-Notifier's own page in a tab: accounts, settings, backup;
+  // with `add`, its form for a mailbox by address and password.
+  void OpenManagePage(bool add);
+
+  // A backup of the mailboxes and the settings as a file's text (JSON). With
+  // a `passphrase` it is sealed with it and holds the passwords; without one
+  // it holds them only `with_passwords`.
+  using Exported = base::OnceCallback<void(std::string)>;
+  void ExportBackup(bool with_passwords, std::string passphrase, Exported done);
+  // Reads a backup: `done` gets "" and how many mailboxes it holds now, else
+  // why not ("passphrase": it is sealed and none was given; "wrong": it does
+  // not open; "bad": not a backup; "locked").
+  using Imported = base::OnceCallback<void(std::string, int)>;
+  void ImportBackup(std::string file, std::string passphrase, Imported done);
+
+  // P5.77: the backup written by itself. When it is on, the M-Notifier looks
+  // every few minutes whether what a backup holds changed since the last one
+  // (or that one is gone from the folder), and then writes a new one into
+  // the folder the person chose: sealed with the passphrase kept for it (it
+  // then holds the passwords), or, without one, a file without the passwords.
+  // Only the newest `keep` of its own files stay in that folder; no other
+  // file there is touched.
+  struct AutoBackup {
+    bool on = false;
+    base::FilePath folder;
+    int keep = 5;
+    // a passphrase is kept for it (encrypted by the system)
+    bool sealed = false;
+    // the last one written, and its file's name
+    base::Time last;
+    std::string name;
+    // why the last one could not be written: "" or "folder" (not there),
+    // "write", "verify" or "locked" (the passphrase cannot be read here)
+    std::string error;
+    bool writing = false;
+  };
+  AutoBackup auto_backup() const;
+  void SetAutoBackup(bool on, int keep);
+  void SetAutoBackupFolder(const base::FilePath& folder);
+  // "" when kept, else "locked" or "short" (fewer than 8 characters); an empty
+  // passphrase leaves the passwords out of the next ones.
+  std::string SetAutoBackupPassphrase(const std::string& passphrase);
+  // Writes one now (even when nothing changed): `done` gets "" or why not
+  // ("off", "busy", "wait": the system's encryption is not there yet, or an
+  // error as in AutoBackup).
+  void SaveAutoBackupNow(Told done);
+
+  // P5.82: the sound of new mail. `name` is "system" (Windows' own sound for
+  // new mail) or one Thoron makes (mail_sounds.h), at `volume` (0 to 100);
+  // an account may have its own, or "off". It stays quiet, for every account,
+  // in the person's quiet hours, while a full-screen program, a game or a
+  // presentation runs (as Windows says), and for an account whose mail is
+  // the tab in front of the person.
+  struct SoundSettings {
+    std::string name;
+    int volume = 70;
+    bool quiet_fullscreen = true;
+    bool quiet_in_front = true;
+    // minutes of the day; -1: no quiet hours
+    int quiet_from = -1;
