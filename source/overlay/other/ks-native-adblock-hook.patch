+void ThoronMailCenter::PlayNewMailSound() {
+  // The offline checks (a local server stands in for Gmail) count the sound
+  // and do not make it.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "thoron-mail-feeds-for-testing")) {
+    return;
+  }
+#if BUILDFLAG(IS_WIN)
+  // Windows' own sound for new mail (the person's sound scheme), else its
+  // plain notice sound. Not waited for.
+  if (!::PlaySoundW(L"MailBeep", nullptr,
+                    SND_ALIAS | SND_ASYNC | SND_NODEFAULT)) {
+    ::MessageBeep(MB_ICONASTERISK);
+  }
+#endif
+}
