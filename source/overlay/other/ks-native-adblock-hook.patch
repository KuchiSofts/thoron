+
+#ifndef CHROME_BROWSER_THORON_PORTABLE_UNLOCK_DIALOG_WIN_H_
+#define CHROME_BROWSER_THORON_PORTABLE_UNLOCK_DIALOG_WIN_H_
+
+#include <string>
+
+#include "base/functional/callback.h"
+
+namespace thoron_portable {
+
+// What the person typed in the unlock window, and their choices.
+struct UnlockAttempt {
+  UnlockAttempt();
+  UnlockAttempt(const UnlockAttempt&) = delete;
+  UnlockAttempt& operator=(const UnlockAttempt&) = delete;
+  ~UnlockAttempt();  // wipes `secret`
+
+  std::u16string secret;  // the passphrase, or the recovery key
+  bool recovery = false;
+  bool remember = false;
+};
+
+// Tries an attempt: "" when it opened the copy, else what to tell the person.
+// It may wipe the secret.
+using TryUnlock = base::RepeatingCallback<std::u16string(UnlockAttempt&)>;
+
+// The window that unlocks a portable copy locked with a passphrase (ROADMAP
+// P4.9, threat model E8): Thoron's own, shown before the browser's message
+// loop and before any profile or tab exists, so no page can see or imitate
+// it. It is a plain Windows dialog made in memory. It stays until an attempt
+// opens the copy (true) or the person chooses Quit or closes it (false).
+// `can_remember`: the system has a store for "Remember this PC".
+bool RunUnlockDialog(bool can_remember, const TryUnlock& try_unlock);
+
+// A plain message from Thoron before its windows exist (an error icon).
+void ShowStartupProblem(const std::u16string& text);
+
+// A locked copy whose key file is missing: true when the person chooses to
+// start without its saved passwords and sign-ins; quitting is the default.
+bool AskToStartWithoutKeyFile();
+
+}  // namespace thoron_portable
+
+#endif  // CHROME_BROWSER_THORON_PORTABLE_UNLOCK_DIALOG_WIN_H_
