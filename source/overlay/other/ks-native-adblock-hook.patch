+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_USER_DATA_IMPORTER_CHROMIUM_FAMILY_PASSWORD_DECRYPTOR_LINUX_H_
+#define COMPONENTS_USER_DATA_IMPORTER_CHROMIUM_FAMILY_PASSWORD_DECRYPTOR_LINUX_H_
+
+#include <stdint.h>
+
+#include <array>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/containers/span.h"
+
+namespace base {
+class FilePath;
+}  // namespace base
+
+// Thoron (ROADMAP P3.14): the passwords and cookies of a Chromium-family
+// browser on Linux, as Chromium encrypts them there
+// (components/os_crypt/async): "v10" values with a fixed key (a browser without
+// a desktop keyring, or started with --password-store=basic), "v11" values with
+// a key made from a secret the browser keeps in the desktop's keyring (the
+// Secret Service of GNOME and others, or KDE's KWallet). Both are AES-128-CBC
+// with an IV of 16 spaces. The keyring is only read: an entry is looked up,
+// never made or changed, a locked keyring is not unlocked and a closed wallet
+// is not opened (no prompt is shown).
+
+namespace user_data_importer::chromium_family {
+
+enum class DecryptResult {
+  kOk,            // Decrypted into `plaintext`.
+  kSkippedV20,    // Not used on Linux (Windows' app-bound values).
+  kSkippedOther,  // Unrecognised, malformed, or "v11" without the keyring's key.
+  kError,         // A known format that failed to decrypt (wrong padding).
+};
+
+class PasswordKey {
+ public:
+  PasswordKey();
+  PasswordKey(const PasswordKey&) = delete;
+  PasswordKey& operator=(const PasswordKey&) = delete;
+  PasswordKey(PasswordKey&&) noexcept;
+  PasswordKey& operator=(PasswordKey&&) noexcept;
+  ~PasswordKey();
+
+  // The keys of the browser whose user data folder is `user_data`: the fixed
+  // "v10" key always, and the "v11" key when the keyring holds an unlocked
+  // secret under one of the application names that browser uses.
+  static PasswordKey ForUserData(const base::FilePath& user_data);
+
+  // A key from the keyring secret `secret` (or none), for tests.
+  static PasswordKey FromSecretForTesting(std::optional<std::string> secret);
+
+  // The application names a browser's secret is kept under, by its user data
+  // folder's name: Chromium's own "chrome" or "chromium", or the browser's.
+  static std::vector<std::string> ApplicationNamesFor(
+      const base::FilePath& user_data);
+
+  // KDE's KWallet keeps the secret in a folder of the wallet instead: the
+  // folder and entry Chromium uses for each of `applications` it knows
+  // ("Chromium Keys" and "Chromium Safe Storage", "Chrome Keys" and "Chrome
+  // Safe Storage" in Google's builds; freedesktop_secret_key_provider.h).
+  static std::vector<std::pair<std::string, std::string>> KWalletEntriesFor(
+      const std::vector<std::string>& applications);
+
+  // PBKDF2-HMAC-SHA1 of `password` with Chromium's salt "saltysalt", one
+  // iteration, 16 bytes: how Chromium makes the key of both prefixes.
+  static std::array<uint8_t, 16> DeriveKey(std::string_view password);
+
+  bool has_keyring_key() const { return has_v11_; }
+  base::span<const uint8_t, 16> fixed_key() const { return v10_; }
+  base::span<const uint8_t, 16> keyring_key() const { return v11_; }
+
+  // Zeroes the keys.
+  void Clear();
+
+ private:
+  std::array<uint8_t, 16> v10_ = {};
+  std::array<uint8_t, 16> v11_ = {};
+  bool has_v11_ = false;
+};
+
+// Reads one `password_value` (or cookie `encrypted_value`) blob.
+DecryptResult DecryptPasswordValue(const PasswordKey& key,
+                                   base::span<const uint8_t> value,
+                                   std::string* plaintext);
+
+}  // namespace user_data_importer::chromium_family
+
+#endif  // COMPONENTS_USER_DATA_IMPORTER_CHROMIUM_FAMILY_PASSWORD_DECRYPTOR_LINUX_H_
