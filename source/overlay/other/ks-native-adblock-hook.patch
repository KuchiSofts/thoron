+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_UPDATE_SWAP_H_
+#define COMPONENTS_THORON_UPDATE_SWAP_H_
+
+#include <stdint.h>
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "components/thoron_update/manifest.h"
+
+namespace base {
+class FilePath;
+}  // namespace base
+
+// Putting a new version in place without ever leaving a copy that cannot start
+// (ROADMAP P3.5), and going back to the one before it (P3.8, the program's half).
+//
+// The program folder ("root") holds one folder for each version it keeps, named
+// by the version (root/158.0.8127.3010/...), and one small file, `current`: its
+// first line names the version that is started, its second line the one before
+// it. A launcher reads the first line and starts that version. The file is only
+// ever replaced whole, in one step (written beside, then renamed over it), and
+// only ever names folders that are complete and verified, so a kill at any
+// moment leaves a version that starts, the old one until the switch and the new
+// one after it, and never a kept version that the file does not name.
+
+namespace thoron_update {
+
+// One file of a version: its path inside the version's folder ('/' between the
+// parts), its length and its SHA-256 (64 characters of 0-9a-f).
+struct VersionFile {
+  std::string path;
+  int64_t size = 0;
+  std::string sha256;
+};
+
+enum class SwapResult {
+  kDone,
+  // The staged folder is not exactly `files`: a file missing, different, or
+  // one more. Nothing was switched; the staged folder is removed.
+  kBadFiles,
+  // `files` names a path outside the version's folder, or `version` is zero.
+  kBadRequest,
+  // The version is already the current one.
+  kAlreadyCurrent,
+  // A rename or a write failed. What was current is still current.
+  kIoError,
+  // There is no version to go back to.
+  kNothingToRollBack,
+  // Stopped on purpose after a step (tests: a kill at that moment).
+  kInterrupted,
+};
+
+std::string_view SwapResultName(SwapResult result);
+
+// The steps of InstallVersion, in order. A test stops after one of them to see
+// what a kill there leaves.
+enum class SwapStep {
+  kVerified,         // every staged file checked
+  kMoved,            // the staged folder renamed to the version's name
+  kSwitched,         // `current` names the new version, then what was current
+  kCleaned,          // versions other than these two removed
+};
+
+// The version the first line of `root`/current names, when its folder is there.
+std::optional<BuildVersion> CurrentVersion(const base::FilePath& root);
+// The version its second line names, when its folder is there.
+std::optional<BuildVersion> PreviousVersion(const base::FilePath& root);
+// The folder of `version` in `root`.
+base::FilePath VersionFolder(const base::FilePath& root,
+                             const BuildVersion& version);
+
+// Whether the folder of `version` holds exactly `files`.
+bool VersionIsComplete(const base::FilePath& root,
+                       const BuildVersion& version,
+                       const std::vector<VersionFile>& files);
+
+// Puts `version` in place from `staged`, a folder in `root` the package was
+// unpacked into: it must hold exactly `files`. Then `current` names `version`
+// and, as the one before it, what was current; every version folder but these two,
+// and every folder a killed update left, is removed: N-1 is kept.
+//
+// Run again after a kill, it goes on where it stopped: a version folder that is
+// already there (it was renamed only after it verified) is used as it is.
+SwapResult InstallVersion(const base::FilePath& root,
+                          const base::FilePath& staged,
+                          const BuildVersion& version,
+                          const std::vector<VersionFile>& files,
+                          std::optional<SwapStep> stop_after = std::nullopt);
+
+// Makes the previous version the current one again, and the current one the
+// previous. Nothing is deleted, so it can be undone the same way.
+SwapResult RollBack(const base::FilePath& root);
+
+// For a browser that runs from a version's folder of a program folder
+// (root/<version>/thoron.exe, as a portable copy does): the same program of the
+// version `current` names, when that is another version and its program is
+// there. A relaunch after an update starts it (ROADMAP P3.20).
+bool BrowserOfCurrentVersion(const base::FilePath& running_exe, base::FilePath* browser);
+
+// Removes what is neither the current nor the previous version: folders a
+// killed update or rollback left. Run by InstallVersion; a launcher may run it
+// at start.
+void CleanUp(const base::FilePath& root);
+
+}  // namespace thoron_update
+
+#endif  // COMPONENTS_THORON_UPDATE_SWAP_H_
