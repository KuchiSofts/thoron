+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_THORON_PORTABLE_KEY_LOCAL_STATE_KEY_H_
+#define COMPONENTS_THORON_PORTABLE_KEY_LOCAL_STATE_KEY_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/files/file_path.h"
+#include "base/time/time.h"
+#include "components/thoron_portable_key/secret_bytes.h"
+
+namespace thoron_portable_key {
+
+// The key a copy that is not locked keeps in Local State, as Chromium writes it
+// on Windows (os_crypt.encrypted_key): base64 of "DPAPI" and a DPAPI blob of
+// the 32-byte profile key for this Windows account. Locking a copy takes the
+// key from there (it stays the same key, so nothing is encrypted again);
+// removing the lock puts it back.
+inline constexpr char kLocalStateKeyPref[] = "os_crypt.encrypted_key";
+
+// The profile key of `encrypted_key`, or nullopt (another account or PC, or
+// not that format). Windows only; nullopt elsewhere.
+std::optional<SecretBytes> UnprotectLocalStateKey(
+    std::string_view encrypted_key);
+// `key` as Local State keeps it, or nullopt.
+std::optional<std::string> ProtectLocalStateKey(const SecretBytes& key);
+
+// How long one Argon2id at the floor takes on this PC, for Calibrate().
+base::TimeDelta MeasureFloor();
+
+// True when the User Data folder `folder` has a key file, or what a write
+// of one left behind.
+bool HasKeyFile(const base::FilePath& folder);
+// Removes the key file and what a write of one left behind; true when none is
+// left.
+bool RemoveKeyFile(const base::FilePath& folder);
+
+}  // namespace thoron_portable_key
+
+#endif  // COMPONENTS_THORON_PORTABLE_KEY_LOCAL_STATE_KEY_H_
