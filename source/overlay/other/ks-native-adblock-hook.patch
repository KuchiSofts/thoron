+  // uBlock Origin's cloud storage: the backup (settings_page.js makeBackup),
+  // kept in a synced preference of the profile, so the browser's own sync
+  // carries it to the person's other computers when it is on for settings.
+  // [id, text] -> "" or what went wrong.
+  void SendToCloud(const base::ListValue& args) {
+    const std::string* id = AnswerId(args, 1);
+    if (!id || !args[1].is_string()) {
+      return;
+    }
+    const std::string& text = args[1].GetString();
+    if (text.size() > kMaxCloudBytes) {
+      Answer(*id, "This is too large for cloud storage (more than 100 kB): back up to a file instead.");
+      return;
+    }
+    if (!base::IsStringUTF8(text)) {
+      return;
+    }
+    Profile::FromWebUI(web_ui())->GetPrefs()->SetString(kCloudPref, text);
+    Answer(*id, std::string());
+  }
