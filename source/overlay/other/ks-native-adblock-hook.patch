@@ -0,0 +1,78 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The About page's updater on Windows builds without Google's branding
+// (ROADMAP P3.9, P3.20): the states of Thoron's own update client
+// (chrome/browser/thoron_update), as the page shows them.
+
+#include <memory>
+#include <string>
+
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/thoron_update/thoron_update_win.h"
+#include "chrome/browser/ui/webui/help/version_updater.h"
+
+namespace {
+
+using State = thoron_update::UpdateClient::State;
+
+class VersionUpdaterThoron : public VersionUpdater {
+ public:
+  VersionUpdaterThoron() = default;
+  VersionUpdaterThoron(const VersionUpdaterThoron&) = delete;
+  VersionUpdaterThoron& operator=(const VersionUpdaterThoron&) = delete;
+  ~VersionUpdaterThoron() override = default;
+
+  // VersionUpdater:
+  void CheckForUpdate(StatusCallback callback, PromoteCallback) override {
+    callback_ = std::move(callback);
+    // Opening the page is asking: it installs what it finds, in every mode.
+    thoron_update_win::Client()->Check(
+        /*install=*/true,
+        base::BindRepeating(&VersionUpdaterThoron::OnStatus, weak_factory_.GetWeakPtr()));
+  }
+
+ private:
+  void OnStatus(const thoron_update::UpdateClient::Status& status) {
+    using Kind = thoron_update::UpdateClient::PageKind;
+    const thoron_update::UpdateClient::Page page =
+        thoron_update::UpdateClient::ForAboutPage(status);
+    Status shown = FAILED;
+    switch (page.kind) {
+      case Kind::kChecking:
+        shown = CHECKING;
+        break;
+      case Kind::kUpdating:
+        shown = UPDATING;
+        break;
+      case Kind::kRelaunch:
+        shown = NEARLY_UPDATED;
+        break;
+      case Kind::kUpToDate:
+        shown = UPDATED;
+        break;
+      case Kind::kFailed:
+        shown = FAILED;
+        break;
+      case Kind::kFailedDownload:
+        shown = FAILED_DOWNLOAD;
+        break;
+      case Kind::kDisabled:
+        shown = DISABLED;
+        break;
+    }
+    callback_.Run(shown, page.progress, false, false, status.version, 0,
+                  base::UTF8ToUTF16(page.message));
+  }
+
+  StatusCallback callback_;
+  base::WeakPtrFactory<VersionUpdaterThoron> weak_factory_{this};
+};
+
+}  // namespace
+
+std::unique_ptr<VersionUpdater> VersionUpdater::Create(content::WebContents* web_contents) {
+  return std::make_unique<VersionUpdaterThoron>();
+}
