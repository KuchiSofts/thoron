+  params.disposition = WindowOpenDisposition::kNewForegroundTab;
+  params.window_action = NavigateParams::WindowAction::kShowWindow;
+  Navigate(&params);
+}
+
+void ThoronMailCenter::OnNewMail(
+    const thoron_mail::MailAccount& account,
+    const std::vector<thoron_mail::MailMessage>& messages) {
+  if (messages.empty()) {
+    return;
+  }
+  // The sound is the M-Notifier's own, so it comes with or without a notice
+  // (P5.78); a notice is then silent, or there would be two. P5.82: the
+  // account's own sound or the one for all, unless it is to stay quiet now.
+  const std::string quiet = QuietReason(account);
+  if (service_->Choice("sound") == "on") {
+    if (quiet.empty()) {
+      const std::string own = AccountSound(account.email);
+      const SoundSettings settings = sound_settings();
+      PlayMailSound(own.empty() ? settings.name : own, settings.volume);
+      ++sounds_played_;
+    } else {
+      last_quiet_ = quiet;
+      ++sounds_held_;
+    }
+  }
+  NotificationDisplayService* display =
+      NotificationDisplayServiceFactory::GetForProfile(profile_);
+  // quiet hours hold the notices too: the person asked not to be disturbed
+  if (!service_->notify() || !display || quiet == "hours") {
+    return;
+  }
+  auto notice = [&](const std::string& id, const std::u16string& title,
+                    const std::u16string& text, const GURL& open) {
+    // Unretained: a notice that outlives the profile is never clicked.
+    auto delegate =
+        base::MakeRefCounted<message_center::HandleNotificationClickDelegate>(
+            base::BindRepeating(
+                [](ThoronMailCenter* center, GURL url, int index,
+                   std::optional<int> button) {
+                  center->OpenGmail(url, index);
+                },
+                base::Unretained(this), open, account.index));
+    // silent: the sound is the M-Notifier's own (above)
+    message_center::RichNotificationData data;
+    data.silent = true;
+    ++notices_shown_;
+    message_center::Notification notification(
+        message_center::NOTIFICATION_TYPE_SIMPLE, id, title, text,
+        ui::ImageModel(), base::UTF8ToUTF16(account.email),
+        GURL("https://mail.google.com/"),
+#if BUILDFLAG(IS_CHROMEOS)
+        message_center::NotifierId(
+            message_center::NotifierType::SYSTEM_COMPONENT, kNotifierId,
+            ash::NotificationCatalogName::kNone),
+#else
+        message_center::NotifierId(
+            message_center::NotifierType::SYSTEM_COMPONENT, kNotifierId),
+#endif
+        data, delegate);
+    display->Display(NotificationHandler::Type::TRANSIENT, notification,
+                     /*metadata=*/nullptr);
+  };
+  if (messages.size() > kMostNotices) {
+    notice("thoron.mail." + account.email,
+           base::NumberToString16(messages.size()) + u" new messages",
+           base::UTF8ToUTF16(account.email),
+           thoron_mail::MailService::InboxUrl(account.index));
+    return;
+  }
+  for (const thoron_mail::MailMessage& message : messages) {
+    const std::string link = thoron_mail::GmailLink(message.link);
+    notice("thoron.mail." + account.email + "." + message.id,
+           base::UTF8ToUTF16(message.from_name.empty() ? message.from_email
+                                                       : message.from_name),
+           base::UTF8ToUTF16(message.subject),
+           link.empty() ? thoron_mail::MailService::InboxUrl(account.index)
+                        : GURL(link));
+  }
+}
+
+std::optional<std::string> ThoronMailCenter::Encrypted(
+    const std::string& text) const {
+  std::string encrypted;
+  if (!encryptor_ || !encryptor_->EncryptString(text, &encrypted)) {
+    return std::nullopt;
+  }
+  return base::Base64Encode(encrypted);
+}
+
+std::optional<std::string> ThoronMailCenter::Decrypted(
+    const std::string& kept) const {
+  std::string encrypted;
+  std::string text;
+  if (!encryptor_ || !base::Base64Decode(kept, &encrypted) ||
+      !encryptor_->DecryptString(encrypted, &text)) {
+    return std::nullopt;
+  }
+  return text;
+}
+
+ThoronMailCenter::AutoBackup ThoronMailCenter::auto_backup() const {
+  const base::DictValue& kept = profile_->GetPrefs()->GetDict(kAutoBackupPref);
+  AutoBackup backup;
+  backup.on = kept.FindBool("on").value_or(false);
+  if (const base::Value* folder = kept.Find("folder")) {
+    backup.folder = base::ValueToFilePath(*folder).value_or(base::FilePath());
+  }
+  backup.keep =
+      std::clamp(kept.FindInt("keep").value_or(5), 1, kMostAutoBackupsKept);
+  const std::string* secret = kept.FindString("secret");
+  backup.sealed = secret && !secret->empty();
+  if (const base::Value* time = kept.Find("time")) {
+    backup.last = base::ValueToTime(*time).value_or(base::Time());
+  }
+  if (const std::string* name = kept.FindString("name")) {
+    backup.name = *name;
+  }
+  if (const std::string* error = kept.FindString("error")) {
+    backup.error = *error;
+  }
+  backup.writing = auto_backup_writing_;
+  return backup;
+}
+
+void ThoronMailCenter::SetAutoBackup(bool on, int keep) {
+  {
+    ScopedDictPrefUpdate update(profile_->GetPrefs(), kAutoBackupPref);
+    update->Set("on", on);
+    update->Set("keep", std::clamp(keep, 1, kMostAutoBackupsKept));
+  }
+  CheckAutoBackup(/*even_unchanged=*/false, base::DoNothing());
+}
+
+void ThoronMailCenter::SetAutoBackupFolder(const base::FilePath& folder) {
+  {
+    ScopedDictPrefUpdate update(profile_->GetPrefs(), kAutoBackupPref);
+    update->Set("folder", base::FilePathToValue(folder));
+    update->Remove("error");
+  }
+  CheckAutoBackup(/*even_unchanged=*/false, base::DoNothing());
+}
+
+std::string ThoronMailCenter::SetAutoBackupPassphrase(
+    const std::string& passphrase) {
+  if (!passphrase.empty() && passphrase.size() < 8) {
+    return "short";
+  }
+  if (passphrase.size() > 1024) {
+    return "bad";
+  }
+  if (!encryptor_) {
+    return "locked";
+  }
+  {
+    ScopedDictPrefUpdate update(profile_->GetPrefs(), kAutoBackupPref);
+    if (passphrase.empty()) {
+      update->Remove("secret");
+    } else {
+      std::optional<std::string> secret = Encrypted(passphrase);
+      if (!secret) {
+        return "locked";
+      }
+      update->Set("secret", std::move(*secret));
+    }
+  }
+  CheckAutoBackup(/*even_unchanged=*/false, base::DoNothing());
+  return std::string();
+}
+
+void ThoronMailCenter::SaveAutoBackupNow(Told done) {
+  CheckAutoBackup(/*even_unchanged=*/true, std::move(done));
+}
+
+void ThoronMailCenter::CheckAutoBackup(bool even_unchanged, Told done) {
+  const AutoBackup backup = auto_backup();
+  if (!backup.on || backup.folder.empty()) {
+    std::move(done).Run("off");
+    return;
+  }
+  if (auto_backup_writing_) {
+    std::move(done).Run("busy");
+    return;
+  }
+  // the passwords and the passphrase are read once the system's encryption
+  // is there (a moment after the browser starts)
+  if (!encryptor_) {
+    std::move(done).Run("wait");
+    return;
+  }
+  const base::DictValue& kept = profile_->GetPrefs()->GetDict(kAutoBackupPref);
+  std::string passphrase;
+  if (const std::string* secret = kept.FindString("secret");
+      secret && !secret->empty()) {
+    std::optional<std::string> opened = Decrypted(*secret);
+    if (!opened) {
+      OnAutoBackupWritten(std::string(), std::move(done),
+                          {std::string(), "locked"});
+      return;
+    }
+    passphrase = std::move(*opened);
+  }
+  std::string json =
+      base::WriteJsonWithOptions(BackupDict(!passphrase.empty()),
+                                 base::JSONWriter::OPTIONS_PRETTY_PRINT)
+          .value_or(std::string());
+  if (json.empty()) {
+    std::move(done).Run("write");
+    return;
+  }
+  // what this one holds, where it goes, how it is sealed and how many are
+  // kept: when none of it changed, the last one is still the backup
+  const std::string mark = crypto::SHA256HashString(
+      base::StrCat({json, "\n", passphrase, "\n", backup.folder.AsUTF8Unsafe(),
+                    "\n", base::NumberToString(backup.keep)}));
+  std::string unchanged;
+  if (const std::string* last = kept.FindString("mark");
+      !even_unchanged && last) {
+    if (Decrypted(*last) == mark) {
+      unchanged = backup.name;
+    }
+  }
+  auto_backup_writing_ = true;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&WriteAutoBackup, backup.folder, std::move(unchanged),
+                     std::move(json), std::move(passphrase), backup.keep,
+                     base::Time::Now()),
+      base::BindOnce(&ThoronMailCenter::OnAutoBackupWritten,
+                     weak_factory_.GetWeakPtr(), mark, std::move(done)));
+}
+
+void ThoronMailCenter::OnAutoBackupWritten(
+    std::string mark,
+    Told done,
+    std::pair<std::string, std::string> written) {
+  auto_backup_writing_ = false;
+  const auto& [name, error] = written;
+  const base::DictValue& kept = profile_->GetPrefs()->GetDict(kAutoBackupPref);
+  const std::string* was = kept.FindString("error");
+  // the profile is written only when something changed
+  if (!name.empty() || error != (was ? *was : std::string())) {
+    ScopedDictPrefUpdate update(profile_->GetPrefs(), kAutoBackupPref);
+    if (error.empty()) {
+      update->Remove("error");
+    } else {
+      update->Set("error", error);
+    }
+    if (!name.empty()) {
+      update->Set("name", name);
+      update->Set("time", base::TimeToValue(base::Time::Now()));
+      if (std::optional<std::string> kept_mark = Encrypted(mark)) {
+        update->Set("mark", std::move(*kept_mark));
+      } else {
+        update->Remove("mark");
+      }
+    }
+  }
+  std::move(done).Run(error);
+}
