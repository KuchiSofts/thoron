+
+#ifndef COMPONENTS_THORON_MAIL_MAIL_SOUNDS_H_
+#define COMPONENTS_THORON_MAIL_MAIL_SOUNDS_H_
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace thoron_mail {
+
+// The sounds of Thoron M-Notifier (P5.82). Each is made here, from tones, when
+// it is played: no recording, no sample of anyone's, nothing to credit. The
+// names are what the profile keeps. "system" is not one of them: it is
+// Windows' own sound for new mail, from the person's sound scheme, and is
+// played by name, never copied.
+inline constexpr char kSystemSound[] = "system";
+
+// The sounds Thoron makes, in the order they are offered.
+const std::vector<std::string>& MadeSoundNames();
+// True for "system" and for every made sound.
+bool IsKnownSound(std::string_view name);
+
+// The sound `name` as a WAV file (PCM, 16 bits, one channel, 44.1 kHz) at
+// `volume` (0 to 100), or "" for a name that is not a made sound. The loudest
+// sample is the volume's share of full scale, never above it.
+std::string MakeSoundWav(std::string_view name, int volume);
+
+}  // namespace thoron_mail
+
+#endif  // COMPONENTS_THORON_MAIL_MAIL_SOUNDS_H_
