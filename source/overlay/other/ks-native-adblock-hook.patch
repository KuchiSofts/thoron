+  }
+}
+
+$('check').addEventListener('click', () => chrome.send('checkNow'));
+$('gear').addEventListener('click', () => {
+  const open = $('settings').hidden;
+  $('settings').hidden = !open;
+  $('accounts').hidden = open;
+  $('add-panel').hidden = true;
+  $('gear').setAttribute('aria-pressed', String(open));
+});
+// "Add an account" opens the two ways to add one
+$('add').addEventListener('click', () => showAddPanel($('add-panel').hidden));
+$('add-google').addEventListener('click', () => chrome.send('addAccount'));
+// the form is on the M-Notifier's own page: a menu closes when another window is used (a password manager)
+$('add-mailbox').addEventListener('click', () => chrome.send('openManage', [true]));
+$('manage').addEventListener('click', () => chrome.send('openManage', [false]));
+$('imap-email').addEventListener('input', fillFromAddress);
+for (const id of ['imap-host', 'imap-webmail']) {
+  $(id).addEventListener('input', () => typed.add(id));
+}
+$('imap-add').addEventListener('click', addMailbox);
+$('imap-cancel').addEventListener('click', () => {
+  $('imap-password').value = '';
+  showAddPanel(false);
+});
+$('imap-password').addEventListener('keydown', (event) => {
+  if (event.key === 'Enter' && !$('imap-add').disabled) {
+    addMailbox();
+  }
+});
+$('export').addEventListener('click', saveBackup);
+$('import').addEventListener('click', () => $('import-file').click());
+$('import-file').addEventListener('change', () => {
+  readBackup($('import-file').files[0]);
+  $('import-file').value = '';
+});
+if (PAGE) {
+  document.body.classList.add('page');
+  $('settings').hidden = false;
+  $('backup').hidden = false;
+  showAddPanel(location.hash === '#manage-add');
+  addEventListener('hashchange', () => showAddPanel(location.hash === '#manage-add'));
+}
+$('notify').addEventListener('change', () => chrome.send('setNotify', [$('notify').checked]));
+$('sound').addEventListener('change', () => chrome.send('setChoice', ['sound', $('sound').checked ? 'on' : 'off']));
+$('messages').addEventListener(
+    'change', () => chrome.send('setChoice', ['messages', $('messages').checked ? 'on' : 'off']));
+$('interval').addEventListener('change', () => chrome.send('setInterval', [Number($('interval').value)]));
+for (const select of document.querySelectorAll('select[data-choice]')) {
+  select.addEventListener('change', () => chrome.send('setChoice', [select.dataset.choice, select.value]));
+}
+document.addEventListener('keydown', (event) => {
+  if (event.key === 'Escape') {
+    chrome.send('closeMenu');
+  }
+});
+addWebUiListener('mail-changed', refresh);
+addWebUiListener('menu-shown', async () => {
+  // the theme may have changed since this page was kept: its colours are read again
+  $('theme').href = `chrome://theme/colors.css?sets=ui,chrome&version=${Date.now()}`;
+  await refresh();
+  chrome.send('menuReady');
+});
+refresh().then(() => chrome.send('menuReady'));
+// the times shown ("2 minutes ago") stay right while the menu is open
+setInterval(() => {
+  if (state && !document.hidden) {
+    show(state);
+  }
+}, 30000);
+)thoron";
