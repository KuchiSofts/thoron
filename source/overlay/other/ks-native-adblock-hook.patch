+template <size_t N>
+std::string Bytes(const uint8_t (&bytes)[N]) {
+  return std::string(reinterpret_cast<const char*>(bytes), N);
+}
+
+template <size_t N>
+PublicKey Key(const uint8_t (&bytes)[N]) {
+  static_assert(N == kPublicKeyBytes);
+  PublicKey key;
+  std::copy(bytes, bytes + N, key.begin());
+  return key;
+}
+
+class ThoronUpdateClientTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(dir_.CreateUniqueTempDir());
+    UpdateClient::RegisterPrefs(prefs_.registry());
+    clock_.SetNow(base::Time::UnixEpoch() + base::Seconds(data::kNow));
+    config_.public_key = Key(data::kPublicKey);
+    config_.allowed_hosts = {"github.com"};
+    config_.manifest_url = GURL(data::kManifestUrl);
+    config_.installed = *ParseBuildVersion(data::kInstalled);
+    config_.updater = *ParseBuildVersion(data::kInstalled);
+    config_.download_dir = dir_.GetPath().AppendASCII("Update");
+    config_.install = base::BindRepeating(&ThoronUpdateClientTest::Install, base::Unretained(this));
+  }
+
+  // The release as it is published.
+  void Publish() {
+    network_.AddResponse(data::kManifestUrl, std::string(data::kManifest));
+    network_.AddResponse(std::string(data::kManifestUrl) + ".sig", Bytes(data::kSignature));
+    network_.AddResponse(UpdateClient::KeyStatementsUrl(GURL(data::kManifestUrl)).spec(), "",
+                         net::HTTP_NOT_FOUND);
+    network_.AddResponse(data::kInstallerUrl, Bytes(data::kInstaller));
+    network_.AddResponse(data::kDeltaUrl, Bytes(data::kDelta));
+  }
+
+  // The installer the client hands a package to: it reads what it was given.
+  bool Install(const base::FilePath& package, bool delta, const std::string& version) {
+    EXPECT_EQ(version, data::kNewest);
+    std::string read;
+    base::ReadFileToString(package, &read);
+    // Nothing else may write to the package while it is installed (U8).
+    const bool writable = base::File(package, base::File::FLAG_OPEN | base::File::FLAG_WRITE).IsValid();
+    base::AutoLock hold(lock_);
+    installed_.push_back(read);
+    writable_.push_back(writable);
+    deltas_.push_back(delta);
+    return install_works_ && !(fail_delta_ && delta);
+  }
+
+  // A look, to its last state; every state it went through is in `states_`.
+  UpdateClient::Status Look(UpdateClient& client, bool install) {
+    base::RunLoop loop;
+    UpdateClient::Status last;
+    states_.clear();
+    client.Check(install, base::BindLambdaForTesting([&](const UpdateClient::Status& status) {
+                   if (states_.empty() || states_.back() != status.state) {
+                     states_.push_back(status.state);
+                   }
+                   last = status;
+                   if (status.state != State::kChecking && status.state != State::kDownloading &&
+                       status.state != State::kInstalling) {
+                     loop.Quit();
+                   }
+                 }));
+    loop.Run();
+    return last;
+  }
+
+  std::unique_ptr<UpdateClient> Client() {
+    return std::make_unique<UpdateClient>(
+        config_, base::MakeRefCounted<network::WeakWrapperSharedURLLoaderFactory>(&network_),
+        &prefs_, &clock_);
+  }
+
+  bool DownloadFolderIsEmpty() {
+    return base::IsDirectoryEmpty(config_.download_dir) || !base::PathExists(config_.download_dir);
+  }
+
+  base::test::TaskEnvironment task_environment_;
+  base::ScopedTempDir dir_;
+  TestingPrefServiceSimple prefs_;
+  base::SimpleTestClock clock_;
+  network::TestURLLoaderFactory network_;
+  UpdateClient::Config config_;
+  std::vector<State> states_;
+
+  base::Lock lock_;
+  std::vector<std::string> installed_;
+  std::vector<bool> deltas_;
+  std::vector<bool> writable_;
+  bool install_works_ = true;
+  bool fail_delta_ = false;
+};
