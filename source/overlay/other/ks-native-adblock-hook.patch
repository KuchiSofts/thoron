index 0000000000000000000000000000000000000000..0436c0ff83e22afab046dae251791c38e1115455
--- /dev/null
+++ b/components/thoron_update/delta_package.cc
@@ -0,0 +1,352 @@
+// Copyright 2026 KuchiSofts. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/thoron_update/delta_package.h"
+
+#include <algorithm>
+#include <map>
+#include <optional>
+#include <set>
+#include <string>
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/values.h"
+#include "components/thoron_update/package.h"
+#include "components/thoron_update/portable_package.h"
+#include "components/zucchini/buffer_view.h"
+#include "components/zucchini/patch_reader.h"
+#include "components/zucchini/zucchini.h"
+#include "crypto/hash.h"
+#include "third_party/zlib/google/zip_reader.h"
+
+namespace thoron_update {
+
+namespace {
+
+constexpr uint64_t kMostListBytes = 16 * 1024 * 1024;
+
+struct Entry {
+  std::string path;
+  int64_t size = 0;
+  std::string sha256;
+  std::string how;
+  std::string from_path;
+  std::string from_sha256;
+};
+
+std::string Sha256Hex(base::span<const uint8_t> data) {
+  return base::HexEncodeLower(crypto::hash::Sha256(data));
+}
+
+// A path inside the version's folder: parts joined by '/', none empty, '.' or
+// '..', no '\\' or ':' (no drive, no stream).
+std::optional<base::FilePath> Inside(const base::FilePath& folder, const std::string& path) {
+  if (path.empty() || path.size() > 1024) {
+    return std::nullopt;
+  }
+  base::FilePath out = folder;
+  for (const std::string& part :
+       base::SplitString(path, "/", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL)) {
+    if (part.empty() || part == "." || part == ".." ||
+        part.find_first_of("\\:") != std::string::npos) {
+      return std::nullopt;
+    }
+    out = out.Append(base::FilePath::FromUTF8Unsafe(part));
+  }
+  return out;
+}
+
+std::optional<std::vector<Entry>> ReadList(const std::string& text,
+                                           const BuildVersion& from,
+                                           const BuildVersion& to,
+                                           DeltaResult* why) {
+  *why = DeltaResult::kNotADelta;
+  const std::optional<base::Value> read = base::JSONReader::Read(text, base::JSON_PARSE_RFC);
+  const base::DictValue* dict = read ? read->GetIfDict() : nullptr;
+  if (!dict || dict->FindInt("format").value_or(0) != 1) {
+    return std::nullopt;
+  }
+  const std::string* from_text = dict->FindString("from");
+  const std::string* to_text = dict->FindString("to");
+  if (!from_text || !to_text) {
+    return std::nullopt;
+  }
+  if (*from_text != ToString(from) || *to_text != ToString(to)) {
+    *why = DeltaResult::kWrongVersion;
+    return std::nullopt;
+  }
+  const base::ListValue* list = dict->FindList("files");
+  if (!list || list->empty() || list->size() > kMostUnpackedFiles) {
+    *why = list && list->size() > kMostUnpackedFiles ? DeltaResult::kTooLarge
+                                                      : DeltaResult::kNotADelta;
+    return std::nullopt;
+  }
+  std::vector<Entry> out;
+  std::set<std::string> seen;
+  int64_t total = 0;
+  for (const base::Value& value : *list) {
+    const base::DictValue* file = value.GetIfDict();
+    if (!file) {
+      return std::nullopt;
+    }
+    Entry entry;
+    const std::string* path = file->FindString("path");
+    const std::string* sha = file->FindString("sha256");
+    const std::string* how = file->FindString("how");
+    const std::optional<double> size = file->FindDouble("size");
+    if (!path || !sha || !how || !size || *size < 0 || *size > 4294967295.0 ||
+        !seen.insert(base::ToLowerASCII(*path)).second) {
+      return std::nullopt;
+    }
+    entry.path = *path;
+    entry.sha256 = *sha;
+    entry.how = *how;
+    entry.size = static_cast<int64_t>(*size);
+    if (entry.how == "same" || entry.how == "patch") {
+      const std::string* from_path = file->FindString("from_path");
+      const std::string* from_sha = file->FindString("from_sha256");
+      if (!from_path || !from_sha) {
+        return std::nullopt;
+      }
+      entry.from_path = *from_path;
+      entry.from_sha256 = *from_sha;
+    } else if (entry.how != "whole") {
+      return std::nullopt;
+    }
+    total += entry.size;
+    if (total > kMostUnpackedBytes) {
+      *why = DeltaResult::kTooLarge;
+      return std::nullopt;
+    }
+    out.push_back(std::move(entry));
+  }
+  return out;
+}
+
+DeltaResult Abandon(const base::FilePath& staged, DeltaResult result) {
+  base::DeletePathRecursively(staged);
+  return result;
+}
+
+}  // namespace
+
+DeltaResult CheckDeltaList(std::string_view text,
+                           const BuildVersion& from,
+                           const BuildVersion& to,
+                           const base::FilePath& folder,
+                           size_t* count) {
+  *count = 0;
+  DeltaResult why = DeltaResult::kNotADelta;
+  const std::optional<std::vector<Entry>> read = ReadList(std::string(text), from, to, &why);
+  if (!read) {
+    return why;
+  }
+  for (const Entry& entry : *read) {
+    if (!Inside(folder, entry.path) ||
+        (!entry.from_path.empty() && !Inside(folder, entry.from_path))) {
+      return DeltaResult::kNotADelta;
+    }
+  }
+  *count = read->size();
+  return DeltaResult::kDone;
+}
+
+std::string_view DeltaResultName(DeltaResult result) {
+  switch (result) {
+    case DeltaResult::kDone:
+      return "done";
+    case DeltaResult::kNotADelta:
+      return "not_a_delta";
+    case DeltaResult::kWrongVersion:
+      return "wrong_version";
+    case DeltaResult::kOldFileDiffers:
+      return "old_file_differs";
+    case DeltaResult::kPatchFails:
+      return "patch_fails";
+    case DeltaResult::kNewFileDiffers:
+      return "new_file_differs";
+    case DeltaResult::kTooLarge:
+      return "too_large";
+    case DeltaResult::kIoError:
+      return "io_error";
+  }
+  return "io_error";
+}
+
+DeltaResult ApplyDelta(const base::FilePath& delta,
+                       const base::FilePath& old_folder,
+                       const BuildVersion& from,
+                       const BuildVersion& to,
+                       const base::FilePath& staged,
+                       std::vector<VersionFile>* files) {
+  files->clear();
+  if (base::PathExists(staged)) {
+    return DeltaResult::kIoError;
+  }
+  // The list first.
+  std::vector<Entry> entries;
+  {
+    zip::ZipReader reader;
+    if (!reader.Open(delta)) {
+      return DeltaResult::kNotADelta;
+    }
+    std::string text;
+    bool found = false;
+    while (const zip::ZipReader::Entry* entry = reader.Next()) {
+      if (entry->path.AsUTF8Unsafe() == "delta.json") {
+        found = reader.ExtractCurrentEntryToString(kMostListBytes, &text);
+        break;
+      }
+    }
+    if (!found) {
+      return DeltaResult::kNotADelta;
+    }
+    DeltaResult why = DeltaResult::kNotADelta;
+    std::optional<std::vector<Entry>> read = ReadList(text, from, to, &why);
+    if (!read) {
+      return why;
+    }
+    entries = std::move(*read);
+  }
+  if (!base::CreateDirectory(staged)) {
+    return DeltaResult::kIoError;
+  }
+  std::map<std::string, size_t> stored;  // "patch/<n>" or "whole/<n>" -> entry
+  for (size_t n = 0; n < entries.size(); ++n) {
+    const Entry& entry = entries[n];
+    const std::optional<base::FilePath> target = Inside(staged, entry.path);
+    if (!target) {
+      return Abandon(staged, DeltaResult::kNotADelta);
+    }
+    if (entry.how != "same") {
+      stored[entry.how + "/" + base::NumberToString(n)] = n;
+      continue;
+    }
+    const std::optional<base::FilePath> source = Inside(old_folder, entry.from_path);
+    if (!source || CheckFile(*source, PackageFile{std::string(), entry.size, entry.from_sha256}) !=
+                       FileCheck::kOk) {
+      return Abandon(staged, DeltaResult::kOldFileDiffers);
+    }
+    if (!base::CreateDirectory(target->DirName()) || !base::CopyFile(*source, *target) ||
+        !MakeRunnableIfProgram(*target)) {
+      return Abandon(staged, DeltaResult::kIoError);
+    }
+    if (CheckFile(*target, PackageFile{std::string(), entry.size, entry.sha256}) != FileCheck::kOk) {
+      return Abandon(staged, DeltaResult::kNewFileDiffers);
+    }
+  }
+  // Then the patches and whole files, in the order the .zip holds them.
+  zip::ZipReader reader;
+  if (!reader.Open(delta)) {
+    return Abandon(staged, DeltaResult::kNotADelta);
+  }
+  while (const zip::ZipReader::Entry* zipped = reader.Next()) {
+    if (zipped->is_unsafe || zipped->is_encrypted || zipped->is_symbolic_link ||
+        ZipPathWasMadeSafe(zipped->path)) {
+      return Abandon(staged, DeltaResult::kNotADelta);
+    }
+    const auto it = stored.find(zipped->path.AsUTF8Unsafe());
+    if (zipped->is_directory || it == stored.end()) {
+      continue;
+    }
+    const Entry& entry = entries[it->second];
+    stored.erase(it);
+    const base::FilePath target = *Inside(staged, entry.path);
+    if (!base::CreateDirectory(target.DirName())) {
+      return Abandon(staged, DeltaResult::kIoError);
+    }
+    if (entry.how == "whole") {
+      bool extracted = false;
+      {
+        zip::FilePathWriterDelegate writer(target);
+        extracted = reader.ExtractCurrentEntry(&writer, static_cast<uint64_t>(entry.size) + 1);
+      }
+      if (!extracted) {
+        return Abandon(staged, DeltaResult::kNewFileDiffers);
+      }
+    } else {
+      std::string patch;
+      if (!reader.ExtractCurrentEntryToString(static_cast<uint64_t>(kMostUnpackedBytes), &patch)) {
+        return Abandon(staged, DeltaResult::kTooLarge);
+      }
+      const std::optional<base::FilePath> source = Inside(old_folder, entry.from_path);
+      std::optional<std::vector<uint8_t>> old_bytes =
+          source ? base::ReadFileToBytes(*source) : std::nullopt;
+      if (!old_bytes || Sha256Hex(*old_bytes) != entry.from_sha256) {
+        return Abandon(staged, DeltaResult::kOldFileDiffers);
+      }
+      const std::optional<zucchini::EnsemblePatchReader> patch_reader =
+          zucchini::EnsemblePatchReader::Create(zucchini::ConstBufferView(
+              reinterpret_cast<const uint8_t*>(patch.data()), patch.size()));
+      if (!patch_reader || patch_reader->header().new_size != static_cast<uint64_t>(entry.size)) {
+        return Abandon(staged, DeltaResult::kPatchFails);
+      }
+      std::vector<uint8_t> made(entry.size);
+      if (zucchini::ApplyBuffer(zucchini::ConstBufferView(old_bytes->data(), old_bytes->size()),
+                                *patch_reader,
+                                zucchini::MutableBufferView(made.data(), made.size())) !=
+          zucchini::status::kStatusSuccess) {
+        return Abandon(staged, DeltaResult::kPatchFails);
+      }
+      if (Sha256Hex(made) != entry.sha256) {
+        return Abandon(staged, DeltaResult::kNewFileDiffers);
+      }
+      if (!base::WriteFile(target, made)) {
+        return Abandon(staged, DeltaResult::kIoError);
+      }
+    }
+    if (!MakeRunnableIfProgram(target)) {
+      return Abandon(staged, DeltaResult::kIoError);
+    }
+    if (CheckFile(target, PackageFile{std::string(), entry.size, entry.sha256}) != FileCheck::kOk) {
+      return Abandon(staged, DeltaResult::kNewFileDiffers);
+    }
+  }
+  if (!reader.ok() || !stored.empty()) {
+    return Abandon(staged, DeltaResult::kNotADelta);
+  }
+  for (const Entry& entry : entries) {
+    files->push_back({entry.path, entry.size, entry.sha256});
+  }
+  return DeltaResult::kDone;
+}
+
+DeltaResult PrepareInstalledDelta(const base::FilePath& delta,
+                                  const base::FilePath& program_folder,
+                                  const BuildVersion& from,
+                                  const BuildVersion& to,
+                                  bool system_level,
+                                  const base::FilePath& staged,
+                                  base::CommandLine* setup) {
+  std::vector<VersionFile> files;
+  const DeltaResult made = ApplyDelta(delta, program_folder, from, to, staged, &files);
+  if (made != DeltaResult::kDone) {
+    return made;
+  }
+  const std::string setup_path = ToString(to) + "/Installer/setup.exe";
+  const bool listed = std::ranges::any_of(
+      files, [&](const VersionFile& file) { return file.path == setup_path; });
+  const base::FilePath setup_exe =
+      staged.Append(base::FilePath::FromUTF8Unsafe(setup_path)).NormalizePathSeparators();
+  if (!listed || !base::PathExists(setup_exe)) {
+    return Abandon(staged, DeltaResult::kNotADelta);
+  }
+  base::CommandLine command(setup_exe);
+  command.AppendSwitchPath("thoron-chrome-bin", staged);
+  command.AppendSwitch("do-not-launch-chrome");
+  if (system_level) {
+    command.AppendSwitch("system-level");
+  }
+  *setup = std::move(command);
+  return DeltaResult::kDone;
+}
+
+}  // namespace thoron_update
