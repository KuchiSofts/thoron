+class ChromiumFamilyReaderTest : public ::testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(dir_.CreateUniqueTempDir());
+    user_data_ = dir_.GetPath().Append(FILE_PATH_LITERAL("User Data"));
+    profile_ = user_data_.Append(FILE_PATH_LITERAL("Default"));
+    ASSERT_TRUE(base::CreateDirectory(profile_));
+  }
+
+  void Write(const base::FilePath& path, const std::string& contents) {
+    ASSERT_TRUE(base::WriteFile(path, contents));
+  }
+
+  // A History DB with the given rows; `visited` is the last visit time.
+  void MakeHistory(base::Time visited) {
+    sql::Database db(sql::Database::Tag("Test"));
+    ASSERT_TRUE(db.Open(profile_.Append(FILE_PATH_LITERAL("History"))));
+    ASSERT_TRUE(db.Execute(
+        "CREATE TABLE urls(id INTEGER PRIMARY KEY, url LONGVARCHAR, "
+        "title LONGVARCHAR, visit_count INTEGER, typed_count INTEGER, "
+        "last_visit_time INTEGER, hidden INTEGER)"));
+    sql::Statement s(db.GetUniqueStatement(
+        "INSERT INTO urls(url, title, visit_count, typed_count, "
+        "last_visit_time, hidden) VALUES(?,?,?,?,?,?)"));
+    s.BindString(0, "https://example.com/");
+    s.BindString16(1, u"Example");
+    s.BindInt(2, 7);
+    s.BindInt(3, 2);
+    s.BindInt64(4, visited.ToDeltaSinceWindowsEpoch().InMicroseconds());
+    s.BindInt(5, 0);
+    ASSERT_TRUE(s.Run());
+    // An internal page that must be filtered out.
+    sql::Statement s2(db.GetUniqueStatement(
+        "INSERT INTO urls(url, title, visit_count, typed_count, "
+        "last_visit_time, hidden) VALUES(?,?,?,?,?,?)"));
+    s2.BindString(0, "chrome://settings/");
+    s2.BindString16(1, u"Settings");
+    s2.BindInt(2, 1);
+    s2.BindInt(3, 0);
+    s2.BindInt64(4, visited.ToDeltaSinceWindowsEpoch().InMicroseconds());
+    s2.BindInt(5, 0);
+    ASSERT_TRUE(s2.Run());
+  }
+
+  void MakeWebData() {
+    sql::Database db(sql::Database::Tag("Test"));
+    ASSERT_TRUE(db.Open(profile_.Append(FILE_PATH_LITERAL("Web Data"))));
+    ASSERT_TRUE(db.Execute(
+        "CREATE TABLE keywords(id INTEGER PRIMARY KEY, short_name VARCHAR, "
+        "keyword VARCHAR, url VARCHAR)"));
+    sql::Statement k(db.GetUniqueStatement(
+        "INSERT INTO keywords(short_name, keyword, url) VALUES(?,?,?)"));
+    k.BindString16(0, u"My Search");
+    k.BindString16(1, u"mys");
+    k.BindString16(2, u"https://s.example.com/?q={searchTerms}");
+    ASSERT_TRUE(k.Run());
+
+    ASSERT_TRUE(db.Execute(
+        "CREATE TABLE autofill(name VARCHAR, value VARCHAR, count INTEGER, "
+        "date_created INTEGER, date_last_used INTEGER)"));
+    sql::Statement a(db.GetUniqueStatement(
+        "INSERT INTO autofill(name, value, count, date_created, "
+        "date_last_used) VALUES(?,?,?,?,?)"));
+    a.BindString16(0, u"email");
+    a.BindString16(1, u"person1@example.com");
+    a.BindInt(2, 3);
+    a.BindInt64(3, 1000000000);  // Seconds since the Unix epoch.
+    a.BindInt64(4, 1000500000);
+    ASSERT_TRUE(a.Run());
+  }
+
+  void MakeLoginData(base::span<const uint8_t> raw_key) {
+    sql::Database db(sql::Database::Tag("Test"));
+    ASSERT_TRUE(db.Open(profile_.Append(FILE_PATH_LITERAL("Login Data"))));
+    ASSERT_TRUE(db.Execute(
+        "CREATE TABLE logins(origin_url VARCHAR, action_url VARCHAR, "
+        "username_element VARCHAR, username_value VARCHAR, "
+        "password_element VARCHAR, password_value BLOB, signon_realm VARCHAR, "
+        "blacklisted_by_user INTEGER, scheme INTEGER)"));
+    auto insert = [&](const std::string& realm,
+                      const std::u16string& username,
+                      const std::vector<uint8_t>& value) {
+      sql::Statement s(db.GetUniqueStatement(
+          "INSERT INTO logins(origin_url, action_url, username_element, "
+          "username_value, password_element, password_value, signon_realm, "
+          "blacklisted_by_user, scheme) VALUES(?,?,?,?,?,?,?,?,?)"));
+      s.BindString(0, "https://site.example.com/login");
+      s.BindString(1, "https://site.example.com/auth");
+      s.BindString16(2, u"u");
+      s.BindString16(3, username);
+      s.BindString16(4, u"p");
+      s.BindBlob(5, value);
+      s.BindString(6, realm);
+      s.BindInt(7, 0);
+      s.BindInt(8, 0);
+      ASSERT_TRUE(s.Run());
+    };
+    // A readable v10 password.
+    insert("https://site.example.com/", u"person1",
+           MakeV10Value(raw_key, "topsecret"));
+    // A v20 app-bound password: must be skipped and counted.
+    std::vector<uint8_t> v20 = {'v', '2', '0', 9, 9, 9, 9};
+    insert("https://app.example.com/", u"person2", v20);
+  }
+
+  // A Cookies database at `db_path` with meta `version`. `encrypted` stores the
+  // encrypted_value blob (empty means use the plaintext `value` column).
+  struct CookieRow {
+    std::string host_key;
+    std::string name;
+    std::string value;              // plaintext column
+    std::vector<uint8_t> encrypted;  // encrypted_value column
+    bool is_persistent = true;
+    bool has_expires = false;
+    base::Time expires;
+  };
+  void MakeCookies(const base::FilePath& db_path,
+                   int version,
+                   const std::vector<CookieRow>& rows) {
+    ASSERT_TRUE(base::CreateDirectory(db_path.DirName()));
+    sql::Database db(sql::Database::Tag("Test"));
+    ASSERT_TRUE(db.Open(db_path));
+    ASSERT_TRUE(db.Execute(
+        "CREATE TABLE meta(key LONGVARCHAR NOT NULL UNIQUE PRIMARY KEY, "
+        "value LONGVARCHAR)"));
+    sql::Statement m(db.GetUniqueStatement(
+        "INSERT INTO meta(key, value) VALUES('version', ?)"));
+    m.BindInt(0, version);
+    ASSERT_TRUE(m.Run());
+    ASSERT_TRUE(db.Execute(
+        "CREATE TABLE cookies(creation_utc INTEGER, host_key TEXT, "
+        "top_frame_site_key TEXT, name TEXT, value TEXT, path TEXT, "
+        "expires_utc INTEGER, is_secure INTEGER, is_httponly INTEGER, "
+        "last_access_utc INTEGER, has_expires INTEGER, is_persistent INTEGER, "
+        "priority INTEGER, encrypted_value BLOB, samesite INTEGER, "
+        "source_scheme INTEGER, source_port INTEGER, last_update_utc INTEGER, "
+        "source_type INTEGER, has_cross_site_ancestor INTEGER)"));
+    int64_t creation = 100;
+    for (const CookieRow& r : rows) {
+      sql::Statement s(db.GetUniqueStatement(
+          "INSERT INTO cookies(creation_utc, host_key, top_frame_site_key, "
+          "name, value, path, expires_utc, is_secure, is_httponly, "
+          "last_access_utc, has_expires, is_persistent, priority, "
+          "encrypted_value, samesite, source_scheme, source_port, "
+          "last_update_utc, source_type, has_cross_site_ancestor) "
+          "VALUES(?,?,'',?,?,'/',?,1,0,0,?,?,1,?,0,2,443,0,1,0)"));
+      s.BindInt64(0, creation++);
+      s.BindString(1, r.host_key);
+      s.BindString(2, r.name);
+      s.BindString(3, r.value);
+      s.BindInt64(4, r.expires.ToDeltaSinceWindowsEpoch().InMicroseconds());
+      s.BindInt(5, r.has_expires ? 1 : 0);
+      s.BindInt(6, r.is_persistent ? 1 : 0);
+      s.BindBlob(7, r.encrypted);
+      ASSERT_TRUE(s.Run());
+    }
+  }
+
+  // A Local State whose os_crypt.encrypted_key wraps `raw_key`.
+  void MakeLocalState(base::span<const uint8_t> raw_key) {
+    std::vector<uint8_t> prefixed = {'D', 'P', 'A', 'P', 'I'};
+    std::vector<uint8_t> wrapped = WrapForCurrentUser(raw_key);
+    prefixed.insert(prefixed.end(), wrapped.begin(), wrapped.end());
+    Write(user_data_.Append(FILE_PATH_LITERAL("Local State")),
+          base::StrCat({"{\"os_crypt\":{\"encrypted_key\":\"",
+                        base::Base64Encode(prefixed), "\"}}"}));
+  }
+
+  void MakeBookmarks() {
+    Write(profile_.Append(FILE_PATH_LITERAL("Bookmarks")), R"({
+      "roots": {
+        "bookmark_bar": {
+          "type": "folder", "name": "Bookmarks bar", "date_added": "13300000000000000",
+          "children": [
+            {"type": "url", "name": "Toolbar Link",
+             "url": "https://toolbar.example.com/", "date_added": "13300000000000000"},
+            {"type": "folder", "name": "Sub", "date_added": "13300000000000000",
+             "children": [
+               {"type": "url", "name": "Nested",
+                "url": "https://nested.example.com/", "date_added": "13300000000000000"}
+             ]},
+            {"type": "folder", "name": "Empty", "date_added": "13300000000000000",
+             "children": []}
+          ]
+        },
+        "other": {
+          "type": "folder", "name": "Other bookmarks", "date_added": "13300000000000000",
+          "children": [
+            {"type": "url", "name": "Other Link",
+             "url": "https://other.example.com/", "date_added": "13300000000000000"},
+            {"type": "url", "name": "Internal",
+             "url": "chrome://flags", "date_added": "13300000000000000"}
+          ]
+        },
+        "synced": {"type": "folder", "name": "Mobile bookmarks", "children": []}
+      }
+    })");
+  }
+
+  ChromiumFamilyReader::Options Options() {
+    ChromiumFamilyReader::Options options;
+    options.profile_path = profile_;
+    options.user_data_path = user_data_;
+    options.bookmark_folder_name = u"Imported from Brave";
+    return options;
+  }
+
+  base::ScopedTempDir dir_;
+  base::FilePath user_data_;
+  base::FilePath profile_;
+};
+
+TEST_F(ChromiumFamilyReaderTest, ImportsEverything) {
+  std::array<uint8_t, 32> raw_key = MakeKey();
+  base::Time visited = base::Time::Now() - base::Days(3);
+  MakeBookmarks();
+  MakeHistory(visited);
+  MakeWebData();
+  MakeLocalState(raw_key);
+  MakeLoginData(raw_key);
+
+  FakeBridge bridge;
+  ChromiumFamilyReader reader(Options());
+  ChromiumFamilyReader::Stats stats = reader.Import(ALL, &bridge);
+
+  // Bookmarks: 3 URLs (toolbar, nested, other) plus the empty "Empty" folder.
+  // chrome://flags is filtered, and the empty mobile root is not an entry.
+  EXPECT_EQ(u"Imported from Brave", bridge.bookmark_folder);
+  EXPECT_EQ(4, stats.bookmarks);
+  ASSERT_EQ(4u, bridge.bookmarks.size());
+  int in_toolbar = 0;
+  int checked = 0;
+  for (const auto& b : bridge.bookmarks) {
+    if (b.in_toolbar) {
+      ++in_toolbar;
+    }
+    // ProfileWriter's contract: toolbar entries carry the bar's name as
+    // path[0]; "Other bookmarks" items carry no root name.
+    if (b.title == u"Toolbar Link") {
+      EXPECT_EQ(std::vector<std::u16string>({u"Bookmarks bar"}), b.path);
+      ++checked;
+    } else if (b.title == u"Nested") {
+      EXPECT_EQ(std::vector<std::u16string>({u"Bookmarks bar", u"Sub"}),
+                b.path);
+      ++checked;
+    } else if (b.title == u"Empty") {
+      EXPECT_TRUE(b.is_folder);
+      EXPECT_EQ(std::vector<std::u16string>({u"Bookmarks bar"}), b.path);
+      ++checked;
+    } else if (b.title == u"Other Link") {
+      EXPECT_FALSE(b.in_toolbar);
+      EXPECT_TRUE(b.path.empty());
+      // WebKit epoch: microseconds since 1601-01-01.
+      EXPECT_EQ(13300000000000000,
+                b.creation_time.ToDeltaSinceWindowsEpoch().InMicroseconds());
+      ++checked;
+    }
+  }
+  EXPECT_EQ(4, checked);
+  EXPECT_EQ(3, in_toolbar);  // Toolbar Link, Nested and Empty.
+
+  // History: the internal page is filtered.
+  ASSERT_EQ(1u, bridge.history.size());
+  EXPECT_EQ("https://example.com/", bridge.history[0].url.spec());
+  EXPECT_EQ(7, bridge.history[0].visit_count);
+  EXPECT_EQ(visited.ToDeltaSinceWindowsEpoch().InMicroseconds(),
+            bridge.history[0].last_visit.ToDeltaSinceWindowsEpoch()
+                .InMicroseconds());
+
+  // Search engines, kept in the {searchTerms} form.
+  ASSERT_EQ(1u, bridge.keywords.size());
+  EXPECT_EQ(u"mys", bridge.keywords[0].keyword);
+  EXPECT_EQ(u"https://s.example.com/?q={searchTerms}", bridge.keywords[0].url);
+
+  // Autofill.
+  ASSERT_EQ(1u, bridge.autofill.size());
+  EXPECT_EQ(u"email", bridge.autofill[0].name);
+  EXPECT_EQ(u"person1@example.com", bridge.autofill[0].value);
+  EXPECT_EQ(3, bridge.autofill[0].times_used);
+
+  // Passwords: the v10 one read, the v20 one skipped and counted.
+  ASSERT_EQ(1u, bridge.passwords.size());
+  EXPECT_EQ(u"person1", bridge.passwords[0].username_value);
+  EXPECT_EQ(u"topsecret", bridge.passwords[0].password_value);
+  EXPECT_EQ(1, stats.passwords);
+#if BUILDFLAG(IS_WIN)
+  EXPECT_EQ(1, stats.passwords_skipped_app_bound);
+#else
+  EXPECT_EQ(1, stats.passwords_skipped_other);
+#endif
+}
